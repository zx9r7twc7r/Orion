#version 460
#extension GL_GOOGLE_include_directive : require


layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D cloudImage;
layout(rgba16f, set = 0, binding = 1) uniform writeonly image2D godRayOutput;
layout(set = 0, binding = 2) uniform CameraProperties
{
    #include "camera_ubo.glsl"
} cam;

layout(push_constant) uniform GodRayPush
{
    vec4 sunDirection;
    vec4 params;
} pc;
const int MAX_SAMPLES = 64;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(godRayOutput);
    if(any(greaterThanEqual(pixel, size)))
    {
        return;
    }

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);

    vec3 camRight = normalize(vec3(cam.viewInverse[0][0], cam.viewInverse[1][0],
        cam.viewInverse[2][0]));
    vec3 camUp = normalize(vec3(cam.viewInverse[0][1], cam.viewInverse[1][1],
        cam.viewInverse[2][1]));
    vec3 camForward = -normalize(vec3(cam.viewInverse[0][2], cam.viewInverse[1][2],
        cam.viewInverse[2][2]));

    vec3 sunDirection = normalize(pc.sunDirection.xyz);
    float blend = clamp(dot(sunDirection, camForward), 0.0, 1.0);
    if(blend <= 0.0 || pc.sunDirection.w <= 0.0)
    {
        imageStore(godRayOutput, pixel, vec4(0.0));
        return;
    }

    float tanHalfFov = 1.0 / max(abs(cam.projInverse[1][1]), 1.0e-6);
    float aspect = float(size.x) / float(size.y);
    vec2 ndc = vec2(dot(sunDirection, camRight) / (tanHalfFov * aspect),
        dot(sunDirection, camUp) / tanHalfFov);
    vec2 sunUV = clamp(ndc * 0.5 + 0.5, vec2(0.001), vec2(0.999));

    int samples = int(clamp(pc.params.x, 4.0, float(MAX_SAMPLES)));
    float weight = max(pc.params.y, 0.0) / float(samples);
    vec2 delta = (uv - sunUV) / float(samples);

    vec3 accum = vec3(0.0);
    float illuminationDecay = 1.0;
    vec2 sampleUV = uv;
    for(int i = 0; i < MAX_SAMPLES; ++i)
    {
        if(i >= samples) break;
        float occlusion = clamp(1.0 - textureLod(cloudImage, clamp(sampleUV, vec2(0.0),
            vec2(1.0)), 0.0).a, 0.0, 1.0);
        accum += occlusion * illuminationDecay * weight;
        illuminationDecay *= 0.985;
        sampleUV -= delta;
    }

    accum *= blend * pc.sunDirection.w;
    imageStore(godRayOutput, pixel, vec4(accum, 1.0));
}
