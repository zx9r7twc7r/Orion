#version 460
#extension GL_GOOGLE_include_directive : require

// ===========================================================================
// 体积云 v2 —— 云模型移植
//
// 参考源（cpp/.tmp/reference/ 下的参考包，与投放包逐字节相同）：
//   Clouds.fsh
//       :25-34   remap / powder
//       :36-62   Mie 常数 + phaseg8 / phasegm5 / phase2lobes
//       :64-66   SampleNoise（noisetex / noiseTextureResolution）
//       :68-156  CalculateDensityForLayer（2D 底覆盖 + 3D worley 侵蚀 + 解析垂直 shaping）
//       :158-160 GetVolumetricClouds
//       :162-185 CalculateCloudSunVisibility
//       :187-208 CalculateCloudSkyVisibility
//       :210-215 CalculateCloudScattering（每样本恰好两项）
//       :217-287 CalculateVolumetricClouds（球壳求交 + march + 透射率 remap）
//   C2_RenderClouds.comp         :95-121  每像素样本组织（世界视线 + 抖动）
//   C5_CompositeScene.frag       :156-192 SampleClouds 的合成口径
//       scattering = sunColor * clouds.r + skyColor * clouds.g
//       color      = background * clouds.b + scattering
//   UserLib/VolumetricSettings.glsl        出厂常量（MIN_TRANSMITTANCE=0.2 /
//       SUN=0.1 / COVERAGE_RAIN=0.35 / WIND_DIR=(1,0,1) / NOISE_OCTAVES=1）
//   UserLib/SkySettings.glsl               phaseg0 = 0.25
//
// 密度场、可见度 march、散射核、积分式、相位与 powder 的数值全部按参考原文，
// 不接受"看起来更合理"的自造阈值或自造归一化。
//
// 已知偏离（仅引擎接口/性能，模型本身未改）：
//   D1 2D 基础覆盖噪声：参考用 noisetex（64² RG，REPEAT + 模糊）。本引擎改用
//      程序化生成的 64² RG8（binding 9），通道语义与采样方式完全一致
//      （.r/.g 各两次 tap，坐标 / noiseTextureResolution=64）。
//   D2 时间：参考 TIME = frameTimeCounter（秒）；本引擎秒数在 CameraUBO.padding
//      （与水面同一时基）。CLOUDS_TIME 的换算见 v2CloudsTime()。
//   D3 采样组织：参考 1/4 分辨率 + 4x4 棋盘 + C3 上采样；本引擎沿用现有
//      全分辨率云图 + 时域抖动的 resolve/composite（P3 才切 1/4）。
//      每像素仍然只取一个抖动偏移（参考 C2 也是每像素一个 dither）。
//   D4 云运动矢量（C2 :82-93）不在本 pass 写：本引擎 resolve/composite 已有
//      基于 prevViewProj 的重投影距离通道（.g）。
//   D5 远景消隐与弦长上限（v1 的同名保护）保留：只乘密度、不参与光照模型。
//   D6 天光颜色：参考 SceneData.skyColor 是单色；本引擎用 clearSkyInscatter 的
//      三方向 HG 加权混合得到**一个**辐亮度（2026-10-17 ② 的方向性天光），
//      只算一次、不做色相改写 ⇒ 等价于参考的"一个 skyColor"。
//   D7 直射能量口径：v1 模型自带 CLOUD_SUN_LIGHT_SCALE=6 的能量标定（用于补偿
//      它没有 2π 相位归一）。参考的 sunLighting 已经含 ×2π×phase×powder，因此
//      这里把 6× 剥离后再喂给模型，避免两套标定叠乘（见 V2_SUN_ENERGY_CALIBRATION）。
//   D8 滑杆量纲：GUI「云尺度」1.0 = 参考 VOLUMETRIC_CLOUDS_SCALE 2.5；GUI「云体
//      密度」5.0 = 参考 VOLUMETRIC_CLOUDS_DENSITY 1.0。只换算量纲，不改公式。
//      侵蚀强度 / 噪声八度 / 天光强度 是新增滑杆（参考分别为常量 0.15、
//      设置项 1、无此倍率），出厂值分别 ≈ 0.14 / 1 / 1.0。
//
// 保留（属于本引擎管线、不属于体积云模型）：
//   · 高层平面云（high_cloud_field.glsl）与体积雾（volumetric_fog.glsl，
//     2026-10-19 B 方案）的合成次序与 v1 一致；
//   · 云层空气透视（cloudAerialParams.x）与输出深度语义（.r 首命中 / .g 重投影）。
// ===========================================================================

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform CameraProperties
{
    #include "camera_ubo.glsl"
} cam;

// 与 v1 完全相同的绑定布局（v2 与 v1 共用同一个描述符集与管线布局）。
layout(set = 0, binding = 1) uniform sampler3D cloudShapeNoise;
layout(set = 0, binding = 2) uniform sampler3D cloudCurlNoise;
layout(rgba16f, set = 0, binding = 3) uniform writeonly image2D cloudOutput;
layout(rg32f, set = 0, binding = 4) uniform writeonly image2D cloudDepthOutput;
layout(set = 0, binding = 5) uniform sampler2D sceneDepth;
layout(set = 0, binding = 6) uniform sampler2D sunShadowMap;       // 仅体积雾尾段消费
layout(set = 0, binding = 7) uniform sampler2D terrainHeightMap;   // 旧档兼容，当前无调用
layout(set = 0, binding = 8) uniform sampler2D sunShadowMapFar;    // 仅体积雾尾段消费
// D1：参考 noisetex 的等价物（64² RG8，REPEAT + 三线性）。.r 宽频底噪、.g worley。
layout(set = 0, binding = 9) uniform sampler2D cloudBaseNoise;

// ---------------------------------------------------------------------------
// 参考常量（VolumetricSettings.glsl / SkySettings.glsl）
// ---------------------------------------------------------------------------
const float V2_PI = 3.14159265359;
const float V2_MIN_TRANSMITTANCE = 0.2;       // VOLUMETRIC_CLOUDS_MIN_TRANSMITTANCE
const float V2_MIN_TRANSMITTANCE_SUN = 0.1;   // VOLUMETRIC_CLOUDS_MIN_TRANSMITTANCE_SUN
const float V2_COVERAGE_RAIN_RATIO = 1.75;    // 0.35 / 0.2：参考雨天/晴天覆盖度之比
const float V2_PHASEG0 = 0.25;                // SkySettings.glsl: #define phaseg0 0.25
const int V2_SKY_STEPS = 32;                  // Clouds.fsh:188
const float V2_SKY_EXTINCTION = 0.075;        // Clouds.fsh:198
const float V2_NOISE_RESOLUTION = 64.0;       // noiseTextureResolution
// GUI「云尺度」1.0 = 参考出厂 VOLUMETRIC_CLOUDS_SCALE 2.5（只做量纲换算）
const float V2_SCALE_CALIBRATION = 2.5;
// GUI「云体密度」出厂 5.0 = 参考 VOLUMETRIC_CLOUDS_DENSITY 1.0（只做量纲换算；
// 参考在 march :268 里对密度乘了两次，所以滑杆与不透明度是非线性的）。
const float V2_DENSITY_GUI_REFERENCE = 5.0;
// D7：剥离 v1 的 CLOUD_SUN_LIGHT_SCALE = 6.0
const float V2_SUN_ENERGY_CALIBRATION = 1.0 / 6.0;
const float V2_EMPTY_DISTANCE = 1000000.0;

// 侵蚀阈值在参考里是硬编码常数（Clouds.fsh:149 `max0(detailNoise - 0.8)`）；
// 侵蚀强度与噪声八度都是滑杆（cloudParams1.x / cloudParams1.z）。
#ifndef V2_EROSION_THRESHOLD
#define V2_EROSION_THRESHOLD 0.8
#endif

// 循环上界（GLSL 需要编译期界，实际步数由 UBO 钳制）。
const int V2_MAX_VIEW_STEPS = 96;             // 与 v1 CLOUD_MAX_VIEW_STEPS 同档
const int V2_MAX_SUN_STEPS = 16;              // VCL_HIGH = 15，留 1 档余量
const int V2_MAX_OCTAVES = 4;
// D5：本引擎的 march 保护（v1 同名常量）
const float V2_MAX_MARCH_LENGTH = 260000.0;

// ---------------------------------------------------------------------------
// 参考逐字移植的小工具（Clouds.fsh:25-66）
// ---------------------------------------------------------------------------
float v2Remap(float value, float originalMin, float originalMax, float newMin, float newMax)
{
    return (((value - originalMin) / (originalMax - originalMin)) * (newMax - newMin)) + newMin;
}

// Clouds.fsh:29-34
float v2Powder(float sampleDensity, float VoL)
{
    float powder = 1.0 - 0.97 * exp(-sampleDensity);
    powder = mix(powder * 1.5, 0.8, VoL * 0.5 + 0.5);
    return powder;
}

// Clouds.fsh:36-62（Mie 常数 + 双瓣相位；一个函数，无上限钳制分支）
const float V2_G_MULTIPLIER_CLOUDS = 0.5;
const float V2_MIXER_G_CLOUDS = 0.9;

// 单个 Mie 瓣（Clouds.fsh:36-62 的两段是同一公式的不同 g/权重）。
float v2PhaseLobe(float x, float g, float weight)
{
    const float g2 = g * g;
    const float g3 = log2((g2 * -0.25 + 0.25) * weight);
    const float g4 = 1.0 + g2;
    const float g5 = -2.0 * g;
    return exp2(log2(g5 * x + g4) * -1.5 + g3);
}

// 前向瓣各向异性系数。参考 g = 0.8 * 0.5 = 0.4；旋钮 cloudParams6.y（原「夕阳红化」，
// lane 合法域 0..1，出厂 0.0 ⇒ 0.4），每 +1 加 0.4。后向瓣固定 -0.25（参考原值）。
float v2ForwardPhaseG()
{
    return clamp(0.4 + 0.4 * cam.cloudParams6.y, 0.0, 0.95);
}

float v2Phase2Lobes(float x, float gForward)
{
    return v2PhaseLobe(x, gForward, V2_MIXER_G_CLOUDS) +
           v2PhaseLobe(x, -0.5 * V2_G_MULTIPLIER_CLOUDS, 1.0 - V2_MIXER_G_CLOUDS);
}

// Clouds.fsh:64-66
vec4 v2SampleNoise(sampler2D noiseSampler, vec2 coord)
{
    return texture(noiseSampler, coord / V2_NOISE_RESOLUTION);
}

// Clouds.fsh:9-14
const float V2_ROTATION = radians(105.0);
const mat2 V2_ROTATE_MATRIX = mat2(
    cos(V2_ROTATION), -sin(V2_ROTATION),
    sin(V2_ROTATION),  cos(V2_ROTATION));

// hash33（太阳步长抖动；Clouds.fsh:168）
vec3 v2Hash33(vec3 p)
{
    p = fract(p * vec3(443.8975, 397.2973, 491.1871));
    p += dot(p.zxy, p.yxz + 19.27);
    return fract(vec3(p.x * p.y, p.z * p.x, p.y * p.z));
}

// ---------------------------------------------------------------------------
// 本引擎时间/尺度接口（D2）
// ---------------------------------------------------------------------------
float v2TimeSeconds()
{
    return max(uintBitsToFloat(cam.padding), 0.0);
}

// 引擎时域抖动（v1 同款：静态像素基 + 黄金比帧间相位 + 近邻 4 相位扰动）。
// 参考用蓝噪声 + 4x4 棋盘（D3）；两者都是低差异采样，这里沿用本引擎已验证的序列。
float v2TemporalJitter(ivec2 pixel)
{
    uint state = uint(pixel.x) * 1973u + uint(pixel.y) * 9277u + 911u;
    state ^= state >> 16u;
    state *= 2246822519u;
    state ^= state >> 13u;
    return float(state & 0x00ffffffu) / float(0x01000000u);
}

float v2TemporalPhase()
{
    return float(cam.frameCount & 0x3ffu) * 0.6180339887498949;
}

// 参考 CLOUDS_TIME = TIME * VOLUMETRIC_CLOUDS_SPEED，作用在**噪声单位**上。
// 本引擎的风速旋钮是"格/秒"，而 pos2D = worldXZ / (positionScale*layerThickness)
// ⇒ 世界位移 speed*TIME 对应噪声位移 speed*TIME/(positionScale*thickness)。
// 参考的 2D/3D 漂移本来就差常数 2 倍（10*normalize*scale 对 5*pos/thickness），
// 这里保留参考那套关系，不做第二次归一。
float v2CloudsTime(float positionScale, float layerThickness)
{
    float speed = max(cam.cloudParams1.y, 0.0);
    return v2TimeSeconds() * speed / max(positionScale * layerThickness, 1.0);
}

vec2 v2WindDirection2D()
{
    // VOLUMETRIC_CLOUDS_WIND_DIR = vec3(1,0,1)
    return normalize(vec3(1.0, 0.0, 1.0).xz);
}

float v2NoiseScale()
{
    return max(cam.cloudParams3.z, 0.05) * V2_SCALE_CALIBRATION;
}

float v2CoverageRain(float coverage)
{
    // 参考 coverageRain 是独立常量（0.35 对晴天 0.2）。这里按同一比例从 GUI
    // 覆盖率推出，保证"雨天比晴天更满"的语义与单调性。
    return clamp(coverage * V2_COVERAGE_RAIN_RATIO, 0.0, 1.0);
}

// UI 相位函数（v1 同名）——只用于 D6 天光三方向的权重，不参与云的散射核。
float hgPhase(float cosine, float g)
{
    float g2 = g * g;
    float denominator = max(1.0e-4, 1.0 + g2 - 2.0 * g * cosine);
    return (1.0 - g2) / (4.0 * V2_PI * denominator * sqrt(denominator));
}

// ---------------------------------------------------------------------------
// 共享 include（顺序同 v1：平面云依赖 tyndall，雾依赖 hgPhase + sun_shadow）
//
// 2026-10-17：本段提前到 march 之前 —— v2 的球壳求交必须用 tyndall 的
// **有理化**根式（tyndallSphereRoots）。直接照抄参考 Sky.fsh 的 rsi 会做
// R≈6.36e6 量级的平方相减（delta = PoD² + R² - |p|²），fp32 下有灾难性抵消，
// 与 tyndall_cloud_field.glsl:8 已记录的教训相同。几何与本引擎一致 ⇒ 不改观感。
// ---------------------------------------------------------------------------
#include "sky_model_common.glsl"
#include "sky_sun_common.glsl"
#include "clear_sky_aerial.glsl"
// tyndallSphereRoots 所在的头（同时提供 TYNDALL_RADIUS）
#include "tyndall_cloud_field.glsl"
#include "high_cloud_field.glsl"

#define TERRAIN_HEIGHT_CONSUMER 1
#include "terrain_height.glsl"

#define SUN_SHADOW_FAR_MAP 1
#define SUN_SHADOW_CONSUMER 1
#define SUN_SHADOW_PCF_TAPS_4 1
// 2026-10-21：体积雾的近图 ∪ 远图合并可见性（治"背光面照常出光柱"），
// 原因见 sun_shadow.glsl 的 sunShadowFogVisibility。
#define SUN_SHADOW_FOG_UNION 1
#include "sun_shadow.glsl"

#include "volumetric_fog.glsl"

vec3 v2SunColor(vec3 lightDirection)
{
    // v1 同款（goldenStrength = 0.5），供 D7 的直射色使用。
    return skyModelSunColor(lightDirection, 0.5);
}

// v1 的天光能量曲线在出厂档（skyHueEnergy = 0.5）的上界 0.25。
const float V2_DAYLIGHT_UPPER = 0.25;
const float V2_NIGHT_AMBIENT = 0.08;   // v1 CLOUD_NIGHT_AMBIENT
const float V2_MOON_LIGHT_SCALE = 6.0 * (0.05 / 1.22077458876);
const float V2_SOLAR_LATITUDE_35_COS = 0.81915204429;

// ---------------------------------------------------------------------------
// 密度场：Clouds.fsh:68-156 逐字移植
//
// 2026-10-17 性能重构（**逐位等价**，不是模型改动）：
//   ① 参考 :97-100 在同一个坐标上取了 4 次（只取 .g/.r）⇒ 合并成 2 次 fetch。
//      `pos2D*2 - wind*2` 与 `(pos2D-wind)*2` 在 IEEE754 下逐位相等（×2 精确）。
//   ② 参考 :108 的局部覆盖图与基噪只依赖 XZ ⇒ 拆成 v2SampleColumn()。
//      **天光 march 沿 +Y 走、XZ 恒定** ⇒ 整条 march 复用同一列，省掉 32×3 次纹理读。
// ---------------------------------------------------------------------------
struct V2CloudColumn
{
    float baseNoise;      // :97-102
    float localCoverage;  // :108-109
};

V2CloudColumn v2SampleColumn(
    vec2 worldXZ,
    float cloudsTime,
    float positionScale,
    float layerThickness,
    float wetness)
{
    vec2 windDir2D = v2WindDirection2D();
    vec2 pos2D = worldXZ / (positionScale * layerThickness);

    vec2 coord2D = pos2D - windDir2D * cloudsTime;
    vec4 base0 = v2SampleNoise(cloudBaseNoise, coord2D);
    vec4 base1 = v2SampleNoise(cloudBaseNoise, coord2D * 2.0);

    V2CloudColumn column;
    column.baseNoise = (base0.g + base0.r + base1.g + base1.r) * 0.25;

    // VC_LOCAL_COVERAGE（VolumetricSettings.glsl:33 出厂开启）
    float localCoverage = texture(cloudBaseNoise,
        (cloudsTime * 25.0 * vec2(1.0, 1.0) + worldXZ) * 1e-5 + 0.5).x;
    column.localCoverage = clamp(localCoverage * 3.0 - 0.75 + wetness, 0.0, 1.0) * 0.5 + 0.5;
    return column;
}

float v2DensityFromColumn(
    vec3 worldPos,
    const V2CloudColumn column,
    float densityMultiplier,
    float baseAltitude,
    float coverageMultiplier,
    float coverageMultiplierRain,
    float layerThickness,
    bool isLowQ,
    int octaves,
    float positionScale,
    float cloudsTime,
    float wetness)
{
    const float topAltitude = baseAltitude + layerThickness;

    if(worldPos.y < baseAltitude || worldPos.y > topAltitude) return 0.0;

    float normalizedHeight = v2Remap(worldPos.y, baseAltitude, topAltitude, 0.0, 1.0);
    float fade = (1.0 - normalizedHeight * normalizedHeight);
    // 云底软边（占层厚比例）。参考没有这一项（0 = 参考口径）；出厂 0.03 只把最底部
    // 3% 的密度拉起来，避免一刀切的底面。旋钮 cloudParams4.x（原「云底羽化」）。
    const float baseFeather = clamp(cam.cloudParams4.x, 0.0, 0.5);
    if(baseFeather > 0.001)
    {
        fade *= smoothstep(0.0, 1.0, normalizedHeight / baseFeather);
    }

    float coverage = mix(coverageMultiplier, coverageMultiplierRain, wetness) *
        fade * column.localCoverage;
    float cloudBase = clamp(column.baseNoise - (0.65 - coverage), 0.0, 1.0);

    // Early out.
    if(cloudBase <= 0.01) return 0.0;
    if(isLowQ) octaves = 0;

    vec3 windDir3D = 10.0 * normalize(vec3(1.0, 0.0, 1.0)) * positionScale;
    // 3D 细节尺度：参考常量 5.0。旋钮 cloudParams6.x（原「远段步长加密」，出厂 1.0 ⇒ 5.0）。
    const float detailScale = 5.0 * clamp(cam.cloudParams6.x, 1.0, 4.0);
    vec3 pos3D = detailScale * worldPos / layerThickness - windDir3D * cloudsTime;

    // 参考 :126 的 curl 读取在基础层不参与 detailNoise（循环内才用）——
    // 逐字保留；编译器会把这条死读取消，不产生带宽。
    vec3 curlNoise = texture(cloudCurlNoise, pos3D * 0.1).xyz;
    float worleyMix = normalizedHeight + 0.5;

    vec2 noiseSample = texture(cloudShapeNoise, pos3D * 0.07).xy * 0.5;
    noiseSample += texture(cloudShapeNoise, pos3D * 0.1).xy * 0.7;

    float detailNoise = noiseSample.x * (0.5 + 0.25 * (1.0 - worleyMix)) +
        noiseSample.y * worleyMix * 2.0;

    for(int i = 0; i < V2_MAX_OCTAVES; ++i)
    {
        if(i >= octaves) break;
        // Scale down successive octaves.
        pos3D *= V2_PI;
        pos3D.xz *= V2_ROTATE_MATRIX;
        windDir3D *= V2_PI;
        windDir3D.xz *= V2_ROTATE_MATRIX;

        // Make the smaller octaves move faster.
        vec3 wind = windDir3D * float(i) * cloudsTime;

        // Decrease weight for successive octaves.
        curlNoise = texture(cloudCurlNoise, (pos3D - wind) * 0.25).xyz * exp(-float(i)) * 0.05;
        detailNoise += texture(cloudShapeNoise, (pos3D - wind) * 0.05 + curlNoise).x *
            exp(-float(i)) * 0.5;
    }

    // 侵蚀阈值：参考是硬编码 0.8（Clouds.fsh:149）。旋钮走 cloudParams6.w
    // （原「去平铺」，出厂 1.05 ⇒ 0.84，≈参考），1.0 = 参考 0.8。
    const float erosionThreshold = V2_EROSION_THRESHOLD * clamp(cam.cloudParams6.w, 0.5, 1.5);
    detailNoise = max(detailNoise - erosionThreshold, 0.0);

    // Erode。侵蚀强度是**旋钮**（GUI「边缘侵蚀」→ cloudParams1.x，出厂 0.14 ≈
    // 参考硬编码的 0.15）；参考把 0.15 写成常量，这里提到 lane 上便于对齐手感。
    float erosionStrength = clamp(cam.cloudParams1.x, 0.0, 1.0);
    float cloudDensity = clamp(cloudBase - detailNoise * erosionStrength, 0.0, 1.0);
    // 垂直 shaping：参考是 pow2(h*PI)。指数做成倍率旋钮（cloudParams3.w，出厂 1.0）。
    const float verticalPower = clamp(2.0 * cam.cloudParams3.w, 0.5, 6.0);
    cloudDensity *= pow(normalizedHeight * V2_PI, verticalPower);

    return cloudDensity * densityMultiplier * 5.0;
}

float v2CalculateDensityForLayer(
    vec3 worldPos,
    float densityMultiplier,
    float baseAltitude,
    float coverageMultiplier,
    float coverageMultiplierRain,
    float layerThickness,
    bool isLowQ,
    int octaves,
    float positionScale,
    float cloudsTime,
    float wetness)
{
    return v2DensityFromColumn(
        worldPos,
        v2SampleColumn(worldPos.xz, cloudsTime, positionScale, layerThickness, wetness),
        densityMultiplier, baseAltitude, coverageMultiplier, coverageMultiplierRain,
        layerThickness, isLowQ, octaves, positionScale, cloudsTime, wetness);
}

struct V2CloudSettings
{
    float minAltitude;
    float maxAltitude;
    float cloudHeight;
    float cloudCoverage;
    float cloudDensity;
    float cloudScale;
    // 参考的 CLOUDS_TIME 是每帧常量宏；这里提前算一次，避免每条密度评估
    // 重复做同一次除法（50+ 次/样本）。
    float cloudsTime;
};

// 噪声八度：参考是 VOLUMETRIC_CLOUDS_NOISE_OCTAVES 设置项（出厂 1）。
// 本引擎复用原「翻腾速度」lane（cloudParams1.z，v1 用它做竖直翻腾，v2 不读翻腾）。
int v2NoiseOctaves()
{
    return clamp(int(cam.cloudParams1.z + 0.5), 0, V2_MAX_OCTAVES);
}

// Clouds.fsh:158-160
float v2GetVolumetricClouds(vec3 position, const V2CloudSettings vcs, bool isLowQ)
{
    return v2CalculateDensityForLayer(
        position,
        vcs.cloudDensity,
        vcs.minAltitude,
        vcs.cloudCoverage,
        v2CoverageRain(vcs.cloudCoverage),
        vcs.cloudHeight,
        isLowQ,
        v2NoiseOctaves(),
        vcs.cloudScale,
        vcs.cloudsTime,
        clamp(cam.weatherParams.x, 0.0, 1.0));
}

// ---------------------------------------------------------------------------
// 光照核：Clouds.fsh:162-215 逐字移植
// ---------------------------------------------------------------------------
float v2CalculateCloudSunVisibility(
    vec3 position,
    const V2CloudSettings vcs,
    int steps,
    bool useDitheredSunlight,
    bool useSimplifiedShaping,
    vec3 lightDirection)
{
    float stepSize = vcs.cloudHeight / float(max(steps, 1));
    vec3 increment = lightDirection * stepSize;
    const float topAltitude = vcs.minAltitude + vcs.cloudHeight;

    if(useDitheredSunlight)
        position += v2Hash33(position).x * increment;

    float transmittance = 1.0;

    for(int i = 0; i < V2_MAX_SUN_STEPS; ++i)
    {
        if(i >= steps) break;
        position += increment;
        // 2026-10-17 性能：太阳在云层之上 ⇒ 越过云顶后密度恒 0（:81 早退），
        // 剩余步全是恒等 ⇒ 直接跳出。**逐位等价**。
        if(position.y > topAltitude) break;
        float opticalDepth = v2GetVolumetricClouds(position, vcs, useSimplifiedShaping);
        float stepTransmittance = exp(-opticalDepth);
        transmittance *= stepTransmittance;

        if(transmittance < V2_MIN_TRANSMITTANCE_SUN) break;
    }

    transmittance = clamp(
        v2Remap(transmittance, V2_MIN_TRANSMITTANCE_SUN, 1.0, 0.0, 1.0), 0.0, 1.0);
    return transmittance;
}

float v2CalculateCloudSkyVisibility(
    vec3 position,
    const V2CloudColumn column,
    const V2CloudSettings vcs,
    bool useSimplifiedShaping)
{
    const int steps = V2_SKY_STEPS;
    float stepSize = vcs.cloudHeight / float(steps);
    const float topAltitude = vcs.minAltitude + vcs.cloudHeight;
    // 天光消光：参考常量 0.075。旋钮 cloudParams6.z（原「云顶随云量拉伸」，出厂 0.0
    // ⇒ 0.075），每 +1 让天光在云内衰减更快（云更"厚"更暗）。
    const float skyExtinction = V2_SKY_EXTINCTION * (1.0 + max(cam.cloudParams6.z, 0.0));
    int octaves = useSimplifiedShaping ? 0 : v2NoiseOctaves();
    float wetness = clamp(cam.weatherParams.x, 0.0, 1.0);

    vec3 increment = vec3(0.0, 1.0, 0.0) * stepSize;

    float transmittance = 1.0;

    for(int i = 0; i < V2_SKY_STEPS; ++i)
    {
        position += increment;
        // 2026-10-17 性能：越过云顶后密度恒 0（:81 的早退）⇒ 剩余步全是恒等，
        // 直接跳出。**逐位等价**（只是省掉 0 贡献的迭代）。
        if(position.y > topAltitude) break;
        float opticalDepth = v2DensityFromColumn(position, column,
            vcs.cloudDensity, vcs.minAltitude, vcs.cloudCoverage,
            v2CoverageRain(vcs.cloudCoverage), vcs.cloudHeight, useSimplifiedShaping,
            octaves, vcs.cloudScale, vcs.cloudsTime, wetness);
        float stepTransmittance = exp(-opticalDepth * skyExtinction);
        transmittance *= stepTransmittance;

        if(transmittance < V2_MIN_TRANSMITTANCE_SUN) break;
    }

    transmittance = clamp(
        v2Remap(transmittance, V2_MIN_TRANSMITTANCE_SUN, 1.0, 0.0, 1.0), 0.0, 1.0);
    return transmittance;
}

// Clouds.fsh:210-215：每样本恰好两项（直射 + 天光），没有顶/底色对、
// 没有高度增益、没有底遮蔽权重 —— 顶底差全部来自上面两条真实 OD march。
vec2 v2CalculateCloudScattering(
    vec3 position,
    const V2CloudColumn column,
    float phase,
    float VoL,
    const V2CloudSettings vcs,
    float odSample,
    int dirLightSteps,
    vec3 lightDirection)
{
    float sunLighting = v2CalculateCloudSunVisibility(
        position, vcs, dirLightSteps, true, true, lightDirection) *
        v2Powder(odSample, VoL) * phase * V2_PI * 2.0;
    float skyLighting = v2CalculateCloudSkyVisibility(position, column, vcs, true) *
        V2_PHASEG0 * V2_PI;

    return vec2(sunLighting, skyLighting);
}

// ---------------------------------------------------------------------------
// 射线壳层 + march：Clouds.fsh:217-287
// ---------------------------------------------------------------------------
struct V2MarchResult
{
    vec2 scattering;      // (sun 权重和, sky 权重和)，合成口径见 C5
    float transmittance;  // 已 remap（MIN_TRANSMITTANCE 地板）
    float cloudDistance;  // 首个云样本距离（本引擎 .r 语义）
    float meanDistance;   // 透射率加权平均云深（本引擎 .g 语义）
};

V2MarchResult v2CalculateVolumetricClouds(
    vec3 worldVector,
    float terrainDistance,
    float dither,
    int steps,
    int dirLightSteps,
    vec3 lightDirection,
    vec3 cameraPosition,
    const V2CloudSettings vcs)
{
    V2MarchResult result;
    result.scattering = vec2(0.0);
    result.transmittance = 1.0;
    result.cloudDistance = V2_EMPTY_DISTANCE;
    result.meanDistance = 0.0;

    float VoL = dot(worldVector, lightDirection);
    float phase = v2Phase2Lobes(VoL, v2ForwardPhaseG());
    float rSteps = 1.0 / float(max(steps, 1));
    float wetness = clamp(cam.weatherParams.x, 0.0, 1.0);

    // 球壳与 tyndallHeight 同一约定（anchor + 行星半径，有理化根式）：
    // 云底壳 = TYNDALL_RADIUS，云顶壳 = TYNDALL_RADIUS + thickness。
    vec2 outerIntersection;
    if(!tyndallSphereRoots(cameraPosition, worldVector,
        TYNDALL_RADIUS + vcs.cloudHeight, outerIntersection) ||
        outerIntersection.y <= 0.0)
    {
        return result;
    }
    vec2 innerIntersection;
    tyndallSphereRoots(cameraPosition, worldVector, TYNDALL_RADIUS, innerIntersection);

    // 相机在云底之下且视线先打到地面 ⇒ 这条射线永远碰不到云层。
    // 地面壳 = 球顶落在海平面 0 的那一层（半径 R - 云底高度）。
    if(cameraPosition.y < vcs.minAltitude && TYNDALL_RADIUS > vcs.minAltitude)
    {
        vec2 planetIntersection;
        if(tyndallSphereRoots(cameraPosition, worldVector,
            TYNDALL_RADIUS - vcs.minAltitude, planetIntersection) &&
            planetIntersection.x > 0.0)
        {
            return result;
        }
    }

    // 玩家在云层内部时切换 march 策略（参考 :249-254）。
    bool belowBase = cameraPosition.y < vcs.minAltitude;
    float startDistance = belowBase ? innerIntersection.y : outerIntersection.x;
    float endDistance = belowBase ? outerIntersection.y : innerIntersection.x;
    bool insideLayer = cameraPosition.y > vcs.minAltitude &&
        cameraPosition.y < vcs.maxAltitude;
    startDistance = insideLayer ? 0.0 : startDistance;
    endDistance = insideLayer
        ? (innerIntersection.y >= 0.0 ? innerIntersection.x : outerIntersection.y)
        : endDistance;
    endDistance = insideLayer ? min(endDistance, 2048.0) : endDistance;

    // D5：弦长上限（本引擎的远段采样保护，只作用在积分区间）。
    endDistance = min(endDistance, startDistance + V2_MAX_MARCH_LENGTH);
    endDistance = min(endDistance, terrainDistance);

    if(!(endDistance > startDistance + 0.01))
        return result;

    vec3 startPos = startDistance * worldVector;
    vec3 endPos = endDistance * worldVector;
    vec3 increment = (endPos - startPos) * rSteps;
    vec3 position = cameraPosition + startPos + increment * dither;

    float stepLength = length(increment);
    float transmittance = 1.0;
    vec2 scattering = vec2(0.0);
    // 参考在无命中时返回 length(endPos)；本引擎的 .r 是"首个命中"哨兵，
    // 空像素必须是 EMPTY（resolve/composite 靠它区分"没有云"），见 D5。
    float cloudDistance = V2_EMPTY_DISTANCE;
    float meanDistance = 0.0;
    float meanWeight = 0.0;

    for(int i = 0; i < V2_MAX_VIEW_STEPS; ++i)
    {
        if(i >= steps) break;

        float marched = length(position - cameraPosition);
        if(terrainDistance < marched && terrainDistance < V2_EMPTY_DISTANCE) break;

        // 该样本的 2D 列项（基噪 + 局部覆盖）。视图评估与天光 march 的 XZ 相同
        // ⇒ 只算一次，天光 march 里直接复用（2026-10-17 性能，逐位等价）。
        V2CloudColumn column = v2SampleColumn(position.xz, vcs.cloudsTime,
            vcs.cloudScale, vcs.cloudHeight, wetness);

        // ⚠ 参考 :268 在这里对 GetVolumetricClouds 的返回值再乘一次 vcs.cloudDensity
        // （GetVolumetricClouds 内部已经乘过）。这不是移植笔误 —— 逐字保留，
        // 因为它定义了参考云层的实际消光量级；改掉会整体改变云的不透明度。
        float odSample = v2DensityFromColumn(position, column,
            vcs.cloudDensity, vcs.minAltitude, vcs.cloudCoverage,
            v2CoverageRain(vcs.cloudCoverage), vcs.cloudHeight, false,
            v2NoiseOctaves(), vcs.cloudScale, vcs.cloudsTime, wetness) *
            vcs.cloudDensity * stepLength;
        float sampleTransmittance = exp(-odSample);

        if(odSample > 0.0)
        {
            vec2 cloudScattering = v2CalculateCloudScattering(
                position, column, phase, VoL, vcs, odSample, dirLightSteps, lightDirection);

            scattering += cloudScattering * (transmittance - transmittance * sampleTransmittance);
            meanDistance += marched * (transmittance * odSample);
            meanWeight += transmittance * odSample;
            transmittance *= sampleTransmittance;

            cloudDistance = min(cloudDistance, marched);

            if(transmittance <= V2_MIN_TRANSMITTANCE) break;
        }

        position += increment;
    }

    transmittance = clamp(
        v2Remap(transmittance, V2_MIN_TRANSMITTANCE, 1.0, 0.0, 1.0), 0.0, 1.0);

    result.scattering = scattering;
    result.transmittance = transmittance;
    result.cloudDistance = cloudDistance;
    result.meanDistance = meanWeight > 0.0 ? meanDistance / meanWeight : cloudDistance;
    return result;
}

// ---------------------------------------------------------------------------
// 引擎共享接口（逐字同 v1）
// ---------------------------------------------------------------------------
void storeEmpty(ivec2 pixel)
{
    imageStore(cloudOutput, pixel, vec4(0.0, 0.0, 0.0, 1.0));
    imageStore(cloudDepthOutput, pixel, vec4(V2_EMPTY_DISTANCE, V2_EMPTY_DISTANCE, 0.0, 0.0));
}

// Reverse-Z scene depth -> linear distance along the view ray.
float sceneDistanceForDepth(vec2 ndc, float depthValue)
{
    if(depthValue <= 1.0e-5)
    {
        return 1.0e30;
    }
    vec4 sceneViewPosition = cam.projInverse * vec4(ndc, depthValue, 1.0);
    if(abs(sceneViewPosition.w) <= 1.0e-6)
    {
        return 1.0e30;
    }
    return length(sceneViewPosition.xyz / sceneViewPosition.w);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(cloudOutput);
    if(any(greaterThanEqual(pixel, size))) return;

    bool cloudDeckEnabled = cam.cloudParams1.w >= 0.5;
    bool highCloudEnabled = cam.highCloudParams0.x >= 0.5;
    // 2026-10-23 雾与云 / 维度解耦（与 v1 逐字同义，见 volumetric_clouds.comp
    // 里那段注释）。云开关与维度门只关云，雾只由 cloudParams7.x 决定。
    const bool overworldDimension = abs(cam.weatherParams.z - 1.0) < 0.25;
    cloudDeckEnabled = cloudDeckEnabled && overworldDimension;
    highCloudEnabled = highCloudEnabled && overworldDimension;
    const bool fogWanted = cam.cloudParams7.x >= 0.5;
    if(!cloudDeckEnabled && !highCloudEnabled && !fogWanted)
    {
        storeEmpty(pixel);
        return;
    }

    // ---- 视线与场景深度（同 v1，含云图/场景分辨率不一致时的保守遮蔽）----
    vec2 ndc = (vec2(pixel) + 0.5) / vec2(size) * 2.0 - 1.0;
    ndc.y = -ndc.y;
    vec4 viewPosition = cam.projInverse * vec4(ndc, 1.0, 1.0);
    vec3 viewTarget = abs(viewPosition.w) > 1.0e-6
        ? viewPosition.xyz / viewPosition.w : viewPosition.xyz;
    vec3 worldDirection = normalize((cam.viewInverse *
        vec4(normalize(viewTarget), 0.0)).xyz);
    vec3 cameraPosition = cam.viewInverse[3].xyz;

    float rawSceneDepth = texelFetch(sceneDepth, pixel, 0).r;
    if(textureSize(sceneDepth, 0) != size)
    {
        const vec2 sceneSize = vec2(textureSize(sceneDepth, 0));
        const vec2 sceneTexel = (vec2(pixel) + 0.5) / vec2(size) * sceneSize;
        const ivec2 sceneBase = ivec2(floor(sceneTexel - 0.5));
        const ivec2 sceneLimit = ivec2(sceneSize) - ivec2(1, 1);
        float nearest = 0.0;
        for(int oy = 0; oy < 2; ++oy)
        for(int ox = 0; ox < 2; ++ox)
        {
            nearest = max(nearest, texelFetch(sceneDepth,
                clamp(sceneBase + ivec2(ox, oy), ivec2(0, 0), sceneLimit), 0).r);
        }
        rawSceneDepth = nearest;
    }
    float sceneDistance = sceneDistanceForDepth(ndc, rawSceneDepth);

    // ---- 直射方向：日落后切换成月亮（同 v1）----
    vec3 lightDirection0 = sunDirection();
    float sunElevation = lightDirection0.y;
    vec3 lightDirection = sunElevation >= 0.0 ? lightDirection0 : -lightDirection0;
    float dayAmount = smoothstep(-0.03, 0.03, sunElevation);
    float elevationMagnitude = abs(sunElevation) / V2_SOLAR_LATITUDE_35_COS;
    float rain = clamp(cam.weatherParams.x, 0.0, 1.0);

    // ---- 高层平面云（引擎层，非体积云模型）----
    float highPixelAngle = 2.0 * abs(cam.projInverse[1][1]) / float(size.y);
    float highDistance = V2_EMPTY_DISTANCE;
    vec4 highCloud = vec4(0.0, 0.0, 0.0, 1.0);
    // 2026-10-23：高层云只主世界、只在自己开关打开时采样（本 pass 现在为雾继续运行）。
    if(highCloudEnabled)
    {
        highCloud = sampleHighCloud(
            cameraPosition, worldDirection, lightDirection, highPixelAngle, highDistance);
        if(highDistance > sceneDistance)
        {
            highCloud = vec4(0.0, 0.0, 0.0, 1.0);
            highDistance = V2_EMPTY_DISTANCE;
        }
    }

    // ---- 直射颜色/能量（v1 链，含月光）----
    vec3 directLightColor = mix(vec3(0.46, 0.56, 1.00), v2SunColor(lightDirection), dayAmount);
    float directLightEnergy = mix(V2_MOON_LIGHT_SCALE * elevationMagnitude,
        6.0, dayAmount) * clamp(cam.cloudParams5.z, 0.0, 3.0);
    float moonStrength = cam.cloudMoonParams.x >= 0.0 ? cam.cloudMoonParams.x : 1.0;
    float moonPhase = cam.cloudMoonParams.y >= 0.0 ? cam.cloudMoonParams.y : 1.0;
    float moonAmount = mix(1.0, moonStrength * clamp(moonPhase, 0.0, 1.0), 1.0 - dayAmount);
    // D7：剥离 v1 模型的 6× 能量标定（见文件头）
    vec3 sunColor = directLightColor * directLightEnergy * moonAmount * V2_SUN_ENERGY_CALIBRATION;

    // ---- D6 天光：三方向 clearSkyInscatter 的 HG 加权混合 ⇒ **一个**辐亮度 ----
    float daylight = mix(V2_NIGHT_AMBIENT, 1.0,
        smoothstep(-0.10, V2_DAYLIGHT_UPPER, sunElevation));
    float skyRadianceScale = daylight * clamp(elevationMagnitude, 0.0, 1.0);
    float skyWeatherFactor = mix(1.0, 0.20, rain);
    vec3 sunSideDir = normalize(vec3(lightDirection.x, 0.20, lightDirection.z));
    vec3 antiSunDir = normalize(vec3(-lightDirection.x, 0.20, -lightDirection.z));
    vec3 radianceZenith = clearSkyInscatter(vec3(0.0, 1.0, 0.0), sunElevation,
        lightDirection, directLightColor, skyRadianceScale, skyWeatherFactor, vec3(1.0));
    vec3 radianceSunSide = clearSkyInscatter(sunSideDir, sunElevation,
        lightDirection, directLightColor, skyRadianceScale, skyWeatherFactor, vec3(1.0));
    vec3 radianceAntiSun = clearSkyInscatter(antiSunDir, sunElevation,
        lightDirection, directLightColor, skyRadianceScale, skyWeatherFactor, vec3(1.0));
    const float V2_AMBIENT_PHASE_G = 0.25;
    float weightZenith = hgPhase(dot(worldDirection, vec3(0.0, 1.0, 0.0)), V2_AMBIENT_PHASE_G);
    float weightSunSide = hgPhase(dot(worldDirection, sunSideDir), V2_AMBIENT_PHASE_G);
    float weightAntiSun = hgPhase(dot(worldDirection, antiSunDir), V2_AMBIENT_PHASE_G);
    vec3 skyColor = (radianceZenith * weightZenith +
        radianceSunSide * weightSunSide + radianceAntiSun * weightAntiSun) /
        max(weightZenith + weightSunSide + weightAntiSun, 1.0e-4);
    // 天光强度（GUI「天光强度」→ cloudParams5.w，原「云粉状暗边」lane）。
    // 参考没有这个倍率：1.0 = 参考口径，>1 提亮背光面。纯曝光旋钮，不做归一。
    skyColor *= clamp(cam.cloudParams5.w, 0.0, 3.0);

    // ---- 体积云本体 ----
    float jitter = fract(v2TemporalJitter(pixel) + v2TemporalPhase() +
        float((pixel.x ^ pixel.y) & 3) * 0.1731);
    int viewSteps = clamp(int(cam.cloudParams2.x + 0.5), 1, V2_MAX_VIEW_STEPS);
    int directLightSteps = clamp(int(cam.cloudParams2.y + 0.5), 1, V2_MAX_SUN_STEPS);

    float baseAltitude = cam.cloudParams0.x;
    float thickness = max(cam.cloudParams0.y, 1.0);
    float coverage = clamp(cam.cloudParams0.z, 0.0, 1.0);
    float cloudScale = max(baseAltitude, 1.0) / 1600.0;
    float densityKnob = clamp(cam.cloudParams0.w, 0.0, 10.0) / V2_DENSITY_GUI_REFERENCE;
    float cloudDensity = 0.015 / max(cloudScale, 1.0e-4) * densityKnob;

    float noiseScale = v2NoiseScale();
    V2CloudSettings vcs = V2CloudSettings(
        baseAltitude,
        baseAltitude + thickness,
        thickness,
        coverage,
        cloudDensity,
        noiseScale,
        v2CloudsTime(noiseScale, thickness));

    V2MarchResult clouds = V2MarchResult(vec2(0.0), 1.0, V2_EMPTY_DISTANCE, V2_EMPTY_DISTANCE);
    if(cloudDeckEnabled)
    {
        clouds = v2CalculateVolumetricClouds(
            worldDirection, sceneDistance, jitter, viewSteps, directLightSteps,
            lightDirection, cameraPosition, vcs);
    }

    // ---- 合成（C5:179-187）：scattering = sunColor*r + skyColor*g ----
    vec3 scattering = sunColor * clouds.scattering.x + skyColor * clouds.scattering.y;
    float transmittance = clouds.transmittance;
    float cloudDistance = clouds.cloudDistance;

    // ---- 高层平面云合成（同 v1）----
    if(highDistance < cloudDistance)
    {
        scattering = highCloud.rgb + highCloud.a * scattering;
    }
    else
    {
        scattering += transmittance * highCloud.rgb;
    }
    transmittance *= highCloud.a;
    cloudDistance = min(cloudDistance, highDistance);

    // ---- 体积雾（同 v1 的 2026-10-19 B 方案参考 march）----
    // 2026-10-23：环境项接沿视线的真实晴空辐亮度（与下面空气透视同一套入参，
    // skyRadianceScale / skyWeatherFactor 就是本文件 D6 天光用的那两个）。
    const vec3 fogAmbientLegacy =
        mix(vec3(0.055, 0.070, 0.125), vec3(0.62, 0.72, 0.92), dayAmount);
    const vec3 fogAmbientSky = clearSkyInscatter(
        worldDirection,
        sunElevation,
        lightDirection,
        directLightColor,
        skyRadianceScale,
        skyWeatherFactor,
        vec3(1.0));
    const vec3 fogAmbient = mix(fogAmbientLegacy, fogAmbientSky,
        clamp(cam.fogExtrasParams.z, 0.0, 1.0));

    FogResult fog = evaluateAnalyticFog(
        cameraPosition,
        worldDirection,
        sceneDistance,
        // 与 v1 的雾完全同源：directLight = 色 × 能量 × 月相
        directLightColor * directLightEnergy * moonAmount,
        lightDirection,
        fogAmbient,
        rain,
        cam.cloudParams7.x,
        cam.cloudParams7.y,
        cam.cloudParams7.z,
        cam.cloudParams7.w,
        cam.cloudParams8.x,
        cam.cloudParams8.y,
        cam.cloudParams8.z,
        cam.cloudParams8.w,
        cam.cloudParams9.x,
        cam.cloudParams9.y,
        cam.cloudParams9.z,
        cam.fogExtrasParams.y,
        cam.fogExtrasParams.w,
        cam.fogExtrasParams.x,
        // 2026-10-23 雨天地面雾浪（两个死 lane 复用，见 v1 同名段）。
        cam.cloudParams4.y,
        cam.cloudParams4.z,
        cam.cloudParams4.w,
        cam.cloudParams9.w);

    // ---- 云层空气透视（同 v1：透射率加权代表点，一次解析采样）----
    {
        float aerialStrength = clamp(cam.cloudAerialParams.x, 0.0, 2.0);
        if(aerialStrength > 0.001 && clouds.meanDistance > 0.0 &&
           clouds.meanDistance < V2_EMPTY_DISTANCE)
        {
            float aerialDistance = clamp(clouds.meanDistance, 0.0, 10000.0);
            float aerialHeightDensity = clearSkyAerialHeightDensity(
                cameraPosition, worldDirection, aerialDistance);
            vec3 aerialInscatter = clearSkyInscatter(
                worldDirection,
                sunElevation,
                lightDirection,
                directLightColor,
                skyRadianceScale,
                skyWeatherFactor,
                vec3(1.0));
            vec3 aerialExtinction = ATM_AP_BASE_EXTINCTION *
                aerialStrength * aerialHeightDensity * (1.0 + 3.0 * rain * rain);
            vec3 aerialTransmittance = exp(-aerialExtinction * aerialDistance);
            float cloudOpacity = clamp(1.0 - transmittance, 0.0, 1.0);
            vec3 withAerial = scattering * aerialTransmittance +
                aerialInscatter * (vec3(1.0) - aerialTransmittance);
            scattering = mix(scattering, withAerial, cloudOpacity);
        }
    }

    // ---- 雾与云的合成（同 v1：按 firstDistance 决定先后）----
    if(fog.transmittance < 1.0)
    {
        if(fog.firstDistance <= cloudDistance)
        {
            scattering = scattering * fog.transmittance + fog.scattering;
        }
        else
        {
            scattering += transmittance * fog.scattering;
        }
        transmittance *= fog.transmittance;
    }

    // ---- 输出：.r 首命中距离（旧消费者）/ .g 重投影距离（时域）----
    float combinedFirst = min(cloudDistance, fog.firstDistance);
    float reprojectDistance = cam.cloudMarchParams.w > 0.5
        ? clouds.meanDistance : combinedFirst;
    if(reprojectDistance <= 0.0 || reprojectDistance >= V2_EMPTY_DISTANCE)
    {
        reprojectDistance = combinedFirst;
    }
    // 2026-10-23：雾的贡献过半 ⇒ 重投影用雾自己的平均距离（理由见 v1 同名段）。
    if(1.0 - fog.transmittance > 0.5)
    {
        reprojectDistance = fog.meanDistance;
    }
    imageStore(cloudDepthOutput, pixel,
        vec4(combinedFirst, reprojectDistance, 0.0, 0.0));
    imageStore(cloudOutput, pixel, vec4(scattering, transmittance));
}
