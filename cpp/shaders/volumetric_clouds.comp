                    // 2026-10-17 顶底统一：强度 1 时归零（增益恒 1.0）——直射的顶底
                    // 差应完全由光程 OD 决定（sunlight / octaveFill 里已经算过），
                    // 这条高度线性增益是**第二套**非物理的顶底差。
                    // 用 if 而不是 mix(x, 1.0, 0.0)：保证强度 0 时逐位等于旧档。
                    float directHeightGain = 0.68 + 0.38 * heightShape;
                    if(ambientUnify > 0.001)
                        directHeightGain = mix(directHeightGain, 1.0, ambientUnify);
                    // 低太阳时受光面翻到云底/下缘（日落太阳在云层下方，
                    // 实拍亮的是云底），白天仍是顶缘亮线；sunsetGlow 插值。
                    // 2026-09-30 四修：方位门放宽 + 背面反日辉地板（常量区注释）。
#if CLOUD_FIRE_HACK
                    float rim = mix(CLOUD_FIRE_BACKFLOOR, 1.0,
                            smoothstep(CLOUD_FIRE_AZIMUTH_LOW,
                                CLOUD_FIRE_AZIMUTH_HIGH, sunSideCosine)) *
                        mix(smoothstep(0.20, 0.90, height),
                            smoothstep(0.90, 0.25, height),
                            sunsetGlow);
                    // 火烧云只留顶缘（rim）。曾把整片朝阳侧云底也一起点亮
                    // （baseGlow = smoothstep(-0.30,0.80,viewLightCosine)*(1-heightShape)，
                    // 乘 CLOUD_FIRE_BASE_STRENGTH），实拍像"整层云被泡在橘色染料里"，
                    // 不像火烧云 —— "半边天橘色"指的是天空，不是云。屏蔽保留为选项：
                    // 想要更大的火烧云，先调 CLOUD_FIRE_RIM_STRENGTH，再考虑改回这里。
#if 0
                    float baseGlow = smoothstep(-0.30, 0.80, viewLightCosine) * (1.0 - heightShape);
#endif
                    // 云边火光跟随曙暮光色相：拂晓冷紫、清晨玫瑰金、傍晚橘。
                    // 2026-09-30 夕阳感二修：火 rim 是直射阳光的边缘散射，
                    // 必须尊重云的自阴影（被云体挡住的火光要暗下来）——
                    // 旧档无条件全额叠加，把光 march 的结构全部盖平，
                    // 朝阳半边成无自阴影的奶油色。日落时 rim 翻到云底后
                    // 覆盖面变大，强度同步下调（银边强度是按白天顶缘调的）。
                    // 2026-09-30 三修：自阴影因子换成几何朝日面遮罩（常量区注释），
                    // 旧的 mix(0.35,1.0,sunlight) 保留在 #else 里逐字节可回退。
#if CLOUD_FIRE_FACE_MASK
                    // 朝真太阳探一拍密度：邻居更密 ⇒ 我在云体内部/背光侧 ⇒ 不沾火光。
                    float sunwardDensity = tyndallDensity(
                        position + lightDirection0 *
                            (max(cam.cloudParams0.y, 1.0) * CLOUD_FIRE_FACE_PROBE_SCALE),
                        false, footprint);
                    float sunwardRatio = min(1.0, sunwardDensity / max(density, 1.0e-6));
                    float fireLitFace = 1.0 - smoothstep(CLOUD_FIRE_FACE_LOW,
                        CLOUD_FIRE_FACE_HIGH, sunwardRatio);
#else
                    float fireLitFace = mix(0.35, 1.0, sunlight);
#endif
#if CLOUD_FIRE_TINT_MODE
                    // 五修：染色比例（0..1）与亮度无关；色相盘按 Rec.709 亮度归一化
                    // ⇒ 混合后亮度不变（常量区注释）。
                    float fireAmount = saturate(sunsetGlow *
                        CLOUD_FIRE_TINT_STRENGTH * rim * fireLitFace * warmBand);
                    vec3 firePalette = twilightPalette(sunElevation);
                    vec3 fireHue = firePalette /
                        max(dot(firePalette, vec3(0.2126, 0.7152, 0.0722)), 1.0e-3);
#else
                    vec3 fireTint = twilightPalette(sunElevation) * sunsetGlow *
                        rim * fireRimStrength *
                        mix(1.0, 0.60, sunsetGlow) *
                        fireLitFace * warmBand;
#endif
#else
                    // ── 参考口径（CLOUD_FIRE_HACK=0）：没有火烧云经验项 ──
                    // 曙暮的暖色只来自三处物理来源：
                    //   ① sampleDirectLight 的太阳色沿光程红化（云体红化旋钮）
                    //   ② Hillaire octave 级联把橘色直射带到侧光受光面
                    //   ③ phi_fwd 漫射场（乘的就是红化后的太阳色）与边界受光
                    // 火 rim / 暮色盘染色 / 朝日面遮罩 / 暖带 / 扇区门全部退场。
                    vec3 fireTint = vec3(0.0);
#endif
                    // Keep highlights present at the sun-facing rim while
                    // letting the restored light march make cloud cores and
                    // undersides read.
#if CLOUD_POWDER_SHADING
                    float sampleTransmittanceP = exp(-density * cam.cloudParams2.z * stepLength);
                    // #7：粉末强度也进 GUI（<=0 回落旧档常量 0.45）。
                    float powderStrengthShade = cam.cloudLightParams2.w > 0.0
                        ? cam.cloudLightParams2.w : 0.45;
                    // 参考 powder（Clouds.fsh:29-34）：
                    //   p = 1 - 0.97*exp(-d)；powder = mix(1.5p, 0.8, VoL*0.5+0.5)
                    // 用本步的光学厚度（density*sigmaT*stepLength）代替参考的 sampleDensity。
                    float refPowderP = 1.0 - 0.97 *
                        exp(-density * cam.cloudParams2.z * stepLength);
                    float powderShade = mix(refPowderP * 1.5, 0.8,
                        viewLightCosine * 0.5 + 0.5);
                    float phaseEffective =
                        max(phase, max(goldenPhaseFloor, moonPhaseFloor));
                    vec3 baseRadiance;
                    if(cam.cloudLightParams2.z > 0.5)
                    {
                        // ── #7 参考口径（参考 PowderEffect 不施加于方向性散射）──
                        // 方向性项不吃粉末 ⇒ 云缘亮边保留（旧档把迎光边缘一起压暗，
                        // 银边变钝、体积感弱）。环境/漫射项取而代之乘上粉末。
                        baseRadiance = sampleDirectLight *
                            (sunlight * phaseEffective + octaveFill) *
                            (directHeightGain) + ambient * powderShade;
                    }
                    else
                    {
                        // 旧档：粉末乘在方向性项上（表达式逐字保留）。
                        baseRadiance = sampleDirectLight *
                            (sunlight * phaseEffective + octaveFill) * powderShade *
                            (directHeightGain) + ambient;
                    }
#else
                    float phaseEffective =
                        max(phase, max(goldenPhaseFloor, moonPhaseFloor));
                    vec3 baseRadiance = sampleDirectLight *
                        (sunlight * phaseEffective + octaveFill) * (directHeightGain) + ambient;
#endif
                    // 地面漫反射从云层下界进入。2026-10-16 起改用 downwardAO：
                    // 旋钮关闭时它就是原来的 (1-h) 几何代理（逐位旧档），
                    // 开启时换成真实向下光学深度（与云底环境光共用同一套遮蔽）。
                    baseRadiance += groundBounceRadiance * downwardAO;
#if !CLOUD_FIRE_HACK
                    // 参考 EvaluateCloud：方向性项与**环境项**都乘"有效源强"
                    // 曲线；phi_fwd 不乘（它本身就是漫射场能量，下方单独注入）。
                    baseRadiance *= scatterSourceAmount;
#endif
                    // phi_fwd 注入（常量区注释块）：加性各向同性项，不乘相位/
                    // powder/高度形，与方向性项正交；随下方
                    // (1-sampleTransmittance)·transmittance 既有管线出射。
                    // 乘样本红化后的太阳色（批次1-A）⇒ 夕阳时漫射场自动偏橘；
                    // directLight 自带昼夜/日落阻尼 ⇒ 夜云拿到月光补光。
                    if(phiSource > 0.0)
                    {
                        // 参考把 Compress 做成 uniform（_HP_HpHpPhiFwd_Compress）；
                        // UBO 的 cloudPhiParams.z >= 0 以它为准（0=线性是合法值），
                        // <0 回落到编译期宏。
                        float compress = cam.cloudPhiParams.z >= 0.0
                            ? cam.cloudPhiParams.z : CLOUD_PHIFWD_COMPRESS;
                        float phiMapped = (compress > 0.0)
                            ? (1.0 - exp(-phiSource * cam.cloudMsParams.x *
                                compress)) / compress
                            : phiSource * cam.cloudMsParams.x;
                        baseRadiance += phiMapped * sampleDirectLight;
                    }
#if CLOUD_FIRE_TINT_MODE
                    // 保亮度染色（常量区注释）：亮度取自混合前的底，色相取自暮色盘。
                    vec3 radiance = mix(baseRadiance,
                        fireHue * dot(baseRadiance, vec3(0.2126, 0.7152, 0.0722)),
                        fireAmount);
#else
                    vec3 radiance = baseRadiance + fireTint;
#endif
                    float sampleTransmittance = exp(-density * cam.cloudParams2.z * stepLength);
                    scattering += radiance * (1.0 - sampleTransmittance) * transmittance;
                    transmittance *= sampleTransmittance;
                }
                distance += stepLength * VL_FAR_STEP_SCALE(distance);
            }
        }
    }

    if(highDistance < firstCloudDistance) {
        scattering = highCloud.rgb + highCloud.a * scattering;
    } else {
        scattering += transmittance * highCloud.rgb;
    }
    transmittance *= highCloud.a;
    firstCloudDistance = min(firstCloudDistance, highDistance);





    // ── 体积雾 ────────────────────────────────────────────────────────
    // 完整设计与参数车道见 volumetric_fog.glsl 头注释。
    // 当前实现不是旧的解析闭式高度雾：
    //   ① 密度由 fogDensityAt() 按参考的双高度带计算，本身仍是世界坐标的纯函数；
    //   ② 沿视线做指数前密 march，透过率逐样本累乘；
    //   ③ 抖动是固定 4×4 Bayer（fogDitherPhase），不做时域累积；太阳可见性用
    //      本工程的近/远阴影图查询，不是旧的固定间隔解析取样。
    // 2026-10-23：环境入散射从"两色插值"换成沿视线的**真实晴空辐亮度**
    // （clearSkyInscatter，与云层空气透视同一个函数、同一套入参），按
    // fogExtrasParams.z 混入 —— 0 即逐位旧档。日出日落时雾自己泛红/泛紫，
    // 不需要再加调色板。旧配色保留为 strength=0 的分支。
    const vec3 fogAmbientLegacy =
        mix(vec3(0.055, 0.070, 0.125), vec3(0.62, 0.72, 0.92), dayAmount);
    // 2026-10-23 修正：环境项取**半球平均**（fogSkyAmbient），不再用视线方向的
    // 辐亮度 —— 后者含 Mie 前向瓣，会在太阳的屏幕位置烧出一块白斑，
    // 而且只吃环境压暗地板（0.35）⇒ 隔墙/洞里照样发光。
    const vec3 fogAmbientSky = fogSkyAmbient(
        worldDirection,
        sunElevation,
        lightDirection,
        directLightColor,
        daylight * clamp(elevationMagnitude, 0.0, 1.0),
        mix(1.0, 0.20, rain));
    const vec3 fogAmbient = mix(fogAmbientLegacy, fogAmbientSky,
        clamp(cam.fogExtrasParams.z, 0.0, 1.0));

    FogResult fog = evaluateAnalyticFog(
        cameraPosition,
        worldDirection,
        sceneDistance,
        directLight,
        lightDirection,
        fogAmbient,
        rain,
        cam.cloudParams7.x,   // enabled
        cam.cloudParams7.y,   // baseDensity（每格消光）
        cam.cloudParams7.z,   // heightBlock（密度 = baseDensity 的高度）
        cam.cloudParams7.w,   // scaleHeight（标高，格）
        cam.cloudParams8.x,   // anisotropyG
        cam.cloudParams8.y,   // sunStrength
        cam.cloudParams8.z,   // ambientStrength
        cam.cloudParams8.w,   // maxDistance（雾最远作用距离，格）
        cam.cloudParams9.x,   // startDistance（近处留白，格）
        cam.cloudParams9.y,   // sunSteps（1..8，无抖动）
        cam.cloudParams9.z,   // rainBoost（雨强把密度乘到这个倍数）
        // 2026-10-23 追加三项：
        cam.fogExtrasParams.y,   // groundAnchor（密度带锚到逐列地面；0 = 旧档）
        cam.fogExtrasParams.w,   // temporalJitter（逐帧低差异抖动；0 = 旧档）
        cam.fogExtrasParams.x,   // dynamicLightStrength（方块光进雾；0 = 旧档）
        // 2026-10-23 雨天地面雾浪（复用两个死 lane，见 VulkanCore.cpp 的注释）：
        cam.cloudParams4.y,      // wispEnabled（0/1）
        cam.cloudParams4.z,      // wispStrength（每格消光的倍率）
        cam.cloudParams4.w,      // wispWavelength（格）
        cam.cloudParams9.w       // wispSpeed（格/秒）
    );

    // ── 2026-10-10 #1：云层空气透视（透射率加权**代表点**）────────────
    // 云 march 内累积：
    //     rayHitPos += marchingPos * cloudTransmittance;  sumTransmit += T;
    // 出循环 rayHitPos /= sumTransmit，然后**只采一次**大气模型
    // （GetSkyRadianceToPoint）。比逐样本采样省一个数量级，又比"整层一个雾色"准
    // —— 云体的远近不同 ⇒ 颜色不同，而近处几乎不变。
    //
    // 本文件的 meanDistAccum/meanDistWeight（批次2-T2c 建立的"透射率加权平均云深"）
    // 就是同一个代表点，零额外 march。应用口径：云层辐亮度按代表距离过一遍解析
    // 晴空（乘透过率 + 补 in-scatter），再按**云自身的不透明度**混回 ⇒ 无云像素与
    // 云后天空逐位不变。放在雾与云的合成**之前**：先给云上大气，再让雾按自己的
    // 距离在前/在后合成（雾的近地散射不会被云的距离过度吸收）。
    // 滑杆（CameraUBO.cloudAerialParams.x）出厂 0 ⇒ 整段不执行。
    {
        float aerialStrength = clamp(cam.cloudAerialParams.x, 0.0, 2.0);
        if(aerialStrength > 0.001 && meanDistWeight > 0.0)
        {
            // 代表点 = 透射率加权平均云深（与末尾写进 .g 的 cloudMeanDistance 同式，
            // 此处提前算一次，因为文件末尾那一行在这之后）。
            float aerialDistance = clamp(meanDistAccum / meanDistWeight, 0.0, 10000.0);
            float aerialHeightDensity = clearSkyAerialHeightDensity(
                cameraPosition, worldDirection, aerialDistance);
            // 雨里把大气散射压到 20%（rgen 的 getWeatherSkyRadianceFactor 同式）：
            // 雨云后面不该是"晴空的蓝"。
            float aerialWeatherFactor = mix(1.0, 0.20, rain);
            vec3 aerialInscatter = clearSkyInscatter(
                worldDirection,
                sunElevation,
                lightDirection,
                directLightColor,
                daylight * clamp(elevationMagnitude, 0.0, 1.0),
                aerialWeatherFactor,
                vec3(1.0));
            vec3 aerialExtinction = ATM_AP_BASE_EXTINCTION *
                aerialStrength * aerialHeightDensity * (1.0 + 3.0 * rain * rain);
            vec3 aerialTransmittance = exp(-aerialExtinction * aerialDistance);
            float cloudOpacity = clamp(1.0 - transmittance, 0.0, 1.0);
            vec3 withAerial = scattering * aerialTransmittance +
                aerialInscatter * (vec3(1.0) - aerialTransmittance);
            scattering = mix(scattering, withAerial, cloudOpacity);
        }
    }


    // ── 体积雾合成（与云共用同一条 scattering/transmittance 链）────────────
    // 排序判据按“第一段被占据的距离”比较（雾从 firstDistance 起、云从
    // firstCloudDistance 起）。雾密度集中在低空、云在千米之上，所以一次比较就够。
    // 注意 transmittance 仍是**标量**：B 方案的 fogDensityAt() 只产生标量消光，
    // 不像旧版瑞利通道那样需要亮度折叠。
    if(fog.transmittance < 1.0)
    {
        if(fog.firstDistance <= firstCloudDistance)
        {
            scattering = scattering * fog.transmittance + fog.scattering;
        }
        else
        {
            scattering += transmittance * fog.scattering;
        }

        transmittance *= fog.transmittance;
    }

    // 批次2-T2c：.r = 首命中距离（旧语义；雾也算"第一段被占据的距离"），
    // .g = 重投影距离（透射率加权平均云深；关闭或无云时回落首命中）。
    float combinedFirst = min(firstCloudDistance, fog.firstDistance);
    float cloudMeanDistance = meanDistWeight > 0.0
        ? meanDistAccum / meanDistWeight : combinedFirst;
    float reprojectDistance = cam.cloudMarchParams.w > 0.5
        ? cloudMeanDistance : combinedFirst;
    // 2026-10-23：雾也要提供重投影深度。combinedFirst 在 startDistance=0（出厂）时
    // 恒为 0，拿它重投影等于不做视差 ⇒ 逐帧抖动的雾会被 resolve 拖成条。
    // 判据（自创的启发式）：雾不透明度过半 ⇒ 这个像素以雾为主，用雾自己的
    // 透射率加权平均距离；否则保留云的深度（云缘拖影由 resolve 的邻域裁剪兜底）。
    if(1.0 - fog.transmittance > 0.5)
    {
        reprojectDistance = fog.meanDistance;
    }
    imageStore(cloudDepthOutput, pixel,
        vec4(combinedFirst, reprojectDistance, 0.0, 0.0));
    imageStore(cloudOutput, pixel, vec4(scattering, transmittance));
}
