#version 460
#extension GL_GOOGLE_include_directive : require

// Vulkan compute adaptation of the MIT-licensed tyndall-clouds density and
// lighting model. The original procedural FBM is represented by precomputed
// 3D noise fields so the half-resolution temporal path remains practical.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform CameraProperties
{
    #include "camera_ubo.glsl"
} cam;

layout(set = 0, binding = 1) uniform sampler3D cloudShapeNoise;
layout(set = 0, binding = 2) uniform sampler3D cloudCurlNoise;
layout(rgba16f, set = 0, binding = 3) uniform writeonly image2D cloudOutput;
layout(rg32f, set = 0, binding = 4) uniform writeonly image2D cloudDepthOutput;
// Reverse-Z scene depth, written by the raygen and already synchronised to
// COMPUTE_SHADER by the time this pass runs.  It is the *same* resolution as
// this dispatch, so a plain texelFetch is exact.  Needed because the fog and
// the high-cloud plane must not be drawn in front of geometry: without it the
// composite would have to keep refusing to touch anything but sky pixels.
layout(set = 0, binding = 5) uniform sampler2D sceneDepth;
// 太阳阴影图（近场 1024²、R32F、最近邻）。由 rt_sun_shadow.comp 每帧写一次。
// 只用在体积雾的太阳可见性查询上：云层本身在几千米高空，地形挡不到它。
layout(set = 0, binding = 6) uniform sampler2D sunShadowMap;
// 地形高度场（512²、R32F、最近邻）。由 rt_terrain_height.comp 每帧写一次，
// 存每个 XZ 列的地面世界 Y。旧档贴地板雾曾按"离这一列地面多高"算剖面；
// 2026-10-19 B 方案改用参考的双高度带，当前不再调用，绑定只为旧档兼容。
// 生产者的 cull mask 排除了树叶/玻璃/玩家代理，所以拿到的实心地面不含树冠。
layout(set = 0, binding = 7) uniform sampler2D terrainHeightMap;

#ifndef CLOUD_MAX_VIEW_STEPS
// 2026-10-02 Route A：64 → 96。抬射程后地平线附近弦长可达数百 km，64 步摊到
// 200+ km 上每步数 km，云形被量化掉。上限只在掠射窄带被触及，成本可控。
#define CLOUD_MAX_VIEW_STEPS 96
#endif
const int MAX_VIEW_STEPS = CLOUD_MAX_VIEW_STEPS;
// 2026-09-30 远处云马赛克修复：掠射时穿过厚云层的弦长可达几十公里，
// 固定 viewSteps 摊上去每步好几公里，密度被步长量化成块状。两道闸：
//   1. march 弦长钳到 CLOUD_MAX_MARCH_LENGTH（超出部分不积分 ⇒ 该像素透射率
//      保持 <1，合到天空上退成平滑远雾）；
//   2. 长弦自适应加密：步数按 sqrt(弦长/8km) 放大（至多到 MAX），
//      sqrt 是折中——线性放大在 60km 弦时会把步数推到 200+。
#ifndef CLOUD_MAX_MARCH_LENGTH
// 2026-10-02 Route A：48 km → 260 km。旧值 48 km 在射程被抬到地平线（R=6360 km
// 时出壳 ≈277 km）后会在地平线之前把掠射视线裁断，重现硬边。
#define CLOUD_MAX_MARCH_LENGTH 260000.0
#endif
// 2026-10-07：掠射带自适应加密的**上限倍率**（相对本档的基础步数；0 = 旧档 =
// 恒用 MAX_VIEW_STEPS）。见 march 里那段注入点的说明：原来的 clamp(..., viewSteps, 96)
// 下限是档位值、上限恒 96，导致弦长一长（地平线带）连性能档也被顶到 80+ 步，
// 三档成本被拉平。K=4 时性能 16→64 / 平衡 20→80 / 高质量 28→112 仍钳到 96 ⇒
// 高质量档逐位不变，只有低档位真正省下来。
#ifndef CLOUD_GRAZING_STEP_CAP_MULTIPLE
#define CLOUD_GRAZING_STEP_CAP_MULTIPLE 4
#endif
const int MAX_LIGHT_STEPS = 6;
const float PI = 3.14159265359;
const float CLOUD_DEPTH_EMPTY = 1000000.0;
// 2026-10-17 参考值（VolumetricSettings.glsl: VOLUMETRIC_CLOUDS_MIN_TRANSMITTANCE = 0.2）：
// 透射率降到 0.2 就停止 march（参考 Clouds.fsh:277）。两个作用：
//   ① 性能：厚云内部不再空算后续步（我们原先 0.015，几乎要走到光完全被吃掉）；
//   ② 观感：云心更快"饱和成实心"，与参考的厚实感一致。
const float MIN_TRANSMITTANCE = 0.2;

// Day/night cloud lighting.  The raygen already swaps the sun for the moon
// after sunset (getTimeDrivenSkyLightDirection) and scales the moonlight to
// TIME_DRIVEN_MOON_NOON_SCALE / TIME_DRIVEN_SUN_NOON_SCALE of noon sunlight.
// The cloud deck previously ignored both: it kept lighting itself from a
// below-horizon sun and its ambient had no night response at all, which is
// why the deck stayed as bright as noon after dark.
const float CLOUD_SUN_LIGHT_SCALE = 6.0;
// 2026-10-01 夜色还原：Bruneton 夜空只剩蓝地板时，按原 2.5% 正午档的月光
// 直射会把夜云压成黑块。云不读天空 LUT（独立解析光照），所以在这里补：
// 夜间直射抬到约 4% 正午档，环境地板 0.03 → 0.08，让受光面重新读出月光。
const float CLOUD_MOON_LIGHT_SCALE =
    CLOUD_SUN_LIGHT_SCALE * (0.05 / 1.22077458876);
// Floor for the (non-sun) ambient term.  The high-cloud plane already uses
// 0.012 for the same purpose.
const float CLOUD_NIGHT_AMBIENT = 0.08;
const float SOLAR_LATITUDE_35_COS = 0.81915204429;

// ── 2026-10-10 #3：天光可见度的竖直 march 标定 ──────────────
// 参考 Clouds.fsh:187 CalculateCloudSkyVisibility：以 cloudHeight/32 的步长从样本
// 竖直向上 march 32 步，每步取云密度做光学厚度，最后 exp(-OD) 得"从这一点往上看，
// 有多少天光能进来"。这里把它做成**可选质量档**（出厂强度 0 = 关），步数受 UBO
// cloudTemporalParams.y 覆盖，上限由宏兜底（循环必须有编译期界）。
const int CLOUD_SKY_VIS_STEPS = 6;
const int CLOUD_SKY_VIS_MAX_STEPS = 16;
// 消光系数：参考按 cloudHeight/32 的步长直接累密度，这里换算成"每格光学厚度"。
// 2% 的竖直消光让一层中等云给 upwardAO ≈ 0.3~0.6，与解析近似同量级。
const float CLOUD_SKY_VIS_EXTINCTION = 0.02;

float saturate(float value)
{
    return clamp(value, 0.0, 1.0);
}

// 每像素的**静态**随机基（只跟像素坐标有关，不含帧号）。
float temporalJitter(ivec2 pixel)
{
    uint state = uint(pixel.x) * 1973u + uint(pixel.y) * 9277u + 911u;
    state ^= state >> 16u;
    state *= 2246822519u;
    state ^= state >> 13u;
    return float(state & 0x00ffffffu) / float(0x01000000u);
}

// 帧间相位：黄金比（0.618…）低差异序列。
//
// 2026-10-06 修"云的噪点闪动"：原来是把 cam.frameCount **直接揉进上面的哈希**
// ⇒ 每帧一个独立白噪声。而云的时域历史只有 3~5 帧（volumetric_cloud_resolve.comp
// 的权重 0.72~0.80），白噪声在这么短的窗口里平均不收敛，残差就是那种低频"沸腾"；
// 空间滤波（volumetric_cloud_atrous）压不掉它 —— 实测该能量既非高频、也不是整体
// 位移，所以只能靠时域，而时域又受"云缘拖影"限制，权重不能一直往上抬。
//
// 换成黄金比序列后，任意长度的连续窗口里采样都近似**均匀铺满** [0,1) ⇒ 步进平均
// 在 3~5 帧内就基本收敛。这正是"低差异"相对"白噪声"的全部价值：同样的帧数、同样
// 的采样数，残差从 ~1/√N 掉到接近 0，而不是靠堆历史帧数。
//
// 只取低 10 位是 fp32 精度考虑：frameCount 跑几小时后仍然精确（1024 帧的周期远长于
// 任何 history 窗口，所以不会看出重复）。
float temporalPhase()
{
    return float(cam.frameCount & 0x3ffu) * 0.6180339887498949;
}


#include "sky_model_common.glsl"

// 2026-09-30 P2：实现移入 sky_model_common.glsl（单一共享版本）。
// goldenStrength=0.5（云半档：全档曾与 fireTint 双叠全橘，09-26 定档）
vec3 sunColor(vec3 lightDirection)
{
    return skyModelSunColor(lightDirection, 0.5);
}

// 亮度归一化的色相提取（#2 天光色相 / #5 光路红化 / #6 散射染色共用）。
// 除以 Rec.709 亮度 ⇒ **只取色相、不改亮度**，新旋钮因此不会把云整体调亮/调暗，
// 只会改变色彩走向（这也是这几项能安全默认开启的原因）。
vec3 cloudHueOf(vec3 c)
{
    return c / max(dot(c, vec3(0.2126, 0.7152, 0.0722)), 1.0e-3);
}

// 火烧云强度：rim 是朝阳侧的顶缘亮线（唯一决定火烧云大小的旋钮）。
// 2026-09-30 六修（用户实测保亮度染色"太怪"，裁定回到加法火光但压暗）：
// BOOST 档 3.8 → 2.2。压得比字面的"一点"多，因为火此时已铺满全天空
// （warmBand 抬高 + 方位门拉平），总注入能量比只照朝阳侧时大得多。
// 3.8 档见 spv 备份 bak_pre_tintmode_20260930；3.0 档保留在 #else。
// 2026-10-02 批次1-C：火烧云总闸从常量改为 cloudParams6.x（fireRimStrength，
// 默认 2.2 = 旧 BOOST=1 档；BOOST=0 的 3.0 档见 spv 备份 bak_pre_tintmode_20260930）。
// 读 lane 处在主循环 fireTint；置 0 = 完全无火烧云。GUI"火烧云强度"。
// BASE 只服务于云底泛光分支，该分支已用 #if 0 屏蔽，当前无调用点。
const float CLOUD_FIRE_BASE_STRENGTH = 1.4;

// =====================================================
// 历史视觉回退常量（仅 CLOUD_FIRE_HACK=1 分支会直接使用）。
// 黄金/月光相位地板会抬高相位函数，非参与介质物理基线；默认构建
// CLOUD_FIRE_HACK=0 时由 cloudPhysicsParams.w 控制且默认关闭。
// CLOUD_SUNSET_AMBIENT_WARMTH 也只用于旧 FIRE_HACK 分支，不作为默认照明模型。
// =====================================================
#ifndef CLOUD_GOLDEN_PHASE_FLOOR
#define CLOUD_GOLDEN_PHASE_FLOOR 0.30
#endif
#ifndef CLOUD_MOON_PHASE_FLOOR
#define CLOUD_MOON_PHASE_FLOOR 0.55
#endif
#ifndef CLOUD_SUNSET_AMBIENT_WARMTH
#define CLOUD_SUNSET_AMBIENT_WARMTH 0.25
#endif

// =====================================================
// 2026-10-14 日落天光色相/能量调节（运行时旋钮 cloudSkyHueParams）。
// 这是对现有低成本环境近似的观感调节，不是天空半球辐亮度积分：当前 ambient
// 仍由 top/bottom 两个常量色、倍率与 daylight 构成，没有方向可见度输入。
//
//   CLOUD_SKYHUE_COOL：在 sunsetGlow 窗口内，把环境色相从 cloudHueOf(directLightColor)
//   向冷紫代理色插值；cloudHueOf 做亮度归一，故该旋钮只调色相、不应改变能量。
//   它不能据此推断背光能量或环境方向性已经物理正确。
//
//   CLOUD_SKYHUE_ENERGY：调节 daylight smoothstep 上界（0.15 到 0.35），改变低太阳
//   时 top/bottom 环境项的整体能量。两项的运行时参数位于 UBO 偏移 1472。
// 旧报告中对环境贡献百分比和 top/bottom 倍率链的归因未从实际 lane 消费关系证明，
// 不作为本 shader 的物理结论。
// =====================================================
#ifndef CLOUD_SKYHUE_COOL_DEFAULT
#define CLOUD_SKYHUE_COOL_DEFAULT 0.65
#endif
#ifndef CLOUD_SKYHUE_ENERGY_DEFAULT
#define CLOUD_SKYHUE_ENERGY_DEFAULT 0.50
#endif

// =====================================================
// 2026-10-15 体积云物理项清理 / 补齐（CameraUBO.cloudPhysicsParams，偏移 1488）
//
// 云是参与介质，不是实体表面；不能把 fireLitFace 的密度探针升格为通用
// Lambert 面照明。相位函数、Beer–Lambert 透过率、自阴影和多重散射才是体积光照项。
//
// Lane 语义（与 C++ / Java 设置一致）：
//   x = cloudGroundAlbedo       均匀地面的 Lambert 反照率（0..0.8；出厂 0.20）
//   y = cloudGroundBounce       是否注入直射日光的地面漫反射近似（0..1；出厂 1）
//   z = cloudSunlightResidual   非物理自阴影残光回退（0..0.25；出厂 0）
//   w = cloudPhaseFloor         非物理黄金相位地板回退（0..1；出厂 0）
//
// 新的地面项只建模均匀水平地面上的直射日光 Lambert 反射；没有地表材质、
// 地形阴影或天空漫射 irradiance 输入，因此不声称是完整的场景级地面反射。
// UBO 尾追加 1488 -> 1504。哨兵 >= 0 以 lane 为准；<0 回落默认值。
// =====================================================
#ifndef CLOUD_GROUND_ALBEDO_DEFAULT
#define CLOUD_GROUND_ALBEDO_DEFAULT 0.20
#endif
#ifndef CLOUD_GROUND_BOUNCE_DEFAULT
#define CLOUD_GROUND_BOUNCE_DEFAULT 1.0
#endif
#ifndef CLOUD_SUNLIGHT_RESIDUAL_DEFAULT
// Beer–Lambert 正确极限是 OD→∞ 时 T→0；旧 0.05 地板是非物理残光。
#define CLOUD_SUNLIGHT_RESIDUAL_DEFAULT 0.0
#endif
#ifndef CLOUD_PHASE_FLOOR_DEFAULT
#define CLOUD_PHASE_FLOOR_DEFAULT 0.0
#endif
#ifndef CLOUD_GROUND_BOUNCE_SCALE
// Lambert 漫反射 radiance = albedo * direct irradiance / PI。
#define CLOUD_GROUND_BOUNCE_SCALE 0.31830988618
#endif

// =====================================================
// 2026-09-30 余晖退场（用户夜景截图：日落后朝阳那侧的云还是一片橘）
//
// 根因：sunsetGlow 的两处暖项（fireTint 火 rim、暖环境）里，fireTint 是**加法**
// 项且**不乘 dayAmount** —— 直射太阳在 -0.03 rad 就归零了，火光却还跟着
// sunsetGlow 的下界一路挂到 -0.20 rad（≈ -11.5°）。而夜里 ambient 已经塌到
// CLOUD_NIGHT_AMBIENT=0.03 的近黑地板、云自身没有颜色，于是"全场景唯一还亮的
// 东西"就是这片橘，对比之下格外扎眼。
//
// 修法：给 sunsetGlow 乘一个"太阳沉下去就快速退场"的衰减。
//
// 锚点不是直接乘 dayAmount：dayAmount 在 e∈[-0.03,0.03] 的过渡带里就已经开始
// 降，会把"太阳正压地平线"那一刻的火烧云一起压掉三成 —— 而那一刻正是日落观感
// 最吃紧的瞬间。锚到 0 之后 e>=0 时系数逐位等于 1.0（float32 全网格实测），
// 整个白天（含贴地平线瞬间）**像素级不变**。
//
// 只作用于黄昏侧：拂晓"日出前云底先亮"是有意保留的窗口（-0.20 下界的另一个
// 用途），不能被一起砍掉，twilightEveningWeight() 正是这条晨昏分界（与
// twilightPalette 同源）。
//
// FLOOR 是余晖的深夜地板：真曙暮光不会瞬间消失，留一点微光让朝阳侧的云缘读起来
// 是暗暖灰而不是纯黑。置 1.0 = 完全关掉这项衰减（像素级等价旧档；乘法指令仍在，
// 字节级回退请用 run/shaders/volumetric_clouds.comp.spv.bak_pre_afterglowfade_20260930）。
// =====================================================
#ifndef CLOUD_AFTERGLOW_FADE_FLOOR
#define CLOUD_AFTERGLOW_FADE_FLOOR 0.25
#endif

// =====================================================
// 2026-09-30 火烧云历史视觉分支：只对 CLOUD_FIRE_HACK=1 的旧 rim 路径有意义，
// 不作为默认体积照明或云面物理模型。密度探针只调制火 rim，不能外推为通用 Lambert 面照明。
//
// 根因：fireTint 是**加法色相覆盖层**，不是面着色项。它原有的"自阴影"耦合只有
// mix(0.35, 1.0, sunlight) —— 下限 0.35，被云体挡住的样本仍拿 38% 的火光；而同
// 一时刻 ambient 已塌到 ~0.3、被挡的直射 ~0.04，橘色项比其它项大一个数量级 ⇒
// 整块云的颜色就是它的颜色。
//
// 另一半原因在 rim 的方位因子：smoothstep(0.15,0.85,dot(视线, 真太阳)) 是**视线
// 方位 × 采样高度**，沿一条射线是常量、云块内所有样本同值。它区分的是"屏幕上离
// 太阳近不近"，不是"这块云的哪一面朝太阳"。日落时更彻底：近水平光程把光 march
// 的 OD 喂饱（见 :452-457 记的"无结构平涂"），sunlight 对整块云几乎是常数，
// 那个 0.35 的地板**就是**它的实际值 ⇒ 整块云上色。
//
// 修法：给火 rim 一个**几何**的朝日面遮罩 —— 往真太阳方向探一拍密度（面尺度，
// 不是光 march 那 336 m 的饱和量），按"朝日方向的邻居相对我自己有多密"给软遮罩：
//   邻居更密（ratio→1，我在云体内部/背光侧）→ 遮罩 0，只剩环境光原色
//   邻居是净空（ratio→0，我在朝日面）      → 遮罩 1，全额火光
// ratio 是比值，无量纲，不依赖密度/消光的绝对标定。探针用真太阳方向 lightDirection0
// ——与 rim 的方位因子同源；日落时 lightDirection 已翻转成月亮，不能拿来当"太阳面"。
//
// 打开时它**取代** fireTint 里那条 mix(0.35,1.0,sunlight)：那条的 0.35 地板正是
// "整块上色"的来源，且日落时它测的是月亮方向的自阴影。置 0 = **像素级**回旧档
// （#else 分支的算式与旧档逐条相同，只多一个局部变量的 OpStore/OpLoad；字节级
// 回退请拷 run/shaders/volumetric_clouds.comp.spv.bak_pre_fireface_20260930）。
//
// 已知局限：只有一拍探针，看不见"云块之外"的遮挡（被邻云挡住的朝阳面仍会亮）。
// 直射项与环境项不受影响，全局遮挡仍由它们表达。
// =====================================================
// =====================================================================
// 2026-10-02 火烧云历史视觉分支。
//
// CLOUD_FIRE_HACK = 0（默认）：停用专为火烧云观感添加的 rim、暮色环境暖化、
// 黄金/月光相位地板和直射能量手工衰减。该分支仍使用相位函数、自阴影 OD、
// 多重散射 octave、phi_fwd 及低成本 top/bottom 环境近似；这些不是完整 RTE 解，
// 也不据此声称已得到场景级环境积分。
// CLOUD_FIRE_HACK = 1 是历史美术回退路径，其中仍保留旧地板及火 rim 探针；
// 不作为默认物理路径。独立 GUI 回退旋钮在默认分支由 UBO lane 控制。
// =====================================================================
#ifndef CLOUD_FIRE_HACK
#define CLOUD_FIRE_HACK 0
#endif
#ifndef CLOUD_SOURCE_OD_SCALE
// 参考 _HP_ScatterSourceODScale：方向性源的"有效源强"尺度。
// 参考 EvaluateCloud 的 scatterSourceAmount =
//   pow(saturate(1 - exp(-scatterOD / scale)), pow)，scatterOD = σ_t·ω0·Δs。
