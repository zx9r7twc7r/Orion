// 说明：只按公开的物理形式重写，未照搬参考代码。

float hgPhase(float cosine, float g)
{
    float g2 = g * g;
    float denominator = max(1.0e-4, 1.0 + g2 - 2.0 * g * cosine);
    return (1.0 - g2) / (4.0 * PI * denominator * sqrt(denominator));
}

