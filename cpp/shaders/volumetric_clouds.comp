// =====================================================================
// 2026-10-02 phi_fwd 物理漫射场（移植自 HanPi Volume Cloud，MIT；推导链：
// RTE → 扩散近似(τ≫1, g_eff→0) → Helmholtz + 格林函数 G=exp(-∫κds)/(4πr)
// → 源项 Q_eff × 边界置信度 → 沿太阳方向 1D 累加）。
//
// 解决的问题：单次散射 + exp(-OD·1.35) 让厚云内部/云底指数变黑，之前靠
// CLOUD_SUNLIGHT_FLOOR / CLOUD_MOON_PHASE_FLOOR 等经验地板压症状；phi_fwd
// 作为**加性各向同性项**从物理上补这层光，随 (1-T_sample)·T_view 既有管线
// 走，与方向性项（相位/powder/高度形）正交。
//
// 关键简化（相对 HP 原版，全部为了性能与标定）：
//   1. ω0=0.999 写死 ⇒ κ = OD·sqrt(3(1-ω0)) = OD×0.0548（宏内无 sqrt）；
//      源的无逃逸存活 T_cum = exp(-OD·0.001) ≈ 1，直接省略（吸收进强度）。
//   2. 源积分搭现有光 march 的便车：复用每步已采的密度样本，只多 ~10 条
//      标量指令/步，零新增纹理读。覆盖半径 = 光 march 弦长（≤336 格），
//      比 HP 的 6 km 短 —— 深处贡献低估由强度旋钮补偿。
//   3. 边界置信度使用云底深度软化与 C_top 代理：cloudPhiFwdBoundaryLight()
//      对 2D 云顶高度代理做差分并计算 wrap 光照（见该函数），不是 fireLitFace 探针。
//
// 强度标定：本实现 φ 的量级 ~0.01-0.1（弦长短、/r 几何衰减），经
// compress 软饱和后 ×cloudMsParams.x。出厂 1.5 是"云底可见泛光不洗白"档；
// HP 建议区间 0.1-2.0 基于其 6 km 弦长，此处同观感大约要 ×5。
// =====================================================================
#ifndef CLOUD_PHIFWD_OMEGA0
// 2026-10-02 参考重构：单散射反照率写死（参考 HP_PHIFWD_OMEGA0 0.999）。
// 它是 κ 与源存活率两处的唯一来源，改成宏以便把 κ 由它推导：
//   g_eff=0 ⇒ κ = σ_t·sqrt(3(1−ω0)) ⇒ κ·Δs = localOD·0.0547722（无逐步 sqrt）。
#define CLOUD_PHIFWD_OMEGA0 0.999
#endif
#ifndef CLOUD_PHIFWD_KAPPA_OD_SCALE
// sqrt(3*(1-0.999))：扩散慢衰减系数。OD=20 时漫射仍剩 ~33%——这就是
// "云芯不黑"的物理来源。
#define CLOUD_PHIFWD_KAPPA_OD_SCALE 0.0547722
#endif
#ifndef CLOUD_PHIFWD_REF_SIGMA_T
// CLOUD_PHIFWD_REF_NORMALIZE=1 用到，用来把 φ 的 σ_t² 因子归一掉。
#define CLOUD_PHIFWD_REF_SIGMA_T 0.1
#endif
#ifndef CLOUD_PHIFWD_REF_NORMALIZE
// φ 的量级标定方式：
//   0 = **本引擎标定（默认，不动优势点）**：沿用 REGIME_GAIN=60，φ 的数值与
//       已保存的 intensity 语义完全不变，画面与今天逐帧一致。
//   1 = 参考归一：把源项里的 σ_t² 乘 (σ_ref/σ_t)² 归一掉 ⇒ φ 与消光绝对值无关，
//       HP 文档给的 intensity 建议区间（0.1~2.0）可直接沿用；因为
//       (0.1/0.008)²/60 ≈ 2.6，等价画面需要把 intensity 调到约 0.58。
#define CLOUD_PHIFWD_REF_NORMALIZE 0
#endif
#ifndef CLOUD_PHIFWD_REGIME_GAIN
// 本引擎的 φ 量级标定（只在 CLOUD_PHIFWD_REF_NORMALIZE=0 时参与）。
// 60 = 出厂标定：HP 的世界 σ_t≈0.1/m、本引擎 extinction=0.008/m，φ 源项里的
// σ_t² 因子差两个数量级，加上 msBuild 尺度折算后，60× 让默认 intensity 在
// density 1~5 区间可见且被 compress 软饱和封顶（厚芯不 runaway）。
#define CLOUD_PHIFWD_REGIME_GAIN 60.0
#endif
#ifndef CLOUD_PHIFWD_BUILD_SCALE
// 各向同性建立速率（参考 _HP_HpHpPhiFwd_MSBuildScale）。UBO 的
// cloudPhiParams.y >= 0 时以它为准；<0 时回落到本宏。
#define CLOUD_PHIFWD_BUILD_SCALE 1.0
#endif
#ifndef CLOUD_PHIFWD_COMPRESS
// 最终软饱和：(1-exp(-φ·k))/k。0=线性不压缩；越大越早饱和（防厚芯过曝）。
// 参考把它做成 uniform（_HP_HpHpPhiFwd_Compress）；UBO 的 cloudPhiParams.z
// >= 0 时以它为准（0 是合法值 = 线性），<0 时回落到本宏。
#define CLOUD_PHIFWD_COMPRESS 1.5
#endif
#ifndef CLOUD_PHIFWD_BOTTOM_SOFT
// 云底软化尺度（归一化云高 0-1）。h=0 处源置信度 0（太阳不从下方注入），
// h=0.18 处恢复 63%。**参考重构**：按云柱厚度 lerp(1,4) 自适应（厚云柱底部
// 保留更多漫射、薄列几乎不注入），列厚由 cloudPhiFwdTopProxy 给出。
#define CLOUD_PHIFWD_BOTTOM_SOFT 0.18
#endif
#ifndef CLOUD_CONE_RATIO
// 参考 CONE_RATIO 2.0f：几何级数的相邻步比率（越大近密远疏越明显）。
// UBO 的 cloudPhiParams.w > 0 时以它为准。
#define CLOUD_CONE_RATIO 2.0
#endif
#ifndef CLOUD_CONE_MIN_STEP
// 参考 CONE_MIN_STEP 5.0f：首步宽度下限（步数多时反解出的 w0 可能过小）。
#define CLOUD_CONE_MIN_STEP 5.0
#endif
#ifndef CLOUD_PHIFWD_MAX_OD
// 偏离参考、**保留本实现的省算力档**（2026-10-02 用户口径："优势点不用重构"）：
// 参考的 EvaluateSunLuminance 循环里没有任何 OD 早退（它只按锥形覆盖距离走），
// 我们保留早退 —— 参考下 φ 的源恰在深处（OD=24 仍有 exp(-1.3)≈27%），早退会
// 低估它，所以这是一个"用精度换帧"的既有优势，默认保持 24（与今天逐帧一致）。
// 置 0 = 参考行为（不早退）：最深处的漫射贡献回到 100%，代价是厚云样本多跑几步。
#define CLOUD_PHIFWD_MAX_OD 24.0
#endif

// =====================================================================
// 2026-10-02 批次1-B：Hillaire octave 级联（cm0.w = con，取代旧"透光残量尾巴"）。
// 直射项 = Σ_o con^o · exp(-OD·1.35·att^o) · phase_o，各 octave 自带相位、
// 加性叠加（HP EvaluateSunLuminance 的 octave 循环同构，不做相对 octave-0 的
// 归一化）。phase_o 的偏心率按 ecc^o 退化：octave 1/2 保留前向趋势但越来越
// 各向同性——橘色直射由此**物理地**到达侧光受光面，接替金色/月光地板的职责
//（地板保留，只作用于 octave 0，之后可减）。con=0 ⇒ 只剩 octave 0，与旧档
// 逐位相同（0.0 加法不改变位型）。
// =====================================================================
#ifndef CLOUD_MS_OCTAVES
#define CLOUD_MS_OCTAVES 1
#endif
#ifndef CLOUD_MS_ECCENTRICITY
// 偏心率逐级衰减率：g_eff = g·ecc^o。0.5 ⇒ octave1 的 g=0.4、octave2 的 g=0.2
// （0.80/0.40/0.20），逐级走向各向同性。2026-10-16 ③ 修正同 att：宏默认保持
// 参考的 0.5，但**必须 < 1** —— `ecc = 1` ⇒ 三个 octave 相位完全相同，
// 「方向记忆逐级消失」这一半的级联设计也被关掉（用户此前设的 1.0）。
#define CLOUD_MS_ECCENTRICITY 0.5
#endif
#ifndef CLOUD_MS_ATTENUATION
// 消光逐级衰减率（Hillaire attenuation）：octave o 的消光乘 att^o ⇒ 高 octave
// 光路穿透更深，厚云深处的「透光底」由 octave 1/2/3 的慢衰减承担。
// 2026-10-16 ③ 修正：宏默认 0.35 → **0.5**，与参考 `_HP_MS_Attenuation` 默认一致，
// 也与出厂配置 / Java 默认 / C++ 原子量统一（此前四处各说各话：宏 0.35、C++ 0.0、
// JSON 0.4、用户 1.0）。⚠ 关键点不是"0.5 还是 0.35"，而是 **att 必须 < 1**：
// `att = 1` ⇒ `att^o ≡ 1` ⇒ 三个 octave 消光完全相同 ⇒ 级联退化成
// 「单个 octave 的消光 × 三个相位求和」，**深度分层整个失效**（用户此前设的 1.0
// 正是这个状态）。批次1 记录：高密度参数（每步 OD≈6）下 0.5 会让 octave 1 在
// OD=6 处衰到 2%、0.35 保留 6% —— 若实测厚芯仍偏暗，把滑杆往 0.35 推即可
//（0.35 仍是本工程标定过的替代值，只是不再是默认）。
#define CLOUD_MS_ATTENUATION 0.5
#endif

// =====================================================================
// 2026-10-02 参考重构（第一阶段：受光逻辑）
//
// 顶高代理 —— 参考 HP_EvaluateHpHpPhiFwdTopHeightProxy：它从**低云天气图**
// （_CloudMapTexture）重建"这一列云有多厚"，用于两件事：
//   1) 云底软化的**列厚缩放**（厚云柱底部保留更多漫射，薄列几乎不注入）；
//   2) 边界受光置信度的 2D 高度差分法线（wrap 光照，压制背光侧假亮）。
// 本引擎没有天气图（这是我们的优势项：程序化非周期区域场 + 3D 噪声体，零额外
// 纹理绑定），所以用密度场**自己的基形通道**在云顶平面上采同一 XZ、同一平流、
// 同一频率，再过与密度同式的 coverage 软阈值 —— 得到同一列云的"有云程度"代理。
// 成本：1 次噪声读 + 1 次区域 hash。
// =====================================================================
float cloudPhiFwdTopProxy(vec2 worldXZ)
{
    vec3 advected = vec3(worldXZ.x, 0.0, worldXZ.y) + tyndallWind();
    float size = clamp(cam.cloudParams3.z, 0.50, 3.0);
    float distribution = clamp(cam.cloudParams3.w, 0.0, 1.0);
    vec3 region = tyndallRegion(
        vec3(advected.x * 0.00012 / size, 0.37, advected.z * 0.00012 / size));
    float baseNoise = textureLod(cloudShapeNoise,
        vec3(advected.x * (0.0000525 / size), 0.37,
            advected.z * (0.0000525 / size)), 0.0).r;
    float rain = clamp(cam.weatherParams.x, 0.0, 1.0);
    float coverage = mix(cam.cloudParams0.z, min(cam.cloudParams0.z + 0.30, 0.98), rain);
    coverage = clamp(coverage + (region.x - 0.5) * distribution * 0.60, 0.02, 0.95);
    // 与密度同式的 coverage 阈值：base − (1−coverage) > 0 ⇔ 该列有云。
    //
    // ⚠ 2026-10-02 补漏：**不要在这里 clamp 到 [0,1]**。边界受光要用它的
    // **2D 高度差**，而 clamp 会在覆盖率阈值处造出整片平台 ⇒ 差分只在平台
    // 边界出现尖峰 ⇒ 背光侧 wrap 光照变成斑驳的黑白块（"看着怪"的第二个来源）。
    // 保持连续场，需要 0..1 的调用方（云底软化的列厚 lerp）自己钳。
    return (baseNoise - (1.0 - coverage)) / max(coverage, 1.0e-3);
}

// 参考 HP_EvaluateHpHpPhiFwdBoundaryLight：顶面代理的 2D 高度差分法线 + wrap 光照。
// 返回 1.0 = 不做抑制（边界置信度 0）；返回小值表示该侧不是受光边界，
// 漫射源在那里不可信。BoundaryConfidence 就是参考的 _HP_HpHpPhiFwd_BoundaryConfidence。
float cloudPhiFwdBoundaryLight(vec3 positionWS, vec3 lightDirection)
{
    float boundaryConfidence = cam.cloudPhiParams.x;
    if(boundaryConfidence <= 0.001) return 1.0;
    // 参考 sampleStep = clamp(weatherMapWorldSize*0.001, 25, 200)（米）。
    // 本引擎用云层厚度作等效尺度：0.05×厚度 落在同一 25..200 档内。
    float sampleStep = clamp(cam.cloudParams0.y * 0.05, 25.0, 200.0);
    float hL = cloudPhiFwdTopProxy(positionWS.xz - vec2(sampleStep, 0.0));
    float hR = cloudPhiFwdTopProxy(positionWS.xz + vec2(sampleStep, 0.0));
    float hD = cloudPhiFwdTopProxy(positionWS.xz - vec2(0.0, sampleStep));
    float hU = cloudPhiFwdTopProxy(positionWS.xz + vec2(0.0, sampleStep));
    float slabThickness = max(cam.cloudParams0.y, 1.0);
    float dHdx = (hR - hL) * slabThickness / max(2.0 * sampleStep, 1.0);
    float dHdz = (hU - hD) * slabThickness / max(2.0 * sampleStep, 1.0);
    vec3 topNormalWS = normalize(vec3(-dHdx, 1.0, -dHdz));
    float wrap = 0.5;
    float boundaryLit = clamp((dot(topNormalWS, lightDirection) + wrap) /
        (1.0 + wrap), 0.0, 1.0);
    return mix(1.0, boundaryLit, clamp(boundaryConfidence, 0.0, 1.0));
}

// localHeight：采样点归一化云高（phi_fwd 云底置信度用，调用方本就要算，传入免重复）。
// phiFwd：phi_fwd 漫射场标量（强度 0 时为 0，调用方按 uniform 分支免费跳过）。
//
// 2026-10-02 参考重构：本函数的两个部分都按 HPVolumeCloud 的
// EvaluateSunLuminance 逐式对齐：
//   · 锥形采样：coverDist = 太阳方向**真实弦长**（球壳求交，含曲率与云底层裁剪），
//     首步 w0 = coverDist·(r−1)/(r^N−1)，步宽几何级数增长，**末步钳到不越界**；
//   · 源项：φ += T_cum·(σ_sΔs)·(1/D)·srcConfidence·msBuild·exp(−∫κ ds)·(1/r)，
//     其中 srcConfidence = 边界受光置信度 × 云底深度置信度（云底软化尺度随
//     云柱厚度 lerp(1,4) 自适应）。
// 保留的**优势项**（刻意偏离参考，恒定行为）：OD 早退（CLOUD_PHIFWD_MAX_OD）、
// powder 只作用于自阴影不作用于漫射源、旧固定步长档（cloudMarchParams.x=0）。
// densityScale：视 march 的远景衰减权（2026-10-02）。光步采到的密度也乘它 ⇒
// 正在淡出的云同时失去自阴影，不会出现"半透明的云却投出实心阴影"。
float lightOpticalDepth(vec3 samplePosition, vec3 lightDirection, float localHeight,
    out float phiFwd, out float relativeLightDistance, float densityScale,
    float viewFootprint)
{
    int lightSteps = clamp(int(cam.cloudParams2.y + 0.5), 1, MAX_LIGHT_STEPS);
    // ── 2026-10-07 降本（两处）─────────────────────────────────────────────
    // ① footprint 此前传的是**光步长** segment（24/48/96 格），它恒 < 60 ⇒
    //    tyndallDensity 的 detailWeight ≡ 1 ⇒ 云在 200 km 外、细节早就是亚像素，
    //    自阴影仍白付 curl + detail 两次读。改用 max(视向 footprint, segment)：
    //    视 march 在同一个 footprint 下早就关掉了 detail（见 detailWeight），
    //    这里跟着关不会多出可见差异。footprint 只增不减 ⇒ 近处（footprint <
    //    segment）逐位不变，mip LOD 也只会更省/更糊，方向安全。
    // ② region 场只依赖 p.xz、周期 ≈ 8.3 km，四步光 march 只挪 24~96 格 ⇒ 循环
    //    外算一次即可（省 ~8 次 tyndallRegion，每次 8 hash + trilerp）。
    TyndallRegions lightRegions = tyndallRegionsFor(samplePosition);
    float powderStrength = clamp(cam.cloudParams5.w, 0.0, 3.0);
    float sigmaT = max(cam.cloudParams2.z, 1.0e-9);
    float opticalDepth = 0.0;
    float marched = 0.0;

    // ── phi_fwd 状态（常量区注释块）。全部标量，随既有循环搭车。──
    bool phiEnabled = cam.cloudMsParams.x > 0.001;
    float phiAccum = 0.0;
    float kappaOD = 0.0; // 观测点→当前步的 ∫κ ds（= OD×0.0548 的累积）
    float tCum = 1.0;    // 源的慢衰减存活率 exp(−OD·(1−ω0))（参考 T_cum）
    float msBuildScale = cam.cloudPhiParams.y >= 0.0
        ? cam.cloudPhiParams.y : CLOUD_PHIFWD_BUILD_SCALE;
    float coneRatio = cam.cloudPhiParams.w > 0.0
        ? max(cam.cloudPhiParams.w, 1.001) : CLOUD_CONE_RATIO;
    // 源置信度 = 边界受光 × 云底深度（参考 srcConfidence）。整次调用算一次。
    float phiConfidence = 1.0;
    if(phiEnabled)
    {
        float depthPow = cam.cloudMsParams.y;
        float bottomConfidence = 1.0;
        if(depthPow > 0.0)
        {
            // 参考 bottomSoftHeight = max(_HP_BottomSmoothHeight·lerp(1,4,列厚), 1e-3)
            // ——列厚由顶高代理给出，厚云柱的底部软化区间扩到 4×。
            float columnThickness = clamp(
                cloudPhiFwdTopProxy(samplePosition.xz), 0.0, 1.0);
            float bottomSoftHeight = max(
                CLOUD_PHIFWD_BOTTOM_SOFT * mix(1.0, 4.0, columnThickness), 1.0e-3);
            bottomConfidence = 1.0 - exp(-max(localHeight + cam.cloudMsParams.z, 0.0) /
                bottomSoftHeight * depthPow);
        }
        phiConfidence = cloudPhiFwdBoundaryLight(samplePosition, lightDirection) *
            bottomConfidence;
    }

    // 覆盖距离：cloudMarchParams.x > 0 走参考的锥形采样；=0 回旧固定 48·2^n 档。
    bool coneMode = false;
    float coverDist = 0.0;
#if CLOUD_LIGHT_MARCH_LOCAL
    coneMode = cam.cloudMarchParams.x > 0.5;
    if(coneMode)
    {
        float entry = 0.0;
        float exitDistance = 0.0;
        float chord;
        if(tyndallInterval(samplePosition, lightDirection, entry, exitDistance))
        {
            // 真实弦长：太阳方向与云壳求交（含曲率 + 云底球裁剪）。
            chord = max(exitDistance - entry, 0.0);
        }
        else
        {
            // 退化情况（太阳方向与云壳无交）：保留旧的几何弦长估计，
            // 避免出现"该点完全无直射"的硬边。
            chord = cam.cloudParams0.y / max(abs(lightDirection.y), 0.15);
        }
        coverDist = clamp(chord, 0.0, cam.cloudMarchParams.x);
        // 首步反解：N 步几何级数正好铺满 coverDist（与参考逐式相同）。
        // 本引擎的"自阴影覆盖距离"滑块 = 参考的 CONE_MAX_DISTANCE，滑块上限 6000
        // 就是参考的取值。
    }
#endif

    float curWidth = coneMode
        ? max(coverDist * (coneRatio - 1.0) /
            max(pow(coneRatio, float(lightSteps)) - 1.0, 1.0e-4), CLOUD_CONE_MIN_STEP)
        : 0.0;
    float cumDist = 0.0;

    for(int step = 0; step < MAX_LIGHT_STEPS; ++step)
    {
        if(step >= lightSteps) break;
        float segment = 0.0;
#if CLOUD_LIGHT_MARCH_LOCAL
        if(coneMode)
        {
            // 参考：末步钳到 coverDist，绝不越过覆盖距离。
            segment = min(curWidth, coverDist - cumDist);
            if(segment <= 0.0) break;
        }
        else
        {
            // 旧固定档 48/96/192…（总覆盖 ~340 格），逐位旧路径。
#ifndef CLOUD_LIGHT_STEP_BASE
#define CLOUD_LIGHT_STEP_BASE 48.0
#endif
            segment = CLOUD_LIGHT_STEP_BASE * exp2(float(step));
        }
#else
        segment = 120.0 * exp2(float(step));
#endif
        float distCenter = cumDist + segment * 0.5;
        vec3 position = samplePosition + lightDirection * distCenter;
        // 视向 footprint 与光步长取大者当采样 footprint（见函数头 ①）。
        float lightFootprint = max(viewFootprint, segment);
#if CLOUD_LIGHT_MARCH_DETAIL
        float sampleDensity = tyndallDensityFromRegions(position, false,
            lightFootprint, lightRegions);
#else
        float sampleDensity = tyndallDensityFromRegions(position, true,
            lightFootprint, lightRegions);
#endif
        // 远景衰减同步：正在淡出的云，自阴影也要淡（同一个权）。
        sampleDensity *= densityScale;
        // rawOD = σ_t·Δs：漫射源的沉积量（参考里 powder 不参与漫射场）。
        float rawOD = sampleDensity * segment * sigmaT;
        float localOD = rawOD * powderStrength;
        opticalDepth += localOD;
        if(phiEnabled)
        {
            // 参考：φ += T_cum·(σ_sΔs)·(1/D)·conf·build·exp(−∫κ ds)·(1/r)
            //   σ_sΔs = σ_t·ω0·Δs、1/D = σ_t（g_eff=0，常数 3 吸收到强度里）
            //   ⇒ 源沉积 = rawOD·density·σ_t·ω0·(标定)
            // 标定：REF_NORMALIZE=0 时乘本引擎的 REGIME_GAIN（与今天逐帧一致）；
            //       =1 时乘 (σ_ref/σ_t)² 归一掉 σ_t²（φ 与消光绝对值无关）。
            float scale = CLOUD_PHIFWD_REGIME_GAIN;
#if CLOUD_PHIFWD_REF_NORMALIZE
            scale = CLOUD_PHIFWD_REF_SIGMA_T * CLOUD_PHIFWD_REF_SIGMA_T /
                (sigmaT * sigmaT);
#endif
            float deposit = rawOD * sampleDensity * sigmaT * scale *
                CLOUD_PHIFWD_OMEGA0;
            float kappaStep = localOD * CLOUD_PHIFWD_KAPPA_OD_SCALE;
            float msBuild = 1.0 - exp(-(opticalDepth - localOD * 0.5) *
                max(msBuildScale, 0.0));
            phiAccum += tCum * deposit * phiConfidence * msBuild *
                exp(-(kappaOD + kappaStep * 0.5)) /
                max(distCenter, segment * 0.5);
            kappaOD += kappaStep;
            tCum *= exp(-localOD * (1.0 - CLOUD_PHIFWD_OMEGA0));
        }
        cumDist += segment;
        curWidth *= coneRatio;
        // 优势项：OD 早退（参考无此档；0 = 参考行为，不早退）。
        float breakLimit = phiEnabled
            ? (CLOUD_PHIFWD_MAX_OD > 0.0 ? CLOUD_PHIFWD_MAX_OD : 1.0e30)
            : 4.0;
        if(opticalDepth > breakLimit) break;
    }
    phiFwd = phiAccum;
    // ── #5 参考 EvaluateSunColor(envLighting, relativeRayDistance)：沿**光路**的
    // 相对距离（本点 → 云顶/太阳方向的覆盖距离比例）。锥形模式下 cumDist 正好是
    // 从本点向太阳行进的距离 ⇒ 深处样本取值大（直射光穿过的云更厚、更该红化）。
    // 非锥形（旧档路径）恒 0 ⇒ 调用方的 mix 退化为端点自身，逐位旧档。
    relativeLightDistance = (coneMode && coverDist > 0.0)
        ? clamp(cumDist / coverDist, 0.0, 1.0) : 0.0;
    return opticalDepth;
}

// =====================================================================
// 2026-10-02 第三阶段（参考重构）：EvaluateCloudProperties 的抽取
//
// 参考把"取密度 + 局部高度 + 是否占用"合成一次采样评估，调用方（视图 march 的
// 粗/细两级、光步）各自只拿结果。我们此前是零散地 tyndallDensity / tyndallHeight
// 分头调，两级步进的占用阈值还硬编码 0.004。抽取后：
//   · 阈值变成 GUI 旋钮（cloudShapeParams.z，参考 HI_CLOUD_DENSITY_THRESHOLD）；
//   · 局部高度随密度一次取回，删掉调用方的重复计算；
//   · 两级步进的语义与参考一致：cheap 探测（simpleMode）未命中就大步跨越，
//     命中才做全量采样（detail 只减不增 ⇒ 无假阴性）。
// =====================================================================
#ifndef CLOUD_TWO_TIER_THRESHOLD
// 参考 HI_CLOUD_DENSITY_THRESHOLD 的量级（本引擎密度已乘 density 旋钮）。
#define CLOUD_TWO_TIER_THRESHOLD 0.004
#endif

struct CloudSample
{
    float density;
    float localHeight;
    bool occupied;
};

CloudSample evaluateCloudSample(vec3 p, bool cheap, float footprint, float threshold)
{
    CloudSample s;
    s.density = tyndallDensity(p, cheap, footprint);
    s.localHeight = clamp(tyndallHeight(p), 0.0, 1.0);
    s.occupied = s.density > threshold;
    return s;
}

void storeEmpty(ivec2 pixel)
{
    imageStore(cloudOutput, pixel, vec4(0.0, 0.0, 0.0, 1.0));
    // rg32f（批次2-T2c）：.r = 首命中距离（兼容旧消费者），.g = 重投影距离。
    imageStore(cloudDepthOutput, pixel,
        vec4(CLOUD_DEPTH_EMPTY, CLOUD_DEPTH_EMPTY, 0.0, 0.0));
}

// Reverse-Z scene depth -> linear distance along the view ray.  The raygen
// stored clipPos.z / clipPos.w, and `ndc` here is the same y-flipped value
// cam.projInverse is fed below, so the reconstruction is exact.
float sceneDistanceForDepth(vec2 ndc, float depthValue)
{
    if(depthValue <= 1.0e-5)
    {
        return 1.0e30;
    }
    vec4 sceneViewPosition = cam.projInverse * vec4(ndc, depthValue, 1.0);
    if(abs(sceneViewPosition.w) <= 1.0e-6)
    {
        return 1.0e30;
    }
    return length(sceneViewPosition.xyz / sceneViewPosition.w);
}

// 2026-10-14：本文件原有的体积雾 march 与它的一整套编译期宏
// （VL_OWNS_FOG_SUN / VL_FOG_EXP_STEPS / VL_FOG_HG_PHASE / FOG_EXP_STEP_BASE /
//  FOG_HG_* / FOG_SUN_TERM_SCALE）已随体积雾一并清空，等待重写。

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(cloudOutput);
    if(any(greaterThanEqual(pixel, size))) return;

    bool cloudDeckEnabled = cam.cloudParams1.w >= 0.5;
    bool highCloudEnabled = cam.highCloudParams0.x >= 0.5;
    // 2026-10-23 **雾与云 / 维度解耦**。
    // 旧条件把三件事绑在一起：云全关、或不在主世界 ⇒ 整趟早退 storeEmpty ⇒
    // 体积雾跟着一起消失（"关掉云就没有雾"；下界/末地一刀雾都没有），
    // 而雾本来有自己的开关（cloudParams7.x）。
    // 现在：维度门与云开关只关**云**，雾只由 cloudParams7.x 决定；
    // 只有"云和雾都不要"才整趟跳过（否则白跑一次 dispatch）。
    const bool overworldDimension = abs(cam.weatherParams.z - 1.0) < 0.25;
    // 云层/高层云的标定只对主世界成立（下界/末地没有这套大气），非主世界只跑雾。
    cloudDeckEnabled = cloudDeckEnabled && overworldDimension;
    highCloudEnabled = highCloudEnabled && overworldDimension;
    const bool fogWanted = cam.cloudParams7.x >= 0.5;
    if(!cloudDeckEnabled && !highCloudEnabled && !fogWanted)
    {
        storeEmpty(pixel);
        return;
    }

    vec2 ndc = (vec2(pixel) + 0.5) / vec2(size) * 2.0 - 1.0;
    ndc.y = -ndc.y;
    vec4 viewPosition = cam.projInverse * vec4(ndc, 1.0, 1.0);
    vec3 viewTarget = abs(viewPosition.w) > 1.0e-6
        ? viewPosition.xyz / viewPosition.w : viewPosition.xyz;
    vec3 worldDirection = normalize((cam.viewInverse *
        vec4(normalize(viewTarget), 0.0)).xyz);
    vec3 cameraPosition = cam.viewInverse[3].xyz;

    // Both volumes are clipped to the opaque scene so the composite can run on
    // every pixel rather than only on sky pixels.  For the cloud deck this is
    // behaviour preserving (a ray that hits terrain never reaches the deck),
    // and for the fog it is what keeps near ground from being fogged as if it
    // sat at the far end of the view distance.
    //
    // 2026-10-04 S2：云图的 march 分辨率现在可以与场景不同（宿主
    // g_cloudResFloorPercent 会给降采样档一个更高的云分辨率），所以不能拿云图的
    // 像素下标直接 texelFetch 场景深度 —— 那会越界取到别的纹素（云被画在地形前面）。
    // 分辨率相同时仍走原来的 texelFetch（逐位不变）；不同时按 uv 取样，像素中心对齐
    // ⇒ 与同分辨率时的语义一致。
    //
    // 2026-10-06 远云剥离 RR：云跑在输出分辨率、场景深度还是 render 分辨率，
    // 分辨率必然不同。单个双线性取样在轮廓处会混出一个中间深度，云要么在地形上
    // 留 1~3 个输出像素的溢出、要么被吃掉一条边。改成看这个输出像素覆盖到的
    // 2x2 场景纹素，取**最近的那个面**（反 Z：值越大越近）做保守遮蔽 —— 宁多裁
    // 一点，也要压掉地形轮廓上的云溢出。
    float rawSceneDepth = texelFetch(sceneDepth, pixel, 0).r;
    if(textureSize(sceneDepth, 0) != size)
    {
        const vec2 sceneSize = vec2(textureSize(sceneDepth, 0));
        const vec2 sceneTexel = (vec2(pixel) + 0.5) / vec2(size) * sceneSize;
        const ivec2 sceneBase = ivec2(floor(sceneTexel - 0.5));
        const ivec2 sceneLimit = ivec2(sceneSize) - ivec2(1, 1);
        float nearest = 0.0;
        for(int oy = 0; oy < 2; ++oy)
        for(int ox = 0; ox < 2; ++ox)
        {
            nearest = max(nearest, texelFetch(sceneDepth,
                clamp(sceneBase + ivec2(ox, oy), ivec2(0, 0), sceneLimit), 0).r);
        }
        rawSceneDepth = nearest;
    }
    float sceneDistance = sceneDistanceForDepth(ndc, rawSceneDepth);

    // sunDirection() is the true sun and keeps travelling below the horizon
    // after sunset; the *lit* direction must be the moon there, exactly as the
    // raygen does for terrain, or the deck is lit from under the world.
    vec3 lightDirection0 = sunDirection();
    float sunElevation = lightDirection0.y;
    vec3 lightDirection = sunElevation >= 0.0 ? lightDirection0 : -lightDirection0;

    // 高层平面云（2026-10-02 C 档）。每像素角尺寸与下面体积云的 footprint 同一
    // 算式（2·|projInverse[1][1]|/屏高），用来预过滤噪声 mip。
    float highPixelAngle = 2.0 * abs(cam.projInverse[1][1]) / float(size.y);
    float highDistance = CLOUD_DEPTH_EMPTY;
    vec4 highCloud = vec4(0.0, 0.0, 0.0, 1.0);
    // 2026-10-23：高层云只主世界、只在自己开关打开时采样 —— 本 pass 现在为了
    // 雾会在"云全关 / 非主世界"时继续运行，若不在这里判就会把主世界的卷云
    // 画到下界/末地的天空里。
    if(highCloudEnabled)
    {
        highCloud = sampleHighCloud(
            cameraPosition, worldDirection, lightDirection, highPixelAngle, highDistance);
        if(highDistance > sceneDistance)
        {
            // The high-cloud sheet is a bare ray-plane intersection with no
            // occlusion test of its own; the scene wins when it is nearer.
            highCloud = vec4(0.0, 0.0, 0.0, 1.0);
            highDistance = CLOUD_DEPTH_EMPTY;
        }
    }

    // 0 = full night, 1 = full day.  Deliberately narrow so that the existing
    // daytime/sunset look is bit-for-bit unchanged above the horizon.
    float dayAmount = smoothstep(-0.03, 0.03, sunElevation);
    // Clear-sky altitude cycle, identical to the raygen's normalized cycle
    // elevation (|sin(dayAngle)|), used to fade the moon in and out.
    float elevationMagnitude = abs(sunElevation) / SOLAR_LATITUDE_35_COS;
    float viewLightCosine = dot(worldDirection, lightDirection);
    // 双瓣 HG 相位（参考 Clouds.fsh:37-62 的等效式）：
    // 前瓣 g=+0.4 权重 0.9、后瓣 g=-0.25 权重 0.1。
    float phase = 0.9 * hgPhase(viewLightCosine, 0.40)
                + 0.1 * hgPhase(viewLightCosine, -0.25);
#if CLOUD_PHASE_CLAMP
    // 相位函数的自变量是入射太阳方向与出射视线方向的夹角；对远场平行太阳，
    // 同一相机射线上的样本共享该夹角是正常的远场近似，不是缺少云表面法线。
    // 默认上限等于双瓣 HG 的自然峰值，不削减相位；滑杆向 0 调才启用旧的 1.05
    // 视觉钳制。weatherParams.w 由 C++ / Java 配置贯通，缺失配置默认 1（自然范围）。
    const float CLOUD_PHASE_MAX_FORWARD = 2.52;
    float cloudPhaseCeiling = mix(CLOUD_PHASE_MAX, CLOUD_PHASE_MAX_FORWARD,
        clamp(cam.weatherParams.w, 0.0, 1.0));
    phase = min(phase, cloudPhaseCeiling);
#endif
#if CLOUD_MS_OCTAVES
    // ── #6（2026-10-02 参考重构）：MS 三参数与级数进 GUI（cloudMsParams2）──
    // 2026-10-16 哨兵修正：原先用 `> 0.0` 判定 ⇒ **滑杆最左端被当成「回落编译期宏」**。
    // 后果不是「某段区间不可达」（0.05~1.00 一直都能到），而是 **0 点非单调**：
    // 0 → 宏默认，0.05 → 0.05，往左推到底反而跳到宏值；而两个物理端点
    //（`att = 0` ⇒ `att^o ≡ 0` ⇒ 三个 octave 全无衰减；`ecc = 0` ⇒ 三个 octave
    // 相位全各向同性）在 UI 上根本取不到。改成 `>= 0.0` ⇒ **0 就是 0**，滑杆
    // 全程单调。负值那条分支现在**只服务于着色器侧的宏覆盖**（Java 侧
    // CloudMs2Settings 的校验与 C++ 的 store 都把值钳在 >= 0，配置下发不了负值）。
    // 历史配置里落在 0 的档由 Java 侧迁移成新默认（0.5 / 0.5）⇒ 画面不变。
    float msEccentricityKnob = cam.cloudMsParams2.w >= 0.0
        ? cam.cloudMsParams2.w : CLOUD_MS_ECCENTRICITY;
    float msAttenuationKnob = cam.cloudMsParams2.z >= 0.0
        ? cam.cloudMsParams2.z : CLOUD_MS_ATTENUATION;
    // 级数 1..3。参考 NUM_MULTI_SCATTERING_OCTAVES = 3（含 octave 0）；我们的
    // octaveFill 是 octave 1..N，所以 N=2 对应参考的 3 项。
    int msOctaveCount = clamp(int(cam.cloudMsParams2.y + 0.5), 1, 3);
    // Hillaire octave 1/2/3 相位：偏心率按 ecc^o 退化，方向记忆逐级消失。
    // 与 octave 0 用同一钳制上限防 HDR 爆点；金色/月光地板不作用于此
    // （把直射送到侧光受光面正是级联的物理职责）。
    float ecc = max(msEccentricityKnob, 0.0);
    float phaseOct1 = mix(hgPhase(viewLightCosine, CLOUD_PHASE_FORWARD_G * ecc),
        hgPhase(viewLightCosine, CLOUD_PHASE_BACK_G * ecc), CLOUD_PHASE_BACK_MIX);
    float phaseOct2 = mix(hgPhase(viewLightCosine, CLOUD_PHASE_FORWARD_G * ecc * ecc),
        hgPhase(viewLightCosine, CLOUD_PHASE_BACK_G * ecc * ecc), CLOUD_PHASE_BACK_MIX);
    // #6 新增第三项：ecc^3 时 g≈0.06 ⇒ 近各向同性，负责最厚云芯的透光底。
    float phaseOct3 = mix(hgPhase(viewLightCosine, CLOUD_PHASE_FORWARD_G * ecc * ecc * ecc),
        hgPhase(viewLightCosine, CLOUD_PHASE_BACK_G * ecc * ecc * ecc), CLOUD_PHASE_BACK_MIX);
#if CLOUD_PHASE_CLAMP
    phaseOct1 = min(phaseOct1, cloudPhaseCeiling);
    phaseOct2 = min(phaseOct2, cloudPhaseCeiling);
    phaseOct3 = min(phaseOct3, cloudPhaseCeiling);
#endif
#endif
    // Day: unchanged 6.0 x sun colour.  Night: cool moon colour at ~2.5% of
    // the noon energy, matching the raygen's moonlight scale.
    vec3 directLightColor = mix(vec3(0.46, 0.56, 1.00), sunColor(lightDirection), dayAmount);
    float directLightEnergy = mix(CLOUD_MOON_LIGHT_SCALE * elevationMagnitude,
        CLOUD_SUN_LIGHT_SCALE, dayAmount) * clamp(cam.cloudParams5.z, 0.0, 3.0);
    vec3 directLight = directLightColor * directLightEnergy;
    // 2026-10-10 逐样本光路大气消光强度（cloudLightParams2.y，GUI「云光路大气消光」）。
    // >=0 以 lane 为准（0 = 关 ⇒ 逐位旧档）；<0 回落编译期默认。
#ifndef CLOUD_ATM_EXTINCTION_DEFAULT
#define CLOUD_ATM_EXTINCTION_DEFAULT 1.0
#endif
    float cloudAtmExtinction = cam.cloudLightParams2.y >= 0.0
        ? clamp(cam.cloudLightParams2.y, 0.0, 1.0) : CLOUD_ATM_EXTINCTION_DEFAULT;
    // 云的「地面参考」高度（格）。全工程海平面 = 63（与 rgen 的 A1 消透同源）。
    const float CLOUD_SEA_LEVEL_Y = 63.0;
    // 曙暮窗（循环内 fireTint 用同一量，提为循环不变量）。窗口语义见循环内
    // 原注释：下界 -0.20 让拂晓太阳还在地平线下时云底先亮，上界 0.24 保证
    // 夜里整片不泛红。
    float sunsetGlow = (1.0 - smoothstep(0.04, 0.24, sunElevation)) *
        smoothstep(-0.20, 0.02, sunElevation);
    // 余晖退场（常量区注释）：黄昏侧太阳一沉下去就快速衰减到深夜地板；拂晓侧
    // 系数恒 1.0，预日出窗口不受影响。e>=0 时系数逐位为 1.0 ⇒ 白天像素级不变。
    sunsetGlow *= mix(1.0,
        mix(CLOUD_AFTERGLOW_FADE_FLOOR, 1.0,
            smoothstep(-0.08, 0.0, sunElevation)),
        twilightEveningWeight());
    // 受光面金色地板：侧光时前向散射瓣塌掉（~0.05），橘色直射到不了受光面，
    // 被冷蓝 ambient 洗白 —— 黄金时刻给 phase 一个地板（常量区注释）。
    // 阴影侧由 sunlight 的光 march OD 压住，不随地板变亮。
    //
    // 2026-09-30 夕阳感修复（用户对照实拍）：地板与暖环境加朝阳扇区门 ——
    // 旧档整个天球的云都被暖直射+暖环境提亮成一片粉白；实拍里近太阳的
    // 云底金亮、背阳侧是灰蓝剪影。sunSector 以视线-太阳夹角作云块相对
    // 太阳方位的代理：朝阳侧全额、背阳侧保留 30%（地平线暖光本就绕圈）。
    // 2026-09-30 修（用户截图：月亮升起时云也变黄）：火 rim / 扇区门用
    // **真太阳**方位（lightDirection0，不翻转）。旧档用 viewLightCosine
    // （视线·lightDirection，黄昏后 lightDirection 翻成月亮）⇒ 月亮升起时
    // 火烧云跟着月亮跑到东边天。曙暮余晖只该挂在太阳落下/将出的那侧。
    float sunSideCosine = dot(worldDirection, lightDirection0);
    float sunSector = smoothstep(-0.35, 0.55, sunSideCosine);
    // 2026-09-30 四修：暖项的高度门抬到 0.35..0.85（常量区注释）—— 日落时
    // 云的受光面翻到云底，而抬头看云底必然越过旧档 17° 的硬截断。
    float warmBand = 1.0 - smoothstep(CLOUD_WARM_BAND_LOW,
        CLOUD_WARM_BAND_HIGH, worldDirection.y);
#if CLOUD_FIRE_HACK
    float goldenPhaseFloor = sunsetGlow * mix(0.30, 1.0, sunSector) *
        warmBand * CLOUD_GOLDEN_PHASE_FLOOR * dayAmount;
    // 夜晚月光地板：dayAmount 归零时全额生效，与白天金地板互斥衔接
    float moonPhaseFloor = (1.0 - dayAmount) * CLOUD_MOON_PHASE_FLOOR;
#else
    // 相位地板不是体积散射物理：出厂关闭，但保留显式视觉回退旋钮。
    // w=0 保持由相位函数与多重散射决定的自然照明；w>0 才渐进恢复旧黄金/月光地板。
    float phaseFloorKnob = cam.cloudPhysicsParams.w >= 0.0
        ? clamp(cam.cloudPhysicsParams.w, 0.0, 1.0) : CLOUD_PHASE_FLOOR_DEFAULT;
    float goldenPhaseFloor = sunsetGlow * mix(0.30, 1.0, sunSector) *
        warmBand * CLOUD_GOLDEN_PHASE_FLOOR * dayAmount * phaseFloorKnob;
    float moonPhaseFloor = (1.0 - dayAmount) * CLOUD_MOON_PHASE_FLOOR * phaseFloorKnob;
#endif
    // 2026-09-30 夕阳感二修（用户截图：朝阳半边云无自阴影、平涂橘）：
    // 日落时太阳贴地平线，光 march 水平穿云、OD 全体饱和到 sunlight 地板
    // ⇒ 直射项变成无结构平涂。物理上贴地平线的太阳入云能量骤减，
    // 按 sunsetGlow 把直射能量压到 45% —— 平涂退掉，朝阳侧的亮度交回
    // 给前向散射与火 rim 的结构项。
#if CLOUD_FIRE_HACK
    directLightEnergy *= mix(1.0, 0.45, sunsetGlow * dayAmount);
#endif
    // ── 参考重构（第三阶段）：物理月光项 ────────────────────────────────
    // 射线生成器已经做了"日落后把光源换成月亮、并把月光能量压到正午的 3%"
    // （rgen 的 TIME_DRIVEN_MOON_NOON_SCALE），但**月相**此前从未参与：相位地板
    // （CLOUD_MOON_PHASE_FLOOR）只能用经验常数代替"被照亮比例"。地板退场后，
    // 这里把月相作为物理量接上：夜间的直射与漫射（phi/octave 都乘 sampleDirectLight）
    // 一起按被照亮比例缩放；白天不参与（dayAmount=1 ⇒ 因子恒 1）。
    // 默认（强度/相位 = 1.0，或 UBO 传负值回落）时因子恒 1.0 ⇒ 逐位不改画面。
    // 想让云跟随世界里真实的 8 相月，把「月光相位」调到对应比例即可（满月 1.0、
    // 上下弦 ≈0.5、新月 0）。
    float moonStrength = cam.cloudMoonParams.x >= 0.0 ? cam.cloudMoonParams.x : 1.0;
    float moonPhase = cam.cloudMoonParams.y >= 0.0 ? cam.cloudMoonParams.y : 1.0;
    float moonAmount = mix(1.0, moonStrength * clamp(moonPhase, 0.0, 1.0),
        1.0 - dayAmount);
    directLight = directLightColor * directLightEnergy * moonAmount;
    // Ambient (sky) light is a daylight term; the previous code applied it at
    // full strength around the clock.
    // 2026-10-14 日落天光修正（B 方案）：上界随旋钮抬高 ⇒ 天光能量在低太阳下
    // 真正衰减（e=0.02 时 daylight 0.512 → 0.330）。哨兵见常量区注释。
    float skyHueCool = cam.cloudSkyHueParams.x >= 0.0
        ? clamp(cam.cloudSkyHueParams.x, 0.0, 1.0) : CLOUD_SKYHUE_COOL_DEFAULT;
    float skyHueEnergy = cam.cloudSkyHueParams.y >= 0.0
        ? clamp(cam.cloudSkyHueParams.y, 0.0, 1.0) : CLOUD_SKYHUE_ENERGY_DEFAULT;
    float daylightUpper = mix(0.15, 0.35, skyHueEnergy);
    float daylight = mix(CLOUD_NIGHT_AMBIENT, 1.0, smoothstep(-0.10, daylightUpper, sunElevation));
    float rain = saturate(cam.weatherParams.x);
    // 2026-10-21 雷暴频闪：每像素只求一次包络，循环内当常量消费（门控见
    // sky_model_common.glsl，thunder=0 时恒 0）。
    float lightningFlash = lightningFlashEnvelope();
    // 静态像素基 + 帧间黄金比相位 + 近邻 4 相位扰动（保证相邻像素互不相同）。
    float jitter = fract(temporalJitter(pixel) + temporalPhase()
        + float((pixel.x ^ pixel.y) & 3) * 0.1731);

    // =====================================================================
    // 2026-10-02 参考重构：把"**每像素只算一次**"的量全部提到循环外。
    //
    // 旧档把 top/bottomAmbient 与夕阳染色写在样本循环里逐样本重算 —— 这些量与
    // 样本无关（只有 height / upwardAO 逐样本），白付 ALU。提出来之后 #2/#5/#6
    // 三项新特性是**净省算力**（旧档的每样本重复计算被删掉了）。
    //
    // 默认值 = 参考口径，每项都能回退旧档（见各行注释）。
    // =====================================================================
    // ── #2 环境光接天空（参考 EvaluateEnvironmentLighting：SH9 探针 × 倍率）──
    // 我们没有 SH 探针、也不新增 descriptor（性能优先），改用**已有的天空模型**
    // 解析天光色：天顶 = 正午蓝天基色 × 当前阳光色相（含天气/暮色/金山调制）
    // ⇒ 日落变暖、雨天转灰、夜晚转冷自动成立；旧档是固定冷蓝常量 + 只染色相。
    // cloudHueOf 是亮度归一的 ⇒ 只改色彩走向，不会把云整体调亮。
    float ambientHueFollow = clamp(cam.cloudAmbientParams.w, 0.0, 1.0);
    vec3 skyLightHue = cloudHueOf(directLightColor);
    // 2026-10-14 日落天光色相调节：按 sunsetGlow 把该近似天光色相向冷紫代理色插值，
    // 与直射色相解耦。cloudHueOf 做亮度归一，所以此旋钮只改颜色；它不建立天光方向性，
    // 也不能单独决定背光能量。冷化强度为 0 时不进分支 ⇒ 逐位旧档。
    if(skyHueCool > 0.001)
    {
        vec3 coolHue = cloudHueOf(TWILIGHT_PREDAWN_TINT);
        skyLightHue = mix(skyLightHue, coolHue, sunsetGlow * skyHueCool);
    }
    // =====================================================================
    // ② 方向性天光（2026-10-17）—— 旋钮 cloudSkyHueParams.z，默认 0 = 逐位旧档
    //
    // 病灶：上面 skyLightHue = cloudHueOf(directLightColor) —— 天光的**色相源是
    // 直射阳光**。日落时直射是高饱和橘红 ⇒ 背光面也被染橙，只能靠「天光冷化」
    // 那个人肉代理往回拉。物理上天光来自天空模型本身：天顶深蓝紫、近太阳地平暖橙，
    // 且**朝阳侧与背阳侧不同**。
    //
    // 做法：在参与介质里环境入散射是 L_amb(ω_v) = ∫ L_sky(ω)·p(ω·ω_v) dω。
    // 方向不是通过表面法线进来的，是通过**相函数**进来的；而 p 的自变量只有
    // ω 与视线方向 —— 两者都逐像素固定 ⇒ 权重是**每像素常量**，可以整体提到
    // 样本循环外。⇒ 循环内结构一字不改，**每样本新增成本 = 0**。
    //
    // 三个方向 = 天顶 / 朝阳侧（仰角 0.20）/ 背阳侧（仰角 0.20）。用 3 个方向
    // 而不是 1 个，是因为「受光侧偏暖、背光侧偏冷」这条正是本次要建立的性质；
    // 用 3 个而不是更多，是因为 clearSkyInscatter 是解析闭式（逐式数一遍约 90 ALU：
    // 2 次 airMass + 3 次 exp2(vec3) + 两个相位 + 若干 dot/mul），3 次 ≈ 270 ALU，
    // 加 3 次 hgPhase 与归一 ≈ 320 ALU/像素（内部 RT 707×376 ⇒ 约 8.5e7 ALU/帧）。
    // 云 pass 的逐样本成本在 10³~10⁴ ALU/像素量级 ⇒ 占比 < 3%，且**不随 march
    // 步数增长**（这正是"提到循环外"的意义）。
    //
    // 归一化：除以权重和（而非直接 cloudHueOf）是必要的 —— 万一三个权重同时
    // 很小，不归一的话向量趋 0，cloudHueOf 会给出近黑色相，把环境项拉黑。
    // 归一后结果必落在三个辐亮度的凸包内，恒为正。
    //
    // ⚠ 强度 = 1 时「天光冷化」（skyHueCool）不再有可见效果：色相已完全由天空
    // 模型给出，那个冷紫代理就是为了替代直射色相而存在的。
    // ⚠ 本段只改**色相**：cloudHueOf 做 Rec.709 亮度归一 ⇒ 环境项总能量不变，
    // 不会把云整体调亮/调暗。这与 10-14 那两轮的保亮度约定一致。
    // =====================================================================
    float skyDirStrength = cam.cloudSkyHueParams.z >= 0.0
        ? clamp(cam.cloudSkyHueParams.z, 0.0, 2.0) : 0.0;
    if(skyDirStrength > 0.001)
    {
        // 与云层空气透视（本文件末尾）完全同一条口径，保证"云后天空"与
        // "云上天光"是同一份天空模型，不会各说各话。
        float skyRadianceScale = daylight * clamp(elevationMagnitude, 0.0, 1.0);
        float skyWeatherFactor = mix(1.0, 0.20, rain);
        vec3 sunSideDir = normalize(vec3(lightDirection.x, 0.20, lightDirection.z));
        vec3 antiSunDir = normalize(vec3(-lightDirection.x, 0.20, -lightDirection.z));
        vec3 radianceZenith = clearSkyInscatter(vec3(0.0, 1.0, 0.0), sunElevation,
            lightDirection, directLightColor, skyRadianceScale, skyWeatherFactor, vec3(1.0));
        vec3 radianceSunSide = clearSkyInscatter(sunSideDir, sunElevation,
            lightDirection, directLightColor, skyRadianceScale, skyWeatherFactor, vec3(1.0));
        vec3 radianceAntiSun = clearSkyInscatter(antiSunDir, sunElevation,
            lightDirection, directLightColor, skyRadianceScale, skyWeatherFactor, vec3(1.0));
        float weightZenith = hgPhase(dot(worldDirection, vec3(0.0, 1.0, 0.0)),
            CLOUD_AMBIENT_PHASE_G);
        float weightSunSide = hgPhase(dot(worldDirection, sunSideDir),
            CLOUD_AMBIENT_PHASE_G);
        float weightAntiSun = hgPhase(dot(worldDirection, antiSunDir),
            CLOUD_AMBIENT_PHASE_G);
        vec3 skyTopRadiance = (radianceZenith * weightZenith +
            radianceSunSide * weightSunSide + radianceAntiSun * weightAntiSun) /
            max(weightZenith + weightSunSide + weightAntiSun, 1.0e-4);
        // 直接改写 skyLightHue：它是**所有**环境色相的唯一来源（top/bottom 两套
        // 基色、以及第二层"夕阳环境染色" ambientTintMul 都读它）⇒ 顶底不会出现
        // 两套色相各说各话。这也是「顶底性质统一」的第一半。
        skyLightHue = mix(skyLightHue, cloudHueOf(skyTopRadiance), skyDirStrength);
    }
    vec3 ambientTopColor = vec3(0.72, 0.80, 0.96) *
        mix(vec3(1.0), skyLightHue, ambientHueFollow) *
        clamp(cam.cloudAmbientParams.x, 0.0, 3.0);
    vec3 ambientBottomColor = vec3(0.22, 0.28, 0.40) *
        mix(vec3(1.0), skyLightHue * vec3(0.94, 0.88, 0.82), ambientHueFollow) *
        clamp(cam.cloudAmbientParams.y, 0.0, 3.0);

    // 环境项仍是低成本的 top/bottom 各向同性近似。**2026-10-17 更正**：原注释写
    // 「不能用 dot(worldDirection, lightDirection0) 把屏幕上的背日方向冒充为天光
    // 半球积分；完整方向性环境照明需要天空辐亮度输入，本 pass 目前没有」——
    // 前半句仍然成立（拿单个方向冒充半球积分确实错），后半句已被 ② 推翻：
    // 现在有 clearSkyInscatter 给出的**真实天空辐亮度**，三方向求积 + HG 加权
    // 是合法的（虽然只有 3 个样本）。所以方向性环境照明已经存在，只是由
    // cloudSkyHueParams.z 控制、默认关闭；这一段各向同性近似仍是默认路径。
    //
    // 地面反照单独按 Lambert 模型估算：均匀水平地面只接收直射太阳时
    // E_ground ≈ E_sun * max(sunElevation,0)，L_ground = rho * E_ground / PI。
    // 这是一项真实直射地面反射近似，不替代现有 bottomAmbient，也不含地形遮挡。
    float groundAlbedo = cam.cloudPhysicsParams.x >= 0.0
        ? clamp(cam.cloudPhysicsParams.x, 0.0, 0.8) : CLOUD_GROUND_ALBEDO_DEFAULT;
    float groundBounceStrength = cam.cloudPhysicsParams.y >= 0.0
        ? clamp(cam.cloudPhysicsParams.y, 0.0, 1.0) : CLOUD_GROUND_BOUNCE_DEFAULT;
    vec3 groundBounceRadiance = vec3(0.0);
    if(groundAlbedo > 0.001 && groundBounceStrength > 0.001 && sunElevation > 0.0)
    {
        groundBounceRadiance = directLight * (groundAlbedo * sunElevation *
            CLOUD_GROUND_BOUNCE_SCALE * groundBounceStrength);
    }

    // =====================================================================
    // 顶底性质统一（2026-10-17）—— 旋钮 cloudSkyHueParams.w，默认 0 = 逐位旧档
    //
    // 病灶：顶与底被**两套独立的手调量**控制，不是同一个模型的两端：
    //   · 顶基色 (0.72,0.80,0.96) × ambTopMul，Rec.709 亮度 0.795
    //   · 底基色 (0.22,0.28,0.40) × ambBottomMul，亮度 0.276
    //   ⇒ 固定比值 2.88×，与场景、天气、太阳高度全无关；再叠一个 (1-h) 当权重，
    //     而 (1-h) 是**位置**不是遮蔽 ⇒ 云底永远吃满额下界光。
    // VolumetricRenderer.fsh 的 SceneData.skyColor）里**根本没有"顶色/底色"这一对**
    // —— 它只有**一个** skyColor，顶底的差别全部来自密度场与竖直光程。
    //
    // 本档在强度 = 1 时做两件事，把"两套手调"换成"一个物理量 + 一个光学量"：
    //   ① 云底基色 := 天顶天光 × 地面反照率 ⇒ 与顶**同一色相源**，亮度比 = 真实
    //      反照率 ρ（不再是写死的 2.88×）；也不再自带 (0.94,0.88,0.82) 那个
    //      「底部偏暖」的固定色偏。
    //      ⚠ 副作用：「地面环境倍率」(cloudAmbientParams.y) 在强度 1 时失效
    //        —— 这正是统一的目的（一个倍率代替两个）。
    //   ② 直射项的高度增益 0.68+0.38·h 归零（见循环内 directHeightGain）。
    //      直射的顶底差本应由光程 OD 决定；这条高度线性增益是第二套、非物理的
    //      顶底差，也是"很明显的明暗分界线"的来源之一。
    // ⚠ 本档**刻意不接管**第三处不对称 —— 「上界用真实竖直 OD、下界用位置权重
    //   (1-h)」，那是环境剖面呈 U 形的主因。原因：当前竖直消光口径
    //   （CLOUD_SKY_VIS_EXTINCTION = 0.02 **每步** × 步长 638 格 ⇒ 单步 OD≈11）
    //   会让向下透过率在 h>0.03 就饱和，一开就把云内打成全黑。该口径是否为本意
    //   尚未裁定（见 deliverables/云顶云底不对称-诊断-2026-10-16.md §3.2），
    //   在裁定前不把"统一"和"云内变黑"绑在一起。下界遮蔽仍由
    //   「云底遮蔽强度」（cloudTemporalParams.w）单独控制。
    // groundBounceRadiance 保留：它是地面辐亮度的**直射**分量，与 ① 的**天光**
    // 分量互补（ρ·(E_sky + E_sun)/π 的两项），不是重复计数。
    // =====================================================================
    float ambientUnify = cam.cloudSkyHueParams.w >= 0.0
        ? clamp(cam.cloudSkyHueParams.w, 0.0, 1.0) : 0.0;
    if(ambientUnify > 0.001)
    {
        // 反照率地板 0.05：ρ=0 的纯黑地面在物理上会让云底完全没有下界光，
        // 但那是极端值；地板避免出现"云底纯黑"的退化观感。
        vec3 groundRadianceColor = ambientTopColor * max(groundAlbedo, 0.05);
        ambientBottomColor = mix(ambientBottomColor, groundRadianceColor, ambientUnify);
    }

    // 朝阳侧暖环境（参考无此项；0 = 关闭 = 旧档）。只取色相、能量锚在 daylight
    // 上，避免整片加亮；循环内随 upwardAO 一起被云体自身遮蔽。
    float ambientSunSide = clamp(cam.cloudAmbientParams.z, 0.0, 2.0);
    vec3 ambientSunSideColor = vec3(0.0);
    if(ambientSunSide > 0.001)
    {
        float facing = smoothstep(-0.35, 0.55, dot(worldDirection, lightDirection));
        ambientSunSideColor = cloudHueOf(directLightColor) *
            (daylight * ambientSunSide * 0.22 * facing);
    }
    // ── #2 附：旧档"夕阳环境染色"（cloudLightParams.w）同样提到循环外 ──
    // 旧档在循环内逐样本算 smoothstep + 亮度除法；这里改成每像素一个**乘子**
    //（代数等价：ambient·(1−k+k·hue)）。k=0 时乘子恒 vec3(1) ⇒ 逐位旧档。
    // 2026-10-14：色相源从 cloudHueOf(directLightColor) 换成 skyLightHue ——
    // 这是"天光冷化"旋钮的第二落点（否则第二层夕阳染色会把冷化结果重新染回橙）。
    // skyHueCool=0 时 skyLightHue 逐位等于 cloudHueOf(directLightColor) ⇒ 逐位旧档。
    vec3 ambientTintMul = vec3(1.0);
    {
        float sunsetTintAmount = clamp(cam.cloudLightParams.w, 0.0, 1.0);
        if(sunsetTintAmount > 0.001)
        {
            float lowSun = (1.0 - smoothstep(0.03, 0.30, sunElevation)) *
                smoothstep(-0.02, 0.06, sunElevation);
            ambientTintMul = mix(vec3(1.0), skyLightHue,
                lowSun * sunsetTintAmount);
        }
    }
    // ── #5 太阳色沿相对光路（参考 EvaluateSunColor(envLighting, relativeRayDistance)）──
    // 端点每像素一次：红化色相取自 sky_sun_common 闭式透射基色在"贴地平"处的取值
    //（红光端，与天空模型单一真源）；循环内按光步返回的**相对光路距离**做保亮度
    // 混合 ⇒ 每样本只有一次 mix，没有每样本 exp。x = 0 ⇒ 逐位旧档。
    float sunPathRedden = clamp(cam.cloudLightParams2.x, 0.0, 2.0);
    vec3 sunPathHue = vec3(1.0);
    if(sunPathRedden > 0.001)
    {
        sunPathHue = mix(vec3(1.0),
            cloudHueOf(skySunPhysicalBaseColor(-0.02)), sunPathRedden);
    }
    // ── #6 散射染色（参考 _ScatteringTint 乘入消光）──
    // 多重散射能量带走当前阳光色相（旧档纯白 ⇒ 厚云内部的透光底不带暖色）。
    // x = 0 ⇒ 恒 vec3(1) ⇒ 逐位旧档。
    vec3 scatterTint = vec3(1.0);
    {
        float scatterTintAmount = clamp(cam.cloudMsParams2.x, 0.0, 1.0);
        if(scatterTintAmount > 0.001)
        {
            scatterTint = mix(vec3(1.0), cloudHueOf(directLightColor), scatterTintAmount);
        }
    }


    float transmittance = 1.0;
    vec3 scattering = vec3(0.0);
    float firstCloudDistance = CLOUD_DEPTH_EMPTY;
    // 批次2-T2c：透射率加权平均云深（软边时域重投影用）
    float meanDistAccum = 0.0;
    float meanDistWeight = 0.0;

    float startDistance;
    float endDistance;
    if(cloudDeckEnabled &&
       tyndallIntervalFar(cameraPosition, worldDirection, startDistance, endDistance))
    {
        endDistance = min(endDistance, sceneDistance);
        if(endDistance > startDistance + 0.01)
        {
            int viewSteps = clamp(int(cam.cloudParams2.x + 0.5), 1, MAX_VIEW_STEPS);
            endDistance = min(endDistance,
                startDistance + CLOUD_MAX_MARCH_LENGTH);
            // 长弦自适应加密（见 CLOUD_MAX_MARCH_LENGTH 注释）
            float marchChord = endDistance - startDistance;
            // 2026-10-07：加密上限改成"本档基础步数 × K"，不再恒 96。
            // 旧写法 clamp(..., viewSteps, MAX_VIEW_STEPS) 的下限是档位值、上限是 96，
            // 而 sqrt(弦长/8000) 在地平线带可达 5 ⇒ 性能档的 16 步也被顶到 80~96，
            // 于是"性能/平衡/高质量"在地平线那条带成本几乎一样，低档位省不下来。
            // K=4：16→64、20→80、28→112 钳到 96（高质量档逐位不变）。
            // CLOUD_GRAZING_STEP_CAP_MULTIPLE = 0 ⇒ 回到旧档。
            int grazingCap = CLOUD_GRAZING_STEP_CAP_MULTIPLE > 0
                ? min(MAX_VIEW_STEPS, viewSteps * CLOUD_GRAZING_STEP_CAP_MULTIPLE)
                : MAX_VIEW_STEPS;
            viewSteps = clamp(int(float(viewSteps) *
                sqrt(max(marchChord, 1.0) / 8000.0) + 0.5),
                viewSteps, grazingCap);
            #ifndef CLOUD_FIRE_RIM_STRENGTH
            // 2026-10-02 清理：火烧云总闸原本走 cloudParams6.x（GUI「火烧云强度」），但它
            // 只在 #if CLOUD_FIRE_HACK 分支里被使用 —— 该宏默认 0 ⇒ 那条链是死的，UI 与
            // JNI/配置已一并移除，这里改回编译期常量（仍是旧档的 2.2）。只有把
            // CLOUD_FIRE_HACK 置 1 做 A/B 回溯时才读它。
            #define CLOUD_FIRE_RIM_STRENGTH 2.2
            #endif
                                float fireRimStrength = CLOUD_FIRE_RIM_STRENGTH;
            // ── 批次1-A：太阳色沿视线路径红化（cloudParams6.y，0=关）──
            // Rayleigh 比例 (5.8/13.5/33.1)e-6 /格 × 穿层弦长作为线积分：斜视
            // 长弦蓝端先衰，夕阳水平视线红化最强；正午短弦几乎无感（弦长的
            // 几何自动完成）。端点每像素算一次，循环内按相对距离线性插值
            // （免每样本 exp）。=0 时端点恒 1 ⇒ 逐位旧档。
            vec3 sunRedEnd = vec3(1.0);
            if(cam.cloudParams6.y > 0.001)
            {
                sunRedEnd = exp(-vec3(5.8e-6, 13.5e-6, 33.1e-6) *
                    cam.cloudParams6.y * marchChord);
            }
            float stepLength = (endDistance - startDistance) / float(viewSteps);
            // ── 批次2-T2a：两级视步进（cloudMarchParams.y，0=旧均匀步进）──
            // 空样本用 cheap 探测（3 次读，跳过侵蚀/卷曲）以 2× 大步跨越；
            // 探测命中才做全量采样（5 次读）并按基准步长积分。probe 与全量
            // 同公式（cheap 只是 detail 以 0.5 平滑），detail 只减不增 ⇒
            // probe 未命中 ⇒ 全量必未命中，无假阴性。稀疏天空迭代数约省一半；
            // 密集云内靠透射率早退兜底，迭代上限 viewSteps×3 防退化。
            bool twoTier = cam.cloudMarchParams.y > 0.5;
            float stepLarge = twoTier ? stepLength * 2.0 : stepLength;
            // ── 2026-10-04 远段步长加密（cloudParams6.x；<=1 = 旧档，逐位不变）──
            // 地平线掠射带的"板条化"来自均匀步长：96 步摊到上百 km 时每步 2 km 级，
            // 积分量化台阶在屏幕上就是条带（与"云 march 分辨率跟着 RR 档位降采样"
            // 是两个独立成因）。这里让**步长随已走过的距离平滑收细**，外层最多收到
            // 1/density，近场逐位不动；用平滑 ramp 而非硬切，避免步长突变造成接缝。
            // 迭代上限同步放宽，否则外层会被 iterCap 截断成硬边。
            // density = 1 ⇒ 全程倍率恒 1.0、补偿恒 0 ⇒ 与旧档逐位相同。
            const float farStepDensity = clamp(cam.cloudParams6.x, 1.0, 4.0);
            const float farStepMid = startDistance + (endDistance - startDistance) * 0.5;
            const float farStepRamp = max(farStepMid - startDistance, 1.0);
#define VL_FAR_STEP_SCALE(d) mix(1.0, 1.0 / farStepDensity, \
    clamp(((d) - farStepMid) / farStepRamp, 0.0, 1.0))
            int iterCap = twoTier ? viewSteps * 3 : viewSteps;
            iterCap += int(ceil(max(farStepDensity - 1.0, 0.0) * float(viewSteps) * 0.5));
            float distance = startDistance + jitter * stepLarge;
            // ── 2026-10-02：远景距离衰减（球壳表征在远处露破绽的收口）─────────
            // 为什么会怪：云层是个球壳，远处同时出现三件事 ——
            //   1) 曲率把整层压成"碗"（地平线附近的云往下弯）；
            //   2) 掠射长弦（可达 200+ km）把云摊成条带，步长再密也救不回来；
