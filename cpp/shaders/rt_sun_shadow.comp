#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require

// 太阳阴影图的生产者（2026-09-25）。
//
// 每帧派发一次，256×256，每个纹素一条射线 —— 6.5 万条，对比逐 march 样本
// 发射线方案最坏情况下的 290 万条。存的是"沿太阳方向首个遮挡体的距离"，
// 消费者（体积光 / 体积雾）拿自己的深度去比较。完整论证见 sun_shadow.glsl。
//
// 这个 pass 之所以能这么便宜，是因为它和屏幕分辨率、和 march 步数都无关：
// 一次固定开销，被所有像素、所有 march 样本共用。
//
// 设备要求：VK_KHR_ray_query（计算着色器用不了 traceRayEXT，见 sun_shadow.glsl）。

layout(local_size_x = 8, local_size_y = 8) in;

// 只需要到 historyParams 为止的前缀。std140 里"少声明"是安全的
// （多声明、或者跳过某个成员再继续才致命），而这个 pass 不读任何
// 云/雾/天空参数。
layout(set = 0, binding = 0) uniform CameraProperties
{
    #include "camera_ubo.glsl"
} cam;

layout(set = 0, binding = 1) uniform accelerationStructureEXT sceneTlas;

// 首遮挡体距离，沿太阳方向、从盒的上风侧边界量起。没打到东西就是 2×EXTENT_Z。
layout(set = 0, binding = 2, r32f) uniform image2D sunShadowImage;

// 选择 sun_shadow.glsl 里的"生产者"半边（射线追踪函数）。消费者半边
// （sunShadowVisibility）依赖 sampler2D sunShadowMap，这个 pass 没有，不选。
#define SUN_SHADOW_PRODUCER 1
#include "sun_shadow.glsl"


void main()
{
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if(texel.x >= SUN_SHADOW_RESOLUTION || texel.y >= SUN_SHADOW_RESOLUTION)
    {
        return;
    }

    vec3 sunDirection = sunShadowLightDirection();
    vec2 uv = (vec2(texel) + 0.5) / float(SUN_SHADOW_RESOLUTION);
    // 起点在**朝太阳**那一端（sunShadowRayOrigin 内部取 +sunDirection*EXTENT_Z，
    // 2026-10-10 修正），所以射线朝场景打 = 沿 -sunDirection 向下。
    vec3 origin = sunShadowRayOrigin(uv, sunDirection, sunShadowCenter());

    imageStore(
        sunShadowImage,
        texel,
        vec4(sunShadowTraceDepth(origin, -sunDirection,
            2.0 * SUN_SHADOW_EXTENT_Z), 0.0, 0.0, 0.0));
}
