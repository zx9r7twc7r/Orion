#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require


layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform CameraProperties
{
    #include "camera_ubo.glsl"
} cam;

layout(set = 0, binding = 1) uniform accelerationStructureEXT sceneTlas;

layout(set = 0, binding = 2, r32f) uniform image2D sunShadowImage;

#define SUN_SHADOW_PRODUCER 1
#include "sun_shadow.glsl"


void main()
{
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if(texel.x >= SUN_SHADOW_RESOLUTION || texel.y >= SUN_SHADOW_RESOLUTION)
    {
        return;
    }

    vec3 sunDirection = sunShadowLightDirection();
    vec2 uv = (vec2(texel) + 0.5) / float(SUN_SHADOW_RESOLUTION);
    vec3 origin = sunShadowRayOrigin(uv, sunDirection, sunShadowCenter());

    imageStore(
        sunShadowImage,
        texel,
        vec4(sunShadowTraceDepth(origin, -sunDirection,
            2.0 * SUN_SHADOW_EXTENT_Z), 0.0, 0.0, 0.0));
}
