#version 460
#extension GL_GOOGLE_include_directive : require


layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2DArray waterStateInput;
layout(rg16f, set = 0, binding = 1) uniform writeonly image2DArray waterStateOutput;

layout(set = 0, binding = 2) uniform CameraProperties
{
    #include "camera_ubo.glsl"
} cam;

layout(set = 0, binding = 3) uniform WaterSimEntities
{
    ivec4 entityCounts;
    vec4 entityImpulses[8];
    vec4 entityBoats[8];
    vec4 entityBoatParams[8];
} simEntities;
layout(push_constant) uniform WaterSimulationPush
{
    uvec4 layersAndFlags;
    vec4 updateAndImpulse;
    ivec4 scrollAndPadding;
    vec4 waveParams;
    float waveSpeed;
    float waveShapeScale;
    float waveShapeAngle;
    float waveShapeCrest;
    float waveShapeWarp;
} pushData;

const ivec2 RESOLUTION = ivec2(512);

vec3 readState(ivec2 texel)
{
    ivec2 clampedTexel = clamp(texel, ivec2(0), RESOLUTION - ivec2(1));
    return texelFetch(
        waterStateInput,
        ivec3(clampedTexel, int(pushData.layersAndFlags.x)),
        0
    ).rgb;
}

// 高度 pass 读的是动量 pass 的输出层（layersAndFlags.y），坐标已对齐、无滚动。
vec3 readHeightPassState(ivec2 texel)
{
    ivec2 clampedTexel = clamp(texel, ivec2(0), RESOLUTION - ivec2(1));
    return texelFetch(
        waterStateInput,
        ivec3(clampedTexel, int(pushData.layersAndFlags.y)),
        0
    ).rgb;
}

float concentricRipples(vec2 delta, float radius, float rings)
{
    float dist = length(delta);
    if(dist >= radius)
    {
        return 0.0;
    }
    float envelope = 0.5 + 0.5 * cos((dist / radius) * 3.14159265359);
    float wave = cos((dist / radius) * rings * 6.28318530718);
    return wave * envelope;
}

// 参考 HPWaterWaveEquation 的高斯波源：sigma = radius*0.4、中心连续、边界归零。
// 参考另有 min(ripple, 0.05) 的安全帽 —— 那是它自己归一化下的值；本引擎的场是
// 世界格量纲（height 另有 ±4 安全阀，见 main 末尾），所以这里保留形状与
// "边界平滑归零"的语义，幅值仍按本引擎标定（调用处与旧路径同系数）。
float gaussianWaveSource(vec2 delta, float radius)
{
    float r = length(delta);
    if(r >= radius)
    {
        return 0.0;
    }
    float sigma = radius * 0.4;
    return exp(-r * r / max(2.0 * sigma * sigma, 1.0e-6));
}

