#version 460
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
#include "bruneton/definitions.glsl"
#include "bruneton/atmosphere.glsl"
#include "bruneton/common.glsl"
#include "bruneton/precompute.glsl"
layout(push_constant) uniform PC {
    int pcLayer;
    int pcAdditive;
    int pcScatteringOrder;
    int pcOutput;
} pc;
layout(set = 0, binding = 0) uniform sampler2D transmittanceTexture;
layout(set = 0, binding = 21) uniform sampler3D deltaScatteringDensityTexture;
layout(rgba32f, set = 0, binding = 13) uniform image3D outScattering;
layout(rgba32f, set = 0, binding = 19) uniform image3D outDeltaMultipleScattering;

void main() {
    ivec3 pix = ivec3(gl_GlobalInvocationID);
    if (pix.x >= SCATTERING_TEXTURE_WIDTH ||
        pix.y >= SCATTERING_TEXTURE_HEIGHT ||
        pix.z >= SCATTERING_TEXTURE_DEPTH) return;
    vec3 frag = vec3(pix) + 0.5;
    float nu;
    vec4 deltaMultipleScattering;
    deltaMultipleScattering.rgb = ComputeMultipleScatteringTexture(
        ATMOSPHERE, transmittanceTexture, deltaScatteringDensityTexture,
        frag, nu);
    deltaMultipleScattering.a = 1.0;
    vec4 scattering = vec4(
        deltaMultipleScattering.rgb / RayleighPhaseFunction(nu), 0.0);
    if (pc.pcOutput == 0) {
        imageStore(outDeltaMultipleScattering, pix, deltaMultipleScattering);
    } else {
        vec4 value = scattering;
        if (pc.pcAdditive == 1) value += imageLoad(outScattering, pix);
        imageStore(outScattering, pix, value);
    }
}
