#version 460
#extension GL_GOOGLE_include_directive : require

// ===========================================================================
// vol_restir_spatial.comp —— 体积光 ReSTIR（S3：空间复用）
//
// 5 个 dispatch 的第 3 个：
//
//   initial(RIS) → temporal → spatial → integrate
//                              ^^^^^^^^ 本文件
//
// 职责：把 restir 网格上 3D 邻域（自身 + 8 个对角邻居）的 reservoir 合并，
// 用更多样本来换噪点下降。邻居跨 x/y（屏幕相邻块）和 z（相邻距离层），所以
// 合并不会把"近处的火把"糊到"远处的雾"上——z 差一层的世界距离差远小于
// 灯的衰减尺度。
//
// 合并权重用彼此的 weightSum（= 该 reservoir 的 WRS 全和）。严格说 ReSTIR
// 应在新位置重算 target function p̂(y)，但那需要为每个邻居重新查灯表并算相位；
// 本工程 stage 数量已经不小，这里先用 weightSum 作为合并权重（同一套
// decodeLocalLightColor / VPT 衰减口径，灯身份不变），偏差体现为空间过渡略软，
// 不会产生亮度漂移。若将来需要严格无偏，再引入 p̂ 重算。
//
// 输出写 R1（上一帧最终结果那张），因为 R0 此刻是本帧 temporal 的输出、
// integrate 之前还要留着；两图角色固定不轮换（见 vol_restir_temporal.comp 头注释）。
//
// 绑定（set 0）———————————————————————————————————————————————
//   0 CameraProperties   （camera_ubo.glsl；只有帧号用得到）
//   1 reservoir 输入      rgba32ui image3D，只读
//   2 reservoir 输出      rgba32ui image3D，只写
// ===========================================================================

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform CameraProperties
{
    #include "camera_ubo.glsl"
} cam;

#include "vol_restir_common.glsl"

layout(rgba32ui, set = 0, binding = 1) uniform readonly uimage3D volReservoirIn;
layout(rgba32ui, set = 0, binding = 2) uniform writeonly uimage3D volReservoirOut;

layout(push_constant) uniform VolRestirSpatialPush
{
    // x = 邻域半径（当前恒 1）, y = 保留, z = 保留, w = 帧种子
    vec4 spatialParams;
} pc;

const int SPATIAL_MAX_CANDIDATES = 9;

void main()
{
    ivec3 restirCoord = ivec3(gl_GlobalInvocationID);
    ivec3 restirSize = ivec3(imageSize(volReservoirIn));

    if(any(greaterThanEqual(restirCoord, restirSize)))
    {
        return;
    }

    VolReservoir candidates[SPATIAL_MAX_CANDIDATES];
    float candidateWeight[SPATIAL_MAX_CANDIDATES];
    int candidateCount = 0;
    float weightTotal = 0.0;

    for(int slot = 0; slot < SPATIAL_MAX_CANDIDATES; ++slot)
    {
        ivec3 offset = ivec3(0);
        if(slot > 0)
        {
            const int bitIndex = slot - 1;
            offset = ivec3(
                ((bitIndex & 1) != 0) ? 1 : -1,
                ((bitIndex & 2) != 0) ? 1 : -1,
                ((bitIndex & 4) != 0) ? 1 : -1);
        }

        ivec3 sampleCoord = restirCoord + offset;
        if(any(lessThan(sampleCoord, ivec3(0))) ||
           any(greaterThanEqual(sampleCoord, restirSize)))
        {
            continue;
        }

        VolReservoir reservoir = volRestirUnpack(
            imageLoad(volReservoirIn, sampleCoord));

        // 空 reservoir（无灯 froxel）不参与合并：它的 weightSum 是 0，
        // 保留它只会让"有灯的邻居"被稀释。
        if(reservoir.sampleCount == 0u || reservoir.lightIndex == 0u)
        {
            continue;
        }

        float weight = max(reservoir.weightSum, 0.0);
        candidates[candidateCount] = reservoir;
        candidateWeight[candidateCount] = weight;
        weightTotal += weight;
        ++candidateCount;
    }

    if(candidateCount == 0 || weightTotal <= 1.0e-6)
    {
        imageStore(volReservoirOut, restirCoord, uvec4(0u, 0u, 0u, 0u));
        return;
    }

    // ---- 按 weightSum 做一次 WRS ----
    uint randomState = volRestirSeed(restirCoord,
        cam.frameCount + uint(pc.spatialParams.w));

    float pick = volRestirRand(randomState) * weightTotal;
    float runningSum = 0.0;
    int selectedIndex = candidateCount - 1;

    for(int i = 0; i < candidateCount; ++i)
    {
        runningSum += candidateWeight[i];
        if(pick <= runningSum)
        {
            selectedIndex = i;
            break;
        }
    }

    VolReservoir merged = candidates[selectedIndex];
    merged.weightSum = weightTotal;
    merged.weight = weightTotal / float(max(merged.sampleCount, 1u));

    imageStore(volReservoirOut, restirCoord, volRestirPack(merged));
}
