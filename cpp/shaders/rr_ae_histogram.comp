#version 460

// RR-7 auto exposure: log2-luminance histogram.
//
// One invocation reduces one 8x8 tile of the DLSS output to a single log2
// luminance sample and bins it.  Reducing inside the thread keeps the atomic
// traffic at width*height/64 while every pixel still contributes, so the
// histogram is stable across frames without a full-resolution atomic pass.
//
// The bin layout is shared with rr_ae_adapt.comp.  Both files must agree on
// the EV range and the bin count or the exposure will be misread.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, set = 0, rgba16f)
uniform image2D rrOutputImage;

layout(binding = 1, set = 0)
buffer AeHistogram
{
    uint bins[256];
};

// 16 EV of log2(luminance), with 0 EV == SDR reference white.
const float AE_LOG2_MIN = -10.0;
const float AE_LOG2_MAX = 6.0;
const uint AE_BIN_COUNT = 256u;
const float AE_LUMA_FLOOR = 1.0e-5;

const vec3 AE_LUMA_WEIGHTS = vec3(0.2126, 0.7152, 0.0722);

void main()
{
    ivec2 size = imageSize(rrOutputImage);

    // The tile stride is a compile-time constant, so express it as an int
    // literal rather than round-tripping the float.
    ivec2 origin = ivec2(gl_GlobalInvocationID.xy) * 8;

    if(origin.x >= size.x || origin.y >= size.y)
    {
        return;
    }

    float sumLog = 0.0;
    uint valid = 0u;

    for(int y = 0; y < 8; ++y)
    {
        for(int x = 0; x < 8; ++x)
        {
            ivec2 p = origin + ivec2(x, y);

            if(p.x >= size.x || p.y >= size.y)
            {
                continue;
            }

            vec3 c = max(imageLoad(rrOutputImage, p).rgb, vec3(0.0));

            float luma = dot(c, AE_LUMA_WEIGHTS);

            sumLog += log2(max(luma, AE_LUMA_FLOOR));
            valid += 1u;
        }
    }

    if(valid == 0u)
    {
        return;
    }

    float logLuma = sumLog / float(valid);

    float t = clamp(
        (logLuma - AE_LOG2_MIN) / (AE_LOG2_MAX - AE_LOG2_MIN),
        0.0,
        1.0
    );

    uint bin = min(uint(t * float(AE_BIN_COUNT)), AE_BIN_COUNT - 1u);

    atomicAdd(bins[bin], 1u);
}
