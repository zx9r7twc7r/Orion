#version 460
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D cloudInput;
layout(rgba16f, set = 0, binding = 1) uniform image2D sceneOutputNear;
layout(rgba16f, set = 0, binding = 6) uniform image2D sceneOutputFar;
layout(set = 0, binding = 2) uniform sampler2D sceneDepth;
layout(set = 0, binding = 5) uniform sampler2D cloudDepthImage;

layout(push_constant) uniform CloudCompositePush
{
    float splitDistance;
    float mode;
} pc;
layout(set = 0, binding = 3) uniform CameraProperties
{
    #include "camera_ubo.glsl"
} cam;

layout(set = 0, binding = 4) readonly buffer AeState
{
    float currentEV;
    float targetEV;
    float avgLogLuma;
    uint sampleCount;
    float cloudWhite;
};

const float CLOUD_SHOULDER_KNEE = 0.75;

vec3 cloudShoulder(vec3 radiance, float displayWhite)
{
    float knee = displayWhite * CLOUD_SHOULDER_KNEE;
    float span = max(displayWhite - knee, 1.0e-4);
    vec3 over = max(radiance - vec3(knee), vec3(0.0));

    return min(radiance, vec3(knee)) + vec3(span) * over / (over + vec3(span));
}

vec4 reconstructCloud(vec2 uv, bool oneToOne, bool downsampling)
{
    vec4 centerSample = textureLod(cloudInput, uv, 0.0);
    if(oneToOne)
    {
        centerSample.a = clamp(centerSample.a, 0.0, 1.0);
        return centerSample;
    }
    if(downsampling)
    {
        centerSample.a = clamp(centerSample.a, 0.0, 1.0);
        return centerSample;
    }
    vec2 texel = 1.0 / vec2(textureSize(cloudInput, 0));

    const int K = 2;
    const float centerZ = min(textureLod(cloudDepthImage, uv, 0.0).r, 1.0e6);
    vec4 sum = vec4(0.0);
    float weightSum = 0.0;

    for(int j = -K; j <= K; ++j)
    {
        for(int i = -K; i <= K; ++i)
        {
            const vec2 ouv = uv + vec2(float(i), float(j)) * texel;
            const vec4 c = textureLod(cloudInput, ouv, 0.0);
            const float z = min(textureLod(cloudDepthImage, ouv, 0.0).r, 1.0e6);

            const float wSpatial = exp(-float(i * i + j * j) * 0.35);
            const float colorDiff = length(c.rgb - centerSample.rgb) +
                abs(c.a - centerSample.a);
            const float wColor = 1.0 / (colorDiff + 1.0e-3);
            const float wDepth = exp(-abs(z - centerZ) / max(centerZ, 1.0) * 40.0);

            const float w = wSpatial * wColor * wDepth;
            sum += c * w;
            weightSum += w;
        }
    }

    vec4 result = sum / max(weightSum, 1.0e-5);

    const vec4 cross = textureLod(cloudInput, uv + vec2(texel.x, 0), 0.0) +
                       textureLod(cloudInput, uv - vec2(texel.x, 0), 0.0) +
                       textureLod(cloudInput, uv + vec2(0, texel.y), 0.0) +
                       textureLod(cloudInput, uv - vec2(0, texel.y), 0.0);
    const vec4 sharpened = centerSample * 1.42 - cross * 0.105;
    result = mix(result, sharpened, 0.25);

    result.rgb = max(result.rgb, vec3(0.0));
    result.a = clamp(result.a, 0.0, 1.0);
    return result;
    

}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    bool farPass = pc.mode >= 0.5;
    ivec2 size = farPass ? imageSize(sceneOutputFar) : imageSize(sceneOutputNear);
    if(any(greaterThanEqual(pixel, size)))
    {
        return;
    }
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);

    if(pc.splitDistance > 0.0)
    {
        float cloudDistance = textureLod(cloudDepthImage, uv, 0.0).r;
        bool pixelIsFarBand = cloudDistance >= pc.splitDistance;
        bool thisPassIsFarBand = pc.mode >= 0.5;
        if(pixelIsFarBand != thisPassIsFarBand)
        {
            return;
        }
    }

    vec4 scene = farPass
        ? imageLoad(sceneOutputFar, pixel)
        : imageLoad(sceneOutputNear, pixel);
    ivec2 cloudSize = textureSize(cloudInput, 0);
    vec4 cloud = reconstructCloud(uv, cloudSize == size, cloudSize.x > size.x);
    cloud.rgb = cloudShoulder(cloud.rgb, cloudWhite);
    scene.rgb = scene.rgb * cloud.a + cloud.rgb;
    if(farPass)
    {
        imageStore(sceneOutputFar, pixel, scene);
    }
    else
    {
        imageStore(sceneOutputNear, pixel, scene);
    }
}
