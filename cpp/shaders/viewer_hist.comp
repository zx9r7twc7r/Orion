#version 460
#extension GL_GOOGLE_include_directive : require

// ===========================================================================
// 覆盖度标定用的直方图 pass（诊断工具，只在 --hist 时跑一次）
//
// 为什么需要它：覆盖度滑条 = m_norm 的阈值，而 m_norm 的分布取决于 base 体积 +
// 高度剖面 + 归一化系数。前面靠"改系数→看图"盲拟合了三轮都失败（一次全白、
// 一次一朵云都没有）。这里直接把 m_norm 分 256 档统计出来，用 CDF 反解滑条，
// 一次到位，不再猜。
//
// 统计对象（与 bevyGetDensity 里**进入 smoothstep 之前**的 m 完全一致）：
//   m = (bevyCloudMapBase(pos, h) * bevyCloudGradient(h) - OFFSET) * GAIN
// ===========================================================================

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "cloud_bevy_core.glsl"

layout(set = 0, binding = 0, std140) uniform PreviewParams
{
    vec4 cameraPosition;
    vec4 cameraForward;
    vec4 cameraRight;
    vec4 cameraUp;
    vec4 sunDirection;
    vec4 layer;
    vec4 shape;
    vec4 light;
    vec4 extras;
    vec4 steps;
    vec4 sky;
} params;

layout(set = 0, binding = 3) uniform sampler2D atlasTex;
layout(set = 0, binding = 9) uniform sampler3D baseTex;
layout(set = 0, binding = 11) restrict buffer HistBuffer
{
    uint bins[256];
};

void main()
{
    ivec3 id = ivec3(gl_GlobalInvocationID);
    ivec3 size = ivec3(64);
    if(any(greaterThanEqual(id, size))) return;

    BevyCloudConfig cfg;
    cfg.planetRadius = 6360000.0;
    cfg.baseScale = max(params.shape.z, 0.05);
    cfg.coverage = clamp(params.shape.x, 0.0, 1.0);
    cfg.density = params.shape.y * 0.010;
    cfg.detailScale = clamp(params.shape.w, 0.1, 4.0) * 8.0;
    cfg.detailStrength = clamp(params.extras.x / 0.15, 0.0, 2.0) * 0.5;
    cfg.baseEdgeSoftness = max(params.extras.y, 0.05);
    cfg.bottomSoftness = max(params.extras.z, 0.02);
    cfg.bottomHeight = params.layer.x;
    cfg.topHeight = params.layer.y;

    // 在 2×2×2 个 tile 的范围里采样，高度取 0..1 均匀
    float period = 1.0 / (0.00035 * cfg.baseScale);
    vec3 world = (vec3(id) + vec3(0.5)) / vec3(size);
    vec3 localPos = vec3(world.x * 2.0 * period, 0.0, world.z * 2.0 * period);
    float h = world.y;

    vec2 atlasSize = vec2(textureSize(atlasTex, 0));
    vec3 pos = localPos + vec3(0.0, cfg.planetRadius + mix(cfg.bottomHeight,
        cfg.topHeight, h), 0.0);

    float m = bevyCloudMapBase(pos, h, cfg, atlasTex, atlasSize, baseTex) * bevyCloudGradient(h);
    // 与 bevyGetDensity 里的归一化保持同一组常数
    m = (m - 0.30) * 2.5;

    uint bin = uint(clamp(m, 0.0, 0.9999) * 256.0);
    atomicAdd(bins[bin], 1u);
}
