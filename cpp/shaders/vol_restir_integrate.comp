#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require


layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform CameraProperties
{
    #include "camera_ubo.glsl"
} cam;

#include "local_light_grid_common.glsl"
#include "vol_restir_common.glsl"
#include "spherical_harmonics.glsl"

layout(rgba32ui, set = 0, binding = 1) uniform readonly uimage3D volReservoirIn;
layout(rgba16f, set = 0, binding = 15) uniform writeonly image3D volRadianceOut;

layout(rgba16f, set = 0, binding = 16) uniform readonly image3D volShYPrev;
layout(rgba16f, set = 0, binding = 17) uniform readonly image3D volShCoCgPrev;
layout(r8,      set = 0, binding = 18) uniform readonly image3D volShAgePrev;
layout(rgba16f, set = 0, binding = 19) uniform writeonly image3D volShYOut;
layout(rgba16f, set = 0, binding = 20) uniform writeonly image3D volShCoCgOut;
layout(r8,      set = 0, binding = 21) uniform writeonly image3D volShAgeOut;

layout(set = 0, binding = 22) uniform accelerationStructureEXT sceneTlas;

layout(push_constant) uniform VolRestirIntegratePush
{
    ivec4 froxelSize;
    vec4 volumeParams;
} pc;

const float VOL_RESTIR_PI = 3.141592653589793;

const float VOL_SH_MAX_ACCUMULATION_FRAMES = 128.0;
const float VOL_SH_FIREFLY_LUMINANCE_THRESHOLD = 1000.0;
const float VOL_SH_HISTORY_AGE_OFFSET = 5.0;

// 与 volumetric_clouds_v3.comp:60 逐行一致。
float hgPhase(float cosine, float g)
{
    float g2 = g * g;
    float denominator = max(1.0e-4, 1.0 + g2 - 2.0 * g * cosine);

    return (1.0 - g2) / (4.0 * VOL_RESTIR_PI * denominator * sqrt(denominator));
}

const float FOG_LIGHT_PHASE_SCALE = 0.62;
const float FOG_LIGHT_PHASE_FLOOR = 0.02;
const float FOG_LIGHT_PHASE_G = 0.40;

float volRestirLightPhase(vec3 toLight, vec3 viewDirection)
{
    const float distanceToLight = max(length(toLight), 1.0e-4);
    const float cosine = dot(-toLight / distanceToLight, viewDirection);

    return FOG_LIGHT_PHASE_FLOOR +
        FOG_LIGHT_PHASE_SCALE * hgPhase(cosine, FOG_LIGHT_PHASE_G);
}

// ---------------------------------------------------------------------------
// 每 froxel 的 NEE 可见性射线（2026-10-28）
//
// 为什么必须有：reservoir 里那点"可见性"是 vol_restir_visibility.comp 在
// **restir 网格**（froxel÷4；1080p 下每格 32×32 像素）的块中心判出来的，本 pass
// 按 froxelCoord/4 取同一个 reservoir ⇒ 4×4 个 froxel 共享一次遮挡判定 ⇒ 门框、
// 墙角、方块边缘必然多漏一整块。这不是调参能盖住的粒度问题，只能在这一层重判。
//
// 口径逐项照抄 Remix：
//   · 结构：_ref/dxvk-remix/submodules/rtxdi/rtxdi-sdk/include/volumetrics/rtx/
//     algorithm/volume_integrator.slangh:44-55（evalNEE）——reservoir 只用来
//     **选灯**，遮挡永远在该 froxel 自己的位置重测；
//   · 射线口径：同目录 volume_integrator_helpers.slangh:9-38。
//   · **不带**背面剔除。Remix 为此专门传 visibilityModeDisableCulling
//     （src/dxvk/shaders/rtx/algorithm/visibility.slangh:34），注释原文：
//     "Culling disabled via visibilityModeDisableCulling to avoid light leaking
//      through geometry as this is especially bad in volumetrics due to how the
//      voxels leak through walls to begin with."。
//     我们的地形是单面壳，一旦把 gl_RayFlagsCullBackFacingTrianglesEXT 加进来
//     就会立刻漏光 —— rt_test.rgen 的直射阴影射线带这个标志，**不要**照抄。
//   · TerminateOnFirstHit | SkipClosestHitShader：只判有无遮挡，不取着色结果。
//   · 掩码 0xFF：与 vol_restir_visibility.comp 同口径（玻璃等透明体也挡光）。
// ---------------------------------------------------------------------------
bool volRestirNeeVisible(vec3 froxelCenter, vec3 lightPosition, float distanceToLight)
{
    const float originBias = 0.05;
    const float tMin = originBias;
    const float tMax = distanceToLight - originBias;

    if(tMax <= tMin)
    {
        return true;
    }

    const vec3 rayDirection =
        (lightPosition - froxelCenter) / max(distanceToLight, 1.0e-4);

    rayQueryEXT rayQuery;
    rayQueryInitializeEXT(rayQuery, sceneTlas,
        gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT,
        0xFFu,
        froxelCenter + rayDirection * originBias, tMin,
        rayDirection, tMax);

    while(rayQueryProceedEXT(rayQuery))
    {
    }

    return rayQueryGetIntersectionTypeEXT(rayQuery, true) ==
        gl_RayQueryCommittedIntersectionNoneEXT;
}

// 原文 rtx/utility/common.slangh:37-47，逐行。
vec3 fireflyFiltering(vec3 contribution, float fireflyFilterMaxIntensity)
{
    if(fireflyFilterMaxIntensity > 0.0)
    {
        const float magicNumber = 1.0e-5;
        const float luminance = dot(contribution, vec3(0.2126, 0.7152, 0.0722));
        const float clampedLuminance = min(luminance, fireflyFilterMaxIntensity);
        contribution = (luminance > magicNumber)
            ? (contribution * (clampedLuminance / luminance))
            : contribution;
    }
    return contribution;
}

// loadFiltered3D 的等价实现：SH 图是 storage image（没有 sampler），
// 手写 8-tap 三线性（权重定义与硬件三线性完全相同）。
SphericalHarmonic volShLoadTrilinear(ivec3 size, vec3 coordinate)
{
    const vec3 clamped = clamp(coordinate, vec3(0.0), vec3(size - ivec3(1)));
    const ivec3 base = ivec3(floor(clamped));
    const ivec3 upper = min(base + ivec3(1), size - ivec3(1));
    const vec3 fraction = clamped - vec3(base);

    SphericalHarmonic result = shCreate();

    for(int dz = 0; dz < 2; ++dz)
    {
        for(int dy = 0; dy < 2; ++dy)
        {
            for(int dx = 0; dx < 2; ++dx)
            {
                const ivec3 p = ivec3(
                    dx == 0 ? base.x : upper.x,
                    dy == 0 ? base.y : upper.y,
                    dz == 0 ? base.z : upper.z);

                const float w =
                    (dx == 0 ? 1.0 - fraction.x : fraction.x) *
                    (dy == 0 ? 1.0 - fraction.y : fraction.y) *
                    (dz == 0 ? 1.0 - fraction.z : fraction.z);

                result.shY += imageLoad(volShYPrev, p) * w;
                result.cocg += imageLoad(volShCoCgPrev, p).xy * w;
            }
        }
    }

    return result;
}

void main()
{
    ivec3 froxelCoord = ivec3(gl_GlobalInvocationID);
    ivec3 froxelSize = ivec3(imageSize(volRadianceOut));

    if(any(greaterThanEqual(froxelCoord, froxelSize)))
    {
        return;
    }

    ivec3 restirSize = ivec3(imageSize(volReservoirIn));
    int restirDownscale = max(pc.froxelSize.w, 1);

    ivec3 restirCoord = clamp(
        ivec3(froxelCoord.xy / restirDownscale, froxelCoord.z),
        ivec3(0), restirSize - ivec3(1));

    VolReservoir reservoir = volRestirUnpack(imageLoad(volReservoirIn, restirCoord));

    vec3 froxelCenter = volRestirFroxelCenter(
        froxelCoord, froxelSize, vec2(pc.froxelSize.xy), 1,
        pc.volumeParams.x, pc.volumeParams.y);

    vec3 cameraPosition = cam.viewInverse[3].xyz;
    vec3 viewDirection = normalize(froxelCenter - cameraPosition);

    vec3 radiance = vec3(0.0);
    vec3 lightDir = vec3(0.0);
    bool hasLight = false;

    if(reservoir.lightIndex != 0u && reservoir.sampleCount != 0u)
    {
        uint tableIndex = reservoir.lightIndex - 1u;

        if(tableIndex < fogLightBuffer.header.x)
        {
            LocalLightGPU light = fogLightBuffer.lights[tableIndex];
            float emissionLevel = light.worldPosEmission.w;

            if(emissionLevel > 0.0)
            {
                vec3 toLight = light.worldPosEmission.xyz - froxelCenter;
                float distanceToLight = length(toLight);

                float energyScale = LOCAL_LIGHT_ENERGY_SCALE * localLightIntensity();
                float attenuation = vptLocalLightDistanceAttenuation(distanceToLight);
                float rangeFade = vptLocalLightRangeFade(distanceToLight, emissionLevel);

                if(rangeFade > 0.0 &&
                   volRestirNeeVisible(froxelCenter, light.worldPosEmission.xyz,
                       distanceToLight))
                {
                    float phase = volRestirLightPhase(toLight, viewDirection);

                    radiance = decodeLocalLightColor(light.meta.x) *
                        emissionLevel * attenuation * rangeFade * energyScale * phase;

                    lightDir = normalize(toLight);
                    hasLight = true;
                }
            }
        }
    }

    imageStore(volRadianceOut, froxelCoord, vec4(radiance, hasLight ? 1.0 : 0.0));

    SphericalHarmonic oldRadianceSH = shCreate();
    float newHistoryAge = 0.0;
    float historyAgeWeight = 1.0;

    {
        vec4 prevClip = volRestirPrevViewProj() * vec4(froxelCenter, 1.0);
        vec2 prevUV = vec2(-1.0);

        if(prevClip.w > 1.0e-6)
        {
            prevUV = (prevClip.xy / prevClip.w) * vec2(0.5, -0.5) + 0.5;
        }

        const bool reprojectionValid =
            all(greaterThanEqual(prevUV, vec2(0.0))) &&
            all(lessThan(prevUV, vec2(1.0)));

        if(reprojectionValid)
        {
            vec3 prevFroxelCoordinate = vec3(
                prevUV * vec2(froxelSize.xy),
                float(froxelCoord.z) + 0.5);

            oldRadianceSH = volShLoadTrilinear(froxelSize, prevFroxelCoordinate);

            const float oldHistoryAge =
                imageLoad(volShAgePrev, froxelCoord).r * VOL_SH_MAX_ACCUMULATION_FRAMES;

            newHistoryAge = min(oldHistoryAge + 1.0, VOL_SH_MAX_ACCUMULATION_FRAMES);

            if(newHistoryAge > 1.0)
            {
                historyAgeWeight = 1.0 / (newHistoryAge + VOL_SH_HISTORY_AGE_OFFSET);
            }
        }
    }

    SphericalHarmonic radianceSH = shCreate();

    if(hasLight)
    {
        shAddRadiance(
            radianceSH,
            fireflyFiltering(radiance, VOL_SH_FIREFLY_LUMINANCE_THRESHOLD),
            lightDir);
    }

    const SphericalHarmonic newRadianceSH =
        shLerp(oldRadianceSH, radianceSH, historyAgeWeight);

    imageStore(volShYOut, froxelCoord, newRadianceSH.shY);
    imageStore(volShCoCgOut, froxelCoord, vec4(newRadianceSH.cocg, 0.0, 0.0));
    imageStore(
        volShAgeOut,
        froxelCoord,
        vec4(newHistoryAge / VOL_SH_MAX_ACCUMULATION_FRAMES, 0.0, 0.0, 0.0));
}
