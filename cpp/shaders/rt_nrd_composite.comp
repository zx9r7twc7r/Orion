#version 460
#extension GL_GOOGLE_include_directive : require

// =====================================================
// NRD-1  local direct-light composite
//
// The NRD counterpart of rt_restir_reconstruct.comp.  That pass temporally
// filtered the raw local DI itself; here NRD's REBLUR_DIFFUSE has already done
// the denoising, so this pass only has to put the result back into the image.
//
// It reproduces the tail of the pass it replaces EXACTLY, so the only thing
// that changes in the final frame is HOW the term was filtered:
//   * the demodulation is unchanged -- the reservoir's packed receiver albedo
//     multiplies the filtered IRRADIANCE, which is what the old pass did too
//     ("max(filteredLighting, 0.0) * unpackReceiverAlbedo(packedAlbedo)")
//   * the 6.0 luminance guard is unchanged
//   * the alpha channel is preserved from the colour image
//
// Bindings:
//   1  colour image (read/write; the denoised local DI is added into it)
//   41 the ReSTIR DI spatial reservoir.  Read only for metadata.w, which holds
//      the receiver albedo that rt_test.rgen packed there; the RayGen that runs
//      before this pass rewrites only sampleAndAreaPdf.
//   53 NRD's OUT_DIFF_RADIANCE_HITDIST
// =====================================================

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 1, set = 0, rgba16f)
uniform image2D image;

struct ReSTIRDIReservoir
{
    vec4 sampleAndAreaPdf;
    vec4 emitterNormalAndTargetPdf;
    vec4 receiverPositionAndViewDepth;
    vec4 receiverNormalAndWeight;
    uvec4 metadata;
};

layout(std430, binding = 41, set = 0) readonly buffer ReSTIRDISpatialBuffer
{
    ReSTIRDIReservoir entries[];
} restirDISpatialBuffer;

layout(binding = 53, set = 0, rgba16f)
uniform readonly image2D nrdOutDiffRadianceHitDistImage;

// ★ 2026-09-29 16:xx：NRD 的**输入**（我们喂进去的原始 DI 信号）。
// 之前只有输出（53），所以"信号塌没塌"和"NRD 拒没拒史"分不开。
// 格式是 REBLUR 的 YCoCg(radiance)+normHitDist，取 .x 即亮度 Y。
layout(binding = 52, set = 0, rgba16f)
uniform readonly image2D nrdInDiffRadianceHitDistImage;

// ★ 2026-09-29 16:xx：NRD 的 IN_VIEWZ（我们写、NRD 读）。
// 用途：区分「NRD 跳过了这个像素」（写的是超范围哨兵 65504）与
// 「NRD 跑了但历史为 0」。此前用 receiverValid 做过同一件事但失败了
// （见交接文档 14:20），直接读 NRD 自己看到的那个数才是判据本身。
layout(binding = 50, set = 0, r32f)
uniform readonly image2D nrdInViewZImage;

// ★ 2026-09-29 16:xx：NRD 的 IN_NORMAL_ROUGHNESS（我们写、NRD 读）。
// 与 50/52 同属 updateNRDDescriptors 那一批 image，且值必然非零
// （法线编码后不可能三个通道全 0）——用作「这一批描述符有没有内容」的对照。
layout(binding = 51, set = 0, rgb10_a2)
uniform readonly image2D nrdInNormalRoughnessImage;

// 2026-09-28：NRD 自带的调试层（binding 56，RGBA8，渲染分辨率）。
//
// 由 NRD 自己的 Validation pass 写，前提是宿主打开了
// CommonSettings::enableValidation（见 VulkanCore.cpp 的 NRD_LOCAL_DI_VALIDATION）。
// 打开 NRD_COMPOSITE_DEBUG==5 即把它整张涂到屏幕上。
//
// 屏幕被切成 4x4 共 16 个视口（NRD README "VALIDATION LAYER"）：
//   视口 2  = 线性 viewZ（绿=正、蓝=负、红=超出 denoisingRange）
//   视口 3  = IN_MV 与「假设场景静止时的期望 MV」之差（洋红=疑似带抖动、
//             蓝=出屏、非 0=有运动物体）
//   视口 8  = 漫反累积帧数（棋盘红 = 历史被重置）
// 判读要点：视口 3 在**移动相机时**若整片非 0，说明我们写的 IN_MV 与 NRD 用
// 自己的矩阵算出的期望位置不一致 —— 这正是"移动时历史被拒"的直接定位。
layout(binding = 56, set = 0, rgba8)
uniform readonly image2D nrdValidationImage;

// 2026-09-28：DEBUG==6 要看 cameraUBO 的 historyValid 与我们自己写的 IN_MV，
// 所以这里声明 UBO（binding 2）和 MV 图（binding 55）。两者与 rt_restir_final.rgen
// 共用同一套描述符，只是那一边把 55 当 writeonly、这边当 readonly。
//
// std140 不能跳字段：要读到 historyValid 就必须把前面的 lane 全部具名。这里只列到
// historyValid 为止，后面的不再需要（规则同 rt_restir_final.rgen 顶部那段说明）。
layout(binding = 2, set = 0) uniform CameraProperties {
    #include "camera_ubo.glsl"
} camUboForMotionDebug;

layout(binding = 55, set = 0, rg16f)
uniform readonly image2D nrdMotionDebugImage;

// =====================================================
// binding 57：rgen 自算 MV 的**私有读回**图（2026-09-29 MV 探针）。
//
// 与 binding 55 的关键区别：55 是 NRD 的 IN_MV，而 NRD 会把它**自己跟踪出来的
// 运动**写回同一张图，所以读 55（或 validation 视口 3）量到的不是我们喂进去的
// MV。57 是 NRD 的 descriptor set 里根本没有的图，写进去什么就读出什么。
//
// 用途：转动视角时看这张图是「光滑正确的旋转流场」还是「零/翻转/乱」，
// 一步判定 MV 到底有没有算对。
// 编码见 rt_restir_final.rgen binding 57：RG = mv.xy（渲染像素）、B = mv.z、
// A = 取得方式（0=天空/无效、0.25=内层门失败、0.5=外闸失败、1=完整）。
// =====================================================
layout(binding = 57, set = 0, rgba16f)
uniform readonly image2D nrdMvProbeImage;

layout(push_constant) uniform NRDCompositePushConstants
{
    uint width;
    uint height;
} nrdCompositePush;

// The same guard the replaced pass applied to the combined colour.
const float LOCAL_DI_COMPOSITE_LUMINANCE_CLAMP = 6.0;

float luminance(vec3 value)
{
    return dot(max(value, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722));
}

vec3 unpackReceiverAlbedo(uint packed)
{
    return vec3(
        float((packed >> 8u) & 255u),
        float((packed >> 16u) & 255u),
        float((packed >> 24u) & 255u)
    ) * (1.0 / 255.0);
}

// 2026-09-27 晚：去噪器还原为 REBLUR_DIFFUSE，因此这里必须恢复 YCoCg 逆变换。
//
// REBLUR 的 IN/OUT 都是 YCoCg：前端做 _NRD_LinearToYCoCg（在
// rt_restir_final.rgen 里），后端必须做 _NRD_YCoCgToLinear 才能拿回线性
// radiance。RELAX 没有这一步（它的 .xyz 本来就是线性 radiance），当初切到
// RELAX 时把它删掉了；只翻去噪器枚举而不恢复这一步，颜色会全错。
// .w 在 REBLUR 里是归一化命中距离（AO），本链没有消费者。
vec3 nrdYCoCgToLinear(vec3 color)
{
    float t = color.x - color.z;

    vec3 r;
    r.y = color.x + color.z;
    r.x = t + color.y;
    r.z = t - color.y;

    return max(r, vec3(0.0));
}

// 定位用显示映射（只在 NRD_COMPOSITE_DEBUG==3 下被引用）：
//   真值 0        -> 纯黑（"这个乘数就是 0"）
//   NaN / Inf     -> 品红（"不是 0，是坏数"）
//   其余          -> ×gain 再开方，1e-3 量级的真值也看得见
// 分开这三种情况是这类断点的关键：黑和 NaN 在正常色调映射后长得一样，
// 但一个要往上游找"谁清成 0"，另一个要查打包约定。
vec3 debugPanelValue(vec3 value, float gain)
{
    if(any(isnan(value)) || any(isinf(value)))
    {
        return vec3(1.0, 0.0, 1.0);
    }

    return sqrt(clamp(value * gain, vec3(0.0), vec3(1.0)));
}

void main()
{
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);

    if(pixel.x >= int(nrdCompositePush.width) ||
       pixel.y >= int(nrdCompositePush.height))
    {
        return;
    }

    const ivec2 renderSize = ivec2(
        int(nrdCompositePush.width),
        int(nrdCompositePush.height)
    );

    const uint index = uint(pixel.y * renderSize.x + pixel.x);

    // REBLUR 的 OUT_DIFF_RADIANCE_HITDIST：.xyz = YCoCg，.w = 归一化命中距离
    // （AO，无消费者）。必须先做逆变换才能拿到线性 radiance。
    const vec4 packedRadiance = imageLoad(
        nrdOutDiffRadianceHitDistImage, pixel
    );

    // =====================================================
    // 2026-09-29 第三步：REBLUR / RELAX 解码切换。两者打包口径不同（NRD.hlsli:915+）：
    //   REBLUR：YCoCg 打包 → 这里做逆变换
    //   RELAX ：线性 radiance（RELAX_FrontEnd_PackRadianceAndHitDist = float4(radiance, hitDist)）
    // 必须与 rt_restir_final.rgen 的 LOCAL_DI_DENOISER_RELAX 与宿主的
    // NRD_LOCAL_DI_USE_RELAX **三者同步**，只改一处会用错误口径解读（画面偏色/发黑）。
    // =====================================================
    // ★★ 2026-09-29 第 3 项（方案 C）：RELAX_DIFFUSE 已回退，宏改回 0 = REBLUR。★★
    // 三处同步见 rt_restir_final.rgen 同名宏处的注释。
#ifndef LOCAL_DI_DENOISER_RELAX
#define LOCAL_DI_DENOISER_RELAX 0
#endif
#if LOCAL_DI_DENOISER_RELAX
    vec3 denoisedIrradiance = max(packedRadiance.xyz, vec3(0.0));
#else
    vec3 denoisedIrradiance = nrdYCoCgToLinear(packedRadiance.xyz);
#endif

    // =====================================================
    // 2026-09-26：本地光走 NRD 还是 raw 直通的 A/B 开关。
    //
    // 单帧 RIS（8 个按发光功率加权的候选，提案 PDF 是「全局 alias + 3D 光栅格」的
    // 精确混合）→ 在选中的那个采样点上
    // 补一根阴影射线 → contrib * vis * W，然后**交给 DLSS-RR 去收敛**。
    // 它既没有 ReSTIR（README 的 TODO 里还写着 "ReSTIR"），也没有 NRD
    // （同样是 TODO，而且注明是给非 NVIDIA 卡准备的）。
    //
    // 也就是说：这条信号是可以只靠后处理链收敛的，而我们现在有两层（NRD +
    // RR）都在动它，反而没法判断哪一层在出错。所以先把 NRD 从本地光这条链上
    // 摘下来做一次对照：
    //   NRD_LOCAL_DI_USE_RAW_TERM = true  → 直接用 RayGen 的原始项
    //   NRD_LOCAL_DI_USE_RAW_TERM = false → 用 NRD 的输出，接近 0 时用原始项兜底
    // NRD 这条路本身没有被删掉，改回 false 即可恢复；等本地光观感定位清楚再决定去留。
    // 2026-09-26 深夜：NRD 从 REBLUR_DIFFUSE 换成 RELAX_DIFFUSE（NVIDIA 官方
    // 为 RTXDI/直射光设计的家族），并按官方简化路径喂输入（MV=0 + 相机运动
    // 内部跟踪）。USE_RAW_TERM 切回 false —— RELAX 的输出才是被测对象；
    // FALLBACK_TO_RAW 保留，作为 RELAX 输出异常时的兜底对照。
    // =====================================================
    // 2026-09-27 定责实验：USE_RAW_TERM=true = raw 直通上屏（NRD 从 DI 链摘除）。
    // 判据：上屏亮 ⇒ 根因在 RELAX 输出侧；仍暗 ⇒ raw 本身低，问题在 final rgen
    // 估计量，与 NRD 无关。定案后改回 false 恢复被测对象 RELAX。
    // 2026-09-27 20:1x 定案：萤石旁标尺实测 raw DI = 0.16-0.32（橙/黄档，
    // 个别红档）——估计量健康不暗，RELAX 输入无问题；而四分屏探针实测 RELAX
    // 输出 ~0.06 => RELAX 把健康信号衰减了数倍，这就是"本地光不亮"的直接根因。
    //
    // 2026-09-27 晚：还原为"消费 NRD 输出"。
    //
    // 链条本身成立——Orion 的降噪器在**下游**：indirect.rgen.slang 第 16 行
    // 写明 "temporal convergence is the denoiser's job"，guides.slang 第 277 行
    // 写明引导图 "consumed by the denoiser/DLSS-RR"，README 也列了
    // "DLSS Ray Reconstruction support"。它的 RIS 之所以是单帧、不做 reservoir
    // 时域复用，正是因为 DLSS-RR 在最后做时域收敛。
    //
    // 而在本项目里 DLSS-RR 已被实测证明无法去噪这个 1spp 时间不相干的信号
    // （rrMode Performance/Quality/DLAA/Ultra-Performance 全试过，画面无变化）
    // ——那正是当初引入 NRD 的原因。所以 raw 直通 = 回到最初的噪点问题。
    //
    // 回滚：编译时加 -DRESTIR_DI_CONSUME_RELAX=0 即恢复 raw 直通。
#ifndef RESTIR_DI_CONSUME_RELAX
#define RESTIR_DI_CONSUME_RELAX 1
#endif
#if RESTIR_DI_CONSUME_RELAX
    const bool NRD_LOCAL_DI_USE_RAW_TERM = false;
    const bool NRD_LOCAL_DI_FALLBACK_TO_RAW = true;
#else
    const bool NRD_LOCAL_DI_USE_RAW_TERM = true;
    const bool NRD_LOCAL_DI_FALLBACK_TO_RAW = false;
#endif

    // RayGen 交下来的、未经去噪的本地光 DI 项（binding 41 的 xyz 在最终
    // ReSTIR RayGen 里被改写为「可见性过滤后的辐照度」，不再是采样点位置）。
    const vec3 rawLocalDI = max(
        restirDISpatialBuffer.entries[index].sampleAndAreaPdf.xyz,
        vec3(0.0)
    );

    const float rawLocalDILuminance = dot(
        rawLocalDI, vec3(0.2126, 0.7152, 0.0722)
    );

    if(NRD_LOCAL_DI_USE_RAW_TERM)
    {
        denoisedIrradiance = rawLocalDI;
    }
    else if(NRD_LOCAL_DI_FALLBACK_TO_RAW)
    {
        const float denoisedLuminance = dot(
            denoisedIrradiance, vec3(0.2126, 0.7152, 0.0722)
        );

        if(denoisedLuminance <= 1.0e-4 && rawLocalDILuminance > 1.0e-4)
        {
            denoisedIrradiance = rawLocalDI;
        }
    }

    const uint packedAlbedo =
        restirDISpatialBuffer.entries[index].metadata.w & 0xffffff00u;

    const vec3 localDIRadiance = denoisedIrradiance *
        unpackReceiverAlbedo(packedAlbedo);

    const vec4 baseColor = imageLoad(image, pixel);

    // =====================================================
    // 2026-09-27 亮度标尺探针：areaPdf 补丁后用户报告「完全没变化」。
    // 把 DI 估计量的**反照率前**亮度量化成 0.05 一档的色带，全屏输出，
    // 一次进游戏同时回答两件事：① 重载链路是否还活着（画面必然变样）；
    // ② raw DI 的真实量级落在哪一档。
    //
    // 读法（准星对准灯照亮的墙面）：
    //   深灰 <0.05 | 深蓝 0.05-0.10 | 蓝 0.10-0.15 | 青 0.15-0.20
    //   深绿 0.20-0.25 | 绿 0.25-0.30 | 黄 0.30-0.35 | 橙 0.35-0.40
    //   红 0.40-0.50 | 品红 0.50-0.75 | 白 >0.75 | 暗红 = 负/NaN
    //
    //   深灰/深蓝 => ×4 没生效，估计量数据流还有未发现环节
    //   青~绿     => ×4 已生效，「没变化」是曝光/观感层的问题
    //   全屏深灰  => DI 项根本没到 composite，查 reconstruct 加法路径
    // 定位后改回 false 即恢复 raw 直通对照。
    // =====================================================
    const bool DBG_LUMA_RULER = false;
    if(DBG_LUMA_RULER)
    {
        // v3：8x8 块均值——1spp 散斑是孤立单像素，截图压缩下不可靠；
        // 块均值 = 散斑密度 × 散斑值 = 收敛估计的期望，整块实色必可读。
        // 64 次 buffer load 只在探针版存在，生产版不编进这行。
        float rulerSum = 0.0;
        const ivec2 tileBase = pixel - (pixel & 7);
        for(int tileDy = 0; tileDy < 8; ++tileDy)
        {
            for(int tileDx = 0; tileDx < 8; ++tileDx)
            {
                const ivec2 tilePixel = tileBase + ivec2(tileDx, tileDy);
                if(tilePixel.x >= renderSize.x || tilePixel.y >= renderSize.y)
                {
                    continue;
                }
                const uint tileIndex = uint(tilePixel.y * renderSize.x +
                    tilePixel.x);
                const vec3 tileSample = max(
                    restirDISpatialBuffer.entries[tileIndex]
                        .sampleAndAreaPdf.xyz,
                    vec3(0.0)
                );
                rulerSum += dot(tileSample, vec3(0.2126, 0.7152, 0.0722));
            }
        }
        const float rulerLuma = rulerSum * (1.0 / 64.0);
        // 对数档（×2）：黑 <0.005 | 暗蓝 <0.01 | 蓝 <0.02 | 青 <0.04
        // 绿 <0.08 | 黄 <0.16 | 橙 <0.32 | 红 <0.64 | 白 ≥0.64 | 暗红 NaN/负
        vec3 rulerColor;
        if(rulerLuma != rulerLuma) rulerColor = vec3(0.25, 0.0, 0.0);
        else if(rulerLuma < 0.0)   rulerColor = vec3(0.25, 0.0, 0.0);
        else if(rulerLuma < 0.005) rulerColor = vec3(0.0);
        else if(rulerLuma < 0.01)  rulerColor = vec3(0.0, 0.0, 0.3);
        else if(rulerLuma < 0.02)  rulerColor = vec3(0.0, 0.0, 1.0);
        else if(rulerLuma < 0.04)  rulerColor = vec3(0.0, 1.0, 1.0);
        else if(rulerLuma < 0.08)  rulerColor = vec3(0.0, 1.0, 0.0);
        else if(rulerLuma < 0.16)  rulerColor = vec3(1.0, 1.0, 0.0);
        else if(rulerLuma < 0.32)  rulerColor = vec3(1.0, 0.5, 0.0);
        else if(rulerLuma < 0.64)  rulerColor = vec3(1.0, 0.0, 0.0);
        else                       rulerColor = vec3(1.0);
        imageStore(image, pixel, vec4(rulerColor, baseColor.a));
        return;
    }

// Ablation for the static white specks on glass (2026-09-25 20:1x):
//   0 = normal composite
//   1 = skip the additive term entirely (white specks gone => they live here)
//   2 = show ONLY the additive term (its spatial pattern = the speck pattern)
//   3 = 四分屏定位「本地光全灭」(2026-09-26)。
//
//       三分屏那一版已经读出：M>=16（样本在）、RayGen 交下来的本地光项非零，
//       而本 pass 实际加进画面的项**恒等于 0**。也就是说断点已经收窄到
//       「NRD 输出」与「接收面反照率解调」这两个乘数之一，所以这一版把它
//       拆成四个因数并排显示，一次重载定案：
//
//       左 1/4 = 本像素选中的光源样本数 M（binding 41 的 metadata.y）
//                黑 = 0；暗红/黄/绿/青/白 = 1 / 2-3 / 4-7 / 8-15 / 16+
//       2/4   = RayGen 交下来的**未去噪**本地光 DI 项（sampleAndAreaPdf.xyz）
//       3/4   = NRD(RELAX) 输出的线性辐照度（binding 53）
//               黑 = NRD 写出的是 0（或该 binding 读不到） -> 交接坏了
//               品红 = NaN/Inf -> YCoCg 解码与 NRD 实际打包不一致
//       右 1/4 = 接收面反照率（metadata.w 的 8..31 位）
//               黑 = 反照率位是 0 -> 解调这个乘数被清零
//
//       2/3/4 三格先 ×4（反照率 ×1）再开方，1e-3 量级也看得见；0 仍是纯黑。
#ifndef NRD_COMPOSITE_DEBUG
#define NRD_COMPOSITE_DEBUG 0
#endif

// DEBUG==8（MV 探针）的色标：**离散色阶**，不用线性亮度。
//
// 为什么改成色阶：2026-09-29 20:07 的第一版用线性亮度（t = mv/32），实机截图证明
// **色调映射把颜色改了**——shader 写的 G/R 比是 0.2，截图里读到 0.5，所以无法从
// 亮度反推 mv 的数值；而且线性映射在 |mv| ≥ 32 处整片饱和，把"偏大"和"大得离谱"
// 压成同一个颜色，等于没有量程。
//
// 色阶只用**饱和色相**，色调映射基本只改亮度/饱和度、不改色相，所以色相是可读的。
// 每格是前两倍，一次截图就能判定量级落在哪一档（左半屏 = mv.x，右半屏 = mv.y）：
//   黑    |v| <   4 px
