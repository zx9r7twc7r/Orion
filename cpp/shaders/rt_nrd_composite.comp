#version 460
#extension GL_GOOGLE_include_directive : require


layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 1, set = 0, rgba16f)
uniform image2D image;

struct ReSTIRDIReservoir
{
    vec4 sampleAndAreaPdf;
    vec4 emitterNormalAndTargetPdf;
    vec4 receiverPositionAndViewDepth;
    vec4 receiverNormalAndWeight;
    uvec4 metadata;
};

layout(std430, binding = 41, set = 0) readonly buffer ReSTIRDISpatialBuffer
{
    ReSTIRDIReservoir entries[];
} restirDISpatialBuffer;

layout(binding = 53, set = 0, rgba16f)
uniform readonly image2D nrdOutDiffRadianceHitDistImage;

layout(binding = 52, set = 0, rgba16f)
uniform readonly image2D nrdInDiffRadianceHitDistImage;

layout(binding = 50, set = 0, r32f)
uniform readonly image2D nrdInViewZImage;

layout(binding = 51, set = 0, rgb10_a2)
uniform readonly image2D nrdInNormalRoughnessImage;

layout(binding = 56, set = 0, rgba8)
uniform readonly image2D nrdValidationImage;

layout(binding = 2, set = 0) uniform CameraProperties {
    #include "camera_ubo.glsl"
} camUboForMotionDebug;

layout(binding = 55, set = 0, rg16f)
uniform readonly image2D nrdMotionDebugImage;

layout(binding = 57, set = 0, rgba16f)
uniform readonly image2D nrdMvProbeImage;

layout(push_constant) uniform NRDCompositePushConstants
{
    uint width;
    uint height;
} nrdCompositePush;

const float LOCAL_DI_COMPOSITE_LUMINANCE_CLAMP = 6.0;

float luminance(vec3 value)
{
    return dot(max(value, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722));
}

vec3 unpackReceiverAlbedo(uint packed)
{
    return vec3(
        float((packed >> 8u) & 255u),
        float((packed >> 16u) & 255u),
        float((packed >> 24u) & 255u)
    ) * (1.0 / 255.0);
}

// 2026-09-27 晚：去噪器还原为 REBLUR_DIFFUSE，因此这里必须恢复 YCoCg 逆变换。
//
// REBLUR 的 IN/OUT 都是 YCoCg：前端做 _NRD_LinearToYCoCg（在
// rt_restir_final.rgen 里），后端必须做 _NRD_YCoCgToLinear 才能拿回线性
// radiance。RELAX 没有这一步（它的 .xyz 本来就是线性 radiance），当初切到
// RELAX 时把它删掉了；只翻去噪器枚举而不恢复这一步，颜色会全错。
// .w 在 REBLUR 里是归一化命中距离（AO），本链没有消费者。
vec3 nrdYCoCgToLinear(vec3 color)
{
    float t = color.x - color.z;

    vec3 r;
    r.y = color.x + color.z;
    r.x = t + color.y;
    r.z = t - color.y;

    return max(r, vec3(0.0));
}

// 定位用显示映射（只在 NRD_COMPOSITE_DEBUG==3 下被引用）：
//   真值 0        -> 纯黑（"这个乘数就是 0"）
//   NaN / Inf     -> 品红（"不是 0，是坏数"）
//   其余          -> ×gain 再开方，1e-3 量级的真值也看得见
// 分开这三种情况是这类断点的关键：黑和 NaN 在正常色调映射后长得一样，
// 但一个要往上游找"谁清成 0"，另一个要查打包约定。
vec3 debugPanelValue(vec3 value, float gain)
{
    if(any(isnan(value)) || any(isinf(value)))
    {
        return vec3(1.0, 0.0, 1.0);
    }

    return sqrt(clamp(value * gain, vec3(0.0), vec3(1.0)));
}

void main()
{
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);

    if(pixel.x >= int(nrdCompositePush.width) ||
       pixel.y >= int(nrdCompositePush.height))
    {
        return;
    }

    const ivec2 renderSize = ivec2(
        int(nrdCompositePush.width),
        int(nrdCompositePush.height)
    );

    const uint index = uint(pixel.y * renderSize.x + pixel.x);

    const vec4 packedRadiance = imageLoad(
        nrdOutDiffRadianceHitDistImage, pixel
    );

#ifndef LOCAL_DI_DENOISER_RELAX
#define LOCAL_DI_DENOISER_RELAX 0
#endif
#if LOCAL_DI_DENOISER_RELAX
    vec3 denoisedIrradiance = max(packedRadiance.xyz, vec3(0.0));
#else
    vec3 denoisedIrradiance = nrdYCoCgToLinear(packedRadiance.xyz);
#endif

#ifndef RESTIR_DI_CONSUME_RELAX
#define RESTIR_DI_CONSUME_RELAX 1
#endif
#if RESTIR_DI_CONSUME_RELAX
    const bool NRD_LOCAL_DI_USE_RAW_TERM = false;
    const bool NRD_LOCAL_DI_FALLBACK_TO_RAW = true;
#else
    const bool NRD_LOCAL_DI_USE_RAW_TERM = true;
    const bool NRD_LOCAL_DI_FALLBACK_TO_RAW = false;
#endif

    const vec3 rawLocalDI = max(
        restirDISpatialBuffer.entries[index].sampleAndAreaPdf.xyz,
        vec3(0.0)
    );

    const float rawLocalDILuminance = dot(
        rawLocalDI, vec3(0.2126, 0.7152, 0.0722)
    );

    if(NRD_LOCAL_DI_USE_RAW_TERM)
    {
        denoisedIrradiance = rawLocalDI;
    }
    else if(NRD_LOCAL_DI_FALLBACK_TO_RAW)
    {
        const float denoisedLuminance = dot(
            denoisedIrradiance, vec3(0.2126, 0.7152, 0.0722)
        );

        if(denoisedLuminance <= 1.0e-4 && rawLocalDILuminance > 1.0e-4)
        {
            denoisedIrradiance = rawLocalDI;
        }
    }

    const uint packedAlbedo =
        restirDISpatialBuffer.entries[index].metadata.w & 0xffffff00u;

    const vec3 localDIRadiance = denoisedIrradiance *
        unpackReceiverAlbedo(packedAlbedo);

    const vec4 baseColor = imageLoad(image, pixel);

    const bool DBG_LUMA_RULER = false;
    if(DBG_LUMA_RULER)
    {
        float rulerSum = 0.0;
        const ivec2 tileBase = pixel - (pixel & 7);
        for(int tileDy = 0; tileDy < 8; ++tileDy)
        {
            for(int tileDx = 0; tileDx < 8; ++tileDx)
            {
                const ivec2 tilePixel = tileBase + ivec2(tileDx, tileDy);
                if(tilePixel.x >= renderSize.x || tilePixel.y >= renderSize.y)
                {
                    continue;
                }
                const uint tileIndex = uint(tilePixel.y * renderSize.x +
                    tilePixel.x);
                const vec3 tileSample = max(
                    restirDISpatialBuffer.entries[tileIndex]
                        .sampleAndAreaPdf.xyz,
                    vec3(0.0)
                );
                rulerSum += dot(tileSample, vec3(0.2126, 0.7152, 0.0722));
            }
        }
        const float rulerLuma = rulerSum * (1.0 / 64.0);
        vec3 rulerColor;
        if(rulerLuma != rulerLuma) rulerColor = vec3(0.25, 0.0, 0.0);
        else if(rulerLuma < 0.0)   rulerColor = vec3(0.25, 0.0, 0.0);
        else if(rulerLuma < 0.005) rulerColor = vec3(0.0);
        else if(rulerLuma < 0.01)  rulerColor = vec3(0.0, 0.0, 0.3);
        else if(rulerLuma < 0.02)  rulerColor = vec3(0.0, 0.0, 1.0);
        else if(rulerLuma < 0.04)  rulerColor = vec3(0.0, 1.0, 1.0);
        else if(rulerLuma < 0.08)  rulerColor = vec3(0.0, 1.0, 0.0);
        else if(rulerLuma < 0.16)  rulerColor = vec3(1.0, 1.0, 0.0);
        else if(rulerLuma < 0.32)  rulerColor = vec3(1.0, 0.5, 0.0);
        else if(rulerLuma < 0.64)  rulerColor = vec3(1.0, 0.0, 0.0);
        else                       rulerColor = vec3(1.0);
        imageStore(image, pixel, vec4(rulerColor, baseColor.a));
        return;
    }

#ifndef NRD_COMPOSITE_DEBUG
#define NRD_COMPOSITE_DEBUG 0
#endif


#if NRD_COMPOSITE_DEBUG == 1
    imageStore(image, pixel, baseColor);
#elif NRD_COMPOSITE_DEBUG == 2
    imageStore(image, pixel, vec4(localDIRadiance, baseColor.a));
#elif NRD_COMPOSITE_DEBUG == 4
    {
        const ReSTIRDIReservoir dbgHistoryReservoir =
            restirDISpatialBuffer.entries[index];

        const bool dbgReceiverValid =
            dbgHistoryReservoir.receiverPositionAndViewDepth.w > 0.0 &&
            dot(dbgHistoryReservoir.receiverNormalAndWeight.xyz,
                dbgHistoryReservoir.receiverNormalAndWeight.xyz) > 0.5;

        const float historyFrames = packedRadiance.w;

        vec3 historyColor;

        if(!dbgReceiverValid)
        {
            historyColor = vec3(1.0, 0.0, 1.0);
        }
        else if(historyFrames < 0.5)
        {
            historyColor = vec3(0.0);
        }
        else if(historyFrames < 2.5)
        {
            historyColor = vec3(0.85, 0.0, 0.0);
        }
        else if(historyFrames < 6.5)
        {
            historyColor = vec3(0.9, 0.5, 0.0);
        }
        else if(historyFrames < 15.5)
        {
            historyColor = vec3(0.0, 0.85, 0.0);
        }
        else if(historyFrames < 31.5)
        {
            historyColor = vec3(0.0, 0.85, 0.85);
        }
        else
        {
            historyColor = vec3(1.0);
        }

        imageStore(image, pixel, vec4(historyColor, baseColor.a));
    }
#elif NRD_COMPOSITE_DEBUG == 5
    imageStore(image, pixel, vec4(imageLoad(nrdValidationImage, pixel).rgb, baseColor.a));
#elif NRD_COMPOSITE_DEBUG == 7
#ifndef NRD_COMPOSITE_DEBUG_VP_LEFT
#define NRD_COMPOSITE_DEBUG_VP_LEFT 8
#endif
#ifndef NRD_COMPOSITE_DEBUG_VP_RIGHT
#define NRD_COMPOSITE_DEBUG_VP_RIGHT 3
#endif
    {
        const int screenW = max(1, int(renderSize.x));
        const int screenH = max(1, int(renderSize.y));
        const int halfW = max(1, screenW / 2);
        const int vpW = max(1, screenW / 4);
        const int vpH = max(1, screenH / 4);

        const bool rightHalf = int(pixel.x) >= halfW;
        const int vp = rightHalf
            ? NRD_COMPOSITE_DEBUG_VP_RIGHT
            : NRD_COMPOSITE_DEBUG_VP_LEFT;

        const ivec2 vpOrigin = ivec2((vp % 4) * vpW, (vp / 4) * vpH);

        const ivec2 local = ivec2(
            (int(pixel.x) - (rightHalf ? halfW : 0)) * vpW / halfW,
            int(pixel.y) * vpH / screenH
        );

        const ivec2 src = vpOrigin +
            clamp(local, ivec2(0), ivec2(vpW - 1, vpH - 1));

        imageStore(
            image,
            pixel,
            vec4(imageLoad(nrdValidationImage, src).rgb, baseColor.a)
        );
    }
#elif NRD_COMPOSITE_DEBUG == 6
    {
        const vec2 mvValue = imageLoad(nrdMotionDebugImage, pixel).xy;

        if(camUboForMotionDebug.historyValid == 0u)
        {
            imageStore(image, pixel, vec4(0.0, 0.0, 1.0, baseColor.a));
        }
        else if(any(isnan(mvValue)) || any(isinf(mvValue)))
        {
            imageStore(image, pixel, vec4(1.0, 0.0, 1.0, baseColor.a));
        }
        else
        {
            const bool rgenSide = pixel.x < (renderSize.x / 2);

            if(rgenSide)
            {
                if(any(isnan(mvValue)) || any(isinf(mvValue)))
                {
                    imageStore(image, pixel, vec4(1.0, 0.0, 1.0, baseColor.a));
                }
                else
                {
                    imageStore(
                        image,
                        pixel,
                        vec4(
                            clamp(abs(mvValue.x), 0.0, 1.0),
                            clamp(abs(mvValue.y), 0.0, 1.0),
                            0.25,
                            baseColor.a
                        )
                    );
                }
            }
            else
            {
                const mat3 curRotInv = mat3(camUboForMotionDebug.viewInverse);
                const mat3 prevRotInv =
                    mat3(camUboForMotionDebug.prevViewInverse);
                const mat3 relRot = transpose(curRotInv) * prevRotInv;
                const float cosHalf2 =
                    clamp((relRot[0][0] + relRot[1][1] + relRot[2][2] - 1.0)
                              * 0.5,
                          -1.0, 1.0);
                const float relAngleDeg = degrees(acos(cosHalf2));

                const vec3 curPos =
                    (camUboForMotionDebug.viewInverse * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
                const vec3 prevPos =
                    (camUboForMotionDebug.prevViewInverse * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
                const float posDelta = length(curPos - prevPos);

                imageStore(
                    image,
                    pixel,
                    vec4(
                        clamp(relAngleDeg / 30.0, 0.0, 1.0),
                        clamp(posDelta / 0.5, 0.0, 1.0),
                        0.25,
                        baseColor.a
                    )
                );
            }
        }
    }
#elif NRD_COMPOSITE_DEBUG == 8
    {
        const vec4 mvProbe = imageLoad(nrdMvProbeImage, pixel);
        const float probeState = mvProbe.w;

        vec3 probeColor;

        if(probeState < 0.1)
        {
            probeColor = vec3(1.0, 1.0, 1.0);
        }
        else if(probeState < 0.375)
        {
            probeColor = vec3(1.0, 0.0, 1.0);
        }
        else if(probeState < 0.75)
        {
            probeColor = vec3(0.0, 1.0, 1.0);
        }
        else
        {
            const float component =
                (pixel.x < renderSize.x / 2) ? mvProbe.x : mvProbe.y;
            const float magnitude = abs(component);

            if(magnitude < 4.0)
            {
                probeColor = vec3(0.0, 0.0, 0.0);
            }
            else if(magnitude < 16.0)
            {
                probeColor = vec3(0.0, 0.0, 1.0);
            }
            else if(magnitude < 64.0)
            {
                probeColor = vec3(0.0, 1.0, 0.0);
            }
            else if(magnitude < 256.0)
            {
                probeColor = vec3(1.0, 1.0, 0.0);
            }
            else
            {
                probeColor = vec3(1.0, 0.0, 0.0);
            }
        }

        imageStore(image, pixel, vec4(probeColor, baseColor.a));
    }
#elif NRD_COMPOSITE_DEBUG == 9
    {
        const int screenW = max(1, int(renderSize.x));
        const int screenH = max(1, int(renderSize.y));
        const int halfW = max(1, screenW / 2);
        const int vpW = max(1, screenW / 4);
        const int vpH = max(1, screenH / 4);

        const bool rightHalf = int(pixel.x) >= halfW;

        if(rightHalf)
        {
            const int vp = 8;
            const ivec2 vpOrigin = ivec2((vp % 4) * vpW, (vp / 4) * vpH);
            const ivec2 local = ivec2(
                (int(pixel.x) - halfW) * vpW / halfW,
                int(pixel.y) * vpH / screenH
            );
            const ivec2 src = vpOrigin +
                clamp(local, ivec2(0), ivec2(vpW - 1, vpH - 1));

            imageStore(
                image,
                pixel,
                vec4(imageLoad(nrdValidationImage, src).rgb, baseColor.a)
            );
        }
        else
        {
            const float diagW = packedRadiance.w;

            vec3 diagColor;

            if(!(diagW >= 0.0) || diagW > 1.0)
            {
                diagColor = vec3(1.0, 0.0, 1.0);
            }
            else if(diagW < 0.105)
            {
                diagColor = vec3(0.9, 0.0, 0.0);
            }
            else if(diagW < 0.2)
            {
                diagColor = vec3(0.9, 0.5, 0.0);
            }
            else if(diagW < 0.5)
            {
                diagColor = vec3(0.9, 0.9, 0.0);
            }
            else if(diagW < 0.95)
            {
                diagColor = vec3(0.0, 0.85, 0.0);
            }
            else
            {
                diagColor = vec3(1.0);
            }

            imageStore(image, pixel, vec4(diagColor, baseColor.a));
        }
    }
#elif NRD_COMPOSITE_DEBUG == 3
    const ReSTIRDIReservoir debugReservoir =
        restirDISpatialBuffer.entries[index];

    const uint debugSampleCount = debugReservoir.metadata.y;

    vec3 debugSampleColor;

    if(debugSampleCount == 0u)
    {
        debugSampleColor = vec3(0.0);
    }
    else if(debugSampleCount == 1u)
    {
        debugSampleColor = vec3(0.45, 0.0, 0.0);
    }
    else if(debugSampleCount <= 3u)
    {
        debugSampleColor = vec3(0.85, 0.85, 0.0);
    }
    else if(debugSampleCount <= 7u)
    {
        debugSampleColor = vec3(0.0, 0.85, 0.0);
    }
    else if(debugSampleCount <= 15u)
    {
        debugSampleColor = vec3(0.0, 0.85, 0.85);
    }
    else
    {
        debugSampleColor = vec3(1.0);
    }

    const vec3 debugRawTerm = debugPanelValue(
        debugReservoir.sampleAndAreaPdf.xyz,
        4.0
    );

    const vec3 debugDenoisedRadiance = debugPanelValue(
        denoisedIrradiance,
        4.0
    );

    const vec3 debugReceiverAlbedo = debugPanelValue(
        unpackReceiverAlbedo(packedAlbedo),
        1.0
    );

    const int debugPanel = min(
        int(float(pixel.x) * 4.0 / float(renderSize.x)),
        3
    );

    vec3 debugWrite;

    if(debugPanel == 0)
    {
        debugWrite = debugSampleColor;
    }
    else if(debugPanel == 1)
    {
        debugWrite = debugRawTerm;
    }
    else if(debugPanel == 2)
    {
        debugWrite = debugDenoisedRadiance;
    }
    else
    {
        debugWrite = debugReceiverAlbedo;
    }

    imageStore(
        image,
        pixel,
        vec4(debugWrite, baseColor.a)
    );
#else
#ifndef NRD_COMPOSITE_HISTORY_STRIP
#define NRD_COMPOSITE_HISTORY_STRIP 1
#endif
#if NRD_COMPOSITE_HISTORY_STRIP
    if(pixel.y < 8)
    {
        const int stripStep = max(1, renderSize.y / 128);
        const float NRD_SKIP_VIEWZ = 60000.0;
        float historyAcc = 0.0;
        float historyTaps = 0.0;
        float inLumaAcc = 0.0;
        float inUnlit = 0.0;
        float normalAcc = 0.0;
        float viewZZero = 0.0;
        float viewZReal = 0.0;
        float taps = 0.0;

        for(int stripY = 8; stripY < renderSize.y; stripY += stripStep)
        {
            const ivec2 stripTap = ivec2(pixel.x, stripY);

            const float inLuma = imageLoad(
                nrdInDiffRadianceHitDistImage,
                stripTap
            ).x;

            const float inViewZ = imageLoad(nrdInViewZImage, stripTap).r;
            const vec3 inNormalPacked = imageLoad(
                nrdInNormalRoughnessImage,
                stripTap
            ).rgb;

            inLumaAcc += inLuma;
            inUnlit += inLuma > 1.0e-4 ? 0.0 : 1.0;
            normalAcc += dot(inNormalPacked, vec3(0.3333333));
            viewZZero += abs(inViewZ) > 1.0e-6 ? 0.0 : 1.0;
            viewZReal += abs(inViewZ) > 1.0e-6 ? 1.0 : 0.0;
            taps += 1.0;

            if(abs(inViewZ) < NRD_SKIP_VIEWZ)
            {
                historyAcc += imageLoad(
                    nrdOutDiffRadianceHitDistImage,
                    stripTap
                ).w;
                historyTaps += 1.0;
            }
        }

        const float safeTaps = max(taps, 1.0);
        const float inAvg = inLumaAcc / safeTaps;
        const float normalAvg = normalAcc / safeTaps;

        if(pixel.y < 4)
        {
            if(viewZZero / safeTaps > 0.5)
            {
                imageStore(image, pixel, vec4(0.0, 0.85, 1.0, baseColor.a));
            }
            else if(historyTaps < 1.0)
            {
                imageStore(image, pixel, vec4(0.15, 0.15, 0.15, baseColor.a));
            }
            else
            {
                const float stripHistory = historyAcc / historyTaps;
                vec3 stripColor;

                if(stripHistory < 0.5)
                {
                    stripColor = vec3(0.0);
                }
                else if(stripHistory < 2.5)
                {
                    stripColor = vec3(0.85, 0.0, 0.0);
                }
                else if(stripHistory < 6.5)
                {
                    stripColor = vec3(0.9, 0.5, 0.0);
                }
                else if(stripHistory < 15.5)
                {
                    stripColor = vec3(0.0, 0.85, 0.0);
                }
                else if(stripHistory < 31.5)
                {
                    stripColor = vec3(0.0, 0.85, 0.85);
                }
                else
                {
                    stripColor = vec3(1.0);
                }

                imageStore(image, pixel, vec4(stripColor, baseColor.a));
            }
        }
        else
        {
            const vec3 signalColor = vec3(
                inUnlit / safeTaps,
                min(normalAvg * 2.0, 1.0),
                viewZZero / safeTaps
            );

            imageStore(image, pixel, vec4(signalColor, baseColor.a));
        }

        return;
    }
#endif

    vec3 combinedColor = baseColor.rgb + localDIRadiance;

    const float combinedLuminance = luminance(combinedColor);

    if(combinedLuminance > LOCAL_DI_COMPOSITE_LUMINANCE_CLAMP)
    {
        combinedColor *=
            LOCAL_DI_COMPOSITE_LUMINANCE_CLAMP / combinedLuminance;
    }

    imageStore(image, pixel, vec4(combinedColor, baseColor.a));
#endif
}
