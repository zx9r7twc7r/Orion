#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require


layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform CameraProperties
{
    #include "camera_ubo.glsl"
} cam;

#include "local_light_grid_common.glsl"
#include "vol_restir_common.glsl"

layout(rgba32ui, set = 0, binding = 1) uniform uimage3D volReservoirInOut;
layout(set = 0, binding = 2) uniform accelerationStructureEXT sceneTlas;

layout(push_constant) uniform VolRestirVisibilityPush
{
    ivec4 froxelSize;
    vec4 volumeParams;
} pc;

void main()
{
    ivec3 restirCoord = ivec3(gl_GlobalInvocationID);
    ivec3 restirSize = ivec3(imageSize(volReservoirInOut));

    if(any(greaterThanEqual(restirCoord, restirSize)))
    {
        return;
    }

    VolReservoir reservoir = volRestirUnpack(imageLoad(volReservoirInOut, restirCoord));

    if(reservoir.sampleCount == 0u || reservoir.lightIndex == 0u)
    {
        return;
    }

    uint tableIndex = reservoir.lightIndex - 1u;
    if(tableIndex >= fogLightBuffer.header.x)
    {
        imageStore(volReservoirInOut, restirCoord, uvec4(0u));
        return;
    }

    LocalLightGPU light = fogLightBuffer.lights[tableIndex];

    int restirDownscale = max(pc.froxelSize.w, 1);
    vec3 froxelCenter = volRestirFroxelCenter(
        restirCoord, restirSize, vec2(pc.froxelSize.xy), restirDownscale,
        pc.volumeParams.x, pc.volumeParams.y);

    vec3 toLight = light.worldPosEmission.xyz - froxelCenter;
    float distanceToLight = length(toLight);

    if(distanceToLight <= 1.0e-3)
    {
        return;
    }

    vec3 rayDirection = toLight / distanceToLight;

    const float originBias = 0.05;
    float tMin = originBias;
    float tMax = distanceToLight - originBias;

    if(tMax <= tMin)
    {
        return;
    }

    rayQueryEXT rayQuery;
    rayQueryInitializeEXT(rayQuery, sceneTlas,
        gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT,
        0xFFu,
        froxelCenter + rayDirection * originBias, tMin,
        rayDirection, tMax);

    while(rayQueryProceedEXT(rayQuery))
    {
    }

    if(rayQueryGetIntersectionTypeEXT(rayQuery, true) !=
        gl_RayQueryCommittedIntersectionNoneEXT)
    {
        imageStore(volReservoirInOut, restirCoord, uvec4(0u, 0u, 0u, 0u));
    }
}
