#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rg32f) uniform image2DArray waterFftState;
layout(set = 0, binding = 1, rgba16f) uniform image2D waterFftSlope;

#include "water_fft_common.glsl"

// 读取双缓冲状态（越界索引按周期环绕 ⇒ 平铺无缝）
vec2 waterFftLoadState(uvec2 index, int layer)
{
    uvec2 wrapped = index & uvec2(WATER_FFT_N - 1u);
    return imageLoad(
        waterFftState,
        ivec3(int(wrapped.x), int(wrapped.y), layer)
    ).rg;
}

// ---------------------------------------------------------------------------
// mode 0：谱生成（h̃(k,t)），按 X 位反转写入
// ---------------------------------------------------------------------------
void waterFftSpectrumPass(uvec2 store)
{
    uvec2 trueIndex = uvec2(waterFftBitReverse(store.x), store.y);
    vec2 gridIndex = waterFftGridIndex(trueIndex);

    vec2 spectrum = waterFftEvolvedSpectrum(gridIndex);
    imageStore(
        waterFftState,
        ivec3(int(store.x), int(store.y), fftPush.destinationLayer),
        vec4(spectrum, 0.0, 1.0)
    );
}

// ---------------------------------------------------------------------------
// mode 1：radix-2 蝶形（就地算法，输入已按本轴位反转）
//   u = 组内下半，v = 组内上半 × 旋转因子，输出 u±v
//   逆变换（时域合成）用 +i 旋转因子：w = exp(+2πi·j/len)
// ---------------------------------------------------------------------------
void waterFftButterflyPass(uvec2 index)
{
    uint axisIndex = (fftPush.axis == 0) ? index.x : index.y;
    uint halfLength = uint(fftPush.stageLength) >> 1u;
    if(halfLength == 0u)
    {
        return;
    }

    uint within = axisIndex % uint(fftPush.stageLength);
    uint partnerIndex = axisIndex ^ halfLength;
    bool lower = within < halfLength;

    uvec2 partner = (fftPush.axis == 0)
        ? uvec2(partnerIndex, index.y)
        : uvec2(index.x, partnerIndex);

    vec2 mine = waterFftLoadState(index, fftPush.sourceLayer);
    vec2 other = waterFftLoadState(partner, fftPush.sourceLayer);

    vec2 lowerValue = lower ? mine : other;
    vec2 upperValue = lower ? other : mine;

    float twiddleIndex = float(within % halfLength);
    float twiddleAngle = 2.0 * WATER_FFT_PI * twiddleIndex / float(fftPush.stageLength);
    vec2 twiddle = vec2(cos(twiddleAngle), sin(twiddleAngle));

    vec2 rotated = waterFftComplexMul(upperValue, twiddle);
    vec2 result = lower ? (lowerValue + rotated) : (lowerValue - rotated);

    imageStore(
        waterFftState,
        ivec3(int(index.x), int(index.y), fftPush.destinationLayer),
        vec4(result, 0.0, 1.0)
    );
}

// ---------------------------------------------------------------------------
// mode 2：Y 位反转（行蝶形已把 X 变换完，列蝶形需要 Y 位反转输入）
// ---------------------------------------------------------------------------
void waterFftBitReverseYPass(uvec2 index)
{
    vec2 value = waterFftLoadState(
        uvec2(index.x, waterFftBitReverse(index.y)), fftPush.sourceLayer);
    imageStore(
        waterFftState,
        ivec3(int(index.x), int(index.y), fftPush.destinationLayer),
        vec4(value, 0.0, 1.0)
    );
}

// ---------------------------------------------------------------------------
// mode 3：finalize —— 基础层 + 细节层高度场 → 一张光学斜率图
// · 谱振幅（visualScale）在这里一次性折算
//   · 中心差分求 ∂h/∂x、∂h/∂z（纹素间距 = texelWorldSize）
//   · choppiness：对斜率做非线性陡化（|g| 越大越陡）⇒ 波峰尖、波谷平（参考
//     Gerstner/Tessendorf 的 choppy 观感，但省掉真实位移重采样 ⇒ 每纹素只 8 次
//     imageLoad，成本可忽略）
//   · 2026-10-19 波面细分：.rg = 基础层斜率（128 格域），.ba = 细节层斜率
//     （32 格域、亚格级小波）。两层共用一次 finalize，着色端按各自的世界 UV
//     采样同一张图 —— 细节层的小波只活在法线里，不移动水面几何。
//     （原 .b 的高度通道未使用，此处让位给细节斜率。）
// ---------------------------------------------------------------------------
vec2 waterFftSlopeFromField(uvec2 index, int layer, float texelWorldSize, float normalization)
{
    float heightLeft = waterFftLoadState(index - uvec2(1u, 0u), layer).x;
    float heightRight = waterFftLoadState(index + uvec2(1u, 0u), layer).x;
    float heightDown = waterFftLoadState(index - uvec2(0u, 1u), layer).x;
    float heightUp = waterFftLoadState(index + uvec2(0u, 1u), layer).x;

    float texel = max(texelWorldSize, 1.0e-4);
    vec2 slope = vec2(heightRight - heightLeft, heightUp - heightDown) *
        (0.5 * normalization / texel);

    if(fftPush.choppiness > 0.0)
    {
        slope *= 1.0 + fftPush.choppiness * length(slope);
    }
    return slope;
}

void waterFftFinalizePass(uvec2 index)
{
    vec2 slope = waterFftSlopeFromField(
        index, fftPush.sourceLayer, fftPush.texelWorldSize, fftPush.visualScale);

    vec2 detailSlope = vec2(0.0);
    if(fftPush.detailVisualScale > 0.0)
    {
        detailSlope = waterFftSlopeFromField(
            index,
            fftPush.detailSourceLayer,
            fftPush.detailTexelWorldSize,
            fftPush.detailVisualScale
        );
    }

    imageStore(
        waterFftSlope,
        ivec2(int(index.x), int(index.y)),
        vec4(slope, detailSlope)
    );
}

void main()
{
    uvec2 index = gl_GlobalInvocationID.xy;
    if(index.x >= WATER_FFT_N || index.y >= WATER_FFT_N)
    {
        return;
    }

    if(fftPush.mode == WATER_FFT_MODE_SPECTRUM)
    {
        waterFftSpectrumPass(index);
    }
    else if(fftPush.mode == WATER_FFT_MODE_BUTTERFLY)
    {
        waterFftButterflyPass(index);
    }
    else if(fftPush.mode == WATER_FFT_MODE_BITREVERSE_Y)
    {
        waterFftBitReverseYPass(index);
    }
    else
    {
        waterFftFinalizePass(index);
    }
}
