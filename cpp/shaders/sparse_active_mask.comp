#version 460
#extension GL_EXT_scalar_block_layout : require
#extension GL_GOOGLE_include_directive : require


layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, r8ui)
uniform uimage2D sparseActiveMaskOut;

layout(binding = 1, std430) readonly buffer BlueNoiseTable
{
    uint words[64u * 128u * 128u / 4u];
} blueNoise;

layout(push_constant) uniform SparseMaskPush
{
    uint width;
    uint height;
    uint frameIndex;
    uint maskWidth;
    float samplingRate;
    uint pad0;
    uint pad1;
    uint pad2;
} pc;
// 与 rt_test.rgen 的 vptSparseBlueNoiseThreshold 逐行相同。
float sparseBlueNoiseThreshold(uvec2 pixelCoord, uint frameIdx)
{
    const uint x = pixelCoord.x & 127u;
    const uint y = pixelCoord.y & 127u;
    const uint layer = frameIdx & 63u;
    const uint byteIndex = 16384u * layer + 128u * y + x;
    const uint word = blueNoise.words[byteIndex >> 2u];
    const uint raw = (word >> ((byteIndex & 3u) * 8u)) & 0xFFu;
    return float(raw) * (1.0 / 255.0);
}

void main()
{
    const uvec2 blockCoordinate = gl_GlobalInvocationID.xy;

    if(blockCoordinate.x >= pc.maskWidth)
    {
        return;
    }

    uint maskValue = 0u;

    for(uint localY = 0u; localY < 2u; ++localY)
    {
        for(uint localX = 0u; localX < 4u; ++localX)
        {
            const uvec2 pixelCoordinate =
                blockCoordinate * uvec2(4u, 2u) + uvec2(localX, localY);

            bool isPixelActive = false;

            if(pixelCoordinate.x < pc.width &&
               pixelCoordinate.y < pc.height)
            {
                isPixelActive =
                    sparseBlueNoiseThreshold(
                        pixelCoordinate,
                        pc.frameIndex) <= pc.samplingRate;
            }

            const uint bitIndex = localY * 4u + localX;

            if(isPixelActive)
            {
                maskValue |= (1u << bitIndex);
            }
        }
    }

    imageStore(
        sparseActiveMaskOut,
        ivec2(blockCoordinate),
        uvec4(maskValue, 0u, 0u, 0u));
}
