#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require


layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform CameraProperties
{
    #include "camera_ubo.glsl"
} cam;

layout(set = 0, binding = 1) uniform accelerationStructureEXT sceneTlas;

layout(set = 0, binding = 2, r32f) uniform image2D terrainHeightImage;

#define TERRAIN_HEIGHT_PRODUCER 1
#include "terrain_height.glsl"


void main()
{
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if(texel.x >= TERRAIN_HEIGHT_RESOLUTION || texel.y >= TERRAIN_HEIGHT_RESOLUTION)
    {
        return;
    }

    vec2 uv = (vec2(texel) + 0.5) / float(TERRAIN_HEIGHT_RESOLUTION);
    vec2 worldXZ = terrainHeightCenterXZ() +
        (uv * 2.0 - 1.0) * TERRAIN_HEIGHT_EXTENT_XY;

    float originY;
    float maxDistance;
    terrainHeightProbeRange(originY, maxDistance);

    const vec3 down = vec3(0.0, -1.0, 0.0);
    vec3 origin = vec3(worldXZ.x, originY, worldXZ.y);
    float hitDistance = terrainHeightTrace(origin, down, maxDistance);

    float groundY = hitDistance < maxDistance - 0.5
        ? origin.y - hitDistance
        : TERRAIN_HEIGHT_EMPTY;

    imageStore(terrainHeightImage, texel, vec4(groundY, 0.0, 0.0, 0.0));
}
