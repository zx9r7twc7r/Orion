#version 460
// =====================================================
// 本地光 DI 项：矩与方差图
//
// 移植自 
//   src/shader/world/svgf/direct_moments.comp
// 与原文逐行对应，两处差异在下面注明。
//
// 为什么需要它： direct_atrous_step*.comp 里
//     phiL = max(phiColor * sqrt(variance), 1.0)
// 即空间滤波的亮度边缘停止强度由**方差图**驱动，且方差图在 5 级之间传递。
// 我此前是在 à-trous 内部 3x3 现算，方差没有时域累积，phiL 逐帧抖动。
//
// 三个步骤（原文顺序）：
//   1) 3x3 亮度矩 m1 = mean(L), m2 = mean(L^2)（在**时域累积后**的图像上）
//   2) 矩的时域累积：h = 历史长度；h > 1.1 时 alpha = clamp(1/h, 0.02, 0.2)，
//      m = mix(prev, m, alpha)
//   3) varRaw = max(m2 - m1*m1, 0)；邻域方差用上一帧的矩 3x3 平均，
//      与 varRaw 各占 0.5（原文注释：The key to stop boiling）
//      存储下限 max(variance, 0.0001)
//
// ==== 与原文的差异 ====
// 1) 矩图用 rgba16f：纯为了避免多一种存储图像格式，
//    算术与语义不变。
// 2) 历史长度取的是**DI 自己的** history length（rt_di_reproject.comp 写出）。
// 这一处绑的是 giHistoryLength（GI 的历史长度），那是它内部两套累积
//    共享一个缓冲的写法；本项目没有 GI 历史长度，用 DI 自己的才是对应语义。
// =====================================================

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// 0：时域累积后的线性项（rt_di_reproject.comp 的 diLinearTermOut）
layout(binding = 0, rgba16f) uniform readonly image2D diLinearTermImage;
// 1：上一帧的矩 (m1, m2)
layout(binding = 1, rgba16f) uniform readonly image2D diMomentsPrev;
// 2：本帧的矩
layout(binding = 2, rgba16f) uniform writeonly image2D diMomentsOut;
// 3：本帧的方差（交给 à-trous 第一级）
layout(binding = 3, r16f) uniform writeonly image2D diVarianceOut;
// 4：历史长度（DI，r16ui）
layout(binding = 4, r16ui) uniform readonly uimage2D diHistoryLengthPrev;

layout(push_constant) uniform DiMomentsPushConstants
{
    uint width;
    uint height;
} momentsPush;

float luminance(vec3 c)
{
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(diLinearTermImage);

    if(pixel.x >= size.x || pixel.y >= size.y)
    {
        return;
    }

    // 1) 3x3 空间矩
    float sumL = 0.0;
    float sumL2 = 0.0;
    float count = 0.0;

    for(int dy = -1; dy <= 1; ++dy)
    {
        for(int dx = -1; dx <= 1; ++dx)
        {
            ivec2 q = pixel + ivec2(dx, dy);
            if(q.x < 0 || q.y < 0 || q.x >= size.x || q.y >= size.y)
            {
                continue;
            }

            float L = luminance(imageLoad(diLinearTermImage, q).rgb);
            sumL += L;
            sumL2 += L * L;
            count += 1.0;
        }
    }

    float m1 = sumL / max(count, 1.0);
    float m2 = sumL2 / max(count, 1.0);

 // 2) 矩的时域累积
    float h = float(imageLoad(diHistoryLengthPrev, pixel).r);

    if(h > 1.1)
    {
        vec2 prev = imageLoad(diMomentsPrev, pixel).rg;
        float alpha = clamp(1.0 / h, 0.02, 0.2);
        m1 = mix(prev.x, m1, alpha);
        m2 = mix(prev.y, m2, alpha);
    }

 // 3) 方差
    float varRaw = max(m2 - m1 * m1, 0.0);

    float sumVar = 0.0;
    float sumW = 0.0;

    for(int dy = -1; dy <= 1; ++dy)
    {
        for(int dx = -1; dx <= 1; ++dx)
        {
            ivec2 q = pixel + ivec2(dx, dy);
            if(q.x < 0 || q.y < 0 || q.x >= size.x || q.y >= size.y)
            {
                continue;
            }

            vec2 mq = imageLoad(diMomentsPrev, q).rg;
            sumVar += max(mq.y - mq.x * mq.x, 0.0);
            sumW += 1.0;
        }
    }

    float variance = mix(varRaw, sumVar / max(sumW, 1.0), 0.5);

    imageStore(diMomentsOut, pixel, vec4(m1, m2, 0.0, 0.0));
    imageStore(
        diVarianceOut,
        pixel,
        vec4(max(variance, 0.0001), 0.0, 0.0, 0.0)
    );
}
