#version 460
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
#include "bruneton/definitions.glsl"
#include "bruneton/atmosphere.glsl"
#include "bruneton/common.glsl"
#include "bruneton/precompute.glsl"
layout(push_constant) uniform PC {
    int pcLayer;
    int pcAdditive;
    int pcScatteringOrder;
    int pcOutput;
} pc;
layout(set = 0, binding = 0) uniform sampler2D transmittanceTexture;
layout(rgba32f, set = 0, binding = 10) uniform image2D outDeltaIrradiance;
layout(rgba32f, set = 0, binding = 20) uniform image2D outIrradiance;

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= IRRADIANCE_TEXTURE_WIDTH ||
        pix.y >= IRRADIANCE_TEXTURE_HEIGHT) return;
    vec2 frag = vec2(pix) + 0.5;
    vec3 deltaIrradiance;
    vec3 irradiance;
    deltaIrradiance = ComputeDirectIrradianceTexture(
        ATMOSPHERE, transmittanceTexture, frag);
    irradiance = vec3(0.0);
    if (pc.pcOutput == 0) {
        imageStore(outDeltaIrradiance, pix, vec4(deltaIrradiance, 1.0));
    } else {
        imageStore(outIrradiance, pix, vec4(irradiance, 1.0));
    }
}
