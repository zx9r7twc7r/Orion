#version 460
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D godRayInput;
layout(rgba16f, set = 0, binding = 1) uniform image2D sceneOutput;
layout(set = 0, binding = 2) uniform sampler2D sceneDepth;
layout(set = 0, binding = 3) uniform CameraProperties
{
    #include "camera_ubo.glsl"
} cam;

const float VL_UPSAMPLE_DEPTH_SHARPNESS_NEAR = 1.0;
const float VL_UPSAMPLE_DEPTH_SHARPNESS_FAR = 6.0;
const float VL_NO_GEOMETRY_DISTANCE = 1.0e30;

float sceneDistanceForDepth(vec2 ndc, float depthValue)
{
    if(depthValue <= 1.0e-5)
    {
        return VL_NO_GEOMETRY_DISTANCE;
    }
    vec4 sceneViewPosition = cam.projInverse * vec4(ndc, depthValue, 1.0);
    if(abs(sceneViewPosition.w) <= 1.0e-6)
    {
        return VL_NO_GEOMETRY_DISTANCE;
    }
    return length(sceneViewPosition.xyz / sceneViewPosition.w);
}

// uv → 与体积光 pass 同一约定的 ndc（y 取反）。
vec2 ndcForUv(vec2 uv)
{
    vec2 ndc = uv * 2.0 - 1.0;
    ndc.y = -ndc.y;
    return ndc;
}

vec4 bilateralGodRay(vec2 uv, float centerDistance)
{
    vec2 inputSize = vec2(textureSize(godRayInput, 0));
    vec2 texel = 1.0 / inputSize;
    vec2 position = uv / texel - 0.5;
    const bool upsampling =
        inputSize.x > float(imageSize(sceneOutput).x) ||
        inputSize.y > float(imageSize(sceneOutput).y);
    vec2 center = floor(position + 0.5);
    vec4 accum = vec4(0.0);
    float weightSum = 0.0;
    for(int y = -1; y <= 1; ++y)
    {
        for(int x = -1; x <= 1; ++x)
        {
            if(!upsampling && x != 0 && y != 0)
            {
                continue;
            }
            vec2 tapUv = (center + vec2(float(x), float(y)) + 0.5) * texel;
            vec4 value = textureLod(godRayInput, tapUv, 0.0);
            float tapDepth = textureLod(sceneDepth, tapUv, 0.0).r;
            float tapDistance = sceneDistanceForDepth(ndcForUv(tapUv), tapDepth);
            float depthDelta = tapDistance - centerDistance;
            float depthSharpness = depthDelta > 0.0
                ? VL_UPSAMPLE_DEPTH_SHARPNESS_FAR
                : VL_UPSAMPLE_DEPTH_SHARPNESS_NEAR;
            float depthWeight = 1.0 / (1.0 + abs(depthDelta) * depthSharpness);
            accum += value * depthWeight;
            weightSum += depthWeight;
        }
    }
    return accum / max(weightSum, 1.0e-5);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(sceneOutput);
    if(any(greaterThanEqual(pixel, size)))
    {
        return;
    }

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    float centerDistance = sceneDistanceForDepth(
        ndcForUv(uv), texelFetch(sceneDepth, pixel, 0).r);

    vec4 godRay = bilateralGodRay(uv, centerDistance);
    godRay.rgb = max(godRay.rgb, vec3(0.0));
    godRay.a = clamp(godRay.a, 0.0, 1.0);

    vec4 scene = imageLoad(sceneOutput, pixel);
    if(scene.r < 0.0 || scene.g < 0.0 || scene.b < 0.0)
    {
        scene.rgb = max(scene.rgb, vec3(0.0));
    }
    scene.rgb = scene.rgb * godRay.a + godRay.rgb;
    imageStore(sceneOutput, pixel, scene);
}
