#version 460
#extension GL_GOOGLE_include_directive : require

// ===========================================================================
// 体积云离线预览（不进游戏）
//
// 与游戏内 volumetric_clouds_v3.comp **共用 cloud_v3_core.glsl** —— 同一份密度场、
// 同一份光照、同一份 march。差别只有外壳与相机：
//   · 游戏里是球壳 + 场景深度裁剪 + 太阳/月光/天光颜色链
//   · 这里是平面层（云底/云顶两个水平面）+ 固定相机 + 单一日照颜色
// 因此预览图能如实反映"形状/密度/明暗"，只有大气/时域/平面云不在这里。
//
// 输出：binding 5 的 rgba16f 图（rgb = 预乘辐亮度，a = 透射率），由 preview.cpp 存盘。
// ===========================================================================

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform PreviewParams
{
    vec4 cameraPosition;      // xyz = 相机位置（格），w = 垂直 FOV（弧度）
    vec4 cameraForward;       // xyz = 视线方向（单位），w = 未用
    vec4 cameraRight;         // xyz = 右向量，w = 未用
    vec4 cameraUp;            // xyz = 上向量，w = 未用
    vec4 sunDirection;        // xyz = 太阳方向（单位），w = 太阳强度
    vec4 layer;               // x = 云底, y = 云顶, z = 世界时间(s), w = frameIndex
    vec4 shape;               // x=coverage, y=densityFactor, z=noiseScale, w=typeInfluence
    vec4 light;               // x=brightness, y=silver, z=heightSkew, w=sunColorR?
    vec4 extras;              // x=erosionAmount, y=erosionScale, z=curlStrength, w=weatherScale
    vec4 steps;               // x=viewSteps, y=lightSamples, z=windSpeed, w=extinction
} params;

layout(set = 0, binding = 1) uniform sampler3D shapeTex;
layout(set = 0, binding = 2) uniform sampler3D detailTex;
layout(set = 0, binding = 3) uniform sampler2D curlTex;
layout(set = 0, binding = 4) uniform sampler2D weatherTex;
layout(rgba16f, set = 0, binding = 5) uniform writeonly image2D outImage;

#include "cloud_v3_core.glsl"

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outImage);
    if(any(greaterThanEqual(pixel, size))) return;

    vec2 ndc = (vec2(pixel) + 0.5) / vec2(size) * 2.0 - 1.0;
    float tanHalfFov = tan(params.cameraPosition.w * 0.5);
    float aspect = float(size.x) / float(size.y);

    vec3 dir = normalize(params.cameraForward.xyz
        + params.cameraRight.xyz * (ndc.x * tanHalfFov * aspect)
        + params.cameraUp.xyz * (ndc.y * tanHalfFov));

    vec3 origin = params.cameraPosition.xyz;
    vec3 sunDir = normalize(params.sunDirection.xyz);

    float baseAltitude = params.layer.x;
    float topAltitude = params.layer.y;
    float layerThickness = max(topAltitude - baseAltitude, 1.0);

    // 平面层求交（预览专用；游戏里是球壳）
    // 平面层求交。2026-10-18 修：相机在层内且视线接近水平时，原来用
    // `(base-y)/max(|dir.y|,1e-4)` 会算出 -2e6 这样的负距离 ⇒ march 直接跳过
    // （"层内视角 / 云顶视角看不到云"就是这个）。这里改成：层内从 0 起、以
    // 一个最远距离封顶，再按上下界面裁剪。
    const float previewMaxDistance = 30000.0;
    float startT = 0.0;
    float endT = 0.0;
    if(origin.y > baseAltitude && origin.y < topAltitude)
    {
        startT = 0.0;
        endT = previewMaxDistance;
        if(dir.y > 1.0e-4)
        {
            endT = min(endT, (topAltitude - origin.y) / dir.y);
        }
        else if(dir.y < -1.0e-4)
        {
            endT = min(endT, (baseAltitude - origin.y) / dir.y);
        }
    }
    else if(abs(dir.y) > 1.0e-4)
    {
        const float t0 = (baseAltitude - origin.y) / dir.y;
        const float t1 = (topAltitude - origin.y) / dir.y;
        startT = max(min(t0, t1), 0.0);
        endT = min(max(t0, t1), previewMaxDistance);
    }
    else
    {
        // 层外且与层平行：永远碰不到
        startT = 1.0;
        endT = 0.0;
    }

    vec4 march = vec4(0.0);
    float cloudDistance = 1.0e6;
    if(endT > startT + 1.0)
    {
        V3MarchInputs inputs;
        inputs.rayOrigin = origin;
        inputs.rayDirection = dir;
        inputs.lightDirection = sunDir;
        inputs.shellOrigin = vec3(origin.x, baseAltitude, origin.z);
        inputs.earthCenter = vec3(origin.x, baseAltitude - 6360000.0, origin.z);
        inputs.startT = startT;
        inputs.endT = endT;
        inputs.layerThickness = layerThickness;
        inputs.coverageMaster = params.shape.x;
        inputs.baseDensityFactor = params.shape.y;
        inputs.noiseScale = params.shape.z;
        inputs.cloudTypeInfluence = params.shape.w;
        inputs.windSpeed = params.steps.z;
        inputs.timeSeconds = params.layer.z;
        inputs.windDirection = normalize(vec3(1.0, 0.0, 0.0));
        inputs.heightGradientSkew = params.light.z;
        inputs.erosionScale = params.extras.y;
        inputs.curlStrength = params.extras.z;
        inputs.weatherScale = max(params.extras.w, 1000.0);
        inputs.erosionAmount = params.extras.x;
        inputs.extinction = max(params.steps.w, 0.0);
        inputs.requestedSteps = int(params.steps.x);
        inputs.lightSamples = int(params.steps.y);
        inputs.frameIndex = int(params.layer.w);

        inputs.ambientColor = vec3(0.38, 0.52, 0.80);

        V3MarchSettings settings;
        settings.eccentricity = 0.6;
        settings.silverIntensity = params.light.y;
        settings.silverSpread = 0.1;
        settings.brightness = params.light.x;
        settings.ambientStrength = 0.25;

        march = v3MarchClouds(shapeTex, detailTex, curlTex, weatherTex, inputs, settings,
            cloudDistance);
    }

    float opacity = clamp(march.a, 0.0, 1.0);
    vec3 sunColor = vec3(params.sunDirection.w);
    vec3 rgb = march.rgb * opacity * sunColor;

    // 调试视图（params.light.w > 0.5）：直接输出不透明度，用来核对密度场
    if(params.light.w > 0.5 && params.light.w < 1.5)
    {
        rgb = vec3(opacity);
    }

    // 探针（params.light.w >= 1.5）：在视线中点直接采样一次密度场，
    //   r = 区间是否有效(0/1)，g = 该点 baseDensity × 4，b = 该点相对高度
    if(params.light.w >= 1.5)
    {
        float midT = 0.5 * (startT + endT);
        vec3 probePos = origin + midT * dir;
        vec3 shellOrigin = vec3(origin.x, baseAltitude, origin.z);
        vec3 relSample = (probePos - shellOrigin) / layerThickness;
        vec3 samplePoint = relSample / max(params.shape.z, 0.001);
        float probeHeight = clamp(abs(dot(dir, normalize(probePos - vec3(origin.x,
            baseAltitude - 6360000.0, origin.z)))) * (midT - startT) / layerThickness, 0.0, 1.0);
        float probeDensity = v3SampleLowFrequency(shapeTex, weatherTex, samplePoint, probePos,
            probeHeight, params.shape.x, params.shape.w, max(params.extras.w, 1000.0));
        rgb = vec3(endT > startT + 1.0 ? 1.0 : 0.0, clamp(probeDensity * 4.0, 0.0, 1.0),
            probeHeight);
        imageStore(outImage, pixel, vec4(rgb, 0.0));
        return;
    }

    imageStore(outImage, pixel, vec4(rgb, 1.0 - opacity));
}
