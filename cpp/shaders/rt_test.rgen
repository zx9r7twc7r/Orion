#version 460
// 2026-10-23：延迟材质路径（RT_DEFERRED_MATERIAL）已整段删除。材质只在命中着色器
// 里求值（resolveHitMaterial），ray generation 不再承担材质体；原先"两种模式"的
// 条件编译与兜底 #define 一并不存在了。
#extension GL_GOOGLE_include_directive : require

#extension GL_EXT_ray_tracing : require
// 2026-10-30 方案 A：次级辐射射线要用 gl_RayFlagsForceOpacityMicromap2StateEXT，
// glslang 要求显式请求该扩展（否则报 "required extension not requested"）。
#extension GL_EXT_opacity_micromap : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#ifdef RT_ENABLE_SER
#extension GL_EXT_shader_invocation_reorder : require
#endif

// ============================================================================
// 2026-10-11 SHaRC（世界空间哈希辐射缓存，NVIDIA RTXGI SHARC v1.8.3）接入
//                  —— 第 1 阶段：零号版本（零行为改变）
//
// 本阶段只把接口接齐：扩展 / NVIDIA 头 / UBO 里的地址与标量 / 模式闸门。**不调用
// 任何缓存读写函数**，所以画面与帧率必须与接入前逐位相同 —— 这就是本阶段的验收
// 判据（外加验证层零报错）。
//
// 三道闸门，任何一道为 0 都表示"不许碰缓存"，见下面 sharcMode()：
//   · ORION_SHARC 未开 ⇒ C++ 侧不创建那三块缓冲 ⇒ cam.sharcBuffersLo/Hi 全 0、
//     cam.sharcCacheParams.x = 0；
//   · 缓冲创建/取地址失败 ⇒ 同上（C++ 侧把 g_sharcBuffersReady 留在 false）；
//   · 首个启用 SHaRC 的帧还没把缓存清零（g_sharcZeroed=false）⇒ C++ 侧同样不下发。
//
// 为什么走 buffer_reference 而不是描述符绑定：NVIDIA 的 GLSL 支持层
// （sharc/SharcGlslHelpers.h）把三块缓存表达为 GL_EXT_buffer_reference 类型，按
// 64 位设备地址访问内存，完全不经过描述符。地址由 C++ 侧经 CameraUBO 的
// sharcBuffersLo/Hi（两个 uvec4，低 32 位在 .x）与 sharcCacheParams 下发。
//
// 为什么 include 放在最靠前：sharc_enable.glsl 里的 #extension 必须早于任何使用；
// 它同时负责撤掉 NVIDIA 头注入的那批 HLSL 风别名宏（lerp/saturate/asfloat...），
// 那些宏会横扫本文件之后的整个翻译单元 —— 详见 sharc_enable.glsl 的文件头。
//
// ============================================================================
//   .tmp/ref/RTXGI/Samples/Pathtracer/PathtracerPipelines.cpp:84-88：
//   同一份源码编两次，一次 SHARC_UPDATE=1、一次 SHARC_QUERY=1）。
// 本工程同构：
//   · 渲染 pass：不带任何定义 ⇒ sharc_enable.glsl 的 #ifndef 让它落到 SHARC_UPDATE=0
//   · update pass：-DSHARC_UPDATE=1 ⇒ 产物 rt_test_sharc_update.rgen.spv
//
// ⚠ 这里**绝不要**再写 `#define SHARC_UPDATE ...`。我此前在"piggyback"方案里写死了
//   `#define SHARC_UPDATE 1`，后果是：两个变体编出**逐字节相同的二进制**
//   （实测三个产物哈希全等），渲染 pass 里还带着 update 调用 —— 也就是分派形同虚设。
//
// 下面几条宏也不再覆盖，全部用参考默认值（SharcCommon.h:71/75/79/91/96/123）：
//   SHARC_ENABLE_CACHE_RESAMPLING = SHARC_UPDATE（**开**）
//   SHARC_SAMPLE_NUM_THRESHOLD    = 0
//   SHARC_USE_FP16 / SHARC_MATERIAL_DEMODULATION / SHARC_SEPARATE_EMISSIVE = 0
// 我此前自造的"关掉重采样"与"门槛 4→8→16"两个覆盖已删除：它们都是在错误挂点下
// 为了压症状而调的，挂点改回参考之后没有存在理由。
// ============================================================================

// 2026-10-11 修正（实机教训，详见 VulkanCore.cpp 的 radianceScale 说明）：
//   ① 分母下限只用来防零 —— 不再当"反射率下限"用。因为存进去的是**物理辐射度**
//      （indirectLight / brdfWeight），brdfWeight 里的采样权重本来就该是它的分母，
//      把一个偏小的 brdfWeight 抬起来等于**把该样本的辐射度系统性抬高**（有偏）。
//   ② 写/读两侧仍然要钳位：负值在宿主侧会被 uint(负数) 变成巨值（GLSL 未定义），
//      萤火虫同理；NaN 一旦进入颜色会被 RR/DLSS 的历史缓冲抹遍全屏。
//   ③ 命中门槛 4 → 16 → 8 的来回，是跟着**查询挂点**走的：
//      · 挂主命中时：误差直接落在可见面上，必须靠"只信收敛好的体素"压方差 ⇒ 16；
//        实机结果：命中率掉到 7.6%，而"错位"依旧 ⇒ 说明问题不在门槛，在挂点。
//      · 挂到间接命中后（5b-3）：误差落在间接-间接项上、可见度低得多，
//        可以换回命中率 ⇒ 8。真正的杠杆是挂点，不是这个数。
#define SHARC_MIN_BSDF_WEIGHT 1e-4
#define SHARC_MAX_IRRADIANCE 1000.0
#include "sharc_enable.glsl"

// =====================================================
// Perf-L10.1 / LL-P1.1 GPU feature-isolation stage
//
// 0  baseline
// 1  disable RTAO rays only
// 2  disable primary GGX glossy-ray path only
// 3  disable diffuse-GI path only
// 4  disable all three paths above
// 5  disable G2B Local-Light guide scans only
// 6  disable Local-Emitter hit scans only
// 7  disable both Local-Light scan paths above
// 8  cap diffuse GI at one bounce
// 9  cap near-field RTAO at two rays
// 10 cap soft sun shadows at one ray
// 11 Russian-roulette termination in the diffuse-GI loop (force ON)
// 12 cap the sun-transmittance-through-water march at one step
// 13 halve every distance-LOD threshold
// 14 force the GI Russian roulette OFF (the on → off direction)
//
// The stage is a runtime value, not a compile-time #define: the native side
// cycles it every PERF_L10_ABLATION_FRAMES_PER_STAGE frames (120) and writes it
// into CameraUBO.perfAblationStage.x, so one capture covers every stage instead
// of one rebuild-and-run per stage.
// 2026-10-07：lane 从 perfPrimary.x 挪到独立的尾块 perfAblationStage ——
// perfPrimary.x 现在是用户「RTAO 近距采样」，共用会让正常档的采样数直接选中
// 一个剥离级（旧版就是因此把 perfL10Stage() 改成恒返回 0，扫级静默失效）。
// 主机在 ORION_PERF_ABLATION 未开时恒写 0 ⇒ 本文件恒走 base，与旧档逐位相同。
// 谓词定义在 CameraProperties 块之后（`cam` 在那里才可见）。
// =====================================================


// LL-P3.1 pinned local-light energy to the bounded primary direct-light path
// and made diffuse GI a pure BSDF continuation.
//
// LL-P3.2 (route C, 2026-09-24) briefly re-enabled the directional guide for
// vertices deeper than the first, and was REJECTED on cost: the guide can only
// produce a bounce from a SECOND diffuse vertex, so it forces "GI 跳数"
// (giBounces) to 2, and that extra GI segment (whole scene ray + its own PBR
// shading + its own sun NEE + water probe) is what made the frame hitch -- not
// the guide's own light scan.
//
// LL-P3.3 (route A, 2026-09-24) supplies the same bounce without a second
// vertex: one explicit local-light NEE at the first GI vertex (see the
// `bounceLocalDiffuse` block in main).  The guide stays OFF; the
// `useLocalGuide` parameter below is kept only so a future experiment can turn
// it on per vertex without re-deriving the primary/secondary distinction.
const bool LL_P3_ENABLE_G2B_LOCAL_GUIDE =
    false;

// Analytic pane radiance / display-transform handshake.  Defined up here
// rather than next to its long explanation (search RR_STABLE_GLASS_RADIANCE)
// because the descriptor carrying it is declared a few lines below, and the
// preprocessor has to know the value by then.
//
// NOTE: this switch also owns descriptor binding 54.  When it is 0 the raygen
// keeps the pane's reflection + analytic gloss INSIDE the colour (the 09-23
// behaviour) instead of withholding them from RR and adding them back in the
// display transform.  The C++ side may still bind 54 unconditionally; a shader
// that declares no binding 54 simply ignores that slot, so no C++ change is
// required.  The display shaders (rr_sdr_post / rr_hdr_encode) must carry the
// SAME value or they would add back a texture the raygen no longer writes.
#ifndef RR_STABLE_GLASS_RADIANCE
#define RR_STABLE_GLASS_RADIANCE 0
#endif

layout(binding = 0, set = 0) uniform accelerationStructureEXT topLevelAS;
layout(binding = 1, set = 0, rgba16f) uniform image2D image;

layout(binding = 6, set = 0, rgba32f)
uniform image2D historyColor0;

layout(binding = 7, set = 0, r32f)
uniform image2D depthImage;

// =====================================================
// 2026-10-09 运动矢量（DLSS-RR）：本工程的**第一个** MV 生产者。
//
// 在此之前 g_motionImage 只在创建时被 clear 过一次、**从未被写过**，而宿主交给
// DLSS 的 constants.mvecScale=(1,1) 又表明"这是一张有效输入" ⇒ DLSS 认为每个
// 像素的世界表面都静止，于是**只有移动物体会拖残影**（静态世界由 clipToPrevClip
// 自己算对了）。
//
// 语义（与宿主 cameraMotionIncluded=eFalse 严格配对）：**只放"物体自身运动"**，
// 相机运动由 DLSS 自己加。因此：
//   · 天空 / miss            → 0
//   · 静态几何（motionOffset==0）→ 0（本来就该是 0，不是"漏写"）
//   · 动态几何（实体/粒子/手）→ 由 closest-hit 插值出的世界位移换算而来
//
// ★ 为什么这个公式对 jitter 免疫：两次投影都用**同一张上一帧矩阵**
//   （prevViewProj），jitter 在两项里完全相同 ⇒ 相减自动抵消，天然满足
//   motionVectorsJittered=false；无需任何去抖处理。
//
// ⚠ 单位：这里写"像素"。若实测残影**变严重/方向加倍**，先把下面的
//   MOTION_VECTOR_UV_UNITS 打开（改写成 UV 单位）再看 —— 宿主 mvecScale=(1,1)
//   与"{1,1} 表示 UV"这两种解释只能靠实机二选一，代码里留了单点开关。
// =====================================================
layout(binding = 62, set = 0, rg16f)
uniform image2D dlssMotionImage;

// 2026-10-22：MV 改为 **UV 单位**（宿主 mvecScale=(1,1)，官方 §6.0 的
// "values in [-1,1] ⇒ scale {1,1}"）。此宏仅保留历史兼容，新代码不再分支。
#define MOTION_VECTOR_UV_UNITS 1

// =====================================================
// 2026-10-09 运动矢量**调试视图**（运行期开关，出厂关 ⇒ 正常游玩零影响）。
//
// 开关走**设置项**而不是编译期 #define（照工程既有先例：giRoulette 那种"一份编译
// 产物服务所有档"的做法）：
//   RTXSettingsConfig.getMotionDebugView()  （设置项 / 设置界面）
//     → NativeVulkan.setMotionDebugView(mode) → C++ 的 g_motionDebugView
//     → 每帧写 CameraUBO.perfAblationStage.y（**保留 lane**，注释见 camera_ubo.glsl）
//     → 这里读 cam.perfAblationStage.y 分派。
// 所以改设置**下一帧就生效**，不需要重编/重启/重建任何资源。
//
// 画的是**本像素真正写进 MV 图的那个值**，不是另算一遍 ⇒ 它同时证明了两件事：
// rgen 确实写了 MV，以及写进去的是多少。
//
// 判读：
//   模式 1（幅值热图）：黑 = 零位移。**静态世界与天空应该是纯黑**；任何"整屏灰"
//                       都说明有相机成分漏进了 MV（相机那一份该由 DLSS 自己加）；
//                       移动物体是一团亮斑，越亮位移越大（16 像素满偏）。
//   模式 2（有向色）：中性灰 0.5 = 零位移；红 = 水平位移、绿 = 垂直位移。
//                       颜色反了 ⇒ 符号写反；整屏彩色噪声 ⇒ 单位错了。
// =====================================================
vec3 rtMotionDebugColor(vec2 motionPixels, uint mode)
{
    if(mode == 1u)
    {
        // 幅值热图：静止必须是纯黑，这一条比任何主观判断都硬。
        const float magnitude =
            clamp(length(motionPixels) / 16.0, 0.0, 1.0);

        return vec3(magnitude);
    }

    // 有向色：0.5 偏置是为了让"正/负"都能看见（纯色相看不到负值）。
    return vec3(
        clamp(motionPixels.x * 0.25 + 0.5, 0.0, 1.0),
        clamp(motionPixels.y * 0.25 + 0.5, 0.0, 1.0),
        0.5
    );
}

layout(binding = 8, set = 0, rgba32f)
uniform image2D historyColor1;

layout(binding = 9, set = 0, r32f)
uniform image2D historyDepth0;

layout(binding = 10, set = 0, r32f)
uniform image2D historyDepth1;

layout(binding = 11, set = 0, rgba16f)
uniform image2D historyNormal0;

layout(binding = 12, set = 0, rgba16f)
uniform image2D historyNormal1;

// =====================================================
// RR-6.2 - DLSS Ray Reconstruction Guide Buffers
// =====================================================

layout(binding = 13, set = 0, rgba16f)
uniform image2D rrDiffuseAlbedoImage;

layout(binding = 14, set = 0, rgba16f)
uniform image2D rrSpecularAlbedoImage;

layout(binding = 15, set = 0, rgba16f)
uniform image2D rrNormalRoughnessImage;

layout(binding = 16, set = 0, r32f)
uniform image2D rrSpecularHitDistanceImage;

// 2026-10-23：DLSS RR 的 TransparencyHint（binding 71，R8_UNORM）。
// 1 = 本像素内容来自穿过玻璃/透明接收面的路径。宿主只在开关打开时把它作为
// kBufferTypeTransparencyHint 交给 RR；但描述符始终绑定，所以这里无条件写。
layout(binding = 71, set = 0, r8)
uniform image2D rrTransparencyHintImage;

// ============================================================================
// 2026-10-24 半分辨率 GI（HANDOFF-2026-10-24-GI-HALFRES.md）
//
// 唯一一张"两用"图：GI 变体（-DGI_HALFRES=1，独立 SPV）写它，主变体读它。
// 布局 rgba16f：
//   rgb = 解调后的辐照度（indirectLight / brdfWeight）
//   a   = 主命中视深度（米，正数）
// 用 storage image + 手写 imageLoad 3×3，不另建 sampler —— 半分辨率的图做
// 硬件双线性只会跨物体边缘糊边，权重必须自己按深度算（见 upsampleGiHalf）。
// ============================================================================
layout(binding = 72, set = 0, rgba16f)
uniform image2D giHalfImage;

// ============================================================================
// 2026-10-26 持久泡沫图（路线 B，Crest 移植；见 water_foam.comp 头注释）
//
// binding 73：512² RGBA16F、2 层、6 级 mip，宿主 30 Hz 累积/耗散。.r = 泡沫量。
//   采样坐标来自 CameraUBO.pomParams.yzw = 原点 x/z / 纹素世界尺寸（0 = 未就绪）。
//   已发布的读层是 CameraUBO.cloudAerialParams.w（0/1，尾块复用，见 camera_ubo.glsl）。
// binding 74：岸线覆盖率注入图（r32ui）。主光线在水下接收面深度 < ~1.35 格时
//   把覆盖率原子写进对应泡沫纹素；water_foam.comp 每 tick 取走并清零。
//   用 r32ui 而不是 r16f：正浮点位序与 uint 单调一致，才能用 imageAtomicMax。
//
// 2026-10-26 21:1x 用户不要泡沫 ⇒ 路线回退：两个 binding 随宿主布局（缩回
// 0..72）一起摘掉，采样/注入/着色三处代码在下方 #if 0 里屏蔽保留。
// ============================================================================
#if 0
layout(binding = 73, set = 0) uniform sampler2DArray waterFoamMap;

layout(binding = 74, set = 0, r32ui)
uniform uimage2D waterFoamInjection;
#endif

// ============================================================================
// 2026-10-26：半透明 alpha blend 的**旁路输出**（binding 73/74/75）
// 设计：docs/decisions/alpha-blend-pass-split.md §3.1 / §7.1（本轮按 §7.4 执行）
//
// 73 gbuffer : rgb = SUM_i tint_i*a_i*PI_{j<i}(1-a_j)   （不含光照的"表面色"）
//              a   = a_0（相机直接命中的那一层）
// 74 meta    : rgb = PI_{1..N}(1-a_i)（链内逐通道透射率，来自 any-hit 累乘）
//              a   = 第一层玻璃面到相机的距离（格）；0 = 本帧这一格没有半透明面
// 75 light   : rgb = E_bg（接收面的入射辐照度，已除以 albedo 解调）
//              a   = 1 = 本帧确实写过
//
// 消费方是 glass_alpha_blend.comp / glass_alpha_finish.comp（独立 descriptor set）。
// 本文件**不再**在 rgen 里把玻璃合成进颜色：颜色由 75 号图 + 73 号图在屏幕空间
// 重新合成（Remix 的 alpha_blend composite 结构），于是"邻居搜索"与"5x5 滤波"
// 这两件就地合成永远做不到的事才有落点。
//
// ⚠ 74 号图的 a 通道**必须由宿主每帧清 0**（未写 = 非半透明面）。判据不能换成
//   73 号图的 a：全透明层的 a_0 可以是 0，但它照样要往颜色里加 E。
// ⚠ 73/74 历史上是水泡沫的两张图（2026-10-26 回退后整段在 #if 0 里），
//   宿主布局同期从 b[73] 扩到 b[76]，其余 72 个 binding 编号一个都没动。
// ============================================================================
layout(binding = 73, set = 0, rgba16f)
uniform image2D glassAlphaBlendGbufferImage;

layout(binding = 74, set = 0, rgba16f)
uniform image2D glassAlphaBlendMetaImage;

layout(binding = 75, set = 0, rgba16f)
uniform image2D glassAlphaBlendLightImage;

// 2026-10-27：radiance volume 兜底（体素面辐照度缓存换算值，见写入点注释）。
layout(binding = 77, set = 0, rgba16f)
uniform image2D glassAlphaBlendVolumeImage;

// =====================================================
// 2026-10-27 稀疏渲染的活跃像素掩码（R8_UINT）。
//
// 生产者：sparse_active_mask.comp（宿主在 trace 之前 dispatch；4x2 像素块
// 打包进一个 uint 的低 8 位，bit = y*4 + x）。
// 消费者：vptSparsePixelIsActive —— 与 Remix 的 isActivePixelFromMask 同款，
// 判定不再由本 pass 自己抽签，保证与任何下游消费者逐位一致。
// =====================================================
layout(binding = 78, set = 0, r8ui)
uniform readonly uimage2D sparseActiveMaskImage;

// =====================================================
// 2026-10-27：Remix 的**时空蓝噪声**（严格搬）
//
// 原文 utility/noise.slangh:161-249
//   #define RNG_SEED_FRAME_RANGE 64
//   struct RNG { uvec2 pixelIdx; uint seed; uint temporalIdx; };
//   float getNextSampleBlueNoise(inout RNG rng)
//   { const uint oldSeed = rng.seed++;
//     uvec2 seedOffset = uvec2(R2(oldSeed) * uvec2(128, 128));
//     float value = texelFetch(BlueNoise, ivec3((rng.pixelIdx.x + seedOffset.x) & 127,
//                                               (rng.pixelIdx.y + seedOffset.y) & 127,
//                                               (rng.temporalIdx) & (RNG_SEED_FRAME_RANGE - 1)), 0).r;
//     return min(value, 1.0f - 1.0f / 255.0f); }
//   vec2 R2(uint index) { const float g = 1.32471795724474602596f;      // :149-157
//                         return fract(vec2(float(index) / g, float(index) / (g * g))); }
//
// 数据：_ref/dxvk-remix/src/util/util_blueNoise_128x128x64.h（MIT），
// 已原样导出为 shaders/blue_noise_128x128x64.r8 并由宿主上传为 storage buffer。
// texelFetch 本就是 NEAREST 取单个 texel ⇒ 这里按字节索引与它逐位等价。
// =====================================================
layout(binding = 76, set = 0, std430) readonly buffer GlassBlueNoiseBuffer
{
    uint words[64u * 128u * 128u / 4u];
} glassBlueNoise;

vec2 glassBlueNoiseR2(uint index)
{
    const float g = 1.32471795724474602596;
    return fract(vec2(float(index) / g, float(index) / (g * g)));
}

float glassBlueNoiseSample(uvec2 pixelIdx, uint temporalIdx, uint seedIndex)
{
    const uvec2 seedOffset = uvec2(glassBlueNoiseR2(seedIndex) * vec2(128.0));
    const uint x = (pixelIdx.x + seedOffset.x) & 127u;
    const uint y = (pixelIdx.y + seedOffset.y) & 127u;
    const uint layer = temporalIdx & 63u;
    const uint byteIndex = 16384u * layer + 128u * y + x;
    const uint word = glassBlueNoise.words[byteIndex >> 2u];
    const uint raw = (word >> ((byteIndex & 3u) * 8u)) & 0xFFu;
    return min(float(raw) * (1.0 / 255.0), 1.0 - 1.0 / 255.0);
}

// Analytic (zero-variance) radiance the denoiser must not touch.  Written by
// this raygen with the pane's mirror lobe + solar gloss removed from every
// other pixel, read back by the display transform after DLSS RR.  See
// RR_STABLE_GLASS_RADIANCE below for the full argument.
#if RR_STABLE_GLASS_RADIANCE
layout(binding = 54, set = 0, rgba16f)
uniform image2D rrStableRadianceImage;
#endif

// Glass scene-reflection hit distance, declared early because
// traceGlassSceneReflectionOneRay() (defined above the main block) writes it
// and the glass primary path reads it after the trace.  Lets RR reproject the
// pane's reflected content at the correct depth (opaque surfaces already do
// this via glossySpecularHitDistance).  Initialised to the sky/infinity value.
float rrGlassReflectionHitDistance = 65504.0;

// =====================================================
// the pane's MIRROR half - indirect light at the reflected surface
//
// 2026-09-30 收口：原 GI_GLASS_REFLECTION_INDIRECT 方案（给镜像半侧补一次
// GI 弹射 + 一个 ReSTIR DI 水库）已随 ReSTIR DI 链整链删除。镜面半侧回到基线：
//   evaluateOpaqueSurfaceRadiance
// + evaluateVPTExactFaceDirectLighting
// + albedo * noDirectLightAmbient
// 即 emission + 直射太阳 + 烘焙面直射。详见 HANDOFF §17。
// =====================================================

// Reflection face's two legacy local-light terms (emitter-adjacency glow +
// voxel-quantised bake).  The reflection face missed the primary opaque path's
// speck-suppression gate, so it keeps its own switch:
// 1 = legacy behaviour (has specks), 0 = drop them (A/B: specks gone, but the
//     mirror loses its local-light fallback).
//
// 2026-09-30：默认改为 **0**。用户报告「玻璃内部的均匀噪点，采样数和候选怎么
// 调都还在」—— 与采样无关 ⇒ 不是估计器方差，只能是**确定性**来源；而这份确定性
// 来源在本文件里只有一处：反射面对
//   evaluateVLIEmitterRadianceAtHit（发射体邻接自发光，不看染色、不查遮挡）
//   evaluateVPTExactFaceDirectLighting（16^3 x 6 面缓存的**逐方块面量化**烘焙）
// 的读取。第二项就是"空间离散静态白点"：它每个方块面一个常量，远处反射内容里
// 一个方块面只占亚像素 ⇒ 屏幕上直接呈现为均匀细颗粒，且因为它是**查表**而不是
// 采样，采样数/候选数怎么调都不会动它。16149-16159 的记载同样写明这份 bake
// 「只被玻璃反射分支读到」，且「正是迁移要删掉的量化」。
// 关闭的门控代价：镜面半侧失去本地光兜底（反射到的内容若只被本地光照亮会变
// 暗）。若出现这一代价，正道是让反射端点走主路径那套 RIS（evaluateVPTRIS-
// DirectLighting），而不是量化烘焙——那是本文件既定的迁移方向。
//
// 2026-09-30 实测（用户侧）：置 0 后玻璃里的均匀颗粒**没有任何变化** ⇒ 它不是
// 水汽里那层"空间离散白点"的来源，或至少不是用户场景里的那一份。基线回 1，
// 避免白付镜面本地光兜底的代价；嫌疑改判见 DBG_KILL_VLI_EMITTER 处的记载。
#ifndef GI_GLASS_REFLECTION_LEGACY
#define GI_GLASS_REFLECTION_LEGACY 1
#endif


// Route A: give the pane's two endpoints separate guides.
//
// One RR call still takes one normal-roughness record, but the pane's content
// arrives from two depths with two different materials.  GI_GLASS_RECEIVER_
// GUIDE_MODE >= 2 hands that single record to the behind-glass receiver, which
// is right when transmission owns the pixel -- and wrong when the mirror lobe
// owns it, because then the pane's own sharp reflection rides a rough guide and
// softens into haze (the coupling RR_STABLE_GLASS_RADIANCE was built to hide).
//
// This switch picks the guide by the same dominance rule the reference
// renderer's stablePlaneExportGuides() uses (largest throughputLuminance wins),
// evaluated on the two lobe weights the pane already has:
//
//   reflection owns the pixel -> normal + roughness come from the *reflected*
//                                surface, so the mirror endpoint has a guide
//                                that describes its own depth and material
//   transmission owns it      -> the merge below keeps the receiver's guide
//
// The reflected endpoint's own depth was already exported for the specular hit
// distance (rrGlassReflectionHitDistance); this adds its roughness so the guide
// pair (normal, roughness) is internally consistent rather than a pane normal
// with a receiver roughness.
//
// 1 = dominant lobe chooses the guide (route A)
// 0 = merge always wins, bit-exact for an A/B
//
// 2026-09-30: 默认改为 1，与上面的 GI_GLASS_RECEIVER_GUIDE_MODE=2 配套 ——
// mode 2 把「接收面的记录」交给 RR 之后，镜像主导的像素会跟着接收面的粗糙度
// 一起被 RR 的空间核抹开（玻璃读成一层软膜）。route A 用同一个支配判据把
// 镜像侧换回**反射端点自己**的法线/粗糙度/反照率，两个端点各自自洽。
#ifndef GI_GLASS_DOMINANT_GUIDE
#define GI_GLASS_DOMINANT_GUIDE 1
#endif

#if GI_GLASS_DOMINANT_GUIDE
// Route A's reflection endpoint: the surface a pane pixel's mirror lobe sees.
// 2026-09-30：有效性 / 法线 / 反照率这三项曾被 09-30 的 ReSTIR 收口连带删掉
// （它们原来挂在已删除的 GI_GLASS_REFLECTION_INDIRECT 导出块里），而 route A
// 的消费端一直躲在 GI_GLASS_DOMINANT_GUIDE=0 后面没参与编译，于是谁也没发现。
// 现在 route A 默认开启，导出由 traceGlassSceneReflectionOneRay 在镜像命中的
// 不透明面处写回，与下面的粗糙度同源 —— 一个玻璃像素一份记录。
bool glassReflectionReceiverValid = false;
vec3 glassReflectionReceiverNormal = vec3(0.0, 1.0, 0.0);
vec3 glassReflectionReceiverAlbedo = vec3(0.0);
float glassReflectionReceiverRoughness = 1.0;

// The pane's two lobe weights, fresh from tracePrimaryGenericTransparent-
// Radiance.  The guide block in main needs them to decide which endpoint owns
// the pixel; they are local to that trace, so it exports them here.
vec3 glassLobeReflectionWeight = vec3(0.0);
vec3 glassLobeTransmissionWeight = vec3(0.0);
bool glassLobeWeightsValid = false;
#endif

// Declared before helper functions because the distance-budgeted VPT/RIS
// helper reads the camera origin from this UBO.
layout(binding = 2, set = 0) uniform CameraProperties {
    #include "camera_ubo.glsl"
} cam;

// ============================================================================
// 2026-10-11 SHaRC —— 地址重建 / 模式闸门 / 参数打包
//
// 2026-10-11 5b-1 起这三件事搬到了 cpp/shaders/sharc_ubo.glsl（单一真源）：
// Resolve pass（rt_sharc_resolve.comp）需要**逐字相同**的版本，两边各存一份必然漂移
// —— 本工程刚在 camera_ubo.glsl 上吃过"每个消费者各抄一份前缀"的亏。
// 前置条件本文件已满足：sharc_enable.glsl 在最前、`cam` 块体就在上面。
// ============================================================================
#include "sharc_ubo.glsl"

// ============================================================================
// 2026-10-11 5a：寻址探针（只读 + 回写，供宿主回读校验）
//
// 背景：前面所有工作都只证明了"能编译"。而 buffer_reference 是**按 64 位设备地址**
// 访问内存的，地址写错、元素下标算错、结构体字节偏移猜错 —— 三种错法都**不会报错**，
// 只会读出别人的显存或数据垃圾。所以在接任何真实缓存逻辑之前，先用一组已知值把
// 这四块缓冲各读一次、回写出来让宿主比对。
//
// 宿主（cpp/VulkanCore.cpp 的 sharcProbeTick）预先用 vkCmdUpdateBuffer 往每块缓冲的
// 第 0 个元素写一组魔数：
//   hashEntries[0]      = 0x1111111122222222（8 字节）
//   accumulation[0]     = 33333333 34343434 35353535 36363636（16 字节）
//   resolved[0]         = 44444444 45454545 46464646 47474747（16 字节）
//                         布局由 SPIR-V 机械确认（OpMemberDecorate，见 2026-10-11 记录）：
//                           radianceData  @0  （float16_t4 = 8 字节）
//                           sampleData    @8  ⇒ 期望 0x46464646
//                           sampleDataExt @12 ⇒ 期望 0x47474747
//                         ⚠ 第一次跑探针时我把 sampleData 猜成 +12，于是误判成 FAIL ——
//                           实际读数 0x46464646 正好是 +8 那个字。所以这里两个偏移都断言。
//   lock[0]             = 0x5A170001
// 本函数把读到的值写进 lock[1..5]，宿主回读 lock[0..5] 逐项比对。
// lock 缓冲在 HASH_GRID_ENABLE_64_BIT_ATOMICS=1（SDK 默认，本工程就用这个）时**完全
// 不使用**，所以拿它当归读槽不会影响任何东西。
//
// 只让 (0,0) 这一个 invocation 写：同址多写虽同值，但单写者更好推理。
// ============================================================================
void sharcProbeWriteBack()
{
    // 注意：buffer_reference 类型的变量**不能带 const 限定符**（GLSL 规定，
    // 2026-10-11 实测 glslang 直接报 "variables with reference type can't have
    // qualifier 'const'"）。
    RWStructuredBuffer_uint64_t probeHash =
        RWStructuredBuffer_uint64_t(sharcCacheAddress(0u));
    RWStructuredBuffer_SharcAccumulationData probeAccumulation =
        RWStructuredBuffer_SharcAccumulationData(sharcCacheAddress(1u));
    RWStructuredBuffer_SharcPackedData probeResolved =
        RWStructuredBuffer_SharcPackedData(sharcCacheAddress(2u));
    RWStructuredBuffer_uint probeOut =
        RWStructuredBuffer_uint(sharcCacheAddress(3u));

    const uint64_t hashKey = probeHash.data[0];

    // 注意：GLSL 没有 C 的 `ull` 后缀（0xFFFFFFFFull 会直接语法错），
    // 用 uint64_t(...) 显式构造最稳（见下面的写法）。
    probeOut.data[1] =
        uint(hashKey & uint64_t(0xFFFFFFFFu));                   // 期望 0x22222222
    probeOut.data[2] = uint(hashKey >> 32u);                     // 期望 0x11111111
    probeOut.data[3] = probeAccumulation.data[0].data.x;         // 期望 0x33333333
    probeOut.data[4] = probeResolved.data[0].sampleData;         // 偏移 +8  ⇒ 期望 0x46464646
    probeOut.data[5] = probeResolved.data[0].sampleDataExt;      // 偏移 +12 ⇒ 期望 0x47474747
    probeOut.data[6] = cam.sharcCacheParams.y;                   // 期望 = 容量（自证 UBO lane 通）
}

// ============================================================================
// 2026-10-11 5b-1：Update pass —— 把 SHaRC 的更新挂在**已有的 GI 回路**上
//
// 为什么不去写一个新的稀疏路径追踪器
// --------------------------------
// 本文件 main 里那段 GI 回路（`indirectLight` / `currentOrigin` / `currentDir` /
// `currentThroughput`，从 20315 起）本来就在算"主命中点处的入射辐射度"，而且走的是
// 本工程完整的材质 / 本地光 / 天空 / 水面 / 玻璃路径。SHaRC 的 update 要的正是这个量
// （见 SharcUpdateHit 的 directLighting 参数）。挂上去等于**零额外射线**：增加的成本
// 只有"哈希插入 + 原子累加"。
//
// 存的是什么（挂点在 GI 回路结束、`indirectLight *= diffuseGILodWeight` **之前**）
// ---------------------------------------------------------------------------
//   radiance = indirectLight / brdfWeight
//   · 位置/法线取**主命中点**（hitPos / normal = 相机可见面）—— 这比"第一个 GI 顶点"
//     更贴合 query：将来 query 就发生在主命中点上，缓存体素正好在同一批位置上。
//   · 为什么除以 brdfWeight：`indirectLight` 是沿路径累加、每一步都乘着 throughput 的
//     和，而 SHARC 体素存的是**该点的入射辐射度**（查询时由调用方再乘 BSDF）。回路
//     只用了第一个顶点的 throughput（`brdfWeight`）作为起点，所以除以它就把"第一个
//     顶点之后的 BSDF 链"去掉了 —— 后续每一步都带着同一个因子，除法在数学上抵消。
//   · ⚠ 为什么必须挂在 `*= diffuseGILodWeight` 之前：那一步是**渲染器自己的远场 LOD
//     折扣**（远处 GI 压到 0.03125），是显示侧的近似，不该污染缓存里的物理量。
//     同理 `litColor` 里那一串 `* 1.8 * rtaoFactor * ...` 也都在挂点之后。
//   · ⚠ 标度待标定（5b-2 第一件事）：渲染器最终用 `indirectLight * 1.8 * ...`，所以
//     "物理入射辐射度"与这里的比值未必是 1。5b-1 不接 query，标度不影响任何像素；
//     接上之后要拿"缓存值 vs 实追值"比一次再定。
//
// 采样：每帧每个 5×5 像素块只让**一个**像素参与更新（≈4%），块内偏移按帧轮转
// ⇒ 多帧覆盖整屏，且同一像素不会每帧都更新。位置随时间变化即可，不需要额外抖动。
// ============================================================================
// 每帧每个 SHARC_UPDATE_BLOCK × SHARC_UPDATE_BLOCK 的像素块里选**一个**像素参与更新。
//   5 ⇒ 4%（SDK 建议值）      2 ⇒ 25%（体素变细后需要更快的填充速度）
//
// 2026-10-11：从 5 改成 2。因为 voxelSize = 相机距离 / sceneScale（见 HashGridCommon.h
// 的 HashGridGetVoxelSize），把 sceneScale 调大 ⇒ 体素更细 ⇒ 每个体素要攒到
// SHARC_SAMPLE_NUM_THRESHOLD 个样本就更难。而更新是"挂在渲染本来就要算的 GI 上"的
// （零额外射线），提高比例几乎只多花哈希插入与原子累加的钱。
// 2026-10-28：2 -> 4（覆盖率 25% -> 6.25%）。成本 ∝ 1/BLOCK²，实测 2 时 sharcup 5.54ms。
// 2026-10-28（按性能收益对齐 Remix）：4 -> 5。Remix Ultra 预设的 downscaleFactor=5
// （rtx_spatially_hashed_radiance_cache.h:77），即 1/25 = 4% 覆盖率；原来 1/16 = 6.25%，
// 1080p 下 129,600 条 update 路径/帧，比 Remix Ultra 的 82,944 多付 56%，且分辨率越高越贵。
// 覆盖率下降的代价由 update 侧关轮盘 + firefly clamp 100× 补（先把方差压下来）。
// 必须与 VulkanCore.cpp 的 sharcUpdateBlock 一致（dispatch 尺寸由宿主按同一个块算）。
#define SHARC_UPDATE_BLOCK 3

// 2026-10-25（对齐 RTX Remix 的 SHaRC 口径）：update pass 改为**块级 dispatch**。
//
// 旧实现：宿主发满渲染分辨率（640x360 = 230,400 线程），本函数让每 5x5 块只有
// 一个像素返回 true，其余 96% 的线程在读完 UBO、算完哈希后立刻 return —— 实测
// sharcup 单独 5.35ms，净亏。
// 新实现：宿主只发 ceil(w/5) x ceil(h/5) 个线程（640x360 -> 128x72 = 9,216），
// 每个线程对应一个块，块内偏移由哈希选出唯一像素。哈希常数与覆盖顺序与旧实现
// 完全相同 ⇒ 缓存填充速度、空间分布逐位不变，只有空跑线程消失。
//
// 为什么不做"直接把 dispatch 缩小、让 shader 按归一化坐标撒点"（参考实现的做法）：
// 本工程 rgen 的射线取自**绑定图像**（imageSize(image)），不是按 DispatchRays
// Dimensions 归一化，缩小 dispatch 只会覆盖屏幕左上角。所以必须显式做
// 块坐标 -> 像素坐标的映射。
// 2026-10-25（对齐 RTX Remix）：update 路径的 firefly clamp。
// 照抄 rtx/shaders/rtx/pass/sharc/sharc_integrator_utilities.slangh:54-81。
// 与参考的差别（必要）：参考只判 INVALID 索引，因为它的 SharcUpdateHit 保证
// 索引有效；本工程在 miss 分支调用时索引可能尚未建立，故再挡一次
// `cacheIndex >= capacity` —— 上一版缺这一条时进世界 6 秒 GPU 挂死。
#ifndef SHARC_FIREFLY_CLAMP_MULTIPLIER
// 2026-10-28：0.0 -> 100.0（对齐 Remix 默认，rtx_spatially_hashed_radiance_cache.h:108）。
// 历史：2026-10-25 首次开启时进世界 6 秒 GPU 挂死，根因是 SharcUpdateHit 之前
// cacheIndices[0] 尚未建立（HASH_GRID_INVALID_CACHE_INDEX）却没被挡；守卫已在下面
// 补了两道（INVALID 索引 + >= capacity），所以现在可以开。
// 成本：每个 update 顶点多一次 SharcGetVoxelData（resolved 读）+ 亮度比较。
// 收益：把"单样本远高于该体素历史均值"的萤火虫按 100× 夹住，缓存方差显著下降 ⇒
// 同样的收敛速度可以用更低的 update 覆盖率达到，这是净性能收益。
// 回退 = -DSHARC_FIREFLY_CLAMP_MULTIPLIER=0（逐位回到旧行为）。
#define SHARC_FIREFLY_CLAMP_MULTIPLIER 100.0
#endif

vec3 sharcClampUpdateRadiance(
    SharcParameters params,
    HashGridIndex cacheIndex,
    vec3 radiance,
    vec3 sampleWeight,
    float multiplier)
{
    if(multiplier <= 0.0 || cacheIndex == HASH_GRID_INVALID_CACHE_INDEX)
    {
        return radiance;
    }

    if(uint(cacheIndex) >= params.hashGridData.capacity)
    {
        return radiance;
    }

    SharcVoxelData cell = SharcGetVoxelData(params.resolvedBuffer, cacheIndex);
    if(cell.accumulatedSampleNum <= SHARC_SAMPLE_NUM_THRESHOLD)
    {
        return radiance;
    }

    float meanLuminance = SharcRadianceLuma(cell.accumulatedRadiance);
    if(meanLuminance <= 1e-6)
    {
        return radiance;
    }

    float sampleLuminance = SharcLuma(radiance * sampleWeight);
    float maxLuminance = meanLuminance * multiplier;
    if(sampleLuminance > maxLuminance)
    {
        radiance *= maxLuminance / sampleLuminance;
    }

    return radiance;
}

ivec2 sharcUpdateBlockOffset(const ivec2 sharcBlock)
{
    const uint sharcBlockArea =
        uint(SHARC_UPDATE_BLOCK) * uint(SHARC_UPDATE_BLOCK);

    uint sharcHash = uint(sharcBlock.x) * 73856093u ^
        uint(sharcBlock.y) * 19349663u ^
        cam.frameCount * 83492791u;
    sharcHash ^= sharcHash >> 13u;
    sharcHash *= 0x5bd1e995u;
    sharcHash ^= sharcHash >> 15u;

    const uint sharcIndex = sharcHash % sharcBlockArea;

    return ivec2(
        int(sharcIndex % uint(SHARC_UPDATE_BLOCK)),
        int(sharcIndex / uint(SHARC_UPDATE_BLOCK)));
}

// 真实渲染尺寸。SHARC_UPDATE 的 dispatch 是块级（远小于屏幕），
// 所以 update 变体里不能拿 gl_LaunchSizeEXT 做屏幕归一化。
ivec2 rtLaunchSize()
{
#if SHARC_UPDATE
    return imageSize(image);
#else
    return ivec2(gl_LaunchSizeEXT.xy);
#endif
}

// The natural Gerstner band set and the persistent interaction field are shared
// with rt_test.rchit through this include.  The analytic receiver caustics
// below read the same field, which is what keeps the caustic pattern locked to
// the visible water normal.
#include "water_wave_field.glsl"

// Stained-glass filter model shared with rt_restir_final.rgen: dye
// saturation, tint strengthening, exposure guard and the voxel DDA
// transmission march.  Single source of truth - see that file's header
// for why the per-shader copies were removed.
#include "glass_tint_common.glsl"
// 玻璃电介质（真折射）数学：解析式平板出射点、非偏振 Fresnel、按格 Beer-Lambert。
// 自包含，不依赖本文件里的任何函数（GLSL 单遍编译，故放在所有声明之前）。
#include "glass_dielectric_common.glsl"
// 2026-10-25：物理薄片（Remix thin-walled）滤波，与 glass_dielectric_common 分离
// 以便单独 A/B（-DORION_GLASS_THINWALL_V2=0）。
#include "glass_thinwall_common.glsl"

// =====================================================
// Perf-L10.1 - runtime GPU feature-isolation predicates
//
// See the stage table at the top of the file.  Reading the stage from the UBO
// keeps one compiled module valid for every stage, so the native sweep turns a
// single capture into every differential instead of one rebuild per stage.
//
// Stages 8-10 reduce ray counts rather than switching a path off, so the cost of
// the second GI bounce, of full near-field RTAO, and of two-sample soft shadows
// can each be measured as a partial delta.
// =====================================================

uint perfL10Stage()
{
    // 2026-10-07：级回到 UBO，但走**独立 lane**（CameraUBO.perfAblationStage.x）
    // 而不是旧的 perfPrimary.x —— 后者现在是用户「RTAO 近距采样」(0-4)，共用会
    // 让正常档直接选中某个剥离级。主机侧 ORION_PERF_ABLATION 未开时恒写 0，
    // 于是本函数恒返回 0 = base = 正常档，逐位等价于"扫级未接"的旧行为。
    // 上限 16：14 = "强制关 GI 轮盘"（2026-10-07 轮盘改成默认开后补的级）；
    //          15 = "间接/反射命中免 POM"（2026-10-12 补，rchit 侧读取同一个档位）；
    //          16 = "关掉体素 DDA 遍历"（2026-10-13 补，见 perfL10DisableVoxelDda）。
    // 2026-10-30：上限从 16 放宽到 31。28/29/30 是「无材质 + 关掉某类次级射线」
    // 的组合臂；31 是 OMM 4 态对照组。**加档必须同步这里**，否则新档会被静默折成
    // 上限值（本坑今天已经踩过一次：31 被折成 30 = noMatNoGi，量出来的是错的臂）。
    return clamp(cam.perfAblationStage.x, 0u, 33u);
}

bool perfL10DisableRtao()
{
    return perfL10Stage() == 1u ||
           perfL10Stage() == 4u ||
           perfL10Stage() == 28u;
}

bool perfL10DisableGlossy()
{
    return perfL10Stage() == 2u ||
           perfL10Stage() == 4u ||
           perfL10Stage() == 28u ||
           perfL10Stage() == 29u;
}

bool perfL10DisableDiffuseGi()
{
    return perfL10Stage() == 3u ||
           perfL10Stage() == 4u ||
           perfL10Stage() == 28u ||
           perfL10Stage() == 30u;
}

bool perfL10DisableG2bLocalGuide()
{
    return perfL10Stage() == 5u ||
           perfL10Stage() == 7u;
}

bool perfL10DisableLocalEmitterHitScan()
{
    return perfL10Stage() == 6u ||
           perfL10Stage() == 7u;
}

// =====================================================
// Stage 16（2026-10-13）：**关掉体素 DDA 遍历**。
//
// 这是"优化 DDA 这一大块"的前置口径。在此之前 rt 相位那十几毫秒里没有任何一项
// 能归因到体素遍历：六份同源 DDA（本文件 2195/3297/2065 + glass_tint_common.glsl:359
// + rt_vpt_irradiance.comp:352/506）全部混在 PERF_L10_GPU_B_RT 这一格里。
// 而这个仓库历史上已经因为"空 ablation 臂"得出过两次完全错误的结论
// （stage 6 noEmitterScan、stage 5/7 的 G2b 两臂都曾长期指向错的路径），
// 所以这一块必须**先有价格再改算法**。
//
// 语义：等同"遍历当空气" ——
//   · vptVoxelPathBlocked()         → 恒 false（棱缝门不再判遮挡）
//   · evaluateVPTLocalSecondaryBounce() → 恒 vec3(0)（本地光二级弹射归零）
// 只用于量价格，观感会穿墙。
// =====================================================
// =====================================================
// 2026-10-24 射线计数（Perf-L10.3 仪器的缺失半边）
//
// binding 46 在宿主侧早就建好、每帧清零回读（VulkanCore.cpp:22037），但一直没有
// 着色器写入 ⇒ instrumentedPixels 恒 0 ⇒ [PERF L10 RAY] 从不出现。
//
// 只在 stage 15（原空档 spare15）写：生产档（stage 0）里 perfRayStatAdd 的第一
// 个分支就返回，零成本。采集用 ORION_PERF_ABLATION=pin:15。
//
// 下标与 C++ PerfL10RayStatIndex 严格同序（VulkanCore.cpp:10198）。
// =====================================================
layout(binding = 46) buffer PerfL10RayStatsBuf
{
    // 2026-10-28: 12 -> 15，与 VulkanCore.cpp 的 PERF_L10_RAY_STAT_COUNT 同步。
    // [12] 本地光可见性 / [13] 太阳软影 / [14] 光泽反射
    uint perfRayStatCount[15];
};

bool perfRayStatsOn()
{
    return perfL10Stage() == 15u;
}

void perfRayStatAdd(uint index, uint value)
{
    if(perfRayStatsOn())
    {
        atomicAdd(perfRayStatCount[index], value);
    }
}

bool perfL10DisableVoxelDda()
{
    return perfL10Stage() == 16u;
}

// Stage 8: cap the diffuse-GI path at one bounce, so the difference against the
// baseline window is the cost of the second bounce alone.  In normal play
// (stage 0) the value comes from the user "GI 跳数" setting (perfPrimary.z).
// 2026-10-28 修正：下面这段 2026-10-25 的判断**是错的**，它导致过一次误判
//（据此断言用户设的 4 跳不生效）。`perfPrimary.z` 一直有写入方：
//   Java 的 giBounces → JNI（VulkanCore.cpp:57398 的 g_perfGiBounces.store）
//   → 每帧 ubo->perfGiBounces（:60100），而 C++ 结构体里
//   perfAoNearSamples / perfAoMidSamples / perfGiBounces / perfSunShadowSamples
//   这四连正好就是 GLSL `uvec4 perfPrimary` 的 x/y/z/w。
// 实测回执：[PERF LANE] giBounces=4 aoNear=1 aoMid=1 sunShadow=1 … 证明用户设置送达。
// 因此 GI_BOUNCE_CAP_DEFAULT 只是 perfPrimary.z == 0 时的兜底；
// 它的默认值 2 **不**代表实际跑 2 跳。改跳数请走设置项，不要改这个宏。
#ifndef GI_BOUNCE_CAP_DEFAULT
#define GI_BOUNCE_CAP_DEFAULT 2
#endif

int perfL10GiBounceCap()
{
    if(perfL10Stage() == 8u)
    {
        return 1;
    }
    // 2026-10-12：上限 2 → 4。SHaRC 的收益来自截断更深的弹射（查询从第二跳起
    // 生效），2 跳时没有可截断的深度 ⇒ 实测 A/B 打平（arm A 21.49ms vs arm B
    // 21.49ms）。参考样本的 UI 对跳数不设上限（PathtracerUi 的 spp/bounce 都是
    // 滑条），这里按本工程步进给到 4。
    const int perfGiFromUbo = int(cam.perfPrimary.z);

    return perfGiFromUbo > 0
        ? min(perfGiFromUbo, 4)
        : GI_BOUNCE_CAP_DEFAULT;
}

// Stage 9: cap near-field RTAO at two rays instead of four.
int perfL10AoSampleCap()
{
    return perfL10Stage() == 9u
        ? 2
        : 4;
}

// Stage 10: cap soft-sun-shadow sampling at one ray instead of two.  In normal
// play (stage 0) the value comes from the user "太阳阴影采样" setting
// (perfPrimary.w, 1 or 2).
int perfL10ShadowSampleCap()
{
    if(perfL10Stage() == 10u)
    {
        return 1;
    }
    return clamp(int(cam.perfPrimary.w), 1, 2);
}

// GI 循环的俄罗斯轮盘。它现在是**生产开关**（CameraUBO.rtSampleParams.y，
// 见 VulkanCore 的 g_giRoulette），而不再只是诊断级：
//   · stage 11 = 强制开（用来复测"关 → 开"的收益，2026-10-07 实测 −5.9ms(rt)）
//   · stage 14 = 强制关（默认改成开后补的，用来复测"开 → 关"的代价）
//   · 其余（含正常档 0）= 跟用户开关
// 仍然是运行期谓词而非 #define：基线模块执行同一个分支后直接落穿，所以一份
// 编译产物仍能服务所有级。
bool perfL10EnableGiRoulette()
{
    const uint stage = perfL10Stage();
    if(stage == 11u)
    {
        return true;
    }
    if(stage == 14u)
    {
        return false;
    }
    return cam.rtSampleParams.y > 0.5;
}

// ============================================================================
// 2026-10-28：俄罗斯轮盘在**变体级**的闸门（按性能收益对齐 Remix）
//
// 参考：_ref/dxvk-remix/src/dxvk/rtx_render/rtx_spatially_hashed_radiance_cache.cpp:128-129
//        sharcArgs.updateAllowRussianRoulette = false;   // "disabling russian roulette to match NRC"
//       _ref/dxvk-remix/src/dxvk/shaders/rtx/algorithm/path_state.slangh:503-508
//        if (isSharcUpdate) useRussianRoulette = useRussianRoulette && cb.sharcArgs.updateAllowRussianRoulette;
//
// 为什么 update 变体必须关：SHaRC 的 update 把"本段的 throughput"乘进每个已记录顶点的
// sampleWeights（SharcCommon.h:716-722 的 SharcSetThroughput）。轮盘一旦终止，路径按 1/p
// 放大 throughput、并以 (1-p) 的概率整条消失 ⇒ 写进缓存的样本方差被放大 p 倍量级，而缓存
// 只有 10 帧累积窗口（sharc_ubo.glsl:130）去摊平它。方差上去后要维持同样观感只能提高
// update 覆盖率，等于**白付 update 成本**。渲染侧不受影响（它本来就要靠轮盘省钱）。
//
// 渲染变体逐位不变：只有 SHARC_UPDATE 这个翻译单元返回 false。
// ============================================================================
bool giRouletteEnabledForVariant()
{
#if SHARC_UPDATE
    return false;
#else
    return perfL10EnableGiRoulette();
#endif
}

// 2026-10-07：太阳透射 march 的步数改成**按距离自适应**。
//
// 实测（stage 12 = 全局 6 步 → 1 步）省 4.0ms(rt) / 6.0ms(整帧)，但那是拿全局
// 精度换的。这个 march 是沿太阳方向穿水/玻璃累积吸收与染色，只对**相机附近的**
// 着色点有意义 —— 远距水体的细节本来就被体积雾与降噪吃掉。
//   · stage 12 = 诊断级，强制 1 步（保留复测能力）
//   · 正常档 = 着色点到相机距离 > cam.rtSampleParams.z 时 1 步、否则 6 步
//   · 该 lane = 0 ⇒ 关 = 固定 6 步 = 旧档逐位不变
//
// 2026-10-15 降本（水路径成本账）：近场 6→3。这个 march 有三处调用（水底入口
// 可见性 / 水面 GGX / 焦散），每处省 3 次遍历 ⇒ 水像素最多省 9 次。2 步会在
// RT+DLSS 下让透射太阳亮带随波面逐帧跳动，3 是积分误差与步数的折中。
// 回退 = WATER_SUN_MARCH_STEPS 改回 6（远场 1 步与诊断 stage12 不变）。
#ifndef WATER_SUN_MARCH_STEPS
#define WATER_SUN_MARCH_STEPS 3
#endif
int perfL10MarchSteps(vec3 worldPos)
{
    const bool diagnosticOneStep = perfL10Stage() == 12u;
    const float farDistance = cam.rtSampleParams.z;
    if(diagnosticOneStep)
    {
        return 1;
    }
    if(farDistance <= 0.0)
    {
        return WATER_SUN_MARCH_STEPS;
    }
    return distance(worldPos, cam.viewInverse[3].xyz) > farDistance
        ? 1 : WATER_SUN_MARCH_STEPS;
}

// Stage 13: halve every distance-LOD threshold.  The tier chain was measured
// never to engage, so this stage answers whether it has any headroom before we
// spend effort on thresholds or on the distance signal itself.
float perfL10TierScale()
{
    return perfL10Stage() == 13u
        ? 0.5
        : 1.0;
}

// =====================================================
// 2026-10-24 GI 光线距离截断（运行期档位）
//
// 车道：CameraUBO.historyPadding0（宿主恒写 0、全仓无读者；按 float 位型解释）。
//   0     = 不截断（默认，与本改动前逐位相同）
//   > 0   = GI 射线的 tMax 上限（格）
//
// 为什么需要：GI 是 rt 段最大一项（noGi 实测 −5.47ms / rt 11.58ms = 47%），
// 而在 giBounces=1 / roulette=1 / rtSpp=1 下所有细分旋钮都测不出收益
// （stage 8/11/12/13/14 全在 ±0.15ms 内）⇒ 只能减每条射线的长度。
//
// 语义代价：被截断的射线按未命中处理，GI 回路退回天空项（albedo*0.6），
// 远处间接光会变淡变平。用 A/B 权衡，别在生产档里凭感觉定值。
// =====================================================
float perfGiTraceMaxDistance(float baseMax)
{
    const float limit =
        uintBitsToFloat(cam.historyPadding0);

    return limit > 0.0 ? min(baseMax, limit) : baseMax;
}

// =====================================================
// 2026-10-24 项 3：次级射线背面剔除
//
// 只给**辐射类**次级射线（反射 / 透射 / 漫反射 GI）加上
// gl_RayFlagsCullBackFacingTrianglesEXT；可见性类射线
// （TerminateOnFirstHit：AO / 局部光遮挡 / 阴影 / 雨探针）保持双面不变。
//
// 为什么这个分段是安全的：
//   · ray flag 只是"允许"剔除，真正生效取决于实例的
//     VK_GEOMETRY_INSTANCE_TRIANGLE_FACING_CULL_DISABLE。宿主侧**只有**
//     SECTION_AS_CLASS_OMM 桶摘掉了 DISABLE（见 VulkanCore.cpp 的
//     instance.flags），不透明 / 水 / 玻璃 / 实体 / 粒子桶全部保留
//     ⇒ 本条只可能影响 cutout 几何。
//   · 原版 cutout 层本来就是单面 authored、cross 模型正反两份共面 quad
//     （见主射线那里的长注释），任何方向都有一份正面朝向来射
//     ⇒ 剔背面不会丢内容。
//   · 可见性射线必须保持双面：太阳方向的可见性取正反两份的并集，用来填补
//     草丛底部影子的漏光缝隙（宿主侧 instance.flags 那段说明）。
// =====================================================
// 2026-10-30 方案 A：辐射类次级射线强制 OMM 2 态近似。
//
// 依据 NVIDIA《Path Tracing Optimizations in Indiana Jones》(2025-05-15)：
// 间接光射线用 gl_RayFlagsForceOpacityMicromap2StateEXT，让 RTCore 直接按
// 2 态（不透明 / 透明）回答，**完全避免 shader 内 alpha 测试**；阴影射线必须
// 保持 4 态保守，否则漏光 —— 本常量不用于可见性射线，所以那条约束自动满足。
//
// 现状：OMM 已建（[RT MEM] omm=322 ommMB=76.3），但 4 态的 unknown 态仍会调
// rt_test.rahit 的 alpha 测试，而 anyhit 会打断硬件求交搜索（NVIDIA
// 《Creating Optimal Meshes for Ray Tracing》：成本 ∝ 光线穿过的 alpha 层数）。
//
// 回退：删掉第三项即回到 4 态。
const uint SECONDARY_TRAVERSE_FLAGS_4STATE =
    gl_RayFlagsNoneEXT |
    gl_RayFlagsCullBackFacingTrianglesEXT;

const uint SECONDARY_TRAVERSE_FLAGS_2STATE =
    SECONDARY_TRAVERSE_FLAGS_4STATE |
    gl_RayFlagsForceOpacityMicromap2StateEXT;

// 2026-10-30 方案 A/B：**默认 4 态**（= 改动前行为）。
//
// 曾经默认 2 态（NVIDIA Indiana Jones 间接光做法），但同局 A/B 实测收益 **0.00**
// （base 15.09 vs 4 态 15.09，56 窗口），而它对次级射线的 alpha 判定有实际影响：
// 把 2 态与次级 mip 一起关掉后室内明显变暗，说明它会改变 GI/反射的透光量。
// 零收益 + 有副作用 ⇒ 默认回退到 4 态。
//
// 保留两个常量与函数壳，因为档 31 仍是“强制 4 态”的对照臂，将来换硬件/驱动可复测。
uint secondaryTraverseFlags()
{
    return SECONDARY_TRAVERSE_FLAGS_4STATE;
}

// Binding 34 (the old 256x256 wavefront-area caustic map) is deliberately no
// longer declared here.  Water caustics are analytic now; see
// evaluatePrimaryWaterReceiverCaustics below.  That map was anchored to a
// 32-block window centred on the player and faded at its own border, which is
// exactly what made the caustic pattern read as a texture glued to the camera.
// The native side still owns the pass and its descriptor; it is never
// dispatched (kWATER_CAUSTIC_PASS_ENABLED = false), so it costs nothing.

// Static Tyndall 3D fields uploaded once by VulkanCore. They are not tied to
// the Minecraft atlas and therefore remain valid across resource-pack reloads.
layout(binding = 38, set = 0) uniform sampler3D cloudShapeNoise;
layout(binding = 39, set = 0) uniform sampler3D cloudCurlNoise;

// =====================================================
// Distant Horizons far field
//
// DH renders its LODs through renderpearl's Vulkan backend on the *same*
// VkDevice as this pass, so these are ordinary same-device handles (no external
// memory).  Two conventions come from that backend and are not negotiable:
//
//  * renderpearl creates every texture with initialLayout=UNDEFINED and
//    immediately barriers it to GENERAL, keeps no per-texture layout state and
//    never transitions it again -- render passes attach to GENERAL and
//    descriptor writes declare GENERAL.  So the host binds these with
//    imageLayout = VK_IMAGE_LAYOUT_GENERAL, *not*
//    SHADER_READ_ONLY_OPTIMAL; a mismatch here is undefined behaviour, not a
//    validation warning.
//  * The images are full window resolution (2122x1129 at 1080p+UI scale), not
//    render resolution, so they must be sampled with plain normalised UV.
//
// `dhFarColor` is DH's already-shaded LOD image (RGBA8_UNORM); `dhFarDepth` is
// its depth buffer, reverse-Z with a ZERO_TO_POS_ONE range -- the same
// convention this pipeline uses, so "1.0 = nothing" holds for both.
//
// When DH is absent the host leaves dhFarFieldParams[0] at 0 and parks the
// block-atlas view in these two bindings (an unwritten descriptor is undefined
// behaviour, and a legal-but-meaningless sample is cheaper than that).  Every
// read below is therefore gated on the flag, never on the sample.
// =====================================================
layout(binding = 47, set = 0) uniform sampler2D dhFarColor;
layout(binding = 48, set = 0) uniform sampler2D dhFarDepth;

// =====================================================
// 天空散射纹理（binding 42，2026-10-05 起 rgen 也采样）
//
// 与 rt_test.rmiss / sky_atmosphere.comp 共用同一张 equirect 预计算（描述符集
// 是全管线共享的，miss 早已绑定 42/43，rgen 补声明零描述符改动）。用途：
// 低 Fresnel 玻璃反射的解析天空（见 tracePrimaryGenericTransparentRadiance
// 的 GI_GLASS_ANALYTIC_REFLECTION）——该路径替代的正是那条 miss 天空射线。
// directionToEquirect 与 rt_test.rmiss 的同名函数逐字一致（投影必须同源，
// 否则反射天空与直视天空对不上）。
// =====================================================
layout(binding = 42, set = 0) uniform sampler2D skyScatteringTex;

vec2 directionToEquirect(vec3 dir)
{
    const float TWO_PI = 6.28318530718;
    // Must invert sky_atmosphere.comp directionForPixel exactly: that pass
    // writes azimuth = u * 2π from the +x axis toward +z.  A constant 0.5
    // offset here half-rotates the sky and mirrors the sun glow.
    float u = fract(atan(dir.z, dir.x) / TWO_PI);
    float v = asin(clamp(dir.y, -1.0, 1.0)) / 3.14159265359 + 0.5;
    return vec2(u, v);
}

// =====================================================
// 远场太阳阴影图（2026-10-01）
//
// 1024² / extent 由 CameraUBO 的 sunShadowFarParams 下发，由 rt_sun_shadow_far.comp
// 每帧在 RT 之前写好。近场那张 256² 图是给体积光/雾的，本文件不声明它，所以定义
// SUN_SHADOW_NO_NEAR_MAP 让 sun_shadow.glsl 跳过那一段（否则 undeclared
// identifier sunShadowMap）。
//
// ⚠ 2026-10-01：本文件**当前不采样这张图**。原路线 A 让它接管远场直射阴影，
//   取证后已撤回（原因见下方"远场档标记"处的大段说明：该图的深度比较对表面
//   采样点恒判全遮挡，会把远场 LOD 整片压黑）。保留 binding / 宏 / include 只是
//   为了让"改好生产者后重新启用"无需再动描述符集布局；声明未被使用不影响编译。
//
// 未启用时（设备不支持 ray query / 环境变量 ORION_SUNSHADOW_FAR=0）host
// 会把 sunShadowFarParams.w 置 0 并往本 binding 绑图集占位。
// =====================================================
layout(binding = 58, set = 0) uniform sampler2D sunShadowMapFar;

// =====================================================
// 2026-10-19 折射焦散图—— binding 69
//
// 宿主 30 Hz 光栅化：256² 网格 × 3×3 实例 × 3 档 IOR（1.3315/1.3335/1.3365）
// 把折射到 1 格深接收面的波前面积比写进 1024² RGBA16F（带 mip）。
// RGB = 三档 IOR 的密度；平坦水面恰为 1，聚焦 = >1。
//
// 安全阀：CameraUBO.waterFftParams2.w（宿主 populateWaterFftParams 写）
//   0 ⇒ 模块未创建 ⇒ **绝不采样**本 binding；1 ⇒ 正常采样。
// 同时仍要求 cam.waterFftParams.y > 0（「海浪」总开关，同 binding 59）。
// =====================================================
layout(binding = 69, set = 0) uniform sampler2D waterCausticMap;

// =====================================================
// 2026-10-19 反射焦散图（天花板/悬垂上的"波光"）—— binding 70
//
// 与 binding 69 同一张 1024²×11 mip 图的**数组层 1**：宿主用同一套 256² 网格
// ×3×3 实例，把 reflect(-sun, n) 投到水面之上 +4 格的参考接收面，片元仍用
// 源面积比写 R 通道（镜面反射无 IOR 色散）。
//
// 消费端：traceWaterReflectedSun 在"水面可见太阳"判定之后用本图调制原有的
// 反射辐照度 —— 平水 = 1（不改亮度），聚焦 = >1，散焦 = <1。
// 安全阀同 binding 69：waterFftParams2.w > 0.5 才采样。
// =====================================================
layout(binding = 70, set = 0) uniform sampler2D waterReflectCausticMap;

// 正交基 / 投影 / 查询与生产者共用同一份，所以"写进去的位置"与"查出来的位置"
// 结构上不可能对不上。消费者半边 + 远场转发档（sunShadowFarVisibility）。
#define SUN_SHADOW_CONSUMER 1
#define SUN_SHADOW_NO_NEAR_MAP 1
#define SUN_SHADOW_FAR_MAP 1
#include "sun_shadow.glsl"

// =====================================================
// RT Local Lights - L3 GPU probe input
// =====================================================

struct LocalLightGPU
{
    vec4 worldPosEmission;
    uvec4 meta;
};

layout(std430, binding = 17, set = 0) readonly buffer LocalLightBuffer
{
    uvec4 header;
    LocalLightGPU lights[];
} localLightBuffer;


// =====================================================
// LL-P2.1 - Binding 18 Local-Light spatial grid
//
// C++ payload (std430 words):
//   [0..3]                     header
//   [4..4 + hashCapacity*8)    8-word hash slots
//   remaining words             packed Binding-17 light indices
//
// A light has a maximum 30-block range while a grid cell is 64 blocks.
// At runtime we visit the receiver cell plus only those face/edge/corner
// neighbors whose shared boundary is within 30 blocks. That is 1 cell in
// the interior and at most 8 cells at a grid corner.
// =====================================================
layout(std430, binding = 18, set = 0) readonly buffer LocalLightGridBuffer
{
    uint words[];
} localLightGridBuffer;


// =====================================================
// VPT-3.2B Section voxel directional irradiance cache
//
// Binding 22 is a sparse Section->page table. Binding 23 holds the
// 16^3 source voxels followed by six 9^3 HDR directional probe fields
// per page. The compute pass updates changed pages only; RayGen samples
// eight nearby probes and chooses their directional response by normal.
// =====================================================
layout(std430, binding = 22, set = 0) readonly buffer VLIPageTableBuffer
{
    uint words[];
} vliPageTableBuffer;

layout(std430, binding = 23, set = 0) readonly buffer VLIPagesBuffer
{
    uint words[];
} vliPagesBuffer;

// VPT-3.3A.1 legacy secondary directional probe storage.  VPT-3.3B.1 no
// longer reads it on the primary path; it remains bound only to preserve the
// established descriptor layout while the correct surface path is verified.
layout(std430, binding = 24, set = 0) readonly buffer VLISecondaryPagesBuffer
{
    uint words[];
} vliSecondaryPagesBuffer;

// VPT-3.1 authoritative exact emitter index.  Every non-zero emitter in a
// source Section is represented once as a packed uint; D.7 samples it through
// the compact nearby source-Section directory below.
layout(std430, binding = 28, set = 0) readonly buffer VPTEmitterIndexPagesBuffer
{
    uint words[];
} vptEmitterIndexPagesBuffer;

// VPT-3.3C.1: eight bounded candidate emitters per receiver Section.  RayGen
// ranks them at the real hardware-RT hit and traces only the best four.
layout(std430, binding = 29, set = 0) readonly buffer VPTCandidatePagesBuffer
{
    uvec4 entries[];
} vptCandidatePagesBuffer;

// VPT-3.4: entry zero stores the source-section count and a revision for this
// receiver's Alias distribution. Remaining entries are a receiver-specific
// Alias table (power x Section-bound-distance) with an explicit selected-entry
// PDF for unbiased single-frame RIS.
struct VPTSourceDirectoryEntry {
    uint pageIndex;
    uint emitterCountAndOffset;
    uint aliasThresholdQ16;
    uint aliasIndex;
    float selectionProbability;
};
layout(std430, binding = 31, set = 0) readonly buffer VPTSourceDirectoryPagesBuffer
{
    VPTSourceDirectoryEntry entries[];
} vptSourceDirectoryPagesBuffer;

// =====================================================
// 2026-10-07 动态光源（移动光源）—— native binding 61
// =====================================================
// 与 binding 17/18 那份**静态方块光源**表无关：那四个消费函数在本文件里零调用点，
// 而且它装的是方块光、与 VLI 面缓存（binding 30）会双重计数。这里是**独立的一条
// 每帧小表**，只装"手持发光物 + 自带发光的实体"，作为与方块发射体**不相交**的
// 另一个光源集被采样（采样端见 evaluateDynamicLightRISDirect）。
//
// 布局（std430，与 native 侧 DynamicLightUpload 逐字段对齐）：
//   header = (条数, 强度 float 位型(主机写 intensity+1.0), 版本号, 保留)
//   记录 32B = vec4 worldPosEmission (xyz=世界坐标, w=发射等级 0..15)
//              uvec4 meta (x = typeCode（仅当 y == 0 时作兜底，走 vliDecodeEmitterColor）
//                          y = 任意 RGB，8/8/8 打包（0 = 没给颜色）
//                          z/w 保留 —— 加颜色只用了本来就空的一个 uint，native 侧
//                          一行都不用改，那几个 pad 字段就是为这个留的)
// **条数放在头部**而不是 CameraUBO：着色器本来就要读这条 buffer，这样连一个
// UBO 车道都不用加，也就没有"在中间插字段把后面整条链推远"的风险。
// 空槽 / 已离开范围的条目用 emission = 0 表示，采样端跳过。
// =====================================================
struct DynamicLightRecord
{
    vec4 worldPosEmission;
    uvec4 meta;
};

layout(std430, binding = 61, set = 0) readonly buffer DynamicLightBuffer
{
    uvec4 header;
    DynamicLightRecord lights[];
} dynamicLights;

// One Alias word per exact emitter-index record. low16=cutoff, high16=alias.
layout(std430, binding = 32, set = 0) readonly buffer VPTEmitterAliasPagesBuffer
{
    uint words[];
} vptEmitterAliasPagesBuffer;

// VPT-3.3B.1: one direct irradiance sample for every exact voxel face.
// Unlike the 9^3 probe fields this buffer is addressed from the primary
// hardware-RT hit itself and is never trilinearly interpolated through air.
layout(std430, binding = 30, set = 0) readonly buffer VPTSurfaceFaceBuffer
{
    uint words[];
} vptSurfaceFaceBuffer;

// VPT-2.2 primary-DDA temporal history.  Bindings 26/27 hold the classic
// VPT direct-light ping-pong history.
// Layout exactly matches VPTDirectHistoryGPU in VulkanCore.cpp.
struct VPTDirectHistory
{
    vec4 radianceAndSampleCount;
    vec4 hitPositionAndValid;
    vec4 normalAndPadding;
    // 2026-10-26 RTXDI 直接光 WRS reservoir（仅第 4 lane；EMA 路径不读不写，
    // v0/v1/v2 语义与旧版逐位一致）。WRS 布局：
    //   v0 = (selectedSample.xyz, emission*8 + typeCode)
    //   v1 = (W, M, lightRevision, 2.0)  // 2.0 = WRS 标签；EMA 在 v1.w 写 1.0
    //   v2 = (receiverPosition.xyz, valid)
    //   v3 = (receiverNormal.xyz, 0)
    vec4 reservoirNormalAndPadding;
};

layout(std430, binding = 26, set = 0) buffer VPTDirectHistoryBuffer0
{
    VPTDirectHistory entries[];
} vptDirectHistoryBuffer0;

layout(std430, binding = 27, set = 0) buffer VPTDirectHistoryBuffer1
{
    VPTDirectHistory entries[];
} vptDirectHistoryBuffer1;

const float VPT_SCREEN_POSITION_EPSILON = 0.35;
const float VPT_SCREEN_NORMAL_COSINE = 0.92;
const float VPT_SCREEN_MAX_HISTORY = 8.0;

const uint VLI_PAGE_TABLE_CAPACITY = 8192u;
const uint VLI_SOURCE_WORDS = 4096u;
const uint VLI_PROBE_EDGE = 9u;
const uint VLI_PROBE_WORDS = VLI_PROBE_EDGE * VLI_PROBE_EDGE * VLI_PROBE_EDGE;
const uint VPT_DIRECTION_COUNT = 6u;
const uint VPT_DIRECTIONAL_CACHE_WORDS = VPT_DIRECTION_COUNT * VLI_PROBE_WORDS; // 4374 uint
const uint VLI_PAGE_WORDS = VLI_SOURCE_WORDS + VPT_DIRECTIONAL_CACHE_WORDS;
const uint VPT_SURFACE_FACE_WORDS = VLI_SOURCE_WORDS * VPT_DIRECTION_COUNT;
const uint VPT_RELATED_EMITTERS_PER_SECTION = 8u;
const uint VPT_EMITTER_HEADER_WORDS = 4u;
const uint VPT_EMITTER_PAGE_WORDS = VPT_EMITTER_HEADER_WORDS + VLI_SOURCE_WORDS;
const uint VPT_MAX_SECTION_PAGES = 4096u;
const uint VPT_SOURCE_DIRECTORY_MAX_SECTIONS = 125u;
const uint VPT_SOURCE_DIRECTORY_ENTRIES_PER_PAGE =
    1u + VPT_SOURCE_DIRECTORY_MAX_SECTIONS;
// VPT-3.3D.7: two unbiased proposals from all non-empty source Sections in
// the local 5x5x5 neighborhood, then one selected visibility DDA.
const uint VPT_RIS_CANDIDATE_COUNT = 2u;
const uint VPT_PRIMARY_DDA_LIGHTS = 4u;
// Legacy C.4 constants retained only for the paused area-light history path.
const uint VPT_AREA_LIGHT_SAMPLES = 12u;
const uint VPT_AREA_LIGHT_HISTORY_SAMPLES = 96u;
const float VPT_LOCAL_MAX_DISTANCE = 30.0;
const float VPT_LOCAL_RANGE_PER_EMISSION = 2.0;
const float VPT_LOCAL_FADE_START_FRACTION = 0.40;
// 2026-09-30: 虚拟发射体必须留在自己的方块内。原值 2.0 给出 ±1 格的样本散布，
// 而真实发光方块只有 1x1、它正下方那块染色玻璃也只有 1x1。样本落到方块之外后
// 有两个后果：
//   * 接收点→该样本的可见性射线根本不穿那块玻璃，透射率恒为 1（白）⇒ 光斑被
//     这一路未染色的光冲淡，看起来"光从上往下穿过玻璃却不染色"；
//   * 该样本不在发射体体素内 ⇒ 不做入面缩短 ⇒ 它与发射体方块之间没有合法遮挡
//     判定 ⇒ 光源旁边方块接缝处漏光，且漏出的样本数随「本地光最远照明距离」
//     调节而变化。
// 1.0 = 发射体的实际足迹（半径 0.5 格）。采样点随后还会被夹回方块内（见
// evaluateVPTRISDirectLightingSingle），因为斜向射线时切向基斜跨 XZ，±0.5 的
// 偏移仍可能越出方块约 0.2 格。
const float VPT_LOCAL_LIGHT_AREA_SIZE = 1.0;

// =====================================================
// 临时诊断开关：判定本地光染色链路是否真的有数据（定位后删除）
//
// 本地光的玻璃染色与太阳光路是两套完全独立的数据源：
//   太阳   -> 硬件射线命中 -> 顶点 byte27 marker -> C++ applyStainedGlassDyeToRTVertex
//   本地光 -> 体素 DDA      -> voxel word bit24 + RGB555 染料色
//             （由 Java SectionCompilerMixin 写入）
//
// 「一路径一颜色」版诊断的问题：二级弹射对**整个半球**采样，附近任何一条
// 采样光线穿过彩玻都会命中标记 ⇒ 标出来的区域**远大于**光斑本身，因此
// 无法判断光斑究竟由谁主导（上一轮的「红」就是这种误读）。
//
// 这一版改成**能量占比图**：把三个候选本地光项分别写进 RGB 三个通道，
// 每题通道值 = 该项亮度（clamp 到 1）。看光斑的通道占比即可判定主导项：
//
//   R = applyLocalGlassTint           本地光直射（走玻璃过滤）
//   G = evaluateVPTLocalSecondaryBounce  本地光二级弹射（走烘焙缓存）
//   B = evaluateVLIEmitterRadianceAtHit  唯一**无玻璃过滤**的假发光
//
// 红 ⇒ 直射主导；绿 ⇒ 二级弹射主导；蓝 ⇒ 无过滤项主导；
// 三通道都暗 ⇒ 三者都不是，白光另有出处。
//
// 必须在所有使用点之前声明：GLSL 单遍编译，后置声明会报未声明标识符。
// =====================================================
// Term readout (2026-09-24): the suspicious patch came back PURE RED, i.e. it is
// the exact baked direct term, which was then found to be missing the 1/pi the
// other consumer of the same buffer applies. Readout is off again.
//
// 2026-09-30 第一轮（已关回）：读出全黑。但那一轮的通道组恰好把两个最可疑项漏掉了，
// 所以"全黑"排除不了它们：
//   R = 面缓存直射（VPT_LOCAL_EXACT_DIRECT_ON_PRIMARY=false(16154) 恒为 0 ⇒ 死通道）
//   G = 二级弹射（localSecondaryLight.y，抽取正确 ⇒ 该项确实为 0）
//   B = 发射体邻接自发光（localEmitterEmission.z，抽取正确 ⇒ 该项确实为 0）
//   ⚠ localDirectLight（经典 0.31 RIS 直射）落在 litColor 里，本表**没有它的通道**；
//     indirectLight（GI 顶点同样叠了一份 evaluateVLIEmitterRadianceAtHit）也没有。
//   ⚠ 而且 evaluateVLIEmitterRadianceAtHit 在表内旧版返回 vec3(0,0,luma)，GI 里那一份
//     被压成只有蓝通道 —— 按 luma 读 GI 会把它读小 13.8 倍。
//
// 2026-09-30 第二轮（本轮，为「无受光面木块视差发光」定位）：三项各占一个通道，
// 表外什么都不留。亮纹落在哪个通道，就是哪一项（太阳不设通道：你说过跟它无关；
// 二级弹射也不设：第一轮抽取正确、实测为 0）：
//   R = localDirectLight      经典 0.31 RIS 本地直射
//   G = localEmitterEmission  主路径"发射体邻接"自发光（命中面**背后**体素的
//                             emission：无可见性射线、无玻璃染色；其 sourceBlock
//                             由浮雕法线的 dominant 轴决定 ⇒ 轴一翻就落到邻块）
//   B = indirectLight         GI（GI 顶点无条件叠了同一项 evaluateVLIEmitterRadianceAtHit，
//                             本项在表内改回原值返回，所以 GI 通道读数是可信的）
//   灰 = payload.emission     地标（材质自发光方块仍可见）
// 用法：-DDBG_LOCAL_TERM_MAP_MACRO=1 编译；配合 -DVPT_LOCAL_GEOMETRIC_COSINE_BOUND=0
// 拿到未经上一轮改动的原始画面。
// 2026-10-01 用本表给「沿墙角/棱的细亮线」定项，读数（跑完已回 0）：
//   **纯红 = localDirectLight（RIS 本地直射，evaluateVPTRISDirectLighting）**
// 与本文件 1917-1940 既有记载的"R = 本项、亮纹与浮雕同周期"完全一致 ⇒ 那条亮线
// 是**浮雕余弦越过几何面地平线**放行的本地直射，不是发射体邻接项、不是面缓存、
// 也不是可见性穿角。修法见同处（VPT_LOCAL_FACE_AXIS_FROM_POSITION）。
// 屏幕含义（沿用本宏原有口径）：
//   R = localDirectLight / G = localEmitterEmission / B = indirectLight / 灰 = emission
#ifndef DBG_LOCAL_TERM_MAP_MACRO
#define DBG_LOCAL_TERM_MAP_MACRO 0
#endif
#if DBG_LOCAL_TERM_MAP_MACRO
const bool DBG_LOCAL_TERM_MAP = true;
#else
const bool DBG_LOCAL_TERM_MAP = false;
#endif

// =====================================================
// Local-light architecture — 2026-09-30 收口
//
// ReSTIR DI 链已整链删除：bindings 19/20 水库、主机侧 rt_restir_final /
// rt_restir_reconstruct 两个 pass、以及 NRD 引导全部移除。本地光只剩经典
// 0.31 RIS：主不透明路径 evaluateVPTRISDirectLighting（发射体索引 + 源目录
// RIS 直射，DDA 可见性 + 玻璃透射），外加体素自发光
// evaluateVLIEmitterRadianceAtHit 与面缓存二级弹射
// evaluateVPTLocalSecondaryBounce。
// 运行期「本地光方案」开关（CameraUBO.localLightModeParams）已废弃移除。
// =====================================================
// 保留以兼容既有构建历史：它守护的「路径纯色标记」已撤除。
const bool DBG_STAINED_GLASS_MARK = false;

// =====================================================
// 判决实验 D（定位后删除）：分清「真凶是未过滤项」还是「走了染色但被裁白」
//
// 前几版诊断都把「有颜色」和「是这条路径」混为一谈：
//   二级弹射对整个半球采样，命中彩玻标记的区域远大于光斑本身；
//   能量占比图能看出谁「亮」，却看不出谁「带颜色」。
//
// 这一版把两件事同时写进同一像素：
//   R = 该项自身的**染料色**（能量归一后，只反映颜色，不反映亮度）
//   G = 该项的**能量**（luma clamp 到 1）
//
// 于是同一次重载就能回答「近段那片白有没有经过彩玻」：
//   R 暗 + G 亮  => 那道白光**没有任何染料**，即未经过彩玻  ⇒ 真凶是无过滤项
//   R 亮 + G 亮  => 经过了彩玻，颜色数据也在      ⇒ 纯粹是能量过高被末端裁白
//
// 编码规则：R 通道 = 染料通道里的**最大者减去最小者**（纯色⇒1，白色⇒0），
// 这样「有没有染料」直接读作 R 的亮度，不受该项整体能量影响。
// =====================================================
// 判决实验 D 的总开关：默认关闭，置 true 时三个本地光项都改画
// 「染料浓度(R) × 能量(G)」。与 DBG_GLASS_DYE_VS_ENERGY_SECONDARY 独立，
// 后者只作用二级弹射，用于把读数收窄到单独一项。
const bool DBG_GLASS_DYE_VS_ENERGY = false;

// =====================================================
// 判决实验 H2（一次定案版）：把「谁贡献了光斑」与「谁带了染色」
// 分成两块，用屏幕**左半边 / 右半边**分别显示，一次重载读完。
//
//   屏幕左半 = 只留 localSecondaryLight（带染色的二级弹射）
//                + 太阳/天空等所有非本地光项 **不变**
//   屏幕右半 = 只留 localEmitterEmission（无过滤自发光）
//                + 太阳/天空等所有非本地光项 **不变**
//
// 判读（把准星对准彩玻后的光斑，看它落在哪半边还亮）：
//   左亮右暗 ⇒ 光斑来自二级弹射（有染色）⇒ 问题在染色/裁切
//   左暗右亮 ⇒ 光斑来自无过滤自发光     ⇒ 问题在这条缺过滤的路径
//   两边都亮 ⇒ 两者都在贡献，需分别压
//   两边都暗 ⇒ 光斑根本不是本地光加进来的
//
// 用片元坐标分屏，不依赖任何数值编码，因此不会被末端 pow/裁剪干扰。
// =====================================================
// 已撤销：该实验证明这两项对「透过彩玻的本地光」无贡献
// （用户报「看着没变化」），因为玻璃后的接收面走的是
// tracePrimaryGenericTransparentRadiance → evaluateVPTRISDirectLightingSingle
// 这条独立分支，与这两项无关。
// Attribution result (2026-09-24 screenshot): the wall-corner blob appears ONLY
// on the half that keeps the baked secondary bounce, so that path owns the
// artifact. Split screen is off again.
const bool DBG_SPLIT_ABLATION = false;

// 判决实验 I：DDA 覆盖率探针（详见 vptTraceGlassTransmissionToEmitter 尾部）。
// true 时该项输出 (穿过的染色玻璃片数, DDA 步数) 而非真实透射率。
// 2026-09-22：该探针三次未显现 → 先关闭，改用阶梯探针定位。
const bool DBG_VPT_DDA_PROBE = false;

// =====================================================
// 判决实验 LADDER（阶梯可达性，2026-09-22 20:11）
// 目的：一次运行定位「玻璃后本地光链路」在哪一层断掉。
//   A = 亮橙 (1,0.5,0)  tracePrimaryGenericTransparentRadiance 入口
//   B = 亮品红(1,0,1)   VPTRIS 调用点
//   C = 亮黄 (1,1,0)    evaluateVPTRISDirectLightingSingle 入口
// 首轮结果：地板光斑区域变纯蓝 → 需改色复验「蓝是探针还是场景」。
// 2026-09-22 20:21 用户澄清：蓝色方块=彩色玻璃本身；白区=出玻璃那段光；
// 症状=本地光直射未染色、仅二次弹射有颜色。阶梯探针完成使命，全部关闭。
const bool DBG_LADDER_A = false;
const bool DBG_LADDER_B = false;
const bool DBG_LADDER_C = false;

// =====================================================
// 判决实验 VLI（2026-09-22 20:42）：定位"天花板白光"的真凶。
// 假设：evaluateVLIEmitterRadianceAtHit 是唯一无玻璃过滤的本地光项；
//       发光方块紧贴天花板 ⇒ 它绕开染色直接把发光块的原始色（白）叠上去。
//   DBG_KILL_VLI_EMITTER = true  ⇒ 该项归零。若天花板白光消失 ⇒ 实锤。
//   DBG_MARK_VLI_EMITTER = true  ⇒ 该项触发处标品红（看覆盖范围）。
// =====================================================
const bool DBG_KILL_VLI_EMITTER = false;
const bool DBG_MARK_VLI_EMITTER = false;

// =====================================================
// 判决实验 BEHIND（2026-09-22 20:50）：玻璃后接收面三项分色。
//   R = directAndEmission     payload.emission + 太阳/环境反射
//   G = localEntityIrradiance 本地光 RIS（已修染色）
//   B = hitAlbedo * ambient   纯 albedo 环境底光（无任何染色）
// 用法：把准星对准天花板白光斑，看它是哪个通道（纯红/绿/蓝 ⇒ 该项主导）。
// 之后可用下面的 KILL 开关单独验证。
// =====================================================
// Build-time switch (see the BEHIND banner at ~11880):
// -DDBG_BEHIND_SPLIT_MACRO=1 paints the three behind-glass receiver terms to
// RGB: R=directAndEmission G=localEntityIrradiance B=ambientTerm.
// ⚠️ 2026-10-01 临时诊断（跑完即回 0）：玻璃后三项分色，用来一次定位"颗粒属于谁"。
//   R = directAndEmission      太阳 + 自发光（无估计量：只有解析光照与阴影射线）
//   G = localEntityIrradiance  本地光 RIS + 8 帧屏幕空间历史（**唯一的估计量**）
//   B = ambientTerm            albedo * ambient（无估计量）
// 判据：把准星对准玻璃里那层均匀颗粒，看它是纯红 / 纯绿 / 纯蓝。
//   · 纯绿 ⇒ 元凶就是那个 8 帧历史估计量 ⇒ 正解是修它的时域累积（长度/键/权重），
//     与降噪器无关 —— 也解释了为什么之前动 RR 的一切都没有效果。
//   · 纯红 ⇒ 在解析太阳/自发光那一支（无估计量）⇒ 查 payload.emission 的取值来源
//     与阴影射线的抖动，而不是采样数。
//   · 纯蓝 ⇒ 环境底光项（无估计量）⇒ 查 ambient 的取值来源。
#ifndef DBG_BEHIND_SPLIT_MACRO
#define DBG_BEHIND_SPLIT_MACRO 0
#endif
const bool DBG_BEHIND_SPLIT = (DBG_BEHIND_SPLIT_MACRO != 0);
const bool DBG_KILL_BEHIND_AMBIENT = false;  // 2026-10-28 临时判决
// 2026-10-28 判决结果：置 true 后橙色玻璃掠射面的绿色颗粒**毫无变化** ⇒
// 该颗粒与 localEntityIrradiance（本地光 RIS + 8 帧屏幕空间历史）无关。
// 本轮为"三项全杀"诊断，临时置 true。
const bool DBG_KILL_BEHIND_LOCAL = false;
const bool DBG_KILL_BEHIND_DIRECT = false;   // 2026-10-28 临时判决

// =====================================================
// 判决实验 GLASSTINT（2026-09-22 21:06）：直接读出摄像面玻璃透射率。
// 假设：玻璃后所有项（payload.emission/太阳/环境/本地光）都被
//       behindRadiance × glassTransmission 统一相乘；若 glassSurface.tint
