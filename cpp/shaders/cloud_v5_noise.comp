#version 460
#extension GL_GOOGLE_include_directive : require


layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(rgba16f, set = 0, binding = 0) uniform writeonly image2D atlasImage;
layout(rgba16f, set = 0, binding = 1) uniform writeonly image3D worleyImage;
layout(rgba16f, set = 0, binding = 2) uniform writeonly image3D baseVolume;
layout(rgba16f, set = 0, binding = 3) uniform writeonly image3D shapeVolume;

layout(push_constant) uniform BakePush
{
    vec4 params;
} pc;
#define V5_NOISE_BAKER 1
#include "cloud_v5_core.glsl"

void main()
{
    ivec3 id = ivec3(gl_GlobalInvocationID);
    const int mode = int(pc.params.x + 0.5);

    if(mode == 0)
    {
        ivec2 size = imageSize(atlasImage);
        if(any(greaterThanEqual(id.xy, size))) return;
        vec2 uv = (vec2(id.xy) + vec2(0.5)) / vec2(size);
        imageStore(atlasImage, id.xy, hpRenderWeather(uv));
        return;
    }
    if(mode == 1)
    {
        ivec3 size = imageSize(worleyImage);
        if(any(greaterThanEqual(id, size))) return;
        vec3 coord = (vec3(id) + vec3(0.5)) / vec3(size);
        imageStore(worleyImage, id, hpRenderDetail(coord));
        return;
    }
    if(mode == 2)
    {
        ivec3 size = imageSize(baseVolume);
        if(any(greaterThanEqual(id, size))) return;
        vec3 coord = (vec3(id) + vec3(0.5)) / vec3(size);
        imageStore(baseVolume, id, hpRenderBase(coord));
        return;
    }
}
