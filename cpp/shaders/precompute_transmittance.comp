#version 460
#extension GL_GOOGLE_include_directive : require
// 2026-09-30 大气重写（方案 A）：takram precompute pass 的 Vulkan compute 适配。
// 原文件：packages/atmosphere/src/shaders/precompute/transmittance.frag（MIT）。
// 适配点：gl_FragCoord → gl_GlobalInvocationID+0.5；MRT/混合 → push constant
// 选择输出变体 + 累加走 imageLoad/add；luminanceFromRadiance = 单位阵
// （散射 LUT 全程存光谱辐亮度，显示端才乘光度系数）。
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
#include "bruneton/definitions.glsl"
#include "bruneton/atmosphere.glsl"
#include "bruneton/common.glsl"
#include "bruneton/precompute.glsl"
layout(push_constant) uniform PC {
    int pcLayer;            // 兼容保留（3D 派发时由 gid.z 取层）
    int pcAdditive;         // 0 = 覆写，1 = 累加
    int pcScatteringOrder;  // 散射阶（2..4）
    int pcOutput;           // 输出变体选择
} pc;

// LUT：transmittance 256×64
// 输出绑定 22：binding 0 是同一张纹理的 COMBINED 采样绑定（其它 pass 读
// 透射用），同名同号会类型冲突 ⇒ 透射永远写不进去（全黑天空的根因）。
layout(rgba32f, set = 0, binding = 22) uniform writeonly image2D outTransmittance;

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= TRANSMITTANCE_TEXTURE_WIDTH ||
        pix.y >= TRANSMITTANCE_TEXTURE_HEIGHT) return;
    vec2 frag = vec2(pix) + 0.5;
#ifdef BRUNETON_STORE_PROBE
    // 链路探针：输出像素坐标花纹（红=x、绿=y）。读回非零 = 派发/绑定/拷贝
    // 链路健康，问题在数学/参数；读回全零 = 派发或绑定断链。
    imageStore(outTransmittance, pix,
        vec4(float(pix.x) / 256.0, float(pix.y) / 64.0, 0.25, 1.0));
#else
    imageStore(outTransmittance, pix,
        vec4(ComputeTransmittanceToTopAtmosphereBoundaryTexture(
            ATMOSPHERE, frag), 1.0));
#endif
}
