#version 460
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
#include "bruneton/definitions.glsl"
#include "bruneton/atmosphere.glsl"
#include "bruneton/common.glsl"
#include "bruneton/precompute.glsl"
layout(push_constant) uniform PC {
    int pcLayer;
    int pcAdditive;
    int pcScatteringOrder;
    int pcOutput;
} pc;
layout(rgba32f, set = 0, binding = 22) uniform writeonly image2D outTransmittance;

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= TRANSMITTANCE_TEXTURE_WIDTH ||
        pix.y >= TRANSMITTANCE_TEXTURE_HEIGHT) return;
    vec2 frag = vec2(pix) + 0.5;
#ifdef BRUNETON_STORE_PROBE
    imageStore(outTransmittance, pix,
        vec4(float(pix.x) / 256.0, float(pix.y) / 64.0, 0.25, 1.0));
#else
    imageStore(outTransmittance, pix,
        vec4(ComputeTransmittanceToTopAtmosphereBoundaryTexture(
            ATMOSPHERE, frag), 1.0));
#endif
}
