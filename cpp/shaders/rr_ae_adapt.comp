#version 460

// RR-7 auto exposure: histogram -> adapted exposure.
//
// Single invocation.  It consumes the histogram the previous frame produced,
// derives a trimmed log-average luminance, converts that into a target
// exposure in log2 space, and blends it into the running value with
// asymmetric rates so the eye-adaptation feel is preserved: darkening after a
// bright flash is fast, brightening out of a dark room is slow.
//
// Keeping the running value in log2 space is what makes the blend perceptually
// linear; blending the linear exposure instead would crawl at the bottom of
// its range and snap at the top.
//
// The pass also clears the histogram, which is why no fill/clear pass is
// needed anywhere else in the frame.
//
// The bin layout is shared with rr_ae_histogram.comp.

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0, set = 0)
buffer AeHistogram
{
    uint bins[256];
};

layout(binding = 1, set = 0)
buffer AeState
{
    // Running exposure in log2.  The display transform applies exp2(this).
    float currentEV;

    // Last frame's measured target, kept for diagnostics.
    float targetEV;

    // Last frame's trimmed average luminance in log2, for diagnostics.
    float avgLogLuma;

    // Pixels that survived the trim, for diagnostics.
    uint sampleCount;

    // Linear radiance that lands exactly on display white after the exposure
    // multiply, i.e. exp2(-currentEV) scaled by the output path's white level.
    // volumetric_cloud_composite.comp rolls the cloud layer off against this so
    // the deck keeps its detail at any exposure instead of clipping to a flat
    // white sheet.  It is a separate lane rather than something the composite
    // could derive itself because the scale depends on which display path is
    // live, which only the host knows.
    float cloudWhite;
};

layout(push_constant) uniform AeParams
{
    float dtSec;

    // log2 of the average luminance the frame should expose to.
    float keyEV;

    float minEV;
    float maxEV;

    // Per-second adaptation rates.  adaptDownRate handles a scene that just
    // got brighter, adaptUpRate a scene that just got darker.
    float adaptUpRate;
    float adaptDownRate;

    // Fraction of the sample mass discarded at each end before averaging, so
    // a few specular pixels or a small black sky do not drag the average.
    float trimLow;
    float trimHigh;

    // 0 = auto exposure switched off in the settings screen.
    int enabled;

    // Linear value the output path renders as its brightest white: 1.0 on the
    // SDR path, where the frame is clipped to that, and a multiple of reference
    // white on the HDR10 path, whose PQ container goes far above it.
    float displayWhiteScale;
};

const float AE_LOG2_MIN = -10.0;
const float AE_LOG2_MAX = 6.0;
const uint AE_BIN_COUNT = 256u;

// Every exit below has to publish this, otherwise the cloud rolloff keeps
// compressing against a stale white level while the exposure it was derived
// from has already moved.
void publishCloudWhite()
{
    cloudWhite = exp2(-currentEV) * displayWhiteScale;
}

void main()
{
    // Switched off: drive the exposure straight back to neutral instead of
    // leaving it frozen wherever it happened to be, so the disabled look is
    // bit-identical to the pre-auto-exposure build.  The histogram is cleared
    // on the way out so a later re-enable starts from a clean accumulator.
    // The histogram pass itself is skipped by the host in this state.
    if(enabled == 0)
    {
        for(uint i = 0u; i < AE_BIN_COUNT; ++i)
        {
            bins[i] = 0u;
        }

        currentEV = 0.0;
        targetEV = 0.0;
        avgLogLuma = 0.0;
        sampleCount = 0u;

        publishCloudWhite();

        return;
    }

    uint total = 0u;

    for(uint i = 0u; i < AE_BIN_COUNT; ++i)
    {
        total += bins[i];
    }

    // Nothing measured yet (first frame, or a frame that reduced to nothing).
    // Hold the running exposure and hand back a clean accumulator.
    if(total == 0u)
    {
        for(uint i = 0u; i < AE_BIN_COUNT; ++i)
        {
            bins[i] = 0u;
        }

        sampleCount = 0u;
        targetEV = currentEV;
        avgLogLuma = 0.0;

        publishCloudWhite();

        return;
    }

    uint lowCut = uint(float(total) * trimLow);
    uint highCut = uint(float(total) * trimHigh);

    uint cum = 0u;
    uint used = 0u;
    float weighted = 0.0;

    for(uint i = 0u; i < AE_BIN_COUNT; ++i)
    {
        uint c = bins[i];
        uint prevCum = cum;

        cum += c;

        // Keep only the bins whose counts fall inside the trimmed window.
        if(cum > lowCut && prevCum < highCut)
        {
            // Weights are normalised by `total` up front so the accumulator
            // stays near the EV range instead of the raw sample count; that
            // keeps float precision independent of resolution.
            float binCenter =
                AE_LOG2_MIN +
                (float(i) + 0.5) *
                    (AE_LOG2_MAX - AE_LOG2_MIN) /
                    float(AE_BIN_COUNT);

            weighted += binCenter * (float(c) / float(total));
            used += c;
        }

        bins[i] = 0u;
    }

    if(used == 0u)
    {
        sampleCount = 0u;
        targetEV = currentEV;

        publishCloudWhite();

        return;
    }

    // weighted holds sum(binCenter * c) / total, so scaling it by total/used
    // turns it into the average over the surviving samples only.
    float avgLogLum = weighted * (float(total) / float(used));

    // keyEV - avgLogLum is the log2 distance between where the frame's average
    // sits and where it should sit, i.e. exactly the exposure to apply.
    float target = clamp(keyEV - avgLogLum, minEV, maxEV);

    float rate =
        target > currentEV
            ? adaptUpRate
            : adaptDownRate;

    float alpha =
        1.0 - exp(-max(dtSec, 0.0) * max(rate, 0.0));

    currentEV = mix(currentEV, target, clamp(alpha, 0.0, 1.0));

    targetEV = target;
    avgLogLuma = avgLogLum;
    sampleCount = used;

    publishCloudWhite();
}
