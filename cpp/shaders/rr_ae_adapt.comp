#version 460


layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0, set = 0)
buffer AeHistogram
{
    uint bins[256];
};

layout(binding = 1, set = 0)
buffer AeState
{
    float currentEV;

    float targetEV;

    float avgLogLuma;

    uint sampleCount;

    float cloudWhite;
};

layout(push_constant) uniform AeParams
{
    float dtSec;

    float keyEV;

    float minEV;
    float maxEV;

    float adaptUpRate;
    float adaptDownRate;

    float trimLow;
    float trimHigh;

    int enabled;

    float displayWhiteScale;
};

const float AE_LOG2_MIN = -10.0;
const float AE_LOG2_MAX = 6.0;
const uint AE_BIN_COUNT = 256u;

// Every exit below has to publish this, otherwise the cloud rolloff keeps
// compressing against a stale white level while the exposure it was derived
// from has already moved.
void publishCloudWhite()
{
    cloudWhite = exp2(-currentEV) * displayWhiteScale;
}

void main()
{
    if(enabled == 0)
    {
        for(uint i = 0u; i < AE_BIN_COUNT; ++i)
        {
            bins[i] = 0u;
        }

        currentEV = 0.0;
        targetEV = 0.0;
        avgLogLuma = 0.0;
        sampleCount = 0u;

        publishCloudWhite();

        return;
    }

    uint total = 0u;

    for(uint i = 0u; i < AE_BIN_COUNT; ++i)
    {
        total += bins[i];
    }

    if(total == 0u)
    {
        for(uint i = 0u; i < AE_BIN_COUNT; ++i)
        {
            bins[i] = 0u;
        }

        sampleCount = 0u;
        targetEV = currentEV;
        avgLogLuma = 0.0;

        publishCloudWhite();

        return;
    }

    uint lowCut = uint(float(total) * trimLow);
    uint highCut = uint(float(total) * trimHigh);

    uint cum = 0u;
    uint used = 0u;
    float weighted = 0.0;

    for(uint i = 0u; i < AE_BIN_COUNT; ++i)
    {
        uint c = bins[i];
        uint prevCum = cum;

        cum += c;

        if(cum > lowCut && prevCum < highCut)
        {
            float binCenter =
                AE_LOG2_MIN +
                (float(i) + 0.5) *
                    (AE_LOG2_MAX - AE_LOG2_MIN) /
                    float(AE_BIN_COUNT);

            weighted += binCenter * (float(c) / float(total));
            used += c;
        }

        bins[i] = 0u;
    }

    if(used == 0u)
    {
        sampleCount = 0u;
        targetEV = currentEV;

        publishCloudWhite();

        return;
    }

    float avgLogLum = weighted * (float(total) / float(used));

    float target = clamp(keyEV - avgLogLum, minEV, maxEV);

    float rate =
        target > currentEV
            ? adaptUpRate
            : adaptDownRate;

    float alpha =
        1.0 - exp(-max(dtSec, 0.0) * max(rate, 0.0));

    currentEV = mix(currentEV, target, clamp(alpha, 0.0, 1.0));

    targetEV = target;
    avgLogLuma = avgLogLum;
    sampleCount = used;

    publishCloudWhite();
}
