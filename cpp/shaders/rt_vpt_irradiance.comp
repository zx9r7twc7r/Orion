#version 460
#extension GL_GOOGLE_include_directive : require

// VPT-3.3B.1: deterministic voxel local-light transport.
// The active solve is emitter -> exact exposed 16^3 x 6 block-face direct
// irradiance (binding 30).  RayGen reads that exact face directly; neither
// 9^3 air-probe field participates in visible primary local lighting.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Camera UBO (set 0, binding 2).  This pass previously took no camera block at
// all, but its pipeline layout is g_rayTracingDescriptorSetLayout, whose
// binding 2 already carries VK_SHADER_STAGE_COMPUTE_BIT, so declaring it costs
// nothing at bind time.  Only the two tail lanes are actually read.
//
// 只声明前缀：std140 的规则是"少声明安全、跳过再继续致命"。这里停在
// historyPadding1（offset 172），它后面一个字段都不再声明，所以任何已读
// 偏移都不会滑动。
layout(binding = 2, set = 0) uniform CameraProperties {
    #include "camera_ubo.glsl"
} cam;

const uint TABLE_CAPACITY = 8192u;
const uint SOURCE_WORDS = 4096u;
const uint PROBE_EDGE = 9u;
const uint PROBE_WORDS = 729u;
const uint DIRECTION_COUNT = 6u;
const uint DIRECTIONAL_CACHE_WORDS = DIRECTION_COUNT * PROBE_WORDS;
const uint PAGE_WORDS = SOURCE_WORDS + DIRECTIONAL_CACHE_WORDS;
const uint SURFACE_FACE_WORDS = SOURCE_WORDS * DIRECTION_COUNT;
const uint CANDIDATES_PER_PAGE = 8u;
const float MAX_LIGHT_DISTANCE = 30.0;
const float LOCAL_RANGE_PER_EMISSION = 2.0;
const float LOCAL_FADE_START_FRACTION = 0.60;
const float INV_PI = 0.3183098861837907;
// VLI source-word contract from SectionCompilerMixin: RGB555 contains the
// exact DyeColor and this bit identifies it as a transmissive stained voxel.
const uint SOURCE_STAINED_GLASS_BIT = 1u << 24u;
// VLI-2.0 partial occluders.  Class 3 is a block that occludes without being a
// full cube (slab / stairs / wall / fence / carpet ...).  SectionCompilerMixin
// stores how much of the cell is free in bits 25..31 (7 bits, 127 = fully
// transparent) and the DDA attenuates by it instead of treating the whole cell
// as a solid wall -- otherwise a torch lit a slab's neighbour as if the slab
// were a full 1x1x1 block.  Keep in lockstep with VLI_PARTIAL_SHIFT /
// VLI_PARTIAL_MAX in SectionCompilerMixin.
const uint SOURCE_PARTIAL_TRANSMISSION_SHIFT = 25u;
const uint SOURCE_PARTIAL_TRANSMISSION_MAX = 127u;

float vliPartialTransmission(uint source)
{
    return float((source >> SOURCE_PARTIAL_TRANSMISSION_SHIFT) &
        SOURCE_PARTIAL_TRANSMISSION_MAX) * (1.0 / 127.0);
}

// Occupied cell: a full cube (class 1) or a partial occluder (class 3).
bool vliVoxelOccupied(uint source)
{
    uint voxelClass = source & 3u;
    return voxelClass == 1u || voxelClass == 3u;
}
// Match the confirmed primary stained-glass filter.  Saturation is increased
// while the strongest transmitted channel remains unchanged, so Binding 30
// gains colour concentration without receiving extra light energy.
const float STAINED_GLASS_TRANSMISSION_SATURATION = 3.0;

// =====================================================
// 用户旋钮：本地光源照射强度（设置界面滑块）。
//
// 读 CameraUBO.historyPadding1 的 float 位型；主机写的是 intensity + 1.0，
// 所以 0.0 是"主机从没下发"的标记而不是合法值。与 rt_test.rgen /
// rt_restir_final.rgen / rt_restir_spatial.comp 里的同名函数逐字一致。
//
// ⚠ 本文件的基础系数是硬编码的 0.78，而不是其余三个文件的
// LOCAL_LIGHT_ENERGY_SCALE = 0.35 —— 这是 2026-09-25 之前就存在的既存不一致，
// 本次只叠加同一个乘子、不去动基准值（改了就会移动已经调好的观感）。
// 因此这里的烘焙面缓存（binding 30）与 ReSTIR 直射项对同一个滑块响应相同，
// 但绝对亮度仍相差 0.78/0.35 倍。要统一基准请单独提出来做，并连带重测。
// =====================================================
float localLightIntensity()
{
    float user = uintBitsToFloat(cam.historyPadding1) - 1.0;
    return (user >= 0.0 && user <= 16.0) ? user : 1.0;
}

layout(std430, binding = 22, set = 0) readonly buffer PageTable
{
    uint words[];
} pageTable;

// Source words occupy [0, 4095]. Direct directional probes occupy the rest.
layout(std430, binding = 23, set = 0) buffer Pages
{
    uint words[];
} pages;

// Final secondary directional probes. RayGen reads this buffer, never the
// full-resolution surface cache directly.
layout(std430, binding = 24, set = 0) buffer SecondaryPages
{
    uint words[];
} secondaryPages;

layout(std430, binding = 25, set = 0) readonly buffer WorkList
{
    uint words[];
} workList;

// xyz = exact world block coordinate; w = emission bits 0..3, type bits 4..6.
layout(std430, binding = 29, set = 0) readonly buffer CandidatePages
{
    uvec4 entries[];
} candidatePages;

// One packed RGB direct irradiance value per exact exposed voxel face.
layout(std430, binding = 30, set = 0) buffer SurfacePages
{
    uint words[];
} surfacePages;

layout(push_constant) uniform Dispatch
{
    uint eventSerial;
    uint passIndex; // 0 = direct probes, 1 = surface faces, 2 = secondary probes
} dispatchInfo;

uint hash32(uint x)
{
    x ^= x >> 16u;
    x *= 0x7feb352du;
    x ^= x >> 15u;
    x *= 0x846ca68bu;
    return x ^ (x >> 16u);
}

uint sectionHash(ivec3 section)
{
    return hash32(
        uint(section.x) * 0x8da6b343u ^
        uint(section.y) * 0xd8163841u ^
        uint(section.z) * 0xcb1ab31fu
    );
}

int floorDiv(int value, int divisor)
{
    return value >= 0 ? value / divisor : -((-value + divisor - 1) / divisor);
}

int positiveMod(int value, int divisor)
{
    int result = value % divisor;
    return result < 0 ? result + divisor : result;
}

bool lookupPage(ivec3 section, out uint page)
{
    uint slot = sectionHash(section) & (TABLE_CAPACITY - 1u);
    for(uint attempt = 0u; attempt < TABLE_CAPACITY; ++attempt)
    {
        uint base = slot * 4u;
        uint pagePlusOne = pageTable.words[base + 3u];
        if(pagePlusOne == 0u)
        {
            return false;
        }
        if(
            int(pageTable.words[base + 0u]) == section.x &&
            int(pageTable.words[base + 1u]) == section.y &&
            int(pageTable.words[base + 2u]) == section.z
        )
        {
            page = pagePlusOne - 1u;
            return true;
        }
        slot = (slot + 1u) & (TABLE_CAPACITY - 1u);
    }
    return false;
}

uint localVoxelIndex(ivec3 local)
{
    return uint(local.x) + 16u * (uint(local.z) + 16u * uint(local.y));
}

// VPT-P2（2026-09-29）：面烘焙可见性 DDA 的单入口 section 页表缓存。
// solveSurfaceFace 对每个暴露面最多 8 个候选各做一条 ≤96 步的 DDA，每步
// readVoxel 都要做一次页表哈希；一条 DDA 最多跨 2~3 个 section，把上次查到
// 的 (section → page) 留在本调用的寄存器里，绝大多数步只剩一次比较。
// 页表在一次 dispatch 内不变，键值比对保证正确性；缺失的 section 不进缓存。
bool g_memoPageValid = false;
ivec3 g_memoSection = ivec3(0);
uint g_memoPage = 0u;

bool readVoxel(ivec3 worldBlock, out uint word)
{
    ivec3 sectionCoord = ivec3(
        floorDiv(worldBlock.x, 16),
        floorDiv(worldBlock.y, 16),
        floorDiv(worldBlock.z, 16)
    );
    uint page;
    if(g_memoPageValid && all(equal(g_memoSection, sectionCoord)))
    {
        page = g_memoPage;
    }
    else
    {
        if(!lookupPage(sectionCoord, page))
        {
            return false;
        }
        g_memoSection = sectionCoord;
        g_memoPage = page;
        g_memoPageValid = true;
    }

    ivec3 local = ivec3(
        positiveMod(worldBlock.x, 16),
        positiveMod(worldBlock.y, 16),
        positiveMod(worldBlock.z, 16)
    );
    word = pages.words[page * PAGE_WORDS + localVoxelIndex(local)];
    return true;
}

bool lookupVoxelPageAndIndex(
    ivec3 worldBlock,
    out uint page,
    out uint voxelIndex
)
{
    if(!lookupPage(
        ivec3(
            floorDiv(worldBlock.x, 16),
            floorDiv(worldBlock.y, 16),
            floorDiv(worldBlock.z, 16)
        ),
        page
    ))
    {
        voxelIndex = 0u;
        return false;
    }

    ivec3 local = ivec3(
        positiveMod(worldBlock.x, 16),
        positiveMod(worldBlock.y, 16),
        positiveMod(worldBlock.z, 16)
    );
    voxelIndex = localVoxelIndex(local);
    return true;
}

vec3 emitterColor(uint typeCode)
{
    if(typeCode == 1u) return vec3(1.0, 0.55, 0.20);
    if(typeCode == 2u) return vec3(0.20, 0.75, 1.0);
    if(typeCode == 3u) return vec3(1.0, 0.12, 0.06);
    if(typeCode == 4u) return vec3(1.0, 0.27, 0.05);
    // 6 = 地狱传送门（紫）。与 rt_test.rgen 的两处同值，见
    // SectionCompilerMixin.classifyLocalLightType。
    if(typeCode == 6u) return vec3(0.70, 0.28, 1.0);
    return vec3(1.0, 0.82, 0.48);
}

uint packRGB(vec3 color)
{
    uvec3 encoded = uvec3(clamp(
        floor(color * 32.0 + 0.5),
        vec3(0.0),
        vec3(255.0)
    ));
    return encoded.x | (encoded.y << 8u) | (encoded.z << 16u);
}

vec3 unpackRGB(uint packedValue)
{
    return vec3(
        float( packedValue        & 255u),
        float((packedValue >>  8u) & 255u),
        float((packedValue >> 16u) & 255u)
    ) * (1.0 / 32.0);
}

vec3 cacheAxis(uint directionIndex)
{
    if(directionIndex == 0u) return vec3( 1.0,  0.0,  0.0);
    if(directionIndex == 1u) return vec3(-1.0,  0.0,  0.0);
    if(directionIndex == 2u) return vec3( 0.0,  1.0,  0.0);
    if(directionIndex == 3u) return vec3( 0.0, -1.0,  0.0);
    if(directionIndex == 4u) return vec3( 0.0,  0.0,  1.0);
    return vec3(0.0, 0.0, -1.0);
}

uint faceIndexFromNormal(vec3 normal)
{
    if(normal.x > 0.5) return 0u;
    if(normal.x < -0.5) return 1u;
    if(normal.y > 0.5) return 2u;
    if(normal.y < -0.5) return 3u;
    if(normal.z > 0.5) return 4u;
    return 5u;
}

vec3 decodeVoxelAlbedo(uint source)
{
    return vec3(
        float((source >>  9u) & 31u),
        float((source >> 14u) & 31u),
        float((source >> 19u) & 31u)
    ) * (1.0 / 31.0);
}

vec3 saturateGlassTransmission(vec3 transmission)
{
    float peak = max(
        transmission.r,
        max(transmission.g, transmission.b)
    );
    return clamp(
        vec3(peak) +
            (transmission - vec3(peak)) *
            STAINED_GLASS_TRANSMISSION_SATURATION,
        vec3(0.0),
        vec3(peak)
    );
}

float localLightRange(float emissionLevel)
{
    return min(
        MAX_LIGHT_DISTANCE,
        max(emissionLevel * LOCAL_RANGE_PER_EMISSION, 2.0)
    );
}

float localRangeFade(float distanceToLight, float emissionLevel)
{
    float range = localLightRange(emissionLevel);
    return 1.0 - smoothstep(
        range * LOCAL_FADE_START_FRACTION,
        range,
        distanceToLight
    );
}

float localDistanceAttenuation(float distanceToLight)
{
    float distance = max(distanceToLight, 0.0);
    return 0.55 / (1.0 + 0.18 * distance + 0.025 * distance * distance);
}

// Exact DDA visibility/transmission to a candidate emitter.  Missing pages
// and opaque voxels stop the path.  Each stained-glass block or pane multiplies
// the RGB irradiance before it reaches the receiver.
vec3 transmissionToEmitter(vec3 origin, ivec3 targetBlock)
{
    vec3 target = vec3(targetBlock) + vec3(0.5);
    vec3 segment = target - origin;
    float maxDistance = length(segment);
    if(maxDistance <= 1.0e-4)
    {
        return vec3(1.0);
    }

    vec3 direction = segment / maxDistance;
    vec3 transmission = vec3(1.0);
    ivec3 cell = ivec3(floor(origin));
    ivec3 step = ivec3(sign(direction));
    vec3 invAbs = 1.0 / max(abs(direction), vec3(1.0e-6));
    vec3 boundary = vec3(cell) + vec3(max(step, ivec3(0)));
    vec3 tMax = (boundary - origin) / direction;
    if(step.x == 0) tMax.x = 1.0e30;
    if(step.y == 0) tMax.y = 1.0e30;
    if(step.z == 0) tMax.z = 1.0e30;

    for(int traversal = 0; traversal < 96; ++traversal)
    {
        int axis = tMax.x < tMax.y
            ? (tMax.x < tMax.z ? 0 : 2)
            : (tMax.y < tMax.z ? 1 : 2);
        float travel = axis == 0 ? tMax.x : (axis == 1 ? tMax.y : tMax.z);
        if(travel >= maxDistance)
        {
            return transmission;
        }

        if(axis == 0)
        {
            cell.x += step.x;
            tMax.x += invAbs.x;
        }
        else if(axis == 1)
        {
            cell.y += step.y;
            tMax.y += invAbs.y;
        }
        else
        {
            cell.z += step.z;
            tMax.z += invAbs.z;
        }

        if(all(equal(cell, targetBlock)))
        {
            return transmission;
        }

        uint source;
        if(!readVoxel(cell, source))
        {
            return vec3(0.0);
        }
        uint voxelClass = source & 3u;
        if(voxelClass == 1u)
        {
            return vec3(0.0);
        }
        if(voxelClass == 3u)
        {
            // Slab / stairs / wall / fence: only the occupied part of the cell
            // blocks.  Attenuate by the free fraction and keep marching, so a
            // torch behind a half slab lights the far side instead of being
            // cut off by a phantom full cube.
            transmission *= max(vliPartialTransmission(source), 1.0 / 127.0);
        }
        if((source & SOURCE_STAINED_GLASS_BIT) != 0u)
        {
            // A lower bound avoids a quantized RGB555 zero turning a coloured
            // glass path into a hard opaque shadow.
            transmission *= max(decodeVoxelAlbedo(source), vec3(1.0 / 31.0));
        }
    }
    return vec3(0.0);
}

vec3 solveDirectIrradiance(uint receiverPage, vec3 receiverPos, vec3 receiverNormal)
{
    vec3 irradiance = vec3(0.0);
    uint candidateBase = receiverPage * CANDIDATES_PER_PAGE;

    for(uint candidateIndex = 0u;
        candidateIndex < CANDIDATES_PER_PAGE;
        ++candidateIndex)
    {
        uvec4 candidate = candidatePages.entries[candidateBase + candidateIndex];
        uint emission = candidate.w & 15u;
        if(emission == 0u)
        {
            continue;
        }

        ivec3 emitterBlock = ivec3(candidate.xyz);
        vec3 toLight = vec3(emitterBlock) + vec3(0.5) - receiverPos;
        float distanceSquared = dot(toLight, toLight);
        if(distanceSquared <= 1.0e-6)
        {
            continue;
        }

        float distanceToLight = sqrt(distanceSquared);
        float emissionLevel = float(emission);
        if(distanceToLight > localLightRange(emissionLevel))
        {
            continue;
        }

        vec3 lightDirection = toLight / distanceToLight;
        float receiverCosine = max(dot(receiverNormal, lightDirection), 0.0);
        if(receiverCosine <= 0.0)
        {
            continue;
        }

        vec3 glassTransmission = transmissionToEmitter(
            receiverPos,
            emitterBlock
        );
        if(max(glassTransmission.r, max(glassTransmission.g,
            glassTransmission.b)) <= 1.0e-4)
        {
            continue;
        }
        glassTransmission = saturateGlassTransmission(glassTransmission);

        uint typeCode = (candidate.w >> 4u) & 7u;
        float radianceScale =
            3.2 *
            0.78 *
            localLightIntensity() *
            (emissionLevel / 15.0) *
            localDistanceAttenuation(distanceToLight) *
            localRangeFade(distanceToLight, emissionLevel);
        irradiance += emitterColor(typeCode) * radianceScale * receiverCosine *
            glassTransmission;
    }

    return irradiance;
}

bool faceIsExposed(ivec3 worldBlock, vec3 faceNormal)
{
    uint neighbor;
    return readVoxel(
        worldBlock + ivec3(faceNormal),
        neighbor
    ) && (neighbor & 3u) != 1u;
}

bool traceToSecondarySurface(
    vec3 origin,
    vec3 direction,
    out ivec3 hitBlock,
    out vec3 hitNormal,
    out float hitDistance
)
{
    ivec3 cell = ivec3(floor(origin));
    ivec3 step = ivec3(sign(direction));
    vec3 invAbs = 1.0 / max(abs(direction), vec3(1.0e-6));
    vec3 boundary = vec3(cell) + vec3(max(step, ivec3(0)));
    vec3 tMax = (boundary - origin) / direction;
    if(step.x == 0) tMax.x = 1.0e30;
    if(step.y == 0) tMax.y = 1.0e30;
    if(step.z == 0) tMax.z = 1.0e30;

    hitBlock = cell;
    hitNormal = vec3(0.0);
    hitDistance = 0.0;
    for(int traversal = 0; traversal < 32; ++traversal)
    {
        int axis = tMax.x < tMax.y
            ? (tMax.x < tMax.z ? 0 : 2)
            : (tMax.y < tMax.z ? 1 : 2);
        float travel = axis == 0 ? tMax.x : (axis == 1 ? tMax.y : tMax.z);
        if(travel > 16.0)
        {
            return false;
        }

        if(axis == 0)
        {
            cell.x += step.x;
            tMax.x += invAbs.x;
            hitNormal = vec3(-step.x, 0.0, 0.0);
        }
        else if(axis == 1)
        {
            cell.y += step.y;
            tMax.y += invAbs.y;
            hitNormal = vec3(0.0, -step.y, 0.0);
        }
        else
        {
            cell.z += step.z;
            tMax.z += invAbs.z;
            hitNormal = vec3(0.0, 0.0, -step.z);
        }

        uint source;
        if(!readVoxel(cell, source))
        {
            return false;
        }
        // A partial occluder is a real surface too (the ray lands on the slab
        // or on the fence bars), so it terminates the march as well.
        if(vliVoxelOccupied(source))
        {
            hitBlock = cell;
            hitDistance = travel;
            return true;
        }
    }
    return false;
}

bool resolveWorkPage(uint invocation, uint entriesPerPage, out uint page, out ivec3 section, out uint localEntry)
{
    uint pageCount = workList.words[0];
    if(invocation >= pageCount * entriesPerPage)
    {
        page = 0u;
        section = ivec3(0);
        localEntry = 0u;
        return false;
    }

    uint pageWorkIndex = invocation / entriesPerPage;
    localEntry = invocation % entriesPerPage;
    uint tableSlot = workList.words[1u + pageWorkIndex];
    uint tableBase = tableSlot * 4u;
    uint pagePlusOne = pageTable.words[tableBase + 3u];
    if(pagePlusOne == 0u)
    {
        page = 0u;
        section = ivec3(0);
        return false;
    }

    page = pagePlusOne - 1u;
    section = ivec3(
        int(pageTable.words[tableBase + 0u]),
        int(pageTable.words[tableBase + 1u]),
        int(pageTable.words[tableBase + 2u])
    );
    return true;
}

void solveDirectProbe(uint invocation)
{
    uint page;
    ivec3 section;
    uint probe;
    if(!resolveWorkPage(invocation, PROBE_WORDS, page, section, probe))
    {
        return;
    }

    ivec3 probeCoord = ivec3(
        int(probe % PROBE_EDGE),
        int(probe / (PROBE_EDGE * PROBE_EDGE)),
        int((probe / PROBE_EDGE) % PROBE_EDGE)
    );
    vec3 probeWorldPosition = vec3(section * 16 + probeCoord * 2) + vec3(1.0);
    uint probeSource;
    bool probeInOpenSpace = readVoxel(
        ivec3(floor(probeWorldPosition)),
        probeSource
    ) && (probeSource & 3u) != 1u;

    uint cacheBase = page * PAGE_WORDS + SOURCE_WORDS + probe;
    for(uint directionIndex = 0u;
        directionIndex < DIRECTION_COUNT;
        ++directionIndex)
    {
        pages.words[cacheBase + directionIndex * PROBE_WORDS] =
            probeInOpenSpace
                ? packRGB(solveDirectIrradiance(
                    page,
                    probeWorldPosition,
                    cacheAxis(directionIndex)
                ))
                : 0u;
    }
}

void solveSurfaceFace(uint invocation)
{
    uint page;
    ivec3 section;
    uint faceEntry;
    if(!resolveWorkPage(invocation, SURFACE_FACE_WORDS, page, section, faceEntry))
    {
        return;
    }

    uint voxelIndex = faceEntry / DIRECTION_COUNT;
    uint faceIndex = faceEntry % DIRECTION_COUNT;
    uint surfaceAddress = page * SURFACE_FACE_WORDS + faceEntry;
    uint source = pages.words[page * PAGE_WORDS + voxelIndex];
    uint emission = (source >> 2u) & 15u;
    // Partial occluders own a face too: if they were excluded here, a slab or a
    // fence would bake to zero and then read as unlit by every local-light
    // consumer, i.e. still "handled as a full block" from the outside.
    if(!vliVoxelOccupied(source) || emission != 0u)
    {
        surfacePages.words[surfaceAddress] = 0u;
        return;
    }

    ivec3 localBlock = ivec3(
        int(voxelIndex & 15u),
        int(voxelIndex >> 8u),
        int((voxelIndex >> 4u) & 15u)
    );
    ivec3 worldBlock = section * 16 + localBlock;
    vec3 faceNormal = cacheAxis(faceIndex);
    // This cache is direct irradiance.  It must not depend on the optional
    // Section RGB555 material average: a face with no mesh-albedo sample is
    // still physically able to receive local light.  RayGen applies the
    // current hit's real PBR/POM albedo after this lookup.
    if(!faceIsExposed(worldBlock, faceNormal))
    {
        surfacePages.words[surfaceAddress] = 0u;
        return;
    }

    vec3 facePosition = vec3(worldBlock) + vec3(0.5) + faceNormal * 0.501;
    // VPT-P3（2026-09-29）：拐角面的多点烘焙（拐角光斑修复 B）。
    // 面中心单点可见性在"切向邻居里有遮挡体"的拐角面处与面的大部分区域
    // 严重不符 —— 半遮挡的面拿到整面亮或整面暗，弹射读取这份量化值时
    // 表现为拐角处 1×1 的亮斑/暗斑。此类面改在面内 2×2 四个子点
    // （±0.25，同一 0.501 外推高度）分别求直接辐照度再取平均，把面中心
    // 采样变成面积分的近似；开阔面维持单点。
    // 子点都在本面自己的外推气格里，transmissionToEmitter 的 DDA 起步干净。
    // VPT-P5（2026-09-30 修复）：判据原本读的是**同一层**的切向邻居
    // （worldBlock + lateralOffset）。在一整片平坦墙面/地面上，同一层的切向
    // 邻居必然是同材质的实体方块（墙体/地板的延续），于是该判据在任何平坦
    // 表面上恒真 —— 每一张面都走 4 子点烘焙，烘焙量 ×4，而
    // solveDirectIrradiance 完全确定（无 RNG），无遮挡面的 4 个子点取值相同，
    // 这一档纯属浪费。VPT-P3 注释里"开阔面维持单点、烘焙成本不变"从未成立。
    //
    // 真正的"半遮挡面"要求横向邻居在**本面所在平面之外**有实体，即
    // worldBlock + lateralOffset + faceNormal 这一格。同一层的横向邻居
    // 整体位于面平面之下（地面）或之内（墙面），封闭不了上半球，不是遮挡体；
    // 而面平面之外那一格为实体时，说明有方块紧贴面侧立着（台阶、檐口、墙角），
    // 该面的近侧半边半球确实被切掉，面心单点不再代表整面。
    // 平坦表面此判据恒假，回到单点烘焙；子点仍落在本面自己的外推气格里，
    // transmissionToEmitter 的 DDA 起步干净。
    ivec3 tangentA = abs(faceNormal.x) > 0.5 ? ivec3(0, 1, 0) : ivec3(1, 0, 0);
    ivec3 tangentB = abs(faceNormal.z) > 0.5 ? ivec3(0, 1, 0) : ivec3(0, 0, 1);
    bool lateralOccluder = false;
    for(int side = 0; side < 4 && !lateralOccluder; ++side)
    {
        ivec3 lateralOffset = (side & 1) == 0 ? tangentA : tangentB;
        lateralOffset = (side & 2) == 0 ? lateralOffset : -lateralOffset;
        uint lateralWord;
        // Partial occluders count here as well: before this class existed a
        // slab/stair/fence was encoded as class 1 and did trigger the 2x2
        // sub-point bake, so leaving class 3 out would silently drop the
        // corner handling for exactly the blocks this change is about.
        if(readVoxel(
            worldBlock + lateralOffset + ivec3(faceNormal),
            lateralWord
        ) && vliVoxelOccupied(lateralWord))
        {
            lateralOccluder = true;
        }
    }

    vec3 directIrradiance;
    if(lateralOccluder)
    {
        directIrradiance = vec3(0.0);
        for(int subPoint = 0; subPoint < 4; ++subPoint)
        {
            float offsetA = (subPoint & 1) == 0 ? -0.25 : 0.25;
            float offsetB = (subPoint & 2) == 0 ? -0.25 : 0.25;
            directIrradiance += solveDirectIrradiance(
                page,
                facePosition +
                    vec3(tangentA) * offsetA +
                    vec3(tangentB) * offsetB,
                faceNormal
            );
        }
        directIrradiance *= 0.25;
    }
    else
    {
        directIrradiance = solveDirectIrradiance(page, facePosition, faceNormal);
    }
    // Store irradiance, not reflected radiance.  The primary shader applies
    // its current PBR/POM albedo exactly once at the hardware-RT hit.
    surfacePages.words[surfaceAddress] = packRGB(directIrradiance);
}

void solveSecondaryLobe(uint invocation)
{
    uint page;
    ivec3 section;
    uint probeDirection;
    if(!resolveWorkPage(
        invocation,
        PROBE_WORDS * DIRECTION_COUNT,
        page,
        section,
        probeDirection
    ))
    {
        return;
    }

    uint probe = probeDirection / DIRECTION_COUNT;
    uint directionIndex = probeDirection % DIRECTION_COUNT;
    ivec3 probeCoord = ivec3(
        int(probe % PROBE_EDGE),
        int(probe / (PROBE_EDGE * PROBE_EDGE)),
        int((probe / PROBE_EDGE) % PROBE_EDGE)
    );
    vec3 probeWorldPosition = vec3(section * 16 + probeCoord * 2) + vec3(1.0);
    uint probeSource;
    vec3 secondaryRadiance = vec3(0.0);
    bool probeInOpenSpace = readVoxel(
        ivec3(floor(probeWorldPosition)),
        probeSource
    ) && (probeSource & 3u) != 1u;

    if(probeInOpenSpace)
    {
        vec3 rayDirection = cacheAxis(directionIndex);
        ivec3 hitBlock;
        vec3 hitNormal;
        float hitDistance;
        if(traceToSecondarySurface(
            probeWorldPosition + rayDirection * 0.02,
            rayDirection,
            hitBlock,
            hitNormal,
            hitDistance
        ))
        {
            uint hitPage;
            uint hitVoxelIndex;
            if(lookupVoxelPageAndIndex(hitBlock, hitPage, hitVoxelIndex))
            {
                uint faceIndex = faceIndexFromNormal(hitNormal);
                uint packedSurface = surfacePages.words[
                    hitPage * SURFACE_FACE_WORDS +
                    hitVoxelIndex * DIRECTION_COUNT + faceIndex
                ];
                // Binding 30 stores direct irradiance.  Convert the hit
                // face to Lambertian outgoing radiance here only for the
                // dormant secondary-probe path; VPT-3.3B.1 does not dispatch
                // this pass or expose it to RayGen.
                uint hitSource = pages.words[
                    hitPage * PAGE_WORDS + hitVoxelIndex
                ];
                vec3 hitAlbedo = decodeVoxelAlbedo(hitSource);
                // The unit block face subtends approximately area / distance^2.
                float solidAngleScale = 1.0 / max(hitDistance * hitDistance, 1.0);
                secondaryRadiance = unpackRGB(packedSurface) *
                    hitAlbedo * INV_PI * solidAngleScale;
            }
        }
    }

    secondaryPages.words[
        page * DIRECTIONAL_CACHE_WORDS +
        directionIndex * PROBE_WORDS + probe
    ] = packRGB(secondaryRadiance);
}

void main()
{
    if(dispatchInfo.passIndex == 0u)
    {
        solveDirectProbe(gl_GlobalInvocationID.x);
    }
    else if(dispatchInfo.passIndex == 1u)
    {
        solveSurfaceFace(gl_GlobalInvocationID.x);
    }
    else if(dispatchInfo.passIndex == 2u)
    {
        solveSecondaryLobe(gl_GlobalInvocationID.x);
    }
}
