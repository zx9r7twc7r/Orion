#version 460


layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, set = 0) uniform sampler2D bloomSceneImage;

layout(binding = 1, set = 0, rgba16f) uniform image2D bloomMipImage;

const float BLOOM_THRESHOLD = 1.0;
const float BLOOM_SOFT_KNEE = 0.5;

// Karis 加权平均用的亮度（避免单个极亮像素主导整块，那是泛光"爬行/颗粒"的主因）。
float brightnessOf(vec3 color)
{
    return dot(color, vec3(0.2126, 0.7152, 0.0722));
}

// 软膝阈值：返回"该像素应当贡献多少"（0..1），乘回颜色。
vec3 applySoftThreshold(vec3 color)
{
    float brightness = max(color.r, max(color.g, color.b));
    float knee = BLOOM_THRESHOLD * BLOOM_SOFT_KNEE + 1.0e-5;
    float soft = clamp(brightness - BLOOM_THRESHOLD + knee, 0.0, 2.0 * knee);
    soft = soft * soft / (4.0 * knee);
    float contribution = max(soft, brightness - BLOOM_THRESHOLD) /
        max(brightness, 1.0e-5);
    return color * contribution;
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dstSize = imageSize(bloomMipImage);
    if(any(greaterThanEqual(pixel, dstSize)))
    {
        return;
    }

    ivec2 srcSize = textureSize(bloomSceneImage, 0);
    vec2 texel = 1.0 / vec2(srcSize);
    vec2 uv = (vec2(pixel) + 0.5) / vec2(dstSize);

    vec3 a = applySoftThreshold(textureLod(bloomSceneImage, uv + texel * vec2(-2.0, -2.0), 0.0).rgb);
    vec3 b = applySoftThreshold(textureLod(bloomSceneImage, uv + texel * vec2( 0.0, -2.0), 0.0).rgb);
    vec3 c = applySoftThreshold(textureLod(bloomSceneImage, uv + texel * vec2( 2.0, -2.0), 0.0).rgb);
    vec3 d = applySoftThreshold(textureLod(bloomSceneImage, uv + texel * vec2(-2.0,  0.0), 0.0).rgb);
    vec3 e = applySoftThreshold(textureLod(bloomSceneImage, uv, 0.0).rgb);
    vec3 f = applySoftThreshold(textureLod(bloomSceneImage, uv + texel * vec2( 2.0,  0.0), 0.0).rgb);
    vec3 g = applySoftThreshold(textureLod(bloomSceneImage, uv + texel * vec2(-2.0,  2.0), 0.0).rgb);
    vec3 h = applySoftThreshold(textureLod(bloomSceneImage, uv + texel * vec2( 0.0,  2.0), 0.0).rgb);
    vec3 i = applySoftThreshold(textureLod(bloomSceneImage, uv + texel * vec2( 2.0,  2.0), 0.0).rgb);

    vec3 j = applySoftThreshold(textureLod(bloomSceneImage, uv + texel * vec2(-1.0, -1.0), 0.0).rgb);
    vec3 k = applySoftThreshold(textureLod(bloomSceneImage, uv + texel * vec2( 1.0, -1.0), 0.0).rgb);
    vec3 l = applySoftThreshold(textureLod(bloomSceneImage, uv + texel * vec2(-1.0,  1.0), 0.0).rgb);
    vec3 m = applySoftThreshold(textureLod(bloomSceneImage, uv + texel * vec2( 1.0,  1.0), 0.0).rgb);

    vec3 result =
        e * 0.125 +
        (a + c + g + i) * 0.03125 +
        (b + d + f + h) * 0.0625 +
        (j + k + l + m) * 0.125;

    imageStore(bloomMipImage, pixel, vec4(result, 1.0));
}
