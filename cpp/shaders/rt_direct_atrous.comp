#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, rgba16f) uniform readonly image2D atrousColorInput;
layout(binding = 1, rgba16f) uniform writeonly image2D atrousColorOutput;
layout(binding = 2, r32f) uniform readonly image2D atrousLinearDepth;
layout(binding = 3, rgba16f) uniform readonly image2D atrousNormalRoughness;
layout(binding = 4, r16f) uniform readonly image2D atrousVarianceInput;
layout(binding = 5, r16f) uniform writeonly image2D atrousVarianceOutput;

layout(push_constant) uniform DirectAtrousPushConstants
{
    uint width;
    uint height;
    uint stepSize;
    float phiColor;
    uint encodeToYCoCg;
} atrousPush;

const float kPhiNormal = 128.0;
#ifndef RT_DI_FIREFLY_ABS
#define RT_DI_FIREFLY_ABS 0.005
#endif

#ifndef RT_DI_ATROUS_BYPASS
#define RT_DI_ATROUS_BYPASS 0
#endif

float luminance(vec3 c)
{
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

vec3 normalizeSafe(vec3 v)
{
    float len = length(v);
    return (len > 1e-4) ? (v / len) : vec3(0.0, 0.0, 1.0);
}

// 照抄 rt_restir_final.rgen 的 _NRD_LinearToYCoCg（合成端做逆变换，必须同一套）
vec3 nrdLinearToYCoCg(vec3 color)
{
    float Y = dot(color, vec3(0.25, 0.5, 0.25));
    float Co = dot(color, vec3(0.5, 0.0, -0.5));
    float Cg = dot(color, vec3(-0.25, 0.5, -0.25));

    return vec3(Y, Co, Cg);
}

// computeVarianceCenter：2x2 权重铺在 3x3 上，越界跳过（不做归一化）
float computeVarianceCenter(ivec2 pixel, ivec2 size)
{
    const float kernel[2][2] = float[2][2](
        float[2](0.25, 0.125),
        float[2](0.125, 0.0625)
    );

    float sum = 0.0;

    for(int dy = -1; dy <= 1; ++dy)
    {
        for(int dx = -1; dx <= 1; ++dx)
        {
            ivec2 q = pixel + ivec2(dx, dy);
            if(q.x < 0 || q.y < 0 || q.x >= size.x || q.y >= size.y)
            {
                continue;
            }

            float k = kernel[abs(dx)][abs(dy)];
            sum += imageLoad(atrousVarianceInput, q).r * k;
        }
    }

    return sum;
}

// estimateDepthFwidth：前向差分的深度梯度，下限 1e-4
float estimateDepthFwidth(float centerDepth, ivec2 pixel, ivec2 size)
{
    float dx = 0.0;
    float dy = 0.0;

    if(pixel.x + 1 < size.x)
    {
        dx = abs(
            centerDepth -
            imageLoad(atrousLinearDepth, pixel + ivec2(1, 0)).r
        );
    }

    if(pixel.y + 1 < size.y)
    {
        dy = abs(
            centerDepth -
            imageLoad(atrousLinearDepth, pixel + ivec2(0, 1)).r
        );
    }

    return max(max(dx, dy), 1.0e-4);
}

// computeWeight：wNormal 恒 1（**不使用法线**）
float computeWeight(
    float depthCenter,
    float depthP,
    float phiDepth,
    vec3 normalCenter,
    vec3 normalP,
    float phiNormal,
    float lumCenter,
    float lumP,
    float phiColor
)
{
    float wNormal = 1.0;
    float wZ = abs(depthCenter - depthP) / max(phiDepth, 1.0e-4);
    float wL = abs(lumCenter - lumP) / max(phiColor, 1.0e-4);
    return exp(-max(wL, 0.0) - max(wZ, 0.0)) * wNormal;
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(atrousColorInput);

    if(pixel.x >= size.x || pixel.y >= size.y)
    {
        return;
    }

    vec3 centerColor = imageLoad(atrousColorInput, pixel).rgb;
    float centerDepth = imageLoad(atrousLinearDepth, pixel).r;
    vec3 centerNormal = imageLoad(atrousNormalRoughness, pixel).xyz;
    float varianceCenter = imageLoad(atrousVarianceInput, pixel).r;
    float varianceForPhi = computeVarianceCenter(pixel, size);

    {
        vec3 sumNeighbors = vec3(0.0);
        float count = 0.0;

        for(int dy = -1; dy <= 1; ++dy)
        {
            for(int dx = -1; dx <= 1; ++dx)
            {
                if(dx == 0 && dy == 0)
                {
                    continue;
                }

                ivec2 q = pixel + ivec2(dx, dy);
                if(q.x < 0 || q.y < 0 || q.x >= size.x || q.y >= size.y)
                {
                    continue;
                }

                sumNeighbors += imageLoad(atrousColorInput, q).rgb;
                count += 1.0;
            }
        }

        if(count > 0.0)
        {
            vec3 meanNeighbors = sumNeighbors / count;

            if(luminance(centerColor) >
               luminance(meanNeighbors) * 5.0 + RT_DI_FIREFLY_ABS)
            {
                centerColor = meanNeighbors;
                varianceCenter = min(varianceCenter, 0.1);
            }
        }
    }

    float centerLum = luminance(centerColor);
    vec3 nCenter = normalizeSafe(centerNormal);
    float fwidthZ = estimateDepthFwidth(centerDepth, pixel, size);

    float phiDepth = max(fwidthZ, 1.0e-4) * float(atrousPush.stepSize) * 10.0;
    float phiL = max(atrousPush.phiColor * sqrt(max(varianceForPhi, 0.0)), 1.0);

    float sumW = 1.0;
    vec3 sumC = centerColor;
    float sumVarW2 = varianceCenter;

    const float kernel[5] = float[5](1.0, 2.0, 3.0, 2.0, 1.0);
    const float kernelNorm = 9.0;

    for(int dy = -2; dy <= 2; ++dy)
    {
        for(int dx = -2; dx <= 2; ++dx)
        {
            if(dx == 0 && dy == 0)
            {
                continue;
            }

            ivec2 q = pixel + ivec2(dx, dy) * int(atrousPush.stepSize);
            if(q.x < 0 || q.y < 0 || q.x >= size.x || q.y >= size.y)
            {
                continue;
            }

            vec3 c = imageLoad(atrousColorInput, q).rgb;
            float d = imageLoad(atrousLinearDepth, q).r;
            vec3 n = normalizeSafe(
                imageLoad(atrousNormalRoughness, q).xyz
            );
            float lum = luminance(c);
            float varNeighbor = imageLoad(atrousVarianceInput, q).r;

            float w = computeWeight(
                centerDepth,
                d,
                phiDepth * length(vec2(float(dx), float(dy))),
                nCenter,
                n,
                kPhiNormal,
                centerLum,
                lum,
                phiL
            );

            float wK = w * (
                kernel[abs(dx)] * kernel[abs(dy)] /
                (kernelNorm * kernelNorm)
            );

            sumC += c * wK;
            sumW += wK;
            sumVarW2 += varNeighbor * (wK * wK);
        }
    }

#if RT_DI_ATROUS_BYPASS
    vec3 outColor = centerColor;
    float outVar = varianceCenter;
#else
    vec3 outColor = sumC / max(sumW, 1.0e-4);
    float outVar = sumVarW2 / max(sumW * sumW, 1.0e-4);
#endif

    if(atrousPush.encodeToYCoCg != 0u)
    {
        vec3 tailColor = nrdLinearToYCoCg(outColor);
        if(pixel.x < (int(atrousPush.width) / 2))
        {
            tailColor = vec3(0.0);
        }
        imageStore(
            atrousColorOutput,
            pixel,
            vec4(tailColor, 1.0)
        );
    }
    else
    {
        imageStore(atrousColorOutput, pixel, vec4(outColor, 1.0));
    }

    imageStore(atrousVarianceOutput, pixel, vec4(outVar, 0.0, 0.0, 0.0));
}
