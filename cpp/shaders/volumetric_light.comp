const int MAX_OCCLUSION_SAMPLES = 12;
const float PI = 3.14159265359;
const float MIN_TRANSMITTANCE = 0.02;
const float SOLAR_LATITUDE_35_COS = 0.81915204429;



const float VL_MEDIUM_SIGMA = 0.0011;
const float VL_LAYER_SIGMA = 0.0022;
const float VL_LAYER_HEIGHT = 143.0;
const float VL_LAYER_SCALE_HEIGHT = 124.0;
