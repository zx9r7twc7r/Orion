#version 460


layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, set = 0) uniform sampler2D bloomSourceMip;
layout(binding = 1, set = 0, rgba16f) uniform image2D bloomTargetMip;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dstSize = imageSize(bloomTargetMip);
    if(any(greaterThanEqual(pixel, dstSize)))
    {
        return;
    }

    vec2 srcTexel = 1.0 / vec2(textureSize(bloomSourceMip, 0));
    vec2 uv = (vec2(pixel) + 0.5) / vec2(dstSize);

    vec3 tent = textureLod(bloomSourceMip, uv, 0.0).rgb * 4.0;
    tent += (
        textureLod(bloomSourceMip, uv + srcTexel * vec2(-1.0,  0.0), 0.0).rgb +
        textureLod(bloomSourceMip, uv + srcTexel * vec2( 1.0,  0.0), 0.0).rgb +
        textureLod(bloomSourceMip, uv + srcTexel * vec2( 0.0, -1.0), 0.0).rgb +
        textureLod(bloomSourceMip, uv + srcTexel * vec2( 0.0,  1.0), 0.0).rgb) * 2.0;
    tent += (
        textureLod(bloomSourceMip, uv + srcTexel * vec2(-1.0, -1.0), 0.0).rgb +
        textureLod(bloomSourceMip, uv + srcTexel * vec2( 1.0, -1.0), 0.0).rgb +
        textureLod(bloomSourceMip, uv + srcTexel * vec2(-1.0,  1.0), 0.0).rgb +
        textureLod(bloomSourceMip, uv + srcTexel * vec2( 1.0,  1.0), 0.0).rgb);
    tent *= (1.0 / 16.0);

    vec3 own = imageLoad(bloomTargetMip, pixel).rgb;

    imageStore(bloomTargetMip, pixel, vec4(own + tent, 1.0));
}
