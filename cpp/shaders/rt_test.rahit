vec4 sampleParticleAlphaAtlas(uint textureSlot, vec2 uv)
{
    switch(textureSlot)
    {
        case 1u: return textureLod(particleAtlases[0], uv, 0.0);
        case 2u: return textureLod(particleAtlases[1], uv, 0.0);
        case 3u: return textureLod(particleAtlases[2], uv, 0.0);
        default: return vec4(0.0);
    }
}


// 2026-10-23：原来这里是 5 份副本之一（且返回类型漂成了 int，其余四份是
// uint），已收进透明剖面共享头，统一返回 uint。本文件的 AnyHit 剖面消费函数
// getTransparentProfileTransmissionAnyHit 同步改成 uint —— glslang 的重载
// 解析**不做** uint→int 隐式转换（实编译报 "no matching overloaded function
// found"），所以不能靠隐式转换糊过去。
#include "transparent_profile_common.glsl"

// Same per-profile dense-body scale as rt_test.rgen's
// getTransparentProfileTransmission, so visibility (shadows, AO and local
// lights) attenuates exactly as much as the surface path transmits.
//   1 tinted glass / 2 ice / 3 slime / 4 honey, 0 = clear or stained glass.
float getTransparentProfileTransmissionAnyHit(uint transparentProfile)
{
    if(transparentProfile == 1u)
    {
        return 0.06;
    }
    if(transparentProfile == 2u)
    {
        return 0.55;
    }
    if(transparentProfile == 3u)
    {
        return 0.45;
    }
    if(transparentProfile == 4u)
    {
        return 0.32;
    }
    return 1.0;
}

vec3 computeGlassBlockTransmissionAnyHit(
    vec3 glassTint,
    float glassAlpha,
    int transparentProfile
)
{
    // Orion: transmission_color = base_color RGB, clamped.
    return clamp(glassTint, vec3(0.0), vec3(1.0));
}

// =====================================================
// Glass optical model (straight-through).
// thinSheetFactors() and glassSheetTransmission() implement the thin-sheet
// surface_bsdf model; the latter matches
// surfaceShadowTransmission() for a straight connection.
// =====================================================
// Disabled (no call sites): kept as a future interface option.  The
// scalar-F fast path below is arithmetically identical for the uniform
// 0.04 glass F0 and skips the unused reflection term.
#if 0
vec3 fresnelSchlick(
    float cosTheta,
    vec3 F0
)
{
    return
        F0 +
        (
            vec3(1.0) - F0
        ) *
        pow(
            1.0 - cosTheta,
            5.0
        );
}

void glassThinSheetFactors(
    vec3 fresnel,
    vec3 transmittance,
    out vec3 reflection,
    out vec3 transmission
)
{
    vec3 f = clamp(fresnel, vec3(0.0), vec3(1.0));
    vec3 a = clamp(transmittance, vec3(0.0), vec3(1.0));
    vec3 oneMinusF = vec3(1.0) - f;
    vec3 denominator = max(vec3(1.0) - f * f * a * a, vec3(1.0e-6));
    reflection = f + oneMinusF * oneMinusF * f * a * a / denominator;
    transmission = oneMinusF * oneMinusF * a / denominator;
}

vec3 glassSheetTransmission(
    vec3 transmissionColor,
    vec3 faceNormal,
    vec3 directionToLight
)
{
    float cosine = clamp(
        abs(dot(normalize(faceNormal), normalize(directionToLight))),
        0.0,
        1.0
    );
    vec3 reflection;
    vec3 transmission;
    glassThinSheetFactors(
        fresnelSchlick(cosine, vec3(0.04)),
        transmissionColor,
        reflection,
        transmission
    );
    return transmission;
}
#endif

// Scalar-F fast path.  The glass F0 (0.04) is uniform across RGB, so
// Schlick Fresnel collapses to one scalar and the Orion thin-sheet
// series becomes transmission = (1-F)^2 * T / (1 - F^2 * T^2).  The x^5
// power expands into multiplies: exact, and off the SFU pipe.  Both
// inputs below are unit length (geometricNormal is normalised at the call
// site, gl_WorldRayDirectionEXT is unit by spec), so no renormalisation
// is needed here.
vec3 glassSheetTransmissionScalarF(
    vec3 transmissionColor,
    float cosTheta
)
{
    float x = 1.0 - clamp(cosTheta, 0.0, 1.0);
    float x2 = x * x;
    float fresnel = 0.04 + 0.96 * (x2 * x2) * x;
    float oneMinusF = 1.0 - fresnel;
    vec3 a = clamp(transmissionColor, vec3(0.0), vec3(1.0));
    vec3 denominator = max(
        vec3(1.0) - (fresnel * fresnel) * (a * a),
        vec3(1.0e-6)
    );
    return (oneMinusF * oneMinusF) * a / denominator;
}

void main() {

    // 2026-10-09：表项是 16B，地址在两个低 lane（any-hit 不需要位移段）。
    // 2026-10-21 地形 32B：.w = 该段顶点步长（32/48），取顶点按它分派。
    const uvec4 sectionAddressEntry =
        sectionVertexAddressBuffer.vertexAddresses[
            gl_InstanceCustomIndexEXT
        ];

    uint64_t rawAddr =
        packUint2x32(sectionAddressEntry.xy);
    if (rawAddr == 0ul) return;

    // 2026-10-22 索引化地形：.w 最低位 = "4 顶点/quad 索引布局"（图案 0,1,2 / 0,2,3，
    // 见 VulkanCore.cpp:sectionQuadIndexAddress）。真实步长 = .w & ~1u —— 必须掩掉
    // 低位，否则 33 会被 loadSectionVertex 当成"非 32B"而按 48B 读。
    // 三角形 t（= gl_PrimitiveID）的三个角：
    //   t 偶 ⇒ 4q+0, 4q+1, 4q+2；t 奇 ⇒ 4q+0, 4q+2, 4q+3（q = t>>1）。
    // 与非索引展开 (v0,v1,v2) / (v0,v2,v3) 逐角对应 ⇒ 重心坐标语义不变。
    const bool indexedQuads =
        (sectionAddressEntry.w & 1u) != 0u;

    const uint sectionStride =
        sectionAddressEntry.w & ~1u;

    const uint primitiveId =
        uint(gl_PrimitiveID);

    uint i0;
    uint i1;
    uint i2;

    if(indexedQuads)
    {
        const uint quadBase =
            (primitiveId >> 1u) * 4u;

        if((primitiveId & 1u) == 0u)
        {
            i0 = quadBase;
            i1 = quadBase + 1u;
            i2 = quadBase + 2u;
        }
        else
        {
            i0 = quadBase;
            i1 = quadBase + 2u;
            i2 = quadBase + 3u;
        }
    }
    else
    {
        i0 = primitiveId * 3u;
        i1 = i0 + 1u;
        i2 = i0 + 2u;
    }

    Vertex v0 = loadSectionVertex(rawAddr, sectionStride, i0);
    Vertex v1 = loadSectionVertex(rawAddr, sectionStride, i1);
    Vertex v2 = loadSectionVertex(rawAddr, sectionStride, i2);

    vec3 barycentrics = vec3(1.0 - attribs.x - attribs.y, attribs.x, attribs.y);

    // === 远场去重（Vista 模型）===
    // 几何角色来自 binding 19 的角色表，不再是顶点里的 pad1 暗号。
    // 命中点落在近场已就绪的 chunk 柱上时，远场命中只是同一片几何的粗表示，直接丢弃。
    const uint instanceRole = lodInstanceRole();
    const vec3 hitWorldPosition =
        vec3(v0.x, v0.y, v0.z) * barycentrics.x +
        vec3(v1.x, v1.y, v1.z) * barycentrics.y +
        vec3(v2.x, v2.y, v2.z) * barycentrics.z;

    if(lodHitIsRedundant(instanceRole, hitWorldPosition))
    {
        ignoreIntersectionEXT;
        return;
    }

    float interpU = v0.u * barycentrics.x + v1.u * barycentrics.y + v2.u * barycentrics.z;
    float interpV = v0.v * barycentrics.x + v1.v * barycentrics.y + v2.v * barycentrics.z;
    vec2 texCoord = vec2(interpU, interpV);

    float materialId =
        v0.materialId * barycentrics.x +
        v1.materialId * barycentrics.y +
        v2.materialId * barycentrics.z;

    float voxyAnyHitMarker =
        v0.pad1 * barycentrics.x +
        v1.pad1 * barycentrics.y +
        v2.pad1 * barycentrics.z;
    // 2026-10-03：与 rt_test.rchit 同源修复 —— pad1 数值暗号会撞车（雨条 marker
    // = -2 与 voxy 的岩浆/光源标记 -2 完全相同），改为**认角色表**：只有
    // LOD_ROLE_VOXY_LOD 的实例才走 voxy 分支，雨/粒子/实体保持自己的路径。
    // 2026-10-03 决定性与 rchit 同名块一致：**voxy 分类默认关闭**（VOXY_LOD_ENABLE），
    // 否则实体/粒子/雨滴的负 pad1 标记会被误判成 voxy，整条动态几何被 alpha 剪裁吞掉。
#ifndef VOXY_LOD_ENABLE
#define VOXY_LOD_ENABLE 0
#endif
    bool isVoxyAnyHit =
        VOXY_LOD_ENABLE != 0 && voxyAnyHitMarker < -0.5 && materialId > 0.5;

    // DH 远场几何不做 alpha cutout：
    // 它的顶点 a 是打包光照 (skyLight<<4)|blockLight，不是 alpha ⇒ 无光格 a=0 会被
    // 下面的 combinedAlpha 判据整片剔掉（空洞 / 看穿地形）。DH 目前走的是
    // SBT_RECORD_ALPHA（translucent 的 any-hit），这里是护栏：万一路由改了，
    // 不要因为一个数据字节把几何静默吃掉。理由详见 rt_test_translucent.rahit 同名块。
    //
    // ★ 判据由 pad1 < -2.5 改为角色表：pad1 现在只表示 DH 材质编号，
    //   不再兼任"是不是远场"的选址暗号（见 lod_coverage.glsl 顶部说明）。
    if(instanceRole == LOD_ROLE_DH_FAR)
    {
        return;
    }

    float encodedTextureSlot =
        isVoxyAnyHit ? 0.0 :
        (v0.pad2 * barycentrics.x +
         v1.pad2 * barycentrics.y +
         v2.pad2 * barycentrics.z);
    uint entityTextureSlot = encodedTextureSlot > 0.5
        ? uint(round(encodedTextureSlot)) : 0u;
    uint particleTextureSlot = encodedTextureSlot < -0.5
        ? uint(round(-encodedTextureSlot)) : 0u;
    float particleMarker =
        v0.pad1 * barycentrics.x +
        v1.pad1 * barycentrics.y +
        v2.pad1 * barycentrics.z;
    bool isRtWeatherRain =
        particleTextureSlot != 0u &&
        particleMarker < -1.5;

    // Rain should be visible only to the primary camera.  It must never
    // shadow, occlude AO/GI/reflections, or participate in water/interface
    // classification.
    //
    // 2026-09-20: extended from weather rain to EVERY captured particle.
    // A particle quad is a camera-facing billboard, not world geometry, so
    // any secondary ray hit turns into a hard parallelogram artefact: an
    // invisible caster dropped a solid dark footprint onto the water floor
    // (sun visibility) and the underwater view was silhouetted by sprites
    // (water transmission).  Particles stay visible to the primary camera
    // ray exactly as before; they simply stop being occluders.
    if(particleTextureSlot != 0u && getRayPurpose(payload.state) != RT_PURPOSE_PRIMARY_SKY)
    {
        ignoreIntersectionEXT;
        return;
    }

    // =====================================================
    // T1-2 Straight transparent continuation
    //
    // Only the dedicated continuation ray ignores generic
    // translucent terrain (vertex materialId=2). Normal primary,
    // AO, sun and Local-Light visibility behavior is unchanged.
    // =====================================================
    bool transparentPassthrough =
        getRayPurpose(payload.state) == RT_PURPOSE_PASSTHROUGH;


    // 提取顶点颜色 / Alpha 与图集颜色 / Alpha。
    // The alpha test defines the visible cutout silhouette.  It must
    // use the same unfiltered base-atlas texel as closest-hit, otherwise
    // linear filtering turns foliage and grass into semi-transparent blur.
    vec4 atlasSample;
    if(isVoxyAnyHit)
    {
        // Voxy LOD quads carry their resolved alpha in the vertex colour;
        // their (u, v) are atlas-mip coordinates, not Minecraft atlas UVs.
        atlasSample = vec4(1.0);
    }
    else if(isRtWeatherRain)
    {
        // Each weather quad selects one tile from the dedicated RGBA streak
        // atlas.  The authored alpha replaces the analytic rectangle mask.
        atlasSample = textureLod(rainStreakAtlas, texCoord, 0.0);
    }
    else if(particleTextureSlot != 0u)
    {
        atlasSample = sampleParticleAlphaAtlas(particleTextureSlot, texCoord);
    }
    else if(entityTextureSlot != 0u)
    {
        atlasSample = sampleEntityAlphaAtlas(entityTextureSlot, texCoord);
    }
    else
    {
        ivec2 atlasSize = textureSize(blockAtlas, 0);
        ivec2 atlasTexel = ivec2(
            clamp(
                floor(texCoord * vec2(atlasSize)),
                vec2(0.0),
                vec2(atlasSize) - vec2(1.0)
            )
        );
        atlasSample = texelFetch(blockAtlas, atlasTexel, 0);
    }


    // =====================================================
    // CLASSIFY ray fast path
    //
    // Water sun-transmittance/classification rays must never
    // be discarded by foliage alpha or transparent traversal.
    // The closest-hit shader owns the final material state.
    // =====================================================
    if(getRayPurpose(payload.state) == RT_PURPOSE_CLASSIFY)
    {
        return;
    }


    vec4 vertexColor =
        vec4(
            v0.r,
            v0.g,
            v0.b,
            v0.a
        ) *
        barycentrics.x +
        vec4(
            v1.r,
            v1.g,
            v1.b,
            v1.a
        ) *
        barycentrics.y +
        vec4(
            v2.r,
            v2.g,
            v2.b,
            v2.a
        ) *
        barycentrics.z;


    float combinedAlpha =
        atlasSample.a *
        vertexColor.a;


    // The authored rain atlas carries anti-aliased low-alpha edges.  Keep
    // those edges instead of applying the foliage/particle cutout threshold;
    // all other material routes retain their established 0.1 cutoff.
    float alphaCutoff = isRtWeatherRain ? 0.025 : 0.1;

    // =====================================================
    // 2026-10-01：玻璃"全覆盖"（GI_GLASS_FULL_COVERAGE），与
    // rt_test_translucent.rahit 的同名块一致：玻璃在追踪器里是几何边界，覆盖率
    // 由几何决定，透明度由材质（染料/透射权重）表达。口径见
    // docs/GLASS_COVERAGE_20260914.md：
    //   "Glass blocks and panes use opaque coverage ... Base texture alpha neither
    //    removes surface samples nor scales transmission."
    // 之前这条会把 alpha < 0.1 的玻璃命中整片剔掉 ⇒ 玻璃上出现针孔/缺角。
    // 只绕过 cutout，后面的可见性（GLASS_VISIBILITY）分支行为不变。
    // A/B：-DGI_GLASS_FULL_COVERAGE=0
    // =====================================================
#ifndef GI_GLASS_FULL_COVERAGE
#define GI_GLASS_FULL_COVERAGE 1
#endif

    bool glassFullCoverage =
        GI_GLASS_FULL_COVERAGE != 0 &&
        materialId >= 2.0 &&
        materialId < 2.5;

    // 2026-10-06 末地传送门：类 7 = **不裁切**（见 EntityRtCapture.MATERIAL_CLASS_UNCUTOUT）。
    // end_portal.png 是**大片透明的星幕**，走下面的 cutout 会被整片剔掉 ⇒ 观感就是
    // "门没渲染"。实测日志已证明捕获链路全对（geometry captured / 贴图正确 / 槽位 28 /
    // 无 slot table full）⇒ 只剩裁切这一环。只对类 7 放行，其余实体/粒子/雨照旧。
    // 类号编码在纹理槽的**小数位**（Java: textureSlot + class/32 ⇒ rchit 用
    // floor(fract(slot)*32 + 0.5) 解），这里用同一个约定。
    bool uncutoutEntity = false;
    if(entityTextureSlot != 0u)
    {
        float entityClass = floor(fract(encodedTextureSlot) * 32.0 + 0.5);
        uncutoutEntity = entityClass > 6.5 && entityClass < 7.5;
    }
    if(!uncutoutEntity && !glassFullCoverage && combinedAlpha < alphaCutoff)
    {
        ignoreIntersectionEXT;
        return;
    }
    if(isRtWeatherRain)
    {
        // Ray tracing has no fixed-function alpha blending here.  Use stable
        // per-pixel coverage so the streak atlas alpha reveals the background
        // instead of turning every surviving texel into an opaque card.
        uint coverageSeed =
            gl_LaunchIDEXT.x * 0x9E3779B9u ^
            gl_LaunchIDEXT.y * 0x85EBCA6Bu ^
            uint(gl_PrimitiveID) * 0xC2B2AE35u;
        coverageSeed ^= coverageSeed >> 16u;
        coverageSeed *= 0x7FEB352Du;
        coverageSeed ^= coverageSeed >> 15u;
        coverageSeed *= 0x846CA68Bu;
        coverageSeed ^= coverageSeed >> 16u;
        float coverageNoise = float(coverageSeed & 0x00FFFFFFu) *
            (1.0 / 16777216.0);
        if(coverageNoise >= combinedAlpha)
        {
            ignoreIntersectionEXT;
            return;
        }
    }
    if(
    transparentPassthrough &&
    glassChainIsTranslucentMaterial(materialId)
)
{
    ignoreIntersectionEXT;
    return;
}


    // =====================================================
    // T1/T9/T3 COMBINED - colored visibility through glass
    //
    // -3 visibility rays are used by Sun / Local Light / AO.
    // Glass must NOT terminate them.
    //
    // We accumulate RGB transmittance in payload.albedo.
    // Opaque geometry is still accepted and terminates normally.
    // =====================================================

    // =====================================================
    // 2026-10-25 阶段 D：主射线透射的"单条射线 + 逐面累乘"
    //
    // 参考 dxvk-remix geometry_resolver.slangh:3169-3213 —— 玻璃在遍历里被消耗，
    // 第一个不透明面才是接收面。这样穿几层玻璃，下游都只有**一个**接收面、
    // 一套 guide/历史，递归路径里"第二/三层共用第一层历史键"造成的固定形状噪点
    // 就不存在了。
    //
    // 相机打到的**第一片**不在这里乘（由 main 的 glassTransmission 负责）。
    // 开关：-DORION_GLASS_SINGLE_PASS=0 ⇒ 本分支不参与编译（回递归旧档）。
    // =====================================================
#ifndef ORION_GLASS_SINGLE_PASS
#define ORION_GLASS_SINGLE_PASS 1
#endif
#if ORION_GLASS_SINGLE_PASS
    if(isPrimaryTransmissionRay(payload.state) &&
       isGlassPaneVertexMaterial(materialId))
    {
        vec3 pos0 = vec3(v0.x, v0.y, v0.z);
        vec3 pos1 = vec3(v1.x, v1.y, v1.z);
        vec3 pos2 = vec3(v2.x, v2.y, v2.z);
        vec3 geometricNormal = normalize(cross(pos1 - pos0, pos2 - pos0));

        vec3 paneTint = vptSaturateGlassTransmission(
            clamp(glassPaneTransmissionColor(atlasSample.rgb, vertexColor.rgb),
                  vec3(0.0), vec3(1.0)));

        float paneCos = clamp(abs(dot(geometricNormal, gl_WorldRayDirectionEXT)), 0.0, 1.0);

        // 与 main 侧同一分工：glassSheetTransmissionScalarF 给能量（含薄片菲涅耳
        // 与染料浓度），色相由 paneTint 归一化承担 ⇒ 灰玻璃退化为纯标量、彩玻保留颜色。
        // 与 main 侧**同一个**函数：真实板厚 + Snell 折射角 + 薄片几何级数。
        // 之前这里用的是 glassSheetTransmissionScalarF（固定 1 格厚），与 main 的
        // 物理模型口径不一致 —— 现在两边共用 glassChainEventThroughput()。
        const vec3 chainHitPos =
            gl_WorldRayOriginEXT + gl_WorldRayDirectionEXT * gl_HitTEXT;

        const uint chainProfileRaw =
            getTransparentProfileFromRawMaterialId(materialId);

        vec3 paneTransmission = glassChainEventThroughput(
            paneTint,
            glassSlabThicknessFromFace(chainHitPos, geometricNormal),
            geometricNormal,
            gl_WorldRayDirectionEXT,
            glassIorForProfile(int(chainProfileRaw)));

#if VPT_GLASS_ALPHA_BLEND
        // 2026-10-26 对齐 RTX Remix：alpha blend 口径，与 main 侧同一公式。
        // 注意不用 vptSaturateGlassTransmission 的 ×3 饱和增强 —— 那是给"薄壁染料
        // 当滤光片"用的，alpha blend 要的是原色。
        // 与 main 侧同源：texture x vertex 的 alpha（Remix-MC BlockTextureManager.java:64）。
        // 2026-10-27：玻璃族的源 alpha 上限。
        // 贴图边框 texel 的 alpha = 1.0，掠射时边框铺满整个面 ⇒ 侧面"实心"。
        // 主体（alpha 0.4）不受影响，只有接近不透明的 texel 被压下来。
#ifndef GLASS_ALPHA_BLEND_MAX_ALPHA
#define GLASS_ALPHA_BLEND_MAX_ALPHA 0.3
#endif
        // 2026-10-27：玻璃族用固定 alpha（贴图 alpha 只作颜色）。
        // 不再取 atlasSample.a —— 边框 texel 是 1.0，侧面整块落在边框上 ⇒ 实心。
        // 致密体（遮光玻璃等）仍按 profile 抬高不透明度。
        const float chainAlpha = max(
            GLASS_FIXED_ALPHA,
            1.0 - clamp(getTransparentProfileTransmissionAnyHit(chainProfileRaw),
                        0.0, 1.0));
#if VPT_GLASS_ALPHA_BLEND_DEFERRED_COMPOSITE
        // =====================================================
        // 2026-10-28：**清玻璃必须当空气跳过**。
        //
        // 主命中侧的清玻璃走 rgen 的 clearGlassAsAir 分支 —— 那里用
        // mix(背景, 贴图×光, 贴图 alpha) 就地合成，**不写** 73/74 图。
        // 但同一块玻璃的出射面会走到这里：一旦被记成一层，宿主清过的
        // 74.y 就变成 hitT > 0，glass_alpha_finish 会把已经 mix 过的
        // rtOutput 再合成一次（rtOutput*bgT + 表面项）⇒ 同一块玻璃一半
        // 像素透、一半像素发实（差在"这条视线的链里有没有第二片清玻璃面"）。
        //
        // 判据与 rchit 的 RT_STATE_CLEAR_GLASS_BIT 同源
        // （materialId < 2.05 && 顶点色是原版灰面明暗 ⇒ 没注入染料）。
        // 回退：-DORION_GLASS_CLEAR_PANE_SKIP=0。
        // =====================================================
#ifndef ORION_GLASS_CLEAR_PANE_SKIP
#define ORION_GLASS_CLEAR_PANE_SKIP 1
#endif
#if ORION_GLASS_CLEAR_PANE_SKIP
        if(materialId < 2.05 &&
           glassVertexFactorIsFaceShade(vertexColor.rgb))
        {
            // 仍然消耗一格预算：清玻璃当空气，但不能让一条射线在
            // "玻璃墙"里无限穿下去（性能与栈深）。
            payload.glassFaceBudget = payload.glassFaceBudget + 1.0;
            if(payload.glassFaceBudget >= float(ORION_GLASS_CHAIN_MAX_FACES))
            {
                return;
            }
            ignoreIntersectionEXT;
            return;
        }
#endif

        // =====================================================
        // 2026-10-26（第四轮，严格搬 RTX Remix）
        //
        // ① 两档 opacity 早退（algorithm/resolve.slangh:471-524）
        //    opacity >= resolveOpaquenessThreshold  ⇒ 当不透明，不记录；
        //    opacity <= resolveTransparencyThreshold ⇒ 当全透，不记录、直接穿。
        // ② 中间档：每个相遇面都是**一层候选**，走同一个 update()。
        //    原文没有"一个体只算一次"的概念 —— 那是本引擎旧口径
        //    （glassChainAcceptEntry），已在这里停用。
        // ③ bgT < 1/255 ⇒ 不再继续穿透（geometry_resolver.slangh:2201-2204）。
        // =====================================================
        if(chainAlpha <= GLASS_ALPHA_BLEND_TRANSPARENCY_THRESHOLD)
        {
            ignoreIntersectionEXT;
            return;
        }

        if(chainAlpha >= GLASS_ALPHA_BLEND_OPAQUENESS_THRESHOLD)
        {
            // 不记录、不 ignore ⇒ 作为遮挡终止（原文 resolveVertexFinalHit）。
            return;
        }

        const vec3 chainPaneAlbedo =
            glassPaneTransmissionColor(atlasSample.rgb, vertexColor.rgb);

        // 面预算照旧推进：这套口径下 transmittanceAccum 不再变化，
        // 终止只能靠 bgT 与预算两条，所以预算必须每层加一（防无限穿透）。
#if VPT_GLASS_ALPHA_BLEND_SINGLE_LAYER
        // 2026-10-27：整条链只记录**最近的一层**。
        // 背景透射率保持 1-a（而非 Π(1-a)），异色玻璃也不会混成第三种颜色。
        // 用户实测："不同颜色的彩色玻璃是实的，只有同色才透" —— 那句现象就是
        // Π(1-a) + 随机选层在异色下的必然结果。
        // 2026-10-28 修：唯一槽位必须留给**最近**的那一层 = 相机主命中面
        // （rgen 在 trace 返回之后写入）。any-hit 命中的永远是"第二近"的面，
        // 让它先占槽位等于把最近层挤掉，最近层只能靠随后那次 update 的抽签
        // （p = a ≈ 0.3）抢回来 ⇒ 逐像素在"近面/远面"之间随机，表现为同一块
        // 玻璃有的地方透、有的地方实，且逐帧闪。
        const bool acceptLayer = false;
#else
        const bool acceptLayer = true;
#endif

        payload.glassFaceBudget = payload.glassFaceBudget + 1.0;

        if(!acceptLayer)
        {
            // 后续玻璃仍然穿透（不记录、不累乘 bgT）。
            ignoreIntersectionEXT;
            return;
        }

        const float chainBackgroundTransparency =
            glassAlphaBlendSurfaceUpdate(
                ivec2(gl_LaunchIDEXT.xy),
                vec4(chainPaneAlbedo / max(chainAlpha, 1.0e-3), chainAlpha),
                geometricNormal,
                gl_HitTEXT,
                float(gl_InstanceCustomIndexEXT & 0x7fffu));

        if(chainBackgroundTransparency <
           GLASS_ALPHA_BLEND_MIN_BACKGROUND_TRANSPARENCY)
        {
            return;
        }
#elif VPT_GLASS_ALPHA_BLEND_SURFACE_RADIANCE
        // 加性口径（旧档，A/B 保留）
        bool chainAcceptLayer;
#if VPT_GLASS_ALPHA_BLEND_PAIR_FACES
        chainAcceptLayer = true;
        payload.glassFaceBudget = payload.glassFaceBudget + 1.0;
#else
        chainAcceptLayer = glassChainAcceptEntry(payload, gl_HitTEXT);
#endif
        if(chainAcceptLayer)
        {
            vec3 chainTransmission;
            vec3 chainSurfaceWeight;
            glassAlphaBlendLayerTerms(
                glassPaneTransmissionColor(atlasSample.rgb, vertexColor.rgb),
                chainAlpha,
                chainTransmission,
                chainSurfaceWeight);
            payload.glassSurfaceWeightAccum +=
                payload.transmittanceAccum * chainSurfaceWeight;
            payload.transmittanceAccum *= chainTransmission;
        }
#else
        paneTransmission = glassAlphaBlendTransmission(
            glassPaneTransmissionColor(atlasSample.rgb, vertexColor.rgb),
            chainAlpha);

        // 一个半透明体只乘一次（进入面）。介质状态推进也在契约里。
        if(glassChainAcceptEntry(payload, gl_HitTEXT))
        {
            payload.transmittanceAccum *= paneTransmission;
        }
#endif
#else
        // 一个半透明体只乘一次（进入面）。介质状态推进也在契约里。
        if(glassChainAcceptEntry(payload, gl_HitTEXT))
        {
            payload.transmittanceAccum *=
                paneTransmission *
                getTransparentProfileTransmissionAnyHit(chainProfileRaw);
        }
#endif

        // 终止判据唯一一处（累积透射 / 面预算）。
        if(glassChainShouldAbort(
               payload.transmittanceAccum,
               payload.glassFaceBudget))
        {
            return;
        }

        ignoreIntersectionEXT;
        return;
    }
#endif

    bool glassVisibilityOnly =
        getRayPurpose(payload.state) == RT_PURPOSE_GLASS_VISIBILITY;


if(
    glassVisibilityOnly &&
    materialId >= 2.0 &&
    materialId < 2.5
)
    {
        // The rain-puddle path reuses this visibility ray.  Preserve a
        // coverage bit even for clear glass, whose RGB transmission can be
        // exactly white and therefore cannot identify a roof by colour.
        payload.glassAlpha = 1.0;

#ifndef GI_CLEAR_GLASS_VISIBILITY_AS_AIR
#define GI_CLEAR_GLASS_VISIBILITY_AS_AIR 1
#endif
#if GI_CLEAR_GLASS_VISIBILITY_AS_AIR
        // =====================================================
        // 2026-10-24（用户要求）：可见性射线里，普通（未染色）玻璃也当空气。
        //
        // 相机主路径 2026-10-07 起、GI 走查 2026-10-13 起都是这条口径，但
        // 太阳/AO/本地光的可见性 any-hit 一直漏着：清玻璃在这里仍要乘
        // glassPaneTransmissionColor（清玻璃 = 白 sprite × 灰面 shade ⇒
        // 0.5~1.0，随被穿过的面朝向变）× 薄片 Fresnel（正入射 ≈0.92）⇒
        // 隔着清玻璃的阳光/灯光被压暗 8%~50%，且阴影深浅跟着面朝向走 ——
        // 这就是"清玻璃根本没当空气"。
        //
        // 判据与 rchit 置 RT_STATE_CLEAR_GLASS_BIT 的完全同源：
        // glassVertexFactorIsFaceShade（顶点色恰为四档灰面 shade ⇒ 没注入染料）。
        // 染色玻璃（含白/灰染料，色值不等于四档 shade）不受影响。
        //
        // 面序/预算的副作用核对：
        //   · 跳过 = 本体贡献 0 个面；旧档贡献 2 个面（进+出，偶数）⇒ 下游
        //     染色玻璃的奇偶不变；
        //   · 清玻璃不再消耗 GI_GLASS_VISIBILITY_MAX_FACES 预算（空气不该消耗）。
        // A/B：-DGI_CLEAR_GLASS_VISIBILITY_AS_AIR=0 逐位回到旧档。
        // =====================================================
        if(materialId < 2.05 &&
            glassVertexFactorIsFaceShade(vertexColor.rgb))
        {
            ignoreIntersectionEXT;
            return;
        }
#endif

        // The visibility ray is receiver -> emitter.  For each traversed
        // glass block its first accepted face is the real light-exit face;
        // only that face receives the Orion boundary sheet, so one
        // block contributes exactly one filter.
        #ifndef ORION_GLASS_MEDIUM_STATE
        // 2026-10-25 阶段 C 总闸（默认 1）。置 0 = 逐位回到面序奇偶旧档。
        #define ORION_GLASS_MEDIUM_STATE 1
        #endif
        #if ORION_GLASS_MEDIUM_STATE
        // =====================================================
        // 介质状态机（替换面序奇偶）
        //
        // 参考 dxvk-remix：concept/surface_material/translucent_surface_material_
        // interaction.slangh:542 的 inout bool insideMedium —— 进入界面时乘一次整片
        // 薄片滤波并置位，出射界面不再乘。
        //
        // 与旧奇偶的差别（这是接缝亮线的根）：
        //   奇偶模型里 Minecraft 裁掉半透明体贴不透明方块的那一面 => 该体只贡献 1 个
        //   面 => 从这点起整条射线下游全部翻转 => 下游丢一次 filter => 亮线。
        //   状态机里同一件事只会让状态多留一格：下一个被接受面若距进入面 > 1.5 格，
        //   判为「上一块的出射面被裁」，按新进入处理并重新乘一次 filter，下游不再受影响。
        //
        // 预算是面数口径：每进入一次记 2 面（进+出），与旧档
        // GI_GLASS_VISIBILITY_MAX_FACES = 16 面 = 8 层逐值同义。
        // =====================================================
        const bool glassWasInside = payload.glassInside > 0.5;
        const bool glassRegionBreak =
            payload.glassEntryT >= 0.0 &&
            gl_HitTEXT - payload.glassEntryT > 1.5;
        const bool isLightExitFace = !glassWasInside || glassRegionBreak;

        if(isLightExitFace)
        {
            payload.glassInside = 1.0;
            payload.glassEntryT = gl_HitTEXT;
            payload.glassFaceBudget = payload.glassFaceBudget + 2.0;
        }
        else
        {
            payload.glassInside = 0.0;
        }

        payload.lastGlassFaceT = gl_HitTEXT;
        #else
        uint glassFaceOrdinal =
            uint(
                max(
                    floor(payload.parallaxRayTravel + 0.5),
                    0.0
                )
            );

#ifndef GI_GLASS_SEAM_RESET
#define GI_GLASS_SEAM_RESET 1
#endif
#if GI_GLASS_SEAM_RESET
        // =====================================================
        // 2026-10-24：半透明区域断开处重置面序（修"贴不透明方块的一像素亮线"，
        // 机制见 HANDOFF-2026-10-24-TRANSLUCENT-SEAM.md §2，用户已确认）。
        //
        // Minecraft 会裁掉半透明体与不透明方块之间共用的那一面。射线在那里
        // 只穿过 1 个面（奇数）⇒ 奇偶从这点起整体翻转 ⇒ 同一条射线上游之外
        // 的所有玻璃/冰的 isLightExitFace 判反 ⇒ 下游本该乘 filter 的面被跳过
        // —— filter 是乘法只会变暗，"少乘"才是亮线。
        //
        // 面距口径（沿同一根射线量）：
        //   同一个体进/出面 = 1.0 格（薄片更小）
        //   相邻两格玻璃之间那一面被裁掉 = 2.0 格
        //   中间隔 N 格空气的下一个体 = N 格（N=1 时仍是 1.0）
        // 阈值 1.5 ⇒ 只把"整格被裁掉"当新区域，不切开隔 1 格空气的两段。
        // 已知副作用：相邻同种玻璃每格各补一次 filter（旧档 2 格只 1 次）
        // —— "一片一滤"的预期语义，多层会均匀略暗（验证判据第 3 条）。
        // A/B：-DGI_GLASS_SEAM_RESET=0 逐位回到旧档。
        // =====================================================
        if(payload.lastGlassFaceT >= 0.0 &&
            gl_HitTEXT - payload.lastGlassFaceT > 1.5)
        {
            glassFaceOrdinal = 0u;
        }
        payload.lastGlassFaceT = gl_HitTEXT;
#endif

        bool isLightExitFace =
            (glassFaceOrdinal & 1u) == 0u;

        // 2026-10-24：面序（可被断开重置）与穿层预算（永不重置）拆成两个字段
        // —— parallaxRayTravel 只剩面序一个用途，重置不再连预算一起清零。
        payload.parallaxRayTravel =
            float(glassFaceOrdinal + 1u);
        payload.glassFaceBudget =
            payload.glassFaceBudget + 1.0;
        #endif


        if(isLightExitFace)
        {
            vec3 pos0 = vec3(v0.x, v0.y, v0.z);
            vec3 pos1 = vec3(v1.x, v1.y, v1.z);
            vec3 pos2 = vec3(v2.x, v2.y, v2.z);

            vec3 geometricNormal =
                normalize(
                    cross(pos1 - pos0, pos2 - pos0)
                );

            vec3 glassTint =
                glassPaneTransmissionColor(
                    atlasSample.rgb,
                    vertexColor.rgb
                );

#ifndef GI_SUN_POOL_SATURATION
// 2026-10-05 G8 太阳彩色透射光斑：太阳路径的玻璃染色对齐本地光路径的
// 峰值保饱和处理（vptSaturateGlassTransmission，×3 峰值保持）。此前太阳
// 路径用原始染色 ⇒ 彩玻光斑比本地光路径的褪灰、不鲜艳。峰值保持 =
// 主通道能量不变、只去灰 ⇒ 不加能量不压暗；白色/灰色玻璃恒等 ⇒ 逐位旧档。
// （原注释"deliberately local-light only"的Scope差异就此对齐。）
#define GI_SUN_POOL_SATURATION 1
#endif
#if GI_SUN_POOL_SATURATION
            glassTint =
                vptSaturateGlassTransmission(
                    clamp(glassTint, vec3(0.0), vec3(1.0))
                );
#endif
            float glassCosTheta =
                clamp(
                    abs(dot(geometricNormal, gl_WorldRayDirectionEXT)),
                    0.0,
                    1.0
                );

            payload.albedo *=
                glassSheetTransmissionScalarF(
                    glassTint,
                    glassCosTheta
                ) *
                getTransparentProfileTransmissionAnyHit(
                    getTransparentProfileFromRawMaterialId(materialId)
                );
        }


        // =====================================================
        // 2026-10-17：玻璃穿层预算（可见性射线）—— 与
        // rt_test_translucent.rahit 的同名块逐字同源（那份有完整推导）。
        // 玻璃不终止可见性射线，只累乘透射色，此前没有上限 ⇒ 太阳/AO/本地光
        // 的层数成本无界。这里补齐"累计透射 < 1%（= 太阳 march 的 W2 阈值）
        // 或面数超限 ⇒ 当遮挡收尾"的口径。
        // A/B：-DGI_GLASS_VISIBILITY_BUDGET=0 ⇒ 逐位回到旧档。
        // =====================================================
#ifndef GI_GLASS_VISIBILITY_BUDGET
#define GI_GLASS_VISIBILITY_BUDGET 1
#endif
#ifndef GI_GLASS_VISIBILITY_MIN_TRANSMITTANCE
#define GI_GLASS_VISIBILITY_MIN_TRANSMITTANCE 0.01
#endif
#ifndef GI_GLASS_VISIBILITY_MAX_FACES
#define GI_GLASS_VISIBILITY_MAX_FACES 16
#endif
#if GI_GLASS_VISIBILITY_BUDGET
        // 2026-10-24：预算改读独立计数器 glassFaceBudget（面序可重置，预算不可）
        // —— 表达式与旧档 glassFaceOrdinal + 1u >= MAX 逐值同义。
        if(
            max(
                payload.albedo.r,
                max(payload.albedo.g, payload.albedo.b)
            ) < GI_GLASS_VISIBILITY_MIN_TRANSMITTANCE ||
            payload.glassFaceBudget >=
                float(GI_GLASS_VISIBILITY_MAX_FACES)
        )
        {
            return;
        }
#endif


        ignoreIntersectionEXT;
        return;
    }
}
