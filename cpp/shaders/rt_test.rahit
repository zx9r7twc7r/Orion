#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// The pane transmission filter is single-sourced in glass_tint_common.glsl so
// this Any-Hit sheet model and the voxel DDA arm of the same stained-glass
// model cannot drift apart again.  GLASS_TINT_NO_DDA keeps the voxel march out
// of this translation unit: its callee vptReadSourceVoxel() is defined only by
// the raygen-family shaders.
#extension GL_GOOGLE_include_directive : require
#define GLASS_TINT_NO_DDA 1

// =====================================================
// 2026-10-26（第四轮，严格搬 RTX Remix）
// AlphaBlendSurface 的每像素状态由**命中着色器**读写（原文在
// geometry_resolver.slangh:2196-2199 做 load -> update -> store），
// 三张图的通道分配见 glass_chain_common.glsl 顶部。
// =====================================================
layout(binding = 73, set = 0, rgba16f)
uniform image2D glassAlphaBlendGbufferImage;

layout(binding = 74, set = 0, rgba16f)
uniform image2D glassAlphaBlendMetaImage;

layout(binding = 75, set = 0, rgba16f)
uniform image2D glassAlphaBlendLightImage;

#include "glass_tint_common.glsl"
// LOD / 远场几何的角色表与每柱覆盖位图（binding 19/20）。
#include "lod_coverage.glsl"

// 2026-10-20: 结构体单源化，见 hit_payload.glsl（六个 shader 共用同一份布局）。
#include "hit_payload.glsl"
// 2026-10-25：透射事件与 main 共用同一套物理薄片数学 + 同一套链契约。
#include "glass_dielectric_common.glsl"
#include "glass_thinwall_common.glsl"
#include "glass_chain_common.glsl"

layout(location = 0) rayPayloadInEXT HitPayload payload;

const uint RT_STATE_PURPOSE_MASK       = 0x7u;
const uint RT_PURPOSE_CLASSIFY          = 1u;
const uint RT_PURPOSE_PASSTHROUGH      = 4u;
const uint RT_PURPOSE_GLASS_VISIBILITY = 5u;
const uint RT_PURPOSE_PRIMARY_SKY       = 7u;
// 2026-10-25 阶段 D：主射线透射段（单条射线 + any-hit 逐面累乘）。
const uint RT_PURPOSE_PRIMARY_TRANSMISSION = 8u;

uint getRayPurpose(uint state)
{
    return state & RT_STATE_PURPOSE_MASK;
}

// 2026-10-28：主透射链身份位（bit 18）。
// 病灶：RT_PURPOSE_PRIMARY_TRANSMISSION = 8 超出 3 位 purpose 掩码
// （RT_STATE_PURPOSE_MASK = 0x7u）⇒ makeTraceState 后被掩成 RT_PURPOSE_FULL，
// 本文件里所有 `== RT_PURPOSE_PRIMARY_TRANSMISSION` 恒假（2026-10-25 起的死代码）。
// 回退：-DORION_GLASS_CHAIN_BIT=0。
#ifndef ORION_GLASS_CHAIN_BIT
#define ORION_GLASS_CHAIN_BIT 1
#endif
const uint RT_STATE_PRIMARY_TRANSMISSION_BIT = 1u << 18u;

bool isPrimaryTransmissionRay(uint state)
{
#if ORION_GLASS_CHAIN_BIT
    return (state & RT_STATE_PRIMARY_TRANSMISSION_BIT) != 0u;
#else
    return getRayPurpose(state) == RT_PURPOSE_PRIMARY_TRANSMISSION;
#endif
}

// 2026-10-28：主透射链只吞**真正的玻璃面**（顶点材质 2.0..2.5）。
//
// 不能复用 glassChainIsTranslucentMaterial()：那个函数是给 rgen 的
// getLegacyMaterialId()（3.0/4.0 = RT_HIT_TRANSLUCENT）写的，范围 2.0..4.5；
// 而两个 any-hit 读的是**顶点材质号**，同一范围会把 LOD 水（2.5..3.5）和
// LOD 树叶（3.5..4.5）也当成玻璃层忽略掉 ⇒ 隔着玻璃看远处水面/树冠会直接
// 穿到后面的东西。这段此前是死代码（purpose 溢出），修好 bit 后才生效。
bool isGlassPaneVertexMaterial(float materialId)
{
    return materialId >= 2.0 && materialId < 2.5;
}

hitAttributeEXT vec2 attribs;

// === Core ABI: exactly matches the global 48-byte Vertex structure ===
struct Vertex {
    float x, y, z;      // 12 bytes
    float u, v;         // 8 bytes
    float r, g, b, a;   // 16 bytes
    float materialId;   // 4 bytes
    float pad1;         // 4 bytes
    float pad2;         // 4 bytes: 0 terrain, 1..16 entity Sampler0
};                      // total: 48 bytes

layout(buffer_reference, scalar) buffer Vertices {
    Vertex v[];
};

// =====================================================
// 2026-10-21 地形 32B 顶点（与 C++ 的 SectionVertex 逐字节对应）
//
// 本 TU 自带 Vertex/Vertices 且不 include material_common.glsl ⇒ 这里单独持一份
// 解包器；内容与 material_common.glsl:89-135 一致，改那边必须同步改这里。
//
// 判别方式：顶点地址表项（binding 21）的 .w = 该段顶点步长（32 或 48）。
// 解包后仍返回老的 48B Vertex ⇒ 下游 materialId/pad1/pad2 使用点零改动。
// 编译期开关必须与 C++ 的 SECTION_VERTEX_32B_ENABLED 一致。
// =====================================================
#if SECTION_VERTEX_32B
struct SectionVertex32
{
    float x, y, z;
    float u, v;
    uint color;      // RGBA8: r | g<<8 | b<<16 | a<<24
    float materialId;
    float pad2;      // pad2 + (pad1 > 0 ? 64 : 0)
};

layout(buffer_reference, scalar) buffer SectionVertices32 {
    SectionVertex32 v[];
};

Vertex loadSectionVertex(uint64_t addr, uint stride, uint index)
{
    if(stride == 32u)
    {
        const SectionVertex32 packed = SectionVertices32(addr).v[index];

        Vertex unpacked;
        unpacked.x = packed.x;
        unpacked.y = packed.y;
        unpacked.z = packed.z;
        unpacked.u = packed.u;
        unpacked.v = packed.v;
        unpacked.r = float(packed.color & 0xFFu) / 255.0;
        unpacked.g = float((packed.color >> 8) & 0xFFu) / 255.0;
        unpacked.b = float((packed.color >> 16) & 0xFFu) / 255.0;
        unpacked.a = float((packed.color >> 24) & 0xFFu) / 255.0;
        unpacked.materialId = packed.materialId;

        const bool rainPuddle = packed.pad2 >= 64.0;
        unpacked.pad1 = rainPuddle ? 0.25 : 0.0;
        unpacked.pad2 = rainPuddle ? (packed.pad2 - 64.0) : packed.pad2;

        return unpacked;
    }

    return Vertices(addr).v[index];
}
#else
Vertex loadSectionVertex(uint64_t addr, uint /*stride*/, uint index)
{
    return Vertices(addr).v[index];
}
#endif

// Match closest-hit: one entry per TLAS Section instance.
// Any-hit must use this table too; CameraProperties.vertexBufferAddr
// is only the initialization fallback/test triangle address.
// 2026-10-09：表项 8B → 16B（uvec4），必须与 closest-hit 和 C++ 侧
// GPUSectionVertexAddress 一致；.xz 用法见 rt_test.rchit 的说明。
layout(std430, binding = 21, set = 0) readonly buffer SectionVertexAddressBuffer {
    uvec4 vertexAddresses[];
} sectionVertexAddressBuffer;

layout(binding = 2, set = 0) uniform CameraProperties {
    #include "camera_ubo.glsl"
} cam;

layout(binding = 3, set = 0) uniform sampler2D blockAtlas;
