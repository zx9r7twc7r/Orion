#version 460
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
#include "bruneton/definitions.glsl"
#include "bruneton/atmosphere.glsl"
#include "bruneton/common.glsl"
#include "bruneton/precompute.glsl"
layout(push_constant) uniform PC {
    int pcLayer;
    int pcAdditive;
    int pcScatteringOrder;
    int pcOutput;
} pc;
layout(set = 0, binding = 0) uniform sampler2D transmittanceTexture;
layout(rgba32f, set = 0, binding = 11) uniform image3D outDeltaRayleigh;
layout(rgba32f, set = 0, binding = 12) uniform image3D outDeltaMie;
layout(rgba32f, set = 0, binding = 13) uniform image3D outScattering;
layout(rgba32f, set = 0, binding = 14) uniform image3D outSingleMie;

void main() {
    ivec3 pix = ivec3(gl_GlobalInvocationID);
    if (pix.x >= SCATTERING_TEXTURE_WIDTH ||
        pix.y >= SCATTERING_TEXTURE_HEIGHT ||
        pix.z >= SCATTERING_TEXTURE_DEPTH) return;
    vec3 frag = vec3(pix) + 0.5;
    vec4 deltaRayleigh;
    vec4 deltaMie;
    vec4 scattering;
    vec4 singleMieScattering;
    ComputeSingleScatteringTexture(
        ATMOSPHERE, transmittanceTexture, frag,
        deltaRayleigh.rgb, deltaMie.rgb);
    deltaRayleigh.a = 1.0;
    deltaMie.a = 1.0;
    scattering = vec4(deltaRayleigh.rgb, 1.0);
    singleMieScattering = vec4(deltaMie.rgb, 1.0);
    if (pc.pcOutput == 0) {
        imageStore(outDeltaRayleigh, pix, deltaRayleigh);
    } else if (pc.pcOutput == 1) {
        imageStore(outDeltaMie, pix, deltaMie);
    } else if (pc.pcOutput == 2) {
        vec4 value = scattering;
        if (pc.pcAdditive == 1) value += imageLoad(outScattering, pix);
        imageStore(outScattering, pix, value);
    } else {
        vec4 value = singleMieScattering;
        if (pc.pcAdditive == 1) value += imageLoad(outSingleMie, pix);
        imageStore(outSingleMie, pix, value);
    }
}
