// =====================================================
// rr_guide_relax.comp —— 跨 delta 的 RR 核半径定向放宽（2026-10-01）
//
// 为什么需要它
//   DLSS-RR 的空间核半径由 guide 粗糙度决定。透过玻璃看到的那份内容
//   （"玻璃后面的接收面"）本身是 1spp 级的：它写不进主 G-buffer，RR 拿不到它的
//   表面记录，只能靠 guide 的粗糙度去放宽核。全局抬粗糙度会让所有玻璃内容一起
//   放宽量由**邻居法线差**给出：
//
//       float neighborRelaxation(...) {
//           StablePlaneRecord r = loadPlane(records, neighbor);
//           return r.branchId == INVALID ? 0.02 : 1.0 - dot(centerNormal, normalize(r.normal));
//       }
//       float disocclusionRelaxation(...) {
//           if (((r.flags >> 8u) & 0xffu) == 0u) return 0.0;   // 未跨 delta ⇒ 不放宽
//           float v = sum of 4 neighbors;
//           return saturate((v - 0.00002) * 25.0);
//       }
//
//   本项目里等价的"跨 delta"标记由 rgen 写进 RR input 的 diffuse-albedo alpha 通道
//   （RR 只用该纹理的 RGB，见 rt_test.rgen 的 guide 写出点）：1 = 该像素主导路径
//   穿过玻璃。本 pass 只改**粗糙度**这一路，法线/深度/反照率原样保留。
//
// 性能
//   16x16 线程 + 18x18 共享内存瓦片，一次 3x3 邻域读取，纯 ALU；没有新的采样、
//   没有额外的 trace。放在 rgen 与 DLSS-RR 之间的一个小 dispatch。
//
// 布局（宿主侧自建描述符集，与 rgen 的 binding 无关）
//   binding 0 : rgba16f normalRoughness（读写，N.xyz + roughness）
//   binding 1 : r32f   depth（读写，反 Z；同时用于远云面）
//   binding 2 : rgba16f diffuseAlbedo（读写，alpha 兼作"跨 delta"标记）
//   binding 3 : r32f   specularHitDistance（读写，远云面）
//   binding 4 : rgba16f specularAlbedo（读写，远云面）
//   binding 5 : sampler2D 已 resolve 的云层（rgba：rgb 预乘散射、a 透过率）
//   binding 6 : sampler2D 云前线距离（rg32f：.r 首命中距离）
//   binding 7 : CameraProperties 前缀（viewInverse / projInverse）
//   push     : RRGuideRelaxPush { uint2 extent; float2 pad; float relaxScale; ... }
//
// 2026-10-03 第二职责 —— 远云的"已解析面" guide 补写
//   云是在 rgen **之后**由 volumetric_cloud_composite.comp 才合成进 RR 的颜色输入
//   （g_rtOutputImage）的，而 RR 的 guide 与深度全部由 rgen 写出。于是云像素上
//   RR 拿到的是**云后面那个面**的记录 —— 通常是天空：深度 0（反 Z 的 miss）、
//   hit distance 65504、albedo 0。RR 会按"无穷远静态背景"去重投影这些像素，
//   远处云因此在时域上被糊成一团（grazing 角、有风时尤甚）。
//
//   这与 rgen 里 DH 远场当初的问题同源，处置也照抄那一段（见 rt_test.rgen 的
//   "stage B：远场现在是我们的几何 ⇒ DLSS RR 的 guide 也必须是我们的"）：
//   反照率 = 该处已着色颜色、roughness = 1、specular = 0、hit distance = 锚定距离，
//   深度用同一份 projInverse 反推出的自洽值。
//
//   只处理**远处**云（`pc.farCloudDistance`，<= 0 时整段跳过 = 逐字节回旧档）。
//   近云保持现状：它背后的地形 guide 是真实的，改成"云面"反而会丢掉地形。
// =====================================================

#version 460
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, rgba16f) uniform image2D normalRoughnessImage;
layout(binding = 1, r32f) uniform image2D depthImage;
layout(binding = 2, rgba16f) uniform image2D diffuseAlbedoImage;
// 远云补写面：binding 3/4 是本 pass 新写出的两路 guide。
layout(binding = 3, r32f) uniform image2D specularHitDistanceImage;
layout(binding = 4, rgba16f) uniform image2D specularAlbedoImage;
// 本帧已 resolve 的云层：rgb = 预乘散射，a = 透过率。空像素是 vec4(0,0,0,1)，
// 所以 `a < 1` 就是"这一像素真的被云遮挡"的判据。
layout(binding = 5) uniform sampler2D cloudResolvedImage;
// rg32f：.r = 云的前线命中距离。空像素写 CLOUD_DEPTH_EMPTY = 1e6，作为哨兵值排除。
layout(binding = 6) uniform sampler2D cloudDepthImage;
// CameraProperties 的**前缀**（宿主侧那份结构体更长）：字段名、类型、顺序与
// 偏移必须逐字一致，这样前缀声明在 used offsets 上与原结构体等价。
layout(binding = 7) uniform CameraProperties
{
    #include "camera_ubo.glsl"
} cam;

layout(push_constant) uniform RRGuideRelaxPush
{
    uvec2 extent;
    float relaxScale;
    float minRoughness;
    float normalFalloff;
    // 远云距离（格/米；<= 0 = 关闭 = 逐字节回旧档）。与宿主侧结构体逐字节对应。
    float farCloudDistance;
    float padding1;
    float padding2;
} pc;

const float NEIGHBOR_EPS = 0.00002;
const float NEIGHBOR_SCALE = 25.0;

const ivec2 OFFSETS[4] = ivec2[4](
    ivec2(-1, 0), ivec2(1, 0), ivec2(0, -1), ivec2(0, 1)
);

// 18x18 瓦片（16+2 边界），存 xyz=法线、w=粗糙度。
shared vec4 tile[18 * 18];
// 18x18 的共享：邻居的"跨 delta"标记。
shared float tileDelta[18 * 18];

ivec2 tileLocal(ivec2 pixel, ivec2 groupBase)
{
    return pixel - groupBase + ivec2(1, 1);
}

void main()
{
    ivec2 extent = ivec2(pc.extent);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 groupBase = ivec2(gl_WorkGroupID.xy) * ivec2(16, 16);

    // ---- 载入瓦片（含 1 像素边界），越界钳到边缘 ----
    for(uint i = gl_LocalInvocationIndex; i < 18u * 18u;
        i += 16u * 16u)
    {
        ivec2 local = ivec2(int(i % 18u), int(i / 18u));
        ivec2 src = clamp(groupBase + local - ivec2(1, 1), ivec2(0), extent - ivec2(1));

        vec4 nr = imageLoad(normalRoughnessImage, src);
        float deltaFlag = imageLoad(diffuseAlbedoImage, src).a;
        float depth = imageLoad(depthImage, src).r;

        // 天空/无效深度（本项目为反 Z：0 = 远）不参与放宽，标记为 -1。
        float valid = depth > 1.0e-6 ? 1.0 : 0.0;
        tile[i] = vec4(nr.xyz, depth > 1.0e-6 ? nr.w : 0.0);
        tileDelta[i] = valid * deltaFlag;
    }

    barrier();
    memoryBarrierShared();

    if(any(greaterThanEqual(pixel, extent)))
    {
        return;
    }

    ivec2 local = tileLocal(pixel, groupBase);
    vec4 center = tile[local.x + 18 * local.y];

    // ---- 只在"本像素或邻居跨过 delta"时放宽----
    float deltaHere = tileDelta[local.x + 18 * local.y];
    float deltaNeighbor = 0.0;
    float normalSpread = 0.0;

    vec3 n0 = normalize(center.xyz);
    for(int i = 0; i < 4; ++i)
    {
        ivec2 o = local + OFFSETS[i];
        vec4 n = tile[o.x + 18 * o.y];
        deltaNeighbor = max(deltaNeighbor, tileDelta[o.x + 18 * o.y]);

        float v = 0.02;
        if(tile[o.x + 18 * o.y].w > 0.0)
        {
            v = clamp(1.0 - dot(n0, normalize(n.xyz)), 0.0, 1.0);
        }
        normalSpread += v;
    }

    float gate = max(deltaHere, deltaNeighbor);
    float relax = clamp((normalSpread - NEIGHBOR_EPS) * NEIGHBOR_SCALE, 0.0, 1.0);
    relax = clamp(relax * pc.relaxScale * gate, 0.0, 1.0);

    // 只在放宽方向加宽：粗糙度朝 1 靠，下限不低于 minRoughness。
    float roughness = clamp(center.w, 0.0, 1.0);
    float relaxed = clamp(
        mix(roughness, 1.0, relax),
        max(pc.minRoughness, roughness),
        1.0
    );

    // =====================================================
    // 远云"已解析面"补写（见文件头第二职责）。放在最后：本像素不再参与粗糙度
    // 放宽（云面本身就是 roughness = 1 的漫反射面），但上面的瓦片读数已经发生，
    // 邻居的放宽不受影响。
    // =====================================================
    if(pc.farCloudDistance > 0.0)
    {
        vec2 uv = (vec2(pixel) + 0.5) / vec2(extent);
        vec4 cloudLayer = textureLod(cloudResolvedImage, uv, 0.0);
        float cloudDistance = textureLod(cloudDepthImage, uv, 0.0).r;
        float transmittance = clamp(cloudLayer.a, 0.0, 1.0);

        // a < 1 ⇒ 这一像素真的被云遮挡（空像素 = (0,0,0,1)，距离 = 1e6 哨兵）。
        // ⚠ 上限**必须**贴着哨兵 CLOUD_DEPTH_EMPTY(1e6)，不能写小值：云的远淡出
        //   距离是用户可调的（实测已被调到 212000，march 弦长上限 260000），
        //   地平线那条掠射带整条都在 100 km 之外。早先写成 1e5 的结果就是
        //   "远处还剩发糊" —— 补写在 100 km 处静默断掉，正好断在最糊的那条带上。
        if(transmittance < 0.999 &&
           cloudDistance >= pc.farCloudDistance &&
           cloudDistance < 9.0e5)
        {
            // 本像素的射线方向：与 volumetric_clouds.comp 的取法逐字一致
            // （projInverse + y 翻转），否则重建出的方向与云 march 用的不是同一条。
            vec2 ndc = (vec2(pixel) + 0.5) / vec2(extent) * 2.0 - 1.0;
            ndc.y = -ndc.y;
            vec4 viewHomogeneous = cam.projInverse * vec4(ndc, 1.0, 1.0);
            float viewW = abs(viewHomogeneous.w) > 1.0e-6
                ? viewHomogeneous.w
                : 1.0;
            vec3 viewTarget = normalize(viewHomogeneous.xyz / viewW);
            vec3 worldDirection =
                normalize((cam.viewInverse * vec4(viewTarget, 0.0)).xyz);

            // 反 Z 深度：rgen 存的是 clipPos.z / clipPos.w，而 projInverse 把
            // z = 1 映到近平面 ⇒ near = -(z/w)。用 projInverse 自己反推，比读
            // UBO 的 cameraNear 更稳：只要这份 projInverse 是 rgen 那张投影矩阵
            // 的逆，写出的深度就与它的深度自洽（sceneDistanceForDepth 依赖同一前提）。
            // 沿射线的距离换算到视深要乘 cos（= -viewTarget.z），反 Z 深度 = near / 视深。
            float nearPlane = -viewHomogeneous.z / viewW;
            float cosine = max(-viewTarget.z, 1.0e-3);
            float cloudDepth = clamp(
                nearPlane / max(cloudDistance * cosine, 1.0e-3), 0.0, 1.0);

            // alpha 通道留着：rgen 用它标"跨 delta（穿过玻璃）"，上面正读着它，
            // 在这里清掉会让玻璃像素的放宽失效。
            float deltaFlag = imageLoad(diffuseAlbedoImage, pixel).a;

            imageStore(diffuseAlbedoImage, pixel,
                vec4(max(cloudLayer.rgb, vec3(0.0)), deltaFlag));
            imageStore(specularAlbedoImage, pixel, vec4(0.0, 0.0, 0.0, 1.0));
            imageStore(normalRoughnessImage, pixel,
                vec4(-worldDirection, 1.0));
            imageStore(specularHitDistanceImage, pixel,
                vec4(cloudDistance, 0.0, 0.0, 0.0));
            imageStore(depthImage, pixel, vec4(cloudDepth, 0.0, 0.0, 0.0));
            return;
        }
    }

    imageStore(
        normalRoughnessImage,
        pixel,
        vec4(center.xyz, relaxed)
    );
}
