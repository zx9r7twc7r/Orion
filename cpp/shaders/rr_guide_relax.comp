
#version 460
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, rgba16f) uniform image2D normalRoughnessImage;
layout(binding = 1, r32f) uniform image2D depthImage;
layout(binding = 2, rgba16f) uniform image2D diffuseAlbedoImage;
layout(binding = 3, r32f) uniform image2D specularHitDistanceImage;
layout(binding = 4, rgba16f) uniform image2D specularAlbedoImage;
layout(binding = 5) uniform sampler2D cloudResolvedImage;
layout(binding = 6) uniform sampler2D cloudDepthImage;
layout(binding = 7) uniform CameraProperties
{
    #include "camera_ubo.glsl"
} cam;

layout(push_constant) uniform RRGuideRelaxPush
{
    uvec2 extent;
    float relaxScale;
    float minRoughness;
    float normalFalloff;
    float farCloudDistance;
    float padding1;
    float padding2;
} pc;

const float NEIGHBOR_EPS = 0.00002;
const float NEIGHBOR_SCALE = 25.0;

const ivec2 OFFSETS[4] = ivec2[4](
    ivec2(-1, 0), ivec2(1, 0), ivec2(0, -1), ivec2(0, 1)
);

shared vec4 tile[18 * 18];
shared float tileDelta[18 * 18];

ivec2 tileLocal(ivec2 pixel, ivec2 groupBase)
{
    return pixel - groupBase + ivec2(1, 1);
}

void main()
{
    ivec2 extent = ivec2(pc.extent);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 groupBase = ivec2(gl_WorkGroupID.xy) * ivec2(16, 16);

    for(uint i = gl_LocalInvocationIndex; i < 18u * 18u;
        i += 16u * 16u)
    {
        ivec2 local = ivec2(int(i % 18u), int(i / 18u));
        ivec2 src = clamp(groupBase + local - ivec2(1, 1), ivec2(0), extent - ivec2(1));

        vec4 nr = imageLoad(normalRoughnessImage, src);
        float deltaFlag = imageLoad(diffuseAlbedoImage, src).a;
        float depth = imageLoad(depthImage, src).r;

        float valid = depth > 1.0e-6 ? 1.0 : 0.0;
        tile[i] = vec4(nr.xyz, depth > 1.0e-6 ? nr.w : 0.0);
        tileDelta[i] = valid * deltaFlag;
    }

    barrier();
    memoryBarrierShared();

    if(any(greaterThanEqual(pixel, extent)))
    {
        return;
    }

    ivec2 local = tileLocal(pixel, groupBase);
    vec4 center = tile[local.x + 18 * local.y];

    float deltaHere = tileDelta[local.x + 18 * local.y];
    float deltaNeighbor = 0.0;
    float normalSpread = 0.0;

    vec3 n0 = normalize(center.xyz);
    for(int i = 0; i < 4; ++i)
    {
        ivec2 o = local + OFFSETS[i];
        vec4 n = tile[o.x + 18 * o.y];
        deltaNeighbor = max(deltaNeighbor, tileDelta[o.x + 18 * o.y]);

        float v = 0.02;
        if(tile[o.x + 18 * o.y].w > 0.0)
        {
            v = clamp(1.0 - dot(n0, normalize(n.xyz)), 0.0, 1.0);
        }
        normalSpread += v;
    }

    float gate = max(deltaHere, deltaNeighbor);
    float relax = clamp((normalSpread - NEIGHBOR_EPS) * NEIGHBOR_SCALE, 0.0, 1.0);
    relax = clamp(relax * pc.relaxScale * gate, 0.0, 1.0);

    float roughness = clamp(center.w, 0.0, 1.0);
    float relaxed = clamp(
        mix(roughness, 1.0, relax),
        max(pc.minRoughness, roughness),
        1.0
    );

    if(pc.farCloudDistance > 0.0)
    {
        vec2 uv = (vec2(pixel) + 0.5) / vec2(extent);
        vec4 cloudLayer = textureLod(cloudResolvedImage, uv, 0.0);
        float cloudDistance = textureLod(cloudDepthImage, uv, 0.0).r;
        float transmittance = clamp(cloudLayer.a, 0.0, 1.0);

        if(transmittance < 0.999 &&
           cloudDistance >= pc.farCloudDistance &&
           cloudDistance < 9.0e5)
        {
            vec2 ndc = (vec2(pixel) + 0.5) / vec2(extent) * 2.0 - 1.0;
            ndc.y = -ndc.y;
            vec4 viewHomogeneous = cam.projInverse * vec4(ndc, 1.0, 1.0);
            float viewW = abs(viewHomogeneous.w) > 1.0e-6
                ? viewHomogeneous.w
                : 1.0;
            vec3 viewTarget = normalize(viewHomogeneous.xyz / viewW);
            vec3 worldDirection =
                normalize((cam.viewInverse * vec4(viewTarget, 0.0)).xyz);

            float nearPlane = -viewHomogeneous.z / viewW;
            float cosine = max(-viewTarget.z, 1.0e-3);
            float cloudDepth = clamp(
                nearPlane / max(cloudDistance * cosine, 1.0e-3), 0.0, 1.0);

            float deltaFlag = imageLoad(diffuseAlbedoImage, pixel).a;

            imageStore(diffuseAlbedoImage, pixel,
                vec4(max(cloudLayer.rgb, vec3(0.0)), deltaFlag));
            imageStore(specularAlbedoImage, pixel, vec4(0.0, 0.0, 0.0, 1.0));
            imageStore(normalRoughnessImage, pixel,
                vec4(-worldDirection, 1.0));
            imageStore(specularHitDistanceImage, pixel,
                vec4(cloudDistance, 0.0, 0.0, 0.0));
            imageStore(depthImage, pixel, vec4(cloudDepth, 0.0, 0.0, 0.0));
            return;
        }
    }

    imageStore(
        normalRoughnessImage,
        pixel,
        vec4(center.xyz, relaxed)
    );
}
