#version 460
#extension GL_GOOGLE_include_directive : require

// ===========================================================================
// 体积云 v3 —— 云模型（MIT，完整移植）
//
// 模型本体在 cloud_v3_core.glsl（与离线预览工具 tools/cloudpreview 共用同一份代码）。
// 本文件只负责**引擎侧接口**：
//   · CameraUBO / 描述符绑定（形状 128³ / 细节 32³ / curl 128² / weather 512²）
//   · 球壳求交（与 tyndall 同一约定）、场景深度裁剪
//   · 直射/天光颜色（本引擎的太阳-月亮链、方向性天光）
// · 复合（mix(background, marchColor, accumDensity) ⇒ 预乘 + 透射率）
//   · 平面云 / 体积雾 / 空气透视尾段（与 v2 一致，不属于云模型）
//
// ===========================================================================

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform CameraProperties
{
    #include "camera_ubo.glsl"
} cam;

layout(set = 0, binding = 1) uniform sampler3D cloudShapeNoise;      // v3: 128³ 低频形状
layout(set = 0, binding = 2) uniform sampler3D cloudCurlNoise;       // v3: 32³ 高频细节
layout(rgba16f, set = 0, binding = 3) uniform writeonly image2D cloudOutput;
layout(rg32f, set = 0, binding = 4) uniform writeonly image2D cloudDepthOutput;
layout(set = 0, binding = 5) uniform sampler2D sceneDepth;
layout(set = 0, binding = 6) uniform sampler2D sunShadowMap;
layout(set = 0, binding = 7) uniform sampler2D terrainHeightMap;
layout(set = 0, binding = 8) uniform sampler2D sunShadowMapFar;
layout(set = 0, binding = 9) uniform sampler2D cloudBaseNoise;       // v2 遗留，v3 不用
layout(set = 0, binding = 10) uniform sampler2D cloudV3CurlNoise;    // 128² curl
layout(set = 0, binding = 11) uniform sampler2D cloudV3WeatherMap;   // 512² 天气图

#include "cloud_v3_core.glsl"

const float V3_EMPTY_DISTANCE = 1000000.0;

void storeEmpty(ivec2 pixel)
{
    imageStore(cloudOutput, pixel, vec4(0.0, 0.0, 0.0, 1.0));
    imageStore(cloudDepthOutput, pixel, vec4(V3_EMPTY_DISTANCE, V3_EMPTY_DISTANCE, 0.0, 0.0));
}

float sceneDistanceForDepth(vec2 ndc, float depthValue)
{
    if(depthValue <= 1.0e-5)
    {
        return 1.0e30;
    }
    vec4 sceneViewPosition = cam.projInverse * vec4(ndc, depthValue, 1.0);
    if(abs(sceneViewPosition.w) <= 1.0e-6)
    {
        return 1.0e30;
    }
    return length(sceneViewPosition.xyz / sceneViewPosition.w);
}

float hgPhase(float cosine, float g)
{
    float g2 = g * g;
    float denominator = max(1.0e-4, 1.0 + g2 - 2.0 * g * cosine);
    return (1.0 - g2) / (4.0 * V3_PI * denominator * sqrt(denominator));
}

#include "sky_model_common.glsl"
#include "sky_sun_common.glsl"
#include "clear_sky_aerial.glsl"
#include "tyndall_cloud_field.glsl"
#include "high_cloud_field.glsl"

#define TERRAIN_HEIGHT_CONSUMER 1
#include "terrain_height.glsl"

#define SUN_SHADOW_FAR_MAP 1
#define SUN_SHADOW_CONSUMER 1
#define SUN_SHADOW_PCF_TAPS_4 1
// 2026-10-21：体积雾的近图 ∪ 远图合并可见性（治"背光面照常出光柱"），
// 原因见 sun_shadow.glsl 的 sunShadowFogVisibility。
#define SUN_SHADOW_FOG_UNION 1
#include "sun_shadow.glsl"

#include "volumetric_fog.glsl"

vec3 v3SunColor(vec3 lightDirection)
{
    return skyModelSunColor(lightDirection, 0.5);
}

const float V3_DAYLIGHT_UPPER = 0.25;
const float V3_NIGHT_AMBIENT = 0.08;
const float V3_MOON_LIGHT_SCALE = 6.0 * (0.05 / 1.22077458876);
const float V3_SOLAR_LATITUDE_35_COS = 0.81915204429;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(cloudOutput);
    if(any(greaterThanEqual(pixel, size))) return;

    bool cloudDeckEnabled = cam.cloudParams1.w >= 0.5;
    bool highCloudEnabled = cam.highCloudParams0.x >= 0.5;
    if((!cloudDeckEnabled && !highCloudEnabled) ||
       abs(cam.weatherParams.z - 1.0) >= 0.25)
    {
        storeEmpty(pixel);
        return;
    }

    // ---- 视线 / 场景深度 ----
    vec2 ndc = (vec2(pixel) + 0.5) / vec2(size) * 2.0 - 1.0;
    ndc.y = -ndc.y;
    vec4 viewPosition = cam.projInverse * vec4(ndc, 1.0, 1.0);
    vec3 viewTarget = abs(viewPosition.w) > 1.0e-6
        ? viewPosition.xyz / viewPosition.w : viewPosition.xyz;
    vec3 worldDirection = normalize((cam.viewInverse * vec4(normalize(viewTarget), 0.0)).xyz);
    vec3 cameraPosition = cam.viewInverse[3].xyz;

    float rawSceneDepth = texelFetch(sceneDepth, pixel, 0).r;
    if(textureSize(sceneDepth, 0) != size)
    {
        const vec2 sceneSize = vec2(textureSize(sceneDepth, 0));
        const vec2 sceneTexel = (vec2(pixel) + 0.5) / vec2(size) * sceneSize;
        const ivec2 sceneBase = ivec2(floor(sceneTexel - 0.5));
        const ivec2 sceneLimit = ivec2(sceneSize) - ivec2(1, 1);
        float nearest = 0.0;
        for(int oy = 0; oy < 2; ++oy)
        for(int ox = 0; ox < 2; ++ox)
        {
            nearest = max(nearest, texelFetch(sceneDepth,
                clamp(sceneBase + ivec2(ox, oy), ivec2(0, 0), sceneLimit), 0).r);
        }
        rawSceneDepth = nearest;
    }
    float sceneDistance = sceneDistanceForDepth(ndc, rawSceneDepth);

    // ---- 直射 / 天光颜色 ----
    vec3 lightDirection0 = sunDirection();
    float sunElevation = lightDirection0.y;
    vec3 lightDirection = sunElevation >= 0.0 ? lightDirection0 : -lightDirection0;
    float dayAmount = smoothstep(-0.03, 0.03, sunElevation);
    float elevationMagnitude = abs(sunElevation) / V3_SOLAR_LATITUDE_35_COS;
    float rain = clamp(cam.weatherParams.x, 0.0, 1.0);

    float highPixelAngle = 2.0 * abs(cam.projInverse[1][1]) / float(size.y);
    float highDistance;
    vec4 highCloud = sampleHighCloud(
        cameraPosition, worldDirection, lightDirection, highPixelAngle, highDistance);
    if(highDistance > sceneDistance)
    {
        highCloud = vec4(0.0, 0.0, 0.0, 1.0);
        highDistance = V3_EMPTY_DISTANCE;
    }

    vec3 directLightColor = mix(vec3(0.46, 0.56, 1.00), v3SunColor(lightDirection), dayAmount);
    float directLightEnergy = mix(V3_MOON_LIGHT_SCALE * elevationMagnitude,
        6.0, dayAmount) * clamp(cam.cloudParams5.z, 0.0, 3.0);
    float moonStrength = cam.cloudMoonParams.x >= 0.0 ? cam.cloudMoonParams.x : 1.0;
    float moonPhase = cam.cloudMoonParams.y >= 0.0 ? cam.cloudMoonParams.y : 1.0;
    float moonAmount = mix(1.0, moonStrength * clamp(moonPhase, 0.0, 1.0), 1.0 - dayAmount);
    vec3 sunColor = directLightColor * directLightEnergy * moonAmount;

    float daylight = mix(V3_NIGHT_AMBIENT, 1.0,
        smoothstep(-0.10, V3_DAYLIGHT_UPPER, sunElevation));
    float skyRadianceScale = daylight * clamp(elevationMagnitude, 0.0, 1.0);
    float skyWeatherFactor = mix(1.0, 0.20, rain);
    vec3 sunSideDir = normalize(vec3(lightDirection.x, 0.20, lightDirection.z));
    vec3 antiSunDir = normalize(vec3(-lightDirection.x, 0.20, -lightDirection.z));
    vec3 radianceZenith = clearSkyInscatter(vec3(0.0, 1.0, 0.0), sunElevation,
        lightDirection, directLightColor, skyRadianceScale, skyWeatherFactor, vec3(1.0));
    vec3 radianceSunSide = clearSkyInscatter(sunSideDir, sunElevation,
        lightDirection, directLightColor, skyRadianceScale, skyWeatherFactor, vec3(1.0));
    vec3 radianceAntiSun = clearSkyInscatter(antiSunDir, sunElevation,
        lightDirection, directLightColor, skyRadianceScale, skyWeatherFactor, vec3(1.0));
    const float V3_AMBIENT_PHASE_G = 0.25;
    float weightZenith = hgPhase(dot(worldDirection, vec3(0.0, 1.0, 0.0)), V3_AMBIENT_PHASE_G);
    float weightSunSide = hgPhase(dot(worldDirection, sunSideDir), V3_AMBIENT_PHASE_G);
    float weightAntiSun = hgPhase(dot(worldDirection, antiSunDir), V3_AMBIENT_PHASE_G);
    vec3 skyColor = (radianceZenith * weightZenith + radianceSunSide * weightSunSide +
        radianceAntiSun * weightAntiSun) / max(weightZenith + weightSunSide + weightAntiSun, 1.0e-4);
    skyColor *= clamp(cam.cloudParams5.w, 0.0, 3.0);

 // ---- 模型参数----
    float baseAltitude = cam.cloudParams0.x;
    float layerThickness = max(cam.cloudParams0.y, 1.0);
    float coverageMaster = clamp(cam.cloudParams0.z, 0.0, 1.0);
    float baseDensityFactor = 0.38 * clamp(cam.cloudParams0.w / 5.0, 0.05, 2.0);
    float noiseScale = max(cam.cloudParams3.z, 0.05) * 8.0;
    float cloudTypeInfluence = clamp(cam.cloudParams3.w, 0.0, 1.0);
    float windSpeed = max(cam.cloudParams1.y, 0.0) * 0.0025;
    float timeSeconds = max(uintBitsToFloat(cam.padding), 0.0);
    vec3 windDirection = normalize(vec3(1.0, 0.0, 0.0));

    float heightGradientSkew = 1.0 + clamp(cam.cloudParams6.y, 0.0, 1.0);
    float erosionScale = 0.005 * clamp(cam.cloudParams6.w, 0.25, 2.0);
    float curlStrength = 0.5 * clamp(cam.cloudParams1.z, 0.25, 2.0);
    // 天气图 1 tile 覆盖多少格：预览器里 5000 格（5 km）才与参考观感一致；
    // 50000 会让整片天空落在同一个天气格上（覆盖度恒定 ⇒ 云连成一片）。
    float weatherScale = 5000.0 * clamp(cam.cloudParams6.x, 0.25, 4.0);
    float erosionAmount = 1.4 * clamp(cam.cloudParams1.x / 0.15, 0.25, 2.0);

    V3MarchSettings settings;
    settings.eccentricity = 0.6;
    settings.silverIntensity = 0.7 + 0.3 * clamp(cam.cloudParams6.z, 0.0, 1.0);
    settings.silverSpread = 0.1;
    // 参考常量是 5.0；预览对比下 10 才接近"白云"的亮度（我们的太阳颜色与
    // 参考的 SUN_INTENSITY=0.78 不同，这一步是量纲对齐，不是模型改动）。
    // 参考常量 5.0 是配他们自己的 tonemap（ACES + 1/16 稀疏 + 时间累积）；
    // 我们的直出色域更暗，实测 12 才接近"白云"。这是量纲对齐，不是模型改动。
    settings.brightness = 12.0;
    // 云底环境补光：参考没有这一项（0 = 逐字行为）；用天光强度滑杆给到 0~0.3。
    settings.ambientStrength = 0.25 * clamp(cam.cloudParams5.w, 0.0, 3.0);

    int viewSteps = int(clamp(cam.cloudParams2.x, 1.0, 96.0));
    int lightSamples = int(clamp(cam.cloudParams2.y, 1.0, 6.0));

    // ---- 球壳求交 ----
    vec2 anchorXZ = cam.cloudParams3.xy;
    vec3 shellOrigin = vec3(anchorXZ.x, baseAltitude, anchorXZ.y);
    vec3 earthCenter = vec3(anchorXZ.x, baseAltitude - TYNDALL_RADIUS, anchorXZ.y);
    vec2 outerRoots;
    vec2 innerRoots;
    bool hasOuter = tyndallSphereRoots(cameraPosition, worldDirection,
        TYNDALL_RADIUS + layerThickness, outerRoots) && outerRoots.y > 0.0;
    tyndallSphereRoots(cameraPosition, worldDirection, TYNDALL_RADIUS, innerRoots);

    bool belowBase = cameraPosition.y < baseAltitude;
    bool insideLayer = cameraPosition.y > baseAltitude &&
        cameraPosition.y < baseAltitude + layerThickness;
    float startT = belowBase ? innerRoots.y : outerRoots.x;
    float endT = belowBase ? outerRoots.y : innerRoots.x;
    startT = insideLayer ? 0.0 : startT;
    endT = insideLayer ? (innerRoots.y >= 0.0 ? innerRoots.x : outerRoots.y) : endT;
    endT = min(endT, sceneDistance);

    vec4 march = vec4(0.0);
    float cloudDistance = V3_EMPTY_DISTANCE;
    if(cloudDeckEnabled && hasOuter && endT > startT + 1.0)
    {
        V3MarchInputs inputs;
        inputs.rayOrigin = cameraPosition;
        inputs.rayDirection = worldDirection;
        inputs.lightDirection = lightDirection;
        inputs.shellOrigin = shellOrigin;
        inputs.earthCenter = earthCenter;
        inputs.startT = startT;
        inputs.endT = endT;
        inputs.layerThickness = layerThickness;
        inputs.coverageMaster = coverageMaster;
        inputs.baseDensityFactor = baseDensityFactor;
        inputs.noiseScale = noiseScale;
        inputs.cloudTypeInfluence = cloudTypeInfluence;
        inputs.windSpeed = windSpeed;
        inputs.timeSeconds = timeSeconds;
        inputs.windDirection = windDirection;
        inputs.heightGradientSkew = heightGradientSkew;
        inputs.erosionScale = erosionScale;
        inputs.curlStrength = curlStrength;
        inputs.weatherScale = weatherScale;
        inputs.erosionAmount = erosionAmount;
        // 消光按**整层光学厚度**标定，而不是每格：参考观感 ≈ 12 个 OD 穿过整层。
        // 这样 400 格层给 0.03/格、16 km 层给 0.0007/格，观感与层厚无关
        // （之前的固定 0.03/格会让 16 km 的层瞬间变成实心白墙）。
        inputs.extinction = (12.0 / max(layerThickness, 1.0)) *
            clamp(cam.cloudParams0.w / 5.0, 0.05, 2.0);
        inputs.ambientColor = skyColor;
        inputs.requestedSteps = viewSteps;
        inputs.lightSamples = lightSamples;
        // 2026-10-18 修"一直闪"：Halton 抖动相位原来跟着帧号变，而我们的 resolve
        // 在云分辨率下并不总能收敛（相机一动历史就被拒）⇒ 每帧换相位 = 整片噪点闪烁。
        // 改成固定相位（静止图案），噪声不再流动；要动态则靠步数/分辨率，不靠抖动。
        inputs.frameIndex = 7;

        march = v3MarchClouds(cloudShapeNoise, cloudCurlNoise, cloudV3CurlNoise,
            cloudV3WeatherMap, inputs, settings, cloudDistance);
    }

    // ---- 复合（A4）：mix(background, marchColor, accumDensity) ----
    float cloudOpacity = clamp(march.a, 0.0, 1.0);
    vec3 scattering = march.rgb * cloudOpacity * sunColor;
    // 2026-10-18 修"莫名其妙的黑"：参考只有太阳项，云底/背光面算出来接近 0，
    // 在夜晚或太阳低角度时整片发黑。这里补一个随覆盖度缩放的天空环境项
    // 。0.55 只是让阴影可读，
    // 不参与太阳项，所以不会把云洗白。
    scattering += skyColor * cloudOpacity * 0.55;
    float transmittance = 1.0 - cloudOpacity;

    // ---- 平面云 / 雾 / 空气透视（同 v2）----
    if(highDistance < cloudDistance)
    {
        scattering = highCloud.rgb + highCloud.a * scattering;
    }
    else
    {
        scattering += transmittance * highCloud.rgb;
    }
    transmittance *= highCloud.a;
    cloudDistance = min(cloudDistance, highDistance);

    // 2026-10-23：环境项接沿视线的真实晴空辐亮度，按 fogExtrasParams.z 混入。
    const vec3 fogAmbientLegacy =
        mix(vec3(0.055, 0.070, 0.125), vec3(0.62, 0.72, 0.92), dayAmount);
    const vec3 fogAmbientSky = clearSkyInscatter(
        worldDirection,
        sunElevation,
        lightDirection,
        directLightColor,
        skyRadianceScale,
        skyWeatherFactor,
        vec3(1.0));
    const vec3 fogAmbient = mix(fogAmbientLegacy, fogAmbientSky,
        clamp(cam.fogExtrasParams.z, 0.0, 1.0));

    FogResult fog = evaluateAnalyticFog(
        cameraPosition,
        worldDirection,
        sceneDistance,
        directLightColor * directLightEnergy * moonAmount,
        lightDirection,
        fogAmbient,
        rain,
        cam.cloudParams7.x, cam.cloudParams7.y, cam.cloudParams7.z, cam.cloudParams7.w,
        cam.cloudParams8.x, cam.cloudParams8.y, cam.cloudParams8.z, cam.cloudParams8.w,
        cam.cloudParams9.x, cam.cloudParams9.y, cam.cloudParams9.z,
        cam.fogExtrasParams.y, cam.fogExtrasParams.w, cam.fogExtrasParams.x,
        // 2026-10-23 雨天地面雾浪（两个死 lane 复用，见 v1 同名段）。
        cam.cloudParams4.y, cam.cloudParams4.z, cam.cloudParams4.w, cam.cloudParams9.w);

    {
        float aerialStrength = clamp(cam.cloudAerialParams.x, 0.0, 2.0);
        if(aerialStrength > 0.001 && cloudDistance > 0.0 && cloudDistance < V3_EMPTY_DISTANCE)
        {
            float aerialDistance = clamp(cloudDistance, 0.0, 10000.0);
            float aerialHeightDensity = clearSkyAerialHeightDensity(
                cameraPosition, worldDirection, aerialDistance);
            vec3 aerialInscatter = clearSkyInscatter(worldDirection, sunElevation,
                lightDirection, directLightColor, skyRadianceScale, skyWeatherFactor, vec3(1.0));
            vec3 aerialExtinction = ATM_AP_BASE_EXTINCTION * aerialStrength *
                aerialHeightDensity * (1.0 + 3.0 * rain * rain);
            vec3 aerialTransmittance = exp(-aerialExtinction * aerialDistance);
            float cloudOpacityForAerial = clamp(march.a, 0.0, 1.0);
            vec3 withAerial = scattering * aerialTransmittance +
                aerialInscatter * (vec3(1.0) - aerialTransmittance);
            scattering = mix(scattering, withAerial, cloudOpacityForAerial);
        }
    }

    if(fog.transmittance < 1.0)
    {
        if(fog.firstDistance <= cloudDistance)
        {
            scattering = scattering * fog.transmittance + fog.scattering;
        }
        else
        {
            scattering += transmittance * fog.scattering;
        }
        transmittance *= fog.transmittance;
    }

    float combinedFirst = min(cloudDistance, fog.firstDistance);
    float reprojectDistance = cam.cloudMarchParams.w > 0.5 ? cloudDistance : combinedFirst;
    if(reprojectDistance <= 0.0 || reprojectDistance >= V3_EMPTY_DISTANCE)
    {
        reprojectDistance = combinedFirst;
    }
    imageStore(cloudDepthOutput, pixel, vec4(combinedFirst, reprojectDistance, 0.0, 0.0));
    imageStore(cloudOutput, pixel, vec4(scattering, transmittance));
}
