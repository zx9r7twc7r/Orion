#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require


#include "sharc_enable.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(binding = 2, set = 0) uniform CameraProperties {
    #include "camera_ubo.glsl"
} cam;

#include "sharc_ubo.glsl"

void main()
{
    const uint entryIndex = gl_GlobalInvocationID.x;

    SharcParameters sharcParameters = sharcBuildParameters();

    if(entryIndex >= sharcParameters.hashGridData.capacity)
    {
        return;
    }

    SharcResolveEntry(
        entryIndex,
        sharcParameters,
        sharcBuildResolveParameters());
}
