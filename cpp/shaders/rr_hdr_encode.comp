#version 460


layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#ifndef RR_STABLE_GLASS_RADIANCE
#define RR_STABLE_GLASS_RADIANCE 0
#endif

layout(binding = 0, set = 0, rgba16f)
uniform image2D rrOutputImage;

#if RR_STABLE_GLASS_RADIANCE
layout(binding = 2, set = 0)
uniform sampler2D rrStableRadianceImage;
#endif

layout(binding = 1, set = 0)
buffer AeState
{
    float currentEV;

    float targetEV;
    float avgLogLuma;
    uint sampleCount;

    float cloudWhite;
};

const float AE_EXPOSURE_STRENGTH = 0.6;

const float PQ_M1 = 0.1593017578125;
const float PQ_M2 = 78.84375;
const float PQ_C1 = 0.8359375;
const float PQ_C2 = 18.8515625;
const float PQ_C3 = 18.6875;
const float PQ_PEAK_NITS = 10000.0;
const float PQ_REFERENCE_WHITE_NITS = 203.0;

const mat3 REC709_TO_REC2020 = mat3(
    0.6274040, 0.0690970, 0.0163916,
    0.3292820, 0.9195400, 0.0880132,
    0.0433136, 0.0113612, 0.8955950
);

vec3 encodePQ(vec3 linearNits)
{
    vec3 y =
        clamp(
            linearNits / PQ_PEAK_NITS,
            vec3(0.0),
            vec3(1.0)
        );

    vec3 n =
        pow(y, vec3(PQ_M1));

    return pow(
        (vec3(PQ_C1) + PQ_C2 * n) /
            (vec3(1.0) + PQ_C3 * n),
        vec3(PQ_M2)
    );
}

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(rrOutputImage);

    if(p.x >= size.x || p.y >= size.y)
    {
        return;
    }

    vec4 color = imageLoad(rrOutputImage, p);

    vec3 linear =
        max(
            mix(color.rgb, vec3(0.0), isnan(color.rgb)),
            vec3(0.0)
        );

#if RR_STABLE_GLASS_RADIANCE
#ifndef POST_SKIP_STABLE
#define POST_SKIP_STABLE 0
#endif
#if !POST_SKIP_STABLE
    vec3 stableRadiance =
        (textureSize(rrStableRadianceImage, 0) == size)
            ? texelFetch(rrStableRadianceImage, p, 0).rgb
            : texture(
                  rrStableRadianceImage,
                  (vec2(p) + vec2(0.5)) / vec2(size)
              ).rgb;

    linear +=
        max(
            mix(
                stableRadiance,
                vec3(0.0),
                isnan(stableRadiance)
            ),
            vec3(0.0)
        );
#endif
#endif

    linear *=
        exp2(currentEV * AE_EXPOSURE_STRENGTH);

    linear =
        min(
            linear,
            vec3(PQ_PEAK_NITS / PQ_REFERENCE_WHITE_NITS)
        );

    vec3 rec2020 =
        REC709_TO_REC2020 * linear;

    vec3 encoded =
        encodePQ(
            rec2020 * PQ_REFERENCE_WHITE_NITS
        );

    imageStore(
        rrOutputImage,
        p,
        vec4(encoded, color.a)
    );
}
