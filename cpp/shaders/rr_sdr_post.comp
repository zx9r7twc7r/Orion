float a2Copysign(float x, float y)
{
    return (y < 0.0) ? -abs(x) : abs(x);
}

float a2WrapTo360(float hue)
{
    float y = mod(hue, 360.0);
    if (y < 0.0)
    {
        y = y + 360.0;
    }
    return y;
}

int a2HuePos(float hue, int tableSize)
{
    return int(a2WrapTo360(hue) / 360.0 * float(tableSize));
}

float a2Lerp(float a, float b, float t)
{
    return a + t * (b - a);
}

// Post-adaptation cone response compression（Hellwig 2022）
float a2ConeFwd(float v)
{
    float a = abs(v);
    float f = pow(a, 0.42);
    return a2Copysign(f / (ACES2_CONE_OFFSET + f), v);
}

float a2ConeInv(float v)
{
    float a = min(abs(v), 0.99);
    float f = (ACES2_CONE_OFFSET * a) / (1.0 - a);
    return a2Copysign(pow(f, 1.0 / 0.42), v);
}

float a2AchromaticNToJ(float a)
{
    return ACES2_J_SCALE * pow(a, ACES2_CZ);
}

float a2JToAchromaticN(float j)
{
    return pow(j * (1.0 / ACES2_J_SCALE), ACES2_INV_CZ);
}

float a2JToY(float j)
{
    float ra = ACES2_AW_J * a2JToAchromaticN(abs(j));
    return a2ConeInv(ra) / ACES2_FL_N;
}

float a2YToJ(float y)
{
    float ra = a2ConeFwd(abs(y) * ACES2_FL_N);
    float j = a2AchromaticNToJ(ra * ACES2_INV_AW_J);
    return a2Copysign(j, y);
}

vec3 a2RgbToAab(vec3 rgb, mat3 rgbToCam16c, mat3 coneToAab)
{
    vec3 m = rgbToCam16c * rgb;
    vec3 a = vec3(a2ConeFwd(m.x), a2ConeFwd(m.y), a2ConeFwd(m.z));
    return coneToAab * a;
}

vec3 a2AabToRgb(vec3 aab, mat3 aabToCone, mat3 cam16cToRgb)
{
    vec3 a = aabToCone * aab;
    vec3 m = vec3(a2ConeInv(a.x), a2ConeInv(a.y), a2ConeInv(a.z));
    return cam16cToRgb * m;
}

vec3 a2AabToJmh(vec3 aab)
{
    if (aab.x <= 0.0)
    {
        return vec3(0.0);
    }
    float j = a2AchromaticNToJ(aab.x);
    float m = length(aab.yz);
    float h = a2WrapTo360(degrees(atan(aab.z, aab.y)));
    return vec3(j, m, h);
}

vec3 a2JmhToAab(vec3 jmh)
{
    float hr = radians(jmh.z);
    return vec3(a2JToAchromaticN(jmh.x),
                jmh.y * cos(hr),
                jmh.y * sin(hr));
}

// Tonescale.ctl: tonescale_fwd（输出为 cd/m^2）
float a2TonescaleFwd(float x)
{
    float f = ACES2_TS_M2 * pow(max(0.0, x) / (x + ACES2_TS_S2), ACES2_TS_G);
    float h = max(0.0, f * f / (f + ACES2_TS_T1));
    return h * ACES2_TS_N_R;
}

// OutputTransform.ctl: chroma_compress_norm
float a2ChromaCompressNorm(float h)
{
    float hr = radians(h);
    float a = cos(hr);
    float b = sin(hr);
    float cosHr2 = a * a - b * b;
    float sinHr2 = 2.0 * a * b;
    float cosHr3 = 4.0 * a * a * a - 3.0 * a;
    float sinHr3 = 3.0 * b - 4.0 * b * b * b;

    float m = 11.34072 * a
            + 16.46899 * cosHr2
            + 7.88380 * cosHr3
            + 14.66441 * b
            - 6.37224 * sinHr2
            + 9.19364 * sinHr3
            + 77.12896;
    return m * ACES2_CHROMA_COMPRESS_SCALE;
}

// OutputTransform.ctl: reach_M_from_table
float a2ReachMFromTable(float h)
{
    int base = a2HuePos(h, 360);
    float t = h - float(base);
    int iLo = base + 1;
    return mix(ACES2_TABLE_REACH_M[iLo], ACES2_TABLE_REACH_M[iLo + 1], t);
}

// OutputTransform.ctl: toe（逆用与正用同一个函数，CTL 里靠 invert 分支）
float a2Toe(float x, float limit, float k1In, float k2In)
{
    if (x > limit)
    {
        return x;
    }
    float k2 = max(k2In, 0.001);
    float k1 = sqrt(k1In * k1In + k2 * k2);
    float k3 = (limit + k1) / (limit + k2);

    float minusB = k3 * x - k1;
    float minusC = k2 * k3 * x;
    return 0.5 * (minusB + sqrt(max(minusB * minusB + 4.0 * minusC, 0.0)));
}

// OutputTransform.ctl: chroma_compress_fwd
vec3 a2ChromaCompressFwd(vec3 jmh, float tonemappedJ)
{
    float j = jmh.x;
    float m = jmh.y;
    float h = jmh.z;

    float mCompr = m;

    if (m != 0.0)
    {
        float nJ = tonemappedJ / ACES2_LIMIT_J_MAX;
        float snJ = max(0.0, 1.0 - nJ);
        float mNorm = a2ChromaCompressNorm(h);
        float limit = pow(nJ, ACES2_MODEL_GAMMA_INV) * a2ReachMFromTable(h) / mNorm;

        float toeLimit = limit - 0.001;
        float toeSnJSat = snJ * ACES2_SAT;
        float toeSqrtNJSatThr = sqrt(nJ * nJ + ACES2_SAT_THR);
        float toeNJCompr = nJ * ACES2_COMPR;

        mCompr = m * pow(tonemappedJ / j, ACES2_MODEL_GAMMA_INV);
        mCompr = mCompr / mNorm;
        mCompr = limit - a2Toe(limit - mCompr, toeLimit, toeSnJSat, toeSqrtNJSatThr);
        mCompr = a2Toe(mCompr, limit, toeNJCompr, snJ);
        mCompr = mCompr * mNorm;
    }

    return vec3(tonemappedJ, mCompr, h);
}

// OutputTransform.ctl: compute_focus_J / get_focus_gain / solve_J_intersect /
// compute_compression_vector_slope / smin_scaled /
// estimate_line_and_boundary_intersection_M / remap_M
float a2ComputeFocusJ(float cuspJ)
{
    return a2Lerp(cuspJ, ACES2_MID_J,
                  min(1.0, ACES2_CUSP_MID_BLEND - (cuspJ / ACES2_LIMIT_J_MAX)));
}

float a2GetFocusGain(float j, float analyticalThreshold)
{
    float gain = ACES2_LIMIT_J_MAX * ACES2_FOCUS_DIST;
    if (j > analyticalThreshold)
    {
        float adj = log((ACES2_LIMIT_J_MAX - analyticalThreshold)
                        / max(0.0001, ACES2_LIMIT_J_MAX - j)) / log(10.0);
        adj = adj * adj + 1.0;
        gain = gain * adj;
    }
    return gain;
}

float a2SolveJIntersect(float j, float m, float focusJ, float slopeGain)
{
    float mScaled = m / slopeGain;
    float a = mScaled / focusJ;

    if (j < focusJ)
    {
        float b = 1.0 - mScaled;
        float c = -j;
        float det = b * b - 4.0 * a * c;
        float root = sqrt(max(det, 0.0));
        return (-2.0 * c) / (b + root);
    }
    else
    {
        float b = -(1.0 + mScaled + ACES2_LIMIT_J_MAX * a);
        float c = ACES2_LIMIT_J_MAX * mScaled + j;
        float det = b * b - 4.0 * a * c;
        float root = sqrt(max(det, 0.0));
        return (-2.0 * c) / (b - root);
    }
}

float a2CompressionVectorSlope(float intersectJ, float focusJ, float slopeGain)
{
    float directionScalar = (intersectJ < focusJ)
        ? intersectJ
        : (ACES2_LIMIT_J_MAX - intersectJ);
    return directionScalar * (intersectJ - focusJ) / (focusJ * slopeGain);
}

float a2SminScaled(float a, float b, float scaleReference)
{
    float sScaled = ACES2_SMOOTH_CUSPS * scaleReference;
    float h = max(sScaled - abs(a - b), 0.0) / sScaled;
    return min(a, b) - h * h * h * sScaled * (1.0 / 6.0);
}

float a2EstimateLineBoundaryM(float jAxisIntersect, float slope, float invGamma,
                              float jMax, float mMax, float jIntersectionReference)
{
    float normalisedJ = jAxisIntersect / jIntersectionReference;
    float shiftedIntersection = jIntersectionReference * pow(normalisedJ, invGamma);
    float denom = jMax - slope * mMax;
    return (denom == 0.0) ? 0.0 : shiftedIntersection * mMax / denom;
}

float a2GamutBoundaryM(vec2 jmCusp, float gammaTopInv, float gammaBottomInv,
                       float jIntersectSource, float slope, float jIntersectCusp)
{
    float mBoundaryLower = a2EstimateLineBoundaryM(
        jIntersectSource, slope, gammaBottomInv,
        jmCusp.x, jmCusp.y, jIntersectCusp);

    float fJIntersectCusp = ACES2_LIMIT_J_MAX - jIntersectCusp;
    float fJIntersectSource = ACES2_LIMIT_J_MAX - jIntersectSource;
    float fJmCuspJ = ACES2_LIMIT_J_MAX - jmCusp.x;
    float mBoundaryUpper = a2EstimateLineBoundaryM(
        fJIntersectSource, -slope, gammaTopInv,
        fJmCuspJ, jmCusp.y, fJIntersectCusp);

    return a2SminScaled(mBoundaryLower, mBoundaryUpper, jmCusp.y);
}

float a2RemapM(float m, float gamutBoundaryM, float reachBoundaryM)
{
    float boundaryRatio = gamutBoundaryM / reachBoundaryM;
    float proportion = max(boundaryRatio, ACES2_COMPRESSION_THRESHOLD);
    float threshold = proportion * gamutBoundaryM;

    if (m <= threshold || proportion >= 1.0)
    {
        return m;
    }

    float mOffset = m - threshold;
    float gamutOffset = gamutBoundaryM - threshold;
    float reachOffset = reachBoundaryM - threshold;

    float scale = reachOffset / ((reachOffset / gamutOffset) - 1.0);
    float nd = mOffset / scale;

    return threshold + scale * nd / (1.0 + nd);
}

// OutputTransform.ctl: cusp_from_table / lookup_hue_interval 的索引区间
int a2HueInterval(float h)
{
    int lowI = 0;
    int highI = 361;
    int i = a2HuePos(h, 360) + 1;

    for (int guard = 0; guard < 16; ++guard)
    {
        if (lowI + 1 >= highI)
        {
            break;
        }
        if (h > ACES2_TABLE_HUES[i])
        {
            lowI = i;
        }
        else
        {
            highI = i;
        }
        i = (lowI + highI) / 2;
    }
    return max(1, highI);
}

vec2 a2CuspFromTable(float h, int iHi)
{
    vec2 lo = ACES2_TABLE_CUSP_JM[iHi - 1];
    vec2 hi = ACES2_TABLE_CUSP_JM[iHi];
    float hLo = ACES2_TABLE_HUES[iHi - 1];
    float hHi = ACES2_TABLE_HUES[iHi];
    float t = (hHi != hLo) ? (h - hLo) / (hHi - hLo) : 0.0;
    return vec2(a2Lerp(lo.x, hi.x, t), a2Lerp(lo.y, hi.y, t));
}

// OutputTransform.ctl: gamut_compress_fwd（含 compress_gamut 的展开）
vec3 a2GamutCompressFwd(vec3 jmh)
{
    float j = jmh.x;
    float m = jmh.y;
    float h = jmh.z;

    if (j <= 0.0)
    {
        return vec3(0.0, 0.0, h);
    }
    if (m < 0.0 || j > ACES2_LIMIT_J_MAX)
    {
        return vec3(j, 0.0, h);
    }

    int iHi = a2HueInterval(h);
    vec2 cusp = a2CuspFromTable(h, iHi);
    float t = h - ACES2_TABLE_HUES[iHi - 1];
    float gammaTopInv = a2Lerp(ACES2_TABLE_UPPER_HULL_GAMMA[iHi - 1],
                               ACES2_TABLE_UPPER_HULL_GAMMA[iHi], t);
    float focusJ = a2ComputeFocusJ(cusp.x);
    float analyticalThreshold = a2Lerp(cusp.x, ACES2_LIMIT_J_MAX, ACES2_FOCUS_GAIN_BLEND);

    float slopeGain = a2GetFocusGain(j, analyticalThreshold);
    float jIntersectSource = a2SolveJIntersect(j, m, focusJ, slopeGain);
    float gamutSlope = a2CompressionVectorSlope(jIntersectSource, focusJ, slopeGain);
    float jIntersectCusp = a2SolveJIntersect(cusp.x, cusp.y, focusJ, slopeGain);

    float gamutBoundaryM = a2GamutBoundaryM(
        cusp, gammaTopInv, ACES2_LOWER_HULL_GAMMA_INV,
        jIntersectSource, gamutSlope, jIntersectCusp);

    if (gamutBoundaryM <= 0.0)
    {
        return vec3(j, 0.0, h);
    }

    float reachMaxM = a2ReachMFromTable(h);
    float reachBoundaryM = a2EstimateLineBoundaryM(
        jIntersectSource, gamutSlope, ACES2_MODEL_GAMMA_INV,
        ACES2_LIMIT_J_MAX, reachMaxM, ACES2_LIMIT_J_MAX);

    float remappedM = a2RemapM(m, gamutBoundaryM, reachBoundaryM);
    return vec3(jIntersectSource + remappedM * gamutSlope, remappedM, h);
}

// OutputTransform.ctl: clamp_AP0_to_AP1
vec3 a2ClampAp0ToAp1(vec3 aces)
{
    vec3 ap1 = ACES2_AP0_TO_AP1 * aces;
    vec3 ap1Clamped = clamp(ap1, vec3(0.0), vec3(ACES2_TS_FORWARD_LIMIT));
    return ACES2_AP1_TO_AP0 * ap1Clamped;
}

// 预设 main() 的前半段：线性 sRGB(D65) → AP0 → outputTransform_fwd →
// clamp 到峰值 → （scale_white = false，跳过）→ limiting→display 矩阵。
vec3 aces2DisplayLinear(vec3 linearSrgb)
{
    vec3 aces = ACES2_SRGB_TO_AP0 * linearSrgb;
    aces = a2ClampAp0ToAp1(aces);

    vec3 jmh = a2AabToJmh(a2RgbToAab(aces, ACES2_IN_RGB_TO_CAM16C, ACES2_IN_CONE_TO_AAB));

    // tonemap_and_compress_fwd
    float linear = a2JToY(jmh.x) / ACES2_REF_LUMINANCE;
    float tonemappedY = a2TonescaleFwd(linear);
    float jTs = a2YToJ(tonemappedY);
    jmh = a2ChromaCompressFwd(jmh, jTs);

    // gamut_compress_fwd
    jmh = a2GamutCompressFwd(jmh);

    vec3 rgb = a2AabToRgb(a2JmhToAab(jmh), ACES2_LIM_AAB_TO_CONE, ACES2_LIM_CAM16C_TO_RGB);
    rgb = clamp(rgb, vec3(0.0), vec3(1.0));
    rgb = rgb * ACES2_WHITE_SCALE;
    return ACES2_LIMIT_TO_DISPLAY * rgb;
}

// 2026-10-23 临时诊断（mode 7..12）：逐段输出 ACES2 中间量，用于把 GPU 结果与
// CPU 模型对齐。stage 1=AP0 输入 2=JMh 3=tonescale 后 4=色度压缩后 5=色域压缩后
// 6=反变换 RGB。诊断完即删。
vec3 aces2Debug(vec3 linearSrgb, int stage)
{
    vec3 aces = a2ClampAp0ToAp1(ACES2_SRGB_TO_AP0 * linearSrgb);
    if(stage == 1)
    {
        return aces * 0.25;
    }

    vec3 jmh = a2AabToJmh(a2RgbToAab(aces, ACES2_IN_RGB_TO_CAM16C, ACES2_IN_CONE_TO_AAB));
    if(stage == 2)
    {
        return vec3(jmh.x / 100.0, jmh.y / 200.0, jmh.z / 360.0);
    }

    float linear = a2JToY(jmh.x) / ACES2_REF_LUMINANCE;
    float tonemappedY = a2TonescaleFwd(linear);
    float jTs = a2YToJ(tonemappedY);
    if(stage == 3)
    {
        return vec3(jTs / 100.0, tonemappedY / 100.0, 0.0);
    }

    vec3 jmhC = a2ChromaCompressFwd(jmh, jTs);
    if(stage == 4)
    {
        return vec3(jmhC.x / 100.0, jmhC.y / 200.0, jmhC.z / 360.0);
    }

    vec3 jmhG = a2GamutCompressFwd(jmhC);
    if(stage == 5)
    {
        return vec3(jmhG.x / 100.0, jmhG.y / 200.0, jmhG.z / 360.0);
    }

    vec3 rgb = a2AabToRgb(a2JmhToAab(jmhG), ACES2_LIM_AAB_TO_CONE, ACES2_LIM_CAM16C_TO_RGB);
    return rgb * 0.25;
}

// ===========================================================================
// 2026-10-26 色彩分级的小件（设置页「色彩映射与调色」）
// 全部作用在**显示域**（已 tonemap + 已做 gamma 的 [0,1] 值）—— 与 Resolve 的
// 一级调色同一口径：Lift/Gamma/Gain、黑白场、支点对比、分离色调、暗角。
// ===========================================================================

const vec3 GRADE_LUMA = vec3(0.2126, 0.7152, 0.0722);

// 色调轮：hue 度 → 纯色（HSV 的 S=1 V=1，六段式）。
vec3 gradeHueColor(float deg)
{
    return clamp(abs(mod(deg / 60.0 + vec3(0.0, 4.0, 2.0), 6.0) - 3.0) - 1.0, 0.0, 1.0);
}

// 绕灰轴 (1,1,1)/√3 旋转色相（Rodrigues）。灰轴上的颜色（R=G=B）旋转后不变，
// 所以中性灰不会被染色 —— 这正是想要的：只把"有彩"的部分往冷/暖推。
vec3 gradeHueRotate(vec3 c, float deg)
{
    const vec3 axis = vec3(0.57735026919);
    float a = radians(deg);
    float cs = cos(a);
    float sn = sin(a);
    return c * cs + cross(axis, c) * sn + axis * dot(axis, c) * (1.0 - cs);
}

// 分离色调：把"当前色相相对灰轴的色度偏移"按亮度掩码加到画面上。
// 用加色度（而不是乘法）是为了保持亮度不变：strength 只推色相，不动明暗。
vec3 gradeSplitTone(vec3 c, float hue, float strength, float mask)
{
    vec3 tint = gradeHueColor(hue);
    vec3 chroma = tint - vec3(dot(tint, GRADE_LUMA));
    return c + chroma * (strength * mask * 0.35);
}

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(rrOutputImage);

    if(p.x >= size.x || p.y >= size.y)
    {
        return;
    }

    vec4 color = imageLoad(rrOutputImage, p);

    // 2026-10-30：NaN / Inf 清洗 —— 与 rr_hdr_encode.comp:104-110 对齐。
    //
    // 实测：RT 帧里确实存在 NaN（HDR 链早就在入口 scrub，注释原文
    // "Denormals, inf and NaN all reach here from the path-traced frame and
    //  would survive the pow() chain as NaN once written to the target"）。
    // SDR 链此前只对 stableRadiance 做过 isnan（且那个分支编译期关闭），
    // 入口的 color.rgb 完全没防护 ⇒ NaN 穿过 tonemap → pow() → 写进目标，
    // 屏幕表现为画面中心一块椭圆区域"透出下层"。
    // 切到 HDR 后该症状消失，正是因为 HDR 链在这里已经清洗过。
    //
    // 注意：这是**止血**，不是根治 —— NaN 的真正来源（某个材质/光照计算
    // 产生 0/0 或 log(负数)）仍需单独排查。
    // bvec3 不能用 ||，逐分量 mix 两次（写法与 rr_hdr_encode.comp 一致）。
    color.rgb = mix(color.rgb, vec3(0.0), isnan(color.rgb));
    color.rgb = mix(color.rgb, vec3(0.0), isinf(color.rgb));
    color.rgb = max(color.rgb, vec3(0.0));

#if RR_STABLE_GLASS_RADIANCE
#ifndef POST_SKIP_STABLE
#define POST_SKIP_STABLE 0
#endif
#if !POST_SKIP_STABLE
    vec3 stableRadiance =
        (textureSize(rrStableRadianceImage, 0) == size)
            ? texelFetch(rrStableRadianceImage, p, 0).rgb
            : texture(
                  rrStableRadianceImage,
                  (vec2(p) + vec2(0.5)) / vec2(size)
              ).rgb;

    color.rgb +=
        max(
            mix(
                stableRadiance,
                vec3(0.0),
                isnan(stableRadiance)
            ),
            vec3(0.0)
        );
#endif
#endif

    // 自动曝光（参与度现在是可调参数；出厂 0.6）
    vec3 exposed =
        max(
            color.rgb * exp2(currentEV * postPush.exposureStrength),
            vec3(0.0)
        );

    // 2026-10-23 调色调：线性光通道增益（1,1,1 = 逐位恒等）。放在色调映射之前
    // ⇒ 等效相机白平衡；三通道独立，可以当色温/色调/自定义染色用。
    exposed *= vec3(postPush.gainR, postPush.gainG, postPush.gainB);

    // 2026-10-26 手动曝光（档）。exp2(0) 严格等于 1 ⇒ 默认逐位不变。
    exposed *= exp2(postPush.manualEV);

    // 色彩映射（各模式输出**线性**值）
    vec3 displayLinear;
    if(postPush.tonemapMode == 1)
    {
        displayLinear = agxEotf(agx(exposed));
    }
    else if(postPush.tonemapMode == 2)
    {
        displayLinear = khronosPbrNeutral(exposed);
    }
    else if(postPush.tonemapMode == 3)
    {
        displayLinear = acesFilmic(exposed);
    }
    else if(postPush.tonemapMode == 4)
    {
        displayLinear = uncharted2(exposed);
    }
    else if(postPush.tonemapMode == 5)
    {
        displayLinear = reinhardJodie(exposed);
    }
    else if(postPush.tonemapMode == 6)
    {
        displayLinear = aces2DisplayLinear(exposed);
    }
    else if(postPush.tonemapMode >= 7 && postPush.tonemapMode <= 12)
    {
        displayLinear = aces2Debug(exposed, postPush.tonemapMode - 6);
    }
    else
    {
        displayLinear = uchimura(exposed);
    }

    // 统一 gamma（出厂 2.2，可调）与饱和度（出厂 1.08）
    vec3 displayColor = pow(max(displayLinear, vec3(0.0)), vec3(1.0 / postPush.gamma));
    const float luma = dot(displayColor, vec3(0.2126, 0.7152, 0.0722));
    displayColor = mix(vec3(luma), displayColor, postPush.saturation);

    // =======================================================================
    // 2026-10-26 色彩分级（设置页「色彩映射与调色」，24 lane）
    //
    // 作用点：显示域 [0,1]（tonemap + gamma + 饱和度之后）。这一段是新加的，
    // **全部参数取中性值时整块跳过** ⇒ 老存档 / 没调过的人画面逐位不变。
    //
    // 顺序（与 Resolve 一级调色一致，改顺序会改变观感，别随手挪）：
    //   黑白场 → 支点对比 → 逐通道 Lift/Gamma/Gain → 色相旋转 →
    //   分离色调（阴影/高光）→ 自然饱和度 → 褪色 → 绿/品红 → 暗角
    // =======================================================================
    bool cgActive =
        postPush.blackPoint != 0.0 ||
        postPush.whitePoint != 1.0 ||
        postPush.gradeContrast != 1.0 ||
        postPush.liftR != 0.0 || postPush.liftG != 0.0 || postPush.liftB != 0.0 ||
        postPush.gradeGammaR != 1.0 || postPush.gradeGammaG != 1.0 ||
        postPush.gradeGammaB != 1.0 ||
        postPush.gradeGainR != 1.0 || postPush.gradeGainG != 1.0 ||
        postPush.gradeGainB != 1.0 ||
        postPush.shadowStrength != 0.0 ||
        postPush.highlightStrength != 0.0 ||
        postPush.vibrance != 0.0 ||
        postPush.fade != 0.0 ||
        postPush.vignette != 0.0 ||
        postPush.hueRotate != 0.0 ||
        postPush.tintGreen != 0.0;

    if(cgActive)
    {
        // ① 黑白场（levels）：把 [blackPoint, whitePoint] 拉回 [0,1]。
        const float cgSpan = max(postPush.whitePoint - postPush.blackPoint, 1.0e-3);
        displayColor =
            max((displayColor - vec3(postPush.blackPoint)) / cgSpan, vec3(0.0));

        // ② 支点对比：以 gradePivot 为轴拉伸/压缩。
        displayColor =
            max((displayColor - vec3(postPush.gradePivot)) * postPush.gradeContrast
                + vec3(postPush.gradePivot), vec3(0.0));

        // ③ ASC-CDL：out = (in * slope + offset) ^ (1/power)。
        //    这里 slope = gradeGain、offset = lift、power = gradeGamma。
        //    逐通道 ⇒ 可以把阴影压青、高光留暖（或反过来），是三通道旋钮做不到的。
        const vec3 cdGain =
            vec3(postPush.gradeGainR, postPush.gradeGainG, postPush.gradeGainB);
        const vec3 cdLift =
            vec3(postPush.liftR, postPush.liftG, postPush.liftB);
        const vec3 cdGamma =
            vec3(postPush.gradeGammaR, postPush.gradeGammaG, postPush.gradeGammaB);

        if(cdGain != vec3(1.0) || cdLift != vec3(0.0) || cdGamma != vec3(1.0))
        {
            displayColor =
                pow(max(displayColor * cdGain + cdLift, vec3(0.0)), 1.0 / cdGamma);
        }

        // ④ 全色相旋转（绕灰轴，中性色不动）。
        if(postPush.hueRotate != 0.0)
        {
            displayColor = gradeHueRotate(displayColor, postPush.hueRotate);
        }

        // ⑤ 分离色调：暗部推冷、亮部留中性 —— "孤独感"主要靠这一步 + 色温。
        if(postPush.shadowStrength != 0.0 || postPush.highlightStrength != 0.0)
        {
            const float tl = dot(displayColor, GRADE_LUMA);
            const float shadowMask = 1.0 - smoothstep(0.0, 0.55, tl);
            const float highMask = smoothstep(0.45, 1.0, tl);

            if(postPush.shadowStrength != 0.0)
            {
                displayColor = gradeSplitTone(
                    displayColor, postPush.shadowHue, postPush.shadowStrength, shadowMask);
            }
            if(postPush.highlightStrength != 0.0)
            {
                displayColor = gradeSplitTone(
                    displayColor, postPush.highlightHue, postPush.highlightStrength, highMask);
            }
        }

        // ⑥ 自然饱和度：彩色越多的地方越少动（与 ⑤ 相反，收彩时保住高彩细节）。
        if(postPush.vibrance != 0.0)
        {
            const float vl = dot(displayColor, GRADE_LUMA);
            const float mx = max(displayColor.r, max(displayColor.g, displayColor.b));
            const float mn = min(displayColor.r, min(displayColor.g, displayColor.b));
            const float chroma = max(mx - mn, 0.0);
            const float amount = postPush.vibrance * (1.0 - smoothstep(0.0, 0.7, chroma));
            displayColor =
                mix(vec3(vl), displayColor, clamp(1.0 + amount, 0.0, 2.0));
        }

        // ⑦ 褪色（fade）：抬黑 + 压白 = 胶片那种"发灰的远"。
        if(postPush.fade != 0.0)
        {
            displayColor = displayColor * (1.0 - 0.30 * postPush.fade)
                         + vec3(0.11 * postPush.fade);
        }

        // ⑧ 绿/品红微调（一次性整体偏色，比三通道增益更容易压出"青绿感"）。
        if(postPush.tintGreen != 0.0)
        {
            displayColor *=
                vec3(1.0 - 0.05 * postPush.tintGreen,
                     1.0 + 0.07 * postPush.tintGreen,
                     1.0 - 0.05 * postPush.tintGreen);
        }

        // ⑨ 暗角：按"到中心的归一化距离"压边角。radius 越大起始越靠外。
        if(postPush.vignette != 0.0)
        {
            const vec2 halfSize = vec2(size) * 0.5;
            const vec2 q = (vec2(p) + vec2(0.5) - halfSize) / max(halfSize.x, 1.0);
            const float radial = length(q) / max(length(vec2(1.0, halfSize.y / max(halfSize.x, 1.0))), 1.0e-3);
            const float falloff =
                smoothstep(postPush.vignetteRadius, 1.0, radial);
            displayColor *= (1.0 - postPush.vignette * falloff);
        }

        displayColor = clamp(displayColor, vec3(0.0), vec3(1.0));
    }

    imageStore(
        rrOutputImage,
        p,
        vec4(displayColor, color.a)
    );
}
