#version 460

// RR-6.5 SDR display transform: RR-7 auto-exposure scale, then a tone curve.
//
// In-place compute pass over the RR linear-HDR output, 8x8 groups, one rgba16f
// storage image.  rr_hdr_encode.comp shares this descriptor set layout, so the
// bindings and the group size here and there have to stay identical; only the
// transfer function may differ.
//
// 2026-10-03 **色彩映射可切换**（用户要求）：push constant 选模式 + 4 个参数
//（曝光参与度 / 对比 / 饱和 / gamma）。所有曲线统一输出**线性**值，最后统一做
// gamma 与饱和度 ⇒ 出厂观感（Uchimura/GT + 2.2）与旧实现逐位一致。
//   mode 0 = Uchimura 2017（= GT tonemap，Polyphony 出厂口径，对比可调）
//   mode 1 = AgX（minimal，Blender 4.0 起的默认 display transform）
//   mode 2 = Khronos PBR Neutral（three.js/model-viewer 移植，MIT）
//   mode 3 = ACES（Hill RRT+ODT fit，three.js/MIT 移植）
//   mode 4 = Uncharted 2 / Hable filmic
//   mode 5 = Reinhard-Jodie（基准）
//   mode 6 = ACES 2.0（2026-10-23：官方 aces-core CTL 逐函数移植，SDR Rec.709/D65
//            预设；360 项色域/色度表由 tools/aces2/port.py 离线烘焙，见下方
//            ACES2 区块）。★ 官方标定是"18% 灰 = 10 nits"，即 ACES 1.0 只映射到
//
// 2026-10-23 调色调（用户要求，所有模式共用）：push constant 末尾 3 个 lane
// 是线性光的 R/G/B 通道增益（1,1,1 = 逐位恒等），作用点在**色调映射之前**，
// 即等效相机白平衡；色温/色调都可以靠它手调。

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// 2026-10-03 后处理参数（宿主每帧随 dispatch 推送）。
//
// 2026-10-26：**扩到 32 lane = 128 字节**（Vulkan 对 push constant 的保底上限就是
// 128），后 24 lane 是新的「色彩分级」组（设置页「色彩映射与调色」）。全部恒等时
// main() 里整块跳过 ⇒ 老存档的画面逐位不变。宿主侧
// cpp/VulkanCore.cpp 的 PostProcessingPush 必须与之逐 lane 对齐。
layout(push_constant) uniform PostPush
{
    int tonemapMode;         // 见文件头 mode 表
    float exposureStrength;  // 自动曝光参与度（出厂 0.6）
    float contrast;          // Uchimura 的 a（出厂口径 1.35，原版 1.0）
    float saturation;        // 饱和度（出厂 1.08）
    float gamma;             // 显示 gamma（出厂 2.2）
    // 2026-10-23 调色调：线性光通道增益（1,1,1 = 逐位恒等）
    float gainR;
    float gainG;
    float gainB;

    // ===== 2026-10-26 色彩分级 24 lane（1 / 0 之类的"中性值"见每条注释）=====
    float manualEV;          // 手动曝光（档，0 = 恒等；±4 约 ±4 档）
    float blackPoint;        // 黑点（0 = 恒等）
    float whitePoint;        // 白点（1 = 恒等；<1 提前削白=更平）
    float gradeContrast;     // 显示域对比（1 = 恒等）
    float gradePivot;        // 对比支点（0.18 线性灰）
    float liftR;             // ASC-CDL offset（0 = 恒等）
    float liftG;
    float liftB;
    float gradeGammaR;       // ASC-CDL 1/power（1 = 恒等）
    float gradeGammaG;
    float gradeGammaB;
    float gradeGainR;        // ASC-CDL slope（1 = 恒等）
    float gradeGainG;
    float gradeGainB;
    float shadowHue;         // 阴影分离色调色相（度）
    float shadowStrength;    // 0 = 关
    float highlightHue;      // 高光分离色调色相（度）
    float highlightStrength; // 0 = 关
    float vibrance;          // 自然饱和度（0 = 恒等；负 = 收彩）
    float fade;              // 褪色/发灰（0 = 恒等；抬黑 + 压白）
    float vignette;          // 暗角强度（0 = 关）
    float vignetteRadius;    // 暗角起始半径（0.6 起暗）
    float hueRotate;         // 全色相旋转（度，0 = 恒等；绕灰轴，保中性色）
    float tintGreen;         // 绿/品红微调（0 = 恒等；>0 偏青绿，<0 偏品红）
} postPush;

// Analytic pane radiance that the raygen withheld from DLSS RR, added back
// here.  See RR_STABLE_GLASS_RADIANCE in rt_test.rgen for why it is split at
// all.  Defined before the descriptor declarations below because the
// preprocessor has to know the value by then.
#ifndef RR_STABLE_GLASS_RADIANCE
#define RR_STABLE_GLASS_RADIANCE 0
#endif

layout(binding = 0, set = 0, rgba16f)
uniform image2D rrOutputImage;

#if RR_STABLE_GLASS_RADIANCE
layout(binding = 2, set = 0)
uniform sampler2D rrStableRadianceImage;
#endif

layout(binding = 1, set = 0)
buffer AeState
{
    float currentEV;
    float targetEV;
    float avgLogLuma;
    uint sampleCount;
    float cloudWhite;
};

// ---------------------------------------------------------------------------
// mode 0: Uchimura 2017（= 社区所谓 GT tonemap；本曲线即 Polyphony 官方口径）。
// 注意：与旧实现不同，这里**不做**内建 gamma —— 统一由最后的 gamma 阶段处理
//（默认 2.2 时与旧的内建 1/2.2 逐位一致）。
// ---------------------------------------------------------------------------
vec3 uchimura(vec3 x)
{
    const float P = 1.0;
    const float a = max(postPush.contrast, 1.0e-3);
    const float m = 0.22;
    const float l = 0.4;
    const float c = 1.33;
    const float b = 0.0;

    float l0 = ((P - m) * l) / a;
    float S0 = m + l0;
    float S1 = m + a * l0;
    float C2 = (a * P) / (P - S1);
    float CP = -1.44269502 * C2 / P;

    vec3 w0 = vec3(1.0 - smoothstep(0.0, m, x));
    vec3 w2 = vec3(step(S0, x));
    vec3 w1 = vec3(1.0 - w0 - w2);

    vec3 T = pow(x, vec3(c)) / pow(m, c - 1.0) + vec3(b);
    vec3 S = vec3(P - (P - S1) / exp2(CP * S0) * exp2(CP * x));
    vec3 L = vec3(m + a * (x - m));

    return T * w0 + L * w1 + S * w2;
}

// ---------------------------------------------------------------------------
// mode 1: AgX（minimal 版；Troy Sobotka 的 AgX 经 Benjamin Wrensch 压缩的
// 广泛复刻实现）。输入输出都是线性。
// ---------------------------------------------------------------------------
vec3 agxDefaultContrastApprox(vec3 x)
{
    vec3 x2 = x * x;
    vec3 x4 = x2 * x2;
    return + 15.5     * x4 * x2
           - 40.14    * x4 * x
           + 31.96    * x4
           - 6.868    * x2 * x
           + 0.4298   * x2
           + 0.1191   * x
           - 0.00232;
}

vec3 agx(vec3 val)
{
    const mat3 agx_mat = mat3(
        0.842479062253094, 0.0423282422610123, 0.0423756549057051,
        0.0783847559183253, 0.878468636469772, 0.0788490074572186,
        0.0791421364302589, 0.0791661274615315, 0.879129973650547);
    const float min_ev = -12.47393;
    const float max_ev = 4.026069;

    val = agx_mat * max(val, vec3(0.0));
    val = clamp(log2(max(val, vec3(1.0e-10))), vec3(min_ev), vec3(max_ev));
    val = (val - min_ev) / (max_ev - min_ev);
    return agxDefaultContrastApprox(val);
}

vec3 agxEotf(vec3 val)
{
    const mat3 agx_mat_inv = mat3(
        1.19687900512017, -0.0528968517574562, -0.0529716355144438,
        -0.0980208811401368, 1.15190312990417, -0.0980434501171241,
        -0.0990297440797205, -0.0989611768448433, 1.15107367264116);
    val = agx_mat_inv * val;
    return pow(max(val, vec3(0.0)), vec3(2.2));
}

// ---------------------------------------------------------------------------
// mode 2: Khronos PBR Neutral（model-viewer/three.js 移植，MIT）。输入输出线性。
// ---------------------------------------------------------------------------
vec3 khronosPbrNeutral(vec3 color)
{
    const float startCompression = 0.8 - 0.04;
    const float desaturation = 0.15;

    float x = min(color.r, min(color.g, color.b));
    float offset = x < 0.08 ? x - 6.25 * x * x : 0.04;
    color -= offset;

    float peak = max(color.r, max(color.g, color.b));
    if(peak < startCompression)
    {
        return color;
    }

    const float d = 1.0 - startCompression;
    const float newPeak = 1.0 - d * d / (peak + d - startCompression);
    color *= newPeak / peak;

    const float g = 1.0 - 1.0 / (desaturation * (peak - newPeak) + 1.0);
    return mix(color, vec3(newPeak), g);
}

// ---------------------------------------------------------------------------
// mode 3: ACES（Stephen Hill 的 RRT+ODT 拟合；three.js 移植，MIT）。
// ---------------------------------------------------------------------------
vec3 rrtAndOdtFit(vec3 v)
{
    vec3 a = v * (v + 0.0245786) - 0.000090537;
    vec3 b = v * (0.983729 * v + 0.4329510) + 0.238081;
    return a / b;
}

vec3 acesFilmic(vec3 color)
{
    const mat3 acesInputMat = mat3(
        vec3(0.59719, 0.07600, 0.02840),
        vec3(0.35458, 0.90834, 0.13383),
        vec3(0.04823, 0.01566, 0.83777));
    const mat3 acesOutputMat = mat3(
        vec3( 1.60475, -0.10208, -0.00327),
        vec3(-0.53108,  1.10813, -0.07276),
        vec3(-0.07367, -0.00605,  1.07602));

    color *= 1.0 / 0.6;   // three.js 的亮环境补偿（保持其观感口径）
    color = acesInputMat * color;
    color = rrtAndOdtFit(color);
    color = acesOutputMat * color;
    return clamp(color, vec3(0.0), vec3(1.0));
}

// ---------------------------------------------------------------------------
// mode 4: Uncharted 2 / Hable filmic。输入输出线性。
// ---------------------------------------------------------------------------
vec3 uncharted2Fit(vec3 v)
{
    const float A = 0.15;
    const float B = 0.50;
    const float C = 0.10;
    const float D = 0.20;
    const float E = 0.02;
    const float F = 0.30;
    return ((v * (A * v + C * B) + D * E) / (v * (A * v + B) + D * F)) - E / F;
}

vec3 uncharted2(vec3 x)
{
    const float exposureBias = 2.0;
    vec3 current = uncharted2Fit(x * exposureBias);
    vec3 whiteScale = vec3(1.0) / uncharted2Fit(vec3(11.2));
    return current * whiteScale;
}

// ---------------------------------------------------------------------------
// mode 5: Reinhard-Jodie。输入输出线性。
// ---------------------------------------------------------------------------
vec3 reinhardJodie(vec3 v)
{
    const float luma = dot(v, vec3(0.2126, 0.7152, 0.0722));
    const vec3 tc = v / (1.0 + v);
    return mix(v / (1.0 + luma), tc, tc);
}

