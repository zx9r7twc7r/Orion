float getClearTimeDrivenSkyLightRadianceScale()
{
    float elevation = getTimeDrivenSunElevation();
    // Keep the existing noon source-energy calibration.  Surface incidence
    // and atmospheric traversal still use the true 35-degree-latitude angle.
    float normalizedCycleElevation =
        abs(elevation) / SOLAR_LATITUDE_35_COS;
    return elevation >= 0.0
        ? normalizedCycleElevation * TIME_DRIVEN_SUN_NOON_SCALE
        : normalizedCycleElevation * TIME_DRIVEN_MOON_NOON_SCALE;
}

float getTimeDrivenSkyLightRadianceScale()
{
    float clearScale = getClearTimeDrivenSkyLightRadianceScale();
    return getTimeDrivenSunElevation() >= 0.0
        // C2 remains a high visual plane.  Receiver lighting is now derived
        // only from the sampled C3 density field below, not player-position
        // attenuation from the older plane-cloud stage.
        ? clearScale * getWeatherSunRadianceFactor()
        : clearScale;
}

vec3 getTimeDrivenSkyLightDirection()
{
    // At night the physical light source is the moon, opposite the sun and
    // therefore above the horizon.  This prevents below-world "sun" rays.
    return getTimeDrivenSunElevation() >= 0.0
        ? getTimeDrivenSunDirection()
        : -getTimeDrivenSunDirection();
}

// 黎明与黄昏的色相是分开的。旧版只看高度角，太阳上升与下降经过同一高度时
// 颜色完全相同，所以黎明和黄昏无法分辨。现在按太阳在升还是在落选色。
// phase 0 = 日出、0.25 = 正午、0.5 = 日落、0.75 = 午夜，所以
// cos(2π·phase) > 0 表示太阳在上升（黎明侧）。
// 数值必须与 sky_atmosphere.comp / volumetric_clouds.comp / volumetric_light.comp
// 保持一致，否则天空、云、光柱与地形受光会各说各话。
// 注意：全局 PI 在本文件后段才声明，这里沿用函数内 TWO_PI 的既有写法。
const vec3 TWILIGHT_DAWN_TINT = vec3(1.00, 0.55, 0.34);
const vec3 TWILIGHT_DUSK_TINT = vec3(1.00, 0.42, 0.075);

float twilightEveningWeight()
{
    const float TWO_PI = 6.28318530718;
    return smoothstep(0.20, -0.20, cos(fract(cam.historyParams.w) * TWO_PI));
}

// Direct sunlight keeps a neutral high-noon white, then moves continuously
// toward orange-gold near the horizon.  Night uses a cool lunar tint; its
// actual energy remains controlled solely by TIME_DRIVEN_MOON_NOON_SCALE.
vec3 getTimeDrivenSkyLightColor()
{
    float elevation = getTimeDrivenSunElevation();
    if(elevation < 0.0)
    {
        return vec3(0.46, 0.56, 1.00);
    }

    float highSun = smoothstep(0.08, 0.68, elevation);
    vec3 base = mix(
        vec3(1.00, 0.56, 0.24),
        vec3(1.00, 0.97, 0.90),
        highSun
    );
    float sunset = 1.0 - smoothstep(0.04, 0.22, elevation);
    vec3 twilightTint = mix(TWILIGHT_DAWN_TINT, TWILIGHT_DUSK_TINT,
        twilightEveningWeight());
    return mix(base, twilightTint, sunset * 0.72);
}

// -------------------------------------------------------------------------
// Atmosphere A1: clear-sky aerial perspective
// -------------------------------------------------------------------------
// This has no descriptor, payload, or secondary-trace dependency.  It is
// deliberately evaluated only for the camera segment after its primary
// radiance is complete; reflections and GI misses already receive the same
// physical sky from rmiss.  Keeping it outside the diffuse loop preserves
// the established SER payload/reorder lifetime exactly.
const vec3 ATM_RAYLEIGH_BETA = vec3(5.5e-6, 13.0e-6, 22.4e-6);
const vec3 ATM_MIE_BETA = vec3(18.0e-6);
const float ATM_RAYLEIGH_HEIGHT = 8000.0;
const float ATM_MIE_HEIGHT = 1200.0;
const float ATM_MIE_G = 0.76;
// Keep the existing clear-sky/aerial-perspective brightness unchanged after
// restoring the direct-sun scale above.  5.22209428235 = 8.5 * 0.75 /
// 1.22077458876, so only direct/occluded contrast changes; the weather/sky
// response itself does not get brighter.
const float ATM_SKY_EXPOSURE = 5.22209428235;

float atmosphereAirMass(float elevation)
{
    float h = clamp(elevation, -0.065, 1.0);
    return min(24.0, 1.0 / max(0.045, h + 0.135));
}

float atmosphereRayleighPhase(float cosTheta)
{
    return 0.05968310366 * (1.0 + cosTheta * cosTheta);
}

float atmosphereMiePhase(float cosTheta)
{
    float g2 = ATM_MIE_G * ATM_MIE_G;
    float denominator = max(1.0e-4, 1.0 + g2 - 2.0 * ATM_MIE_G * cosTheta);
    float invDenominator = inversesqrt(denominator);
    return (3.0 * (1.0 - g2) * (1.0 + cosTheta * cosTheta)) /
        (8.0 * 3.14159265359 * (2.0 + g2)) *
        invDenominator * invDenominator * invDenominator;
}

vec3 samplePhysicalClearSkyForAerialPerspective(vec3 rayDir)
{
    rayDir = normalize(rayDir);
    float sunElevation = getTimeDrivenSunElevation();
    vec3 lightDirection = getTimeDrivenSkyLightDirection();
    float cosTheta = clamp(dot(rayDir, lightDirection), -1.0, 1.0);

    float viewMass = atmosphereAirMass(rayDir.y);
    float lightMass = atmosphereAirMass(abs(sunElevation));
    vec3 sunTransmittance = exp2(-1.44269504089 * (
        ATM_RAYLEIGH_BETA * ATM_RAYLEIGH_HEIGHT +
        ATM_MIE_BETA * ATM_MIE_HEIGHT
    ) * lightMass);
    vec3 rayleighScatter = vec3(1.0) - exp2(-1.44269504089 * ATM_RAYLEIGH_BETA * ATM_RAYLEIGH_HEIGHT * viewMass);
    vec3 mieScatter = vec3(1.0) - exp2(-1.44269504089 * ATM_MIE_BETA * ATM_MIE_HEIGHT * viewMass);

    // Keep direct sunlight at its own weather factor.  Sky scattering uses
    // the softer 20%-at-full-rain reference response instead.
    vec3 sourceRadiance = getTimeDrivenSkyLightColor() *
        (3.2 * getClearTimeDrivenSkyLightRadianceScale()) *
        sunTransmittance * getWeatherSkyRadianceFactor() * getWeatherSkyTint();
    vec3 scatter = sourceRadiance * ATM_SKY_EXPOSURE * (
        rayleighScatter * atmosphereRayleighPhase(cosTheta) +
        mieScatter * atmosphereMiePhase(cosTheta)
    );

    float nightAmount = 1.0 - smoothstep(-0.03, 0.12, sunElevation);
    float horizon = 1.0 - clamp(rayDir.y, 0.0, 1.0);
    horizon *= horizon * (3.0 - 2.0 * horizon);
    vec3 nightAmbient = mix(vec3(0.0010, 0.0018, 0.0050), vec3(0.004, 0.008, 0.020), horizon);
    return max(scatter + nightAmbient * nightAmount, vec3(0.0));
}

vec3 applyClearSkyAerialPerspective(
    vec3 surfaceRadiance,
    vec3 cameraOrigin,
    vec3 cameraDirection,
    float cameraDistance
)
{
    // A height-aware analytic segment.  It gives distant terrain its blue
    // atmospheric lift without a marching loop or a new temporal buffer.
    float distance = clamp(cameraDistance, 0.0, 10000.0);
    float midpointY = cameraOrigin.y + cameraDirection.y * (0.5 * distance);
    float heightDensity = exp(-0.025 * clamp(midpointY - 63.0, -32.0, 256.0));
    heightDensity = clamp(heightDensity, 0.10, 2.23);

    float rainStrength = getOverworldRainStrength();
    float weatherFogDensity = 1.0 + WEATHER_RF_DENSITY *
        3.0 * rainStrength * rainStrength;
    vec3 extinction = vec3(0.000030, 0.000052, 0.000090) *
        heightDensity * weatherFogDensity;
    vec3 transmittance = exp(-extinction * distance);
    vec3 inscatter = samplePhysicalClearSkyForAerialPerspective(cameraDirection);
    vec3 clearWeatherResult = surfaceRadiance * transmittance +
        inscatter * (vec3(1.0) - transmittance);

    // Individual streak cards cannot resolve into the distance: they become
    // sub-pixel long before the terrain horizon.  Follow the reference pack's
    // rainy Mie extinction with a cheap analytic distance fog, evaluated once
    // after the primary hit (no volume march and no additional ray queries).
    float rainOpticalDepth = distance * rainStrength * WEATHER_RF_DENSITY *
        heightDensity * 0.00022;
    float rainFogAmount = 1.0 - exp(-rainOpticalDepth);
    vec3 rainFogColor = mix(
        vec3(0.34, 0.40, 0.46),
        inscatter,
        0.25
    );

    // ---------------------------------------------------------------
    // Distance fog ("边界雾").  Gives far terrain layered depth that the weak
    // clear-sky extinction above cannot: an analytic distance + height falloff,
    // one exp per primary hit, no extra march or ray query.  The three knobs
    // ride the previously-unused cloudParams4.yzw lanes:
    //   cloudParams4.y = gain          (0 disables; ~1.0 is a visible veil)
    //   cloudParams4.z = distance      (blocks to 50% fog)
    //   cloudParams4.w = height falloff(blocks; 0 = flat, larger = tighter)
    // The tint is the physical sky in that direction, so the veil matches the
    // horizon instead of fighting it, and it slides smoothly into the rain
    // fog already computed above.
    // ---------------------------------------------------------------
    float distFogGain = cam.cloudParams4.y;
    if(distFogGain > 0.0)
    {
        float distFogScale = max(cam.cloudParams4.z, 1.0);
        float distFogFalloff = max(cam.cloudParams4.w, 0.0);
        // Denser below the fog's reference height, thinnter above it, so the
        // veil hugs the low ground and mountains poke through.
        float distFogHeightDensity =
            exp(-max(cameraDirection.y, 0.0) * distFogFalloff);
        float distFogOpticalDepth =
            (distance / distFogScale) * distFogGain * distFogHeightDensity;
        float distFogAmount = 1.0 - exp(-distFogOpticalDepth);
        // The distance veil keeps the sky's hue and most of its luminance so
        // it reads as atmosphere, not as a grey wall.
        vec3 distFogColor = inscatter * 1.05;
        rainFogColor = mix(rainFogColor, distFogColor, distFogAmount);
        rainFogAmount = max(rainFogAmount, distFogAmount);
    }

    return mix(clearWeatherResult, rainFogColor, rainFogAmount);
}


VPTDirectHistory vptReadPrimaryHistory(uint index)
{
    return cam.historyReadIndex == 0u
        ? vptDirectHistoryBuffer0.entries[index]
        : vptDirectHistoryBuffer1.entries[index];
}


void vptWritePrimaryHistory(uint index, VPTDirectHistory value)
{
    if(cam.historyReadIndex == 0u)
    {
        vptDirectHistoryBuffer1.entries[index] = value;
    }
    else
    {
        vptDirectHistoryBuffer0.entries[index] = value;
    }
}


bool vptReprojectPreviousPixel(
    vec3 worldPosition,
    ivec2 renderSize,
    out uint previousIndex
)
{
    previousIndex = 0u;
    if(cam.historyValid == 0u)
    {
        return false;
    }

    mat4 previousWorldToView = inverse(cam.prevViewInverse);
    mat4 previousViewToClip = inverse(cam.prevProjInverse);
    vec4 previousClip = previousViewToClip *
        previousWorldToView * vec4(worldPosition, 1.0);
    if(previousClip.w <= 1.0e-5)
    {
        return false;
    }

    vec2 ndc = previousClip.xy / previousClip.w;
    vec2 uv = vec2(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5);
    if(any(lessThan(uv, vec2(0.0))) || any(greaterThanEqual(uv, vec2(1.0))))
    {
        return false;
    }

    ivec2 previousPixel = ivec2(floor(uv * vec2(renderSize)));
    previousPixel = clamp(previousPixel, ivec2(0), renderSize - ivec2(1));
    previousIndex = uint(previousPixel.y * renderSize.x + previousPixel.x);
    return true;
}


bool vptPrimaryHistoryMatches(
    VPTDirectHistory history,
    vec3 hitPosition,
    vec3 hitNormal
)
{
    return history.hitPositionAndValid.w > 0.5 &&
        history.radianceAndSampleCount.w > 0.0 &&
        length(history.hitPositionAndValid.xyz - hitPosition) <= VPT_SCREEN_POSITION_EPSILON &&
        dot(normalize(history.normalAndPadding.xyz), hitNormal) >= VPT_SCREEN_NORMAL_COSINE;
}


vec3 evaluateVPTPrimaryTemporal(
    vec3 hitPosition,
    vec3 hitNormal,
    vec3 hitAlbedo,
    vec3 direction,
    inout uint rngState,
    ivec2 pixelCoord,
    ivec2 renderSize
)
{
    uint currentIndex = uint(pixelCoord.y * renderSize.x + pixelCoord.x);
    uint previousIndex = 0u;
    VPTDirectHistory previousHistory;
    bool reuseHistory = vptReprojectPreviousPixel(
        hitPosition,
        renderSize,
        previousIndex
    );
    if(reuseHistory)
    {
        previousHistory = vptReadPrimaryHistory(previousIndex);
        reuseHistory = vptPrimaryHistoryMatches(
            previousHistory,
            hitPosition,
            hitNormal
        );
    }

    uint phase = uint(pixelCoord.x & 1) | (uint(pixelCoord.y & 1) << 1u);
    bool traceCandidate = !reuseHistory || phase == (cam.frameCount & 3u);

    vec3 filteredRadiance = reuseHistory
        ? previousHistory.radianceAndSampleCount.rgb
        : vec3(0.0);
    float sampleCount = reuseHistory
        ? previousHistory.radianceAndSampleCount.w
        : 0.0;

    if(traceCandidate)
    {
        vec3 candidateRadiance = evaluateVPTPrimaryIndirect(
            hitPosition,
            hitNormal,
            hitAlbedo,
            direction,
            rngState
        );
        float nextCount = min(sampleCount + 1.0, VPT_SCREEN_MAX_HISTORY);
        float alpha = reuseHistory ? (1.0 / nextCount) : 1.0;
        filteredRadiance = mix(filteredRadiance, candidateRadiance, alpha);
        sampleCount = nextCount;
    }

    VPTDirectHistory outputHistory;
    outputHistory.radianceAndSampleCount = vec4(filteredRadiance, sampleCount);
    outputHistory.hitPositionAndValid = vec4(hitPosition, 1.0);
    outputHistory.normalAndPadding = vec4(hitNormal, 0.0);
    vptWritePrimaryHistory(currentIndex, outputHistory);
    return filteredRadiance;
}

// VPT-3.3C.4: reuse the existing world-space reprojection contract for the
// direct area-light integral.  Every valid pixel traces all 48 current-frame
// DDA paths; history only combines distinct deterministic sample groups.
vec3 evaluateVPTCandidateDirectTemporal(
    vec3 hitPosition,
    vec3 hitNormal,
    vec3 hitAlbedo,
    ivec2 pixelCoord,
    ivec2 renderSize
)
{
    uint currentIndex = uint(pixelCoord.y * renderSize.x + pixelCoord.x);
    uint previousIndex = 0u;
    bool reuseHistory = vptReprojectPreviousPixel(
        hitPosition, renderSize, previousIndex
    );
    VPTDirectHistory previousHistory;
    if(reuseHistory)
    {
        previousHistory = vptReadPrimaryHistory(previousIndex);
        reuseHistory = vptPrimaryHistoryMatches(
            previousHistory, hitPosition, hitNormal
        );
    }

    uint temporalSeed = uint(pixelCoord.x) * 1973u ^
        uint(pixelCoord.y) * 9277u ^ cam.frameCount * 26699u;
    vec3 currentRadiance = evaluateVPTRISDirectLighting(
        hitPosition, hitNormal, hitAlbedo, temporalSeed
    );
    float oldCount = reuseHistory
        ? previousHistory.radianceAndSampleCount.w : 0.0;
    float nextCount = min(oldCount + 1.0, VPT_SCREEN_MAX_HISTORY);
    float alpha = 1.0 / nextCount;
    vec3 filteredRadiance = reuseHistory
        ? mix(previousHistory.radianceAndSampleCount.rgb, currentRadiance, alpha)
        : currentRadiance;

    VPTDirectHistory outputHistory;
    outputHistory.radianceAndSampleCount = vec4(filteredRadiance, nextCount);
    outputHistory.hitPositionAndValid = vec4(hitPosition, 1.0);
    outputHistory.normalAndPadding = vec4(normalize(hitNormal), 0.0);
    vptWritePrimaryHistory(currentIndex, outputHistory);
    return filteredRadiance;
}


// =====================================================
// ReSTIR DI temporal stabilization
//
// ReSTIR still owns candidate selection and keeps the one-shadow-ray budget.
// This stage only filters the already-evaluated direct-light estimate using
// the existing Binding 26/27 ping-pong history.  It adds no RT visibility ray.
//
// History layout reuse:
//   radianceAndSampleCount.xyz = filtered local direct lighting
//   radianceAndSampleCount.w   = temporal sample count
//   hitPositionAndValid.xyz    = receiver world position
//   hitPositionAndValid.w      = receiver view depth
//   normalAndPadding.xyz       = receiver normal
//   normalAndPadding.w         = encoded material+lighting revision signature
//
// The signature is a compact proxy because the opaque RT payload does not
// preserve a stable block material ID.  It hashes quantized PBR properties
// together with the receiver's local-light directory revision, so material
// changes and emitter-set changes reject stale history without a C++ layout
// change.
// =====================================================

const float RESTIR_DI_TEMPORAL_HISTORY_MAX = 6.0;
const float RESTIR_DI_TEMPORAL_ALPHA_FLOOR = 0.18;
const float RESTIR_DI_TEMPORAL_FILTER_NORMAL_COSINE = 0.965;
const float RESTIR_DI_TEMPORAL_NEIGHBOR_SIGMA = 1.35;

float restirDITemporalLuminance(vec3 value)
{
    return dot(max(value, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722));
}

uint restirDITemporalReceiverSignature(
    vec3 hitPos,
    vec3 albedo,
    float roughness,
    float metallic
)
{
    uvec3 qa = uvec3(
        clamp(floor(clamp(albedo, vec3(0.0), vec3(1.0)) * 31.0 + 0.5),
              vec3(0.0), vec3(31.0))
    );
    uint qr = uint(clamp(floor(clamp(roughness, 0.0, 1.0) * 15.0 + 0.5), 0.0, 15.0));
    uint qm = uint(clamp(floor(clamp(metallic, 0.0, 1.0) * 7.0 + 0.5), 0.0, 7.0));

    uint packedMaterial =
        (qa.x) |
        (qa.y << 5u) |
        (qa.z << 10u) |
        (qr << 15u) |
        (qm << 19u);

    uint receiverRevision = 0u;
    ivec3 receiverSection = ivec3(floor(hitPos / 16.0));
    uint receiverPage;
    if(vliLookupSectionPage(receiverSection, receiverPage))
    {
        receiverRevision = vptSourceDirectoryPagesBuffer.entries[
            receiverPage * VPT_SOURCE_DIRECTORY_ENTRIES_PER_PAGE
        ].aliasThresholdQ16;
    }

    uint signature = packedMaterial ^
        (receiverRevision * 0x9e3779b9u) ^
        uint(receiverSection.x * 73856093) ^
        uint(receiverSection.y * 19349663) ^
        uint(receiverSection.z * 83492791);
    pcg_hash(signature);
    return signature & 0x003fffffu;
}

float restirDIEncodeTemporalSignature(uint signature)
{
    // Encode inside a finite 1.x float; compare by bit pattern on read.
    return uintBitsToFloat(0x3f800000u | (signature & 0x003fffffu));
}

bool restirDITemporalHistoryMatches(
    VPTDirectHistory history,
    vec3 hitPos,
    vec3 hitNormal,
    float viewDepth,
    uint receiverSignature,
    float positionScale
)
{
    if(history.radianceAndSampleCount.w <= 0.0)
    {
        return false;
    }

    uint storedSignature =
        floatBitsToUint(history.normalAndPadding.w) & 0x003fffffu;
    if(storedSignature != receiverSignature)
    {
        return false;
    }

    vec3 storedNormal = history.normalAndPadding.xyz;
    if(dot(storedNormal, storedNormal) < 0.5 ||
        dot(normalize(storedNormal), normalize(hitNormal)) <
            RESTIR_DI_TEMPORAL_FILTER_NORMAL_COSINE)
    {
        return false;
    }

    float depthTolerance = max(0.20, viewDepth * 0.015);
    if(abs(history.hitPositionAndValid.w - viewDepth) > depthTolerance)
    {
        return false;
    }

    float positionTolerance =
        max(0.30, min(1.50, viewDepth * 0.0125)) * positionScale;
    return length(history.hitPositionAndValid.xyz - hitPos) <=
        positionTolerance;
}

vec3 restirDIClampTemporalLuminance(
    vec3 radiance,
    float minLuma,
    float maxLuma
)
{
    vec3 nonNegative = max(radiance, vec3(0.0));
    float luma = restirDITemporalLuminance(nonNegative);
    if(luma <= 1.0e-6)
    {
        return nonNegative;
    }

    float clampedLuma = clamp(luma, minLuma, maxLuma);
    return nonNegative * (clampedLuma / luma);
}

bool restirDIAccumulateTemporalNeighbor(
    ivec2 samplePixel,
    ivec2 renderSize,
    vec3 hitPos,
    vec3 hitNormal,
    float viewDepth,
    uint receiverSignature,
    inout float luminanceSum,
    inout float luminanceSquaredSum,
    inout uint validCount
)
{
    if(any(lessThan(samplePixel, ivec2(0))) ||
        any(greaterThanEqual(samplePixel, renderSize)))
    {
        return false;
    }

    uint sampleIndex = uint(samplePixel.y * renderSize.x + samplePixel.x);
    VPTDirectHistory sampleHistory = vptReadPrimaryHistory(sampleIndex);
    if(!restirDITemporalHistoryMatches(
        sampleHistory,
        hitPos,
        hitNormal,
        viewDepth,
        receiverSignature,
        2.5
    ))
    {
        return false;
    }

    float sampleLuma =
        restirDITemporalLuminance(sampleHistory.radianceAndSampleCount.rgb);
    luminanceSum += sampleLuma;
    luminanceSquaredSum += sampleLuma * sampleLuma;
    validCount += 1u;
    return true;
}

vec3 evaluateReSTIRDITemporalStabilization(
    vec3 currentRadiance,
    vec3 hitPos,
    vec3 hitNormal,
    vec3 hitAlbedo,
    float roughness,
    float metallic,
    ivec2 pixelCoord,
    ivec2 renderSize
)
{
    uint currentIndex = uint(pixelCoord.y * renderSize.x + pixelCoord.x);
    vec3 filteredRadiance = max(currentRadiance, vec3(0.0));
    float viewDepth = restirDIReceiverViewDepth(hitPos);
    uint receiverSignature = restirDITemporalReceiverSignature(
        hitPos, hitAlbedo, roughness, metallic
    );

    uint previousIndex = 0u;
    bool reuseHistory = vptReprojectPreviousPixel(
        hitPos, renderSize, previousIndex
    );
    VPTDirectHistory previousHistory;

    if(reuseHistory)
    {
        previousHistory = vptReadPrimaryHistory(previousIndex);
        reuseHistory = restirDITemporalHistoryMatches(
            previousHistory,
            hitPos,
            hitNormal,
            viewDepth,
            receiverSignature,
            1.0
        );
    }

    float nextCount = 1.0;

    if(reuseHistory)
    {
        vec3 previousRadiance =
            max(previousHistory.radianceAndSampleCount.rgb, vec3(0.0));

        // Low-cost neighborhood clamp: read only two extra history pixels.
        // Alternate horizontal/vertical taps every frame, covering the full
        // cross over two frames without four additional reads every frame.
        ivec2 previousPixel = ivec2(
            int(previousIndex % uint(renderSize.x)),
            int(previousIndex / uint(renderSize.x))
        );
        ivec2 axis = (cam.frameCount & 1u) == 0u
            ? ivec2(1, 0)
            : ivec2(0, 1);

        float centerLuma = restirDITemporalLuminance(previousRadiance);
        float luminanceSum = centerLuma;
        float luminanceSquaredSum = centerLuma * centerLuma;
        uint validCount = 1u;

        restirDIAccumulateTemporalNeighbor(
            previousPixel - axis,
            renderSize,
            hitPos,
            hitNormal,
            viewDepth,
            receiverSignature,
            luminanceSum,
            luminanceSquaredSum,
            validCount
        );
        restirDIAccumulateTemporalNeighbor(
            previousPixel + axis,
            renderSize,
            hitPos,
            hitNormal,
            viewDepth,
            receiverSignature,
            luminanceSum,
            luminanceSquaredSum,
            validCount
        );

        if(validCount >= 2u)
        {
            float invCount = 1.0 / float(validCount);
            float meanLuma = luminanceSum * invCount;
            float variance = max(
                luminanceSquaredSum * invCount - meanLuma * meanLuma,
                0.0
            );
            float sigma = sqrt(variance);
            float padding = max(0.025, meanLuma * 0.12);
            float minLuma = max(
                0.0,
                meanLuma - RESTIR_DI_TEMPORAL_NEIGHBOR_SIGMA * sigma - padding
            );
            float maxLuma =
                meanLuma + RESTIR_DI_TEMPORAL_NEIGHBOR_SIGMA * sigma + padding;

            // Clamp history tightly to its validated spatial neighborhood.
            previousRadiance = restirDIClampTemporalLuminance(
                previousRadiance, minLuma, maxLuma
            );

            // Do not damage reservoir statistics.  Suppress current-frame
            // fireflies only at radiance input, with a looser upper bound so
            // genuinely changing lights can converge over a few frames.
            float currentUpperBound = max(
                maxLuma * 3.0,
                maxLuma + max(0.20, meanLuma * 0.75)
            );
            filteredRadiance = restirDIClampTemporalLuminance(
                filteredRadiance, 0.0, currentUpperBound
            );
        }

        float oldCount = min(
            previousHistory.radianceAndSampleCount.w,
            RESTIR_DI_TEMPORAL_HISTORY_MAX
        );
        nextCount = min(oldCount + 1.0, RESTIR_DI_TEMPORAL_HISTORY_MAX);
        float alpha = max(
            1.0 / nextCount,
            RESTIR_DI_TEMPORAL_ALPHA_FLOOR
        );
        filteredRadiance = mix(
            previousRadiance,
            filteredRadiance,
            alpha
        );
    }

    VPTDirectHistory outputHistory;
    outputHistory.radianceAndSampleCount =
        vec4(filteredRadiance, nextCount);
    outputHistory.hitPositionAndValid =
        vec4(hitPos, viewDepth);
    outputHistory.normalAndPadding =
        vec4(
            normalize(hitNormal),
            restirDIEncodeTemporalSignature(receiverSignature)
        );
    vptWritePrimaryHistory(currentIndex, outputHistory);

    return filteredRadiance;
}


// Each cache probe is only a few blocks from the receiver.  This short DDA
// prevents the scalar cache from trilinearly bleeding through a full block
// wall; it is intentionally cheaper than a hardware RT shadow ray.
bool vptCacheProbeVisible(vec3 origin, vec3 target)
{
    vec3 segment = target - origin;
    float maxDistance = length(segment);
    if(maxDistance <= 1.0e-4) return true;
    vec3 direction = segment / maxDistance;
    ivec3 cell = ivec3(floor(origin));
    ivec3 step = ivec3(sign(direction));
    vec3 invAbs = 1.0 / max(abs(direction), vec3(1.0e-6));
    vec3 boundary = vec3(cell) + vec3(max(step, ivec3(0)));
    vec3 tMax = (boundary - origin) / direction;
    if(step.x == 0) tMax.x = 1.0e30;
    if(step.y == 0) tMax.y = 1.0e30;
    if(step.z == 0) tMax.z = 1.0e30;

    for(int i = 0; i < 8; ++i)
    {
        int axis = tMax.x < tMax.y ? (tMax.x < tMax.z ? 0 : 2)
                                    : (tMax.y < tMax.z ? 1 : 2);
        float t = axis == 0 ? tMax.x : (axis == 1 ? tMax.y : tMax.z);
        if(t >= maxDistance) return true;
        if(axis == 0) { cell.x += step.x; tMax.x += invAbs.x; }
        else if(axis == 1) { cell.y += step.y; tMax.y += invAbs.y; }
        else { cell.z += step.z; tMax.z += invAbs.z; }
        uint source;
        if(!vptReadSourceVoxel(cell, source)) return false;
        if((source & 3u) == 1u) return false;
    }
    return false;
}

vec3 vptDirectionalCacheAxis(uint directionIndex)
{
    if(directionIndex == 0u) return vec3( 1.0,  0.0,  0.0);
    if(directionIndex == 1u) return vec3(-1.0,  0.0,  0.0);
    if(directionIndex == 2u) return vec3( 0.0,  1.0,  0.0);
    if(directionIndex == 3u) return vec3( 0.0, -1.0,  0.0);
    if(directionIndex == 4u) return vec3( 0.0,  0.0,  1.0);
    return vec3(0.0, 0.0, -1.0);
}


// VPT-3.3A.1: sample the direct and final secondary directional fields with
// the same short receiver-to-probe visibility test and trilinear weights.
void sampleVPTDualDirectionalIrradiance(
    vec3 worldPos,
    vec3 surfaceNormal,
    out vec3 outPrimary,
    out vec3 outSecondary
)
{
    outPrimary = vec3(0.0);
    outSecondary = vec3(0.0);

    ivec3 sectionCoord = ivec3(floor(worldPos / 16.0));
    uint pageIndex;
    if(!vliLookupSectionPage(sectionCoord, pageIndex))
    {
        return;
    }

    vec3 localProbe = clamp(
        (worldPos - vec3(sectionCoord * 16)) * 0.5,
        vec3(0.0),
        vec3(7.999)
    );
    ivec3 base = ivec3(floor(localProbe));
    vec3 fraction = fract(localProbe);
    uint primaryPageBase = pageIndex * VLI_PAGE_WORDS + VLI_SOURCE_WORDS;
    uint secondaryPageBase = pageIndex * VPT_DIRECTIONAL_CACHE_WORDS;
    vec3 N = normalize(surfaceNormal);

    vec3 primaryAccum = vec3(0.0);
    vec3 secondaryAccum = vec3(0.0);
    float acceptedWeight = 0.0;

    for(int y = 0; y <= 1; ++y)
    for(int z = 0; z <= 1; ++z)
    for(int x = 0; x <= 1; ++x)
    {
        ivec3 probe = base + ivec3(x, y, z);
        uint index = uint(probe.x) + VLI_PROBE_EDGE * (
            uint(probe.z) + VLI_PROBE_EDGE * uint(probe.y)
        );
        vec3 weight3 = mix(
            vec3(1.0) - fraction,
            fraction,
            vec3(float(x), float(y), float(z))
        );
        float weight = weight3.x * weight3.y * weight3.z;
        vec3 probeWorldPos = vec3(sectionCoord * 16 + probe * 2) + vec3(1.0);

        // 仅执行一次连通性 DDA 判定，双层共享该可见性
        if(vptCacheProbeVisible(worldPos + surfaceNormal * 0.03, probeWorldPos))
        {
            vec3 primaryDirIrr = vec3(0.0);
            vec3 secondaryDirIrr = vec3(0.0);

            for(uint directionIndex = 0u;
                directionIndex < VPT_DIRECTION_COUNT;
                ++directionIndex)
            {
                float normalWeight = max(
                    dot(N, vptDirectionalCacheAxis(directionIndex)),
                    0.0
                );
                normalWeight *= normalWeight;

                // Pass 1: 一次直接光 (Binding 23)
                uint packedPrimary = vliPagesBuffer.words[
                    primaryPageBase + directionIndex * VLI_PROBE_WORDS + index
                ];
                primaryDirIrr += vliUnpackRadiance(packedPrimary) * normalWeight;

                // Pass 2: final Surface Cache-derived secondary light.
                uint packedSecondary = vliSecondaryPagesBuffer.words[
                    secondaryPageBase + directionIndex * VLI_PROBE_WORDS + index
                ];
                secondaryDirIrr += vliUnpackRadiance(packedSecondary) * normalWeight;
            }

            primaryAccum += primaryDirIrr * weight;
            secondaryAccum += secondaryDirIrr * weight;
            acceptedWeight += weight;
        }
    }

    if(acceptedWeight > 1.0e-5)
    {
        outPrimary = primaryAccum / acceptedWeight;
        outSecondary = secondaryAccum / acceptedWeight;
    }
}

// VPT-3.3A.1: solve the primary receiver response from the two fields.
void evaluateVPTDualLighting(
    vec3 hitPos,
    vec3 hitNormal,
    vec3 hitAlbedo,
    out vec3 localDirect,
    out vec3 localSecondary
)
{
    vec3 primaryIrr = vec3(0.0);
    vec3 secondaryIrr = vec3(0.0);
    sampleVPTDualDirectionalIrradiance(hitPos, hitNormal, primaryIrr, secondaryIrr);

    localDirect = primaryIrr * hitAlbedo * 0.92;
    localSecondary = secondaryIrr * hitAlbedo * 0.92;
}


const float LOCAL_LIGHT_GRID_CELL_SIZE =
    64.0;


const float LOCAL_LIGHT_MAX_RANGE =
    30.0;


uint localLightGridHash32(
    ivec3 cellCoord
)
{
    uint h =
        uint(cellCoord.x) *
        0x8da6b343u;

    h ^=
        uint(cellCoord.y) *
        0xd8163841u;

    h ^=
        uint(cellCoord.z) *
        0xcb1ab31fu;

    h ^= h >> 16u;
    h *= 0x7feb352du;
    h ^= h >> 15u;
    h *= 0x846ca68bu;
    h ^= h >> 16u;

    return
        h;
}


ivec3 localLightGridCellCoord(
    vec3 worldPos
)
{
    return
        ivec3(
            floor(
                worldPos /
                LOCAL_LIGHT_GRID_CELL_SIZE
            )
        );
}


int localLightGridNeighborMinOffset(
    float worldComponent
)
{
    float cellBase =
        floor(
            worldComponent /
            LOCAL_LIGHT_GRID_CELL_SIZE
        ) *
        LOCAL_LIGHT_GRID_CELL_SIZE;


    return
        worldComponent -
        cellBase <
        LOCAL_LIGHT_MAX_RANGE
            ? -1
            : 0;
}


int localLightGridNeighborMaxOffset(
    float worldComponent
)
{
    float cellBase =
        floor(
            worldComponent /
            LOCAL_LIGHT_GRID_CELL_SIZE
        ) *
        LOCAL_LIGHT_GRID_CELL_SIZE;


    return
        cellBase +
        LOCAL_LIGHT_GRID_CELL_SIZE -
        worldComponent <
        LOCAL_LIGHT_MAX_RANGE
            ? 1
            : 0;
}


uint localLightGridPackedIndexBase()
{
    return
        4u +
        localLightGridBuffer.words[2] *
        8u;
}


bool localLightGridLookupCell(
    ivec3 cellCoord,
    out uint firstLightIndex,
    out uint lightCount
)
{
    uint hashCapacity =
        localLightGridBuffer.words[2];


    if(hashCapacity == 0u)
    {
        firstLightIndex =
            0u;

        lightCount =
            0u;

        return
            false;
    }


    uint hashMask =
        hashCapacity -
        1u;


    uint slotIndex =
        localLightGridHash32(
            cellCoord
        ) &
        hashMask;


    for(
        uint probe = 0u;
        probe < hashCapacity;
        ++probe
    )
    {
        uint slotBase =
            4u +
            slotIndex *
            8u;


        if(
            localLightGridBuffer.words[
                slotBase +
                3u
            ] == 0u
        )
        {
            firstLightIndex =
                0u;

            lightCount =
                0u;

            return
                false;
        }


        if(
            int(
                localLightGridBuffer.words[
                    slotBase
                ]
            ) == cellCoord.x &&
            int(
                localLightGridBuffer.words[
                    slotBase +
                    1u
                ]
            ) == cellCoord.y &&
            int(
                localLightGridBuffer.words[
                    slotBase +
                    2u
                ]
            ) == cellCoord.z
        )
        {
            firstLightIndex =
                localLightGridBuffer.words[
                    slotBase +
                    4u
                ];

            lightCount =
                localLightGridBuffer.words[
                    slotBase +
                    5u
                ];

            return
                true;
        }


        slotIndex =
            (
                slotIndex +
                1u
            ) &
            hashMask;
    }


    firstLightIndex =
        0u;

    lightCount =
        0u;

    return
        false;
}


struct HitPayload {
    float hitDistance;
    vec3 normal;
    vec3 albedo;
    uint state;
    float roughness;
    float f0Metal;
    vec3 emission;
    float parallaxRayTravel;
    float pomSelfShadow;
    float glassAlpha;
};

// First-hit surface data for group3.  This is intentionally only the visible
// glass shell; the straight behind-glass transport stays in its existing
// function until the following PBR-composition block.
struct GlassSurfaceInfo {
    vec3 position;
    vec3 normal;
    vec3 tint;
    float alpha;
};

layout(location = 0) rayPayloadEXT HitPayload payload;

#ifdef RT_ENABLE_SER
// EXT SER is restricted to the diffuse-GI secondary path. Keeping this helper
// behind a compile-time flag leaves the ordinary module capability-free.
void traceDiffuseSer(vec3 origin, vec3 direction, uint bouncePhase)
{
    hitObjectEXT hitObject;
    hitObjectTraceRayEXT(
        hitObject,
        topLevelAS,
        gl_RayFlagsNoneEXT,
        0xff,
        0,
        0,
        0,
        origin,
        0.001,
        direction,
        10000.0,
        0
    );

    uint sbtIndex = hitObjectGetShaderBindingTableRecordIndexEXT(hitObject);
    uint coherenceHint = (bouncePhase << 2u) | (sbtIndex & 0x3u);
    reorderThreadEXT(hitObject, coherenceHint, 4u);
    hitObjectExecuteShaderEXT(hitObject, 0);
}
#endif

// state is the compact transport contract shared by every RT shader.
// It replaces the overloaded floating materialId without increasing payload
// size.  Low bits are supplied by rgen; hit shaders preserve them and append
// their result classification.
const uint RT_STATE_PURPOSE_MASK       = 0x7u;
const uint RT_STATE_HIT_CLASS_SHIFT    = 3u;
const uint RT_STATE_WATER_EVENT_SHIFT  = 5u;
const uint RT_STATE_GLASS_BIT          = 1u << 7u;
const uint RT_STATE_GLASS_BOTTOM_BIT   = 1u << 8u;
const uint RT_STATE_PROFILE_SHIFT      = 9u;

const uint RT_PURPOSE_FULL             = 0u;
const uint RT_PURPOSE_CLASSIFY         = 1u;
const uint RT_PURPOSE_DISTANCE_ONLY    = 2u;
const uint RT_PURPOSE_VISIBILITY_ONLY  = 3u;
const uint RT_PURPOSE_PASSTHROUGH      = 4u;
const uint RT_PURPOSE_GLASS_VISIBILITY = 5u;
const uint RT_PURPOSE_WATER_MEDIUM     = 6u;
// Primary sky misses use the 16-step volume; secondary misses use the
// reference low-quality five-step branch without changing their ray type.
const uint RT_PURPOSE_PRIMARY_SKY      = 7u;

const uint RT_HIT_OPAQUE               = 0u;
const uint RT_HIT_WATER                = 1u;
const uint RT_HIT_TRANSLUCENT          = 2u;
const uint RT_HIT_MISS                 = 3u;
const uint RT_WATER_NONE               = 0u;
const uint RT_WATER_AIR_TO_WATER       = 1u;
const uint RT_WATER_WATER_TO_AIR       = 2u;

uint makeTraceState(uint purpose)
{
    return purpose & RT_STATE_PURPOSE_MASK;
}

uint getRayPurpose(uint state)
{
    return state & RT_STATE_PURPOSE_MASK;
}

uint getHitClass(uint state)
{
    return (state >> RT_STATE_HIT_CLASS_SHIFT) & 0x3u;
}

uint getWaterEvent(uint state)
{
    return (state >> RT_STATE_WATER_EVENT_SHIFT) & 0x3u;
}

uint getTransparentProfile(uint state)
{
    return (state >> RT_STATE_PROFILE_SHIFT) & 0x7u;
}

bool isGlassHit(uint state)
{
    return (state & RT_STATE_GLASS_BIT) != 0u;
}

bool isGlassBottomHit(uint state)
{
    return (state & RT_STATE_GLASS_BOTTOM_BIT) != 0u;
}

// Temporary decode used only while rgen's existing transport calls are moved
// one by one in subsequent blocks.  No hit shader writes a legacy ID.
float getLegacyMaterialId(uint state)
{
    uint hitClass = getHitClass(state);
    if(hitClass == RT_HIT_WATER)
    {
        return getWaterEvent(state) == RT_WATER_WATER_TO_AIR ? 2.0 : 1.0;
    }
    if(hitClass == RT_HIT_TRANSLUCENT)
    {
        return isGlassBottomHit(state) ? 4.0 : 3.0;
    }
    return 0.0;
}

// Ray purpose is carried by payload.state.  parallaxRayTravel is written only
// by closest-hit as an actual POM travel distance.


// rchit now supplies one analytical normal for all top-water triangles at a
// world position.  Keep that optical slope; flattening it here would erase
// the wave response from reflection and transmission.  Vertical waterfalls
// still arrive with their original geometric normal.
vec3 stabilizeWaterInterfaceNormal(
    vec3 normal
)
{
    return normalize(normal);
}


// One hardware visibility query for the final RIS-selected local-light
// sample.  AnyHit ignores glass, multiplies its RGB block transmission into
// payload.albedo, and accepts any opaque hit.  The VPT page walk above has
// already rejected paths that cross an unloaded Section.
vec3 vptTraceGlassTransmissionToEmitter(
    vec3 origin,
    vec3 target,
    float targetVoxelEntryDistance
)
{
    vec3 segment = target - origin;
    float distanceToTarget = length(segment);
    if(distanceToTarget <= 0.03)
    {
        return vec3(1.0);
    }

    // The selected light is represented by a voxel but sampled as a virtual
    // area emitter.  Stop just before entering that source voxel so its own
    // opaque mesh cannot shadow its emitted sample.
    float rayMaxDistance = min(
        distanceToTarget - 0.03,
        targetVoxelEntryDistance - 0.03
    );
    if(rayMaxDistance <= 0.02)
    {
        return vec3(1.0);
    }

    // =====================================================
    // VXL-2 voxel DDA transmission (this is the path that actually runs)
    //
    // This block replaced a hardware GLASS_VISIBILITY ray that could never
    // return a tint.  That ray seeded payload.hitDistance = 1.0 and then
    // tested `payload.hitDistance >= 0.0` as its "was I blocked?" sentinel,
    // expecting the Any-Hit shader to write a negative distance.  No loaded
    // rahit ever writes payload.hitDistance -- rt_test.rahit and
    // rt_test_translucent.rahit only declare the field in the struct -- so
    // the seed survived every trace, the test was unconditionally true, and
    // this function returned vec3(0.0) on every pixel.
    //
    // evaluateVPTRISDirectLightingSingle() turns that zero into an early
    // `return vec3(0.0)` (its `max(transmittance) <= 0.0` guard), so the
    // entire local-light direct term behind glass was identically zero, and
    // with it every consumer of the coloured transmission:
    // applyLocalGlassTint and its exposure guard never ran.  The only local
    // light left behind a pane was the emitter's own canned self-glow, which
    // no glass filter is applied to -- hence "the light through the coloured
    // glass is still white" and "changing the glass colour changes nothing".
    //
    // The voxel DDA is the path that is correct end to end: Java writes the
    // dye into bits 9..23 (RGB555) and raises VPT_STAINED_GLASS_BIT (bit 24)
    // on the same voxel word, and marks the pane VLI_VOXEL_TRANSLUCENT
    // (class 2), so `(source & 3u) == 1u` is false and the pane never
    // occludes -- it only multiplies the filter.  This decode is bit-for-bit
    // the rt_vpt_irradiance.comp / rt_restir_final.rgen decode.
    //
    // Only stained panes matter, so a missing page-table entry is skipped
    // like air rather than terminating the march: an unloaded Section must
    // never cut the term (the hard Section-grid seams this project already
    // removed elsewhere).  The march starts at the receiver origin (which
    // the caller already offset by N * 0.035) and stops at rayMaxDistance,
    // matching the ray interval it replaces.
    // =====================================================
    vec3 direction = segment / distanceToTarget;
    ivec3 cell = ivec3(floor(origin));
    ivec3 step = ivec3(sign(direction));
    vec3 invAbs = 1.0 / max(abs(direction), vec3(1.0e-6));
    vec3 boundary = vec3(cell) + vec3(max(step, ivec3(0)));
    vec3 tMax = (boundary - origin) / direction;
    if(step.x == 0) tMax.x = 1.0e30;
    if(step.y == 0) tMax.y = 1.0e30;
    if(step.z == 0) tMax.z = 1.0e30;

    int maxTraversal = min(
        96,
        int(ceil(distanceToTarget * dot(abs(direction), vec3(1.0)))) + 2
    );
    vec3 glassTransmission = vec3(1.0);

    // 判决实验 I 计数器（见函数尾部探针说明）
    int dbgGlassPanelsCrossed = 0;
    int dbgVoxelsVisited = 0;

    for(int traversal = 0; traversal < maxTraversal; ++traversal)
    {
        int axis = tMax.x < tMax.y
            ? (tMax.x < tMax.z ? 0 : 2)
            : (tMax.y < tMax.z ? 1 : 2);
        float travel = axis == 0 ? tMax.x : (axis == 1 ? tMax.y : tMax.z);
        if(travel >= rayMaxDistance)
        {
            break;
        }

        if(axis == 0)
        {
            cell.x += step.x;
            tMax.x += invAbs.x;
        }
        else if(axis == 1)
        {
            cell.y += step.y;
            tMax.y += invAbs.y;
        }
        else
        {
            cell.z += step.z;
            tMax.z += invAbs.z;
        }

        uint source;
        if(!vptReadSourceVoxel(cell, source))
        {
            continue;
        }

        if((source & VPT_STAINED_GLASS_BIT) != 0u)
        {
            glassTransmission *=
                max(vptDecodeVoxelAlbedo(source), vec3(1.0 / 31.0));
            ++dbgGlassPanelsCrossed;
        }
        ++dbgVoxelsVisited;
    }

    // =====================================================
    // 判决实验 I：DDA 覆盖率探针（DBG_VPT_DDA_PROBE=true 时生效）
    //
    // 目的：唯一还没被证实的一环 —— 从「玻璃后的接收面」射向光源的
    // DDA，到底有没有真的穿过玻璃体素。
    //
    // 「近处白、远处有色」有两种互斥解释：
    //   (a) DDA 没穿到玻璃（paneTransit 停在初值 1.0 纯白）⇒ 近处无染色
    //   (b) DDA 穿到了，但近处能量过高被末端逐通道硬裁 ⇒ 比例坍缩
    //
    // 本探针把**穿过几片染色玻璃**直接编码成亮度，一次重载即可区分：
    //   光斑处通道亮 ⇒ 穿到了玻璃（(a) 不成立，问题在能量）
    //   光斑处通道全黑 ⇒ 一片都没穿到（(a) 成立：射程/方向有问题）
    //
    // 编码：R = clamp(panelsCrossed / 2)   —— 1 片=0.5，2片及以上=1.0
    //       G = clamp(voxelsVisited / 64)  —— DDA 实际步数（看射程够不够）
    //       B = 0
    // 只读比值、恒 <= 1，不会被末端 pow 裁剪改变（0.5 和 1.0 都能区分）。
    // =====================================================
    if(DBG_VPT_DDA_PROBE)
    {
        // 注意：上游 evaluateVPTRISDirectLightingSingle 用
        // `if(max(transmittance) <= 0.0) return vec3(0.0);` 早退，
        // 所以探针三个通道都不能全为 0，否则「没穿到玻璃」和
        // 「该像素本来就没有本地光」会无法区分。G 恒加 0.15 兜底。
        return vec3(
            clamp(float(dbgGlassPanelsCrossed) * 0.5, 0.0, 0.85),
            clamp(float(dbgVoxelsVisited) / 64.0, 0.0, 0.7) + 0.15,
            0.0
        );
    }

    return clamp(
        vptSaturateGlassTransmission(glassTransmission),
        vec3(0.0),
        vec3(1.0)
    );
}

// R16: glass receivers cannot use Binding 30's cached face-centre irradiance:
// it is intentionally one value per Minecraft block face, which creates the
// visible un-smoothed block shadow pattern.  Select one of Binding 29's eight
// already-ranked nearby emitters at the true hardware hit instead.  The score,
// light point and visibility ray are all deterministic: no RIS proposal, no
// frame seed and exactly one hardware visibility trace for this glass pixel.
//
// The hardware query is the existing GLASS_VISIBILITY path, so Any-Hit keeps
// accumulating RGB glass transmission for any intervening stained panes.
// The primary camera pane is filtered separately by blockTransmission below.
//
// Disabled (no call sites): kept as a future interface option.
#if 0
vec3 evaluateGlassReceiverDeterministicLocalLighting(
    vec3 hitPos,
    vec3 hitNormal,
    vec3 hitAlbedo
)
{
    ivec3 receiverSection = ivec3(floor(hitPos / 16.0));
    uint receiverPage;
    if(!vliLookupSectionPage(receiverSection, receiverPage))
    {
        return vec3(0.0);
    }

    vec3 N = normalize(hitNormal);
    float bestScore = 0.0;
    vec3 bestEmitterCenter = vec3(0.0);
    ivec3 bestEmitterBlock = ivec3(0);
    float bestDistance = 0.0;
    float bestEmission = 0.0;
    uint bestTypeCode = 0u;

    uint candidateBase =
        receiverPage * VPT_RELATED_EMITTERS_PER_SECTION;

    for(uint candidateIndex = 0u;
        candidateIndex < VPT_RELATED_EMITTERS_PER_SECTION;
        ++candidateIndex)
    {
        uvec4 candidate = vptCandidatePagesBuffer.entries[
            candidateBase + candidateIndex
        ];
        uint emission = candidate.w & 15u;
        if(emission == 0u)
        {
            continue;
        }

        ivec3 emitterBlock = ivec3(candidate.xyz);
        vec3 emitterCenter = vec3(emitterBlock) + vec3(0.5);
        vec3 toLight = emitterCenter - hitPos;
        float distanceSquared = dot(toLight, toLight);
        if(distanceSquared <= 1.0e-6)
        {
            continue;
        }

        float distanceToLight = sqrt(distanceSquared);
        float emissionLevel = float(emission);
        if(distanceToLight > vptLocalLightRange(emissionLevel))
        {
            continue;
        }

        float NdotL = max(dot(N, toLight / distanceToLight), 0.0);
        if(NdotL <= 0.0)
        {
            continue;
        }

        float score =
            emissionLevel *
            vptLocalLightDistanceAttenuation(distanceToLight) *
            vptLocalLightRangeFade(distanceToLight, emissionLevel) *
            NdotL;

        // Stable tie break: Binding 29 itself has a stable CPU ordering.
        if(score > bestScore)
        {
            bestScore = score;
            bestEmitterCenter = emitterCenter;
            bestEmitterBlock = emitterBlock;
            bestDistance = distanceToLight;
            bestEmission = emissionLevel;
            bestTypeCode = (candidate.w >> 4u) & 7u;
        }
    }

    if(bestScore <= 0.0)
    {
        return vec3(0.0);
    }

    vec3 receiverOrigin = hitPos + N * 0.035;
    float targetVoxelEntryDistance;
    if(!vptLoadedPathToCandidateEmitter(
        receiverOrigin,
        bestEmitterCenter,
        bestEmitterBlock,
        targetVoxelEntryDistance
    ))
    {
        return vec3(0.0);
    }

    vec3 glassVisibility = vptTraceGlassTransmissionToEmitter(
        receiverOrigin,
        bestEmitterCenter,
        targetVoxelEntryDistance
    );
    if(max(glassVisibility.r, max(glassVisibility.g, glassVisibility.b)) <= 0.0)
    {
        return vec3(0.0);
    }

    vec3 lightDirection = normalize(bestEmitterCenter - hitPos);
    float NdotL = max(dot(N, lightDirection), 0.0);
    float radianceScale =
        3.2 *
        LOCAL_LIGHT_ENERGY_SCALE *
        (bestEmission / 15.0) *
        vptLocalLightDistanceAttenuation(bestDistance) *
        vptLocalLightRangeFade(bestDistance, bestEmission);

    return
        vliDecodeEmitterColor(bestTypeCode) *
        radianceScale *
        NdotL *
        glassVisibility *
        max(hitAlbedo, vec3(0.0)) *
        0.92;
}
#endif

uint seed;

uint pcg_hash(inout uint state) {
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    state = (state * 747796405u) + 2891336453u;
    return (word >> 22u) ^ word;
}

float rand(inout uint state) {
    return float(pcg_hash(state)) / 4294967296.0;
}
// =====================================================
// DLSS frame-level Halton(2,3) jitter
// 32 phases for current 2.0x Performance scaling.
//
// sequenceIndex starts at 1.
// Returned value is pixel-space offset in [-0.5, 0.5).
// =====================================================

float haltonValue(
    uint index,
    uint base
) {
    float f = 1.0;
    float result = 0.0;

    uint i = index;

    while (i > 0u) {
        f /= float(base);

        result +=
            f * float(i % base);

        i /= base;
    }

    return result;
}


vec2 getDLSSFrameJitter(
    uint frameIndex
) {
    const uint PHASE_COUNT = 32u;

    uint sequenceIndex =
        (frameIndex % PHASE_COUNT) + 1u;

    return vec2(
        haltonValue(sequenceIndex, 2u),
        haltonValue(sequenceIndex, 3u)
    ) - vec2(0.5);
}

vec3 sampleHemisphereCosine(vec3 normal, inout uint state) {
    float r1 = rand(state);
    float r2 = rand(state);
    float phi = 2.0 * 3.14159265 * r1;
    float r = sqrt(r2);
    float x = r * cos(phi);
    float y = r * sin(phi);
    float z = sqrt(max(0.0, 1.0 - x * x - y * y));

    vec3 up = abs(normal.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, normal));
    vec3 bitangent = cross(normal, tangent);

    return tangent * x + bitangent * y + normal * z;
}

vec3 sampleGGX(vec3 normal, float roughness, inout uint state) {
    float alpha = max(roughness * roughness, 0.001); 
    float alpha2 = alpha * alpha;
    float r1 = rand(state);
    float r2 = rand(state);
    float phi = 2.0 * 3.14159265 * r1;
    float cosTheta = sqrt((1.0 - r2) / (1.0 + (alpha2 - 1.0) * r2));
    float sinTheta = sqrt(1.0 - cosTheta * cosTheta);

    vec3 H = vec3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta);
    vec3 up = abs(normal.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, normal));
    vec3 bitangent = cross(normal, tangent);

    return tangent * H.x + bitangent * H.y + normal * H.z;
}

// 软化太阳方向采样（用于柔和阴影）
vec3 sampleSunDirection(vec3 sunDir, inout uint state) {
    float r1 = rand(state);
    float r2 = rand(state);
    float angle = 6.2831853 * r1;
    // Solar angular radius is about 0.27 degrees. The former 0.86-degree
    // disk averaged narrow architectural shadows into an overcast look.
    float radius = sqrt(r2) * 0.0047;

    vec3 up = abs(sunDir.y) < 0.999 ? vec3(0,1,0) : vec3(1,0,0);
    vec3 tangent = normalize(cross(up, sunDir));
    vec3 bitangent = cross(sunDir, tangent);

    return normalize(sunDir + tangent * cos(angle) * radius + bitangent * sin(angle) * radius);
}

// Orion glass filter: base RGB is transmission_color directly.  The
// profile argument is retained only to avoid changing the existing call
// ABI; exact glass markers always pass zero.

int getTransparentProfileFromPayloadMaterialId(float materialId)
{
    return int(
        round(
            clamp(
                fract(materialId) * 10.0,
                0.0,
                4.0
            )
        )
    );
}

// =====================================================
// Orion transmission_weight / subsurface_weight port.
//
// SectionCompilerMixin's resolveTranslucentMarker labels the TRANSLUCENT mesh
// and VulkanCore maps marker N to materialId 2.0 + 0.1 * (N - 18), so the
// profile arrives here as 1..4:
//
//   0  clear / stained glass and the generic translucent body
//   1  tinted glass       (vanilla blocks light almost completely)
//   2  ice family         (hazy, still clearly see-through)
//   3  slime block
//   4  honey block
//
// Orion keeps transmission_weight ORTHOGONAL to transmission_color:
//   transmission_color = base_color RGB            (pure tint, never scaled)
//   thinTransmissionWeight = transmission_weight   (strength, 0..1)
// The weight is multiplied OUTSIDE the thin-sheet geometric series, never
// folded into the tint.  The previous code multiplied the profile scale into
// the chromatic filter itself, which darkened the dye of ice / honey / tinted
// glass instead of only reducing their transmitted energy.
// =====================================================

// Orion transmission_weight: how much light the body transmits.  This is a
// strength, not a colour, so it must never touch the tint RGB.
float getTransparentProfileTransmission(int transparentProfile)
{
    if(transparentProfile == 1)
    {
        return 0.06;
    }
    if(transparentProfile == 2)
    {
        return 0.55;
    }
    if(transparentProfile == 3)
    {
        return 0.45;
    }
    if(transparentProfile == 4)
    {
        return 0.32;
    }
    return 1.0;
}

// Orion subsurface_weight: the share of transmitted light that leaves the
// back face as a Lambert diffuse lobe (frosted / translucent-body scattering)
// rather than a straight sheet transmission.  Ice, slime and honey are the
// bodies that should scatter; clear and stained glass stay thin-sheet.
//
// Reserved for a follow-up that adds a real back-face Lambert scattering lobe.
// The straight camera path has no BSDF sampling framework, so a correct
// subsurface lobe needs an extra hemisphere trace per translucent pixel; that
// cost is deferred until the transport rewrite lands.
#if 0
float getTransparentProfileSubsurfaceWeight(int transparentProfile)
{
    if(transparentProfile == 2)
    {
        return 0.55;   // ice: frosted, strong back-scatter
    }
    if(transparentProfile == 3)
    {
        return 0.70;   // slime: dense translucent gel
    }
    if(transparentProfile == 4)
    {
        return 0.80;   // honey: thickest, most diffuse
    }
    return 0.0;        // clear/stained/tinted glass: pure thin-sheet
}
#endif

// =====================================================
// Orion glass optical model (straight-through port).
//
// glassThinSheetFactors() is Orion's thin-sheet dielectric energy
// split, reproduced verbatim: one air-glass boundary whose internal
// reflections form a geometric series.  glassSheetTransmission() is
// Orion's surfaceShadowTransmission() for a straight shadow
// connection.  The closest-hit shader flips the glass normal toward
// the ray origin, so the boundary cosine takes abs(dot).
//
// Minecraft's base texture RGB is transmission_color directly.  Texture
// alpha neither punches coverage holes nor selects optical transmission
// strength, so it no longer participates in any glass filter.
// =====================================================

vec3 fresnelSchlick(
    float cosTheta,
    vec3 F0
);

// Disabled (no call sites): kept as a future interface option.  The
// scalar-F variants below are arithmetically identical for the uniform
// 0.04 glass F0 but cost a third of the Fresnel ALU and skip the unused
// reflection term on transmission-only paths.
#if 0
void glassThinSheetFactors(
    vec3 fresnel,
    vec3 transmittance,
    out vec3 reflection,
    out vec3 transmission
)
{
    vec3 f = clamp(fresnel, vec3(0.0), vec3(1.0));
    vec3 a = clamp(transmittance, vec3(0.0), vec3(1.0));
    vec3 oneMinusF = vec3(1.0) - f;
    vec3 denominator = max(vec3(1.0) - f * f * a * a, vec3(1.0e-6));
    reflection = f + oneMinusF * oneMinusF * f * a * a / denominator;
    transmission = oneMinusF * oneMinusF * a / denominator;
}
#endif

// The glass F0 (0.04) is uniform across RGB, so Schlick Fresnel collapses
// to one scalar.  The x^5 power is expanded into multiplies: exact
// (slightly more accurate than the GPU pow approximation) and off the
// SFU pipe.
float fresnelSchlickScalar(
    float cosTheta,
    float F0
)
{
    float x = 1.0 - clamp(cosTheta, 0.0, 1.0);
    float x2 = x * x;
    return F0 + (1.0 - F0) * (x2 * x2) * x;
}

// Scalar-F Orion thin-sheet split.  Same geometric series as the
// shielded vec3 version; only the reflection term keeps the per-channel
// algebra that a mirror-glass lobe actually needs.
void glassThinSheetFactorsScalarF(
    float fresnel,
    vec3 transmittance,
    out vec3 reflection,
    out vec3 transmission
)
{
    float f = clamp(fresnel, 0.0, 1.0);
    vec3 a = clamp(transmittance, vec3(0.0), vec3(1.0));
    float oneMinusF = 1.0 - f;
    vec3 denominator = max(
        vec3(1.0) - (f * f) * (a * a),
        vec3(1.0e-6)
    );
    reflection =
        vec3(f) + ((oneMinusF * oneMinusF) * f) * (a * a) / denominator;
    transmission =
        (oneMinusF * oneMinusF) * a / denominator;
}

vec3 glassSheetTransmissionScalarF(
    vec3 transmissionColor,
    float cosTheta
)
{
    float fresnel = fresnelSchlickScalar(cosTheta, 0.04);
    float oneMinusF = 1.0 - fresnel;
    vec3 a = clamp(transmissionColor, vec3(0.0), vec3(1.0));
    vec3 denominator = max(
        vec3(1.0) - (fresnel * fresnel) * (a * a),
        vec3(1.0e-6)
    );
    return (oneMinusF * oneMinusF) * a / denominator;
}

vec3 glassSheetTransmission(
    vec3 transmissionColor,
    vec3 faceNormal,
    vec3 directionToLight
)
{
    // Both inputs are unit length at every call site: payload.normal is
    // normalised in the closest-hit shaders and directionToLight is the
    // maintained-unit march direction.
    float cosine = clamp(
        abs(dot(faceNormal, directionToLight)),
        0.0,
        1.0
    );
    return glassSheetTransmissionScalarF(transmissionColor, cosine);
}

// Orion transmission_color: the pure chromatic filter.  It is base_color
// RGB clamped, with NO profile scaling folded in.  The transmission strength
// is applied separately as getTransparentProfileTransmission() OUTSIDE the
// thin-sheet series, matching Orion's surfaceShadowTransmission():
//   transmission = thinSheetFactors(fresnel, transmission_color) * weight.
vec3 computeGlassBlockTransmission(
    vec3 glassTint,
    float glassAlpha,
    int transparentProfile
)
{
    // transmission_color = base_color RGB, clamped.  glassAlpha and the
    // profile strength deliberately do NOT enter the tint; folding either in
    // would darken the dye instead of only attenuating transmitted energy.
    return
        clamp(glassTint, vec3(0.0), vec3(1.0));
}

// =====================================================
// LOCAL-LIGHT stained-glass tint strengthening
//
// The visibility path above is a plain multiplicative transmittance, so a
// bright local emitter washes its own colour out: the dominant channel is
// pushed past the tone curve and the illuminated pool reads as white even
// through saturated stained glass.  This boost re-saturates the transmittance
// while restoring its luminance, so a coloured pool keeps the exact brightness
// it had and only gains colour.
//
// Scope is deliberately local-light only.  Sun / sky shadow transmittance is
// accumulated by the separate RT_PURPOSE_GLASS_VISIBILITY block in main() and
// is never passed through this function.
// =====================================================
const float LOCAL_GLASS_TINT_SATURATION = 1.55;
const vec3 LOCAL_GLASS_TINT_LUMA = vec3(0.2126, 0.7152, 0.0722);

vec3 strengthenLocalGlassTint(
    vec3 transmittance
)
{
    vec3 t =
        clamp(transmittance, vec3(0.0), vec3(1.0));

    float peak =
        max(t.r, max(t.g, t.b));

    // Achromatic (clear glass) transmittance is already its own boost result.
    if(peak <= 1.0e-4)
    {
        return t;
    }

    vec3 chroma =
        clamp(
            mix(
                vec3(1.0),
                t / peak,
                LOCAL_GLASS_TINT_SATURATION
            ),
            vec3(0.0),
            vec3(1.0)
        );

    // Restore the original luminance so the boost never brightens or darkens
    // the pool, it only moves the hue.  The final clamp keeps a saturated
    // channel inside the valid transmittance range.
    float targetLuminance =
        dot(t, LOCAL_GLASS_TINT_LUMA);

    float chromaLuminance =
        dot(chroma, LOCAL_GLASS_TINT_LUMA);

    return
        clamp(
            chroma *
            (targetLuminance / max(chromaLuminance, 1.0e-4)),
            vec3(0.0),
            vec3(1.0)
        );
}

// =====================================================
// Hue-preserving exposure guard for the local-light glass tint
//
// The visibility path is a plain multiplicative transmittance, so a bright
// local emitter drives its dominant channel past the display white point
// (rr_sdr_post is a bare pow(1/2.2) encode with no tone curve) and the
// illuminated pool reads as white even through saturated stained glass.
//
// Re-saturating the *transmittance* cannot recover that: the product is
// already out of range by the time the sink sees it.  So the filter is
// applied to the whole radiance and the result is then compressed with ONE
// shared scalar as soon as its peak leaves the unit range.  Every channel
// is scaled by the same factor, so the channel ratios - and therefore the
// hue - survive exactly, and only the excess brightness is folded back.
//
// Neutral transmission (every local light that does not shine through
// coloured glass) returns immediately, so this is a no-op for them: no ray,
// no texture fetch, no extra binding, ~10 ALU on a value that already
// existed.
// =====================================================
const float LOCAL_GLASS_TINT_NEUTRAL_SPREAD = 0.08;

// Fraction of the panes' transit luminance the pool keeps.  1.0 lets the
// sheet absorb exactly its own luminance once on top of the hue rotation;
// 0.0 disables that extra absorption and leaves colour only.  Single knob
// for tuning how dark a coloured pool becomes.
const float LOCAL_GLASS_TINT_ABSORPTION = 1.0;

vec3 applyLocalGlassTint(vec3 radiance, vec3 transmittance)
{
    // 诊断（R 通道）：本地光直射项的入射能量（过滤之前），用于与二级弹射
    // 项、无过滤假发光项比较能量占比。
    if(DBG_LOCAL_TERM_MAP)
    {
        return vec3(dbgTermLuma(radiance), 0.0, 0.0);
    }
    if(DBG_GLASS_DYE_VS_ENERGY)
    {
        // R = 直射的染料浓度（经玻璃过滤，应当有色）
        // G = 该项能量
        return vec3(
            dbgDyeConcentration(strengthenLocalGlassTint(
                clamp(transmittance, vec3(0.0), vec3(1.0))
            )),
            dbgTermLuma(radiance),
            0.0
        );
    }

    vec3 paneTransit =
        clamp(transmittance, vec3(0.0), vec3(1.0));

    // 判决实验 I 探针直通：探针值已经是最终读数，不能再被"染色增强"
    // 与中性早退改写，否则读出的不是 DDA 覆盖率本身。
    if(DBG_VPT_DDA_PROBE)
    {
        return paneTransit;
    }

    vec3 tint =
        strengthenLocalGlassTint(paneTransit);

    float tintPeak = max(tint.r, max(tint.g, tint.b));
    float tintFloor = min(tint.r, min(tint.g, tint.b));
    if(tintPeak - tintFloor <= LOCAL_GLASS_TINT_NEUTRAL_SPREAD)
    {
        return max(radiance, vec3(0.0)) * tint;
    }

    // A stained pane absorbs energy as well as rotating hue.
    // strengthenLocalGlassTint() deliberately restores the panes' own
    // luminance, so on its own it leaves a bright local emitter's pool
    // sitting at - or above - the white point.  Scaling by that same transit
    // luminance makes the sheet really eat light, so the pool drops to a
    // level where its colour gradient can read instead of reading as white.
    vec3 tinted =
        max(radiance, vec3(0.0)) *
        tint *
        pow(
            max(dot(paneTransit, LOCAL_GLASS_TINT_LUMA), 0.0),
            LOCAL_GLASS_TINT_ABSORPTION
        );

    if(DBG_GLASS_PEAK_READOUT)
    {
        // 同上：比值型读数，读直射路径染色后的色调纯度
        return dbgHuePurity2(tinted);
    }

    // rr_sdr_post is a bare pow(1/2.2) with no tone curve, so every channel
    // above 1.0 is clipped *per channel*: the clipped channels all stop at
    // the same level while the ratios collapse, and that collapse is what
    // reads as white.  Fold the peak back to exactly the white point with
    // ONE shared scalar, so every channel ratio - and therefore the hue -
    // survives at the brightest level that cannot clip.
    float peak = max(tinted.r, max(tinted.g, tinted.b));
    if(peak <= 1.0)
    {
        return tinted;
    }
    return tinted * (1.0 / peak);
}

vec3 traceSunTransmittanceThroughWater(
    vec3 startOrigin,
    vec3 rayDir,
    bool stableTransmission
) {

    const float WATER_IOR =
        1.33;

    // Waterlight 风格青绿松石水色：红强吸收、蓝轻压、绿最透。
    const vec3 WATER_ABSORPTION =
        waterAbsorptionColor();
        const vec3 WATER_SCATTER_COLOR = waterScatterColor();

const float WATER_EXTINCTION_DISTANCE =
    16.0;

    const float WATER_F0 =
        0.0200593;

    const float RAY_BIAS =
        0.001;

    vec3 transmittance =
        vec3(1.0);

    vec3 currentOrigin =
        startOrigin;

    vec3 currentDir =
        normalize(rayDir);

    for(
        int step = 0;
        step < min(6, perfL10MarchCap());
        ++step
    )
    {
        payload.hitDistance =
            1.0;

        payload.state = makeTraceState(RT_PURPOSE_CLASSIFY);

        traceRayEXT(
            topLevelAS,
            gl_RayFlagsNoneEXT,
            0xff,
            0,
            0,
            0,
            currentOrigin,
            0.02,
            currentDir,
            10000.0,
            0
        );

        // 没有任何几何体阻挡。
        if(
            payload.hitDistance < 0.0
        )
        {
            return transmittance;
        }

        float hitMaterialId =
            getLegacyMaterialId(payload.state);


        // =================================================
        // T1/T9/T3 COMBINED
        //
        // payload:
        //   0 = opaque
        //   1 = Air -> Water
        //   2 = Water -> Air
        //   3 = exact glass / stained glass
        //
        // Glass uses straight transmission: NO refraction.
        // One Orion boundary sheet per block.
        // =================================================
if(hitMaterialId >= 2.5)
{
    // ID 3 = entering / normal glass face.
    // Apply the Orion sheet transmission once per block.
    //
    // ID 4 = exit or bottom face.
    // Continue through it, but do not tint a second time.
    if(hitMaterialId < 3.5)
    {
        transmittance *=
            glassSheetTransmission(
                payload.albedo,
                payload.normal,
                currentDir
            );

        // W2: below 1% the remaining march cannot contribute visible
        // sun energy; stop tracing through stacked glass sheets.
        if(max(transmittance.r, max(transmittance.g, transmittance.b)) < 0.01)
        {
            return vec3(0.0);
        }
    }


    vec3 glassHitPos =
        currentOrigin +
        currentDir *
        payload.hitDistance;


    currentOrigin =
        glassHitPos +
        currentDir *
        RAY_BIAS;


    continue;
}

        if(
            hitMaterialId <= 0.5
        )
        {
            // Opaque geometry still blocks the sun.
            return vec3(0.0);
        }


        // =================================================
        // Water only from this point onward.
        //
        // 1.0 = Air -> Water
        // 2.0 = Water -> Air
        // =================================================
        // Water -> Air state.
        bool exitingWater =
            hitMaterialId > 1.5;

        // The segment before this interface was travelled inside water.
        // Keep absorption as Beer-Lambert attenuation and add a separate
        // in-scattering term instead of replacing the transmitted light.
        if(exitingWater)
        {
float waterDistance =
    stableTransmission
        ? min(payload.hitDistance, 2.0)
        : payload.hitDistance;

            vec3 extinction =
                exp(
                    -WATER_ABSORPTION *
                    waterDistance
                );

            transmittance *= extinction;

            float scatterDepth =
                1.0 -
                exp(
                    -waterDistance * 0.05
                );

            vec3 inScatter =
                WATER_SCATTER_COLOR *
                scatterDepth;

            transmittance +=
                inScatter;
        }

        vec3 hitPos =
            currentOrigin +
            currentDir *
            payload.hitDistance;

        // rchit 已经保证 normal 朝向入射射线。
        vec3 hitNormal =
            normalize(
                payload.normal
            );

        hitNormal =
            stabilizeWaterInterfaceNormal(
                hitNormal
            );

        // =================================================
        // FIX: Water -> Air classify stability
        //
        // The animated water-wave normal is desirable when entering water,
        // but on the exit interface it produces triangle-dependent classify
        // refraction and causes the reported flashing triangles.
        //
        // Keep full absorption/scatter on the underwater segment, but use a
        // stable planar exit normal for the Water -> Air interface.
        // =================================================
        vec3 interfaceNormal =
            exitingWater
                ? vec3(
                    0.0,
                    hitNormal.y >= 0.0 ? 1.0 : -1.0,
                    0.0
                )
                : hitNormal;

        float cosTheta =
            clamp(
                -dot(
                    currentDir,
                    interfaceNormal
                ),
                0.0,
                1.0
            );

        // Fresnel transmission。
        // 反射出去的能量在这里不允许继续作为透射太阳。
        float fresnel =
            WATER_F0 +
            (
                1.0 -
                WATER_F0
            ) *
            pow(
                1.0 -
                cosTheta,
                5.0
            );

        transmittance *=
            1.0 -
            fresnel;

        // W2: a deep water crossing can absorb the sun below any
        // visible contribution; stop the march before its remaining
        // interface traces.
        if(max(transmittance.r, max(transmittance.g, transmittance.b)) < 0.01)
        {
            return vec3(0.0);
        }

float eta =
    1.0 / WATER_IOR;

        vec3 transmittedDir =
            refract(
                currentDir,
                interfaceNormal,
                eta
            );

        // Water -> Air 可能发生全反射。
        // 这部分属于反射路径，
        // 不能继续算作太阳透射。
        if(
            dot(
                transmittedDir,
                transmittedDir
            ) < 1.0e-6
        )
        {
            return vec3(0.0);
        }

        // interfaceNormal 始终朝向射线来源一侧，
        // 所以透射后统一向 -normal 偏移即可跨过界面。
        currentOrigin =
            hitPos -
            interfaceNormal *
            RAY_BIAS;

        currentDir =
            normalize(
                transmittedDir
            );
    }

    return vec3(0.0);
}
const float PI =
    3.14159265359;


int decodeF0MetalCode(
    float f0Metal
)
{
    return int(
        round(
            clamp(
                f0Metal,
                0.0,
                1.0
            ) *
            255.0
        )
    );
}


float decodeMetallicFromCode(
    int code
)
{
    return code >= 230
        ? 1.0
        : 0.0;
}


vec3 complexIorToF0(
    vec3 n,
    vec3 k
)
{
    vec3 nMinus1 =
        n - vec3(1.0);

    vec3 nPlus1 =
        n + vec3(1.0);

    return
        (
            nMinus1 * nMinus1 +
            k * k
        ) /
        (
            nPlus1 * nPlus1 +
            k * k
        );
}


vec3 decodeBaseF0(
    int code,
    vec3 albedo
)
{
    if(code <= 229)
    {
        return vec3(
            float(code) / 255.0
        );
    }

    if(code == 230)
    {
        // Iron
        return complexIorToF0(
            vec3(
                2.9114,
                2.9497,
                2.5845
            ),
            vec3(
                3.0893,
                2.9318,
                2.7670
            )
        );
    }

    if(code == 231)
    {
        // Gold
        return complexIorToF0(
            vec3(
                0.18299,
                0.42108,
                1.3734
            ),
            vec3(
                3.4242,
                2.3459,
                1.7704
            )
        );
    }

    if(code == 232)
    {
        // Aluminum
        return complexIorToF0(
            vec3(
                1.3456,
                0.96521,
                0.61722
            ),
            vec3(
                7.4746,
                6.3995,
                5.3031
            )
        );
    }

    if(code == 233)
    {
        // Chrome
        return complexIorToF0(
            vec3(
                3.1071,
                3.1812,
                2.3230
            ),
            vec3(
                3.3314,
                3.3291,
                3.1350
            )
        );
    }

    if(code == 234)
    {
        // Copper
        return complexIorToF0(
            vec3(
                0.27105,
                0.67693,
                1.3164
            ),
            vec3(
                3.6092,
                2.6248,
                2.2921
            )
        );
    }

    if(code == 235)
    {
        // Lead
        return complexIorToF0(
            vec3(
                1.9100,
                1.8300,
                1.4400
            ),
            vec3(
                3.5100,
                3.4000,
                3.1800
            )
        );
    }

    if(code == 236)
    {
        // Platinum
        return complexIorToF0(
            vec3(
                2.3757,
                2.0847,
                1.8453
            ),
            vec3(
                4.2655,
                3.7153,
                3.1365
            )
        );
    }

    if(code == 237)
    {
        // Silver
        return complexIorToF0(
            vec3(
                0.15943,
                0.14512,
                0.13547
            ),
            vec3(
                3.9291,
                3.1900,
                2.3808
            )
        );
    }

    // 255 = generic metal, use albedo as F0.
    // 238..254 先按 generic metal 处理。
    return albedo;
}


// =====================================================
// RR-6.2 - Specular Albedo approximation
// =====================================================

vec3 rrEnvBRDFApprox2(
    vec3 specularColor,
    float alpha,
    float NoV
)
{
    NoV = abs(NoV);

    float Xx = 1.0;
    float Xy = NoV;
    float Xz = NoV * NoV;
    float Xw = NoV * Xz;

    float Yx = 1.0;
    float Yy = alpha;
    float Yw = alpha * alpha * alpha;

    vec2 m1x =
        vec2(
            0.99044 * Xx - 1.28514 * Xy,
            1.29678 * Xx - 0.755907 * Xy
        );

    float biasDen =
        dot(
            vec3(
                1.0 * Xx + 2.92338 * Xy + 59.4188 * Xw,
                20.3225 * Xx - 27.0302 * Xy + 222.592 * Xw,
                121.563 * Xx + 626.13 * Xy + 316.627 * Xw
            ),
            vec3(
                Yx,
                Yy,
                Yw
            )
        );

    float bias =
        dot(
            m1x,
            vec2(
                Yx,
                Yy
            )
        ) /
        max(
            biasDen,
            1.0e-6
        );

    vec2 m3x =
        vec2(
            0.0365463 * Xx + 3.32707 * Xy,
            9.0632 * Xx - 9.04756 * Xy
        );

    float scaleDen =
        dot(
            vec3(
                1.0 * Xx + 3.59685 * Xz - 1.36772 * Xw,
                9.04401 * Xx - 16.3174 * Xz + 9.22949 * Xw,
                5.56589 * Xx + 19.7886 * Xz - 20.2123 * Xw
            ),
            vec3(
                Yx,
                Yy,
                Yw
            )
        );

    float scale =
        dot(
            m3x,
            vec2(
                Yx,
                Yy
            )
        ) /
        max(
            scaleDen,
            1.0e-6
        );

    bias *=
        clamp(
            specularColor.g * 50.0,
            0.0,
            1.0
        );

    return
        specularColor *
        max(
            scale,
            0.0
        ) +
        vec3(
            max(
                bias,
                0.0
            )
        );
}


vec3 fresnelSchlick(
    float cosTheta,
    vec3 F0
)
{
    // Exact x^5 expansion: same series as pow(x,5), off the SFU pipe and
    // slightly more accurate than the GPU pow approximation.
    vec3 x = vec3(1.0) - vec3(cosTheta);
    vec3 x2 = x * x;
    return
        F0 +
        (
            vec3(1.0) - F0
        ) *
        ((x2 * x2) * x);
}


// =====================================================
// PBR-1B - Burley diffuse angular / roughness response
//
// Reimplemented for this Vulkan RT path from the same
// Disney Burley model used by the reference shader.
//
// IMPORTANT:
// - f90 base = 0.5
// - roughness factor = 2.0
// - Schlick exponent = 5
// - 1/PI is intentionally NOT applied here.
//
// This keeps the project's existing diffuse energy scale
// and only imports the Burley angular/roughness response.
// =====================================================
float evaluateBurleyDiffuseAngular(
    vec3 N,
    vec3 V,
    vec3 L,
    float roughness
)
{
    vec3 H =
        normalize(
            V + L
        );


    float LdotH =
        clamp(
            dot(L, H),
            0.0,
            1.0
        );


    float NdotL =
        clamp(
            dot(N, L),
            0.0,
            1.0
        );


    float NdotV =
        clamp(
            dot(N, V),
            0.0,
            1.0
        );


    float f90 =
        0.5 +
        2.0 *
        roughness *
        LdotH *
        LdotH;


    float lightScatter =
        1.0 +
        (
            f90 - 1.0
        ) *
        pow(
            1.0 - NdotL,
            5.0
        );


    float viewScatter =
        1.0 +
        (
            f90 - 1.0
        ) *
        pow(
            1.0 - NdotV,
            5.0
        );


    return
        NdotL *
        lightScatter *
        viewScatter;
}


// =====================================================
// PBR-2 - Reference-shader rough-specular reflection gate
//
// Active reference settings:
//   ENABLE_ROUGH_SPECULAR
//   TEXTURE_PBR_FORMAT = 1
//   ROUGHNESS_CLAMP = 2
//
// Original material logic, reimplemented for this RT path:
//   x = saturate(perceptualSmoothness * 2.5 - 0.85)
//   reflectionStrength = curveTop(x)
//   curveTop(x) = 1 - (x - 1)^2
//   LabPBR metal code >= 230 forces reflectionStrength to 1.
//
// For opaque specular tracing the reference shader uses this as
// a tracing gate (> 0), not as an extra multiplier on the final
// reflection radiance. We keep the same behavior here.
// =====================================================
float evaluatePBR2ReflectionStrength(
    float encodedRoughness,
    int f0MetalCode
)
{
    // Current payload stores:
    //   roughness = (1 - perceptualSmoothness)^2
    // Recover the original LabPBR smoothness before the later
    // shading roughness clamp is applied.
    float perceptualSmoothness =
        1.0 -
        sqrt(
            clamp(
                encodedRoughness,
                0.0,
                1.0
            )
        );


    float x =
        clamp(
            perceptualSmoothness * 2.5 - 0.85,
            0.0,
            1.0
        );


    float shifted =
        x - 1.0;


    float reflectionStrength =
        1.0 - shifted * shifted;


    if(f0MetalCode >= 230)
    {
        reflectionStrength =
            1.0;
    }


    return
        clamp(
            reflectionStrength,
            0.0,
            1.0
        );
}


float distributionGGX(
    vec3 N,
    vec3 H,
    float roughness
)
{
    float a =
        roughness * roughness;

    float a2 =
        a * a;

    float NdotH =
        max(
            dot(N, H),
            0.0
        );

    float NdotH2 =
        NdotH * NdotH;

    float denom =
        NdotH2 *
        (
            a2 - 1.0
        ) +
        1.0;

    return
        a2 /
        max(
            PI * denom * denom,
            1.0e-6
        );
}


float geometrySchlickGGX(
    float NdotX,
    float roughness
)
{
    float r =
        roughness + 1.0;

    float k =
        (r * r) / 8.0;

    return
        NdotX /
        (
            NdotX * (1.0 - k) + k
        );
}


float geometrySmith(
    vec3 N,
    vec3 V,
    vec3 L,
    float roughness
)
{
    float NdotV =
        max(
            dot(N, V),
            0.0
        );

    float NdotL =
        max(
            dot(N, L),
            0.0
        );

    float ggxV =
        geometrySchlickGGX(
            NdotV,
            roughness
        );

    float ggxL =
        geometrySchlickGGX(
            NdotL,
            roughness
        );

    return
        ggxV * ggxL;
}

// Primary-water direct sun response.  The visibility query is intentionally
// shared with opaque sunlight: water under a roof, cliff, or opaque canopy
// receives no GGX sun glint.  Water-body scattering remains solely on the
// established transmitted-water path, where it has real optical distance.
const float WATER_SURFACE_SUN_ROUGHNESS = 0.12;

vec3 evaluatePrimaryWaterSunLighting(
    vec3 waterSurfacePosition,
    vec3 waterNormal,
    vec3 viewDirection,
    vec3 sunDirection
)
{
    const float WATER_F0 = 0.0200593;

    vec3 N = normalize(waterNormal);
    vec3 V = normalize(viewDirection);
    vec3 L = normalize(sunDirection);

    float NdotL = max(dot(N, L), 0.0);
    float NdotV = max(dot(N, V), 0.0);

    // This is an explicit sun term, not moonlight or sky reflection.
    if(L.y <= 0.0 || NdotL <= 0.0 || NdotV <= 0.0)
    {
        return vec3(0.0);
    }

    // One primary-water-to-sun visibility trace.  It returns zero behind
    // opaque blockers and retains any existing glass colour filtering.
    vec3 sunTransmittance = traceSunTransmittanceThroughWater(
        waterSurfacePosition + N * 0.035,
        L,
        true
    );

    if(max(sunTransmittance.r, max(sunTransmittance.g, sunTransmittance.b)) <= 0.0)
    {
        return vec3(0.0);
    }

    vec3 sunRadiance =
        getTimeDrivenSkyLightColor() *
        3.2 *
        getTimeDrivenSkyLightRadianceScale() *
        sunTransmittance *
        c3CloudSunTransmittance(waterSurfacePosition + N * 0.035, L);

    vec3 H = normalize(V + L);
    float VdotH = max(dot(V, H), 0.0);
    float F = fresnelSchlickScalar(VdotH, WATER_F0);
    float D = distributionGGX(N, H, WATER_SURFACE_SUN_ROUGHNESS);
    float G = geometrySmith(N, V, L, WATER_SURFACE_SUN_ROUGHNESS);
    vec3 sunSpecular =
        sunRadiance *
        ((D * G * F) / max(4.0 * NdotV * NdotL, 1.0e-4)) *
        NdotL;

    return sunSpecular;
}


vec3 evaluateDirectSunLighting(
    vec3 hitPos,
    vec3 hitNormal,
    vec3 viewDir,
    vec3 hitAlbedo,
    float hitRoughness,
    float hitF0Metal,
    float pomSelfShadow,
    vec3 sunDirection
)
{
    vec3 N =
        normalize(
            hitNormal
        );

    vec3 V =
        normalize(
            viewDir
        );

    vec3 L =
        normalize(
            sunDirection
        );

    float NdotL =
        max(
            dot(N, L),
            0.0
        );

    float NdotV =
        max(
            dot(N, V),
            0.0
        );

    if(
        NdotL <= 0.0 ||
        NdotV <= 0.0
    )
    {
        return vec3(0.0);
    }


    vec3 sunTransmittance =
        traceSunTransmittanceThroughWater(
            hitPos +
                L * 0.001,
            L,
            true
        );

    vec3 sunLightColor =
        getTimeDrivenSkyLightColor() *
        3.2 *
        getTimeDrivenSkyLightRadianceScale() *
        sunTransmittance *
        c3CloudSunTransmittance(hitPos + L * 0.001, L) *
        clamp(
            pomSelfShadow,
            0.0,
            1.0
        );


    int f0MetalCode =
        decodeF0MetalCode(
            hitF0Metal
        );

    float metallic =
        decodeMetallicFromCode(
            f0MetalCode
        );

    vec3 F0 =
        decodeBaseF0(
            f0MetalCode,
            hitAlbedo
        );


    float roughness =
        clamp(
            hitRoughness,
            0.04,
            1.0
        );


    vec3 H =
        normalize(
            V + L
        );

    float VdotH =
        max(
            dot(V, H),
            0.0
        );


    vec3 F =
        fresnelSchlick(
            VdotH,
            F0
        );

    float D =
        distributionGGX(
            N,
            H,
            roughness
        );

    float G =
        geometrySmith(
            N,
            V,
            L,
            roughness
        );


    vec3 specularBRDF =
        (
            D * G * F
        ) /
        max(
            4.0 * NdotV * NdotL,
            1.0e-4
        );


    vec3 kD =
        (
            vec3(1.0) - F
        ) *
        (1.0 - metallic);


    // PBR-1B:
    // Keep this helper path's existing 1.2 diffuse scale.
    // Only replace Lambert NdotL with Burley angular response.
    float burleyDiffuse =
        evaluateBurleyDiffuseAngular(
            N,
            V,
            L,
            roughness
        );


    vec3 diffuseTerm =
        kD *
        hitAlbedo *
        1.2 *
        burleyDiffuse;

    vec3 specularTerm =
        specularBRDF *
        NdotL;


    return
        sunLightColor *
        (
            diffuseTerm +
            specularTerm
        );
}


// =====================================================
// RT Local Lights - L4
//
// Primary opaque surface only.
//
// Per pixel:
//   1) scan uploaded local lights,
//   2) retain the strongest 4 approximate contributors,
//   3) trace at most 4 visibility rays,
//   4) evaluate the same Cook-Torrance GGX model used by
//      current direct-sun lighting.
//
// L4 deliberately uses neutral white light. Per-block RGB/type
// mapping is deferred to the next Local Light section.
// =====================================================

const int MAX_PRIMARY_LOCAL_LIGHTS =
    4;


// =====================================================
// L7.3 B - Secondary diffuse Local Light GI budget
//
// Keep the strongest 2 local lights.
// Each selected light uses exactly 1 real 2.0x2.0 cube-area
// surface sample and at most 1 visibility ray.
// =====================================================
const int MAX_SECONDARY_LOCAL_LIGHTS =
    2;

vec3 decodeLocalLightColor(
    uint typeCode
)
{
    // 0 = fallback / 未分类
    if(typeCode == 0u)
    {
        return
            vec3(
                1.00,
                0.90,
                0.75
            );
    }


    // 1 = 火把 / 灯笼 / 营火 / 普通火
    if(typeCode == 1u)
    {
        return
            vec3(
                1.00,
                0.62,
                0.28
            );
    }


    // 2 = 灵魂火系列
    if(typeCode == 2u)
    {
        return
            vec3(
                0.25,
                0.72,
                1.00
            );
    }


    // 3 = 红石火把
    if(typeCode == 3u)
    {
        return
            vec3(
                1.00,
                0.18,
                0.08
            );
    }


    // 4 = 岩浆
    if(typeCode == 4u)
    {
        return
            vec3(
                1.00,
                0.34,
                0.08
            );
    }


    // 5 = 萤石 / 海晶灯 / 菌光体 /
    //     南瓜灯 / 红石灯
    if(typeCode == 5u)
    {
        return
            vec3(
                1.00,
                0.82,
                0.52
            );
    }


    return
        vec3(
            1.00,
            0.90,
            0.75
        );
}
// =====================================================
// E1-1 - Unified Local Emitter Radiance
//
// Same Minecraft emitter definition is now shared by:
// - Primary
// - Glossy reflection
// - Diffuse GI
//
// incomingRayDirection points TOWARD the hit surface.
// Probe 0.02 block past the surface so a boundary hit is
// classified inside the block that was actually intersected.
// =====================================================

vec3 evaluateLocalEmitterCandidateRadiance(
    vec3 hitPos,
    vec3 incomingRayDirection,
    vec3 hitAlbedo,
    LocalLightGPU candidateLight
)
{
    vec3 safeIncomingDir =
        normalize(
            incomingRayDirection
        );


    vec3 emitterProbePos =
        hitPos +
        safeIncomingDir *
        0.02;


    vec4 worldPosEmission =
        candidateLight
            .worldPosEmission;


    vec3 emitterBlockMin =
        worldPosEmission.xyz -
        vec3(0.001);


    vec3 emitterBlockMax =
        worldPosEmission.xyz +
        vec3(1.001);


    bool hitThisEmitter =
        all(
            greaterThanEqual(
                emitterProbePos,
                emitterBlockMin
            )
        ) &&
        all(
            lessThanEqual(
                emitterProbePos,
                emitterBlockMax
            )
        );


    if(!hitThisEmitter)
    {
        return vec3(0.0);
    }


    float emitterLevel =
        clamp(
            worldPosEmission.w,
            1.0,
            15.0
        );


    float emitterLevel01 =
        emitterLevel /
        15.0;


    vec3 emitterColor =
        decodeLocalLightColor(
            candidateLight.meta.x
        );


    vec3 safeAlbedo =
        clamp(
            hitAlbedo,
            vec3(0.0),
            vec3(1.0)
        );


    float albedoRadiance =
        dot(
            safeAlbedo,
            vec3(0.333333333)
        );


    // E1-2A:
    // 保留原来的纹理，而不是把整个方块刷成恒定发光色。
    return
        emitterColor *
        3.2 *
        LOCAL_LIGHT_ENERGY_SCALE *
        emitterLevel01 *
        albedoRadiance *
        safeAlbedo;
}


vec3 evaluateLocalEmitterRadianceAtHit(
    vec3 hitPos,
    vec3 incomingRayDirection,
    vec3 hitAlbedo
)
{
    // =====================================================================
    // HARD-KILL (2026-09-21): local direct light is disabled unconditionally
    // at the shader source level, bypassing the user-facing toggle entirely.
    // This guarantees every local emitter (torch/lamp/glowstone/etc) stops
    // contributing DIRECT light; only the secondary bounce (G2B guide) and
    // sun/sky/GI remain.  Revert this block to restore the toggle.
    // =====================================================================
    {
        return
            vec3(0.0);
    }


    uint lightCount =
        localLightBuffer.header.x;


    if(lightCount == 0u)
    {
        return
            vec3(0.0);
    }


    // The inward probe uses the same convention as the candidate test below.
    // Search the 3x3x3 neighborhood to preserve the original inclusive box
    // test at a 32-block grid boundary (an emitter on either side can own an
    // exactly-on-boundary probe).
    vec3 emitterProbePos =
        hitPos -
        normalize(
            incomingRayDirection
        ) *
        0.02;


    ivec3 probeCell =
        localLightGridCellCoord(
            emitterProbePos
        );


    uint packedIndexBase =
        localLightGridPackedIndexBase();


    int minCellX =
        localLightGridNeighborMinOffset(
            emitterProbePos.x
        );

    int maxCellX =
        localLightGridNeighborMaxOffset(
            emitterProbePos.x
        );

    int minCellY =
        localLightGridNeighborMinOffset(
            emitterProbePos.y
        );

    int maxCellY =
        localLightGridNeighborMaxOffset(
            emitterProbePos.y
        );

    int minCellZ =
        localLightGridNeighborMinOffset(
            emitterProbePos.z
        );

    int maxCellZ =
        localLightGridNeighborMaxOffset(
            emitterProbePos.z
        );


    vec3 emitterRadiance =
        vec3(0.0);


    for(int cellZ = minCellZ; cellZ <= maxCellZ; ++cellZ)
    {
        for(int cellY = minCellY; cellY <= maxCellY; ++cellY)
        {
            for(int cellX = minCellX; cellX <= maxCellX; ++cellX)
            {
                uint firstLightIndex =
                    0u;

                uint cellLightCount =
                    0u;


                if(
                    !localLightGridLookupCell(
                        probeCell +
                        ivec3(
                            cellX,
                            cellY,
                            cellZ
                        ),
                        firstLightIndex,
                        cellLightCount
                    )
                )
                {
                    continue;
                }


                for(
                    uint candidateOffset = 0u;
                    candidateOffset < cellLightCount;
                    ++candidateOffset
                )
                {
                    uint lightIndex =
                        localLightGridBuffer.words[
                            packedIndexBase +
                            firstLightIndex +
                            candidateOffset
                        ];


                    if(lightIndex >= lightCount)
                    {
                        continue;
                    }


                    vec3 candidateRadiance =
                        evaluateLocalEmitterCandidateRadiance(
                            hitPos,
                            incomingRayDirection,
                            hitAlbedo,
                            localLightBuffer.lights[
                                lightIndex
                            ]
                        );


                    emitterRadiance =
                        max(
                            emitterRadiance,
                            candidateRadiance
                        );
                }
            }
        }
    }


    return
        emitterRadiance;
}
vec3 evaluateLocalEmitterSurfaceRadiance(
    vec3 hitPos,
    vec3 incomingRayDirection,
    vec3 hitAlbedo
)
{
    uint lightCount =
        localLightBuffer.header.x;


    vec3 emitterRadiance =
        vec3(0.0);


    vec3 safeAlbedo =
        clamp(
            hitAlbedo,
            vec3(0.0),
            vec3(1.0)
        );


    // iterationRP 的发光表面不是恒定颜色覆盖，
    // 而是让 emitter lighting 继续经过原表面 albedo。
    //
    // Radiance(albedo) 在原 shader 中就是 RGB 平均值。
    float albedoRadiance =
        dot(
            safeAlbedo,
            vec3(
                0.333333333
            )
        );


    for(
        uint lightIndex = 0u;
        lightIndex < lightCount;
        ++lightIndex
    )
    {
        LocalLightGPU candidateLight =
            localLightBuffer
                .lights[lightIndex];


        vec4 worldPosEmission =
            candidateLight
                .worldPosEmission;


        vec3 emitterProbePos =
            hitPos +
            normalize(
                incomingRayDirection
            ) *
            0.02;


        vec3 emitterBlockMin =
            worldPosEmission.xyz -
            vec3(0.001);


        vec3 emitterBlockMax =
            worldPosEmission.xyz +
            vec3(1.001);


        bool hitThisEmitter =
            all(
                greaterThanEqual(
                    emitterProbePos,
                    emitterBlockMin
                )
            ) &&
            all(
                lessThanEqual(
                    emitterProbePos,
                    emitterBlockMax
                )
            );


        if(!hitThisEmitter)
        {
            continue;
        }


        float emitterLevel =
            clamp(
                worldPosEmission.w,
                1.0,
                15.0
            );


        float emitterLevel01 =
            emitterLevel /
            15.0;


        vec3 emitterColor =
            decodeLocalLightColor(
                candidateLight.meta.x
            );


        vec3 texturedEmitterRadiance =
            emitterColor *
            3.2 *
            LOCAL_LIGHT_ENERGY_SCALE *
            emitterLevel01 *
            albedoRadiance *
            safeAlbedo;


        emitterRadiance =
            max(
                emitterRadiance,
                texturedEmitterRadiance
            );
    }


    return
        emitterRadiance;
}
float localLightRangeFade(
    float distanceToLight,
    float emissionLevel
)
{
    // C-2:
    // Minecraft emission level 15 -> 30 block effective range.
    float range =
        max(
            emissionLevel * 2.0,
            2.0
        );


    // 15-level light:
    // 24 blocks = fade start
    // 30 blocks = zero
    float fadeStart =
        range *
        0.80;


    return
        1.0 -
        smoothstep(
            fadeStart,
            range,
            distanceToLight
        );
}


// =====================================================
// C-2 - Local Light distance attenuation
//
// Replaces the old hard 1 / d^2 falloff.
//
// Confirmed curve:
//     0.55 / (1 + 0.18*d + 0.025*d^2)
//
// Goals:
// - reduce the near-field hotspot,
// - preserve much more medium-range energy,
// - let indoor lighting spread naturally.
// =====================================================

float localLightDistanceAttenuation(
    float distanceToLight
)
{
    float d =
        max(
            distanceToLight,
            0.0
        );


    return
        0.55 /
        (
            1.0 +
            0.18 * d +
            0.025 * d * d
        );
}



// =====================================================
// L7.1 - True voxel cube area light
//
// B quality mode:
//   2 real emitter-surface samples / selected light / pixel
//
// The old projected disk approximation is removed.
// Each sample lies on an actual visible face of the emitting
// 1x1x1 voxel.  The shadow ray therefore ends on the emitter
// surface itself, which makes penumbra width depend on the real
// source/blocker/receiver geometry.
//
// Up to 4 selected local lights -> at most 8 local-light
// visibility rays / pixel.
//
// Sampling is spatially + temporally decorrelated.  RR / DLSS
// can integrate the remaining 2-spp stochastic noise.
// =====================================================

const int LOCAL_LIGHT_CUBE_AREA_SAMPLES =
    2;


// =====================================================
// L7.2
// Keep 2 rays / light, but enlarge the effective emitting
// face from 1x1 to 2.0x2.0 blocks.
// =====================================================
const float LOCAL_LIGHT_CUBE_EMITTER_SIZE =
    2.0;

const float LOCAL_LIGHT_CUBE_EMITTER_HALF_SIZE =
    LOCAL_LIGHT_CUBE_EMITTER_SIZE *
    0.5;


// Keep samples slightly away from the virtual emitter border.
// This still avoids unstable edge hits while allowing a much
// wider penumbra than the old 1x1 source.
const float LOCAL_LIGHT_CUBE_SURFACE_INSET =
    0.03;


// The ray target is already on the emitter surface, so the old
// 0.70 block center-exclusion distance is no longer appropriate.
// Stop only a tiny distance before the sampled surface.
const float LOCAL_LIGHT_CUBE_RAY_END_EPSILON =
    0.03;


// =====================================================
// P1-1 - Hybrid Local Light emitter shapes
//
// type 1..3: point-like fire family, represented by the
//             iterationRP diffuse light sphere (radius 0.5)
// type 4..5: full-block emitters, use the confirmed effective
//             2.0x2.0 cube-face area
// =====================================================

const float LOCAL_LIGHT_POINT_SPHERE_RADIUS =
    0.5;


const float LOCAL_LIGHT_POINT_SPHERE_PROJECTED_AREA =
    3.14159265359 *
    LOCAL_LIGHT_POINT_SPHERE_RADIUS *
    LOCAL_LIGHT_POINT_SPHERE_RADIUS;


bool isPointLikeLocalLightType(
    uint typeCode
)
{
    return
        typeCode >= 1u &&
        typeCode <= 3u;
}


// Existing L7 energy shaping is intentionally retained.
// It only controls the game-tuned local-light response; the
// penumbra itself is now produced geometrically by the cube area.
const float LOCAL_LIGHT_L7_NEARFIELD_MIN_D2 =
    1.75;

const float LOCAL_LIGHT_L7_RADIANCE_SCALE =
    LOCAL_LIGHT_ENERGY_SCALE;

const float LOCAL_LIGHT_L7_DIFFUSE_SCALE =
    0.92;

const float LOCAL_LIGHT_L7_DIFFUSE_SOFTEN =
    0.45;

const float LOCAL_LIGHT_L7_SPECULAR_SCALE =
    0.28;

const float LOCAL_LIGHT_L7_MIN_SPECULAR_ROUGHNESS =
    0.35;


// =====================================================
// Sample the visible projected surface of the point-like sphere.
//
// The sphere is centered at BlockPos + 0.5 and uses the confirmed
// iterationRP diffuse-light radius 0.5.  Sampling the receiver-facing
// projected disk avoids wasting rays on the hidden half of the sphere.
// It is an isotropic point-like emitter, so callers must NOT apply the
// cube-face emitterFacing term to this sample.
// =====================================================

vec3 sampleLocalLightPointSphereSurface(
    vec3 emitterBlockPos,
    vec3 receiverPos,
    int selectedSlot,
    int sampleIndex
)
{
    vec3 emitterCenter =
        emitterBlockPos +
        vec3(0.5);


    vec3 centerToReceiver =
        receiverPos -
        emitterCenter;


    float centerToReceiverLengthSquared =
        dot(
            centerToReceiver,
            centerToReceiver
        );


    vec3 frontDirection =
        centerToReceiverLengthSquared > 1.0e-8
            ? centerToReceiver *
                inversesqrt(
                    centerToReceiverLengthSquared
                )
            : vec3(
                0.0,
                1.0,
                0.0
            );


    vec3 referenceAxis =
        abs(frontDirection.y) < 0.999
            ? vec3(
                0.0,
                1.0,
                0.0
            )
            : vec3(
                1.0,
                0.0,
                0.0
            );


    vec3 tangent =
        normalize(
            cross(
                referenceAxis,
                frontDirection
            )
        );


    vec3 bitangent =
        cross(
            frontDirection,
            tangent
        );


    uvec3 emitterBits =
        floatBitsToUint(
            emitterBlockPos
        );


    uint framePhase =
        cam.frameCount &
        15u;


    uint state =
        gl_LaunchIDEXT.x * 1877u ^
        gl_LaunchIDEXT.y * 9241u ^
        framePhase * 26711u ^
        emitterBits.x * 31847u ^
        emitterBits.y * 42131u ^
        emitterBits.z * 61169u ^
        uint(selectedSlot + 1) * 1031u ^
        uint(sampleIndex + 1) * 2017u;


    float projectedRadius =
        LOCAL_LIGHT_POINT_SPHERE_RADIUS *
        sqrt(
            rand(state)
        );


    float projectedAngle =
        6.28318530718 *
        rand(state);


    float diskX =
        projectedRadius *
        cos(projectedAngle);


    float diskY =
        projectedRadius *
        sin(projectedAngle);


    float frontOffset =
        sqrt(
            max(
                LOCAL_LIGHT_POINT_SPHERE_RADIUS *
                    LOCAL_LIGHT_POINT_SPHERE_RADIUS -
                    projectedRadius *
                    projectedRadius,
                0.0
            )
        );


    return
        emitterCenter +
        tangent * diskX +
        bitangent * diskY +
        frontDirection * frontOffset;
}


// =====================================================
// Sample one of the three cube faces visible from receiverPos.
//
// Face-selection probability is proportional to the projected
// axis weight abs(receiver-center).  This avoids wasting either
// of the two rays on a back-facing cube face.
//
// The returned point stays on the selected voxel-face plane and uses
// the confirmed effective 2.0x2.0 tangential extent.
// =====================================================

vec3 sampleLocalLightCubeSurface(
    vec3 emitterBlockPos,
    vec3 receiverPos,
    int selectedSlot,
    int sampleIndex,
    out vec3 emitterSurfaceNormal,
    out float faceSelectionProbability
)
{
    vec3 emitterCenter =
        emitterBlockPos +
        vec3(0.5);


    vec3 centerToReceiver =
        receiverPos -
        emitterCenter;


    vec3 faceWeights =
        abs(
            centerToReceiver
        ) +
        vec3(1.0e-4);


    float faceWeightSum =
        faceWeights.x +
        faceWeights.y +
        faceWeights.z;


    uvec3 emitterBits =
        floatBitsToUint(
            emitterBlockPos
        );


    // 16 temporal phases.  Two samples per light use different
    // seed branches while adjacent pixels and emitters are also
    // decorrelated.
    uint framePhase =
        cam.frameCount &
        15u;


    uint state =
        gl_LaunchIDEXT.x * 1973u ^
        gl_LaunchIDEXT.y * 9277u ^
        framePhase * 26699u ^
        emitterBits.x * 31847u ^
        emitterBits.y * 42131u ^
        emitterBits.z * 61169u ^
        uint(selectedSlot + 1) * 1013u ^
        uint(sampleIndex + 1) * 1999u;


    float faceSelector =
        rand(state) *
        faceWeightSum;


    float tangentExtent =
        max(
            LOCAL_LIGHT_CUBE_EMITTER_HALF_SIZE -
                LOCAL_LIGHT_CUBE_SURFACE_INSET,
            0.01
        );


    float u =
        mix(
            -tangentExtent,
            tangentExtent,
            rand(state)
        );


    float v =
        mix(
            -tangentExtent,
            tangentExtent,
            rand(state)
        );


    vec3 samplePos =
        emitterCenter;


    if(faceSelector < faceWeights.x)
    {
        faceSelectionProbability =
            faceWeights.x /
            faceWeightSum;


        bool positiveFace =
            centerToReceiver.x >=
            0.0;


        emitterSurfaceNormal =
            vec3(
                positiveFace
                    ? 1.0
                    : -1.0,
                0.0,
                0.0
            );


                samplePos.x =
            emitterBlockPos.x +
            (
                positiveFace
                    ? 1.0
                    : 0.0
            );

        samplePos.y =
            emitterCenter.y +
            u;

        samplePos.z =
            emitterCenter.z +
            v;
    }
    else if(
        faceSelector <
        faceWeights.x +
        faceWeights.y
    )
    {
        faceSelectionProbability =
            faceWeights.y /
            faceWeightSum;


        bool positiveFace =
            centerToReceiver.y >=
            0.0;


        emitterSurfaceNormal =
            vec3(
                0.0,
                positiveFace
                    ? 1.0
                    : -1.0,
                0.0
            );


                samplePos.x =
            emitterCenter.x +
            u;

        samplePos.y =
            emitterBlockPos.y +
            (
                positiveFace
                    ? 1.0
                    : 0.0
            );

        samplePos.z =
            emitterCenter.z +
            v;
    }
    else
    {
        faceSelectionProbability =
            faceWeights.z /
            faceWeightSum;


        bool positiveFace =
            centerToReceiver.z >=
            0.0;


        emitterSurfaceNormal =
            vec3(
                0.0,
                0.0,
                positiveFace
                    ? 1.0
                    : -1.0
            );


        samplePos.x =
            emitterCenter.x +
            u;

        samplePos.y =
            emitterCenter.y +
            v;

        samplePos.z =
            emitterBlockPos.z +
            (
                positiveFace
                    ? 1.0
                    : 0.0
            );
    }


    return
        samplePos;
}


float localLightApproxScore(
    vec3 surfacePos,
    vec3 N,
    vec4 worldPosEmission
)
{
    float emissionLevel =
        clamp(
            worldPosEmission.w,
            1.0,
            15.0
        );


    // L2 stores integer BlockPos coordinates. The first L4 light
    // position is the geometric center of that emitting block.
    vec3 lightPos =
        worldPosEmission.xyz +
        vec3(0.5);


    vec3 toLight =
        lightPos -
        surfacePos;


    float distanceSquared =
        dot(
            toLight,
            toLight
        );


    if(distanceSquared <= 1.0e-6)
    {
        return
            0.0;
    }


    float distanceToLight =
        sqrt(
            distanceSquared
        );


    float rangeFade =
        localLightRangeFade(
            distanceToLight,
            emissionLevel
        );


    if(rangeFade <= 0.0)
    {
        return
            0.0;
    }


    vec3 L =
        toLight /
        distanceToLight;


    float NdotL =
        max(
            dot(
                N,
                L
            ),
            0.0
        );


    if(NdotL <= 0.0)
    {
        return
            0.0;
    }


    // Stable inverse-square ranking. Clamp the near field to
    // avoid a singular score when a surface is very close to
    // the emitting block center.
float distanceAttenuation =
    localLightDistanceAttenuation(
        distanceToLight
    );


    float emission01 =
        emissionLevel /
        15.0;


return
    emission01 *
    distanceAttenuation *
    rangeFade *
    NdotL;
}


// =====================================================
// G2B-2 Q1 + E1 - Diffuse-path Local-Light guiding
//
// Q1:
//   Keep exactly one diffuse GI path.  For every diffuse
//   direction, choose with equal probability between:
//     1) the confirmed cosine-weighted BSDF proposal, and
//     2) a Local-Light directional proposal.
//
//   The path throughput is corrected with the full mixture PDF:
//
//     pMix = 0.5 * pBSDF + 0.5 * pLight
//
//   No Local-Light radiance is added here.  The selected direction
//   is still traced as a normal full scene ray; blockers therefore
//   remain ordinary path hits rather than binary shadow tests.
//
// E1 guide geometry:
//   type 1..3 = confirmed R2 sphere, radius 0.5
//   type 4..5 = actual 1x1x1 emitter cube
//
// The guide geometry defines only the sampling PDF.  Emission is
// still accepted exclusively by the confirmed emitter-hit path.
// =====================================================

const float G2B_LOCAL_GUIDE_PROBABILITY =
    0.5;

const float G2B_LOCAL_GUIDE_EPSILON =
    1.0e-6;

const float G2B_CUBE_GUIDE_INSET =
    0.001;


bool g2bSurfaceBelongsToEmitter(
    vec3 surfacePos,
    vec3 surfaceNormal,
    vec3 emitterBlockPos
)
{
    vec3 insideProbe =
        surfacePos -
        normalize(surfaceNormal) *
        0.02;


    return
        all(
            greaterThanEqual(
                insideProbe,
                emitterBlockPos -
                    vec3(0.001)
            )
        ) &&
        all(
            lessThanEqual(
                insideProbe,
                emitterBlockPos +
                    vec3(1.001)
            )
        );
}


float g2bLocalGuideSelectionWeight(
    vec3 surfacePos,
    vec3 surfaceNormal,
    LocalLightGPU light
)
{
    if(
        g2bSurfaceBelongsToEmitter(
            surfacePos,
            surfaceNormal,
            light.worldPosEmission.xyz
        )
    )
    {
        return
            0.0;
    }


    return
        max(
            localLightApproxScore(
                surfacePos,
                surfaceNormal,
                light.worldPosEmission
            ),
            0.0
        );
}


float g2bLocalGuideWeightSum(
    vec3 surfacePos,
    vec3 surfaceNormal
)
{
    uint lightCount =
        localLightBuffer.header.x;


    float weightSum =
        0.0;


    ivec3 centerCell =
        localLightGridCellCoord(
            surfacePos
        );

    uint packedIndexBase =
        localLightGridPackedIndexBase();


    for(int cellZ = -1; cellZ <= 1; ++cellZ)
    {
        for(int cellY = -1; cellY <= 1; ++cellY)
        {
            for(int cellX = -1; cellX <= 1; ++cellX)
            {
                uint firstLightIndex =
                    0u;

                uint cellLightCount =
                    0u;


                if(
                    !localLightGridLookupCell(
                        centerCell +
                        ivec3(
                            cellX,
                            cellY,
                            cellZ
                        ),
                        firstLightIndex,
                        cellLightCount
                    )
                )
                {
                    continue;
                }


                for(
                    uint candidateOffset = 0u;
                    candidateOffset < cellLightCount;
                    ++candidateOffset
                )
                {
                    uint lightIndex =
                        localLightGridBuffer.words[
                            packedIndexBase +
                            firstLightIndex +
                            candidateOffset
                        ];


                    if(lightIndex >= lightCount)
                    {
                        continue;
                    }


                    weightSum +=
                        g2bLocalGuideSelectionWeight(
                            surfacePos,
                            surfaceNormal,
                            localLightBuffer.lights[
                                lightIndex
                            ]
                        );
                }
            }
        }
    }


    return
        weightSum;
}


bool g2bSampleSphereGuideDirection(
    vec3 surfacePos,
    vec3 emitterBlockPos,
    inout uint rngState,
    out vec3 sampledDirection,
    out float directionalPdf
)
{
    vec3 sphereCenter =
        emitterBlockPos +
        vec3(0.5);


    vec3 toCenter =
        sphereCenter -
        surfacePos;


    float centerDistanceSquared =
        dot(
            toCenter,
            toCenter
        );


    float radiusSquared =
        LOCAL_LIGHT_POINT_SPHERE_RADIUS *
        LOCAL_LIGHT_POINT_SPHERE_RADIUS;


    if(
        centerDistanceSquared <=
        radiusSquared +
            G2B_LOCAL_GUIDE_EPSILON
    )
    {
        sampledDirection =
            vec3(0.0, 1.0, 0.0);

        directionalPdf =
            0.0;

        return
            false;
    }


    float centerDistance =
        sqrt(
            centerDistanceSquared
        );


    vec3 coneAxis =
        toCenter /
        centerDistance;


    float cosThetaMax =
        sqrt(
            max(
                1.0 -
                    radiusSquared /
                    centerDistanceSquared,
                0.0
            )
        );


    float cosTheta =
        mix(
            1.0,
            cosThetaMax,
            rand(rngState)
        );


    float sinTheta =
        sqrt(
            max(
                1.0 -
                    cosTheta *
                    cosTheta,
                0.0
            )
        );


    float phi =
        2.0 *
        PI *
        rand(rngState);


    vec3 referenceAxis =
        abs(coneAxis.z) < 0.999
            ? vec3(0.0, 0.0, 1.0)
            : vec3(1.0, 0.0, 0.0);


    vec3 tangent =
        normalize(
            cross(
                referenceAxis,
                coneAxis
            )
        );


    vec3 bitangent =
        cross(
            coneAxis,
            tangent
        );


    sampledDirection =
        normalize(
            tangent *
                (
                    cos(phi) *
                    sinTheta
                ) +
            bitangent *
                (
                    sin(phi) *
                    sinTheta
                ) +
            coneAxis *
                cosTheta
        );


    directionalPdf =
        1.0 /
        max(
            2.0 *
                PI *
                (
                    1.0 -
                    cosThetaMax
                ),
            G2B_LOCAL_GUIDE_EPSILON
        );


    return
        true;
}


float g2bSphereGuideDirectionalPdf(
    vec3 surfacePos,
    vec3 rayDirection,
    vec3 emitterBlockPos
)
{
    vec3 sphereCenter =
        emitterBlockPos +
        vec3(0.5);


    vec3 toCenter =
        sphereCenter -
        surfacePos;


    float centerDistanceSquared =
        dot(
            toCenter,
            toCenter
        );


    float radiusSquared =
        LOCAL_LIGHT_POINT_SPHERE_RADIUS *
        LOCAL_LIGHT_POINT_SPHERE_RADIUS;


    if(
        centerDistanceSquared <=
        radiusSquared +
            G2B_LOCAL_GUIDE_EPSILON
    )
    {
        return
            0.0;
    }


    vec3 originFromCenter =
        surfacePos -
        sphereCenter;


    float b =
        dot(
            originFromCenter,
            rayDirection
        );


    float c =
        dot(
            originFromCenter,
            originFromCenter
        ) -
        radiusSquared;


    float discriminant =
        b * b -
        c;


    if(discriminant < 0.0)
    {
        return
            0.0;
    }


    float root =
        sqrt(
            discriminant
        );


    float farIntersection =
        -b +
        root;


    if(farIntersection <= 0.0)
    {
        return
            0.0;
    }


    float cosThetaMax =
        sqrt(
            max(
                1.0 -
                    radiusSquared /
                    centerDistanceSquared,
                0.0
            )
        );


    return
        1.0 /
        max(
            2.0 *
                PI *
                (
                    1.0 -
                    cosThetaMax
                ),
            G2B_LOCAL_GUIDE_EPSILON
        );
}


bool g2bSampleCubeGuideDirection(
    vec3 surfacePos,
    vec3 emitterBlockPos,
    inout uint rngState,
    out vec3 sampledDirection,
    out float directionalPdf
)
{
    vec3 emitterCenter =
        emitterBlockPos +
        vec3(0.5);


    vec3 receiverOffset =
        surfacePos -
        emitterCenter;


    vec3 faceWeights =
        abs(receiverOffset) +
        vec3(1.0e-4);


    float faceWeightSum =
        faceWeights.x +
        faceWeights.y +
        faceWeights.z;


    float faceSelector =
        rand(rngState) *
        faceWeightSum;


    float usableSide =
        1.0 -
        2.0 *
        G2B_CUBE_GUIDE_INSET;


    float u =
        G2B_CUBE_GUIDE_INSET +
        rand(rngState) *
        usableSide;


    float v =
        G2B_CUBE_GUIDE_INSET +
        rand(rngState) *
        usableSide;


    vec3 samplePos =
        emitterCenter;


    vec3 emitterNormal =
        vec3(0.0);


    float faceProbability =
        1.0;


    if(faceSelector < faceWeights.x)
    {
        bool positiveFace =
            receiverOffset.x >= 0.0;


        faceProbability =
            faceWeights.x /
            faceWeightSum;


        samplePos =
            vec3(
                emitterBlockPos.x +
                    (
                        positiveFace
                            ? 1.0
                            : 0.0
                    ),
                emitterBlockPos.y + u,
                emitterBlockPos.z + v
            );


        emitterNormal =
            vec3(
                positiveFace
                    ? 1.0
                    : -1.0,
                0.0,
                0.0
            );
    }
    else if(
        faceSelector <
        faceWeights.x +
            faceWeights.y
    )
    {
        bool positiveFace =
            receiverOffset.y >= 0.0;


        faceProbability =
            faceWeights.y /
            faceWeightSum;


        samplePos =
            vec3(
                emitterBlockPos.x + u,
                emitterBlockPos.y +
                    (
                        positiveFace
                            ? 1.0
                            : 0.0
                    ),
                emitterBlockPos.z + v
            );


        emitterNormal =
            vec3(
                0.0,
                positiveFace
                    ? 1.0
                    : -1.0,
                0.0
            );
    }
    else
    {
        bool positiveFace =
            receiverOffset.z >= 0.0;


        faceProbability =
            faceWeights.z /
            faceWeightSum;


        samplePos =
            vec3(
                emitterBlockPos.x + u,
                emitterBlockPos.y + v,
                emitterBlockPos.z +
                    (
                        positiveFace
                            ? 1.0
                            : 0.0
                    )
            );


        emitterNormal =
            vec3(
                0.0,
                0.0,
                positiveFace
                    ? 1.0
                    : -1.0
            );
    }


    vec3 toSample =
        samplePos -
        surfacePos;


    float sampleDistanceSquared =
        dot(
            toSample,
            toSample
        );


    if(
        sampleDistanceSquared <=
        G2B_LOCAL_GUIDE_EPSILON
    )
    {
        sampledDirection =
            vec3(0.0, 1.0, 0.0);

        directionalPdf =
            0.0;

        return
            false;
    }


    float sampleDistance =
        sqrt(
            sampleDistanceSquared
        );


    sampledDirection =
        toSample /
        sampleDistance;


    float emitterFacing =
        max(
            dot(
                emitterNormal,
                -sampledDirection
            ),
            0.0
        );


    if(
        emitterFacing <=
        G2B_LOCAL_GUIDE_EPSILON
    )
    {
        directionalPdf =
            0.0;

        return
            false;
    }


    float faceArea =
        usableSide *
        usableSide;


    directionalPdf =
        faceProbability *
        sampleDistanceSquared /
        max(
            emitterFacing *
                faceArea,
            G2B_LOCAL_GUIDE_EPSILON
        );


    return
        true;
}


float g2bCubeGuideDirectionalPdf(
    vec3 surfacePos,
    vec3 rayDirection,
    vec3 emitterBlockPos
)
{
    vec3 boxMin =
        emitterBlockPos;


    vec3 boxMax =
        emitterBlockPos +
        vec3(1.0);


    vec3 safeDirection =
        vec3(
            abs(rayDirection.x) > 1.0e-8
                ? rayDirection.x
                : (
                    rayDirection.x >= 0.0
                        ? 1.0e-8
                        : -1.0e-8
                ),
            abs(rayDirection.y) > 1.0e-8
                ? rayDirection.y
                : (
                    rayDirection.y >= 0.0
                        ? 1.0e-8
                        : -1.0e-8
                ),
            abs(rayDirection.z) > 1.0e-8
                ? rayDirection.z
                : (
                    rayDirection.z >= 0.0
                        ? 1.0e-8
                        : -1.0e-8
                )
        );


    vec3 t0 =
        (
            boxMin -
            surfacePos
        ) /
        safeDirection;


    vec3 t1 =
        (
            boxMax -
            surfacePos
        ) /
        safeDirection;


    vec3 nearByAxis =
        min(
            t0,
            t1
        );


    vec3 farByAxis =
        max(
            t0,
            t1
        );


    float nearDistance =
        max(
            max(
                nearByAxis.x,
                nearByAxis.y
            ),
            nearByAxis.z
        );


    float farDistance =
        min(
            min(
                farByAxis.x,
                farByAxis.y
            ),
            farByAxis.z
        );


    if(
        farDistance <
            max(
                nearDistance,
                0.0
            ) ||
        nearDistance <= 0.0
    )
    {
        return
            0.0;
    }


    int hitAxis =
        0;


    if(nearByAxis.y > nearByAxis.x)
    {
        hitAxis =
            1;
    }


    if(
        nearByAxis.z >
        nearByAxis[hitAxis]
    )
    {
        hitAxis =
            2;
    }


    vec3 hitPoint =
        surfacePos +
        rayDirection *
        nearDistance;


    float inset =
        G2B_CUBE_GUIDE_INSET;


    bool insideSampledFace =
        true;


    if(hitAxis == 0)
    {
        insideSampledFace =
            hitPoint.y >= boxMin.y + inset &&
            hitPoint.y <= boxMax.y - inset &&
            hitPoint.z >= boxMin.z + inset &&
            hitPoint.z <= boxMax.z - inset;
    }
    else if(hitAxis == 1)
    {
        insideSampledFace =
            hitPoint.x >= boxMin.x + inset &&
            hitPoint.x <= boxMax.x - inset &&
            hitPoint.z >= boxMin.z + inset &&
            hitPoint.z <= boxMax.z - inset;
    }
    else
    {
        insideSampledFace =
            hitPoint.x >= boxMin.x + inset &&
            hitPoint.x <= boxMax.x - inset &&
            hitPoint.y >= boxMin.y + inset &&
            hitPoint.y <= boxMax.y - inset;
    }


    if(!insideSampledFace)
    {
        return
            0.0;
    }


    vec3 receiverOffset =
        surfacePos -
        (
            emitterBlockPos +
            vec3(0.5)
        );


    vec3 faceWeights =
        abs(receiverOffset) +
        vec3(1.0e-4);


    float faceWeightSum =
        faceWeights.x +
        faceWeights.y +
        faceWeights.z;


    float faceProbability =
        faceWeights[hitAxis] /
        faceWeightSum;


    float emitterFacing =
        abs(
            rayDirection[hitAxis]
        );


    float usableSide =
        1.0 -
        2.0 *
        inset;


    float faceArea =
        usableSide *
        usableSide;


    return
        faceProbability *
        nearDistance *
        nearDistance /
        max(
            emitterFacing *
                faceArea,
            G2B_LOCAL_GUIDE_EPSILON
        );
}


float g2bLocalGuideDirectionalPdf(
    vec3 surfacePos,
    vec3 surfaceNormal,
    vec3 rayDirection,
    float guideWeightSum
)
{
    if(
        guideWeightSum <=
        G2B_LOCAL_GUIDE_EPSILON
    )
    {
        return
            0.0;
    }


    float mixturePdf =
        0.0;


    uint lightCount =
        localLightBuffer.header.x;


    ivec3 centerCell =
        localLightGridCellCoord(
            surfacePos
        );

    uint packedIndexBase =
        localLightGridPackedIndexBase();


    for(int cellZ = -1; cellZ <= 1; ++cellZ)
    {
        for(int cellY = -1; cellY <= 1; ++cellY)
        {
            for(int cellX = -1; cellX <= 1; ++cellX)
            {
                uint firstLightIndex =
                    0u;

                uint cellLightCount =
                    0u;


                if(
                    !localLightGridLookupCell(
                        centerCell +
                        ivec3(
                            cellX,
                            cellY,
                            cellZ
                        ),
                        firstLightIndex,
                        cellLightCount
                    )
                )
                {
                    continue;
                }


                for(
                    uint candidateOffset = 0u;
                    candidateOffset < cellLightCount;
                    ++candidateOffset
                )
                {
                    uint lightIndex =
                        localLightGridBuffer.words[
                            packedIndexBase +
                            firstLightIndex +
                            candidateOffset
                        ];


                    if(lightIndex >= lightCount)
                    {
                        continue;
                    }


                    LocalLightGPU light =
                        localLightBuffer.lights[
                            lightIndex
                        ];


                    float selectionWeight =
                        g2bLocalGuideSelectionWeight(
                            surfacePos,
                            surfaceNormal,
                            light
                        );


                    if(selectionWeight <= 0.0)
                    {
                        continue;
                    }


                    float shapePdf =
                        isPointLikeLocalLightType(
                            light.meta.x
                        )
                            ? g2bSphereGuideDirectionalPdf(
                                surfacePos,
                                rayDirection,
                                light.worldPosEmission.xyz
                            )
                            : g2bCubeGuideDirectionalPdf(
                                surfacePos,
                                rayDirection,
                                light.worldPosEmission.xyz
                            );


                    mixturePdf +=
                        (
                            selectionWeight /
                            guideWeightSum
                        ) *
                        shapePdf;
                }
            }
        }
    }


    return
        mixturePdf;
}


bool g2bSampleLocalGuideDirection(
    vec3 surfacePos,
    vec3 surfaceNormal,
    float guideWeightSum,
    inout uint rngState,
    out vec3 sampledDirection,
    out float directionalPdf
)
{
    uint lightCount =
        localLightBuffer.header.x;


    if(
        lightCount == 0u ||
        guideWeightSum <=
            G2B_LOCAL_GUIDE_EPSILON
    )
    {
        sampledDirection =
            vec3(0.0, 1.0, 0.0);

        directionalPdf =
            0.0;

        return
            false;
    }


    float selectionTarget =
        rand(rngState) *
        guideWeightSum;


    float accumulatedWeight =
        0.0;


    uint selectedIndex =
        0u;


    bool hasEligibleLight =
        false;


    bool selected =
        false;


    ivec3 centerCell =
        localLightGridCellCoord(
            surfacePos
        );

    uint packedIndexBase =
        localLightGridPackedIndexBase();


    for(int cellZ = -1; cellZ <= 1; ++cellZ)
    {
        for(int cellY = -1; cellY <= 1; ++cellY)
        {
            for(int cellX = -1; cellX <= 1; ++cellX)
            {
                uint firstLightIndex =
                    0u;

                uint cellLightCount =
                    0u;


                if(
                    !localLightGridLookupCell(
                        centerCell +
                        ivec3(
                            cellX,
                            cellY,
                            cellZ
                        ),
                        firstLightIndex,
                        cellLightCount
                    )
                )
                {
                    continue;
                }


                for(
                    uint candidateOffset = 0u;
                    candidateOffset < cellLightCount;
                    ++candidateOffset
                )
                {
                    uint lightIndex =
                        localLightGridBuffer.words[
                            packedIndexBase +
                            firstLightIndex +
                            candidateOffset
                        ];


                    if(lightIndex >= lightCount)
                    {
                        continue;
                    }


                    float selectionWeight =
                        g2bLocalGuideSelectionWeight(
                            surfacePos,
                            surfaceNormal,
                            localLightBuffer.lights[
                                lightIndex
                            ]
                        );


                    if(selectionWeight <= 0.0)
                    {
                        continue;
                    }


                    hasEligibleLight =
                        true;


                    selectedIndex =
                        lightIndex;


                    accumulatedWeight +=
                        selectionWeight;


                    if(selectionTarget <= accumulatedWeight)
                    {
                        selected =
                            true;

                        break;
                    }
                }


                if(selected)
                {
                    break;
                }
            }


            if(selected)
            {
                break;
            }
        }


        if(selected)
        {
            break;
        }
    }


    if(!hasEligibleLight)
    {
        sampledDirection =
            vec3(0.0, 1.0, 0.0);

        directionalPdf =
            0.0;

        return
            false;
    }


    // Floating-point accumulation can place the target a few ULPs
    // above the final sum.  selectedIndex already stores the final
    // eligible light, which is the correct stable fallback.
    if(!selected)
    {
        selected =
            true;
    }


    LocalLightGPU selectedLight =
        localLightBuffer.lights[selectedIndex];


    float conditionalPdf =
        0.0;


    bool sampleValid =
        false;


    if(
        isPointLikeLocalLightType(
            selectedLight.meta.x
        )
    )
    {
        sampleValid =
            g2bSampleSphereGuideDirection(
                surfacePos,
                selectedLight.worldPosEmission.xyz,
                rngState,
                sampledDirection,
                conditionalPdf
            );
    }
    else
    {
        sampleValid =
            g2bSampleCubeGuideDirection(
                surfacePos,
                selectedLight.worldPosEmission.xyz,
                rngState,
                sampledDirection,
                conditionalPdf
            );
    }


    if(!sampleValid)
    {
        directionalPdf =
            0.0;

        return
            false;
    }


    directionalPdf =
        g2bLocalGuideDirectionalPdf(
            surfacePos,
            surfaceNormal,
            sampledDirection,
            guideWeightSum
        );


    return
        directionalPdf >
        G2B_LOCAL_GUIDE_EPSILON;
}


void g2bSampleDiffuseDirectionMIS(
    vec3 surfacePos,
    vec3 surfaceNormal,
    inout uint rngState,
    out vec3 sampledDirection,
    out float bsdfToMixtureWeight
)
{
    vec3 N =
        normalize(
            surfaceNormal
        );


    if(
        !LL_P3_ENABLE_G2B_LOCAL_GUIDE ||
        perfL10DisableG2bLocalGuide()
    )
    {
        sampledDirection =
            sampleHemisphereCosine(
                N,
                rngState
            );

        bsdfToMixtureWeight =
            1.0;

        return;
    }


    float guideWeightSum =
        g2bLocalGuideWeightSum(
            surfacePos,
            N
        );


    float guideProbability =
        guideWeightSum >
            G2B_LOCAL_GUIDE_EPSILON
                ? G2B_LOCAL_GUIDE_PROBABILITY
                : 0.0;


    bool chooseGuide =
        guideProbability > 0.0 &&
        rand(rngState) <
            guideProbability;


    float sampledGuidePdf =
        0.0;


    if(chooseGuide)
    {
        bool guideSampleValid =
            g2bSampleLocalGuideDirection(
                surfacePos,
                N,
                guideWeightSum,
                rngState,
                sampledDirection,
                sampledGuidePdf
            );


        if(!guideSampleValid)
        {
            guideProbability =
                0.0;

            sampledDirection =
                sampleHemisphereCosine(
                    N,
                    rngState
                );
        }
    }
    else
    {
        sampledDirection =
            sampleHemisphereCosine(
                N,
                rngState
            );
    }


    float NdotDirection =
        max(
            dot(
                N,
                sampledDirection
            ),
            0.0
        );


    float bsdfPdf =
        NdotDirection /
        PI;


    float lightPdf =
        0.0;


    if(guideProbability > 0.0)
    {
        lightPdf =
            chooseGuide
                ? sampledGuidePdf
                : g2bLocalGuideDirectionalPdf(
                    surfacePos,
                    N,
                    sampledDirection,
                    guideWeightSum
                );
    }


    float mixturePdf =
        (
            1.0 -
            guideProbability
        ) *
        bsdfPdf +
        guideProbability *
        lightPdf;


    bsdfToMixtureWeight =
        mixturePdf >
            G2B_LOCAL_GUIDE_EPSILON
                ? bsdfPdf /
                    mixturePdf
                : 0.0;
}


vec3 evaluatePrimaryLocalLights(
    vec3 hitPos,
    vec3 hitNormal,
    vec3 viewDir,
    vec3 hitAlbedo,
    float hitRoughness,
    int hitF0MetalCode,
    float primaryDistance,
    out vec3 emitterRadiance
)
{
    emitterRadiance =
        vec3(0.0);


    int activeLightCount =
        1;


    int areaSampleCount =
        clamp(int(cam.perfSecondary.y), 1, 2); // user "局部光区域采样"


    // LL-P3.1 primary budget:
    // - exactly one highest-scored local emitter;
    // - preserve the confirmed two L7 area samples in the near field;
    // - use one area sample from 16 blocks onward.
    if(primaryDistance >= 16.0)
    {
        areaSampleCount =
            1;
    }

    uint lightCount =
        localLightBuffer.header.x;


    if(lightCount == 0u)
    {
        return
            vec3(0.0);
    }


    vec3 N =
        normalize(
            hitNormal
        );


    vec3 V =
        normalize(
            viewDir
        );


    float NdotV =
        max(
            dot(
                N,
                V
            ),
            0.0
        );


    if(NdotV <= 0.0)
    {
        return
            vec3(0.0);
    }


    // -------------------------------------------------
    // Keep the strongest nearby contributor. No shadow ray is fired
    // during this candidate pass; Binding 18 restricts it to the only
    // grid cells that can contain an emitter within its 30-block range.
    // -------------------------------------------------

    uint selectedIndex[MAX_PRIMARY_LOCAL_LIGHTS];

    float selectedScore[MAX_PRIMARY_LOCAL_LIGHTS];
    for(
    int slot = 0;
    slot < MAX_PRIMARY_LOCAL_LIGHTS;
    ++slot
)
{
    selectedIndex[slot] =
        0u;

    selectedScore[slot] =
        -1.0;
}


    ivec3 centerCell =
        localLightGridCellCoord(
            hitPos
        );

    int minCellX =
        localLightGridNeighborMinOffset(
            hitPos.x
        );

    int maxCellX =
        localLightGridNeighborMaxOffset(
            hitPos.x
        );

    int minCellY =
        localLightGridNeighborMinOffset(
            hitPos.y
        );

    int maxCellY =
        localLightGridNeighborMaxOffset(
            hitPos.y
        );

    int minCellZ =
        localLightGridNeighborMinOffset(
            hitPos.z
        );

    int maxCellZ =
        localLightGridNeighborMaxOffset(
            hitPos.z
        );

    uint packedIndexBase =
        localLightGridPackedIndexBase();


    for(int cellZ = minCellZ; cellZ <= maxCellZ; ++cellZ)
    {
        for(int cellY = minCellY; cellY <= maxCellY; ++cellY)
        {
            for(int cellX = minCellX; cellX <= maxCellX; ++cellX)
            {
                uint firstLightIndex =
                    0u;

                uint cellLightCount =
                    0u;


                if(
                    !localLightGridLookupCell(
                        centerCell +
                        ivec3(
                            cellX,
                            cellY,
                            cellZ
                        ),
                        firstLightIndex,
                        cellLightCount
                    )
                )
                {
                    continue;
                }


                for(
                    uint candidateOffset = 0u;
                    candidateOffset < cellLightCount;
                    ++candidateOffset
                )
                {
                    uint lightIndex =
                        localLightGridBuffer.words[
                            packedIndexBase +
                            firstLightIndex +
                            candidateOffset
                        ];


                    if(lightIndex >= lightCount)
                    {
                        continue;
                    }


                    LocalLightGPU candidateLight =
                        localLightBuffer.lights[
                            lightIndex
                        ];

                    vec4 worldPosEmission =
                        candidateLight.worldPosEmission;


                    emitterRadiance =
                        max(
                            emitterRadiance,
                            evaluateLocalEmitterCandidateRadiance(
                                hitPos,
                                -V,
                                hitAlbedo,
                                candidateLight
                            )
                        );


                    float score =
                        localLightApproxScore(
                            hitPos,
                            N,
                            worldPosEmission
                        );


                    if(score <= 0.0)
                    {
                        continue;
                    }


                    if(score > selectedScore[0])
                    {
                        selectedScore[0] =
                            score;

                        selectedIndex[0] =
                            lightIndex;
                    }
                }
            }
        }
    }




    vec3 F0 =
        decodeBaseF0(
            hitF0MetalCode,
            hitAlbedo
        );


    float metallic =
        decodeMetallicFromCode(
            hitF0MetalCode
        );


    float roughness =
        clamp(
            hitRoughness,
            0.04,
            1.0
        );


    vec3 accumulatedLocalLight =
        vec3(0.0);


    // -------------------------------------------------
    // L7.1 B mode:
    // 2 real cube-surface visibility rays per selected light.
    // Up to 4 selected lights -> at most 8 rays / pixel.
    // -------------------------------------------------

for(
    int slot = 0;
    slot < activeLightCount;
    ++slot
)
{
    if(selectedScore[slot] <= 0.0)
    {
        break;
    }


LocalLightGPU selectedLight =
    localLightBuffer
        .lights[
            selectedIndex[slot]
        ];


vec4 worldPosEmission =
    selectedLight
        .worldPosEmission;


uint typeCode =
    selectedLight
        .meta.x;


float emissionLevel =
            clamp(
                worldPosEmission.w,
                1.0,
                15.0
            );


        vec3 lightCenter =
            worldPosEmission.xyz +
            vec3(0.5);


        vec3 centerToLight =
            lightCenter -
            hitPos;


        float centerDistanceSquared =
            dot(
                centerToLight,
                centerToLight
            );


        if(centerDistanceSquared <= 1.0e-6)
        {
            continue;
        }


        float centerDistance =
            sqrt(
                centerDistanceSquared
            );


        float centerRangeFade =
            localLightRangeFade(
                centerDistance,
                emissionLevel
            );


        if(centerRangeFade <= 0.0)
        {
            continue;
        }


        float emission01 =
            emissionLevel /
            15.0;


        vec3 localLightColor =
            decodeLocalLightColor(
                typeCode
            );


        bool pointLikeEmitter =
            isPointLikeLocalLightType(
                typeCode
            );


        vec3 integratedAreaLight =
            vec3(0.0);


        // =================================================
        // L7.1 / G1 - Effective 2.0x2.0 cube-face emitter
        //
        // Exactly two points are sampled on visible effective
        // cube-face areas.  Each sample independently evaluates:
        //
        //   emitter surface point
        //   distance attenuation
        //   receiver NdotL
        //   emitter-facing cosine
        //   colored glass visibility
        //   GGX + diffuse response
        //
        // This is what creates geometric soft shadows:
        // blocker/source/receiver distances now change penumbra
        // width naturally instead of applying a fixed blur radius.
        // =================================================

for(
    int areaSample = 0;
    areaSample <
        areaSampleCount;
    ++areaSample
)
        {
            vec3 emitterSurfaceNormal =
                vec3(0.0);


            float faceSelectionProbability =
                1.0;


            vec3 sampleLightPos =
                vec3(0.0);


            if(pointLikeEmitter)
            {
                sampleLightPos =
                    sampleLocalLightPointSphereSurface(
                        worldPosEmission.xyz,
                        hitPos,
                        slot,
                        areaSample
                    );
            }
            else
            {
                sampleLightPos =
                    sampleLocalLightCubeSurface(
                        worldPosEmission.xyz,
                        hitPos,
                        slot,
                        areaSample,
                        emitterSurfaceNormal,
                        faceSelectionProbability
                    );
            }


            vec3 sampleToLight =
                sampleLightPos -
                hitPos;


            float sampleDistanceSquared =
                dot(
                    sampleToLight,
                    sampleToLight
                );


            if(sampleDistanceSquared <= 1.0e-8)
            {
                continue;
            }


            float sampleDistance =
                sqrt(
                    sampleDistanceSquared
                );


            float sampleRangeFade =
                localLightRangeFade(
                    sampleDistance,
                    emissionLevel
                );


            if(sampleRangeFade <= 0.0)
            {
                continue;
            }


            vec3 sampleDirection =
                sampleToLight /
                sampleDistance;


            float geometricNdotL =
                max(
                    dot(
                        N,
                        sampleDirection
                    ),
                    0.0
                );


            if(geometricNdotL <= 0.0)
            {
                continue;
            }


            float sourceAngularWeight =
                LOCAL_LIGHT_POINT_SPHERE_PROJECTED_AREA;


            // The sphere was sampled over its projected disk, so its
            // exact projected area is the Monte-Carlo source weight.
            // The cube face was importance-selected by projected axis
            // weight, so compensate that face-selection probability.
            if(!pointLikeEmitter)
            {
                float emitterFacing =
                    max(
                        dot(
                            emitterSurfaceNormal,
                            -sampleDirection
                        ),
                        0.0
                    );


                if(emitterFacing <= 0.0)
                {
                    continue;
                }


                sourceAngularWeight =
                    emitterFacing /
                    max(
                        faceSelectionProbability,
                        1.0e-4
                    );
            }


            float shadowMaxDistance =
                sampleDistance -
                LOCAL_LIGHT_CUBE_RAY_END_EPSILON;


            bool sampleVisible =
                true;


            vec3 sampleTransmittance =
                vec3(1.0);


            if(shadowMaxDistance > 0.03)
            {
                payload.hitDistance =
                    1.0;

                payload.albedo =
                    vec3(1.0);

                payload.parallaxRayTravel =
                    0.0;

                payload.state = makeTraceState(RT_PURPOSE_GLASS_VISIBILITY);


                traceRayEXT(
                    topLevelAS,

                    gl_RayFlagsTerminateOnFirstHitEXT |
                    gl_RayFlagsSkipClosestHitShaderEXT,

                    0xff,

                    0,
                    0,
                    0,

                    hitPos +
                        N * 0.035,

                    0.02,

                    sampleDirection,

                    shadowMaxDistance,

                    0
                );


                sampleVisible =
                    payload.hitDistance <
                    0.0;


                if(sampleVisible)
                {
                    sampleTransmittance =
                        clamp(
                            payload.albedo,
                            vec3(0.0),
                            vec3(1.0)
                        );
                }
            }


            if(!sampleVisible)
            {
                continue;
            }


            // Physical receiver cosine.  The old sqrt blend lifted
            // grazing angles and produced the visible floor halo.
            float softDiffuseNdotL =
                geometricNdotL;


            float localSpecularRoughness =
                max(
                    roughness,
                    LOCAL_LIGHT_L7_MIN_SPECULAR_ROUGHNESS
                );


            vec3 H =
                normalize(
                    V +
                    sampleDirection
                );


            float VdotH =
                max(
                    dot(
                        V,
                        H
                    ),
                    0.0
                );


            vec3 F =
                fresnelSchlick(
                    VdotH,
                    F0
                );


            float D =
                distributionGGX(
                    N,
                    H,
                    localSpecularRoughness
                );


            float G =
                geometrySmith(
                    N,
                    V,
                    sampleDirection,
                    localSpecularRoughness
                );


            vec3 specularBRDF =
                (
                    D *
                    G *
                    F
                ) /
                max(
                    4.0 *
                    NdotV *
                    geometricNdotL,
                    1.0e-4
                );


            vec3 kD =
                (
                    vec3(1.0) -
                    F
                ) *
                (
                    1.0 -
                    metallic
                );


            vec3 diffuseTerm =
                kD *
                hitAlbedo *
                softDiffuseNdotL *
                LOCAL_LIGHT_L7_DIFFUSE_SCALE;


            vec3 specularTerm =
                specularBRDF *
                geometricNdotL *
                LOCAL_LIGHT_L7_SPECULAR_SCALE;


float distanceAttenuation =
    localLightDistanceAttenuation(
        sampleDistance
    );


            // emitterFacing is the source-side cosine term of
            // the sampled physical cube face.
            float radianceScale =
    3.2 *
    LOCAL_LIGHT_L7_RADIANCE_SCALE *
    emission01 *
    distanceAttenuation *
    sampleRangeFade *
    sourceAngularWeight;


            vec3 sampleRadiance =
                localLightColor *
                radianceScale;


            integratedAreaLight +=
                sampleRadiance *
                sampleTransmittance *
                (
                    diffuseTerm +
                    specularTerm
                );
        }


        accumulatedLocalLight +=
integratedAreaLight /
float(
    areaSampleCount
);
    }


    return
        accumulatedLocalLight;
}



// =====================================================
// T11 - Deterministic scene reflection for glass
//
// Exactly one first-surface reflection ray.  It follows the geometric mirror
// direction and returns either the real opaque-scene radiance at its first
// hit, or the existing miss-shader sky radiance.  Water and later transparent
// hits deliberately contribute nothing here.
// =====================================================

vec3 traceGlassSceneReflectionOneRay(
    vec3 glassSurfacePosition,
    vec3 glassNormal,
    vec3 viewDir,
    vec3 sunDirection
)
{
    vec3 N = normalize(glassNormal);
    vec3 V = normalize(viewDir);
    float NdotV = max(dot(N, V), 0.0);
    if(NdotV <= 0.0)
    {
        return vec3(0.0);
    }

    vec3 reflectionDirection =
        reflect(-V, N);

    payload.hitDistance = 1.0;
    payload.state = makeTraceState(RT_PURPOSE_FULL);

    traceRayEXT(
        topLevelAS,
        gl_RayFlagsNoneEXT,
        0xff,
        0,
        0,
        0,
        glassSurfacePosition + N * 0.035,
        0.02,
        reflectionDirection,
        10000.0,
        0
    );

    // Export the real reflection hit distance for DLSS RR specular
    // reprojection.  Opaque surfaces already report glossySpecularHitDistance;
    // glass must do the same or RR treats the pane's reflection as a
    // sky/infinity (65504) reflection and blurs it across frames.  A miss
    // (sky reflection) legitimately stays at 65504.
    rrGlassReflectionHitDistance =
        payload.hitDistance >= 0.0
            ? payload.hitDistance
            : 65504.0;

    vec3 reflectedSceneRadiance =
        vec3(0.0);

    if(payload.hitDistance < 0.0)
    {
        // The common ray miss shader already returns the renderer's real
        // sky radiance in payload.albedo.  Keep it as environment reflection.
        reflectedSceneRadiance =
            payload.albedo;
    }
    else if(getLegacyMaterialId(payload.state) <= 0.5)
    {
        vec3 reflectionHitPos =
            glassSurfacePosition +
            N * 0.035 +
            reflectionDirection *
            payload.hitDistance;

        vec3 reflectionHitNormal =
            payload.normal;

        vec3 reflectionHitAlbedo =
            payload.albedo;

        vec3 reflectionHitEmission =
            payload.emission +
            evaluateVLIEmitterRadianceAtHit(
                reflectionHitPos,
                reflectionHitNormal,
                reflectionHitAlbedo
            );

        reflectedSceneRadiance =
            evaluateOpaqueSurfaceRadiance(
                reflectionHitPos,
                reflectionHitNormal,
                -reflectionDirection,
                reflectionHitAlbedo,
                payload.roughness,
                payload.f0Metal,
                reflectionHitEmission,
                payload.pomSelfShadow,
                sunDirection
            ) +
            evaluateVPTExactFaceDirectLighting(
                reflectionHitPos,
                reflectionHitNormal,
                reflectionHitAlbedo
            ) +
            reflectionHitAlbedo *
            clamp(cam.cameraParams.w, 0.0, 1.0);
    }

    // Fresnel weighting lives at the call site now: the Orion thin-sheet
    // reflection factor replaces the fixed F0 environment-BRDF weight.
    return reflectedSceneRadiance;
}



// =====================================================
// L7.3 B - Secondary diffuse Local Light GI
//
// Budget per opaque secondary hit:
//   - scan the existing Local Light SSBO,
//   - keep the strongest 2 approximate contributors,
//   - 1 real 2.0x2.0 area sample per selected light,
//   - at most 2 visibility rays total,
//   - diffuse PBR response only (no secondary GGX specular).
//
// The result is outgoing radiance at this secondary surface.
// The caller multiplies it by currentThroughput before adding it
// to indirectLight.
// =====================================================

vec3 evaluateSecondaryDiffuseLocalLights(
    vec3 hitPos,
    vec3 hitNormal,
    vec3 viewDir,
    vec3 hitAlbedo,
    float hitF0Metal
)
{
    uint lightCount =
        localLightBuffer.header.x;


    if(lightCount == 0u)
    {
        return
            vec3(0.0);
    }


    vec3 N =
        normalize(
            hitNormal
        );


    vec3 V =
        normalize(
            viewDir
        );


    float NdotV =
        max(
            dot(
                N,
                V
            ),
            0.0
        );


    if(NdotV <= 0.0)
    {
        return
            vec3(0.0);
    }


    // -------------------------------------------------
    // Select only the strongest two local contributors.
    // No visibility ray is fired during this scan.
    // -------------------------------------------------

    uint selectedIndex[
        MAX_SECONDARY_LOCAL_LIGHTS
    ];


    float selectedScore[
        MAX_SECONDARY_LOCAL_LIGHTS
    ];


    for(
        int slot = 0;
        slot < MAX_SECONDARY_LOCAL_LIGHTS;
        ++slot
    )
    {
        selectedIndex[slot] =
            0u;

        selectedScore[slot] =
            -1.0;
    }


    // Probe slightly inside the currently hit block.
    // If this secondary surface itself belongs to an emitter,
    // nextEmission already carries its self-radiance, so do not
    // add a local-light self-contribution here.
    vec3 emitterProbePos =
        hitPos -
        N * 0.02;


    for(
        uint lightIndex = 0u;
        lightIndex < lightCount;
        ++lightIndex
    )
    {
        LocalLightGPU candidateLight =
            localLightBuffer
                .lights[lightIndex];


        vec4 candidateWorldPosEmission =
            candidateLight
                .worldPosEmission;


        vec3 emitterBlockMin =
            candidateWorldPosEmission.xyz -
            vec3(0.001);


        vec3 emitterBlockMax =
            candidateWorldPosEmission.xyz +
            vec3(1.001);


        bool hitThisEmitter =
            all(
                greaterThanEqual(
                    emitterProbePos,
                    emitterBlockMin
                )
            ) &&
            all(
                lessThanEqual(
                    emitterProbePos,
                    emitterBlockMax
                )
            );


        if(hitThisEmitter)
        {
            continue;
        }


        float score =
            localLightApproxScore(
                hitPos,
                N,
                candidateWorldPosEmission
            );


        if(score <= 0.0)
        {
            continue;
        }


        for(
            int slot = 0;
            slot < MAX_SECONDARY_LOCAL_LIGHTS;
            ++slot
        )
        {
            if(score <= selectedScore[slot])
            {
                continue;
            }


            for(
                int shift =
                    MAX_SECONDARY_LOCAL_LIGHTS - 1;
                shift > slot;
                --shift
            )
            {
                selectedScore[shift] =
                    selectedScore[
                        shift - 1
                    ];

                selectedIndex[shift] =
                    selectedIndex[
                        shift - 1
                    ];
            }


            selectedScore[slot] =
                score;

            selectedIndex[slot] =
                lightIndex;

            break;
        }
    }


    int f0MetalCode =
        decodeF0MetalCode(
            hitF0Metal
        );


    float metallic =
        decodeMetallicFromCode(
            f0MetalCode
        );


    // Secondary diffuse Local Light deliberately carries no
    // metallic diffuse energy.
    if(metallic >= 0.999)
    {
        return
            vec3(0.0);
    }


    vec3 F0 =
        decodeBaseF0(
            f0MetalCode,
            hitAlbedo
        );


    vec3 accumulatedSecondaryLocal =
        vec3(0.0);


    for(
        int slot = 0;
        slot < MAX_SECONDARY_LOCAL_LIGHTS;
        ++slot
    )
    {
        if(selectedScore[slot] <= 0.0)
        {
            continue;
        }


        LocalLightGPU selectedLight =
            localLightBuffer
                .lights[
                    selectedIndex[slot]
                ];


        vec4 worldPosEmission =
            selectedLight
                .worldPosEmission;


        uint typeCode =
            selectedLight.meta.x;


        float emissionLevel =
            clamp(
                worldPosEmission.w,
                1.0,
                15.0
            );


        vec3 emitterSurfaceNormal =
            vec3(0.0);


        float faceSelectionProbability =
            1.0;


        bool pointLikeEmitter =
            isPointLikeLocalLightType(
                typeCode
            );


        // B mode = exactly one source sample per light.
        vec3 sampleLightPos =
            vec3(0.0);


        if(pointLikeEmitter)
        {
            sampleLightPos =
                sampleLocalLightPointSphereSurface(
                    worldPosEmission.xyz,
                    hitPos,
                    slot,
                    0
                );
        }
        else
        {
            sampleLightPos =
                sampleLocalLightCubeSurface(
                    worldPosEmission.xyz,
                    hitPos,
                    slot,
                    0,
                    emitterSurfaceNormal,
                    faceSelectionProbability
                );
        }


        vec3 sampleToLight =
            sampleLightPos -
            hitPos;


        float sampleDistanceSquared =
            dot(
                sampleToLight,
                sampleToLight
            );


        if(sampleDistanceSquared <= 1.0e-8)
        {
            continue;
        }


        float sampleDistance =
            sqrt(
                sampleDistanceSquared
            );


        float sampleRangeFade =
            localLightRangeFade(
                sampleDistance,
                emissionLevel
            );


        if(sampleRangeFade <= 0.0)
        {
            continue;
        }


        vec3 L =
            sampleToLight /
            sampleDistance;


        float geometricNdotL =
            max(
                dot(
                    N,
                    L
                ),
                0.0
            );


        if(geometricNdotL <= 0.0)
        {
            continue;
        }


        float sourceAngularWeight =
            LOCAL_LIGHT_POINT_SPHERE_PROJECTED_AREA;


        if(!pointLikeEmitter)
        {
            float emitterFacing =
                max(
                    dot(
                        emitterSurfaceNormal,
                        -L
                    ),
                    0.0
                );


            if(emitterFacing <= 0.0)
            {
                continue;
            }


            sourceAngularWeight =
                emitterFacing /
                max(
                    faceSelectionProbability,
                    1.0e-4
                );
        }


        // -------------------------------------------------
        // One colored-glass-aware visibility ray.
        // -------------------------------------------------

        float shadowMaxDistance =
            sampleDistance -
            LOCAL_LIGHT_CUBE_RAY_END_EPSILON;


        bool visible =
            true;


        vec3 localShadowTransmittance =
            vec3(1.0);


        if(shadowMaxDistance > 0.03)
        {
            payload.hitDistance =
                1.0;

            payload.albedo =
                vec3(1.0);

            payload.parallaxRayTravel =
                0.0;

            payload.state = makeTraceState(RT_PURPOSE_GLASS_VISIBILITY);


            traceRayEXT(
                topLevelAS,

                gl_RayFlagsTerminateOnFirstHitEXT |
                gl_RayFlagsSkipClosestHitShaderEXT,

                0xff,

                0,
                0,
                0,

                hitPos +
                    N * 0.035,

                0.02,

                L,

                shadowMaxDistance,

                0
            );


            visible =
                payload.hitDistance <
                0.0;


            if(visible)
            {
                localShadowTransmittance =
                    clamp(
                        payload.albedo,
                        vec3(0.0),
                        vec3(1.0)
                    );
            }
        }


        if(!visible)
        {
            continue;
        }


        // -------------------------------------------------
        // Diffuse-only PBR response.
        //
        // Reuse the same Fresnel/energy split as the primary
        // local-light diffuse lobe, but deliberately skip GGX
        // specular in L7.3 B.
        // -------------------------------------------------

        vec3 H =
            normalize(
                V + L
            );


        float VdotH =
            max(
                dot(
                    V,
                    H
                ),
                0.0
            );


        vec3 F =
            fresnelSchlick(
                VdotH,
                F0
            );


        vec3 kD =
            (
                vec3(1.0) -
                F
            ) *
            (
                1.0 -
                metallic
            );


        float softDiffuseNdotL =
            geometricNdotL;


        vec3 diffuseTerm =
            kD *
            hitAlbedo *
            softDiffuseNdotL *
            LOCAL_LIGHT_L7_DIFFUSE_SCALE;


        float emission01 =
            emissionLevel /
            15.0;


float distanceAttenuation =
    localLightDistanceAttenuation(
        sampleDistance
    );

float radianceScale =
    3.2 *
    LOCAL_LIGHT_L7_RADIANCE_SCALE *
    emission01 *
    distanceAttenuation *
    sampleRangeFade *
    sourceAngularWeight;


        vec3 localRadiance =
            decodeLocalLightColor(
                typeCode
            ) *
            radianceScale;


        accumulatedSecondaryLocal +=
            localRadiance *
            localShadowTransmittance *
            diffuseTerm;
    }


    return
        accumulatedSecondaryLocal;
}


// =====================================================
// T9 LOW-COST - one-sample diffuse GI behind transparent glass
//
// Exactly ONE additional diffuse GI trace is used for a glass pixel.
// To keep the T9 budget conservative, a secondary opaque hit uses
// emission + configured ambient only; no secondary local-light scan
// and no secondary sun visibility ray are spawned here.
//
// A sky miss uses the real miss radiance, giving the receiver a
// physically meaningful environment bounce.
// =====================================================

vec3 traceTransparentLowCostGI(
    vec3 hitPos,
    vec3 hitNormal,
    vec3 hitAlbedo
)
{
    vec3 N =
        normalize(
            hitNormal
        );


    vec3 giDirection =
        sampleHemisphereCosine(
            N,
            seed
        );


    payload.hitDistance =
        1.0;

    payload.state = makeTraceState(RT_PURPOSE_FULL);


    traceRayEXT(
        topLevelAS,
        gl_RayFlagsNoneEXT,
        0xff,
        0,
        0,
        0,
        hitPos +
            N * 0.035,
        0.02,
        giDirection,
        10000.0,
        0
    );


    vec3 incomingRadiance =
        vec3(0.0);


    if(payload.hitDistance < 0.0)
    {
        incomingRadiance =
            payload.albedo;
    }
    else
    {
        float secondaryMaterialId =
            getLegacyMaterialId(payload.state);


        float ambientBaseBrightness =
            clamp(
                cam.cameraParams.w,
                0.0,
                1.0
            );


        if(secondaryMaterialId <= 0.5)
        {
            incomingRadiance =
                payload.emission +
                payload.albedo *
                ambientBaseBrightness;
        }
        else
        {
            // Water / glass secondary interfaces are intentionally
            // conservative here; recursive transparent GI is deferred
            // to the later multi-layer stage.
            incomingRadiance =
                payload.albedo *
                ambientBaseBrightness;
        }
    }


    // Match the project's established GI transport scale:
    // 0.7 throughput and 1.8 final indirect multiplier.
    return
        hitAlbedo *
        incomingRadiance *
        1.26;
}


vec3 evaluateOpaqueSurfaceRadiance(
    vec3 hitPos,
    vec3 hitNormal,
    vec3 viewDir,
    vec3 hitAlbedo,
    float hitRoughness,
    float hitF0Metal,
    vec3 hitEmission,
    float pomSelfShadow,
    vec3 sunDirection
)
{
    return
        hitEmission +
        evaluateDirectSunLighting(
            hitPos,
            hitNormal,
            viewDir,
            hitAlbedo,
            hitRoughness,
            hitF0Metal,
            pomSelfShadow,
            sunDirection
        );
}
// =====================================================
// T1-2 Generic translucent straight transmission
//
// Cost target:
// - exactly ONE additional trace for pixels whose primary hit
//   is generic translucent terrain;
// - any-hit skips generic translucent geometry on that trace;
// - no refraction, no reflection split, no recursive branching.
//
// T1 scope intentionally shades the first opaque surface behind
// the glass with the existing emission + direct-sun evaluator.
// Local Light / GI participation is reserved for T9.
// =====================================================
// Shared primary continuation for water and generic translucent terrain.
//
// The start medium is explicit: this prevents a water path from treating a
// glass face as a Water -> Air interface, and lets a glass path hand a water
// hit back to the real water transport instead of returning its raw albedo.
struct WaterTransmissionInfo {
    float waterPathLength;
    vec3 receiverWorldPos;
    vec3 receiverNormal;
    vec3 receiverViewDirection;
    vec3 receiverAlbedo;
    float receiverRoughness;
    float receiverF0Metal;
    float reachedUnderwaterReceiver;
};

// RR has one guide record per pixel.  When transmission contributes most of
// the pixel, that record must describe the real opaque receiver rather than
// the transparent front face which the camera ray first touched.
void applyTransparentReceiverRRGuides(
    WaterTransmissionInfo receiver,
    inout vec3 diffuseAlbedo,
    inout vec3 specularAlbedo,
    inout vec4 normalRoughness,
    inout float specularHitDistance
)
{
    int f0MetalCode =
        decodeF0MetalCode(
            receiver.receiverF0Metal
        );

    float metallic =
        decodeMetallicFromCode(
            f0MetalCode
        );

    vec3 N =
        normalize(
            receiver.receiverNormal
        );

    vec3 V =
        normalize(
            receiver.receiverViewDirection
        );

    float NdotV =
        abs(
            dot(N, V)
        );

    float roughness =
        clamp(
            receiver.receiverRoughness,
            0.0,
            1.0
        );

    diffuseAlbedo =
        receiver.receiverAlbedo *
        (1.0 - metallic);

    specularAlbedo =
        rrEnvBRDFApprox2(
            decodeBaseF0(
                f0MetalCode,
                receiver.receiverAlbedo
            ),
            roughness * roughness,
            NdotV
        );

    normalRoughness =
        vec4(N, roughness);

    // The opaque receiver's separate glossy-hit distance is not available
    // on this continuation.  Far keeps RR from treating the transparent
    // front-surface reflection distance as the receiver's specular event.
    specularHitDistance =
        65504.0;
}

vec3 evaluatePrimaryWaterReceiverCaustics(
    vec3 waterSurfacePosition,
    WaterTransmissionInfo receiver,
    vec3 sunDirection
)
{
    const float WATER_IOR = 1.33;
    const vec3 WATER_ABSORPTION = waterAbsorptionColor();
    const vec3 WATER_GLASS_TINT = vec3(0.20, 0.75, 0.78);
    const float WATER_CAUSTIC_STRENGTH = waterStyleCausticStrength();
    // The caustic texture is 256², but it covers the same 32-block window as
    // the 512² interaction state.  Keep this conversion tied to that world
    // span instead of accidentally shrinking the sampled domain to 16 blocks.
    const float WATER_CAUSTIC_WORLD_SPAN_TEXELS = 512.0;

    if(
        receiver.reachedUnderwaterReceiver <= 0.5 ||
        receiver.waterPathLength <= 0.0 ||
        sunDirection.y <= 0.0
    )
    {
        return vec3(0.0);
    }

    vec3 receiverN = normalize(receiver.receiverNormal);
    vec3 receiverV = normalize(receiver.receiverViewDirection);
    vec3 L = normalize(sunDirection);
    float waterDepth =
        max(waterSurfacePosition.y - receiver.receiverWorldPos.y, 0.0);

    if(waterDepth < 0.08 || cam.waterSimSurfaceAndOrigin.w <= 0.0)
    {
        return vec3(0.0);
    }

    // The map's coordinate system is the flat water source plane.  Do not use
    // the camera ray's primary water normal here: the deformed refractive
    // normals already created the map, and doing so would make the caustics
    // camera-dependent again.
    vec3 incomingWaterSun = refract(-L, vec3(0.0, 1.0, 0.0), 1.0 / WATER_IOR);
    if(dot(incomingWaterSun, incomingWaterSun) < 1.0e-6)
    {
        return vec3(0.0);
    }

    vec3 receiverToSun = normalize(-incomingWaterSun);
    float NdotL = max(dot(receiverN, receiverToSun), 0.0);
    float NdotV = max(dot(receiverN, receiverV), 0.0);
    if(NdotL <= 0.0 || NdotV <= 0.0 || receiverToSun.y <= 0.0)
    {
        return vec3(0.0);
    }

    vec3 sunTransmittance = traceSunTransmittanceThroughWater(
        receiver.receiverWorldPos + receiverN * 0.01,
        receiverToSun,
        false
    );
    if(max(sunTransmittance.r, max(sunTransmittance.g, sunTransmittance.b)) <= 0.0)
    {
        return vec3(0.0);
    }

    vec2 flatProjectedWaterXZ =
        receiver.receiverWorldPos.xz +
        receiverToSun.xz *
        (waterDepth / max(receiverToSun.y, 0.06));
    // waterCausticMap is stored on the same one-block-deep receiver plane
    // used by its inverse wavefront projection, rather than at the flat water
    // source coordinate.  This keeps cellular caustic features world-stable
    // as the actual receiver depth changes.
    vec2 causticReceiverPlaneXZ =
        flatProjectedWaterXZ -
        receiverToSun.xz * (1.0 / max(receiverToSun.y, 0.06));
    vec2 causticUV =
        (causticReceiverPlaneXZ - cam.waterSimSurfaceAndOrigin.yz) /
        (cam.waterSimSurfaceAndOrigin.w * WATER_CAUSTIC_WORLD_SPAN_TEXELS);
    vec2 causticBorder = smoothstep(vec2(0.0), vec2(0.02), causticUV) *
        (1.0 - smoothstep(vec2(0.98), vec2(1.0), causticUV));
    float causticValid = causticBorder.x * causticBorder.y;
    if(causticValid <= 0.0)
    {
        return vec3(0.0);
    }

    vec2 wavefrontDensity = texture(waterCausticMap, causticUV).rg;
    float interactionElevationMatch = 1.0 - smoothstep(
        0.65,
        1.50,
        abs(waterSurfacePosition.y - cam.waterSimSurfaceAndOrigin.x)
    );
    interactionElevationMatch *= float(cam.waterSimState.y != 0u);
    float density = mix(
        wavefrontDensity.r,
        wavefrontDensity.g,
        interactionElevationMatch
    );

    // Density 1 is the unperturbed wavefront and therefore contributes no
    // extra lighting; only physically concentrated area adds caustic energy.
    // A mild contrast curve favours the bright cellular peaks over the dim
    // web so the pattern reads clearly on sunlit floors.
    float causticFocus = causticValid * min(max(density - 1.0, 0.0), 4.5);
    causticFocus *= 0.88 + 0.24 * causticFocus;
    if(causticFocus <= 1.0e-5)
    {
        return vec3(0.0);
    }

    int f0MetalCode = decodeF0MetalCode(receiver.receiverF0Metal);
    float metallic = decodeMetallicFromCode(f0MetalCode);
    float diffuseResponse = evaluateBurleyDiffuseAngular(
        receiverN,
        receiverV,
        receiverToSun,
        clamp(receiver.receiverRoughness, 0.04, 1.0)
    );

    float cameraWaterFade = clamp(receiver.waterPathLength / 16.0, 0.0, 1.0);
    cameraWaterFade *= cameraWaterFade;
    vec3 cameraWaterTransmittance =
        exp(-WATER_ABSORPTION * receiver.waterPathLength);
    cameraWaterTransmittance = mix(
        cameraWaterTransmittance,
        cameraWaterTransmittance * WATER_GLASS_TINT,
        cameraWaterFade
    );
    cameraWaterTransmittance *= mix(1.0, 0.15, cameraWaterFade);

    vec3 sunRadiance =
        getTimeDrivenSkyLightColor() *
        3.2 *
        getTimeDrivenSkyLightRadianceScale() *
        sunTransmittance *
        c3CloudSunTransmittance(waterSurfacePosition, receiverToSun);

    float shallowFade = smoothstep(0.08, 0.55, waterDepth);
    return
        sunRadiance *
        cameraWaterTransmittance *
        receiver.receiverAlbedo *
        (1.0 - metallic) *
        diffuseResponse *
        (WATER_CAUSTIC_STRENGTH * causticFocus * shallowFade);
}

// ---- Shoreline foam -------------------------------------------------------
// Cheap two-octave value noise used only by the foam mask below.
float shoreFoamHash(vec2 p)
{
    p = fract(p * vec2(127.1, 311.7));
    p += dot(p, p + 34.35);
    return fract(p.x * p.y);
}

float shoreFoamNoise(vec2 p)
{
    vec2 cell = floor(p);
    vec2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    float n00 = shoreFoamHash(cell);
    float n10 = shoreFoamHash(cell + vec2(1.0, 0.0));
    float n01 = shoreFoamHash(cell + vec2(0.0, 1.0));
    float n11 = shoreFoamHash(cell + vec2(1.0, 1.0));
    return mix(
        mix(n00, n10, f.x),
        mix(n01, n11, f.x),
        f.y
    );
}

// Bright foam ribbon where the visible water floor is within ~0.6 m of the
// surface (i.e. near the shore).  Two noise octaves break the ribbon into
// uneven patches and drift it slowly so the edge breathes like a wave lap.
vec3 evaluateShoreFoam(
    vec3 waterSurfacePosition,
    vec3 surfaceNormal,
    const in WaterTransmissionInfo receiver,
    vec3 sunDirection
)
{
    if(
        receiver.reachedUnderwaterReceiver <= 0.5 ||
        dot(receiver.receiverNormal, vec3(0.0, 1.0, 0.0)) < 0.5
    )
    {
        return vec3(0.0);
    }

    float waterDepth =
        waterSurfacePosition.y - receiver.receiverWorldPos.y;
    // The receiver lies along the refracted view ray, so oblique views
    // inflate the depth; damp the excess with the view steepness.
    // receiverViewDirection points back toward the camera (positive y).
    waterDepth *= clamp(receiver.receiverViewDirection.y, 0.55, 1.0);
    if(waterDepth > 1.80)
    {
        return vec3(0.0);
    }

    float foamTime = uintBitsToFloat(cam.padding);
    vec2 worldXZ = waterSurfacePosition.xz;
    // The raw depth is a 1 m stair-step over the voxel floor, so any depth
    // iso-line would be blocky.  Adding a smooth low-frequency wobble turns
    // the iso-lines into organic wavy contours.  One extra noise fetch,
    // ~8 ALU, no extra ray or texture.
    float shoreDepth =
        waterDepth +
        (shoreFoamNoise(worldXZ * 0.55 + foamTime * 0.05) - 0.5) * 1.3;

    float n1 = shoreFoamNoise(worldXZ * 1.9 + foamTime * vec2(0.30, -0.22));
    float n2 = shoreFoamNoise(worldXZ * 4.7 - foamTime * vec2(0.18, 0.34));
    float foamField = n1 * 0.65 + n2 * 0.35;

    // Base ribbon: strongest right at the waterline, gone by ~1.1 m of
    // wobbled depth.
    float shoreBand = 1.0 - smoothstep(0.08, 1.10, shoreDepth);
    // Uneven lace: threshold the combined field so foam breaks into patches.
    float foamMask = shoreBand * smoothstep(0.24, 0.55, foamField);
    // Bright edge right where water meets the bank, still noise-gated so a
    // single shallow block cannot turn into a solid white square.
    foamMask = max(
        foamMask,
        (1.0 - smoothstep(0.05, 0.30, shoreDepth)) *
            smoothstep(0.15, 0.40, foamField) *
            0.90
    );
    if(foamMask <= 0.001)
    {
        return vec3(0.0);
    }

    vec3 foamRadiance =
        getTimeDrivenSkyLightColor() *
        (0.45 + 0.62 * max(sunDirection.y, 0.0));

    return foamRadiance * foamMask;
}

vec3 tracePrimaryTransparentRadiance(
    vec3 startOrigin,
    vec3 startDirection,
    bool startInsideWater,
    vec3 sunDirection,
    bool enableWaterReceiverGI,
    float waterGILodDistance,
    out WaterTransmissionInfo transmissionInfo
);

// One straight continuation for exact clear/stained glass.  The dedicated
// Any-Hit path skips later glass faces, so this trace reaches either the
// real opaque receiver, water transport, or the sky.  Glass never owns a
// refractive or POM branch.
//
// Dead code: no call sites remain after the Orion thin-sheet port moved
// the primary camera pane to tracePrimaryGenericTransparentRadiance.  Kept
// under #if 0 for future reference (it used the pre-port pure-multiplicative
// blockTransmission * receiverRadiance model).
#if 0
vec3 tracePrimarySimpleGlassRadiance(
    vec3 glassSurfacePosition,
    vec3 rayDirection,
    vec3 glassTint,
    float glassAlpha,
    vec3 sunDirection,
    out WaterTransmissionInfo transmissionInfo
)
{
    transmissionInfo.waterPathLength = 0.0;
    transmissionInfo.receiverWorldPos = vec3(0.0);
    transmissionInfo.receiverNormal = vec3(0.0, 1.0, 0.0);
    transmissionInfo.receiverViewDirection = vec3(0.0, 0.0, 1.0);
    transmissionInfo.receiverAlbedo = vec3(0.0);
    transmissionInfo.receiverRoughness = 1.0;
    transmissionInfo.receiverF0Metal = 0.0;
    transmissionInfo.reachedUnderwaterReceiver = 0.0;

    vec3 straightDirection = normalize(rayDirection);
    vec3 blockTransmission =
        computeGlassBlockTransmission(glassTint, glassAlpha, 0);

    payload.hitDistance = 1.0;
    payload.state = makeTraceState(RT_PURPOSE_PASSTHROUGH);

    traceRayEXT(
        topLevelAS,
        gl_RayFlagsNoneEXT,
        0xff,
        0,
        0,
        0,
        glassSurfacePosition + straightDirection * 0.01,
        0.01,
        straightDirection,
        10000.0,
        0
    );

    if(payload.hitDistance < 0.0)
    {
        return blockTransmission * payload.albedo;
    }

    vec3 hitPos =
        glassSurfacePosition +
        straightDirection * (payload.hitDistance + 0.01);
    float hitMaterialId = getLegacyMaterialId(payload.state);

    // A glass ray can enter real water.  Transfer to the authoritative water
    // walker instead of returning the water atlas colour.
    if(hitMaterialId > 0.5 && hitMaterialId < 2.5)
    {
        bool exitingWater = hitMaterialId > 1.5;
        vec3 refractedDirection = refract(
            straightDirection,
            payload.normal,
            exitingWater ? 1.33 : (1.0 / 1.33)
        );
        bool totalInternalReflection =
            dot(refractedDirection, refractedDirection) < 1.0e-6;
        if(totalInternalReflection)
        {
            refractedDirection = reflect(
                straightDirection,
                payload.normal
            );
        }

        WaterTransmissionInfo waterInfo;
        vec3 waterRadiance = tracePrimaryTransparentRadiance(
            hitPos + refractedDirection * 0.001,
            refractedDirection,
            totalInternalReflection ? exitingWater : !exitingWater,
            sunDirection,
            false,
            0.0,
            waterInfo
        );
        transmissionInfo = waterInfo;
        return blockTransmission * waterRadiance;
    }

    // Any-Hit normally removes a second glass face.  If it is still reported,
    // continue past it through the existing straight transparent walker;
    // returning the face albedo here discarded a nearby emitter/receiver.
    if(hitMaterialId >= 2.5)
    {
        WaterTransmissionInfo continuationInfo;
        vec3 continuedRadiance = tracePrimaryTransparentRadiance(
            hitPos + straightDirection * 0.001,
            straightDirection,
            false,
            sunDirection,
            false,
            0.0,
            continuationInfo
        );
        transmissionInfo = continuationInfo;
        return blockTransmission * continuedRadiance;
    }

    vec3 hitNormal = payload.normal;
    vec3 hitAlbedo = payload.albedo;
    transmissionInfo.receiverWorldPos = hitPos;
    transmissionInfo.receiverNormal = hitNormal;
    transmissionInfo.receiverViewDirection = -straightDirection;
    transmissionInfo.receiverAlbedo = hitAlbedo;
    transmissionInfo.receiverRoughness = payload.roughness;
    transmissionInfo.receiverF0Metal = payload.f0Metal;
    transmissionInfo.reachedUnderwaterReceiver = 1.0;

    vec3 receiverRadiance = evaluateOpaqueSurfaceRadiance(
        hitPos,
        hitNormal,
        -straightDirection,
        hitAlbedo,
        payload.roughness,
        payload.f0Metal,
        payload.emission +
            evaluateVLIEmitterRadianceAtHit(hitPos, hitNormal, hitAlbedo),
        payload.pomSelfShadow,
        sunDirection
    );

    return blockTransmission * receiverRadiance;
}
#endif

vec3 tracePrimaryGenericTransparentRadiance(
    vec3 glassSurfacePosition,
    vec3 rayDirection,
    vec3 glassNormal,
    vec3 glassTint,
    float glassAlpha,
    int transparentProfile,
    vec3 sunDirection,
    out WaterTransmissionInfo transmissionInfo
)
{
    transmissionInfo.waterPathLength = 0.0;
    transmissionInfo.receiverWorldPos = vec3(0.0);
    transmissionInfo.receiverNormal = vec3(0.0, 1.0, 0.0);
    transmissionInfo.receiverViewDirection = vec3(0.0, 0.0, 1.0);
    transmissionInfo.receiverAlbedo = vec3(0.0);
    transmissionInfo.receiverRoughness = 1.0;
    transmissionInfo.receiverF0Metal = 0.0;
    transmissionInfo.reachedUnderwaterReceiver = 0.0;

    vec3 straightDirection =
        normalize(
            rayDirection
        );


    vec3 startOrigin =
        glassSurfacePosition +
        straightDirection *
        0.01;


    payload.hitDistance =
        1.0;

    payload.state = makeTraceState(RT_PURPOSE_PASSTHROUGH);


    traceRayEXT(
        topLevelAS,
        gl_RayFlagsNoneEXT,
        0xff,
        0,
        0,
        0,
        startOrigin,
        0.01,
        straightDirection,
        10000.0,
        0
    );


    vec3 behindRadiance =
        vec3(0.0);


    if(payload.hitDistance < 0.0)
    {
        // Dedicated -4 miss path returns real sky radiance.
        behindRadiance =
            payload.albedo;
    }
    else
    {
        float hitDistance =
            payload.hitDistance;
            float hitParallaxRayTravel =
    max(
        payload.parallaxRayTravel,
        0.0
    );


        vec3 hitNormal =
            normalize(
                payload.normal
            );


        vec3 hitAlbedo =
            payload.albedo;


        float hitMaterialId =
            getLegacyMaterialId(payload.state);


        float hitRoughness =
            payload.roughness;


        float hitF0Metal =
            payload.f0Metal;


        vec3 hitEmission =
            payload.emission;


        float hitPOMSelfShadow =
            clamp(
                payload.pomSelfShadow,
                0.0,
                1.0
            );


vec3 hitPos =
    startOrigin +
    straightDirection *
    (
        hitDistance +
        hitParallaxRayTravel
    );


if(hitMaterialId <= 0.5)
{
    transmissionInfo.receiverWorldPos = hitPos;
    transmissionInfo.receiverNormal = hitNormal;
    transmissionInfo.receiverViewDirection = -straightDirection;
    transmissionInfo.receiverAlbedo = hitAlbedo;
    transmissionInfo.receiverRoughness = hitRoughness;
    transmissionInfo.receiverF0Metal = hitF0Metal;
    transmissionInfo.reachedUnderwaterReceiver = 1.0;

    vec3 unifiedHitEmission =
        hitEmission +
        evaluateVLIEmitterRadianceAtHit(
            hitPos,
            hitNormal,
            hitAlbedo
        );


    float ambientBaseBrightness =
                clamp(
                    cam.cameraParams.w,
                    0.0,
                    1.0
                );


            vec3 directAndEmission =
                evaluateOpaqueSurfaceRadiance(
                    hitPos,
                    hitNormal,
                    -straightDirection,
                    hitAlbedo,
                    hitRoughness,
                    hitF0Metal,
                    unifiedHitEmission,
                    hitPOMSelfShadow,
                    sunDirection
                );


// Glass receivers use the same Binding 31 Section-directory RIS path as a
// normal opaque primary hit.  Binding 29's legacy Top-8 list could omit an
// otherwise visible nearby emitter and incorrectly return black behind glass.
// The RIS proposals remain cheap; only the selected emitter performs the one
// final GLASS_VISIBILITY hardware trace.
uint glassReceiverRisSeed =
    uint(gl_LaunchIDEXT.x) * 1973u ^
    uint(gl_LaunchIDEXT.y) * 9277u ^
    cam.frameCount * 26699u;
pcg_hash(glassReceiverRisSeed);

vec3 localEntityIrradiance =
    evaluateVPTRISDirectLighting(
        hitPos,
        hitNormal,
        hitAlbedo,
        glassReceiverRisSeed
    );


            behindRadiance =
                directAndEmission +
                localEntityIrradiance +
                hitAlbedo *
                ambientBaseBrightness;
        }
        else if(
            hitMaterialId > 0.5 &&
            hitMaterialId < 2.5
        )
        {
            // A camera ray through glass has reached real water.  Do not
            // return water's base texture (which makes triangle-shaped
            // patches); cross this interface and continue with the water
            // transport instead.
            bool exitingWater =
                hitMaterialId > 1.5;

            float eta =
                exitingWater
                    ? 1.33
                    : (1.0 / 1.33);

            vec3 refractedDirection =
                refract(
                    straightDirection,
                    hitNormal,
                    eta
                );

            bool totalInternalReflection =
                dot(
                    refractedDirection,
                    refractedDirection
                ) < 1.0e-6;

            if(
                totalInternalReflection
            )
            {
                refractedDirection =
                    reflect(
                        straightDirection,
                        hitNormal
                    );
            }

            WaterTransmissionInfo nestedWaterInfo;
            behindRadiance =
                tracePrimaryTransparentRadiance(
                    totalInternalReflection
                        ? hitPos +
                            hitNormal *
                            0.001
                        : hitPos -
                            hitNormal *
                        0.001,
                    normalize(
                        refractedDirection
                    ),
                    totalInternalReflection
                        ? exitingWater
                        : !exitingWater,
                    sunDirection,
                    false,
                    0.0,
                    nestedWaterInfo
                );

            transmissionInfo = nestedWaterInfo;
        }
        else if(hitMaterialId >= 2.5)
        {
            // Fallback for a second glass face.  The normal fast path skips
            // it in any-hit, but treating it as raw albedo when that skip is
            // unavailable makes the underside of a glass block look solid.
            // Resume after this face through the full transparent walker;
            // it owns water state and any later translucent interfaces.
            WaterTransmissionInfo fallbackWaterInfo;
            behindRadiance =
                tracePrimaryTransparentRadiance(
                    hitPos +
                        straightDirection *
                        0.001,
                    straightDirection,
                    false,
                    sunDirection,
                    false,
                    0.0,
                    fallbackWaterInfo
                );

            transmissionInfo = fallbackWaterInfo;
        }
        else
        {
            behindRadiance =
                hitAlbedo;
        }
    }


    // =====================================================
    // Mirror-glass transmission. The pane keeps straight transport and the
    // Orion thin-sheet filter, but intentionally does not consume LabPBR
    // roughness, metalness, or POM self-shadowing. Its reflective lobe is a
    // single deterministic mirror ray with a dielectric F0.
    // =====================================================

    vec3 blockTransmission =
        computeGlassBlockTransmission(
            glassTint,
            glassAlpha,
            transparentProfile
        );

    // Orion thinTransmissionWeight: the transmission strength is applied
    // OUTSIDE the thin-sheet series, never folded into the tint.  A dense
    // body (tinted glass / honey) attenuates transmitted energy without
    // darkening its dye.
    float transmissionWeight =
        getTransparentProfileTransmission(transparentProfile);


    vec3 N =
        normalize(
            glassNormal
        );


    vec3 V =
        normalize(
            -straightDirection
        );


    float NdotV =
        clamp(
            abs(
                dot(
                    N,
                    V
                )
            ),
            0.0,
            1.0
        );


    const vec3 glassF0 = vec3(0.04);


    // View-angle Fresnel enters the Orion thin-sheet energy split: the
    // internal-reflection geometric series distributes energy between the
    // straight transmission and the mirror reflection.  glassF0 is uniform
    // across RGB, so the Fresnel factor is scalar.
    float viewFresnel =
        fresnelSchlickScalar(
            NdotV,
            0.04
        );


    vec3 sheetReflection;
    vec3 sheetTransmission;
    glassThinSheetFactorsScalarF(
        viewFresnel,
        blockTransmission,
        sheetReflection,
        sheetTransmission
    );

    // Orion surfaceDeltaLobes(): the reflection lobe interpolates from the
    // bare Fresnel toward the full thin-sheet reflection by the transmission
    // weight, while the transmission lobe is simply scaled by it.  For a
    // nearly-opaque body the reflection collapses to plain Fresnel and the
    // transmission vanishes, instead of both being darkened together.
    vec3 glassReflection =
        mix(
            vec3(viewFresnel),
            sheetReflection,
            transmissionWeight
        );
    vec3 glassTransmission =
        sheetTransmission *
        transmissionWeight;

    // Keep a direct-sun GGX highlight for the pane, but use a fixed mirror
    // regularizer rather than material/POM roughness. A literal zero
    // roughness makes the microfacet distribution singular.
    const float GLASS_MIRROR_SUN_ROUGHNESS = 0.04;
    vec3 surfaceSpecular = vec3(0.0);
    vec3 L = normalize(sunDirection);
    float NdotL = max(dot(N, L), 0.0);
    if(NdotL > 0.0 && NdotV > 0.0)
    {
        vec3 H = normalize(V + L);
        float VdotH = max(dot(V, H), 0.0);
        float F = fresnelSchlickScalar(VdotH, 0.04);
        float D = distributionGGX(N, H, GLASS_MIRROR_SUN_ROUGHNESS);
        float G = geometrySmith(
            N, V, L, GLASS_MIRROR_SUN_ROUGHNESS
        );
        float specularBRDF = (D * G * F) /
            max(4.0 * NdotV * NdotL, 1.0e-4);
        vec3 sunTransmittance = traceSunTransmittanceThroughWater(
            glassSurfacePosition + N * 0.035, L, true
        );
        vec3 sunRadiance =
            getTimeDrivenSkyLightColor() *
            3.2 *
            getTimeDrivenSkyLightRadianceScale() *
            sunTransmittance *
            c3CloudSunTransmittance(glassSurfacePosition + N * 0.035, L);
        surfaceSpecular = sunRadiance * specularBRDF * NdotL;
    }


    vec3 transmittedRadiance =
        behindRadiance *
        glassTransmission;

    // One deterministic mirror ray returns the first opaque scene surface.
    // Its existing PBR/VLI/cached-local radiance is weighted by the
    // Orion thin-sheet reflection factor instead of a glass GGX lobe.
    vec3 surfaceSceneReflection =
        traceGlassSceneReflectionOneRay(
            glassSurfacePosition,
            N,
            V,
            sunDirection
        ) *
        glassReflection;

    return
        transmittedRadiance +
        surfaceSceneReflection +
        surfaceSpecular;
}


// =====================================================
// One-bounce water-bed diffuse GI
//
// Deterministic interface transport: all non-TIR interfaces refract and
// apply (1-F), while TIR reflects.  This removes the old roulette flicker
// without adding paths or changing water-surface normals.
// =====================================================
vec3 tracePrimaryWaterReceiverIndirectReworked(
    vec3 receiverPos,
    vec3 receiverNormal,
    vec3 receiverAlbedo,
    float lodDistance,
    vec3 sunDirection
)
{
    uint lodState =
        uint(gl_LaunchIDEXT.x) * 73856093u ^
        uint(gl_LaunchIDEXT.y) * 19349663u ^
        cam.frameCount * 83492791u ^
        0x57474931u;
    uint lodRandom = pcg_hash(lodState);

    bool runWaterGI = true;
    float lodWeight = 1.0;
    if(lodDistance >= 64.0 * perfL10TierScale() && lodDistance < 128.0 * perfL10TierScale())
    {
        runWaterGI = (lodRandom & 1u) == 0u;
        lodWeight = 2.0;
    }
    else if(lodDistance >= 128.0 * perfL10TierScale() && lodDistance < 160.0 * perfL10TierScale())
    {
        runWaterGI = (lodRandom & 3u) == 0u;
        lodWeight = 4.0;
    }
    else if(lodDistance >= 160.0 * perfL10TierScale())
    {
        runWaterGI = false;
    }
    if(!runWaterGI) return vec3(0.0);

    uint pathState = lodRandom ^ 0x57474942u;
    vec3 currentOrigin = receiverPos + normalize(receiverNormal) * 0.035;
    vec3 currentDirection =
        sampleHemisphereCosine(normalize(receiverNormal), pathState);
    vec3 throughput = receiverAlbedo * 0.7;
    bool insideWater = true;
    int waterInterfaceSteps = 0;

    const vec3 WATER_ABSORPTION = waterAbsorptionColor();
    const vec3 WATER_SCATTER_COLOR = waterScatterColor();

const float WATER_EXTINCTION_DISTANCE =
    16.0;
    const float WATER_IOR = 1.33;
    const float WATER_F0 = 0.0200593;
    const int MAX_WATER_INTERFACE_STEPS = 6;

    for(int pathStep = 0; pathStep <= MAX_WATER_INTERFACE_STEPS; ++pathStep)
    {
        payload.hitDistance = 1.0;
        payload.state = makeTraceState(
            insideWater ? RT_PURPOSE_WATER_MEDIUM : RT_PURPOSE_FULL
        );
        traceRayEXT(
            topLevelAS, gl_RayFlagsNoneEXT, 0xff, 0, 0, 0,
            currentOrigin, 0.001, currentDirection, 10000.0, 0
        );

        if(payload.hitDistance < 0.0)
        {
            return throughput * payload.albedo * 1.8 * lodWeight;
        }

        float hitDistance = payload.hitDistance;
        vec3 hitPos = currentOrigin + currentDirection * hitDistance;
        float hitMaterialId = getLegacyMaterialId(payload.state);
        if(insideWater)
if(insideWater)
{
    vec3 extinction =
        exp(
            -WATER_ABSORPTION *
            hitDistance
        );

float scatterAmount = 0.0;

    throughput *= extinction;

    throughput =
        mix(
            throughput,
            WATER_SCATTER_COLOR,
            scatterAmount
        );
}

        if(hitMaterialId <= 0.5)
        {
            vec3 hitNormal = payload.normal;
            vec3 hitAlbedo = payload.albedo;
            vec3 incomingRadiance = evaluateOpaqueSurfaceRadiance(
                hitPos,
                hitNormal,
                -currentDirection,
                hitAlbedo,
                max(payload.roughness, 0.05),
                payload.f0Metal,
                payload.emission +
                    evaluateVLIEmitterRadianceAtHit(hitPos, hitNormal, hitAlbedo),
                payload.pomSelfShadow,
                sunDirection
            );
            uint localState = pathState ^ 0x5747494Cu;
            pcg_hash(localState);
            incomingRadiance +=
                evaluateVPTRISDirectLighting(hitPos, hitNormal, hitAlbedo, localState);
            return throughput * incomingRadiance * 1.8 * lodWeight;
        }

        if(hitMaterialId >= 2.5)
        {
            // Glass is a colour filter, never a water-medium transition.
            if(hitMaterialId < 3.5)
            {
                throughput *= glassSheetTransmission(
                    payload.albedo,
                    payload.normal,
                    currentDirection
                );
            }
            currentOrigin = hitPos + currentDirection * 0.001;
            continue;
        }

        if(++waterInterfaceSteps > MAX_WATER_INTERFACE_STEPS)
        {
            return vec3(0.0);
        }

        bool exitingWater = hitMaterialId > 1.5;
        vec3 interfaceNormal =
            stabilizeWaterInterfaceNormal(payload.normal);
        float cosTheta = clamp(
            -dot(currentDirection, interfaceNormal), 0.0, 1.0
        );
        float fresnelX = 1.0 - cosTheta;
        float fresnelX2 = fresnelX * fresnelX;
        float fresnel = WATER_F0 +
            (1.0 - WATER_F0) * (fresnelX2 * fresnelX2) * fresnelX;
        vec3 refractedDirection = refract(
            currentDirection,
            interfaceNormal,
            exitingWater ? WATER_IOR : (1.0 / WATER_IOR)
        );

        if(dot(refractedDirection, refractedDirection) < 1.0e-6)
        {
            currentOrigin = hitPos + interfaceNormal * 0.001;
            currentDirection = reflect(currentDirection, interfaceNormal);
            continue;
        }

        throughput *= 1.0 - fresnel;
        insideWater = !exitingWater;
        currentOrigin = hitPos - interfaceNormal * 0.001;
        currentDirection = refractedDirection;
    }

    return vec3(0.0);
}

// =====================================================
// Legacy one-bounce water-bed diffuse GI
//
// This is entered only after the primary transmission walker reaches a real
// opaque receiver through water. It can traverse water interfaces but returns
// after its first opaque or miss event; it never recursively spawns GI.
// =====================================================
vec3 tracePrimaryWaterReceiverIndirect(
    vec3 receiverPos,
    vec3 receiverNormal,
    vec3 receiverAlbedo,
    float lodDistance,
    vec3 sunDirection
)
{
    uint lodState =
        uint(gl_LaunchIDEXT.x) * 73856093u ^
        uint(gl_LaunchIDEXT.y) * 19349663u ^
        cam.frameCount * 83492791u ^
        0x57474931u;
    uint lodRandom = pcg_hash(lodState);

    bool runWaterGI = true;
    float lodWeight = 1.0;
    if(lodDistance >= 64.0 * perfL10TierScale() && lodDistance < 128.0 * perfL10TierScale())
    {
        runWaterGI = (lodRandom & 1u) == 0u;
        lodWeight = 2.0;
    }
    else if(lodDistance >= 128.0 * perfL10TierScale() && lodDistance < 160.0 * perfL10TierScale())
    {
        runWaterGI = (lodRandom & 3u) == 0u;
        lodWeight = 4.0;
    }
    else if(lodDistance >= 160.0 * perfL10TierScale())
    {
        runWaterGI = false;
    }

    if(!runWaterGI)
    {
        return vec3(0.0);
    }

    uint pathState = lodRandom ^ 0x57474942u;
    vec3 N = normalize(receiverNormal);
    vec3 currentOrigin = receiverPos + N * 0.035;
    vec3 currentDirection = sampleHemisphereCosine(N, pathState);
    vec3 pathThroughput = receiverAlbedo * 0.7;
    bool insideWater = true;
    int waterInterfaceSteps = 0;

    const vec3 WATER_ABSORPTION = waterAbsorptionColor();
    const float WATER_IOR = 1.33;
    const float WATER_F0 = 0.0200593;
    const int MAX_WATER_INTERFACE_STEPS = 6;

    for(int pathStep = 0; pathStep <= MAX_WATER_INTERFACE_STEPS; ++pathStep)
    {
        payload.hitDistance = 1.0;
        payload.state = makeTraceState(
            insideWater ? RT_PURPOSE_WATER_MEDIUM : RT_PURPOSE_FULL
        );

        traceRayEXT(
            topLevelAS,
            gl_RayFlagsNoneEXT,
            0xff,
            0,
            0,
            0,
            currentOrigin,
            0.001,
            currentDirection,
            10000.0,
            0
        );

        if(payload.hitDistance < 0.0)
        {
            return pathThroughput * payload.albedo * 1.8 * lodWeight;
        }

        float hitDistance = payload.hitDistance;
        vec3 hitPos = currentOrigin + currentDirection * hitDistance;
        vec3 hitNormal = payload.normal;
        vec3 hitAlbedo = payload.albedo;
        vec3 hitEmission = payload.emission;
        float hitMaterialId = getLegacyMaterialId(payload.state);
        float hitRoughness = max(payload.roughness, 0.05);
        float hitF0Metal = payload.f0Metal;
        float hitPOMSelfShadow = payload.pomSelfShadow;

        if(insideWater)
        {
            pathThroughput *= exp(-WATER_ABSORPTION * hitDistance);
        }

        bool isWaterInterface =
            hitMaterialId > 0.5 &&
            hitMaterialId < 2.5;

        if(!isWaterInterface)
        {
            // Glass is not continued by this one-bounce helper. The existing
            // primary transparent walker remains authoritative for glass.
            if(hitMaterialId > 2.5)
            {
                return vec3(0.0);
            }

            vec3 unifiedEmission =
                hitEmission +
                evaluateVLIEmitterRadianceAtHit(
                    hitPos,
                    hitNormal,
                    hitAlbedo
                );

            vec3 directSun =
                evaluateDirectSunLighting(
                    hitPos,
                    hitNormal,
                    -currentDirection,
                    hitAlbedo,
                    hitRoughness,
                    hitF0Metal,
                    hitPOMSelfShadow,
                    sunDirection
                );

            uint vptState = pathState ^ 0x5747494Cu;
            pcg_hash(vptState);
            vec3 localDirect =
                evaluateVPTRISDirectLighting(
                    hitPos,
                    hitNormal,
                    hitAlbedo,
                    vptState
                );

            return pathThroughput *
                (unifiedEmission + directSun + localDirect) *
                1.8 * lodWeight;
        }

        waterInterfaceSteps += 1;
        if(waterInterfaceSteps > MAX_WATER_INTERFACE_STEPS)
        {
            return vec3(0.0);
        }

        bool exitingWater = hitMaterialId > 1.5;
        vec3 interfaceNormal = stabilizeWaterInterfaceNormal(hitNormal);
        float cosTheta = clamp(
            -dot(currentDirection, interfaceNormal),
            0.0,
            1.0
        );
        float fresnelX = 1.0 - cosTheta;
        float fresnelX2 = fresnelX * fresnelX;
        float fresnel = WATER_F0 +
            (1.0 - WATER_F0) * (fresnelX2 * fresnelX2) * fresnelX;

        if(rand(pathState) < fresnel)
        {
            currentOrigin = hitPos + interfaceNormal * 0.001;
            currentDirection =
                reflect(currentDirection, interfaceNormal);
            continue;
        }

        float eta = exitingWater ? WATER_IOR : (1.0 / WATER_IOR);
        vec3 refractedDirection = refract(
            currentDirection,
            interfaceNormal,
            eta
        );

        if(dot(refractedDirection, refractedDirection) < 1.0e-6)
        {
            currentOrigin = hitPos + interfaceNormal * 0.001;
            currentDirection =
                reflect(currentDirection, interfaceNormal);
            continue;
        }

        insideWater = !exitingWater;
        currentOrigin = hitPos - interfaceNormal * 0.001;
        currentDirection = refractedDirection;
    }

    return vec3(0.0);
}

// =====================================================
// Primary water transmission radiance
// =====================================================
vec3 tracePrimaryTransparentRadiance(
    vec3 startOrigin,
    vec3 startDirection,
    bool startInsideWater,
    vec3 sunDirection,
    bool enableWaterReceiverGI,
    float waterGILodDistance,
    out WaterTransmissionInfo transmissionInfo
)
{
    transmissionInfo.waterPathLength = 0.0;
    transmissionInfo.receiverWorldPos = vec3(0.0);
    transmissionInfo.receiverNormal = vec3(0.0, 1.0, 0.0);
    transmissionInfo.receiverViewDirection = vec3(0.0, 0.0, 1.0);
    transmissionInfo.receiverAlbedo = vec3(0.0);
    transmissionInfo.receiverRoughness = 1.0;
    transmissionInfo.receiverF0Metal = 0.0;
    transmissionInfo.reachedUnderwaterReceiver = 0.0;

    const float WATER_IOR =
        1.33;


const vec3 WATER_ABSORPTION =
    waterAbsorptionColor();

// 已确认：0~3 格保持高通透。
const float WATER_SHALLOW_DISTANCE =
    3.0;

// 已确认：约 16 格后水底基本不可见。
const float WATER_EXTINCTION_DISTANCE =
    16.0;

// e^-4 ≈ 1.8%。
// 从 3 -> 16 格累计约 4 个 scattering optical depths。
const float WATER_SCATTERING =
    waterScatteringAmount();

const vec3 WATER_SCATTER_COLOR = waterScatterColor();


    const float WATER_F0 =
        0.0200593;


    const float RAY_BIAS =
        0.001;


    vec3 throughput =
        vec3(1.0);
        vec3 accumulatedWaterScattering =
    vec3(0.0);


    vec3 currentOrigin =
        startOrigin;


    vec3 currentDirection =
        normalize(
            startDirection
        );


    // Preserve the incident direction that actually entered water.  It is
    // used only when the refracted continuation incorrectly misses along a
    // shallow water/block boundary.
    vec3 waterEntryDirection =
        currentDirection;


    bool hasWaterEntryDirection =
        startInsideWater;


    bool insideWater =
        startInsideWater;


    for(
        int step = 0;
        step < 8;
        ++step
    )
    {
        payload.hitDistance =
            1.0;


        payload.state = makeTraceState(
            insideWater ? RT_PURPOSE_WATER_MEDIUM : RT_PURPOSE_FULL
        );

        traceRayEXT(
            topLevelAS,
            gl_RayFlagsNoneEXT,
            0xff,
            0,
            0,
            0,
            currentOrigin,
            0.01,
            currentDirection,
            10000.0,
            0
        );


        // =============================================
        // Miss
        //
        // miss shader 的 payload.albedo 在这里代表天空结果，
        // 这种情况下它才是 Radiance，可以直接使用。
        // =============================================
if(payload.hitDistance < 0.0)
{
    // A refracted ray can leave the shallow, triangulated water volume at a
    // block edge and reach miss before it reaches the adjacent solid.  Do
    // not turn that transport failure into a strip of sky colour: retry the
    // local segment along the direction that entered water.  A genuine open
    // water view still misses again and therefore keeps the real sky.
    if(insideWater && hasWaterEntryDirection)
    {
        payload.hitDistance =
            1.0;

        payload.state = makeTraceState(RT_PURPOSE_WATER_MEDIUM);

        traceRayEXT(
            topLevelAS,
            gl_RayFlagsNoneEXT,
            0xff,
            0,
            0,
            0,
            currentOrigin,
            0.01,
            waterEntryDirection,
            10000.0,
            0
        );

        if(
            payload.hitDistance >= 0.0 &&
            getLegacyMaterialId(payload.state) <= 0.5
        )
        {
            vec3 fallbackHitPos =
                currentOrigin +
                waterEntryDirection *
                payload.hitDistance;

            vec3 fallbackHitNormal =
                payload.normal;

            transmissionInfo.waterPathLength +=
                payload.hitDistance;
            transmissionInfo.receiverWorldPos = fallbackHitPos;
            transmissionInfo.receiverNormal = fallbackHitNormal;
            transmissionInfo.receiverViewDirection = -waterEntryDirection;
            transmissionInfo.receiverAlbedo = payload.albedo;
            transmissionInfo.receiverRoughness = payload.roughness;
            transmissionInfo.receiverF0Metal = payload.f0Metal;
            transmissionInfo.reachedUnderwaterReceiver = 1.0;

            uint fallbackWaterVptRisSeed =
                uint(gl_LaunchIDEXT.x) * 1973u ^
                uint(gl_LaunchIDEXT.y) * 9277u ^
                cam.frameCount * 26699u ^
                0x57424F54u;
            pcg_hash(fallbackWaterVptRisSeed);

            vec3 fallbackLocalDirect =
                evaluateVPTRISDirectLighting(
                    fallbackHitPos,
                    fallbackHitNormal,
                    payload.albedo,
                    fallbackWaterVptRisSeed
                );

            vec3 fallbackRadiance =
                evaluateOpaqueSurfaceRadiance(
                    fallbackHitPos,
                    fallbackHitNormal,
                    -waterEntryDirection,
                    payload.albedo,
                    payload.roughness,
                    payload.f0Metal,
                    payload.emission +
                        evaluateVLIEmitterRadianceAtHit(
                            fallbackHitPos,
                            fallbackHitNormal,
                            payload.albedo
                        ),
                    payload.pomSelfShadow,
                    sunDirection
                ) +
                fallbackLocalDirect;

            return
                throughput *
                exp(
                    -WATER_ABSORPTION *
                    payload.hitDistance
                ) *
                fallbackRadiance;
        }
    }

return
    accumulatedWaterScattering +
    throughput *
    payload.albedo;
}


        // =============================================
        // 必须立刻保存命中数据。
        //
        // 后面的太阳可见性检测会继续覆盖 payload。
        // =============================================

        float hitDistance =
            payload.hitDistance;


        vec3 hitNormal =
            normalize(
                payload.normal
            );


        vec3 hitAlbedo =
            payload.albedo;


        float hitMaterialId =
            getLegacyMaterialId(payload.state);


        float hitF0Metal =
            payload.f0Metal;
            float hitRoughness =
    payload.roughness;



        vec3 hitEmission =
            payload.emission;


        float hitPOMSelfShadow =
            clamp(
                payload.pomSelfShadow,
                0.0,
                1.0
            );


        vec3 hitPos =
            currentOrigin +
            currentDirection *
            hitDistance;


// =====================================================
// WATER VOLUME TRANSPORT
//
// 0~3 blocks:
//   absorption only, high transparency.
//
// >3 blocks:
//   absorption + scattering extinction.
//
// Scattering is accumulated as radiance separately from
// bottom/surface throughput.
// =====================================================
if(insideWater)
{
    transmissionInfo.waterPathLength +=
        hitDistance;


    const vec3 WATER_GLASS_TINT =
        vec3(
            0.20,
            0.75,
            0.78
        );


    const float WATER_END_DISTANCE =
        16.0;


    float waterFade =
        clamp(
            transmissionInfo.waterPathLength /
            WATER_END_DISTANCE,
            0.0,
            1.0
        );


    // 保持浅水透明，深水逐渐加厚
    waterFade =
        waterFade *
        waterFade;


    vec3 absorption =
        exp(
            -WATER_ABSORPTION *
            hitDistance
        );


    throughput *= absorption;


    // 青色玻璃厚度
    throughput =
        mix(
            throughput,
            throughput * WATER_GLASS_TINT,
            waterFade
        );


    // 深水降低透射
    throughput *=
        mix(
            1.0,
            0.15,
            waterFade
        );
}


// W1: an opaque receiver attenuated below this level contributes less
// than 3% of its air radiance.  Skipping it avoids the direct-sun water
// march, the VPT/RIS local-direct evaluation and the water-receiver GI
// bounce for work the eye cannot resolve.
if(max(throughput.r, max(throughput.g, throughput.b)) < 0.03)
{
    return accumulatedWaterScattering;
}


        // =============================================
// Opaque surface
// =============================================

if(hitMaterialId <= 0.5)
{
    transmissionInfo.receiverWorldPos = hitPos;
    transmissionInfo.receiverNormal = hitNormal;
    transmissionInfo.receiverViewDirection = -currentDirection;
    transmissionInfo.receiverAlbedo = hitAlbedo;
    transmissionInfo.receiverRoughness = hitRoughness;
    transmissionInfo.receiverF0Metal = hitF0Metal;
    transmissionInfo.reachedUnderwaterReceiver = 1.0;

    vec3 unifiedHitEmission =
        hitEmission +
        evaluateVLIEmitterRadianceAtHit(
            hitPos,
            hitNormal,
            hitAlbedo
        );


vec3 surfaceRadiance =
    evaluateOpaqueSurfaceRadiance(
        hitPos,
        hitNormal,
        -currentDirection,
        hitAlbedo,
        hitRoughness,
        hitF0Metal,
        unifiedHitEmission,
        hitPOMSelfShadow,
        sunDirection
    );


// This receiver was reached through the water transport.  Evaluate its
// active VPT/RIS local direct light before the return below applies the
// accumulated Beer-Lambert attenuation for the camera-to-receiver path.
uint waterReceiverVptRisSeed =
    uint(gl_LaunchIDEXT.x) * 1973u ^
    uint(gl_LaunchIDEXT.y) * 9277u ^
    cam.frameCount * 26699u ^
    0x57424F54u;
pcg_hash(waterReceiverVptRisSeed);

vec3 waterReceiverLocalDirect =
    evaluateVPTRISDirectLighting(
        hitPos,
        hitNormal,
        hitAlbedo,
        waterReceiverVptRisSeed
    );

surfaceRadiance +=
    waterReceiverLocalDirect;

if(insideWater && enableWaterReceiverGI)
{
    surfaceRadiance +=
        tracePrimaryWaterReceiverIndirectReworked(
            hitPos,
            hitNormal,
            hitAlbedo,
            waterGILodDistance,
            sunDirection
        );
}


return
    throughput *
    surfaceRadiance;


// =============================================
// Generic translucent interface
//
// Glass stays straight-through and contributes its filter once.  It is not
// a water interface and must never consume WATER_IOR / insideWater state.
// =============================================
if(hitMaterialId >= 2.5)
{
    if(hitMaterialId < 3.5)
    {
        throughput *=
            glassSheetTransmission(
                hitAlbedo,
                payload.normal,
                currentDirection
            );
    }

    currentOrigin =
        hitPos +
        currentDirection *
        RAY_BIAS;

    continue;
}


// =============================================
// Another water interface

        hitNormal =
            stabilizeWaterInterfaceNormal(
                hitNormal
            );

        bool exitingWater =
            hitMaterialId > 1.5;

        if(!exitingWater)
        {
            waterEntryDirection =
                currentDirection;

            hasWaterEntryDirection =
                true;
        }


        float cosTheta =
            clamp(
                -dot(
                    currentDirection,
                    hitNormal
                ),
                0.0,
                1.0
            );


        float fresnel =
            WATER_F0 +
            (
                1.0 -
                WATER_F0
            ) *
            pow(
                1.0 -
                cosTheta,
                5.0
            );


        float eta =
            exitingWater
                ? WATER_IOR
                : (1.0 / WATER_IOR);


        vec3 transmittedDirection =
            refract(
                currentDirection,
                hitNormal,
                eta
            );


        // =============================================
        // Total internal reflection
        // =============================================

        if(
            dot(
                transmittedDirection,
                transmittedDirection
            ) < 1.0e-6
        )
        {
            currentOrigin =
                hitPos +
                hitNormal *
                RAY_BIAS;


            currentDirection =
                normalize(
                    reflect(
                        currentDirection,
                        hitNormal
                    )
                );


            // 没有跨介质。
            continue;
        }


        // 这里没有再做随机 roulette，
        // 所以透射能量必须显式乘 (1-F)。
        throughput *=
            1.0 -
            fresnel;


        insideWater =
            !exitingWater;


        currentOrigin =
            hitPos -
            hitNormal *
            RAY_BIAS;


        currentDirection =
            normalize(
                transmittedDirection
            );
    }


    return
        vec3(0.0);
}

// =====================================================
// A2-1
// Primary ray-traced glossy reflection radiance
//
// 只负责：
// Primary opaque surface
// -> GGX reflection ray
// -> sky / opaque surface
//
// 如果中途撞到水：
// 允许真实 reflection / refraction 穿过水界面，
// 但水界面本身不作为最终 Radiance。
// =====================================================
}
vec3 tracePrimaryGlossyReflectionRadiance(
    vec3 primarySurfaceOrigin,
    vec3 startOrigin,
    vec3 startDirection,
    vec3 sunDirection,
    inout uint state,
    out float firstSpecularHitDistance
)
{
    firstSpecularHitDistance =
        65504.0;
    const float WATER_IOR =
        1.33;

    const float WATER_F0 =
        0.0200593;

    const vec3 WATER_ABSORPTION =
        waterAbsorptionColor();
        const vec3 WATER_SCATTER_COLOR = waterScatterColor();

const float WATER_EXTINCTION_DISTANCE =
    16.0;

    const float RAY_BIAS =
        0.001;

    const int MAX_WATER_INTERFACE_STEPS =
    6;


// A3-4：Primary glossy 命中第一个 opaque 后，
// 最多允许 1 次额外 PBR indirect continuation。
const int MAX_OPAQUE_INDIRECT_CONTINUATIONS =
    1;


// 最坏路径：
// 6 次 water interface
// + 第一个 opaque
// + continuation 的终点
const int MAX_PATH_TRACE_STEPS =
    MAX_WATER_INTERFACE_STEPS +
    MAX_OPAQUE_INDIRECT_CONTINUATIONS +
    1;


vec3 throughput =
    vec3(1.0);


vec3 accumulatedRadiance =
    vec3(0.0);


vec3 currentOrigin =
    startOrigin;


vec3 currentDirection =
    normalize(
        startDirection
    );


bool insideWater =
    false;


int waterInterfaceStepCount =
    0;


int opaqueContinuationCount =
    0;


for(
    int pathStep = 0;
    pathStep < MAX_PATH_TRACE_STEPS;
    ++pathStep
)
    {
        payload.hitDistance =
            1.0;


        payload.state = makeTraceState(RT_PURPOSE_FULL);

        traceRayEXT(
            topLevelAS,
            gl_RayFlagsNoneEXT,
            0xff,
            0,
            0,
            0,
            currentOrigin,
            0.001,
            currentDirection,
            10000.0,
            0
        );


        if(pathStep == 0)
        {
            if(payload.hitDistance >= 0.0)
            {
                vec3 firstSpecularHitPos =
                    currentOrigin +
                    currentDirection *
                    payload.hitDistance;

                firstSpecularHitDistance =
                    length(
                        firstSpecularHitPos -
                        primarySurfaceOrigin
                    );
            }
            else
            {
                firstSpecularHitDistance =
                    65504.0;
            }
        }


        // =============================================
        // Sky
        // =============================================

        if(payload.hitDistance < 0.0)
{
    // The in-water segment is already Beer-Lambert attenuated in
    // throughput.  Preserve the environment term instead of producing a
    // black reflection fragment at a fluid-section boundary.
    return
        accumulatedRadiance +
        throughput *
        payload.albedo;
}


        // 后续 visibility trace 会覆盖 payload，
        // 所以这里必须立即保存。
        float hitDistance =
            payload.hitDistance;


        vec3 hitNormal =
            normalize(
                payload.normal
            );


        vec3 hitAlbedo =
            payload.albedo;


        float hitMaterialId =
            getLegacyMaterialId(payload.state);


        float hitRoughness =
            payload.roughness;


        float hitF0Metal =
            payload.f0Metal;


        vec3 hitEmission =
            payload.emission;


        float hitPOMSelfShadow =
            clamp(
                payload.pomSelfShadow,
                0.0,
                1.0
            );


        vec3 hitPos =
            currentOrigin +
            currentDirection *
            hitDistance;


        // 当前 ray segment 真正在水中传播。
        if(insideWater)
        {
throughput *=
    exp(
        -WATER_ABSORPTION *
        hitDistance
    );


        }


        // =============================================
        // Opaque hit
        // =============================================

if(hitMaterialId <= 0.5)
{
    // =================================================
    // A3-4
    //
    // 当前 opaque 自己的 local radiance：
    //
    // emission
    // +
    // 完整 PBR direct sun
    // =================================================

    vec3 surfaceRadiance =
        evaluateOpaqueSurfaceRadiance(
            hitPos,
            hitNormal,
            -currentDirection,
            hitAlbedo,
            hitRoughness,
            hitF0Metal,
            hitEmission,
            hitPOMSelfShadow,
            sunDirection
        );


    accumulatedRadiance +=
        throughput *
        surfaceRadiance;


    // =================================================
    // 已经完成一次 opaque indirect continuation。
    //
    // 第二个 opaque 就是终点：
    // 取它自己的 emission + direct，然后返回。
    // =================================================

    if(
        opaqueContinuationCount >=
        MAX_OPAQUE_INDIRECT_CONTINUATIONS
    )
    {
        return
            accumulatedRadiance;
    }


    // =================================================
    // 当前 opaque 的 view/outgoing direction
    // =================================================

    vec3 bounceV =
        normalize(
            -currentDirection
        );


    float bounceNdotV =
        max(
            dot(
                hitNormal,
                bounceV
            ),
            0.0
        );


    if(bounceNdotV <= 1.0e-5)
    {
        return
            accumulatedRadiance;
    }


    // =================================================
    // LabPBR material decode
    // =================================================

    int hitF0MetalCode =
        decodeF0MetalCode(
            hitF0Metal
        );


    float hitMetallic =
        decodeMetallicFromCode(
            hitF0MetalCode
        );


    vec3 bounceF0 =
        decodeBaseF0(
            hitF0MetalCode,
            hitAlbedo
        );


    float bounceRoughness =
        max(
            hitRoughness,
            0.05
        );


    // =================================================
    // Fresnel-based lobe selection
    //
    // 和已经确认的 A3-1 使用相同规则。
    // =================================================

    vec3 bounceFForChoice =
        fresnelSchlick(
            bounceNdotV,
            bounceF0
        );


    float bounceFMax =
        max(
            max(
                bounceFForChoice.r,
                bounceFForChoice.g
            ),
            bounceFForChoice.b
        );


    float bounceSpecularProbability =
        hitMetallic > 0.5
            ? 1.0
            : clamp(
                bounceFMax,
                0.05,
                0.95
            );


    bool chooseBounceSpecular =
        rand(state) <
        bounceSpecularProbability;


    vec3 bounceDirection =
        vec3(0.0);


    vec3 bounceWeight =
        vec3(0.0);


    // =================================================
    // GGX Specular continuation
    // =================================================

    if(chooseBounceSpecular)
    {
        vec3 bounceH =
            normalize(
                sampleGGX(
                    hitNormal,
                    bounceRoughness,
                    state
                )
            );


        float bounceVdotH =
            max(
                dot(
                    bounceV,
                    bounceH
                ),
                0.0
            );


        float bounceNdotH =
            max(
                dot(
                    hitNormal,
                    bounceH
                ),
                0.0
            );


        bounceDirection =
            normalize(
                reflect(
                    -bounceV,
                    bounceH
                )
            );


        float bounceNdotL =
            max(
                dot(
                    hitNormal,
                    bounceDirection
                ),
                0.0
            );


        if(
            bounceVdotH <= 1.0e-5 ||
            bounceNdotH <= 1.0e-5 ||
            bounceNdotL <= 1.0e-5
        )
        {
            return
                accumulatedRadiance;
        }


        vec3 bounceF =
            fresnelSchlick(
                bounceVdotH,
                bounceF0
            );


        float bounceD =
            distributionGGX(
                hitNormal,
                bounceH,
                bounceRoughness
            );


        float bounceG =
            geometrySmith(
                hitNormal,
                bounceV,
                bounceDirection,
                bounceRoughness
            );


        vec3 bounceSpecularBRDF =
            (
                bounceD *
                bounceG *
                bounceF
            ) /
            max(
                4.0 *
                bounceNdotV *
                bounceNdotL,
                1.0e-5
            );


        // sampleGGX:
        //
        // PDF(H) = D * NdotH
        //
        // reflection mapping:
        //
        // PDF(L) =
        // PDF(H) / (4 * VdotH)
        float bounceSpecularPdf =
            max(
                (
                    bounceD *
                    bounceNdotH
                ) /
                max(
                    4.0 *
                    bounceVdotH,
                    1.0e-5
                ),
                1.0e-5
            );


        bounceWeight =
            (
                bounceSpecularBRDF *
                bounceNdotL
            ) /
            (
                bounceSpecularPdf *
                max(
                    bounceSpecularProbability,
                    1.0e-5
                )
            );
    }


    // =================================================
    // Diffuse continuation
    // =================================================

    else
    {
        float bounceDiffuseProbability =
            max(
                1.0 -
                bounceSpecularProbability,
                1.0e-5
            );


        vec3 bounceKD =
            (
                vec3(1.0) -
                bounceFForChoice
            ) *
            (
                1.0 -
                hitMetallic
            );


        bounceDirection =
            sampleHemisphereCosine(
                hitNormal,
                state
            );


        // Cosine hemisphere：
        //
        // BRDF * NdotL / PDF
        // =>
        // kD * albedo
        bounceWeight =
            (
                bounceKD *
                hitAlbedo
            ) /
            bounceDiffuseProbability;
    }


    // =================================================
    // 与已经确认的 A3-1 保持同一 GI transport 尺度。
    // =================================================

    throughput *=
        bounceWeight *
        0.7;


    currentOrigin =
        hitPos +
        hitNormal *
        RAY_BIAS;


    currentDirection =
        bounceDirection;


    opaqueContinuationCount +=
        1;


    continue;
}


        // =============================================
        // Water interface
        //
        // rchit 已确认：
        // 1.0 = Air -> Water
        // 2.0 = Water -> Air
        // =============================================
if(
    waterInterfaceStepCount >=
    MAX_WATER_INTERFACE_STEPS
)
{
    return
        accumulatedRadiance;
}


waterInterfaceStepCount +=
    1;

        hitNormal =
            stabilizeWaterInterfaceNormal(
                hitNormal
            );

        bool exitingWater =
            hitMaterialId > 1.5;


        float cosTheta =
            clamp(
                -dot(
                    currentDirection,
                    hitNormal
                ),
                0.0,
                1.0
            );


        float fresnel =
            WATER_F0 +
            (
                1.0 -
                WATER_F0
            ) *
            pow(
                1.0 -
                cosTheta,
                5.0
            );


        float waterChoice =
            rand(
                state
            );


        // =============================================
        // Reflection
        // =============================================

        if(
            waterChoice <
            fresnel
        )
        {
            // 没跨介质：
            //
            // Air -> Water 的界面反射：
            // 仍在 Air。
            //
            // Water -> Air 的界面反射：
            // 仍在 Water。
            insideWater =
                exitingWater;


            currentOrigin =
                hitPos +
                hitNormal *
                RAY_BIAS;


            currentDirection =
                normalize(
                    reflect(
                        currentDirection,
                        hitNormal
                    )
                );


            continue;
        }


        // =============================================
        // Transmission
        // =============================================

        float eta =
            exitingWater
                ? WATER_IOR
                : (1.0 / WATER_IOR);


        vec3 refractedDirection =
            refract(
                currentDirection,
                hitNormal,
                eta
            );


        // Total internal reflection
        if(
            dot(
                refractedDirection,
                refractedDirection
            ) < 1.0e-6
        )
        {
            insideWater =
                exitingWater;


            currentOrigin =
                hitPos +
                hitNormal *
                RAY_BIAS;


            currentDirection =
                normalize(
                    reflect(
                        currentDirection,
                        hitNormal
                    )
                );


            continue;
        }


        // 真正跨介质
        insideWater =
            !exitingWater;


        currentOrigin =
            hitPos -
            hitNormal *
            RAY_BIAS;


        currentDirection =
            normalize(
                refractedDirection
            );
    }


return
    accumulatedRadiance;
}
// =====================================================
// Explicit reflected sunlight from flat water
//
// Path:
//
// Sun
//   -> horizontal water surface
//   -> specular reflection
//   -> opaque receiver surface
//
// This explicitly samples the specular water path instead
// of waiting for a random GI ray to hit the exact sun path.
// =====================================================
float traceWaterReflectedSun(
    vec3 receiverPos,
    vec3 receiverNormal,
    vec3 sunDirection
)
{
    const vec3 WATER_PLANE_NORMAL =
        vec3(0.0, 1.0, 0.0);

    const float WATER_F0 =
        0.0200593;

    // -------------------------------------------------
    // For a flat horizontal mirror:
    //
    // receiver -> virtual sun
    //
    // This ray must hit the water surface if the receiver
    // can receive the reflected sunlight.
    // -------------------------------------------------
    vec3 toWaterDir =
        normalize(
            reflect(
                sunDirection,
                WATER_PLANE_NORMAL
            )
        );

    float receiverNdotL =
        max(
            dot(
                receiverNormal,
                toWaterDir
            ),
            0.0
        );

    // Receiver faces away from reflected light.
    if(receiverNdotL <= 0.0)
    {
        return 0.0;
    }


    // =================================================
    // Receiver -> Water
    // =================================================
    payload.hitDistance =
        1.0;

    payload.state = makeTraceState(RT_PURPOSE_CLASSIFY);

    traceRayEXT(
        topLevelAS,
        gl_RayFlagsNoneEXT,
        0xff,
        0,
        0,
        0,
        receiverPos +
            receiverNormal * 0.035,
        0.02,
        toWaterDir,
        10000.0,
        0
    );


    // No water intersection.
    if(payload.hitDistance < 0.0)
    {
        return 0.0;
    }


    float waterMaterialId =
        getLegacyMaterialId(payload.state);

    // First intersection must actually be water.
    if(waterMaterialId <= 0.5)
    {
        return 0.0;
    }


    // We only want the Air -> Water top-facing surface.
    //
    // materialId:
    //     1 = Air -> Water
    //     2 = Water -> Air
    if(waterMaterialId > 1.5)
    {
        return 0.0;
    }


    vec3 waterHitPos =
        receiverPos +
        receiverNormal * 0.035 +
        toWaterDir *
        payload.hitDistance;

    vec3 waterHitNormal =
        normalize(
            payload.normal
        );


    // Reject vertical water sides.
    // Current explicit solution is for the horizontal
    // water surface only.
    if(
        dot(
            waterHitNormal,
            WATER_PLANE_NORMAL
        ) < 0.5
    )
    {
        return 0.0;
    }


    // =================================================
    // Water -> Sun visibility
    //
    // The reflection only exists if this exact water point
    // is actually exposed to the sun.
    // =================================================
    payload.hitDistance =
        1.0;

    payload.state = makeTraceState(RT_PURPOSE_VISIBILITY_ONLY);

    traceRayEXT(
        topLevelAS,
        gl_RayFlagsTerminateOnFirstHitEXT |
        gl_RayFlagsSkipClosestHitShaderEXT,
        0xff,
        0,
        0,
        0,
        waterHitPos +
            WATER_PLANE_NORMAL * 0.035,
        0.02,
        sunDirection,
        10000.0,
        0
    );


    // Something blocks the sun above the water.
    if(payload.hitDistance >= 0.0)
    {
        return 0.0;
    }


    // =================================================
    // Fresnel reflection
    // =================================================
    float waterCosTheta =
        clamp(
            dot(
            WATER_PLANE_NORMAL,
            sunDirection
            ),
            0.0,
            1.0
        );

    float waterFresnel =
        WATER_F0 +
        (
            1.0 -
            WATER_F0
        ) *
        pow(
            1.0 -
            waterCosTheta,
            5.0
        );


    return
        receiverNdotL *
        waterFresnel;
}

        
void main() {
    ivec2 size = imageSize(image);

    if (gl_LaunchIDEXT.x >= size.x ||
        gl_LaunchIDEXT.y >= size.y) {
        return;
    }


    ivec2 pixelCoord =
        ivec2(gl_LaunchIDEXT.xy);


    // 一帧唯一一个 Primary jitter。
    // 所有像素、4 个 sample 共享。
    vec2 frameJitter =
        getDLSSFrameJitter(
            cam.frameCount
        );


    // Camera UBO 当前保存的是 inverse matrices。
    // Depth 要恢复真实 view/projection 后计算 HW depth。
    mat4 viewMatrix =
        inverse(cam.viewInverse);

    mat4 projectionMatrix =
        inverse(cam.projInverse);


    const int SAMPLES_PER_FRAME = 1;

    vec3 accumulatedSampleColor =
        vec3(0.0);

// =====================================================
// RR-6.2 - Dense guide values for this primary pixel
// =====================================================

vec3 rrDiffuseAlbedo =
    vec3(0.0);

vec3 rrSpecularAlbedo =
    vec3(0.0);

vec4 rrNormalRoughness =
    vec4(0.0);

float rrSpecularHitDistance =
    65504.0;

// Transparent paths replace the front-surface RR record only when their
// transmitted receiver is the dominant visible signal.
bool rrTransparentReceiverGuideValid =
    false;

vec3 rrTransparentReceiverWorldPos =
    vec3(0.0);

    vec3 sunDir =
        getTimeDrivenSkyLightDirection();


    for (int s = 0;
         s < SAMPLES_PER_FRAME;
         ++s) {
seed =
    gl_LaunchIDEXT.y * uint(size.x) +
    gl_LaunchIDEXT.x +
    cam.frameCount * 97253u +
    uint(s * 19937u);

pcg_hash(seed);


// Primary camera sampling 不再消耗 PCG。
// 4 个 sample 使用相同的帧级 Halton jitter。
vec2 pixelCenter =
    vec2(gl_LaunchIDEXT.xy) +
    vec2(0.5) +
    frameJitter;


vec2 inUV =
    pixelCenter /
    vec2(gl_LaunchSizeEXT.xy);

        vec2 d = inUV * 2.0 - 1.0;
        d.y = -d.y;

        vec4 origin = cam.viewInverse * vec4(0.0, 0.0, 0.0, 1.0);
        vec4 target = cam.projInverse * vec4(d.x, d.y, 1.0, 1.0);

        // Infinite-far perspective matrices map the far-plane clip point to
        // w == 0. In that case target.xyz is already the homogeneous ray
        // direction; dividing by w would inject NaNs into traceRayEXT.
        vec3 viewTarget = abs(target.w) > 1.0e-6
            ? target.xyz / target.w
            : target.xyz;
        float viewTargetLengthSquared = dot(viewTarget, viewTarget);
        vec3 rayDir = viewTargetLengthSquared > 1.0e-12
            ? viewTarget * inversesqrt(viewTargetLengthSquared)
            : vec3(0.0, 0.0, -1.0);
        vec4 worldDir = cam.viewInverse * vec4(rayDir, 0.0);

        // ==========================================
        // 步骤 1: Primary Ray (主光线发射)
        // ==========================================
payload.state = makeTraceState(RT_PURPOSE_PRIMARY_SKY);

traceRayEXT(
    topLevelAS,
gl_RayFlagsNoneEXT,
    0x01,
    0, 0, 0,
    origin.xyz,
    0.001,
    worldDir.xyz,
    10000.0,
    0
);


// =====================================================
// 保存 Primary Ray 命中结果。
// 从这里开始，后面的 reflection/AO/shadow/GI
// 都允许继续覆盖 payload。
// =====================================================

float primaryHitDistance =
    payload.hitDistance;


// =====================================================
// P1-2A - RT distance sampling LOD
//
// Hard distance bands:
//   0-16  = near
//   16-32 = medium
//   32-48 = far
//   48+   = very far
//
// No Raster color compositing in this version.
// =====================================================

float rtLodDistance =
    max(
        primaryHitDistance,
        0.0
    );


uint rtLodState =
    uint(pixelCoord.x) * 73856093u ^
    uint(pixelCoord.y) * 19349663u ^
    cam.frameCount * 83492791u;


uint rtLodRandom =
    pcg_hash(
        rtLodState
    );


bool rtLodHalfSample =
    (rtLodRandom & 1u) == 0u;


bool rtLodQuarterSample =
    (rtLodRandom & 3u) == 0u;


bool rtLodGlossyHalfSample =
    ((rtLodRandom >> 3u) & 1u) == 0u;


bool rtLodGlossyQuarterSample =
    ((rtLodRandom >> 3u) & 3u) == 0u;


float primaryPOMSelfShadow =
    clamp(
        payload.pomSelfShadow,
        0.0,
        1.0
    );


float primaryGlassAlpha =
    clamp(
        payload.glassAlpha,
        0.0,
        1.0
    );


float primaryRoughness =
    clamp(
        payload.roughness,
        0.0,
        1.0
    );


float primaryF0Metal =
    payload.f0Metal;


float primaryParallaxRayTravel =
    max(
        payload.parallaxRayTravel,
        0.0
    );


// =====================================================
// RR-6.2 - Primary surface material guides
// Capture before any secondary ray overwrites payload.
// =====================================================

if(
    s == 0 &&
    primaryHitDistance >= 0.0 &&
    getLegacyMaterialId(payload.state) <= 0.5
)
{
    vec3 guideAlbedo =
        payload.albedo;

    vec3 guideNormal =
        normalize(
            payload.normal
        );

    float guideRoughness =
        clamp(
            payload.roughness,
            0.0,
            1.0
        );

    int guideF0MetalCode =
        decodeF0MetalCode(
            payload.f0Metal
        );

    float guideMetallic =
        decodeMetallicFromCode(
            guideF0MetalCode
        );

    vec3 guideF0 =
        decodeBaseF0(
            guideF0MetalCode,
            guideAlbedo
        );

    vec3 guideV =
        normalize(
            -worldDir.xyz
        );

    float guideNdotV =
        abs(
            dot(
                guideNormal,
                guideV
            )
        );

    rrDiffuseAlbedo =
        guideAlbedo *
        (
            1.0 -
            guideMetallic
        );

    rrSpecularAlbedo =
        rrEnvBRDFApprox2(
            guideF0,
            guideRoughness *
                guideRoughness,
            guideNdotV
        );

    rrNormalRoughness =
        vec4(
            guideNormal,
            guideRoughness
        );
}


// =====================================================
// Probe - RR POM depth consistency
//
// ClosestHit already reports the POM virtual surface travel
// through primaryParallaxRayTravel.
//
// RR albedo / normal / roughness already describe that POM
// surface, so feed RR depth from the same virtual position.
//
// Main shading and all ray origins remain untouched.
// =====================================================

if (s == 0)
{
    // Minecraft 26.2 reversed-Z:
    // miss / far = 0.0
    float primaryDepth =
        0.0;


    if(primaryHitDistance >= 0.0)
    {
        float primarySurfaceTravel =
            getHitClass(payload.state) == RT_HIT_TRANSLUCENT
                ? primaryParallaxRayTravel
                : 0.0;

        vec3 primaryHitPos =
    origin.xyz +
    worldDir.xyz *
    (primaryHitDistance + primarySurfaceTravel);


        vec4 viewPos =
            viewMatrix *
            vec4(
                primaryHitPos,
                1.0
            );


        vec4 clipPos =
            projectionMatrix *
            viewPos;


        if(abs(clipPos.w) > 1.0e-6)
        {
            primaryDepth =
                clamp(
                    clipPos.z /
                    clipPos.w,
                    0.0,
                    1.0
                );
        }
    }


    imageStore(
        depthImage,
        pixelCoord,
        vec4(
            primaryDepth,
            0.0,
            0.0,
            0.0
        )
    );
}


vec3 sampleColor =
    vec3(0.0);

        // ==========================================
        // 步骤 2: ClosestHit 结果判定 (若未击中则输出天空)
        // ==========================================
if (primaryHitDistance < 0.0) {

    // Sky has no receiver and must not retain an old opaque reservoir.
    restirDIWriteCurrent(
        uint(pixelCoord.y * size.x + pixelCoord.x),
        restirDIEmptyReservoir()
    );

    sampleColor =
        payload.albedo;

} else {
    vec3 hitPos =
        origin.xyz +
        worldDir.xyz *
        primaryHitDistance;
            vec3 albedo = payload.albedo;
            vec3 normal = payload.normal;
            float matId = getLegacyMaterialId(payload.state);

// The geometric face normal, captured before POM, normal maps or rain
// displacement touch `normal`.  Rain surface classification must key off the
// axis-aligned face orientation rather than a shaded normal: a normal map can
// tilt normal.y below the threshold even on a perfectly horizontal ground
// face.
vec3 primaryGeometricNormal =
    payload.normal;

// SectionCompiler marks every solid axis-aligned exterior face with marker 23
// -- horizontal top faces and vertical wall faces alike.  VulkanCore carries
// that marker through the opaque closest-hit payload as glassAlpha = 0.25,
// while ordinary opaque faces retain 1.0.  The payload geometric normal is
// what separates the two orientations, so one marker covers both rain models
// and neither VulkanCore nor rt_test.rchit needs to know which is which.
bool rainSolidSurfaceCandidate =
    matId <= 0.5 &&
    primaryGlassAlpha > 0.0 &&
    primaryGlassAlpha < 0.5;

// Upward rain model: the existing puddle film and splash ripples.
bool rainTopSurfaceCandidate =
    rainSolidSurfaceCandidate &&
    primaryGeometricNormal.y > 0.5;

// Wall rain model: run-off film and slow droplets.  Only the two horizontal
// axes qualify, so undersides (normal.y < -0.5) enter neither model.
bool rainWallSurfaceCandidate =
    rainSolidSurfaceCandidate &&
    abs(primaryGeometricNormal.y) < 0.5;


// 水体折射与吸收管线保持独立。
// T1-2 payload materialId=3 is generic translucent terrain
// and must never enter the water path.
if (matId > 0.5 && matId < 2.5) {
                // Water keeps its existing path and explicitly invalidates
                // the opaque ReSTIR history for this pixel.
                restirDIWriteCurrent(
                    uint(pixelCoord.y * size.x + pixelCoord.x),
                    restirDIEmptyReservoir()
                );
                vec3 viewDir = -worldDir.xyz;
                float cosTheta = clamp(dot(normal, viewDir), 0.0, 1.0);
                float R0 = 0.02;
                float fresnelX = 1.0 - cosTheta;
                float fresnelX2 = fresnelX * fresnelX;
                float fresnel = R0 + (1.0 - R0) * (fresnelX2 * fresnelX2) * fresnelX;

                // =====================================================
                // RR-6.2 - Primary water guides
                // =====================================================
                if(s == 0)
                {
                    const float waterGuideRoughness =
                        WATER_SURFACE_SUN_ROUGHNESS;

                    rrDiffuseAlbedo =
                        vec3(0.0);

                    rrSpecularAlbedo =
                        rrEnvBRDFApprox2(
                            vec3(R0),
                            waterGuideRoughness *
                                waterGuideRoughness,
                            cosTheta
                        );

                    rrNormalRoughness =
                        vec4(
                            normalize(normal),
                            waterGuideRoughness
                        );

                    vec3 rrWaterReflectionDir =
                        normalize(
                            reflect(
                                worldDir.xyz,
                                normal
                            )
                        );

                    vec3 rrWaterReflectionOrigin =
                        hitPos +
                        normal *
                        0.01;

                    payload.hitDistance =
                        1.0;

                    payload.state = makeTraceState(RT_PURPOSE_DISTANCE_ONLY);

                    traceRayEXT(
                        topLevelAS,
                        gl_RayFlagsNoneEXT,
                        0xff,
                        0,
                        0,
                        0,
                        rrWaterReflectionOrigin,
                        0.01,
                        rrWaterReflectionDir,
                        10000.0,
                        0
                    );

                    if(payload.hitDistance >= 0.0)
                    {
                        vec3 rrWaterReflectionHitPos =
                            rrWaterReflectionOrigin +
                            rrWaterReflectionDir *
                            payload.hitDistance;

                        rrSpecularHitDistance =
                            length(
                                rrWaterReflectionHitPos -
                                hitPos
                            );
                    }
                    else
                    {
                        rrSpecularHitDistance =
                            65504.0;
                    }
                }

                // A one-sample Fresnel roulette chooses either sky
                // reflection or water transmission for a whole pixel.  With
                // a changing per-frame seed that produces the flashing
                // triangular sky patches visible at water/block boundaries.
                // Evaluate the two physical lobes deterministically and
                // combine them by Fresnel instead.
                WaterTransmissionInfo reflectedTransmissionInfo;
                vec3 reflectedRadiance =
                    tracePrimaryTransparentRadiance(
                        hitPos +
                            normal *
                            0.01,
                        normalize(
                            reflect(
                                worldDir.xyz,
                                normal
                            )
                        ),
                        false,
                        sunDir,
                        false,
                        primaryHitDistance,
                        reflectedTransmissionInfo
                    );

                vec3 refrDir =
                    refract(
                        worldDir.xyz,
                        normal,
                        1.0 / 1.33
                    );

                if(
                    dot(
                        refrDir,
                        refrDir
                    ) < 1.0e-6
                )
                {
                    sampleColor =
                        reflectedRadiance;
                }
                else
                {
                    WaterTransmissionInfo transmittedTransmissionInfo;
                    vec3 transmittedRadiance =
                        tracePrimaryTransparentRadiance(
                            hitPos -
                                normal *
                                0.01,
                            refrDir,
                            true,
                            sunDir,
                            true,
                            primaryHitDistance,
                            transmittedTransmissionInfo
                        );

                    // Below the Fresnel crossover this pixel is primarily
                    // the lit receiver seen through water, so RR must not use
                    // the water-surface depth/normal as its reconstruction
                    // guide.
                    if(
                        s == 0 &&
                        transmittedTransmissionInfo.reachedUnderwaterReceiver > 0.5 &&
                        fresnel < 0.5
                    )
                    {
                        applyTransparentReceiverRRGuides(
                            transmittedTransmissionInfo,
                            rrDiffuseAlbedo,
                            rrSpecularAlbedo,
                            rrNormalRoughness,
                            rrSpecularHitDistance
                        );

                        rrTransparentReceiverWorldPos =
                            transmittedTransmissionInfo.receiverWorldPos;

                        rrTransparentReceiverGuideValid =
                            true;
                    }

                    sampleColor =
                        mix(
                            transmittedRadiance,
                            reflectedRadiance,
                            fresnel
                        );

                    sampleColor +=
                        evaluatePrimaryWaterReceiverCaustics(
                            hitPos,
                            transmittedTransmissionInfo,
                            sunDir
                        );

                    // Shoreline foam: additive white ribbon near the visible
                    // waterline.  Damped by Fresnel so grazing reflections
                    // keep the surface reading as water, not as a white
                    // overlay.  Inside the transmission branch: a fully
                    // reflected pixel shows no underwater floor, so no foam.
                    // 2026-09-20: disabled per user request -- the depth the
                    // foam reads is a 1 m voxel staircase, so the noise-then-
                    // threshold result still traces blocky contours.  Kept
                    // for reference; re-enable only with a continuous depth
                    // field (e.g. several jittered receiver probes).
#if 0
                    sampleColor +=
                        evaluateShoreFoam(
                            hitPos,
                            normal,
                            transmittedTransmissionInfo,
                            sunDir
                        ) * (1.0 - fresnel * 0.75);
#endif
                }

                // The reflected/transmitted walkers do not contain an
                // explicit directional solar lobe.  Add the shadow-correct
                // water-surface GGX glint once after their Fresnel combination.
                sampleColor +=
                    evaluatePrimaryWaterSunLighting(
                        hitPos,
                        normal,
                        viewDir,
                        sunDir
                    );

            }
            // =====================================================
            // T1-2 Generic translucent terrain
            //
            // Vertex materialId=2 (confirmed T1-1) is translated by
            // rchit to payload materialId=3 for normal faces and 4 for
            // the physical bottom face, so neither can collide with the
            // existing water back-face payload value 2.
            //
            // Straight transmission only: no refraction.
            // =====================================================
else if(
    matId >= 2.5 &&
    matId < 4.5
)
{
                // Glass remains on its transmission path. It never feeds a
                // transparent-layer reservoir into an opaque receiver.
                restirDIWriteCurrent(
                    uint(pixelCoord.y * size.x + pixelCoord.x),
                    restirDIEmptyReservoir()
                );
                GlassSurfaceInfo glassSurface;
                glassSurface.position =
                    hitPos +
                    worldDir.xyz * primaryParallaxRayTravel;
                glassSurface.normal = normal;
                glassSurface.tint = albedo;
                glassSurface.alpha = primaryGlassAlpha;
                const vec3 glassF0 = vec3(0.04);

                float glassNdotV =
                    clamp(
                        abs(
                            dot(
                                glassSurface.normal,
                                normalize(-worldDir.xyz)
                            )
                        ),
                        0.0,
                        1.0
                    );

                // =====================================================
                // RR guide policy - hybrid guide for generic glass
                //
                // The glass SURFACE identity always comes from the
                // first-surface pane: normal, roughness and specular F0
                // are written below from the glass hit and are NEVER
                // replaced by the behind-glass receiver.  This keeps the
                // pane visible - the chromatic tint no longer floats as a
                // gas cloud.
                //
                // The guides that describe the VISIBLE TRANSMITTED
                // content - primary depth and diffuse albedo - are
                // borrowed from the behind-glass receiver when the
                // transmission actually reached one (see the merge after
                // the trace below).  With rrDiffuseAlbedo=0 and depth at
                // the pane, DLSS RR had misclassified the transmitted back
                // content as distant specular (reprojected at the pane's
                // motion / 65504) and smeared it into a blur.  Reporting
                // the receiver's diffuse albedo + depth lets RR reproject
                // the transmitted light correctly (sharp) while the pane's
                // normal/specular keep the surface solid.
                //
                // Water keeps its own full receiver-guide switch; this
                // hybrid targets generic glass only.
                // =====================================================


                if(s == 0)
                {
                    rrDiffuseAlbedo =
                        vec3(0.0);


                    rrSpecularAlbedo =
                        rrEnvBRDFApprox2(
                            glassF0,
                            0.0,
                            glassNdotV
                        );


                    rrNormalRoughness =
                        vec4(
                            glassSurface.normal,
                            0.0
                        );


                    rrSpecularHitDistance =
                        65504.0;
                }


                WaterTransmissionInfo glassTransmissionInfo;
                sampleColor =
                    tracePrimaryGenericTransparentRadiance(
                        glassSurface.position,
                        worldDir.xyz,
                        glassSurface.normal,
                        glassSurface.tint,
                        glassSurface.alpha,
                        int(getTransparentProfile(payload.state)),
                        sunDir,
                        glassTransmissionInfo
                    );

                // =====================================================
                // RR guide merge - pane surface identity (kept) +
                // transmitted content guide (from the behind-glass
                // receiver).  Run only on the first sample; the guide
                // images are stored once per pixel after the loop.
                // =====================================================
                if(s == 0)
                {
                    // Real glass scene-reflection distance.  The pane's
                    // reflection ray was traced inside
                    // tracePrimaryGenericTransparentRadiance above and
                    // exported its hit distance, so RR can reproject the
                    // reflected content at the correct depth (opaque
                    // surfaces already do this via
                    // glossySpecularHitDistance).  Replaces the previous
                    // hard-coded 65504 that made the pane's specular read
                    // as a sky/infinity reflection and blur.
                    rrSpecularHitDistance =
                        rrGlassReflectionHitDistance;

                    // Borrow the transmitted-content guide from the
                    // behind-glass receiver: diffuse albedo + depth so RR
                    // can reproject the transmitted light (sharp).  The
                    // pane's own normal / roughness / specular-F0 written
                    // above are left untouched, keeping the glass surface
                    // solid (anti-gas).
                    if(
                        glassTransmissionInfo.reachedUnderwaterReceiver
                            > 0.5
                    )
                    {
                        int receiverF0MetalCode =
                            decodeF0MetalCode(
                                glassTransmissionInfo.receiverF0Metal
                            );

                        float receiverMetallic =
                            decodeMetallicFromCode(
                                receiverF0MetalCode
                            );

                        rrDiffuseAlbedo =
                            glassTransmissionInfo.receiverAlbedo *
                            (1.0 - receiverMetallic);

                        rrTransparentReceiverWorldPos =
                            glassTransmissionInfo.receiverWorldPos;

                        rrTransparentReceiverGuideValid =
                            true;
                    }
                }
            }
            // 不透明方块的 PBR 核心管线
            else {
vec3 emission =
    payload.emission;


float roughness =
    max(
        payload.roughness,
        0.05
    );


// =====================================================
// LabPBR 1.3 F0 / Metal decoding
//
// 0..229   = dielectric F0
// 230..255 = metal
//
// Hardcoded metal N/K tables are optional in LabPBR,
// so this stage treats 230..255 as generic metals
// using albedo as metallic F0.
// =====================================================

int f0MetalCode =
    int(
        round(
            clamp(
                payload.f0Metal,
                0.0,
                1.0
            ) * 255.0
        )
    );


bool isMetal =
    f0MetalCode >= 230;


float metallic =
    isMetal
        ? 1.0
        : 0.0;


// =====================================================
// PBR-2 - rough-specular tracing gate
//
// Use the raw LabPBR roughness payload here, BEFORE the local
// max(..., 0.05) shading clamp, so the original smoothness
// threshold is preserved exactly.
// =====================================================
float pbr2ReflectionStrength =
    evaluatePBR2ReflectionStrength(
        payload.roughness,
        f0MetalCode
    );

vec3 materialF0 =
    isMetal
        ? albedo
        : vec3(
            float(f0MetalCode) /
            255.0
        );

                // ==========================================
                // 步骤 3: RTAO (8 条短距离遮蔽射线)
                // ==========================================
// === 强化版 RTAO：增大探测范围、加深遮蔽对比 ===
                float occlusion =
    0.0;


// 10-chunk RTAO distance budget:
//   0-16   : 4 rays  (existing near quality)
//   16-32  : 2 rays  (existing near quality)
//   32-64  : 1 ray
//   64-96  : 1 ray
//   96-128 : 0.5 ray, 2-frame interleave
//   128-160: 0.25 ray, 4-frame interleave
//   160+   : disabled
int aoSamples = 0;
float aoTemporalWeight = 1.0;


if(rtLodDistance < 16.0 * perfL10TierScale())
{
    aoSamples =
        clamp(int(cam.perfPrimary.x), 0, 4); // user "RTAO 近距采样"
}
else if(rtLodDistance < 32.0 * perfL10TierScale())
{
    aoSamples =
        clamp(int(cam.perfPrimary.y), 0, 2); // user "RTAO 中距采样"
}
else if(rtLodDistance < 64.0 * perfL10TierScale())
{
    aoSamples = 1;
}
else if(rtLodDistance < 96.0 * perfL10TierScale())
{
    aoSamples = 1;
}
else if(rtLodDistance < 128.0 * perfL10TierScale())
{
    aoSamples = rtLodHalfSample ? 1 : 0;
    aoTemporalWeight = 2.0;
}
else if(rtLodDistance < 160.0 * perfL10TierScale())
{
    aoSamples = rtLodQuarterSample ? 1 : 0;
    aoTemporalWeight = 4.0;
}


if(perfL10DisableRtao())
{
    aoSamples =
        0;
}

// Perf-L10.1 stage 9: cap the near-field ray count so the cost of four RTAO
// rays against two is a measurable partial delta.
aoSamples =
    min(aoSamples, perfL10AoSampleCap());

float maxDist =
    5.5;


for(
    int i = 0;
    i < aoSamples;
    ++i
)
{
    vec3 aoDir =
        sampleHemisphereCosine(
            normal,
            seed
        );


    payload.hitDistance =
        -1.0;

    payload.state = makeTraceState(RT_PURPOSE_VISIBILITY_ONLY);


    traceRayEXT(
        topLevelAS,

        gl_RayFlagsTerminateOnFirstHitEXT |
        gl_RayFlagsSkipClosestHitShaderEXT,

        0xff,
        0,
        0,
        0,

        hitPos +
            normal * 0.035,

        0.01,
        aoDir,
        maxDist,
        0
    );


    if(payload.hitDistance > 0.0)
    {
        float distWeight =
            1.0 -
            clamp(
                payload.hitDistance /
                maxDist,
                0.0,
                1.0
            );


        occlusion +=
            distWeight *
            distWeight;
    }
}


float rtaoFactor =
    1.0;


if(aoSamples > 0)
{
    rtaoFactor =
        clamp(
            pow(
                clamp(
                    1.0 -
                    (
                        (occlusion * aoTemporalWeight) /
                        float(aoSamples)
                    ),
                    0.0,
                    1.0
                ),
                1.3
            ),
            0.45,
            1.0
        );
}
                

                vec3 V = -worldDir.xyz;
                float NdotV = max(dot(normal, V), 0.0001);
vec3 F0 =
    materialF0;


vec3 F =
    F0 +
    (1.0 - F0) *
    pow(
        1.0 - NdotV,
        5.0
    );

                // === 严格控制：非金属且粗糙的表面绝对禁止镜面反射，消除镜面世界 ===
                // =====================================================
// G2B-2 Q1 + E1
// Diffuse GI remains independent from glossy reflection, but its
// single direction now uses the confirmed 50:50 BSDF/Local-Light
// proposal mixture.  No second GI ray is introduced.
// =====================================================

vec3 bounceDir =
    vec3(0.0);


float g2bPrimaryMixtureWeight =
    1.0;


// Match the diffuse-GI LOD gate below before doing the expensive local-light
// guide scan.  On interleaved/distant pixels the GI loop is skipped anyway,
// so generating a guide direction there only burns ALU and buffer reads.
bool prepareDiffuseGI =
    !perfL10DisableDiffuseGi() &&
    (
        rtLodDistance < 64.0 * perfL10TierScale() ||
        (rtLodDistance < 128.0 * perfL10TierScale() && rtLodHalfSample) ||
        (rtLodDistance < 160.0 * perfL10TierScale() && rtLodQuarterSample)
    );

if(prepareDiffuseGI)
{
    g2bSampleDiffuseDirectionMIS(
        hitPos,
        normal,
        seed,
        bounceDir,
        g2bPrimaryMixtureWeight
    );
}
else
{
    // The direction/weight are dead when the GI loop is disabled.  Keep a
    // valid zero direction for debuggers and avoid touching the RNG state.
    bounceDir = normal;
    g2bPrimaryMixtureWeight = 0.0;
}


vec3 brdfWeight =
    (
        vec3(1.0) -
        F
    ) *
    (
        1.0 -
        metallic
    ) *
    albedo *
    g2bPrimaryMixtureWeight;

                // ==========================================
                // 步骤 4: Direct Shadow (4 条软阴影射线)
                // ==========================================
float NdotL = max(0.0, dot(normal, sunDir));
vec3 shadowTransmittance =
    vec3(0.0);

// Direct-sun visibility is deliberately kept independent from rain exposure.
// Rain falls vertically, while sampleSunDirection() follows the sun and can
// be sideways or below the horizon.  Using the latter as a roof test was the
// reason an open floor never received the ground-rain material response.
float rainSkyExposure =
    0.0;

int shadowSamples =
    rtLodDistance < 16.0 * perfL10TierScale()
        ? 2
        : 1;

// Perf-L10.1 stage 10: cap the soft-shadow ray count so one extra visibility
// ray per near pixel becomes a measurable partial delta.
shadowSamples =
    min(shadowSamples, perfL10ShadowSampleCap());


// =====================================================
// T1/T9/T3 COMBINED - colored transparent sun shadows
//
// Visibility rays start with white transmittance.
// Any-Hit multiplies glass color into payload.albedo and ignores
// that glass intersection. Opaque geometry still terminates the ray.
// =====================================================

uint shadowSeed =
    seed ^
    0x68bc21ebu;

pcg_hash(shadowSeed);


for (int si = 0;
     si < shadowSamples;
     ++si)
{
    vec3 shadowDir =
        sampleSunDirection(
            sunDir,
            shadowSeed
        );


    payload.hitDistance =
        1.0;

    payload.albedo =
        vec3(1.0);

    payload.parallaxRayTravel =
        0.0;

    payload.glassAlpha =
        0.0;

    payload.state = makeTraceState(RT_PURPOSE_GLASS_VISIBILITY);


    traceRayEXT(
        topLevelAS,
        gl_RayFlagsTerminateOnFirstHitEXT |
        gl_RayFlagsSkipClosestHitShaderEXT,
        0xff,
        0,
        0,
        0,
        // Visibility starts along its actual outgoing ray, never along the
        // POM/normal-map shading normal.  The latter can cross a block edge
        // and turn a blocked sun ray into a false bright seam.
        hitPos +
            shadowDir * 0.001,
        0.02,
        shadowDir,
        10000.0,
        0
    );


    if(payload.hitDistance < 0.0)
    {
        shadowTransmittance +=
            clamp(
                payload.albedo,
                vec3(0.0),
                vec3(1.0)
            );

    }
}


shadowTransmittance /=
    float(
        shadowSamples
    );

// One vertical visibility query is required only for a rain-active primary
// solid surface.  The existing GLASS_VISIBILITY Any-Hit path preserves
// glassAlpha=1 through clear/stained glass, so roofs and glass canopies keep
// blocking rain even if their RGB transmission is white.
//
// A wall only needs this query while its run-off is actually resolvable: up
// close.  Beyond the effect distance the wall stays dry rather than paying a
// ray per pixel, and rain fog already hides the difference there.
bool rainWallExposureQuery =
    rainWallEnabled() &&
    rainWallSurfaceCandidate &&
    rtLodDistance < rainWallExposureDistance();

if(
    (rainTopSurfaceCandidate || rainWallExposureQuery) &&
    getOverworldRainStrength() > 0.01
)
{
    payload.hitDistance =
        1.0;

    payload.albedo =
        vec3(1.0);

    payload.parallaxRayTravel =
        0.0;

    payload.glassAlpha =
        0.0;

    payload.state =
        makeTraceState(RT_PURPOSE_GLASS_VISIBILITY);

    // Start the wall ray slightly off the surface along its own normal so it
    // cannot re-intersect the face it started from.  The top-face ray keeps
    // its original fixed +Y offset.
    vec3 rainExposureOrigin =
        rainTopSurfaceCandidate
            ? hitPos + vec3(0.0, 0.002, 0.0)
            : hitPos + primaryGeometricNormal * 0.002;

    // The top-face query has always run to its full 10000 range, so it keeps
    // that behaviour.  The wall query is new and bounded instead: anything
    // overhead that could matter sits far closer than the cap, and the cap
    // stops an open-sky wall from paying a full-height traversal.
    float rainExposureTMax =
        rainTopSurfaceCandidate
            ? 10000.0
            : rainWallExposureRange();

    traceRayEXT(
        topLevelAS,
        gl_RayFlagsTerminateOnFirstHitEXT |
        gl_RayFlagsSkipClosestHitShaderEXT,
        0xff,
        0,
        0,
        0,
        rainExposureOrigin,
        0.02,
        vec3(0.0, 1.0, 0.0),
        rainExposureTMax,
        0
    );

    rainSkyExposure =
        (payload.hitDistance < 0.0 && payload.glassAlpha < 0.5)
            ? 1.0
            : 0.0;
}


// POM self-shadow remains scalar and multiplies the RGB light path.
shadowTransmittance *=
    primaryPOMSelfShadow;


float shadowVisibility =
    max(
        max(
            shadowTransmittance.r,
            shadowTransmittance.g
        ),
        shadowTransmittance.b
    );

// Block 1: continuous rain wetness across every exposed solid top face.
// Spatial modulation keeps the film natural, while rain coverage is not
// limited to isolated puddle islands.
float rainGroundWetness =
    0.0;

if(
    rainTopSurfaceCandidate &&
    rainSkyExposure > 0.0
)
{
    const float REFERENCE_DEFAULT_POROSITY = 0.2;
    const float REFERENCE_POROSITY_ABSORPTION = 0.4;

    rainGroundWetness =
        getOverworldRainStrength() *
        rainSkyExposure;
    rainGroundWetness *=
        evaluateContinuousRainWetnessNoise(hitPos.xz);
    rainGroundWetness = clamp(
        rainGroundWetness *
            (1.8 - REFERENCE_DEFAULT_POROSITY) -
        REFERENCE_DEFAULT_POROSITY * 0.2,
        0.0,
        1.0
    );
    // The candidate is an axis-aligned geometric top face, so its equivalent
    // reference v_tbn[2].y is exactly 1.0.
    rainGroundWetness *=
        clamp(1.0 * 0.5 + 0.5, 0.0, 1.0);

    albedo *=
        1.0 -
        rainGroundWetness *
        sqrt(REFERENCE_DEFAULT_POROSITY) *
        REFERENCE_POROSITY_ABSORPTION;
}

if(rainGroundWetness > 0.0)
{
    // This renderer stores physical roughness (0 = smooth), while the
    // reference pushes its packed smoothness channel toward 1.  Keep the
    // already verified smooth-film target and drive it with the continuous
    // continuous rain-film coverage.
    roughness = mix(roughness, 0.075, rainGroundWetness);
    normal = normalize(
        mix(
            normal,
            vec3(0.0, 1.0, 0.0),
            clamp(rainGroundWetness * 2.0 - 1.0, 0.0, 1.0)
        )
    );

    // Reuse the existing analytic rain-impact field.  It performs no texture
    // lookup, allocation, compute dispatch or ray query.  The 48-block limit
    // avoids its nine-cell gradient loop where the reference splash fade is
    // already visually small.
    if(rtLodDistance < 48.0)
    {
        vec2 rainPuddleRippleGradient =
            evaluateRainPuddleRippleGradient(hitPos.xz) *
            rainGroundWetness;

        normal = normalize(
            normal +
            vec3(
                -rainPuddleRippleGradient.x,
                0.0,
                -rainPuddleRippleGradient.y
            )
        );
    }

    NdotL = max(0.0, dot(normal, sunDir));

    // PBR-2 originally evaluated its tracing gate before this block, from
    // the dry payload roughness.  Re-evaluate only after rain has changed
    // roughness so the existing GGX path actually traces the wet film.
    pbr2ReflectionStrength = evaluatePBR2ReflectionStrength(
        roughness,
        f0MetalCode
    );
}

// =====================================================
// Block 2: rain run-off on exposed solid wall faces.
//
// Same no-allocation model as the wet ground: the pattern is evaluated from
// world-space coordinates only, so it allocates nothing, samples no texture
// and stays stable under RR/DLSS reprojection.  It runs on an already
// visible, rain-exposed vertical solid face, and it never overlaps block 1
// because a face cannot be both upward and vertical.
// =====================================================
float rainWallWetness =
    0.0;

float rainWallDripShape =
    0.0;

if(
    rainWallEnabled() &&
    rainWallSurfaceCandidate &&
    rainSkyExposure > 0.0 &&
    rtLodDistance < rainWallWetnessDistance()
)
{
    // The wall is axis aligned, so its surface parameterisation is the
    // horizontal tangent axis plus world Y.  A screen-space domain would
    // swim as soon as the camera moves; a world-space one stays glued to the
    // block.
    //
    // Both faces of a one-block-thick wall share that (tangent, height)
    // domain, so without the facing offset they would show the identical
    // pattern wherever both are visible at once, for instance through a
    // doorway.  Folding the facing sign into the tangent coordinate breaks
    // that symmetry for one compare and one add.
    float faceOffset =
        primaryGeometricNormal.x + primaryGeometricNormal.z > 0.0
            ? 0.0
            : 31.7;

    vec2 wallUV =
        abs(primaryGeometricNormal.x) > 0.5
            ? vec2(hitPos.z + faceOffset, hitPos.y)
            : vec2(hitPos.x + faceOffset, hitPos.y);

    float rain =
        getOverworldRainStrength();

    // Static film: the same continuous noise the wet ground uses, evaluated
    // on (tangent, height) so wall and ground read as one rain field rather
    // than two separate effects.
    rainWallWetness =
        clamp(
            rain *
                rainSkyExposure *
                rainWallWetnessScale() *
                evaluateContinuousRainWetnessNoise(wallUV),
            0.0,
            1.0
        );

    // Each dial is a UBO read behind an inlined clamp; the compiler folds the
    // repeated loads of the same lane, so they are called at their use sites
    // rather than hoisted into locals that then need naming.
    if(
        rainWallDripDensity() > 0.0 &&
        rtLodDistance < rainWallDripDistance()
    )
    {
        float rainWallTime =
            uintBitsToFloat(cam.padding);

        // Column hashing gathers the film into separated rivulets instead of
        // a uniform sheet, which is what reads as "flowing" rather than just
        // "wet".
        float columnCoord =
            wallUV.x / RAIN_WALL_DRIP_COLUMN_WIDTH;

        float columnIndex =
            floor(columnCoord);

        float columnFrac =
            fract(columnCoord);

        // Soft width profile: a triangular wave smoothed into a bump that
        // peaks at the rivulet centre and reaches zero at both column edges,
        // so neighbouring rivulets never show a hard seam.
        float columnProfile =
            1.0 - abs(columnFrac * 2.0 - 1.0);

        columnProfile =
            columnProfile * columnProfile * (3.0 - 2.0 * columnProfile);

        float columnHash =
            rainPuddleHash(
                vec2(columnIndex, RAIN_WALL_DRIP_COLUMN_SALT)
            );

        // Only a fraction of the columns actually run; the rest keep just the
        // static film.  Without this the wall turns into a curtain.
        float drippingColumn =
            step(
                1.0 - rainWallDripDensity(),
                columnHash
            );

        // Per-column speed and phase keep neighbouring rivulets out of sync,
        // so the wall never shows a repeating vertical rhythm.  The scale is
        // applied to both ends, which keeps the spread between slow and fast
        // columns constant as the dial moves.
        float dripSpeed =
            mix(
                RAIN_WALL_DRIP_SPEED_MIN * rainWallDripSpeedScale(),
                RAIN_WALL_DRIP_SPEED_MAX * rainWallDripSpeedScale(),
                rainPuddleHash(
                    vec2(columnIndex, RAIN_WALL_DRIP_SPEED_SALT)
                )
            );

        float dripPhase =
            rainPuddleHash(
                vec2(columnIndex, RAIN_WALL_DRIP_PHASE_SALT)
            );

        // Descent makes the travel coordinate grow with time and with height,
        // so a fixed travel value tracks a droplet moving downward as the
        // frame time advances.  The trail dial stretches the cycle, so a longer
        // setting means droplets farther apart with a proportionally longer
        // falloff behind each head.
        float dripTravel =
            (rainWallTime * dripSpeed + wallUV.y) /
                (RAIN_WALL_DRIP_PERIOD * rainWallTrailScale()) +
            dripPhase;

        // Position inside one droplet cycle.  Zero is the droplet head; it
        // grows upward along the trail the droplet has just left behind.
        float dripLocal =
            fract(dripTravel);

        // Trail: quadratic falloff that reaches exactly zero at the top of
        // the cycle, so consecutive cycles join without a seam.
        float dripTrail =
            (1.0 - dripLocal) *
            (1.0 - dripLocal);

        // Head: a narrow bright band sitting on the trail's leading edge.
        float dripHead =
            1.0 - smoothstep(0.0, RAIN_WALL_DRIP_HEAD_WIDTH, dripLocal);

        rainWallDripShape =
            max(dripTrail * RAIN_WALL_DRIP_TRAIL_STRENGTH, dripHead) *
            columnProfile *
            drippingColumn *
            rain *
            rainSkyExposure;
    }
}

if(rainWallWetness > 0.0)
{
    albedo *=
        1.0 -
        rainWallWetness * RAIN_WALL_ALBEDO_DARKENING;

    roughness =
        mix(roughness, RAIN_WALL_FILM_ROUGHNESS, rainWallWetness);

    if(rainWallDripShape > 0.0)
    {
        float dripAmount =
            clamp(rainWallDripShape, 0.0, 1.0);

        // Droplets are geometry, not paint: bend the normal outward along the
        // face normal and let the highlight do the work.  Darkening the
        // albedo further would just read as dirt.
        normal = normalize(
            normal +
            primaryGeometricNormal * dripAmount *
                (RAIN_WALL_DRIP_BUMP * rainWallDripBumpScale())
        );

        roughness =
            mix(roughness, RAIN_WALL_DRIP_ROUGHNESS, dripAmount);
    }

    NdotL = max(0.0, dot(normal, sunDir));

    // PBR-2 evaluated its tracing gate from the dry payload roughness before
    // this block.  Re-evaluate it here for the same reason block 1 does, so
    // the GGX path actually traces the wet wall.
    pbr2ReflectionStrength = evaluatePBR2ReflectionStrength(
        roughness,
        f0MetalCode
    );
}

// =====================================================
// A1 - GGX Direct Sun Lighting
//
// 保留：
// - 8 ray soft shadow
// - shadowVisibility
// - sun intensity 3.2
//
// 新增：
// - LabPBR F0
// - GGX NDF
// - Smith geometry
// - Schlick Fresnel
// - metallic / dielectric energy split
// =====================================================

vec3 directLight =
    vec3(0.0);


if(
    NdotL > 0.0 &&
    NdotV > 0.0 &&
    shadowVisibility > 0.0
)
{
    vec3 directL =
        normalize(
            sunDir
        );


    vec3 directH =
        normalize(
            V +
            directL
        );


    // -------------------------------------------------
    // Direct-light F0
    //
    // 这里单独使用完整 LabPBR metal 解码。
    // 不修改当前 GI 的 materialF0，
    // 因此不会提前影响 A3。
    // -------------------------------------------------

    vec3 directF0 =
        decodeBaseF0(
            f0MetalCode,
            albedo
        );


    float directVdotH =
        max(
            dot(
                V,
                directH
            ),
            0.0
        );


    vec3 directF =
        fresnelSchlick(
            directVdotH,
            directF0
        );


    float directD =
        distributionGGX(
            normal,
            directH,
            roughness
        );


    float directG =
        geometrySmith(
            normal,
            V,
            directL,
            roughness
        );


    vec3 directSpecularBRDF =
        (
            directD *
            directG *
            directF
        ) /
        max(
            4.0 *
            NdotV *
            NdotL,
            1.0e-4
        );


    // -------------------------------------------------
    // Energy split
    //
    // dielectric:
    // diffuse + specular
    //
    // metal:
    // diffuse -> 0
    // specular only
    // -------------------------------------------------

    vec3 directKD =
        (
            vec3(1.0) -
            directF
        ) *
        (
            1.0 -
            metallic
        );


    // PBR-1B:
    // The current Primary path did NOT contain the helper's 1.2 scale.
    // Preserve that exact Primary brightness baseline and only replace
    // Lambert NdotL with the Burley angular/roughness response.
    float directBurleyDiffuse =
        evaluateBurleyDiffuseAngular(
            normal,
            V,
            directL,
            roughness
        );


    vec3 directDiffuse =
        directKD *
        albedo *
        directBurleyDiffuse;


    vec3 directSpecular =
        directSpecularBRDF *
        NdotL;


    vec3 sunRadiance =
        getTimeDrivenSkyLightColor() *
        3.2 *
        getTimeDrivenSkyLightRadianceScale() *
        shadowTransmittance *
        c3CloudSunTransmittance(hitPos + directL * 0.001, directL);


    directLight =
        sunRadiance *
        (
            directDiffuse +
            directSpecular
        );
}


// =====================================================
// VLI-1.4 - Section voxel indirect local light
//
// No candidate search and no L7 local-light visibility rays remain on
// the primary path. The old emitter call stays only as a zero-cost
// compatibility fallback while Binding 17 contains its permanent empty
// sentinel page.
// =====================================================

// 判决实验 H2 分屏判据：右半屏 = true（保留自发光 / 关掉二级弹射），
// 左半屏 = false。必须在两个本地光项之前声明（GLSL 单遍编译）。
bool splitHalfRight =
    DBG_SPLIT_ABLATION &&
    (float(gl_LaunchIDEXT.x) >= 0.5 * float(gl_LaunchSizeEXT.x));

vec3 localEmitterEmission =
    evaluateVLIEmitterRadianceAtHit(
        hitPos,
        normal,
        albedo
    );
if(DBG_KILL_EMITTER_TERM)
{
    localEmitterEmission = vec3(0.0);
}
// 判决实验 H2 分屏：左半屏关掉无过滤自发光，右半屏保留它。
if(DBG_SPLIT_ABLATION)
{
    localEmitterEmission = splitHalfRight ? localEmitterEmission : vec3(0.0);
}

// Opaque primary receivers use full ReSTIR DI. Glass and water retain their
// dedicated paths, so no transparent-layer history participates in reprojection.
uint vptRisSeed = uint(gl_LaunchIDEXT.x) * 1973u ^
    uint(gl_LaunchIDEXT.y) * 9277u ^ cam.frameCount * 26699u;
pcg_hash(vptRisSeed);
vec3 localDirectLight = evaluateReSTIRDIDirectLighting(
    hitPos,
    normal,
    albedo,
    ivec2(gl_LaunchIDEXT.xy),
    ivec2(gl_LaunchSizeEXT.xy),
    vptRisSeed
);
uint vptBounceSeed = uint(gl_LaunchIDEXT.x) * 31847u ^
    uint(gl_LaunchIDEXT.y) * 11213u ^ cam.frameCount * 6971u;
pcg_hash(vptBounceSeed);
// Keep the local-light secondary DDA on the same 10-chunk temporal budget as
// direct local lighting.  This avoids an unbudgeted extra voxel traversal in
// the distant tiers.
bool runLocalSecondary = rtLodDistance < 64.0 * perfL10TierScale();
float localSecondaryLodWeight = 1.0;
if(rtLodDistance >= 64.0 * perfL10TierScale() && rtLodDistance < 128.0 * perfL10TierScale())
{
    runLocalSecondary = rtLodHalfSample;
    localSecondaryLodWeight = 2.0;
}
else if(rtLodDistance >= 128.0 * perfL10TierScale() && rtLodDistance < 160.0 * perfL10TierScale())
{
    runLocalSecondary = rtLodQuarterSample;
    localSecondaryLodWeight = 4.0;
}

vec3 localSecondaryLight = runLocalSecondary
    ? evaluateVPTLocalSecondaryBounce(
        hitPos,
        normal,
        albedo,
        vptBounceSeed
    ) * localSecondaryLodWeight
    : vec3(0.0);
if(DBG_KILL_SECONDARY_TERM)
{
    localSecondaryLight = vec3(0.0);
}
// 判决实验 H2 分屏：左半屏保留二级弹射，右半屏关掉它。
if(DBG_SPLIT_ABLATION)
{
    localSecondaryLight = splitHalfRight ? vec3(0.0) : localSecondaryLight;
}


                    // =====================================================
// Explicit Sun -> Water -> Receiver reflection
// =====================================================
// The reflection interval is the user "水面反射间隔" setting
// (perfSecondary.z: 0 = off, 1 = every frame, 2/4 = every N frames).  On
// skipped frames the term is simply dropped; the temporal filters smooth the
// result, trading one visibility ray per skipped frame.
uint waterReflectionInterval =
    clamp(cam.perfSecondary.z, 0u, 4u);
bool runWaterReflection =
    waterReflectionInterval > 0u &&
    (waterReflectionInterval == 1u ||
     (cam.frameCount % waterReflectionInterval) == 0u);
float waterReflectedSunFactor =
    runWaterReflection
        ? traceWaterReflectedSun(
            hitPos,
            normal,
            sunDir
        )
        : 0.0;

vec3 waterReflectedSunLight =
    getTimeDrivenSkyLightColor() *
    3.2 *
    getTimeDrivenSkyLightRadianceScale() *
    albedo *
    (1.0 - metallic) *
    waterReflectedSunFactor *
    c3CloudSunTransmittance(hitPos, sunDir);
    // =====================================================
// A2-1
// Independent ray-traced GGX glossy reflection
// =====================================================

vec3 glossyReflectionLight =
    vec3(0.0);

float glossySpecularHitDistance =
    65504.0;


// =====================================================
// A3-3
// Primary GGX glossy reflection
//
// Full Monte-Carlo weight:
//
//     BRDF * NdotL / PDF
//
// 当前 sampleGGX() 采样 GGX NDF half-vector：
//
//     PDF(H) = D(H) * NdotH
//
// reflection 映射后：
//
//     PDF(L) = PDF(H) / (4 * VdotH)
// =====================================================
bool runGlossyRT =
    pbr2ReflectionStrength > 0.0;


float glossyLodWeight =
    1.0;


// 10-chunk GGX reflection budget.  The former 48-block hard stop produced
// black metal/specular regions.  Interleaved estimates retain the expected
// reflected radiance through 10 chunks; no RT reflection is traced beyond it.
// The full-resolution distance is the user "光泽全采样距离" setting
// (perfSecondary.w, 16/32/64/96 blocks).
float glossyFullResDistance =
    float(clamp(cam.perfSecondary.w, 16u, 96u));
if(
    rtLodDistance >= glossyFullResDistance &&
    rtLodDistance < 128.0 * perfL10TierScale()
)
{
    runGlossyRT =
        runGlossyRT &&
        rtLodGlossyHalfSample;

    glossyLodWeight =
        2.0;
}
else if(
    rtLodDistance >= 128.0 * perfL10TierScale() &&
    rtLodDistance < 160.0 * perfL10TierScale()
)
{
    runGlossyRT =
        runGlossyRT &&
        rtLodGlossyQuarterSample;

    glossyLodWeight =
        4.0;
}
else if(rtLodDistance >= 160.0 * perfL10TierScale())
{
    runGlossyRT = false;
}


if(perfL10DisableGlossy())
{
    runGlossyRT =
        false;
}

vec3 glossyRayNormal =
    normal;


vec3 glossyH =
    vec3(0.0);


vec3 glossyDir =
    vec3(0.0);


float glossyNdotV =
    0.0;


float glossyNdotL =
    0.0;


float glossyNdotH =
    0.0;


float glossyVdotH =
    0.0;


// Avoid sampling GGX and constructing reflection state for pixels whose
// distance/material LOD already disabled glossy RT.  The old code paid this
// math cost before the runGlossyRT guard below, even when no ray was traced.
if(runGlossyRT)
{
    glossyH =
        normalize(
            sampleGGX(
                glossyRayNormal,
                roughness,
                seed
            )
        );

    glossyDir =
        normalize(
            reflect(
                -V,
                glossyH
            )
        );

    glossyNdotV =
        max(
            dot(
                glossyRayNormal,
                V
            ),
            0.0
        );

    glossyNdotL =
        max(
            dot(
                glossyRayNormal,
                glossyDir
            ),
            0.0
        );

    glossyNdotH =
        max(
            dot(
                glossyRayNormal,
                glossyH
            ),
            0.0
        );

    glossyVdotH =
        max(
            dot(
                V,
                glossyH
            ),
            0.0
        );
}


if(
    runGlossyRT &&
    glossyNdotV > 1.0e-5 &&
    glossyNdotL > 1.0e-5 &&
    glossyNdotH > 1.0e-5 &&
    glossyVdotH > 1.0e-5
)
{
    // =================================================
    // LabPBR F0
    // =================================================

    vec3 glossyF0 =
        decodeBaseF0(
            f0MetalCode,
            albedo
        );


    vec3 glossyF =
        fresnelSchlick(
            glossyVdotH,
            glossyF0
        );


    // =================================================
    // GGX D / G
    // =================================================

    float glossyD =
        distributionGGX(
            glossyRayNormal,
            glossyH,
            roughness
        );


    float glossyG =
        geometrySmith(
            glossyRayNormal,
            V,
            glossyDir,
            roughness
        );


    // =================================================
    // Cook-Torrance GGX specular BRDF
    //
    // D * G * F
    // -------------------------
    // 4 * NdotV * NdotL
    // =================================================

    vec3 glossySpecularBRDF =
        (
            glossyD *
            glossyG *
            glossyF
        ) /
        max(
            4.0 *
            glossyNdotV *
            glossyNdotL,
            1.0e-5
        );


    // =================================================
    // GGX reflection PDF
    //
    // sampleGGX():
    //     PDF(H) = D * NdotH
    //
    // half-vector -> reflected direction:
    //     PDF(L) = PDF(H) / (4 * VdotH)
    // =================================================

    float glossySpecularPdf =
        max(
            (
                glossyD *
                glossyNdotH
            ) /
            max(
                4.0 *
                glossyVdotH,
                1.0e-5
            ),
            1.0e-5
        );


    // =================================================
    // Monte-Carlo throughput
    //
    // BRDF * cos(theta) / PDF
    // =================================================

    vec3 glossyWeight =
        (
            glossySpecularBRDF *
            glossyNdotL
        ) /
        glossySpecularPdf;


    vec3 incomingGlossyRadiance =
        tracePrimaryGlossyReflectionRadiance(
            hitPos,
            hitPos +
                glossyRayNormal * 0.001,
            glossyDir,
            sunDir,
            seed,
            glossySpecularHitDistance
        );


glossyReflectionLight =
    glossyWeight *
    incomingGlossyRadiance *
    glossyLodWeight;
}

if(s == 0 && matId <= 0.5)
{
    rrSpecularHitDistance =
        glossySpecularHitDistance;
}

                // ==========================================
                // 步骤 5: GI Bounce (2 次弹射路径追踪)
                // ==========================================
                vec3 indirectLight = vec3(0.0);
                vec3 currentOrigin =
    hitPos + normal * 0.001;
                vec3 currentDir = bounceDir;
vec3 currentThroughput =
    brdfWeight;

// =====================================================
// GI medium state
// =====================================================
bool currentInsideWater =
    false;

const vec3 GI_WATER_ABSORPTION =
    waterAbsorptionColor();

int diffuseBounceCount =
    0;

int waterInterfaceStepCount =
    0;


// Perf-L10.1 stage 8: the bounce cap is switchable at runtime so the cost of the
// second bounce can be measured directly as a partial delta against the baseline
// window.  Deliberately not `const`: it is read from the UBO.
int MAX_DIFFUSE_BOUNCES =
    perfL10GiBounceCap();

const int MAX_WATER_INTERFACE_STEPS =
    6;


// =====================================================
// 10-chunk Diffuse GI distance sampling
//
// 0-64    : 1.0 spp
// 64-128  : 0.5 spp temporal interleave
// 128-160 : 0.25 spp temporal interleave
// 160+    : disabled
// =====================================================

bool runDiffuseGI =
    true;


float diffuseGILodWeight =
    1.0;


if(
    rtLodDistance >= 64.0 * perfL10TierScale() &&
    rtLodDistance < 128.0 * perfL10TierScale()
)
{
    runDiffuseGI =
        rtLodHalfSample;

    diffuseGILodWeight =
        2.0;
}
else if(
    rtLodDistance >= 128.0 * perfL10TierScale() &&
    rtLodDistance < 160.0 * perfL10TierScale()
)
{
    runDiffuseGI =
        rtLodQuarterSample;

    diffuseGILodWeight =
        4.0;
}
else if(rtLodDistance >= 160.0 * perfL10TierScale())
{
    runDiffuseGI = false;
}


if(perfL10DisableDiffuseGi())
{
    runDiffuseGI =
        false;
}


while(
    runDiffuseGI &&
    diffuseBounceCount <
    MAX_DIFFUSE_BOUNCES
)
{
                    if(perfL10EnableGiRoulette())
                    {
                        // Perf-L10.1 stage 11: Russian-roulette survival with energy
                        // compensation, mirroring the reference renderer's policy.
                        // Unbiased in expectation: surviving paths carry the weight of
                        // the terminating ones back, so only the variance changes.
                        // Uses a private RNG state so the main sampling stream is not
                        // perturbed and the stage stays comparable to the baseline.
                        {
                            float rrLuminance = max(
                                max(currentThroughput.r, currentThroughput.g),
                                currentThroughput.b
                            );

                            float rrLow = clamp(
                                0.85 - sqrt(max(rrLuminance, 0.0)),
                                0.0,
                                1.0
                            );

                            float rrTermination = clamp(
                                rrLow * rrLow +
                                max(
                                    0.0,
                                    float(diffuseBounceCount) /
                                        float(MAX_DIFFUSE_BOUNCES) - 0.4
                                ),
                                0.0,
                                1.0
                            );

                            float rrSurvival = max(1.0 - rrTermination, 0.05);

                            uint rrState = seed ^ 0x9e3779b9u;
                            float rrRoll = float(pcg_hash(rrState) & 0x00ffffffu)
                                         / float(0x01000000u);

                            if(rrRoll >= rrSurvival)
                            {
                                break;
                            }

                            currentThroughput /= rrSurvival;
                        }
                    }

                    payload.hitDistance = 1.0;
                    payload.state = makeTraceState(
                        currentInsideWater ? RT_PURPOSE_WATER_MEDIUM : RT_PURPOSE_FULL
                    );

#ifdef RT_ENABLE_SER
                    // Perf-L10.7: the host alternates this every window so SER can
                    // be measured against a plain trace taken moments apart.  The
                    // flag lives in perfSerAb.x, a tail lane this shader never
                    // reads as anything else; perfPrimary.y must stay the RTAO
                    // mid-distance sample count or the A/B would bias that too.
                    if(cam.perfSerAb.x != 0u)
                    {
                        traceDiffuseSer(
                            currentOrigin,
                            currentDir,
                            uint(diffuseBounceCount) & 0x3u
                        );
                    }
                    else
                    {
                        traceRayEXT(topLevelAS, gl_RayFlagsNoneEXT, 0xff, 0, 0, 0, currentOrigin, 0.001, currentDir, 10000.0, 0);
                    }
#else
                    traceRayEXT(topLevelAS, gl_RayFlagsNoneEXT, 0xff, 0, 0, 0, currentOrigin, 0.001, currentDir, 10000.0, 0);
#endif

if (payload.hitDistance < 0.0) {
    indirectLight +=
        currentThroughput *
        payload.albedo *
        0.6;
    break;
} else {
vec3 nextHitPos =
    currentOrigin +
    currentDir *
    payload.hitDistance;

vec3 nextNormal =
    normalize(
        payload.normal
    );

vec3 nextAlbedo =
    payload.albedo;

vec3 nextEmission =
    payload.emission;

float nextMaterialId =
    getLegacyMaterialId(payload.state);

float nextF0Metal =
    payload.f0Metal;
    float nextRoughness =
    max(
        payload.roughness,
        0.05
    );

float nextPOMSelfShadow =
    clamp(
        payload.pomSelfShadow,
        0.0,
        1.0
    );
// =====================================================
// Beer-Lambert for the segment we JUST travelled
// =====================================================

bool nextHitIsWater =
    nextMaterialId > 0.5;

// 水背面命中意味着：
// 刚才这段射线是从水里面走到水面的。
bool hitWaterFromInside =
    nextMaterialId > 1.5;

bool segmentWasInsideWater =
    nextHitIsWater
        ? hitWaterFromInside
        : currentInsideWater;

if(segmentWasInsideWater)
{
    currentThroughput *=
        exp(
            -GI_WATER_ABSORPTION *
            payload.hitDistance
        );
}

// =====================================================
// GI water reflection
//
// 只处理真实水面反射：
// 洞壁 -> 水面 -> 天空
//
// 如果反射方向被洞穴遮挡，就不会获得天空光。
// 因此完全封闭的地下水不会凭空照亮洞穴。
// =====================================================
if (nextMaterialId > 0.5)
{
    waterInterfaceStepCount +=
        1;


    if(
        waterInterfaceStepCount >
        MAX_WATER_INTERFACE_STEPS
    )
    {
        break;
    }


    const float WATER_IOR =
        1.33;

    const float WATER_F0 =
        0.0200593;

    // =================================================
    // 1.0 = Air -> Water
    // 2.0 = Water -> Air
    // =================================================
    bool exitingWater =
        nextMaterialId > 1.5;

    vec3 interfaceNormal =
        stabilizeWaterInterfaceNormal(
            nextNormal
        );

    float cosTheta =
        clamp(
            -dot(
                currentDir,
                interfaceNormal
            ),
            0.0,
            1.0
        );

    float waterFresnel =
        WATER_F0 +
        (
            1.0 -
            WATER_F0
        ) *
        pow(
            1.0 -
            cosTheta,
            5.0
        );

    float waterChoice =
        rand(seed);


    if(
        waterChoice <
        waterFresnel
    )
    {
        // =============================================
        // Reflection
        //
        // 没有跨介质。
        // Air 仍是 Air。
        // Water 仍是 Water。
        // =============================================
        currentInsideWater =
            exitingWater;

        currentOrigin =
            nextHitPos +
            interfaceNormal *
            0.001;

        currentDir =
            normalize(
                reflect(
                    currentDir,
                    interfaceNormal
                )
            );
    }
    else
    {
        // =============================================
        // Transmission / Refraction
        // =============================================
        float eta =
            exitingWater
                ? WATER_IOR
                : (1.0 / WATER_IOR);

        vec3 refractedDir =
            refract(
                currentDir,
                interfaceNormal,
                eta
            );

        // Water -> Air 可能发生 TIR。
        if(
            dot(
                refractedDir,
                refractedDir
            ) < 1.0e-6
        )
        {
            // 全反射，所以仍然留在原介质。
            currentInsideWater =
                exitingWater;

            currentOrigin =
                nextHitPos +
                interfaceNormal *
                0.001;

            currentDir =
                normalize(
                    reflect(
                        currentDir,
                        interfaceNormal
                    )
                );
        }
        else
        {
            // 真正跨过界面。
            //
            // Air -> Water:
            //     currentInsideWater = true
            //
            // Water -> Air:
            //     currentInsideWater = false
            currentInsideWater =
                !exitingWater;

            currentOrigin =
                nextHitPos -
                interfaceNormal *
                0.001;

            currentDir =
                normalize(
                    refractedDir
                );
        }
    }

    continue;
}
vec3 nextUnifiedEmission =
    nextEmission +
evaluateVLIEmitterRadianceAtHit(
    nextHitPos,
    nextNormal,
    nextAlbedo
);
// =====================================================
// A3-2
// Secondary hit PBR direct sun lighting
//
// 使用与现有 PBR direct-light helper 相同的：
// - LabPBR F0 / metal
// - GGX NDF
// - Smith geometry
// - Schlick Fresnel
// - dielectric / metal energy split
// - real sun visibility / water transmittance
// =====================================================

vec3 bounceDirect =
    evaluateDirectSunLighting(
        nextHitPos,
        nextNormal,

        // 当前 GI ray 从上一表面射向这里，
        // 所以 secondary surface 的 outgoing/view direction
        // 是 currentDir 的反方向。
        normalize(
            -currentDir
        ),

        nextAlbedo,
        nextRoughness,
        nextF0Metal,
        nextPOMSelfShadow,
        sunDir
    );

// =====================================================
// Sun -> Water -> GI secondary surface
//
// 之前这条显式水面反射只作用于 Primary surface。
// 这里把同样经过真实水面 + 太阳可见性验证的能量
// 接入 secondary hit，使它能够继续通过 GI 传给当前表面。
// =====================================================

int nextF0MetalCode =
    int(
        round(
            clamp(
                nextF0Metal,
                0.0,
                1.0
            ) *
            255.0
        )
    );


float nextMetallic =
    nextF0MetalCode >= 230
        ? 1.0
        : 0.0;


float bounceWaterReflectedSunFactor =
    traceWaterReflectedSun(
        nextHitPos,
        nextNormal,
        sunDir
    );


vec3 bounceWaterReflectedSun =
    getTimeDrivenSkyLightColor() *
    3.2 *
    getTimeDrivenSkyLightRadianceScale() *
    nextAlbedo *
    (1.0 - nextMetallic) *
    bounceWaterReflectedSunFactor *
    c3CloudSunTransmittance(nextHitPos, sunDir);


// =====================================================
// G2B-1 baseline retained by G2B-2:
// No explicit Local-Light NEE on secondary surfaces
//
// Do not reconnect a GI hit to the old virtual emitter faces.
// Local-Light energy is accepted only when the current BSDF
// path itself reaches an emitter through nextUnifiedEmission.
// =====================================================

vec3 bounceLocalDiffuse =
    vec3(0.0);


indirectLight +=
    currentThroughput *
    (
        nextUnifiedEmission +
        bounceDirect +
        bounceWaterReflectedSun +
        bounceLocalDiffuse
    );
// =====================================================
// A3-1
// PBR secondary GI transport
//
// Opaque secondary surface:
//
// dielectric:
//     Diffuse + GGX Specular
//
// metal:
//     GGX Specular only
//
// Water interface 仍由上面的独立路径处理。
// =====================================================

diffuseBounceCount +=
    1;


// 当前已经达到最大 surface bounce，
// 不需要再生成一条永远不会被 trace 的方向。
if(
    diffuseBounceCount >=
    MAX_DIFFUSE_BOUNCES
)
{
    break;
}


vec3 nextV =
    normalize(
        -currentDir
    );


float nextNdotV =
    max(
        dot(
            nextNormal,
            nextV
        ),
        0.0
    );


if(nextNdotV <= 1.0e-5)
{
    break;
}


// -----------------------------------------------------
// LabPBR F0
// -----------------------------------------------------

vec3 nextF0 =
    decodeBaseF0(
        nextF0MetalCode,
        nextAlbedo
    );


// 用当前 viewing angle 的 Fresnel
// 作为 diffuse/specular mixture 的采样概率依据。
vec3 nextFForChoice =
    fresnelSchlick(
        nextNdotV,
        nextF0
    );


float nextFMax =
    max(
        max(
            nextFForChoice.r,
            nextFForChoice.g
        ),
        nextFForChoice.b
    );


// 金属没有 diffuse lobe，所以必须走 specular。
//
// 非金属根据 Fresnel 选择两种 lobe。
// 0.05 / 0.95 只影响采样概率和方差，
// 后面的 / probability 会补偿能量。
float nextSpecularProbability =
    nextMetallic > 0.5
        ? 1.0
        : clamp(
            nextFMax,
            0.05,
            0.95
        );


bool chooseNextSpecular =
    rand(seed) <
    nextSpecularProbability;


vec3 nextBounceDir =
    vec3(0.0);


vec3 nextBounceWeight =
    vec3(0.0);


// =====================================================
// GGX Specular branch
// =====================================================

if(chooseNextSpecular)
{
    vec3 nextH =
        normalize(
            sampleGGX(
                nextNormal,
                nextRoughness,
                seed
            )
        );


    float nextVdotH =
        max(
            dot(
                nextV,
                nextH
            ),
            0.0
        );


    float nextNdotH =
        max(
            dot(
                nextNormal,
                nextH
            ),
            0.0
        );


    nextBounceDir =
        normalize(
            reflect(
                -nextV,
                nextH
            )
        );


    float nextNdotL =
        max(
            dot(
                nextNormal,
                nextBounceDir
            ),
            0.0
        );


    if(
        nextVdotH <= 1.0e-5 ||
        nextNdotH <= 1.0e-5 ||
        nextNdotL <= 1.0e-5
    )
    {
        break;
    }


    vec3 nextF =
        fresnelSchlick(
            nextVdotH,
            nextF0
        );


    float nextD =
        distributionGGX(
            nextNormal,
            nextH,
            nextRoughness
        );


    float nextG =
        geometrySmith(
            nextNormal,
            nextV,
            nextBounceDir,
            nextRoughness
        );


    vec3 nextSpecularBRDF =
        (
            nextD *
            nextG *
            nextF
        ) /
        max(
            4.0 *
            nextNdotV *
            nextNdotL,
            1.0e-5
        );


    // sampleGGX() 当前采样的是 GGX half vector：
    //
    // PDF(H) = D(H) * NdotH
    //
    // reflection 映射：
    //
    // PDF(L) =
    // PDF(H) / (4 * VdotH)
    float nextSpecularPdf =
        max(
            (
                nextD *
                nextNdotH
            ) /
            max(
                4.0 *
                nextVdotH,
                1.0e-5
            ),
            1.0e-5
        );


    nextBounceWeight =
        (
            nextSpecularBRDF *
            nextNdotL
        ) /
        (
            nextSpecularPdf *
            max(
                nextSpecularProbability,
                1.0e-5
            )
        );
}


// =====================================================
// Diffuse branch
// =====================================================

else
{
    float nextDiffuseProbability =
        max(
            1.0 -
            nextSpecularProbability,
            1.0e-5
        );


    vec3 nextKD =
        (
            vec3(1.0) -
            nextFForChoice
        ) *
        (
            1.0 -
            nextMetallic
        );


    float g2bSecondaryMixtureWeight =
        1.0;


    g2bSampleDiffuseDirectionMIS(
        nextHitPos,
        nextNormal,
        seed,
        nextBounceDir,
        g2bSecondaryMixtureWeight
    );


    // Cosine hemisphere:
    //
    // BRDF = kD * albedo / PI
    // PDF  = NdotL / PI
    //
    // BRDF * NdotL / PDF
    // => kD * albedo
    nextBounceWeight =
        (
            nextKD *
            nextAlbedo *
            g2bSecondaryMixtureWeight
        ) /
        nextDiffuseProbability;
}


// =====================================================
// 保留当前已经稳定的 GI 总体能量尺度 0.7。
//
// A3-1 只验证 BRDF transport。
// 暂时不同时改变整体曝光 / GI 强度。
// =====================================================

currentThroughput *=
    nextBounceWeight *
    0.7;


currentOrigin =
    nextHitPos +
    nextNormal *
    0.001;


currentDir =
    nextBounceDir;


// 结束 opaque-hit else
}

// 结束 GI while
// 结束 GI while
}
indirectLight *=
    diffuseGILodWeight;


vec3 litColor =
    directLight +
    localDirectLight +
    localSecondaryLight +
    waterReflectedSunLight +
    glossyReflectionLight +
    indirectLight *
    1.8 *
    rtaoFactor;


// =====================================================
// RTX setting: Ambient base brightness


// =====================================================
// RTX setting: Ambient base brightness
//
// Final lighting =
// existing lighting + albedo * ambient base brightness
//
// This is independent of:
// - direct sunlight visibility
// - GI
// - glossy reflection
// - water reflection
// - shadow state
// =====================================================

float ambientBaseBrightness =
    clamp(
        cam.cameraParams.w,
        0.0,
        1.0
    );

// The user-controlled value remains the dusk/overcast baseline. At high sun
// it is reduced so an occluded surface is visibly separated from one lit by
// the direct shadow ray instead of reading as uniformly cloudy.
float noonShadowContrast = smoothstep(
    0.35,
    SOLAR_LATITUDE_35_COS,
    max(getTimeDrivenSunElevation(), 0.0)
);
ambientBaseBrightness *= mix(1.0, 0.55, noonShadowContrast);


vec3 ambientLight =
    albedo *
    ambientBaseBrightness;


sampleColor =
    emission +
    localEmitterEmission +
    litColor +
    ambientLight;
            }
        }

        // Apply the camera-to-first-visible-surface segment once.  Misses
        // already contain the physical sky from rmiss, and applying this
        // after all water/glass composition prevents double-fogging their
        // internal transport paths.
        if(primaryHitDistance > 0.0)
        {
            sampleColor = applyClearSkyAerialPerspective(
                sampleColor,
                origin.xyz,
                worldDir.xyz,
                primaryHitDistance
            );
        }

        accumulatedSampleColor += sampleColor;
    }

    // ==========================================
    // Perf-1.1
    // Custom Temporal removed from RayGen.
    // DLSS Ray Reconstruction receives current noisy linear HDR.
    // ==========================================
    vec3 finalColor =
        accumulatedSampleColor /
        float(SAMPLES_PER_FRAME);

    float sampleLuminance =
        dot(
            finalColor,
            vec3(0.2126, 0.7152, 0.0722)
        );

    if(sampleLuminance > 6.0)
    {
        finalColor *=
            6.0 / sampleLuminance;
    }

    vec3 currentColor =
        finalColor;

// The early primary-depth write describes the first hit, which is correct for
// opaque terrain.  A transmitted receiver overrides it here so RR reprojects
// the same surface whose radiance is present in currentColor.
if(rrTransparentReceiverGuideValid)
{
    vec4 receiverViewPos =
        viewMatrix *
        vec4(
            rrTransparentReceiverWorldPos,
            1.0
        );

    vec4 receiverClipPos =
        projectionMatrix *
        receiverViewPos;

    if(abs(receiverClipPos.w) > 1.0e-6)
    {
        float receiverDepth =
            clamp(
                receiverClipPos.z /
                receiverClipPos.w,
                0.0,
                1.0
            );

        imageStore(
            depthImage,
            pixelCoord,
            vec4(
                receiverDepth,
                0.0,
                0.0,
                0.0
            )
        );
    }
}


// =====================================================
// RR-6.2 - Write dense guide buffers once per pixel
// =====================================================

imageStore(
    rrDiffuseAlbedoImage,
    pixelCoord,
    vec4(
        rrDiffuseAlbedo,
        1.0
    )
);

imageStore(
    rrSpecularAlbedoImage,
    pixelCoord,
    vec4(
        rrSpecularAlbedo,
        1.0
    )
);

imageStore(
    rrNormalRoughnessImage,
    pixelCoord,
    rrNormalRoughness
);

imageStore(
    rrSpecularHitDistanceImage,
    pixelCoord,
    vec4(
        rrSpecularHitDistance,
        0.0,
        0.0,
        0.0
    )
);


// =====================================================
// RR-6.3 / RR-6.5 input contract
//
// DLSS Ray Reconstruction receives noisy linear HDR RT color.
// Custom temporal history stays available internally, but is not
// fed into RR. SDR display conversion will happen after RR.
// =====================================================

imageStore(
    image,
    pixelCoord,
    vec4(
        max(
            currentColor,
            vec3(0.0)
        ),
        1.0
    )
);
}
