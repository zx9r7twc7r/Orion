#version 460
#extension GL_GOOGLE_include_directive : require

#extension GL_EXT_ray_tracing : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#ifdef RT_ENABLE_SER
#extension GL_EXT_shader_invocation_reorder : require
#endif

// =====================================================
// Perf-L10.1 / LL-P1.1 GPU feature-isolation stage
//
// 0  baseline
// 1  disable RTAO rays only
// 2  disable primary GGX glossy-ray path only
// 3  disable diffuse-GI path only
// 4  disable all three paths above
// 5  disable G2B Local-Light guide scans only
// 6  disable Local-Emitter hit scans only
// 7  disable both Local-Light scan paths above
// 8  cap diffuse GI at one bounce
// 9  cap near-field RTAO at two rays
// 10 cap soft sun shadows at one ray
// 11 Russian-roulette termination in the diffuse-GI loop
// 12 cap the sun-transmittance-through-water march at one step
//
// The stage is a runtime value, not a compile-time #define: the native side
// cycles it every few hundred frames and writes it into perfPrimary.x, so one
// capture covers every stage instead of one rebuild-and-run per stage.
// perfPrimary is otherwise unread by this shader, so that lane carries only
// this switch.  The predicates live after the CameraProperties block, which is
// where `cam` first becomes visible.
// =====================================================


// LL-P3.1: Local-light energy now arrives through the bounded primary
// direct-light path below. Keep diffuse GI as a pure BSDF continuation;
// it must no longer scan or target the global local-light set.
const bool LL_P3_ENABLE_G2B_LOCAL_GUIDE =
    false;

layout(binding = 0, set = 0) uniform accelerationStructureEXT topLevelAS;
layout(binding = 1, set = 0, rgba16f) uniform image2D image;

layout(binding = 6, set = 0, rgba32f)
uniform image2D historyColor0;

layout(binding = 7, set = 0, r32f)
uniform image2D depthImage;

layout(binding = 8, set = 0, rgba32f)
uniform image2D historyColor1;

layout(binding = 9, set = 0, r32f)
uniform image2D historyDepth0;

layout(binding = 10, set = 0, r32f)
uniform image2D historyDepth1;

layout(binding = 11, set = 0, rgba16f)
uniform image2D historyNormal0;

layout(binding = 12, set = 0, rgba16f)
uniform image2D historyNormal1;

// =====================================================
// RR-6.2 - DLSS Ray Reconstruction Guide Buffers
// =====================================================

layout(binding = 13, set = 0, rgba16f)
uniform image2D rrDiffuseAlbedoImage;

layout(binding = 14, set = 0, rgba16f)
uniform image2D rrSpecularAlbedoImage;

layout(binding = 15, set = 0, rgba16f)
uniform image2D rrNormalRoughnessImage;

layout(binding = 16, set = 0, r32f)
uniform image2D rrSpecularHitDistanceImage;

// Glass scene-reflection hit distance, declared early because
// traceGlassSceneReflectionOneRay() (defined above the main block) writes it
// and the glass primary path reads it after the trace.  Lets RR reproject the
// pane's reflected content at the correct depth (opaque surfaces already do
// this via glossySpecularHitDistance).  Initialised to the sky/infinity value.
float rrGlassReflectionHitDistance = 65504.0;

// Declared before helper functions because the distance-budgeted VPT/RIS
// helper reads the camera origin from this UBO.
layout(binding = 2, set = 0) uniform CameraProperties {
    mat4 viewInverse;
    mat4 projInverse;
uvec2 vertexBufferAddr;
uint frameCount;
uint padding;

vec4 cameraParams;

uint historyReadIndex;
uint historyValid;
uint historyPadding0;
uint historyPadding1;

// Must match CameraUBO: two performance-control vec4 lanes precede history.
uvec4 perfPrimary;
uvec4 perfSecondary;

mat4 prevViewInverse;
mat4 prevProjInverse;

vec4 historyParams;

vec4 playerPositionAndWater;
vec4 playerVelocityAndSpeed;

vec4 waterSimSurfaceAndOrigin;
uvec4 waterSimState;
vec4 waterSimImpulse;
// x rain [0,1], y thunder [0,1], z dimension code: 0 other, 1 overworld,
// 2 nether, 3 end.  w is reserved for the next atmosphere stage.
vec4 weatherParams;
vec4 cloudParams0; // bottom, thickness, coverage, density
vec4 cloudParams1; // detail strength, wind speed, evolution, enabled
// Match the native CameraUBO cloudParams[40] and the miss shader layout.
vec4 cloudParams2; // view steps, light steps, extinction, history weight
vec4 cloudParams3; // world anchor x/z, cloud size, distribution variation
vec4 cloudParams4; // x = base feather, yzw = distance-fog gain / distance / height falloff
vec4 cloudParams5; // top brightness, bottom brightness, sunlight strength
vec4 cloudParams6;
vec4 cloudParams7;
vec4 cloudParams8;
vec4 cloudParams9;
// This pass reads none of the sky lanes either, but they are *not* optional:
// the native struct lays skyParams[8] out between cloudParams[40] and
// godRayParams[12], so a single vec4 here would slide every following read down
// by 16 bytes -- which is exactly how rainWallParams0 first landed on
// rainWallParams1's data.  Same trap volumetric_light.comp documents.
// x = sun disk luminance, y = halo strength, z = angular diameter, w = stars
vec4 skyParams0;
// x = sun-tint strength, y = physical sky enabled, z = scatter, w = ozone
vec4 skyParams1;
// Declared but unused: a std140 block may stop early, it may not skip a field
// and then continue, so these have to be named to reach the tail of the struct.
// Cost: nothing, they are never loaded.  See CameraUBO::rainWallParams for why
// the rain-wall block is a new tail field rather than extra cloudParams lanes.
vec4 godRayParams0;
vec4 godRayParams1;
vec4 godRayParams2;
vec4 rainWallParams0; // enabled, wetness scale, drip density, drip speed scale
vec4 rainWallParams1; // trail scale, effect distance, drip bump, reserved
// Water style dials (Waterlight turquoise look).  Same tail-chain rule: these
// must be named to reach the end of the native struct.
// x = wave scale, y = tint mix, z = density scale, w = caustic strength
vec4 waterStyleParams0;
vec4 waterStyleParams1;
// Perf-L10.7 - in-session SER A/B toggle.  Appended at the very tail on purpose:
// this shader reads every lane of perfPrimary and perfSecondary, so the toggle
// cannot share any of them without silently biasing the A/B against whatever
// feature that lane drives (it once sat on perfPrimary.y, which is the RTAO
// mid-distance sample count read below).  A tail block is also safe for the
// other shaders that declare this block: they stop before it, so no offset they
// read shifts.  x = toggle, yzw = reserved.
uvec4 perfSerAb;
} cam;

// =====================================================
// Perf-L10.1 - runtime GPU feature-isolation predicates
//
// See the stage table at the top of the file.  Reading the stage from the UBO
// keeps one compiled module valid for every stage, so the native sweep turns a
// single capture into every differential instead of one rebuild per stage.
//
// Stages 8-10 reduce ray counts rather than switching a path off, so the cost of
// the second GI bounce, of full near-field RTAO, and of two-sample soft shadows
// can each be measured as a partial delta.
// =====================================================

uint perfL10Stage()
{
    // Stage ablation is disabled (PERF_L10_ENABLE_STAGE_ABLATION = false on the
    // C++ side), so perfPrimary.x now carries the user "RTAO 近距采样" setting
    // (aoNearSamples, 0-4).  Every perfL10Xxx() diagnostic below therefore takes
    // its normal-play branch and the sweep never engages.
    return 0u;
}

bool perfL10DisableRtao()
{
    return perfL10Stage() == 1u ||
           perfL10Stage() == 4u;
}

bool perfL10DisableGlossy()
{
    return perfL10Stage() == 2u ||
           perfL10Stage() == 4u;
}

bool perfL10DisableDiffuseGi()
{
    return perfL10Stage() == 3u ||
           perfL10Stage() == 4u;
}

bool perfL10DisableG2bLocalGuide()
{
    return perfL10Stage() == 5u ||
           perfL10Stage() == 7u;
}

bool perfL10DisableLocalEmitterHitScan()
{
    return perfL10Stage() == 6u ||
           perfL10Stage() == 7u;
}

// Stage 8: cap the diffuse-GI path at one bounce, so the difference against the
// baseline window is the cost of the second bounce alone.  In normal play
// (stage 0) the value comes from the user "GI 跳数" setting (perfPrimary.z).
int perfL10GiBounceCap()
{
    if(perfL10Stage() == 8u)
    {
        return 1;
    }
    return clamp(int(cam.perfPrimary.z), 0, 2);
}

// Stage 9: cap near-field RTAO at two rays instead of four.
int perfL10AoSampleCap()
{
    return perfL10Stage() == 9u
        ? 2
        : 4;
}

// Stage 10: cap soft-sun-shadow sampling at one ray instead of two.  In normal
// play (stage 0) the value comes from the user "太阳阴影采样" setting
// (perfPrimary.w, 1 or 2).
int perfL10ShadowSampleCap()
{
    if(perfL10Stage() == 10u)
    {
        return 1;
    }
    return clamp(int(cam.perfPrimary.w), 1, 2);
}

// Stage 11 enables the Russian-roulette block in the diffuse-GI loop.  It is a
// runtime predicate rather than a preprocessor switch because the stage is a
// UBO value: the baseline module executes the same branch and simply falls
// through, so one compiled module still serves every stage.
bool perfL10EnableGiRoulette()
{
    return perfL10Stage() == 11u;
}

// Stage 12: cap the sun-transmittance march so its cost is measurable.
int perfL10MarchCap()
{
    return perfL10Stage() == 12u
        ? 1
        : 6;
}

// Stage 13: halve every distance-LOD threshold.  The tier chain was measured
// never to engage, so this stage answers whether it has any headroom before we
// spend effort on thresholds or on the distance signal itself.
float perfL10TierScale()
{
    return perfL10Stage() == 13u
        ? 0.5
        : 1.0;
}

// Binding 34 is the local Evan-style wavefront-area caustic map.  R contains
// natural-wave density; G includes the player interaction field and is used
// only on the matching water elevation.
layout(binding = 34, set = 0) uniform sampler2D waterCausticMap;

// Static Tyndall 3D fields uploaded once by VulkanCore. They are not tied to
// the Minecraft atlas and therefore remain valid across resource-pack reloads.
layout(binding = 38, set = 0) uniform sampler3D cloudShapeNoise;
layout(binding = 39, set = 0) uniform sampler3D cloudCurlNoise;

// =====================================================
// RT Local Lights - L3 GPU probe input
// =====================================================

struct LocalLightGPU
{
    vec4 worldPosEmission;
    uvec4 meta;
};

layout(std430, binding = 17, set = 0) readonly buffer LocalLightBuffer
{
    uvec4 header;
    LocalLightGPU lights[];
} localLightBuffer;


// =====================================================
// LL-P2.1 - Binding 18 Local-Light spatial grid
//
// C++ payload (std430 words):
//   [0..3]                     header
//   [4..4 + hashCapacity*8)    8-word hash slots
//   remaining words             packed Binding-17 light indices
//
// A light has a maximum 30-block range while a grid cell is 64 blocks.
// At runtime we visit the receiver cell plus only those face/edge/corner
// neighbors whose shared boundary is within 30 blocks. That is 1 cell in
// the interior and at most 8 cells at a grid corner.
// =====================================================
layout(std430, binding = 18, set = 0) readonly buffer LocalLightGridBuffer
{
    uint words[];
} localLightGridBuffer;

// ReSTIR DI ping-pong reservoirs. This is exactly five std430 vec4 lanes
// (80 bytes), matching ReSTIRDIReservoirGPU in VulkanCore.cpp. `lightIndex`
// stores the packed VPT emitter record; emitterNormalAndTargetPdf.x stores
// the source emitter-page index because local voxel emitters are point/area
// proxies and do not have a persistent geometric normal.
struct ReSTIRDIReservoir
{
    vec4 sampleAndAreaPdf;
    vec4 emitterNormalAndTargetPdf;
    vec4 receiverPositionAndViewDepth;
    vec4 receiverNormalAndWeight;
    uvec4 metadata;
};

layout(std430, binding = 19, set = 0) buffer ReSTIRDIReservoirBuffer0
{
    ReSTIRDIReservoir entries[];
} restirDIReservoirBuffer0;

layout(std430, binding = 20, set = 0) buffer ReSTIRDIReservoirBuffer1
{
    ReSTIRDIReservoir entries[];
} restirDIReservoirBuffer1;


// =====================================================
// VPT-3.2B Section voxel directional irradiance cache
//
// Binding 22 is a sparse Section->page table. Binding 23 holds the
// 16^3 source voxels followed by six 9^3 HDR directional probe fields
// per page. The compute pass updates changed pages only; RayGen samples
// eight nearby probes and chooses their directional response by normal.
// =====================================================
layout(std430, binding = 22, set = 0) readonly buffer VLIPageTableBuffer
{
    uint words[];
} vliPageTableBuffer;

layout(std430, binding = 23, set = 0) readonly buffer VLIPagesBuffer
{
    uint words[];
} vliPagesBuffer;

// VPT-3.3A.1 legacy secondary directional probe storage.  VPT-3.3B.1 no
// longer reads it on the primary path; it remains bound only to preserve the
// established descriptor layout while the correct surface path is verified.
layout(std430, binding = 24, set = 0) readonly buffer VLISecondaryPagesBuffer
{
    uint words[];
} vliSecondaryPagesBuffer;

// VPT-3.1 authoritative exact emitter index.  Every non-zero emitter in a
// source Section is represented once as a packed uint; D.7 samples it through
// the compact nearby source-Section directory below.
layout(std430, binding = 28, set = 0) readonly buffer VPTEmitterIndexPagesBuffer
{
    uint words[];
} vptEmitterIndexPagesBuffer;

// VPT-3.3C.1: eight bounded candidate emitters per receiver Section.  RayGen
// ranks them at the real hardware-RT hit and traces only the best four.
layout(std430, binding = 29, set = 0) readonly buffer VPTCandidatePagesBuffer
{
    uvec4 entries[];
} vptCandidatePagesBuffer;

// VPT-3.4: entry zero stores the source-section count and a revision for this
// receiver's Alias distribution. Remaining entries are a receiver-specific
// Alias table (power x Section-bound-distance) with an explicit selected-entry
// PDF for unbiased single-frame RIS.
struct VPTSourceDirectoryEntry {
    uint pageIndex;
    uint emitterCountAndOffset;
    uint aliasThresholdQ16;
    uint aliasIndex;
    float selectionProbability;
};
layout(std430, binding = 31, set = 0) readonly buffer VPTSourceDirectoryPagesBuffer
{
    VPTSourceDirectoryEntry entries[];
} vptSourceDirectoryPagesBuffer;

// One Alias word per exact emitter-index record. low16=cutoff, high16=alias.
layout(std430, binding = 32, set = 0) readonly buffer VPTEmitterAliasPagesBuffer
{
    uint words[];
} vptEmitterAliasPagesBuffer;

// VPT-3.3B.1: one direct irradiance sample for every exact voxel face.
// Unlike the 9^3 probe fields this buffer is addressed from the primary
// hardware-RT hit itself and is never trilinearly interpolated through air.
layout(std430, binding = 30, set = 0) readonly buffer VPTSurfaceFaceBuffer
{
    uint words[];
} vptSurfaceFaceBuffer;

// VPT-2.2 primary-DDA temporal history.  Bindings 26/27 are deliberately
// independent from the existing ReSTIR DI Reservoir bindings 19/20.
// Layout exactly matches VPTDirectHistoryGPU in VulkanCore.cpp.
struct VPTDirectHistory
{
    vec4 radianceAndSampleCount;
    vec4 hitPositionAndValid;
    vec4 normalAndPadding;
};

layout(std430, binding = 26, set = 0) buffer VPTDirectHistoryBuffer0
{
    VPTDirectHistory entries[];
} vptDirectHistoryBuffer0;

layout(std430, binding = 27, set = 0) buffer VPTDirectHistoryBuffer1
{
    VPTDirectHistory entries[];
} vptDirectHistoryBuffer1;

const float VPT_SCREEN_POSITION_EPSILON = 0.35;
const float VPT_SCREEN_NORMAL_COSINE = 0.92;
const float VPT_SCREEN_MAX_HISTORY = 8.0;

const uint VLI_PAGE_TABLE_CAPACITY = 8192u;
const uint VLI_SOURCE_WORDS = 4096u;
const uint VLI_PROBE_EDGE = 9u;
const uint VLI_PROBE_WORDS = VLI_PROBE_EDGE * VLI_PROBE_EDGE * VLI_PROBE_EDGE;
const uint VPT_DIRECTION_COUNT = 6u;
const uint VPT_DIRECTIONAL_CACHE_WORDS = VPT_DIRECTION_COUNT * VLI_PROBE_WORDS; // 4374 uint
const uint VLI_PAGE_WORDS = VLI_SOURCE_WORDS + VPT_DIRECTIONAL_CACHE_WORDS;
const uint VPT_SURFACE_FACE_WORDS = VLI_SOURCE_WORDS * VPT_DIRECTION_COUNT;
const uint VPT_RELATED_EMITTERS_PER_SECTION = 8u;
const uint VPT_EMITTER_HEADER_WORDS = 4u;
const uint VPT_EMITTER_PAGE_WORDS = VPT_EMITTER_HEADER_WORDS + VLI_SOURCE_WORDS;
const uint VPT_MAX_SECTION_PAGES = 4096u;
const uint VPT_SOURCE_DIRECTORY_MAX_SECTIONS = 125u;
const uint VPT_SOURCE_DIRECTORY_ENTRIES_PER_PAGE =
    1u + VPT_SOURCE_DIRECTORY_MAX_SECTIONS;
// VPT-3.3D.7: two unbiased proposals from all non-empty source Sections in
// the local 5x5x5 neighborhood, then one selected visibility DDA.
const uint VPT_RIS_CANDIDATE_COUNT = 2u;
const uint VPT_PRIMARY_DDA_LIGHTS = 4u;
// Legacy C.4 constants retained only for the paused area-light history path.
const uint VPT_AREA_LIGHT_SAMPLES = 12u;
const uint VPT_AREA_LIGHT_HISTORY_SAMPLES = 96u;
const float VPT_LOCAL_MAX_DISTANCE = 30.0;
const float VPT_LOCAL_RANGE_PER_EMISSION = 2.0;
const float VPT_LOCAL_FADE_START_FRACTION = 0.40;
const float VPT_LOCAL_LIGHT_AREA_SIZE = 2.0;
const uint VPT_STAINED_GLASS_BIT = 1u << 24u;

// =====================================================
// 临时诊断开关：判定本地光染色链路是否真的有数据（定位后删除）
//
// 本地光的玻璃染色与太阳光路是两套完全独立的数据源：
//   太阳   -> 硬件射线命中 -> 顶点 byte27 marker -> C++ applyStainedGlassDyeToRTVertex
//   本地光 -> 体素 DDA      -> voxel word bit24 + RGB555 染料色
//             （由 Java SectionCompilerMixin 写入）
//
// 「一路径一颜色」版诊断的问题：二级弹射对**整个半球**采样，附近任何一条
// 采样光线穿过彩玻都会命中标记 ⇒ 标出来的区域**远大于**光斑本身，因此
// 无法判断光斑究竟由谁主导（上一轮的「红」就是这种误读）。
//
// 这一版改成**能量占比图**：把三个候选本地光项分别写进 RGB 三个通道，
// 每题通道值 = 该项亮度（clamp 到 1）。看光斑的通道占比即可判定主导项：
//
//   R = applyLocalGlassTint           本地光直射（走玻璃过滤）
//   G = evaluateVPTLocalSecondaryBounce  本地光二级弹射（走烘焙缓存）
//   B = evaluateVLIEmitterRadianceAtHit  唯一**无玻璃过滤**的假发光
//
// 红 ⇒ 直射主导；绿 ⇒ 二级弹射主导；蓝 ⇒ 无过滤项主导；
// 三通道都暗 ⇒ 三者都不是，白光另有出处。
//
// 必须在所有使用点之前声明：GLSL 单遍编译，后置声明会报未声明标识符。
// =====================================================
const bool DBG_LOCAL_TERM_MAP = false;
// 保留以兼容既有构建历史：它守护的「路径纯色标记」已撤除。
const bool DBG_STAINED_GLASS_MARK = false;

// =====================================================
// 判决实验 D（定位后删除）：分清「真凶是未过滤项」还是「走了染色但被裁白」
//
// 前几版诊断都把「有颜色」和「是这条路径」混为一谈：
//   二级弹射对整个半球采样，命中彩玻标记的区域远大于光斑本身；
//   能量占比图能看出谁「亮」，却看不出谁「带颜色」。
//
// 这一版把两件事同时写进同一像素：
//   R = 该项自身的**染料色**（能量归一后，只反映颜色，不反映亮度）
//   G = 该项的**能量**（luma clamp 到 1）
//
// 于是同一次重载就能回答「近段那片白有没有经过彩玻」：
//   R 暗 + G 亮  => 那道白光**没有任何染料**，即未经过彩玻  ⇒ 真凶是无过滤项
//   R 亮 + G 亮  => 经过了彩玻，颜色数据也在      ⇒ 纯粹是能量过高被末端裁白
//
// 编码规则：R 通道 = 染料通道里的**最大者减去最小者**（纯色⇒1，白色⇒0），
// 这样「有没有染料」直接读作 R 的亮度，不受该项整体能量影响。
// =====================================================
// 判决实验 D 的总开关：默认关闭，置 true 时三个本地光项都改画
// 「染料浓度(R) × 能量(G)」。与 DBG_GLASS_DYE_VS_ENERGY_SECONDARY 独立，
// 后者只作用二级弹射，用于把读数收窄到单独一项。
const bool DBG_GLASS_DYE_VS_ENERGY = false;

// =====================================================
// 判决实验 H2（一次定案版）：把「谁贡献了光斑」与「谁带了染色」
// 分成两块，用屏幕**左半边 / 右半边**分别显示，一次重载读完。
//
//   屏幕左半 = 只留 localSecondaryLight（带染色的二级弹射）
//                + 太阳/天空等所有非本地光项 **不变**
//   屏幕右半 = 只留 localEmitterEmission（无过滤自发光）
//                + 太阳/天空等所有非本地光项 **不变**
//
// 判读（把准星对准彩玻后的光斑，看它落在哪半边还亮）：
//   左亮右暗 ⇒ 光斑来自二级弹射（有染色）⇒ 问题在染色/裁切
//   左暗右亮 ⇒ 光斑来自无过滤自发光     ⇒ 问题在这条缺过滤的路径
//   两边都亮 ⇒ 两者都在贡献，需分别压
//   两边都暗 ⇒ 光斑根本不是本地光加进来的
//
// 用片元坐标分屏，不依赖任何数值编码，因此不会被末端 pow/裁剪干扰。
// =====================================================
// 已撤销：该实验证明这两项对「透过彩玻的本地光」无贡献
// （用户报「看着没变化」），因为玻璃后的接收面走的是
// tracePrimaryGenericTransparentRadiance → evaluateVPTRISDirectLightingSingle
// 这条独立分支，与这两项无关。
const bool DBG_SPLIT_ABLATION = false;

// 判决实验 I：DDA 覆盖率探针（详见 vptTraceGlassTransmissionToEmitter 尾部）。
// true 时该项输出 (穿过的染色玻璃片数, DDA 步数) 而非真实透射率。
const bool DBG_VPT_DDA_PROBE = true;

// =====================================================
// 判决实验 H（ablation，逐项物理隔离；DBG_SPLIT_ABLATION=false 时才生效）
// =====================================================
const bool DBG_KILL_EMITTER_TERM = false;
const bool DBG_KILL_SECONDARY_TERM = false;

// =====================================================
// 判决实验 E：直接暴露二级弹射的染料与能量（同上编码，只作用于
// evaluateVPTLocalSecondaryBounce）。默认关闭，置 true 即启用。
// =====================================================
const bool DBG_GLASS_DYE_VS_ENERGY_SECONDARY = false;

// =====================================================
// 判决实验 F：读出二级弹射的**色调纯度**（比值型，不受末端裁剪影响）。
//
// 上一版读绝对峰值失败：R = clamp(peak / SCALE) 之后仍要走 rr_sdr_post，
// 而那里对 >1 的通道逐通道硬裁 ⇒ R 恒被钉在 1，读不出任何量级。
// 把尺子伸进它自己要测的裁切区里，是编码错误。
//
// 这一版只读**比值**，恒 <= 1，永远不会被裁：
//   R = 染料纯度 = (max3 - min3) / max3   （纯色⇒1，白⇒0）
//   G = 弱通道占比 = 第二通道 / max3       （纯红(1,0,0)⇒0，泛白(1,.8,.8)⇒0.8）
//
// 判读近段光斑：
//   G 暗（<0.2）  => 颜色是纯的，泛白只是高亮度的主观感受 => 只需压整体亮度
//   G 亮（>0.5）  => 弱通道真被抬起 => 有第二个源在同一处加白，顺着找它
// =====================================================
// 判决实验 G：把「有没有染色」与「弱通道占比」分开编码。
//
// F-2 的结果（整屏纯绿）有两种完全不同的解释，必须分开：
//   (a) glassTransmission 真的接近白  ⇒ 纯度和弱通道占比都退化成 1（纯绿）
//   (b) 这项返回值被用在大量像素上、且该项根本没被染色 ⇒ 也是纯绿
// 判据：把「透射率是否严格等于 (1,1,1)」单独拿出来：
//   R = 1 - 弱通道占比（(b) 那种「颜色纯」的度量）
//   G = 1 - 纯度        （白 ⇒ 1；有色 ⇒ 0）
//   B = 纯白标记         （transmission == (1,1,1) ⇒ 1，否则 0）
// 判读：
//   B 亮  ⇒ 根本没染色（透射率恒白）——染色链路在那处没生效
//   B 暗 + G 亮 ⇒ 有染色但接近白（被抬灰）
//   B 暗 + G 暗 ⇒ 染色饱和、颜色纯
vec3 dbgHuePurity2(vec3 transmission)
{
    vec3 v = max(transmission, vec3(0.0));
    float peak = max(v.r, max(v.g, v.b));
    float floorValue = min(v.r, min(v.g, v.b));
    bool isPureWhite = all(equal(v, vec3(1.0)));
    if(peak <= 1.0e-6)
    {
        return vec3(0.0, 1.0, isPureWhite ? 1.0 : 0.0);
    }
    float second = 0.0;
    if(peak == v.r)
    {
        second = max(v.g, v.b);
    }
    else if(peak == v.g)
    {
        second = max(v.r, v.b);
    }
    else
    {
        second = max(v.r, v.g);
    }
    return vec3(
        clamp(1.0 - (peak - floorValue) / peak, 0.0, 1.0),
        clamp(1.0 - second / peak, 0.0, 1.0),
        isPureWhite ? 1.0 : 0.0
    );
}

const bool DBG_GLASS_PEAK_READOUT = false;
const float DBG_PEAK_SCALE = 64.0;


const vec3 DBG_TERM_LUMA = vec3(0.2126, 0.7152, 0.0722);

float dbgTermLuma(vec3 value)
{
    return clamp(dot(max(value, vec3(0.0)), DBG_TERM_LUMA), 0.0, 1.0);
}

// 染色浓度：纯色 ⇒ 1，中性白 ⇒ 0。拒绝任何整体亮度的干扰。
float dbgDyeConcentration(vec3 value)
{
    vec3 v = max(value, vec3(0.0));
    return clamp(
        max(v.r, max(v.g, v.b)) - min(v.r, min(v.g, v.b)),
        0.0,
        1.0
    );
}
// User-confirmed global local-light energy. Sampling, emitter geometry,
// candidate count, and attenuation curves remain unchanged.
const float LOCAL_LIGHT_ENERGY_SCALE = 0.35;
// Saturation of the stained-glass RGB filter on the primary opaque-receiver
// VPT path.  Peak transmission stays unchanged, so this changes colour
// concentration without increasing local-light energy or range.
// 3.0 matches the confirmed rt_vpt_irradiance.comp bake filter.
const float STAINED_GLASS_TRANSMISSION_SATURATION = 3.0;

// Peak-preserving saturation boost of the stained-glass RGB filter.  Mirrors
// rt_vpt_irradiance.comp's bake filter exactly: the maximum channel is kept,
// the channel differences are amplified, so dye concentration rises without
// changing local-light energy or range.
vec3 vptSaturateGlassTransmission(vec3 transmission)
{
    float peak = max(transmission.r, max(transmission.g, transmission.b));
    return clamp(
        vec3(peak) +
            (transmission - vec3(peak)) *
            STAINED_GLASS_TRANSMISSION_SATURATION,
        vec3(0.0),
        vec3(peak)
    );
}

// Local-light exposure guard: hue-preserving peak fold-back.
//
// The local-light terms are HDR by construction.  vliUnpackRadiance() returns
// 0..~8 irradiance, and the secondary bounce multiplies that by
// bounceAlbedo / PI, 0.92 and the receiver albedo, so a single sample peaks
// well above 2.0.  rr_sdr_post.comp ends with a bare pow(color, 1/2.2) and has
// no tone curve, so it clamps every channel on its own: a red-glass sample of
// (2.3, 0.6, 0.6) has its strongest channel pinned at 1.0 and washes out to
// white -- the channel ratios, i.e. the glass colour, collapse exactly at the
// clip point.  That is why the local-light pool behind stained glass reads
// white and gets whiter the closer (hence brighter) the receiver is, while the
// sun paths, whose energy stays below 1.0, never clip and look correct.
//
// Folding the peak back with one shared scalar keeps every channel ratio
// identical, so hue survives; values at or below 1.0 are returned untouched,
// so mid-tones and overall exposure do not move, and the sun paths are not
// affected at all.
vec3 toneKeepHueLocal(vec3 value)
{
    // 判决实验期间关闭压制，只读原始能量（见 DBG_GLASS_DYE_VS_ENERGY_*）
    if(DBG_GLASS_DYE_VS_ENERGY || DBG_GLASS_DYE_VS_ENERGY_SECONDARY)
    {
        return value;
    }
    float peak = max(value.r, max(value.g, value.b));
    if(peak <= 1.0)
    {
        return value;
    }
    return value * (1.0 / peak);
}
// VPT-3.4A: one local-light indirect DDA from the primary receiver.
const float VPT_LOCAL_BOUNCE_MAX_DISTANCE = 12.0;


uint vliHash32(ivec3 sectionCoord)
{
    uint h = uint(sectionCoord.x) * 0x8da6b343u;
    h ^= uint(sectionCoord.y) * 0xd8163841u;
    h ^= uint(sectionCoord.z) * 0xcb1ab31fu;
    h ^= h >> 16u;
    h *= 0x7feb352du;
    h ^= h >> 15u;
    h *= 0x846ca68bu;
    h ^= h >> 16u;
    return h;
}


bool vliLookupSectionPage(ivec3 sectionCoord, out uint pageIndex)
{
    uint slot = vliHash32(sectionCoord) & (VLI_PAGE_TABLE_CAPACITY - 1u);
    for(uint probe = 0u; probe < VLI_PAGE_TABLE_CAPACITY; ++probe)
    {
        uint base = slot * 4u;
        uint pagePlusOne = vliPageTableBuffer.words[base + 3u];
        if(pagePlusOne == 0u)
        {
            pageIndex = 0u;
            return false;
        }

        if(
            int(vliPageTableBuffer.words[base + 0u]) == sectionCoord.x &&
            int(vliPageTableBuffer.words[base + 1u]) == sectionCoord.y &&
            int(vliPageTableBuffer.words[base + 2u]) == sectionCoord.z
        )
        {
            pageIndex = pagePlusOne - 1u;
            return true;
        }

        slot = (slot + 1u) & (VLI_PAGE_TABLE_CAPACITY - 1u);
    }

    pageIndex = 0u;
    return false;
}


int vliFloorDiv(int value, int divisor)
{
    return value >= 0 ? value / divisor : -((-value + divisor - 1) / divisor);
}


int vliPositiveMod(int value, int divisor)
{
    int result = value % divisor;
    return result < 0 ? result + divisor : result;
}


uint vliReadSourceVoxel(ivec3 worldBlock)
{
    ivec3 sectionCoord = ivec3(
        vliFloorDiv(worldBlock.x, 16),
        vliFloorDiv(worldBlock.y, 16),
        vliFloorDiv(worldBlock.z, 16)
    );
    uint pageIndex;
    if(!vliLookupSectionPage(sectionCoord, pageIndex))
    {
        return 0u;
    }

    ivec3 local = ivec3(
        vliPositiveMod(worldBlock.x, 16),
        vliPositiveMod(worldBlock.y, 16),
        vliPositiveMod(worldBlock.z, 16)
    );
    uint index = uint(local.x) + 16u * (uint(local.z) + 16u * uint(local.y));
    return vliPagesBuffer.words[pageIndex * VLI_PAGE_WORDS + index];
}


vec3 vliDecodeEmitterColor(uint typeCode)
{
    if(typeCode == 1u) return vec3(1.0, 0.55, 0.20);
    if(typeCode == 2u) return vec3(0.20, 0.75, 1.0);
    if(typeCode == 3u) return vec3(1.0, 0.12, 0.06);
    if(typeCode == 4u) return vec3(1.0, 0.27, 0.05);
    return vec3(1.0, 0.82, 0.48);
}

vec3 sampleHemisphereCosine(vec3 normal, inout uint state);
vec3 vptDominantBlockFaceNormal(vec3 normal);

// Defined next to the glass optical model; needed by the local-light direct
// lighting path above it.
vec3 strengthenLocalGlassTint(vec3 transmittance);
vec3 applyLocalGlassTint(vec3 radiance, vec3 transmittance);

vec3 evaluateOpaqueSurfaceRadiance(
    vec3 hitPos,
    vec3 hitNormal,
    vec3 viewDir,
    vec3 hitAlbedo,
    float hitRoughness,
    float hitF0Metal,
    vec3 hitEmission,
    float pomSelfShadow,
    vec3 sunDirection
);


vec3 evaluateVLIEmitterRadianceAtHit(
    vec3 hitPos,
    vec3 hitNormal,
    vec3 hitAlbedo
)
{
    vec3 blockFaceNormal = vptDominantBlockFaceNormal(hitNormal);
    ivec3 sourceBlock = ivec3(floor(hitPos - blockFaceNormal * 0.02));
    uint source = vliReadSourceVoxel(sourceBlock);
    uint emission = (source >> 2u) & 15u;
    if(emission == 0u)
    {
        return vec3(0.0);
    }

    // 诊断（B 通道）：唯一**既无玻璃过滤、也无可见性射线/遮挡**的本地光
    // 贡献——它直接把命中面背后那个发光方块的发射色当光叠加。
    vec3 safeAlbedo = max(hitAlbedo, vec3(0.0));
    vec3 emitterTerm = vliDecodeEmitterColor((source >> 6u) & 7u) *
        3.2 *
        LOCAL_LIGHT_ENERGY_SCALE *
        (float(emission) / 15.0) *
        safeAlbedo;
    if(DBG_LOCAL_TERM_MAP)
    {
        return vec3(0.0, 0.0, dbgTermLuma(emitterTerm));
    }
    if(DBG_GLASS_DYE_VS_ENERGY)
    {
        // R = 该项的染料浓度（它**没有**做玻璃过滤，所以应当恒为 0）
        // G = 该项的能量
        return vec3(
            dbgDyeConcentration(vliDecodeEmitterColor((source >> 6u) & 7u)),
            dbgTermLuma(emitterTerm),
            0.0
        );
    }
    return emitterTerm;
}

vec3 vliUnpackRadiance(uint packed)
{
    return vec3(
        float( packed        & 255u),
        float((packed >> 8u) & 255u),
        float((packed >> 16u) & 255u)
    ) * (1.0 / 32.0);
}

vec3 vptDominantBlockFaceNormal(vec3 normal)
{
    vec3 n = normalize(normal);
    vec3 a = abs(n);
    if(a.x >= a.y && a.x >= a.z)
    {
        return vec3(n.x >= 0.0 ? 1.0 : -1.0, 0.0, 0.0);
    }
    if(a.y >= a.z)
    {
        return vec3(0.0, n.y >= 0.0 ? 1.0 : -1.0, 0.0);
    }
    return vec3(0.0, 0.0, n.z >= 0.0 ? 1.0 : -1.0);
}

uint vptFaceIndexFromBlockFaceNormal(vec3 normal)
{
    if(normal.x > 0.5) return 0u;
    if(normal.x < -0.5) return 1u;
    if(normal.y > 0.5) return 2u;
    if(normal.y < -0.5) return 3u;
    if(normal.z > 0.5) return 4u;
    return 5u;
}

// Exact primary local-light response.  payload.normal may include POM detail,
// so only its dominant axis is used to recover the owning Minecraft block
// face.  The current PBR/POM albedo is applied once after the cached
// face-to-emitter DDA irradiance lookup.
vec3 evaluateVPTExactFaceDirectLighting(
    vec3 hitPos,
    vec3 shadingNormal,
    vec3 hitAlbedo
)
{
    vec3 blockFaceNormal = vptDominantBlockFaceNormal(shadingNormal);
    ivec3 worldBlock = ivec3(floor(hitPos - blockFaceNormal * 0.02));
    ivec3 sectionCoord = ivec3(
        vliFloorDiv(worldBlock.x, 16),
        vliFloorDiv(worldBlock.y, 16),
        vliFloorDiv(worldBlock.z, 16)
    );
    uint pageIndex;
    if(!vliLookupSectionPage(sectionCoord, pageIndex))
    {
        return vec3(0.0);
    }

    ivec3 local = ivec3(
        vliPositiveMod(worldBlock.x, 16),
        vliPositiveMod(worldBlock.y, 16),
        vliPositiveMod(worldBlock.z, 16)
    );
    uint voxelIndex = uint(local.x) + 16u *
        (uint(local.z) + 16u * uint(local.y));
    uint source = vliPagesBuffer.words[pageIndex * VLI_PAGE_WORDS + voxelIndex];
    if((source & 3u) != 1u)
    {
        return vec3(0.0);
    }

    uint packedIrradiance = vptSurfaceFaceBuffer.words[
        pageIndex * VPT_SURFACE_FACE_WORDS +
        voxelIndex * VPT_DIRECTION_COUNT +
        vptFaceIndexFromBlockFaceNormal(blockFaceNormal)
    ];
    return vliUnpackRadiance(packedIrradiance) * max(hitAlbedo, vec3(0.0)) * 0.92;
}

// VPT-2 stores a small history count in bits 24..30 and marks cache probes
// placed inside solid voxels in bit 31.  RGB remains the existing lower 24
// bit fixed-point encoding, so no packed-float extension is required.
bool vptProbeHasRadiance(uint packed)
{
    return (packed & 0x7f000000u) != 0u &&
           (packed & 0x80000000u) == 0u;
}

// VPT-1.3 source voxel fields.  RGB555 was produced from the actual block
// atlas sprite average during atlas construction, not from vertex tint.
vec3 vptDecodeVoxelAlbedo(uint source)
{
    return vec3(
        float((source >> 9u) & 31u),
        float((source >> 14u) & 31u),
        float((source >> 19u) & 31u)
    ) * (1.0 / 31.0);
}

bool vptReadSourceVoxel(ivec3 worldBlock, out uint source)
{
    ivec3 sectionCoord = ivec3(
        vliFloorDiv(worldBlock.x, 16),
        vliFloorDiv(worldBlock.y, 16),
        vliFloorDiv(worldBlock.z, 16)
    );
    uint pageIndex;
    if(!vliLookupSectionPage(sectionCoord, pageIndex)) return false;
    ivec3 local = ivec3(
        vliPositiveMod(worldBlock.x, 16),
        vliPositiveMod(worldBlock.y, 16),
        vliPositiveMod(worldBlock.z, 16)
    );
    uint index = uint(local.x) + 16u * (uint(local.z) + 16u * uint(local.y));
    source = vliPagesBuffer.words[pageIndex * VLI_PAGE_WORDS + index];
    return true;
}

// Analytic ray/AABB entry distance of one voxel.  A local-light visibility ray
// uses it to stop just before entering the emitter's own cell, so the emitter
// mesh cannot shadow its own emitted sample.  Returns a negative value when the
// segment misses the cell.
float vptEmitterVoxelEntryDistance(
    vec3 origin,
    vec3 target,
    ivec3 block
)
{
    vec3 segment = target - origin;
    float segmentLength = length(segment);
    if(segmentLength <= 1.0e-6)
    {
        return -1.0;
    }

    vec3 direction = segment / segmentLength;
    // Keep every component away from zero: an exactly parallel axis would
    // otherwise evaluate 0/0 = NaN and poison the min/max reduction below.
    vec3 safeDirection = mix(
        direction,
        vec3(1.0e-6),
        lessThan(abs(direction), vec3(1.0e-6))
    );

    vec3 boxMin = vec3(block);
    vec3 boxMax = boxMin + vec3(1.0);
    vec3 t0 = (boxMin - origin) / safeDirection;
    vec3 t1 = (boxMax - origin) / safeDirection;
    vec3 tNear = min(t0, t1);
    vec3 tFar = max(t0, t1);
    float tEnter = max(max(tNear.x, tNear.y), tNear.z);
    float tExit = min(min(tFar.x, tFar.y), tFar.z);
    if(tEnter > tExit || tExit < 0.0)
    {
        return -1.0;
    }
    return max(tEnter, 0.0);
}

// Superseded by vptEmitterVoxelEntryDistance(); no call sites remain.
//
// This walk is not only page-table dependent, it also caps at 96 steps while
// the local-light budget reaches 160 blocks (~277 steps along a diagonal
// segment), so any emitter farther than roughly 55-96 blocks reported "path
// not loaded" - and because the cap scaled with the ray direction, the failure
// boundary was direction dependent.  Callers used that result as a visibility
// gate, which hard-zeroed the entire local-light term on an invisible distance
// shell instead of letting the hardware occlusion query decide.
//
// It is retained only as a loaded-world boundary test.  It must not decide
// material visibility: its compact source word has no transparent-material
// class or RGB transmission, so treating occupancy as visibility would make
// coloured glass opaque to local RIS lighting.
bool vptLoadedPathToCandidateEmitter(
    vec3 origin,
    vec3 target,
    ivec3 targetBlock,
    out float targetVoxelEntryDistance
)
{
    vec3 segment = target - origin;
    float maxDistance = length(segment);
    targetVoxelEntryDistance = maxDistance;
    if(maxDistance <= 1.0e-4)
    {
        return true;
    }

    vec3 direction = segment / maxDistance;
    // A ray can cross at most one voxel per axis unit.  Bound the loop by
    // the actual segment while retaining the old worst-case cap.
    int maxTraversal = min(
        96,
        int(ceil(maxDistance * dot(abs(direction), vec3(1.0)))) + 2
    );
    ivec3 cell = ivec3(floor(origin));
    ivec3 step = ivec3(sign(direction));
    vec3 invAbs = 1.0 / max(abs(direction), vec3(1.0e-6));
    vec3 boundary = vec3(cell) + vec3(max(step, ivec3(0)));
    vec3 tMax = (boundary - origin) / direction;
    if(step.x == 0) tMax.x = 1.0e30;
    if(step.y == 0) tMax.y = 1.0e30;
    if(step.z == 0) tMax.z = 1.0e30;

    for(int traversal = 0; traversal < maxTraversal; ++traversal)
    {
        int axis = tMax.x < tMax.y
            ? (tMax.x < tMax.z ? 0 : 2)
            : (tMax.y < tMax.z ? 1 : 2);
        float travel = axis == 0 ? tMax.x : (axis == 1 ? tMax.y : tMax.z);
        if(travel >= maxDistance)
        {
            return true;
        }

        if(axis == 0)
        {
            cell.x += step.x;
            tMax.x += invAbs.x;
        }
        else if(axis == 1)
        {
            cell.y += step.y;
            tMax.y += invAbs.y;
        }
        else
        {
            cell.z += step.z;
            tMax.z += invAbs.z;
        }

        if(all(equal(cell, targetBlock)))
        {
            targetVoxelEntryDistance = travel;
            return true;
        }

        uint source;
        if(!vptReadSourceVoxel(cell, source))
        {
            return false;
        }
    }
    return false;
}

// Defined after the ray payload and ray-mode declarations.  The selected
// local-light sample uses exactly one of these queries; the M=2 proposals
// remain cheap and do not trace visibility individually.
vec3 vptTraceGlassTransmissionToEmitter(
    vec3 origin,
    vec3 target,
    float targetVoxelEntryDistance
);

float vptLocalLightRange(float emissionLevel)
{
    // rainWallParams1.w = Java 滑块「本地光最远照明距离」（格）。
    // 旧 DLL 恒写 0（reserved 位），此时回落到编译期默认，双向兼容。
    float userLocalMax = cam.rainWallParams1.w;
    float localMaxDistance =
        userLocalMax > 0.5
            ? min(VPT_LOCAL_MAX_DISTANCE, userLocalMax)
            : VPT_LOCAL_MAX_DISTANCE;
    return min(
        localMaxDistance,
        max(emissionLevel * VPT_LOCAL_RANGE_PER_EMISSION, 2.0)
    );
}

float vptLocalLightRangeFade(float distanceToLight, float emissionLevel)
{
    float range = vptLocalLightRange(emissionLevel);
    return 1.0 - smoothstep(
        range * VPT_LOCAL_FADE_START_FRACTION,
        range,
        distanceToLight
    );
}

float vptLocalLightDistanceAttenuation(float distanceToLight)
{
    return 0.55 / (1.0 + 0.18 * distanceToLight +
        0.025 * distanceToLight * distanceToLight);
}

float rand(inout uint state);

// Deterministic base-2 radical inverse for the 96-sample fixed sequence.
float vptRadicalInverseBase2(uint value)
{
    float result = 0.0;
    float weight = 0.5;
    for(int bit = 0; bit < 7; ++bit)
    {
        if((value & 1u) != 0u)
        {
            result += weight;
        }
        value >>= 1u;
        weight *= 0.5;
    }
    return result;
}

// A fixed low-discrepancy distribution over a 2.0 x 2.0 area emitter.  It
// has no stochastic phase, so visibility integration is temporally stable.
vec2 vptAreaLightStratum(uint sampleIndex)
{
    return vec2(
        (float(sampleIndex) + 0.5) / float(VPT_AREA_LIGHT_HISTORY_SAMPLES) - 0.5,
        vptRadicalInverseBase2(sampleIndex) - 0.5
    );
}

// VPT-3.3D.7 single-frame RIS: propose from every non-empty source Section in
// the complete local 5x5x5 neighborhood, then from that Section's exact
// emitter index.  There is still just one selected voxel-DDA visibility path.
// Unlike the old Binding 29 Top-8 list, crossing a receiver Section boundary
// cannot silently remove a still-in-range light from the proposal domain.
// One independent RIS estimate: two proposals and exactly one visibility path.
// The distance-budget wrapper below invokes this one or more times as needed.
uint pcg_hash(inout uint state);

// Defined with the VPT temporal helpers below. ReSTIR DI shares their
// world-space reprojection contract but owns independent reservoir storage.
bool vptReprojectPreviousPixel(
    vec3 worldPosition,
    ivec2 renderSize,
    out uint previousIndex
);

// Retain a bounded temporal population.  Reusing only one old candidate with
// two new candidates never converges on a stationary receiver: the single
// final visibility query remains visible as salt-and-pepper noise, especially
// near shadow boundaries.  World-space reprojection and receiver validation
// below make this modest cap safe without spatial reuse.
const uint RESTIR_DI_TEMPORAL_MAX_M = 12u;
// Keep M coherent with the actual bounded reuse budget even if a stale
// reservoir survives a shader hot reload or these limits are tuned later.
const uint RESTIR_DI_SPATIAL_MAX_M = 32u;
const uint RESTIR_DI_MAX_RESERVOIR_M = RESTIR_DI_SPATIAL_MAX_M;
const float RESTIR_DI_MIN_PROPOSAL_PDF = 1.0e-5;
// Reservoir statistics must stay self-consistent: weightSum, M and pHat are
// stored without independent firefly clamps.  If a later stage needs outlier
// suppression, clamp radiance/denoiser input instead of the reservoir itself.
const float RESTIR_DI_MIN_TARGET_RATIO = 0.50;
const float RESTIR_DI_MAX_TARGET_RATIO = 2.00;
const float RESTIR_DI_TEMPORAL_POSITION_EPSILON = 0.20;
const float RESTIR_DI_NORMAL_COSINE = 0.96;

uint restirDIPackReceiverAlbedo(vec3 albedo, bool validSample)
{
    uvec3 q = uvec3(round(clamp(albedo, vec3(0.0), vec3(1.0)) * 255.0));
    return (validSample ? 1u : 0u) |
        (q.r << 8u) | (q.g << 16u) | (q.b << 24u);
}

vec3 restirDIUnpackReceiverAlbedo(uint packed)
{
    return vec3(
        float((packed >> 8u) & 255u),
        float((packed >> 16u) & 255u),
        float((packed >> 24u) & 255u)
    ) * (1.0 / 255.0);
}

ReSTIRDIReservoir restirDIEmptyReservoir()
{
    ReSTIRDIReservoir reservoir;
    reservoir.sampleAndAreaPdf = vec4(0.0);
    reservoir.emitterNormalAndTargetPdf = vec4(0.0);
    reservoir.receiverPositionAndViewDepth = vec4(0.0);
    reservoir.receiverNormalAndWeight = vec4(0.0);
    reservoir.metadata = uvec4(0u);
    return reservoir;
}

ReSTIRDIReservoir restirDIReadPrevious(uint index)
{
    return cam.historyReadIndex == 0u
        ? restirDIReservoirBuffer0.entries[index]
        : restirDIReservoirBuffer1.entries[index];
}

void restirDIWriteCurrent(uint index, ReSTIRDIReservoir reservoir)
{
    if(cam.historyReadIndex == 0u)
    {
        restirDIReservoirBuffer1.entries[index] = reservoir;
    }
    else
    {
        restirDIReservoirBuffer0.entries[index] = reservoir;
    }
}

float restirDIReceiverViewDepth(vec3 hitPos)
{
    vec3 cameraPosition =
        (cam.viewInverse * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
    return length(hitPos - cameraPosition);
}

vec3 restirDIUnshadowedContribution(
    vec3 hitPos,
    vec3 hitNormal,
    ReSTIRDIReservoir candidate
)
{
    uint packedEmitter = candidate.metadata.x;
    uint emission = (packedEmitter >> 12u) & 15u;
    if(emission == 0u)
    {
        return vec3(0.0);
    }

    vec3 toLight = candidate.sampleAndAreaPdf.xyz - hitPos;
    float distanceToLight = length(toLight);
    if(distanceToLight <= 1.0e-6 ||
        distanceToLight > vptLocalLightRange(float(emission)))
    {
        return vec3(0.0);
    }

    float receiverCosine = max(
        dot(normalize(hitNormal), toLight / distanceToLight),
        0.0
    );
    if(receiverCosine <= 0.0)
    {
        return vec3(0.0);
    }

    uint typeCode = (packedEmitter >> 16u) & 7u;
    float scale = 3.2 * LOCAL_LIGHT_ENERGY_SCALE *
        (float(emission) / 15.0) *
        vptLocalLightDistanceAttenuation(distanceToLight) *
        vptLocalLightRangeFade(distanceToLight, float(emission));
    return vliDecodeEmitterColor(typeCode) * scale * receiverCosine;
}

float restirDITarget(
    vec3 hitPos,
    vec3 hitNormal,
    ReSTIRDIReservoir candidate
)
{
    return max(dot(
        restirDIUnshadowedContribution(hitPos, hitNormal, candidate),
        vec3(0.2126, 0.7152, 0.0722)
    ), 0.0);
}

bool restirDIFinite(float value)
{
    return !isnan(value) && !isinf(value);
}

bool restirDIStoredLightIsValid(ReSTIRDIReservoir reservoir)
{
    if((reservoir.metadata.w & 1u) == 0u || reservoir.metadata.y == 0u ||
        reservoir.metadata.y > RESTIR_DI_MAX_RESERVOIR_M ||
        !restirDIFinite(reservoir.sampleAndAreaPdf.w) ||
        !restirDIFinite(reservoir.emitterNormalAndTargetPdf.w) ||
        !restirDIFinite(reservoir.receiverNormalAndWeight.w) ||
        reservoir.sampleAndAreaPdf.w < RESTIR_DI_MIN_PROPOSAL_PDF ||
        reservoir.emitterNormalAndTargetPdf.w <= 0.0 ||
        reservoir.receiverNormalAndWeight.w <= 0.0 ||
        dot(reservoir.receiverNormalAndWeight.xyz,
            reservoir.receiverNormalAndWeight.xyz) < 0.5)
    {
        return false;
    }

    uint sourcePage = uint(
        max(reservoir.emitterNormalAndTargetPdf.x, 0.0) + 0.5
    );
    uint receiverPage = uint(
        max(reservoir.emitterNormalAndTargetPdf.y, 0.0) + 0.5
    );
    uint directoryRevision = uint(
        max(reservoir.emitterNormalAndTargetPdf.z, 0.0) + 0.5
    );
    if(sourcePage >= VPT_MAX_SECTION_PAGES ||
        receiverPage >= VPT_MAX_SECTION_PAGES ||
        directoryRevision == 0u)
    {
        return false;
    }

    uint currentRevision = vptEmitterIndexPagesBuffer.words[
        sourcePage * VPT_EMITTER_PAGE_WORDS + 1u
    ];
    uint currentDirectoryRevision = vptSourceDirectoryPagesBuffer.entries[
        receiverPage * VPT_SOURCE_DIRECTORY_ENTRIES_PER_PAGE
    ].aliasThresholdQ16;
    return currentRevision != 0u &&
        currentRevision == reservoir.metadata.z &&
        currentDirectoryRevision == directoryRevision;
}

bool restirDIReuseTargetIsStable(
    ReSTIRDIReservoir reservoir,
    float target
)
{
    float previousTarget = max(reservoir.emitterNormalAndTargetPdf.w, 1.0e-5);
    float targetRatio = target / previousTarget;
    return target > 0.0 &&
        targetRatio >= RESTIR_DI_MIN_TARGET_RATIO &&
        targetRatio <= RESTIR_DI_MAX_TARGET_RATIO;
}

bool restirDITemporalReceiverMatches(
    ReSTIRDIReservoir reservoir,
    vec3 hitPos,
    vec3 hitNormal,
    float viewDepth
)
{
    if(length(reservoir.receiverPositionAndViewDepth.xyz - hitPos) >
        RESTIR_DI_TEMPORAL_POSITION_EPSILON ||
        dot(normalize(reservoir.receiverNormalAndWeight.xyz),
            normalize(hitNormal)) < RESTIR_DI_NORMAL_COSINE)
    {
        return false;
    }

    float depthTolerance = max(0.25, viewDepth * 0.02);
    return abs(reservoir.receiverPositionAndViewDepth.w - viewDepth) <=
        depthTolerance;
}

void restirDIUpdateReservoir(
    inout ReSTIRDIReservoir reservoir,
    ReSTIRDIReservoir candidate,
    float candidateWeight,
    uint candidateM,
    inout uint rngState
)
{
    if(!restirDIFinite(candidateWeight) || candidateWeight <= 0.0 ||
        candidateM == 0u)
    {
        return;
    }

    // candidateWeight is the aggregate RIS weight represented by candidateM
    // samples.  Never clamp it independently from M: doing so changes the
    // represented distribution and makes W = weightSum / (M * pHat) invalid.
    float oldWeightSum = restirDIFinite(reservoir.receiverNormalAndWeight.w)
        ? reservoir.receiverNormalAndWeight.w : 0.0;
    uint oldM = reservoir.metadata.y;
    float newWeightSum = oldWeightSum + candidateWeight;
    uint combinedM = oldM + candidateM;
    if(!restirDIFinite(newWeightSum) || newWeightSum <= 0.0 ||
        combinedM == 0u || combinedM > RESTIR_DI_MAX_RESERVOIR_M)
    {
        return;
    }

    if(rand(rngState) * newWeightSum < candidateWeight)
    {
        reservoir = candidate;
    }

    reservoir.receiverNormalAndWeight.w = newWeightSum;
    reservoir.metadata.y = combinedM;
    reservoir.metadata.w = (reservoir.metadata.w & 0xffffff00u) | 1u;
}

bool restirDIGenerateCandidate(
    vec3 hitPos,
    vec3 hitNormal,
    inout uint rngState,
    out ReSTIRDIReservoir candidate
)
{
    candidate = restirDIEmptyReservoir();
    ivec3 receiverSection = ivec3(floor(hitPos / 16.0));
    uint receiverPage;
    // Section whose source directory we read.  Normally the receiver's own
    // Section; the miss path below borrows a resident neighbour so a missing
    // Section can never delete the whole local-light term.
    ivec3 directorySection = receiverSection;
    if(!vliLookupSectionPage(receiverSection, receiverPage))
    {
        bool borrowedDirectory = false;
        for(uint neighbourIndex = 0u; neighbourIndex < 6u; ++neighbourIndex)
        {
            ivec3 neighbour = receiverSection + (
                neighbourIndex == 0u ? ivec3( 1,  0,  0) :
                neighbourIndex == 1u ? ivec3(-1,  0,  0) :
                neighbourIndex == 2u ? ivec3( 0,  1,  0) :
                neighbourIndex == 3u ? ivec3( 0, -1,  0) :
                neighbourIndex == 4u ? ivec3( 0,  0,  1) :
                                       ivec3( 0,  0, -1)
            );
            if(vliLookupSectionPage(neighbour, receiverPage))
            {
                directorySection = neighbour;
                borrowedDirectory = true;
                break;
            }
        }
        if(!borrowedDirectory)
        {
            return false;
        }
    }

    uint directoryBase = receiverPage * VPT_SOURCE_DIRECTORY_ENTRIES_PER_PAGE;
    uint directoryRevision = vptSourceDirectoryPagesBuffer.entries[
        directoryBase
    ].aliasThresholdQ16;
    uint sourceSectionCount = min(
        vptSourceDirectoryPagesBuffer.entries[directoryBase].pageIndex,
        VPT_SOURCE_DIRECTORY_MAX_SECTIONS
    );
    if(sourceSectionCount == 0u || directoryRevision == 0u)
    {
        return false;
    }

    uint sourceDirectoryBucket = min(
        uint(rand(rngState) * float(sourceSectionCount)),
        sourceSectionCount - 1u
    );
    VPTSourceDirectoryEntry bucketEntry =
        vptSourceDirectoryPagesBuffer.entries[
            directoryBase + 1u + sourceDirectoryBucket
        ];
    uint sourceDirectoryIndex = rand(rngState) <=
        float(bucketEntry.aliasThresholdQ16) / 65535.0
        ? sourceDirectoryBucket
        : min(bucketEntry.aliasIndex, sourceSectionCount - 1u);
    VPTSourceDirectoryEntry sourceEntry =
        vptSourceDirectoryPagesBuffer.entries[
            directoryBase + 1u + sourceDirectoryIndex
        ];
    uint sourcePage = sourceEntry.pageIndex;
    uint sourceMetadata = sourceEntry.emitterCountAndOffset;
    uint emitterCount = sourceMetadata & 0x1fffu;
    if(emitterCount == 0u || sourcePage >= VPT_MAX_SECTION_PAGES)
    {
        return false;
    }

    uint emitterBucket = min(
        uint(rand(rngState) * float(emitterCount)), emitterCount - 1u
    );
    uint emitterAliasWord = vptEmitterAliasPagesBuffer.words[
        sourcePage * VPT_EMITTER_PAGE_WORDS +
        VPT_EMITTER_HEADER_WORDS + emitterBucket
    ];
    uint emitterIndex = rand(rngState) <=
        float(emitterAliasWord & 0xffffu) / 65535.0
        ? emitterBucket
        : min(emitterAliasWord >> 16u, emitterCount - 1u);
    uint packedEmitter = vptEmitterIndexPagesBuffer.words[
        sourcePage * VPT_EMITTER_PAGE_WORDS +
        VPT_EMITTER_HEADER_WORDS + emitterIndex
    ];
    uint emission = (packedEmitter >> 12u) & 15u;
    if(emission == 0u)
    {
        return false;
    }

    ivec3 sourceSection = directorySection + ivec3(
        int((sourceMetadata >> 13u) & 7u) - 2,
        int((sourceMetadata >> 16u) & 7u) - 2,
        int((sourceMetadata >> 19u) & 7u) - 2
    );
    ivec3 emitterBlock = sourceSection * 16 + ivec3(
        int(packedEmitter & 15u),
        int((packedEmitter >> 4u) & 15u),
        int((packedEmitter >> 8u) & 15u)
    );
    vec3 emitterCenter = vec3(emitterBlock) + vec3(0.5);
    vec3 toEmitter = emitterCenter - hitPos;
    float emitterDistance = length(toEmitter);
    if(emitterDistance <= 1.0e-6 ||
        emitterDistance > vptLocalLightRange(float(emission)) ||
        dot(normalize(hitNormal), toEmitter / emitterDistance) <= 0.0)
    {
        return false;
    }

    vec3 centreDirection = toEmitter / emitterDistance;
    vec3 referenceAxis = abs(centreDirection.y) < 0.95
        ? vec3(0.0, 1.0, 0.0)
        : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(referenceAxis, centreDirection));
    vec3 bitangent = normalize(cross(centreDirection, tangent));
    vec2 sampleUv = vec2(rand(rngState), rand(rngState)) - vec2(0.5);
    vec3 emitterSample = emitterCenter +
        (tangent * sampleUv.x + bitangent * sampleUv.y) *
        VPT_LOCAL_LIGHT_AREA_SIZE;

    uint totalEmitterPower = vptEmitterIndexPagesBuffer.words[
        sourcePage * VPT_EMITTER_PAGE_WORDS + 2u
    ];
    float proposalPdf = max(
        sourceEntry.selectionProbability *
        (float(emission) / float(max(totalEmitterPower, 1u))),
        RESTIR_DI_MIN_PROPOSAL_PDF
    );
    candidate.sampleAndAreaPdf = vec4(emitterSample, proposalPdf);
    candidate.emitterNormalAndTargetPdf = vec4(
        float(sourcePage),
        float(receiverPage),
        float(directoryRevision),
        0.0
    );
    candidate.metadata = uvec4(
        packedEmitter,
        1u,
        vptEmitterIndexPagesBuffer.words[
            sourcePage * VPT_EMITTER_PAGE_WORDS + 1u
        ],
        1u
    );
    return candidate.metadata.z != 0u;
}

// Disabled (no call sites): kept as a future interface option.
#if 0
vec3 restirDIStainedGlassGateFilter(
    vec3 hitPos,
    vec3 emitterSample,
    ivec3 emitterBlock
)
{
    vec3 emitterToReceiver = normalize(hitPos - emitterSample);
    vec3 directionAbs = abs(emitterToReceiver);
    ivec3 gateOffset = ivec3(0);
    if(directionAbs.x >= directionAbs.y && directionAbs.x >= directionAbs.z)
    {
        gateOffset.x = emitterToReceiver.x >= 0.0 ? 1 : -1;
    }
    else if(directionAbs.y >= directionAbs.z)
    {
        gateOffset.y = emitterToReceiver.y >= 0.0 ? 1 : -1;
    }
    else
    {
        gateOffset.z = emitterToReceiver.z >= 0.0 ? 1 : -1;
    }

    uint gateSource;
    if(vptReadSourceVoxel(emitterBlock + gateOffset, gateSource) &&
        (gateSource & VPT_STAINED_GLASS_BIT) != 0u)
    {
        return clamp(vptDecodeVoxelAlbedo(gateSource), vec3(0.0), vec3(1.0));
    }
    return vec3(1.0);
}
#endif

vec3 evaluateReSTIRDIDirectLighting(
    vec3 hitPos,
    vec3 hitNormal,
    vec3 hitAlbedo,
    ivec2 pixelCoord,
    ivec2 renderSize,
    inout uint rngState
)
{
    uint currentIndex = uint(pixelCoord.y * renderSize.x + pixelCoord.x);
    float viewDepth = restirDIReceiverViewDepth(hitPos);
    ReSTIRDIReservoir reservoir = restirDIEmptyReservoir();

    // Preserve receiver data even when the two initial proposals fail.  The
    // following spatial pass can then import a valid neighbour sample without
    // tracing any additional visibility ray.
    ReSTIRDIReservoir receiverOnly = restirDIEmptyReservoir();
    receiverOnly.receiverPositionAndViewDepth = vec4(hitPos, viewDepth);
    receiverOnly.receiverNormalAndWeight = vec4(normalize(hitNormal), 0.0);
    receiverOnly.metadata.w = restirDIPackReceiverAlbedo(hitAlbedo, false);

    // Initial + temporal reservoir construction only.  No visibility ray is
    // issued in this pass; exactly one final visibility ray is deferred until
    // after same-frame spatial reservoir reuse.
    // Candidate count is the user "局部光 RIS 候选" setting (perfSecondary.x).
    uint risCandidateCount =
        clamp(cam.perfSecondary.x, 1u, 2u);
    for(uint proposalIndex = 0u;
        proposalIndex < risCandidateCount;
        ++proposalIndex)
    {
        ReSTIRDIReservoir candidate;
        if(restirDIGenerateCandidate(hitPos, hitNormal, rngState, candidate))
        {
            float target = restirDITarget(hitPos, hitNormal, candidate);
            candidate.emitterNormalAndTargetPdf.w = target;
            restirDIUpdateReservoir(
                reservoir,
                candidate,
                target / candidate.sampleAndAreaPdf.w,
                1u,
                rngState
            );
        }
    }

    if(cam.historyValid != 0u)
    {
        uint previousIndex;
        if(vptReprojectPreviousPixel(hitPos, renderSize, previousIndex))
        {
            ReSTIRDIReservoir previous = restirDIReadPrevious(previousIndex);
            if(restirDIStoredLightIsValid(previous) &&
                restirDITemporalReceiverMatches(
                    previous, hitPos, hitNormal, viewDepth))
            {
                uint reusedM = min(previous.metadata.y, RESTIR_DI_TEMPORAL_MAX_M);
                float target = restirDITarget(hitPos, hitNormal, previous);
                if(restirDIReuseTargetIsStable(previous, target))
                {
                    float previousTarget = max(
                        previous.emitterNormalAndTargetPdf.w,
                        RESTIR_DI_MIN_PROPOSAL_PDF
                    );
                    float reusedWeightSum =
                        previous.receiverNormalAndWeight.w *
                        (float(reusedM) / float(previous.metadata.y));
                    float temporalCandidateWeight =
                        target * reusedWeightSum / previousTarget;
                    restirDIUpdateReservoir(
                        reservoir,
                        previous,
                        temporalCandidateWeight,
                        reusedM,
                        rngState
                    );
                }
            }
        }
    }

    float selectedTarget = restirDITarget(hitPos, hitNormal, reservoir);
    if(reservoir.metadata.y == 0u || selectedTarget <= 0.0 ||
        !restirDIFinite(reservoir.receiverNormalAndWeight.w) ||
        reservoir.receiverNormalAndWeight.w <= 0.0)
    {
        restirDIWriteCurrent(currentIndex, receiverOnly);
        return vec3(0.0);
    }

    float selectedWeightSum = reservoir.receiverNormalAndWeight.w;
    reservoir.receiverPositionAndViewDepth = vec4(hitPos, viewDepth);
    reservoir.receiverNormalAndWeight = vec4(
        normalize(hitNormal),
        selectedWeightSum
    );
    reservoir.emitterNormalAndTargetPdf.w = selectedTarget;
    reservoir.metadata.w = restirDIPackReceiverAlbedo(hitAlbedo, true);
    restirDIWriteCurrent(currentIndex, reservoir);

    // Direct local-light radiance is added by rt_restir_final.rgen after the
    // spatial reservoir pass.  Keeping this at zero avoids double lighting and
    // preserves the one-shadow-ray-per-pixel ReSTIR DI budget.
    return vec3(0.0);
}

vec3 evaluateVPTRISDirectLightingSingle(
    vec3 hitPos,
    vec3 hitNormal,
    vec3 hitAlbedo,
    inout uint rngState
)
{
    ivec3 receiverSection = ivec3(floor(hitPos / 16.0));
    uint receiverPage;
    // Section whose source directory we actually read.  It is normally the
    // receiver's own Section; see the miss path below.
    ivec3 directorySection = receiverSection;
    if(!vliLookupSectionPage(receiverSection, receiverPage))
    {
        // A Section missing from the VPT page table is *unknown*, not black.
        // Returning zero here removed the complete local-light term over whole
        // 16-block Sections, which is what painted the hard, un-jittered
        // terminators along the Section grid on otherwise uniformly lit walls.
        //
        // Borrow the first resident axis neighbour instead.  Directory offsets
        // are stored relative to the Section that owns the directory, so every
        // emitter is still reconstructed at its true absolute position by
        // offsetting from `directorySection` rather than `receiverSection`.
        // Only the Section-level proposal weights become the donor's, which is
        // a bounded approximation versus a hard black band.
        bool borrowedDirectory = false;
        for(uint neighbourIndex = 0u; neighbourIndex < 6u; ++neighbourIndex)
        {
            ivec3 neighbour = receiverSection + (
                neighbourIndex == 0u ? ivec3( 1,  0,  0) :
                neighbourIndex == 1u ? ivec3(-1,  0,  0) :
                neighbourIndex == 2u ? ivec3( 0,  1,  0) :
                neighbourIndex == 3u ? ivec3( 0, -1,  0) :
                neighbourIndex == 4u ? ivec3( 0,  0,  1) :
                                       ivec3( 0,  0, -1)
            );
            if(vliLookupSectionPage(neighbour, receiverPage))
            {
                directorySection = neighbour;
                borrowedDirectory = true;
                break;
            }
        }
        if(!borrowedDirectory)
        {
            return vec3(0.0);
        }
    }

    // A zero normal is the dedicated water-column receiver.  It has no
    // Lambert-facing hemisphere: a submerged light may arrive from above,
    // below or the side, while the proposal and final visibility path remain
    // exactly the normal M=2 / one-ray RIS budget.
    bool waterColumnReceiver = dot(hitNormal, hitNormal) <= 1.0e-8;
    vec3 N = waterColumnReceiver
        ? vec3(0.0, 1.0, 0.0)
        : normalize(hitNormal);
    vec3 selectedContribution = vec3(0.0);
    vec3 selectedSample = vec3(0.0);
    ivec3 selectedBlock = ivec3(0);
    float weightSum = 0.0;
    uint directoryBase = receiverPage * VPT_SOURCE_DIRECTORY_ENTRIES_PER_PAGE;
    uint sourceSectionCount = min(
        vptSourceDirectoryPagesBuffer.entries[directoryBase].pageIndex,
        VPT_SOURCE_DIRECTORY_MAX_SECTIONS
    );
    if(sourceSectionCount == 0u)
    {
        return vec3(0.0);
    }

    for(uint proposalIndex = 0u;
        proposalIndex < clamp(cam.perfSecondary.x, 1u, 2u);
        ++proposalIndex)
    {
        uint sourceDirectoryBucket = min(
            uint(rand(rngState) * float(sourceSectionCount)),
            sourceSectionCount - 1u
        );
        VPTSourceDirectoryEntry sourceDirectoryBucketEntry =
            vptSourceDirectoryPagesBuffer.entries[
            directoryBase + 1u + sourceDirectoryBucket
        ];
        uint sourceDirectoryIndex = rand(rngState) <=
            float(sourceDirectoryBucketEntry.aliasThresholdQ16) / 65535.0
            ? sourceDirectoryBucket
            : min(sourceDirectoryBucketEntry.aliasIndex, sourceSectionCount - 1u);
        VPTSourceDirectoryEntry sourceDirectoryEntry =
            vptSourceDirectoryPagesBuffer.entries[
                directoryBase + 1u + sourceDirectoryIndex
            ];
        uint sourcePage = sourceDirectoryEntry.pageIndex;
        uint sourceMetadata = sourceDirectoryEntry.emitterCountAndOffset;
        uint emitterCount = sourceMetadata & 0x1fffu;
        if(emitterCount == 0u)
        {
            continue;
        }

        uint emitterBucket = min(
            uint(rand(rngState) * float(emitterCount)),
            emitterCount - 1u
        );
        uint emitterAliasWord = vptEmitterAliasPagesBuffer.words[
            sourcePage * VPT_EMITTER_PAGE_WORDS +
            VPT_EMITTER_HEADER_WORDS + emitterBucket
        ];
        uint emitterIndex = rand(rngState) <=
            float(emitterAliasWord & 0xffffu) / 65535.0
            ? emitterBucket
            : min(emitterAliasWord >> 16u, emitterCount - 1u);
        uint packedEmitter = vptEmitterIndexPagesBuffer.words[
            sourcePage * VPT_EMITTER_PAGE_WORDS +
            VPT_EMITTER_HEADER_WORDS + emitterIndex
        ];
        uint emission = (packedEmitter >> 12u) & 15u;
        if(emission == 0u) continue;

        ivec3 sourceSection = directorySection + ivec3(
            int((sourceMetadata >> 13u) & 7u) - 2,
            int((sourceMetadata >> 16u) & 7u) - 2,
            int((sourceMetadata >> 19u) & 7u) - 2
        );
        ivec3 emitterBlock = sourceSection * 16 + ivec3(
            int(packedEmitter & 15u),
            int((packedEmitter >> 4u) & 15u),
            int((packedEmitter >> 8u) & 15u)
        );

        vec3 emitterCenter = vec3(emitterBlock) + vec3(0.5);
        vec3 toLight = emitterCenter - hitPos;
        float distanceSquared = dot(toLight, toLight);
        if(distanceSquared <= 1.0e-6)
        {
            continue;
        }
        float distanceToLight = sqrt(distanceSquared);
        float emissionLevel = float(emission);
        if(distanceToLight > vptLocalLightRange(emissionLevel))
        {
            continue;
        }

        float receiverCosine = waterColumnReceiver
            ? 1.0
            : max(dot(N, toLight / distanceToLight), 0.0);
        if(receiverCosine <= 0.0)
        {
            continue;
        }

        uint typeCode = (packedEmitter >> 16u) & 7u;
        vec3 centreDirection = toLight / distanceToLight;
        vec3 referenceAxis = abs(centreDirection.y) < 0.95
            ? vec3(0.0, 1.0, 0.0)
            : vec3(1.0, 0.0, 0.0);
        vec3 tangent = normalize(cross(referenceAxis, centreDirection));
        vec3 bitangent = normalize(cross(centreDirection, tangent));

        vec2 sampleUv = vec2(rand(rngState), rand(rngState)) - vec2(0.5);
        vec3 emitterSample = emitterCenter +
            (tangent * sampleUv.x + bitangent * sampleUv.y) *
            VPT_LOCAL_LIGHT_AREA_SIZE;
        vec3 sampledToLight = emitterSample - hitPos;
        float sampledDistance = length(sampledToLight);
        if(sampledDistance <= 1.0e-6) continue;
        vec3 lightDirection = sampledToLight / sampledDistance;
        float sampledCosine = max(dot(N, lightDirection), 0.0);
        if(sampledCosine <= 0.0) continue;
        float scale = 3.2 * LOCAL_LIGHT_ENERGY_SCALE *
            (emissionLevel / 15.0) *
            vptLocalLightDistanceAttenuation(sampledDistance) *
            vptLocalLightRangeFade(sampledDistance, emissionLevel);
        vec3 contribution = vliDecodeEmitterColor(typeCode) * scale * sampledCosine;
        // The section Alias table already includes power and distance; the
        // emitter Alias table uses exact emission power.  Keep the real PDF
        // explicit so RIS remains unbiased after hierarchical importance
        // sampling instead of retaining the old uniform reciprocal.
        float target = max(dot(contribution, vec3(0.2126, 0.7152, 0.0722)), 0.0);
        uint totalEmitterPower = vptEmitterIndexPagesBuffer.words[
            sourcePage * VPT_EMITTER_PAGE_WORDS + 2u
        ];
        float proposalPdf = max(
            sourceDirectoryEntry.selectionProbability *
            (float(emission) / float(max(totalEmitterPower, 1u))),
            1.0e-8
        );
        float weight = target / proposalPdf;
        if(weight <= 0.0) continue;
        weightSum += weight;
        if(rand(rngState) * weightSum < weight)
        {
            selectedContribution = contribution;
            selectedSample = emitterSample;
            selectedBlock = emitterBlock;
        }
    }
    if(weightSum <= 0.0)
    {
        return vec3(0.0);
    }

    vec3 receiverOrigin = hitPos + N * 0.035;
    // Stop the visibility ray just before it enters the emitter's own voxel, so
    // the emitter mesh cannot shadow its own emitted sample.  This used to run
    // vptLoadedPathToCandidateEmitter() and treat "path not loaded" as "light
    // invisible", which hard-zeroed the whole term beyond ~64 blocks on a
    // direction-dependent distance shell.  Occlusion is now decided purely by
    // the hardware GLASS_VISIBILITY trace below.
    float targetVoxelEntryDistance = vptEmitterVoxelEntryDistance(
        receiverOrigin, selectedSample, selectedBlock
    );
    if(targetVoxelEntryDistance < 0.0)
    {
        targetVoxelEntryDistance = distance(selectedSample, receiverOrigin);
    }

    // The GLASS_VISIBILITY Any-Hit already accumulates the Orion
    // thin-sheet transmission for every intervening glass block.
    vec3 transmittance = vptTraceGlassTransmissionToEmitter(
        receiverOrigin, selectedSample, targetVoxelEntryDistance
    );
    if(max(transmittance.r, max(transmittance.g, transmittance.b)) <= 0.0)
    {
        return vec3(0.0);
    }

    // Local emitters are the only light this path handles, so the coloured
    // transmission - and the exposure guard that keeps its hue from being
    // clipped to white - are applied here and nowhere else.
    float selectedWeight = max(dot(selectedContribution,
        vec3(0.2126, 0.7152, 0.0722)), 1.0e-6);
    return applyLocalGlassTint(
        selectedContribution * (weightSum /
            (float(clamp(cam.perfSecondary.x, 1u, 2u)) * selectedWeight)) *
            max(hitAlbedo, vec3(0.0)) * 0.92,
        transmittance
    );
}

// Distance budget for local direct lighting, measured from the camera in
// Minecraft blocks.  A call to evaluateVPTRISDirectLightingSingle() always
// performs one final hardware visibility path after RIS selection.
//
// The budget is expressed as a *keep probability*: the fraction of pixels that
// trace that single final visibility path.  Expected ray count per pixel equals
// the keep probability, so the profile below is the real cost.
//
//   0-56 blocks    (0-3.5 chunks): keep 1.00
//   56-72 blocks  : keep 1.00 -> 0.50
//   72-120 blocks : keep 0.50
//   120-136 blocks: keep 0.50 -> 0.25
//   136-152 blocks: keep 0.25
//   152-200 blocks: keep 0.25 -> 0.00
//   200+ blocks   : keep 0.00
//
// This used to be four *hard* bands on the camera-centred distance sphere: the
// visibility count (and therefore the noise level) stepped at 64 and 128
// blocks, and the whole term was clipped to zero at 160 blocks.  A hard
// mean-step on a camera-centred sphere is a hard edge in the image, and because
// the sphere follows the camera it crosses walls, ceilings and terrain
// identically -- which reads as an un-jittered light/dark boundary, i.e. a
// hacked-in hard shadow terminator, no matter what local-light model feeds it.
// Every band edge is now a smoothstep ramp of finite width, the ramp position
// is dithered per pixel so the transitions cannot line up into a contour, and
// the range extends smoothly to 200 blocks instead of clipping at 160.
//
// The plateau values are the previous band values, so the expected ray count
// (and therefore the frame cost) stays within a few percent of the hard-banded
// scheme: the only new work is the 160-200 block tail that used to be free
// because it was simply disabled.
const float VPT_LOCAL_KEEP_RAMP_BLOCKS = 16.0;
const float VPT_LOCAL_KEEP_TAIL_END_BLOCKS = 200.0;

float vptLocalLightKeepProbability(float cameraDistance)
{
    if(cameraDistance <= 56.0) return 1.0;
    if(cameraDistance <= 72.0)
    {
        return mix(1.0, 0.5,
            smoothstep(0.0, 1.0, (cameraDistance - 56.0) / VPT_LOCAL_KEEP_RAMP_BLOCKS));
    }
    if(cameraDistance <= 120.0) return 0.5;
    if(cameraDistance <= 136.0)
    {
        return mix(0.5, 0.25,
            smoothstep(0.0, 1.0, (cameraDistance - 120.0) / VPT_LOCAL_KEEP_RAMP_BLOCKS));
    }
    if(cameraDistance <= 152.0) return 0.25;
    if(cameraDistance <= VPT_LOCAL_KEEP_TAIL_END_BLOCKS)
    {
        return mix(0.25, 0.0,
            smoothstep(0.0, 1.0,
                (cameraDistance - 152.0) /
                (VPT_LOCAL_KEEP_TAIL_END_BLOCKS - 152.0)));
    }
    return 0.0;
}

vec3 evaluateVPTRISDirectLighting(
    vec3 hitPos,
    vec3 hitNormal,
    vec3 hitAlbedo,
    inout uint rngState
)
{
    vec3 cameraPosition =
        (cam.viewInverse * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
    float receiverCameraDistance = length(hitPos - cameraPosition);

    // Exactly one pcg_hash draw on every path, as before, so the RNG stream
    // stays in step with the rest of the frame's sampling.  Bits 0-15 dither
    // the ramp position, bits 16-31 make the keep/skip decision.
    uint fadeState = pcg_hash(rngState);
    float rampDither =
        (float(fadeState & 0xffffu) / 65535.0 - 0.5) * 6.0;
    float keepProbability = vptLocalLightKeepProbability(
        receiverCameraDistance + rampDither);

    if(keepProbability <= 1.0e-4)
    {
        return vec3(0.0);
    }
    if(keepProbability < 1.0 &&
       float((fadeState >> 16u) & 0xffffu) / 65535.0 >= keepProbability)
    {
        return vec3(0.0);
    }

    // Compensate the skipped frames, but bound the multiplier at 4x (the old
    // 128-160 block value) so the 152-200 block tail fades out smoothly by
    // *energy* instead of exploding into high-variance fireflies.
    float weightScale = 1.0 / max(keepProbability, 0.25);

    return evaluateVPTRISDirectLightingSingle(
        hitPos, hitNormal, hitAlbedo, rngState) * weightScale;
}

// VPT-3.4A: cosine-sample one true voxel surface, then read that surface's
// event-driven local direct irradiance from Binding 30.  This never samples
// Binding 24 air probes and a missing Section terminates the ray as opaque.
vec3 evaluateVPTLocalSecondaryBounce(
    vec3 hitPos,
    vec3 hitNormal,
    vec3 hitAlbedo,
    inout uint rngState
)
{
    vec3 N = normalize(hitNormal);
    vec3 direction = sampleHemisphereCosine(N, rngState);
    int maxTraversal = min(
        48,
        int(ceil(VPT_LOCAL_BOUNCE_MAX_DISTANCE *
            dot(abs(direction), vec3(1.0)))) + 2
    );
    vec3 origin = hitPos + N * 0.035;
    ivec3 cell = ivec3(floor(origin));
    ivec3 step = ivec3(sign(direction));
    vec3 invAbs = 1.0 / max(abs(direction), vec3(1.0e-6));
    vec3 boundary = vec3(cell) + vec3(max(step, ivec3(0)));
    vec3 tMax = (boundary - origin) / direction;
    if(step.x == 0) tMax.x = 1.0e30;
    if(step.y == 0) tMax.y = 1.0e30;
    if(step.z == 0) tMax.z = 1.0e30;
    // Stained glass between the receiver and the sampled radiance must tint
    // the bounce exactly like the rt_vpt_irradiance.comp bake does.  Without
    // this the DDA treated every pane as air and torch light behind coloured
    // glass reached the receiver as raw white emitter colour.
    vec3 glassTransmission = vec3(1.0);

    for(int traversal = 0; traversal < maxTraversal; ++traversal)
    {
        int axis = tMax.x < tMax.y
            ? (tMax.x < tMax.z ? 0 : 2)
            : (tMax.y < tMax.z ? 1 : 2);
        float travel = axis == 0 ? tMax.x : (axis == 1 ? tMax.y : tMax.z);
        if(travel > VPT_LOCAL_BOUNCE_MAX_DISTANCE) return vec3(0.0);

        vec3 faceNormal;
        if(axis == 0)
        {
            cell.x += step.x;
            tMax.x += invAbs.x;
            faceNormal = vec3(-step.x, 0.0, 0.0);
        }
        else if(axis == 1)
        {
            cell.y += step.y;
            tMax.y += invAbs.y;
            faceNormal = vec3(0.0, -step.y, 0.0);
        }
        else
        {
            cell.z += step.z;
            tMax.z += invAbs.z;
            faceNormal = vec3(0.0, 0.0, -step.z);
        }

        uint source;
        // A Section that is absent from the VPT page table is *unknown*, not
        // black.  Returning zero here extinguished the whole local-light
        // secondary term the moment the bounce ray left the loaded page set,
        // which drew a straight, completely noise-free light/dark seam along the
        // 16-block Section grid -- the same failure mode already removed from the
        // direct local-light paths.  An unknown Section is skipped like air, so a
        // missing table entry can never change lighting.
        if(!vptReadSourceVoxel(cell, source)) continue;
        // Same voxel classification as the comp's transmissionToEmitter: a
        // stained pane multiplies the RGB filter and stays transparent; the
        // 1/31 floor stops a quantized RGB555 zero becoming a hard shadow.
        if((source & VPT_STAINED_GLASS_BIT) != 0u)
        {
            glassTransmission *=
                max(vptDecodeVoxelAlbedo(source), vec3(1.0 / 31.0));
        }
        if((source & 3u) != 1u) continue;

        vec3 bounceAlbedo = vptDecodeVoxelAlbedo(source);
        if(max(bounceAlbedo.r, max(bounceAlbedo.g, bounceAlbedo.b)) <= 0.0)
        {
            continue;
        }

        ivec3 sectionCoord = ivec3(
            vliFloorDiv(cell.x, 16), vliFloorDiv(cell.y, 16),
            vliFloorDiv(cell.z, 16)
        );
        uint pageIndex;
        if(!vliLookupSectionPage(sectionCoord, pageIndex)) continue;
        ivec3 local = ivec3(
            vliPositiveMod(cell.x, 16), vliPositiveMod(cell.y, 16),
            vliPositiveMod(cell.z, 16)
        );
        uint voxelIndex = uint(local.x) + 16u *
            (uint(local.z) + 16u * uint(local.y));
        uint packedDirect = vptSurfaceFaceBuffer.words[
            pageIndex * VPT_SURFACE_FACE_WORDS +
            voxelIndex * VPT_DIRECTION_COUNT +
            vptFaceIndexFromBlockFaceNormal(faceNormal)
        ];
        vec3 outgoingRadiance = vliUnpackRadiance(packedDirect) *
            bounceAlbedo * (1.0 / 3.14159265359);
        vec3 secondaryTerm = outgoingRadiance * max(hitAlbedo, vec3(0.0)) *
            0.92 * vptSaturateGlassTransmission(glassTransmission);

        // 诊断（G 通道）：本地光二级弹射项的能量。
        if(DBG_LOCAL_TERM_MAP)
        {
            return vec3(0.0, dbgTermLuma(secondaryTerm), 0.0);
        }
        if(DBG_GLASS_DYE_VS_ENERGY_SECONDARY)
        {
            // R = 到达接收面的染料浓度（纯色⇒亮，白⇒暗）
            // G = 该项能量
            return vec3(
                dbgDyeConcentration(vptSaturateGlassTransmission(glassTransmission)),
                dbgTermLuma(secondaryTerm),
                0.0
            );
        }
        if(DBG_GLASS_PEAK_READOUT)
        {
            // 比值型读数：R = 染料纯度，G = 弱通道占比。
            // 读的是到达接收面的染色透射率本身（含 saturate），
            // 与该项能量无关，因此不受末端裁剪影响。
            return dbgHuePurity2(vptSaturateGlassTransmission(glassTransmission));
        }
        return toneKeepHueLocal(secondaryTerm);
    }
    return vec3(0.0);
}

// Fixed-cost voxel DDA.  Missing pages terminate the ray: treating an
// unloaded Section as air would leak light across the loaded-world boundary.
vec3 traceVPTEmitterDDA(vec3 origin, vec3 direction, out vec3 blockerAlbedo,
                         out vec3 blockerPos, out vec3 blockerNormal)
{
    ivec3 cell = ivec3(floor(origin));
    ivec3 step = ivec3(sign(direction));
    vec3 invAbs = 1.0 / max(abs(direction), vec3(1.0e-6));
    vec3 boundary = vec3(cell) + vec3(max(step, ivec3(0)));
    vec3 tMax = (boundary - origin) / direction;
    if(step.x == 0) tMax.x = 1.0e30;
    if(step.y == 0) tMax.y = 1.0e30;
    if(step.z == 0) tMax.z = 1.0e30;
    blockerAlbedo = vec3(0.0);
    blockerPos = origin;
    blockerNormal = vec3(0.0);
    // Stained panes crossed on the way to an emitter tint its light exactly
    // like the bake filter; without this the DDA read panes as air and torch
    // light behind coloured glass stayed raw white.
    vec3 glassTransmission = vec3(1.0);

    for(int i = 0; i < 64; ++i)
    {
        int axis = tMax.x < tMax.y ? (tMax.x < tMax.z ? 0 : 2)
                                    : (tMax.y < tMax.z ? 1 : 2);
        float t = axis == 0 ? tMax.x : (axis == 1 ? tMax.y : tMax.z);
        if(t > 30.0) break;
        if(axis == 0) { cell.x += step.x; tMax.x += invAbs.x; blockerNormal=vec3(-step.x,0,0); }
        else if(axis == 1) { cell.y += step.y; tMax.y += invAbs.y; blockerNormal=vec3(0,-step.y,0); }
        else { cell.z += step.z; tMax.z += invAbs.z; blockerNormal=vec3(0,0,-step.z); }

        uint source;
        if(!vptReadSourceVoxel(cell, source)) break;
        if((source & VPT_STAINED_GLASS_BIT) != 0u)
        {
            glassTransmission *=
                max(vptDecodeVoxelAlbedo(source), vec3(1.0 / 31.0));
        }
        uint emission = (source >> 2u) & 15u;
        if(emission > 0u)
        {
            return vliDecodeEmitterColor((source >> 6u) & 7u) *
                (float(emission) / 15.0) * 3.2 *
                LOCAL_LIGHT_ENERGY_SCALE *
                vptSaturateGlassTransmission(glassTransmission);
        }
        if((source & 3u) == 1u)
        {
            blockerAlbedo = vptDecodeVoxelAlbedo(source);
            blockerPos = origin + direction * t;
            return vec3(0.0);
        }
    }
    return vec3(0.0);
}

vec3 evaluateVPTPrimaryIndirect(vec3 hitPos, vec3 hitNormal, vec3 hitAlbedo,
                                vec3 direction, inout uint rngState)
{
    vec3 blockerAlbedo, blockerPos, blockerNormal;
    vec3 first = traceVPTEmitterDDA(hitPos + hitNormal * 0.02, direction,
        blockerAlbedo, blockerPos, blockerNormal);
    if(max(first.r, max(first.g, first.b)) > 0.0)
        return hitAlbedo * first;

    // The second DDA exists only after a real non-emissive voxel hit.  It is
    // not a second full-screen ray or a global-light search.
    if(max(blockerAlbedo.r, max(blockerAlbedo.g, blockerAlbedo.b)) > 0.0)
    {
        vec3 secondAlbedo, secondPos, secondNormal;
        vec3 second = traceVPTEmitterDDA(blockerPos + blockerNormal * 0.02,
            sampleHemisphereCosine(blockerNormal, rngState), secondAlbedo,
            secondPos, secondNormal);
        return hitAlbedo * blockerAlbedo * second * 0.55;
    }
    return vec3(0.0);
}


// Fixed northern-latitude equinox path. Minecraft +X is east and +Z is south:
// 0.0 = due-east sunrise, 0.25 = due-south noon at 55 degrees altitude,
// 0.5 = due-west sunset, 0.75 = midnight. Seasonal declination is deliberately
// not introduced here; it will be added as a separate, explicit stage.
const float SOLAR_LATITUDE_35_SIN = 0.57357643635;
const float SOLAR_LATITUDE_35_COS = 0.81915204429;

vec3 getTimeDrivenSunDirection()
{
    const float TWO_PI = 6.28318530718;
    float dayAngle =
        fract(cam.historyParams.w) * TWO_PI;

    return vec3(
        cos(dayAngle),
        SOLAR_LATITUDE_35_COS * sin(dayAngle),
        SOLAR_LATITUDE_35_SIN * sin(dayAngle)
    );
}

// Preserve the former 3.2 clear-noon irradiance on a horizontal surface
// while keeping the confirmed 55-degree solar altitude.  At noon NdotL on
// flat ground is SOLAR_LATITUDE_35_COS, so 1/cos(35deg) exactly compensates
// the geometric incidence loss instead of raising the historical ground-energy
// baseline.  This restores a clear, hard sun without deliberately overdriving
// bright terrain.  Moonlight remains independently controlled below.
const float TIME_DRIVEN_SUN_NOON_SCALE = 1.22077458876;
// 0.05 was the prior selected midnight value.  Reduce it by 40% without
// changing the day-light BRDF path or the noon sun energy.
const float TIME_DRIVEN_MOON_NOON_SCALE = 0.03;

// Atmosphere C1 keeps the reference pack's weather response deliberately
// compact: sky 20%, direct sunlight 10%, and fog density 1 + 3 * rain^2 at
// full rain.  Weather is strictly an Overworld effect in this stage.
const float WEATHER_RF_SKY_BRIGHTNESS = 0.20;
const float WEATHER_RF_SUN_BRIGHTNESS = 0.10;
const float WEATHER_RF_DENSITY = 1.0;
const vec3 WEATHER_THUNDER_COLD_TINT = vec3(0.72, 0.78, 0.86);

float getTimeDrivenSunElevation()
{
    const float TWO_PI = 6.28318530718;
    return SOLAR_LATITUDE_35_COS *
        sin(fract(cam.historyParams.w) * TWO_PI);
}

float getOverworldRainStrength()
{
    return abs(cam.weatherParams.z - 1.0) < 0.25
        ? clamp(cam.weatherParams.x, 0.0, 1.0)
        : 0.0;
}

float getOverworldThunderStrength()
{
    return abs(cam.weatherParams.z - 1.0) < 0.25
        ? clamp(cam.weatherParams.y, 0.0, 1.0)
        : 0.0;
}

float getWeatherSkyRadianceFactor()
{
    return mix(1.0, WEATHER_RF_SKY_BRIGHTNESS, getOverworldRainStrength());
}

float getWeatherSunRadianceFactor()
{
    return mix(1.0, WEATHER_RF_SUN_BRIGHTNESS, getOverworldRainStrength());
}

vec3 getWeatherSkyTint()
{
    return mix(vec3(1.0), WEATHER_THUNDER_COLD_TINT, getOverworldThunderStrength());
}

// =====================================================
// Rain wall run-off tuning
//
// Split in two:
//
//   - the *shape* of the effect stays compile-time here.  The rivulet lattice
//     geometry and the material response are what make the wall read as water
//     rather than as dirt, and none of them is a taste decision a player should
//     have to make;
//   - the *dial* values live in cam.rainWallParams0/1, filled every frame from
//     RTXSettingsConfig.RainWallSettings, so the look can be judged in game
//     with no rebuild.
//
// Four of the dials are scale factors with a 1.0 identity value, which is what
// keeps the constants below meaningful: at 1.0 the effective parameter is
// exactly the constant.  Density and distance are absolute instead, because
// "no rivulets" and "this far" have no natural identity.
//
// Cost shape is unchanged by the dials: they move distances and scales, never
// sample counts.
//   - the film is one evaluateContinuousRainWetnessNoise call on (tangent,
//     height) -- the same cost the wet ground already pays;
//   - the droplets add three rainPuddleHash calls per pixel;
//   - the one new ray per pixel is bounded by the effect distance, so it never
//     runs on the far field and never traverses a full open-sky column.
//
// Accessors rather than file-scope variables on purpose: a global with a
// non-constant initialiser has to be ordered against this block at link time,
// and the compiler inlines these calls away anyway.
// =====================================================

bool rainWallEnabled()
{
    return cam.rainWallParams0.x > 0.5;
}

// Scales the film's albedo darkening and its pull towards the film roughness in
// one number, so "wetness" cannot be pushed into an inconsistent pair.
float rainWallWetnessScale()
{
    return clamp(cam.rainWallParams0.y, 0.0, 2.0);
}

// Fraction of the rivulet columns that actually run.  Zero leaves the static
// film everywhere and no droplets at all.
float rainWallDripDensity()
{
    return clamp(cam.rainWallParams0.z, 0.0, 1.0);
}

float rainWallDripSpeedScale()
{
    return clamp(cam.rainWallParams0.w, 0.1, 4.0);
}

float rainWallTrailScale()
{
    return clamp(cam.rainWallParams1.x, 0.25, 4.0);
}

float rainWallDripBumpScale()
{
    return clamp(cam.rainWallParams1.z, 0.0, 2.0);
}

// The single distance dial.  It is read as "how far from the camera the effect
// still runs" and drives all three gates below, so they can never cross each
// other.  Cost is linear in this value only through the sky-exposure ray.
float rainWallEffectDistance()
{
    return clamp(cam.rainWallParams1.y, 16.0, 160.0);
}

// =====================================================
// Water style dials (Waterlight turquoise look).
// Same accessor pattern as the rain-wall block above: the native side fills
// waterStyleParams every frame, the JNI setter validates the ranges, and
// these clamps are only the safety net for a stale buffer.
// =====================================================

// Uniform scale on every natural wave band.  The closest-hit paths and the
// caustic pass scale identically, so caustics keep tracking the normals.
float waterStyleWaveScale()
{
    return clamp(cam.waterStyleParams0.x, 0.0, 2.0);
}

// 0.0 = the legacy blue-teal water, 1.0 = the turquoise Waterlight look.
// Density scale rides on absorption so "clearer / murkier" is one dial.
vec3 waterAbsorptionColor()
{
    return mix(
        vec3(0.18, 0.055, 0.018),
        vec3(0.24, 0.045, 0.055),
        clamp(cam.waterStyleParams0.y, 0.0, 1.0)
    ) * clamp(cam.waterStyleParams0.z, 0.25, 4.0);
}

vec3 waterScatterColor()
{
    return mix(
        vec3(0.05, 0.22, 0.28),
        vec3(0.05, 0.34, 0.30),
        clamp(cam.waterStyleParams0.y, 0.0, 1.0)
    );
}

float waterScatteringAmount()
{
    return mix(0.3076923, 0.38, clamp(cam.waterStyleParams0.y, 0.0, 1.0));
}

float waterStyleCausticStrength()
{
    return clamp(cam.waterStyleParams0.w, 0.0, 4.0);
}

// Droplets need their trail to be resolvable, so they cut out earlier than the
// static film does.  A distant wall may stay wet -- the film is one noise fetch
// -- but it must not animate, because a droplet trail near the sub-pixel limit
// reads as flicker rather than as flow.  At the 64 block default the ratio
// reproduces the original hand-tuned 64 / 48 / 48 / 64 split exactly.
const float RAIN_WALL_DRIP_DISTANCE_RATIO = 0.75;

float rainWallWetnessDistance()
{
    return rainWallEffectDistance();
}

float rainWallDripDistance()
{
    return rainWallEffectDistance() * RAIN_WALL_DRIP_DISTANCE_RATIO;
}

float rainWallExposureDistance()
{
    return rainWallEffectDistance() * RAIN_WALL_DRIP_DISTANCE_RATIO;
}

float rainWallExposureRange()
{
    return rainWallEffectDistance();
}

// Film response.  Roughness drops well below the wet ground's 0.075 because a
// vertical film is thin but reads as far smoother to the eye.  These are the
// reference values the wetness scale multiplies or mixes towards.
const float RAIN_WALL_ALBEDO_DARKENING = 0.30;
const float RAIN_WALL_FILM_ROUGHNESS = 0.10;

// Rivulet layout.  Columns are the vertical strands the water gathers into.
// The width is fixed: it is the spatial frequency of the lattice, and moving it
// would change how the wall reads at a given distance rather than how much
// water runs down it.
const float RAIN_WALL_DRIP_COLUMN_WIDTH = 0.45;

// Descent speed in blocks per second, per column, before the speed scale.  Real
// wall run-off sits around 0.05-0.30 m/s; the slow end of that range reads
// better on a wall than a physically average value does.
const float RAIN_WALL_DRIP_SPEED_MIN = 0.11;
const float RAIN_WALL_DRIP_SPEED_MAX = 0.26;

// Vertical spacing between successive droplets on one column, before the trail
// scale.  A longer period means a longer trail, because the head travels the
// same distance in the same time and the falloff is stretched behind it.
const float RAIN_WALL_DRIP_PERIOD = 1.6;

// Trail shape: quadratic falloff behind the droplet head, normalised so it
// reaches exactly zero at the top of the cycle, which makes consecutive
// cycles join without a seam.
const float RAIN_WALL_DRIP_TRAIL_STRENGTH = 0.55;

// Head width as a fraction of one cycle.  This is the highlight that makes
// the streak read as a droplet rather than as a scratch.
const float RAIN_WALL_DRIP_HEAD_WIDTH = 0.06;

// Droplets are a geometry effect, not a colour effect: they bend the surface
// normal outward, and the highlight that produces is what sells the water.
const float RAIN_WALL_DRIP_BUMP = 0.35;
const float RAIN_WALL_DRIP_ROUGHNESS = 0.045;

// Per-column salts.  These only need to decorrelate the column lookups from
// one another; any distinct constants work.
const float RAIN_WALL_DRIP_COLUMN_SALT = 7.13;
const float RAIN_WALL_DRIP_SPEED_SALT = 53.11;
const float RAIN_WALL_DRIP_PHASE_SALT = 91.37;

#if 0
// Superseded by the camera UBO dials above; kept as the record of the
// hand-tuned look the defaults were calibrated against.
//
//   RAIN_WALL_WETNESS_DISTANCE   -> rainWallWetnessDistance()
//   RAIN_WALL_DRIP_DISTANCE      -> rainWallDripDistance()
//   RAIN_WALL_EXPOSURE_DISTANCE  -> rainWallExposureDistance()
//   RAIN_WALL_EXPOSURE_RANGE     -> rainWallExposureRange()
//   RAIN_WALL_DRIP_COLUMN_COVERAGE -> rainWallDripDensity()
const float RAIN_WALL_WETNESS_DISTANCE = 64.0;
const float RAIN_WALL_DRIP_DISTANCE = 48.0;
const float RAIN_WALL_EXPOSURE_DISTANCE = 48.0;
const float RAIN_WALL_EXPOSURE_RANGE = 64.0;
const float RAIN_WALL_DRIP_COLUMN_COVERAGE = 0.38;
#endif

// Stable, low-frequency wet-patch field.  It is evaluated only after a
// primary opaque hit has already used its existing sun-visibility rays.
float rainPuddleHash(vec2 p)
{
    p = fract(p * vec2(0.1031, 0.11369));
    p += dot(p, p.yx + 19.19);
    return fract((p.x + p.y) * p.x);
}

float evaluateRainPuddlePattern(vec2 worldXZ)
{
    vec2 p = worldXZ * 0.31;
    vec2 cell = floor(p);
    vec2 f = fract(p);
    vec2 blend = f * f * (3.0 - 2.0 * f);

    float n00 = rainPuddleHash(cell);
    float n10 = rainPuddleHash(cell + vec2(1.0, 0.0));
    float n01 = rainPuddleHash(cell + vec2(0.0, 1.0));
    float n11 = rainPuddleHash(cell + vec2(1.0, 1.0));
    float broad = mix(mix(n00, n10, blend.x), mix(n01, n11, blend.x), blend.y);
    float detail = rainPuddleHash(floor(worldXZ * 1.73));
    return smoothstep(0.56, 0.82, broad * 0.80 + detail * 0.20);
}

// Reference wetness uses a continuous noise modulation, never a binary
// puddle mask.  The reference values are preserved here: world XZ is scaled
// by 5.0, the second octave is 0.37x with weight 3.0, and the final wetness
// multiplier is saturate(1 - n * 0.25) * 0.7 + 0.3.  The hash-backed value
// field is used only until block 2 installs the reference pack's noise image.
float evaluateContinuousRainWetnessNoise(vec2 worldXZ)
{
    vec2 p0 = worldXZ * 5.0;
    vec2 cell0 = floor(p0);
    vec2 frac0 = fract(p0);
    vec2 blend0 = frac0 * frac0 * (3.0 - 2.0 * frac0);
    float n00 = rainPuddleHash(cell0);
    float n10 = rainPuddleHash(cell0 + vec2(1.0, 0.0));
    float n01 = rainPuddleHash(cell0 + vec2(0.0, 1.0));
    float n11 = rainPuddleHash(cell0 + vec2(1.0, 1.0));
    float n0 = mix(mix(n00, n10, blend0.x), mix(n01, n11, blend0.x), blend0.y);

    vec2 p1 = p0 * 0.37;
    vec2 cell1 = floor(p1);
    vec2 frac1 = fract(p1);
    vec2 blend1 = frac1 * frac1 * (3.0 - 2.0 * frac1);
    float n20 = rainPuddleHash(cell1);
    float n30 = rainPuddleHash(cell1 + vec2(1.0, 0.0));
    float n21 = rainPuddleHash(cell1 + vec2(0.0, 1.0));
    float n31 = rainPuddleHash(cell1 + vec2(1.0, 1.0));
    float n1 = mix(mix(n20, n30, blend1.x), mix(n21, n31, blend1.x), blend1.y);

    float n = n0 + n1 * 3.0;
    return clamp(1.0 - n * 0.25, 0.0, 1.0) * 0.7 + 0.3;
}

// Wet ground uses the same no-allocation model as the water-rain path: one
// deterministic impact per world-space cell, evaluated only on an already
// visible, rain-exposed upward opaque surface.  It adds neither particles,
// textures nor ray queries, and stays stable for RR/DLSS reprojection.
vec2 evaluateRainPuddleRippleGradient(vec2 worldXZ)
{
    float rain = getOverworldRainStrength();
    if(rain <= 0.01)
    {
        return vec2(0.0);
    }

    // All rain-impact dimensions are 40% smaller than the current dense
    // field.  The matching frequency preserves the same ring count in the
    // reduced footprint.
    const float CELL_SIZE = 0.432;
    const float RING_SPEED = 0.336;
    const float RING_FREQUENCY = 66.66667;
    float time = uintBitsToFloat(cam.padding);
    vec2 baseCell = floor(worldXZ / CELL_SIZE);
    vec2 gradient = vec2(0.0);

    for(int y = -1; y <= 1; ++y)
    {
        for(int x = -1; x <= 1; ++x)
        {
            vec2 cell = baseCell + vec2(float(x), float(y));
            float seedX = rainPuddleHash(cell + vec2(17.0, 43.0));
            float seedZ = rainPuddleHash(cell + vec2(71.0, 29.0));
            float age = fract(time * mix(0.42, 1.08, rain) +
                rainPuddleHash(cell + vec2(113.0, 7.0)));
            vec2 impact = (cell + vec2(seedX, seedZ)) * CELL_SIZE;
            vec2 delta = worldXZ - impact;
            float distanceToImpact = length(delta);
            float envelope = (1.0 - smoothstep(0.52, 1.0, age)) *
                (1.0 - smoothstep(0.12, 0.204, distanceToImpact));
            if(envelope <= 0.0 || distanceToImpact <= 1.0e-4)
            {
                continue;
            }

            float radius = age * RING_SPEED;
            float slope = cos((distanceToImpact - radius) * RING_FREQUENCY);
            gradient += normalize(delta) * slope * envelope;
        }
    }

    // Keep the confirmed visible normal amplitude while reducing the ring
    // footprint.  This remains a nine-cell analytic evaluation with no extra
    // ray, texture, allocation, or dispatch cost.
    return gradient * (0.060 * rain);
}

// -------------------------------------------------------------------------
// Tyndall-derived cloud field for secondary rays and cloud shadows
// -------------------------------------------------------------------------
// Secondary rays use fewer samples of the same curved density field.
const int C3_CLOUD_HQ_SAMPLES = 16;
const int C3_CLOUD_LQ_SAMPLES = 5;
const int C3_CLOUD_SUN_SAMPLES = 5;
#define C3_CLOUD_BOTTOM cam.cloudParams0.x
#define C3_CLOUD_THICKNESS cam.cloudParams0.y
#define C3_CLOUD_ENABLED cam.cloudParams1.w
#define C3_CLOUD_EXTINCTION cam.cloudParams2.z
const float C3_CLOUD_BASIC_SHADOWLIGHT = 0.10;
const float C3_CLOUD_BASIC_SKYLIGHT = 0.10;
const float C3_CLOUD_FADE_DISTANCE = 30000.0;
const float C3_CLOUD_MIN_TRANSMITTANCE = 0.20;
const float C3_CLOUD_MIN_SUN_TRANSMITTANCE = 0.10;

float c3Saturate(float value)
{
    return clamp(value, 0.0, 1.0);
}

#include "tyndall_cloud_field.glsl"

float c3CloudDensity(vec3 worldPos, bool simplified)
{
    return tyndallDensity(worldPos, simplified, 0.0);
}

